<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste des boxes -->
    <record id="view_storage_box_tree" model="ir.ui.view">
        <field name="name">storage.box.tree</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <list string="Boxes de stockage" decoration-success="status == 'disponible'" 
                  decoration-danger="status == 'occupe'" decoration-warning="status == 'maintenance'">
                <field name="name"/>
                <field name="floor_id"/>
                <field name="current_customer_name" string="Client"/>
                <field name="volume"/>
                <field name="surface"/>
                <field name="price_monthly"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'disponible'"
                       decoration-danger="status == 'occupe'"
                       decoration-warning="status == 'maintenance'"
                       decoration-info="status == 'reserve'"/>
                <field name="product_tmpl_id" string="Produit" optional="hide"/>
                <field name="date_available" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire des boxes -->
    <record id="view_storage_box_form" model="ir.ui.view">
        <field name="name">storage.box.form</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <form string="Box de stockage">
                <header>
                    <button name="action_make_available" string="Rendre disponible" 
                            type="object" class="oe_highlight" 
                            invisible="status == 'disponible'"/>
                    <button name="action_make_occupied" string="Marquer occupé" 
                            type="object" 
                            invisible="status == 'occupe'"/>
                    <button name="action_make_maintenance" string="En maintenance" 
                            type="object" 
                            invisible="status == 'maintenance'"/>
                    <field name="status" widget="statusbar" 
                           statusbar_visible="disponible,reserve,occupe"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                        <button name="action_view_current_subscription" type="object" 
                                class="oe_stat_button" icon="fa-refresh"
                                invisible="not current_subscription_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Abonnement</span>
                                <span class="o_stat_text text-success">Actif</span>
                            </div>
                        </button>
                        <button name="action_view_customer" type="object" 
                                class="oe_stat_button" icon="fa-user"
                                invisible="not current_partner_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Voir</span>
                                <span class="o_stat_text">Client</span>
                            </div>
                        </button>
                        <button name="action_view_on_website" type="object" 
                                class="oe_stat_button" icon="fa-globe">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Voir sur</span>
                                <span class="o_stat_text">le site</span>
                            </div>
                        </button>
                    </div>
                    
                    <!-- Bandeau client actuel -->
                    <div class="alert alert-info d-flex align-items-center" role="alert" 
                         invisible="not current_customer_name">
                        <i class="fa fa-user fa-lg me-3"/>
                        <div>
                            <strong>Client actuel : </strong>
                            <field name="current_customer_name" class="fw-bold"/>
                            <span class="ms-2 text-muted" invisible="not current_subscription_id">
                                (via abonnement)
                            </span>
                        </div>
                        <button name="action_refresh_customer" type="object" 
                                class="btn btn-sm btn-outline-secondary ms-auto"
                                string="Rafraîchir" icon="fa-refresh"/>
                    </div>
                    
                    <group>
                        <group string="Informations générales">
                            <field name="name"/>
                            <field name="floor_id"/>
                            <field name="status"/>
                            <field name="date_available" 
                                   invisible="status == 'disponible'"
                                   placeholder="Date de disponibilité prévue"/>
                        </group>
                        <group string="Dimensions">
                            <field name="width"/>
                            <field name="depth"/>
                            <field name="height"/>
                            <field name="volume"/>
                            <field name="surface"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tarification">
                            <field name="price_monthly"/>
                            <field name="registration_fee"/>
                            <field name="deposit_months"/>
                            <field name="deposit_amount"/>
                        </group>
                        <group string="Position">
                            <field name="aisle" widget="radio"/>
                            <field name="grid_row"/>
                            <field name="grid_col"/>
                            <field name="position_x"/>
                            <field name="position_y"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description du box..."/>
                    </group>
                    
                    <!-- Champs cachés pour les computed -->
                    <field name="current_partner_id" invisible="1"/>
                    <field name="current_subscription_id" invisible="1"/>
                    <field name="current_reservation_id" invisible="1"/>
                    
                    <notebook>
                        <page string="Réservations" name="reservations">
                            <field name="reservation_ids">
                                <list decoration-success="state == 'ongoing'" 
                                      decoration-info="state == 'confirmed'"
                                      decoration-muted="state in ('completed', 'cancelled')">
                                    <field name="name"/>
                                    <field name="customer_name"/>
                                    <field name="partner_id" optional="hide"/>
                                    <field name="reservation_date"/>
                                    <field name="start_date"/>
                                    <field name="end_date" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'ongoing'"
                                           decoration-info="state == 'confirmed'"
                                           decoration-warning="state == 'pending'"
                                           decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Produit lié" name="product_link">
                            <group>
                                <group string="Liaison avec le produit e-commerce">
                                    <field name="product_tmpl_id" 
                                           options="{'no_create': True}"
                                           context="{'default_is_storage_box': True}"/>
                                    <button name="action_link_product_by_name" 
                                            string="Lier automatiquement par nom"
                                            type="object" class="btn-link"
                                            icon="fa-magic"
                                            invisible="product_tmpl_id"
                                            help="Cherche un produit avec un nom correspondant"/>
                                </group>
                                <group string="Info abonnement" invisible="not current_subscription_id">
                                    <field name="current_subscription_id" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert" invisible="product_tmpl_id">
                                <i class="fa fa-exclamation-triangle me-2"/>
                                <strong>Aucun produit lié.</strong> 
                                Liez ce box à un produit e-commerce pour que le système récupère 
                                automatiquement le client depuis les abonnements actifs.
                            </div>
                        </page>
                        <page string="Notes internes" name="notes">
                            <field name="notes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue kanban des boxes -->
    <record id="view_storage_box_kanban" model="ir.ui.view">
        <field name="name">storage.box.kanban</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="floor_id"/>
                <field name="volume"/>
                <field name="price_monthly"/>
                <field name="status"/>
                <field name="date_available"/>
                <field name="current_customer_name"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="floor_id"/>
                                </div>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><field name="volume"/> m³ - <field name="price_monthly"/> €/mois</div>
                            <t t-if="record.current_customer_name.raw_value">
                                <div class="mt-1">
                                    <i class="fa fa-user text-primary"/> 
                                    <strong><field name="current_customer_name"/></strong>
                                </div>
                            </t>
                            <t t-if="record.date_available.raw_value">
                                <div><small class="text-muted">Dispo: <field name="date_available"/></small></div>
                            </t>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="status" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action pour les boxes -->
    <record id="action_storage_box" model="ir.actions.act_window">
        <field name="name">Boxes de stockage</field>
        <field name="res_model">storage.box</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    
    <!-- Action serveur pour rafraîchir les clients -->
    <record id="action_refresh_all_customers" model="ir.actions.server">
        <field name="name">Rafraîchir les clients</field>
        <field name="model_id" ref="storage_plan_module.model_storage_box"/>
        <field name="binding_model_id" ref="storage_plan_module.model_storage_box"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_refresh_customer()
        </field>
    </record>
    
    <!-- Action serveur pour lier les produits automatiquement -->
    <record id="action_link_products_auto" model="ir.actions.server">
        <field name="name">Lier produits automatiquement</field>
        <field name="model_id" ref="storage_plan_module.model_storage_box"/>
        <field name="binding_model_id" ref="storage_plan_module.model_storage_box"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_link_product_by_name()
        </field>
    </record>
    
</odoo>
