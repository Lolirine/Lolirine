<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue du wizard de scan avec 3 options -->
    <record id="view_lolirine_scan_tva_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.wizard.form</field>
        <field name="model">lolirine.scan.tva.wizard</field>
        <field name="arch" type="xml">
            <form string="Scanner une souche TVA">
                <sheet>
                    <div class="container-fluid">
                        <!-- Onglets de mode -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <ul class="nav nav-tabs nav-justified" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active" id="tab-upload" data-bs-toggle="tab" data-bs-target="#mode-upload" type="button" role="tab">
                                            <i class="fa fa-upload fa-2x d-block mb-1"/>
                                            Glisser / Uploader
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" id="tab-webcam" data-bs-toggle="tab" data-bs-target="#mode-webcam" type="button" role="tab">
                                            <i class="fa fa-camera fa-2x d-block mb-1"/>
                                            Caméra / Webcam
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" id="tab-scanner" data-bs-toggle="tab" data-bs-target="#mode-scanner" type="button" role="tab">
                                            <i class="fa fa-print fa-2x d-block mb-1"/>
                                            Scanner Mac
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        
                        <!-- Contenu des onglets -->
                        <div class="tab-content">
                            <!-- Mode Upload / Drag & Drop -->
                            <div class="tab-pane fade show active" id="mode-upload" role="tabpanel">
                                <div class="row">
                                    <div class="col-12">
                                        <div class="scan-dropzone p-5 text-center" 
                                             style="min-height: 200px; border: 3px dashed #ccc; border-radius: 10px; background: #fafafa;">
                                            <i class="fa fa-cloud-upload fa-4x text-muted mb-3"/>
                                            <h4>Glissez votre fichier ici</h4>
                                            <p class="text-muted">ou cliquez pour parcourir</p>
                                            <field name="document" filename="document_filename" widget="binary" class="mt-3"/>
                                            <field name="document_filename" invisible="1"/>
                                            <p class="text-muted mt-2">
                                                <small><i class="fa fa-info-circle"/> Formats acceptés : JPG, PNG, PDF</small>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Mode Webcam -->
                            <div class="tab-pane fade" id="mode-webcam" role="tabpanel">
                                <div class="row">
                                    <div class="col-12 text-center">
                                        <div class="alert alert-info">
                                            <i class="fa fa-info-circle"/> 
                                            La capture par webcam utilise la caméra de votre appareil.
                                            Autorisez l'accès à la caméra si demandé.
                                        </div>
                                        
                                        <div id="webcam-container" class="mb-3" style="background: #000; border-radius: 10px; overflow: hidden; display: inline-block;">
                                            <video id="webcam-video" autoplay="true" playsinline="true" 
                                                   style="max-width: 100%; max-height: 350px; display: none;"/>
                                            <div id="webcam-placeholder" class="p-5 text-white">
                                                <i class="fa fa-video-camera fa-4x mb-3"/>
                                                <p>Cliquez sur "Démarrer la caméra" pour commencer</p>
                                            </div>
                                        </div>
                                        <canvas id="webcam-canvas" style="display: none;"/>
                                        
                                        <div class="mt-3">
                                            <button type="button" class="btn btn-primary btn-lg" id="btn-start-webcam" onclick="startWebcam()">
                                                <i class="fa fa-video-camera"/> Démarrer la caméra
                                            </button>
                                            <button type="button" class="btn btn-success btn-lg" id="btn-capture" onclick="captureWebcam()" style="display: none;">
                                                <i class="fa fa-camera"/> Capturer
                                            </button>
                                            <button type="button" class="btn btn-secondary" id="btn-stop-webcam" onclick="stopWebcam()" style="display: none;">
                                                <i class="fa fa-stop"/> Arrêter
                                            </button>
                                        </div>
                                        
                                        <div id="webcam-result" class="mt-3" style="display: none;">
                                            <div class="alert alert-success">
                                                <i class="fa fa-check-circle"/> Image capturée ! 
                                                Cliquez sur "Scanner et extraire" pour continuer.
                                            </div>
                                            <img id="captured-image" style="max-width: 300px; border-radius: 8px;"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <script>
                                    let webcamStream = null;
                                    
                                    function startWebcam() {
                                        navigator.mediaDevices.getUserMedia({ 
                                            video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }
                                        })
                                        .then(function(stream) {
                                            webcamStream = stream;
                                            const video = document.getElementById('webcam-video');
                                            const placeholder = document.getElementById('webcam-placeholder');
                                            video.srcObject = stream;
                                            video.style.display = 'block';
                                            placeholder.style.display = 'none';
                                            document.getElementById('btn-start-webcam').style.display = 'none';
                                            document.getElementById('btn-capture').style.display = 'inline-block';
                                            document.getElementById('btn-stop-webcam').style.display = 'inline-block';
                                        })
                                        .catch(function(err) {
                                            alert('Erreur caméra: ' + err.message);
                                        });
                                    }
                                    
                                    function stopWebcam() {
                                        if (webcamStream) {
                                            webcamStream.getTracks().forEach(track => track.stop());
                                            webcamStream = null;
                                        }
                                        const video = document.getElementById('webcam-video');
                                        const placeholder = document.getElementById('webcam-placeholder');
                                        video.style.display = 'none';
                                        placeholder.style.display = 'block';
                                        document.getElementById('btn-start-webcam').style.display = 'inline-block';
                                        document.getElementById('btn-capture').style.display = 'none';
                                        document.getElementById('btn-stop-webcam').style.display = 'none';
                                    }
                                    
                                    function captureWebcam() {
                                        const video = document.getElementById('webcam-video');
                                        const canvas = document.getElementById('webcam-canvas');
                                        canvas.width = video.videoWidth;
                                        canvas.height = video.videoHeight;
                                        canvas.getContext('2d').drawImage(video, 0, 0);
                                        
                                        canvas.toBlob(function(blob) {
                                            // Convertir en base64 et mettre dans le champ
                                            const reader = new FileReader();
                                            reader.onloadend = function() {
                                                const base64 = reader.result.split(',')[1];
                                                // Trouver le champ binary et y mettre la valeur
                                                const fileInput = document.querySelector('input[type="file"]');
                                                if (fileInput) {
                                                    const dataTransfer = new DataTransfer();
                                                    const file = new File([blob], 'capture_' + Date.now() + '.jpg', { type: 'image/jpeg' });
                                                    dataTransfer.items.add(file);
                                                    fileInput.files = dataTransfer.files;
                                                    fileInput.dispatchEvent(new Event('change', { bubbles: true }));
                                                }
                                                
                                                // Afficher l'aperçu
                                                document.getElementById('captured-image').src = reader.result;
                                                document.getElementById('webcam-result').style.display = 'block';
                                            };
                                            reader.readAsDataURL(blob);
                                        }, 'image/jpeg', 0.92);
                                        
                                        stopWebcam();
                                    }
                                </script>
                            </div>
                            
                            <!-- Mode Scanner Mac -->
                            <div class="tab-pane fade" id="mode-scanner" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="card mb-3 border-primary">
                                            <div class="card-header bg-primary text-white">
                                                <i class="fa fa-apple"/> Méthode 1 : Transfert d'images
                                            </div>
                                            <div class="card-body">
                                                <ol class="mb-0">
                                                    <li>Appuyez sur <kbd>⌘</kbd> + <kbd>Espace</kbd></li>
                                                    <li>Tapez <strong>"Transfert d'images"</strong></li>
                                                    <li>Sélectionnez votre scanner</li>
                                                    <li>Cliquez sur <strong>"Scanner"</strong></li>
                                                    <li>Enregistrez puis glissez l'image dans l'onglet "Glisser/Uploader"</li>
                                                </ol>
                                            </div>
                                        </div>
                                        
                                        <div class="card border-success">
                                            <div class="card-header bg-success text-white">
                                                <i class="fa fa-apple"/> Méthode 2 : Aperçu (Preview)
                                            </div>
                                            <div class="card-body">
                                                <ol class="mb-0">
                                                    <li>Ouvrez <strong>Aperçu</strong></li>
                                                    <li>Menu <strong>Fichier → Importer depuis le scanner</strong></li>
                                                    <li>Sélectionnez votre scanner</li>
                                                    <li>Scannez et enregistrez</li>
                                                    <li>Glissez le fichier dans l'onglet "Glisser/Uploader"</li>
                                                </ol>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="card mb-3 border-info">
                                            <div class="card-header bg-info text-white">
                                                <i class="fa fa-mobile"/> Méthode 3 : iPhone / iPad
                                            </div>
                                            <div class="card-body">
                                                <ol class="mb-0">
                                                    <li>Ouvrez <strong>Notes</strong> ou <strong>Fichiers</strong></li>
                                                    <li>Touchez <strong>+</strong> → <strong>Scanner des documents</strong></li>
                                                    <li>Photographiez votre ticket</li>
                                                    <li>Envoyez par <strong>AirDrop</strong> vers votre Mac</li>
                                                    <li>Glissez dans l'onglet "Glisser/Uploader"</li>
                                                </ol>
                                            </div>
                                        </div>
                                        
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h5><i class="fa fa-keyboard-o"/> Raccourci rapide</h5>
                                                <p class="display-6">
                                                    <kbd>⌘</kbd> + <kbd>Shift</kbd> + <kbd>I</kbd>
                                                </p>
                                                <p class="text-muted mb-0">
                                                    Ouvre directement Transfert d'images
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="alert alert-warning mt-3">
                                    <i class="fa fa-arrow-left"/> 
                                    Une fois votre document scanné, allez dans l'onglet <strong>"Glisser/Uploader"</strong> pour le déposer.
                                </div>
                            </div>
                        </div>
                        
                        <!-- Notes -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <label for="notes" class="form-label">Notes (optionnel)</label>
                                <field name="notes" placeholder="Notes sur ce document..." class="form-control"/>
                            </div>
                        </div>
                    </div>
                </sheet>
                
                <footer>
                    <button name="action_create_scan" 
                            type="object" 
                            string="Scanner et extraire" 
                            class="btn-primary"
                            icon="fa-magic"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Vue du wizard d'extraction manuelle -->
    <record id="view_lolirine_scan_tva_extract_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.extract.wizard.form</field>
        <field name="model">lolirine.scan.tva.extract.wizard</field>
        <field name="arch" type="xml">
            <form string="Extraction manuelle">
                <group>
                    <group string="Fournisseur">
                        <field name="supplier_vat" placeholder="BE0123456789"/>
                        <field name="supplier_name"/>
                    </group>
                    <group string="Facture">
                        <field name="invoice_number"/>
                        <field name="invoice_date"/>
                    </group>
                </group>
                <group>
                    <group string="Montants">
                        <field name="tax_rate"/>
                        <field name="amount_untaxed"/>
                        <field name="amount_tax"/>
                        <field name="amount_total"/>
                    </group>
                    <group string="Texte OCR (reference)">
                        <field name="ocr_text" readonly="1" nolabel="1"/>
                    </group>
                </group>
                <field name="scan_id" invisible="1"/>
                <footer>
                    <button name="action_apply" 
                            type="object" 
                            string="Appliquer" 
                            class="btn-primary"
                            icon="fa-check"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
