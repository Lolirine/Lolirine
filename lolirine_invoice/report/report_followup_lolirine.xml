<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hériter du rapport de relance pour utiliser le layout Lolirine -->
    <template id="report_followup_lolirine" inherit_id="account_followup.report_followup_print_all" priority="99">
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">lolirine_invoice.external_layout_lolirine</attribute>
        </xpath>
    </template>

    <!-- Template personnalisé pour le contenu de la relance -->
    <template id="followup_report_content_lolirine" inherit_id="account_followup.template_followup_report" priority="99">
        <!-- Remplacer le titre -->
        <xpath expr="//h2[contains(@class, 'strong') or .//strong]" position="replace">
            <h2 style="color: #c0392b; border-bottom: 2px solid #c0392b; padding-bottom: 10px;">
                <strong>Rapport de relance</strong>
            </h2>
        </xpath>
    </template>
</odoo>
