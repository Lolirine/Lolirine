<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue formulaire étendue pour les leads -->
    <record id="view_crm_lead_form_lolirine" model="ir.ui.view">
        <field name="name">crm.lead.form.lolirine</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Ajouter le bouton pour créer un abonnement -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_create_partner_and_subscription" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        string="Créer Abonnement"
                        invisible="partner_id"/>
                <button name="action_view_partner" type="object"
                        class="oe_stat_button" icon="fa-user"
                        string="Voir Client"
                        invisible="not partner_id"/>
            </xpath>
            
            <!-- Ajouter un onglet pour les infos garde-meubles -->
            <xpath expr="//notebook" position="inside">
                <page string="📦 Garde-Meubles" name="storage_info">
                    <group>
                        <group string="Besoins en stockage">
                            <field name="storage_type"/>
                            <field name="storage_duration"/>
                            <field name="desired_start_date"/>
                        </group>
                        <group string="Informations complémentaires">
                            <field name="how_did_you_hear"/>
                            <field name="is_company_contact"/>
                            <field name="company_name_contact" invisible="not is_company_contact"/>
                            <field name="legal_name" invisible="not is_company_contact"/>
                            <field name="vat_number" invisible="not is_company_contact"/>
                        </group>
                    </group>
                    <group string="Contenu à stocker">
                        <field name="storage_content" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Demandes particulières">
                        <field name="special_requests" nolabel="1" colspan="2"/>
                    </group>
                </page>
                
                <page string="📍 Adresse complète" name="address_info">
                    <group>
                        <group>
                            <field name="contact_street"/>
                            <field name="contact_street_number"/>
                            <field name="contact_street2"/>
                        </group>
                        <group>
                            <field name="contact_zip"/>
                            <field name="contact_city"/>
                            <field name="contact_country_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="full_address" readonly="1"/>
                    </group>
                </page>
            </xpath>
            
        </field>
    </record>
    
    <!-- Vue liste étendue pour les leads -->
    <record id="view_crm_lead_tree_lolirine" model="ir.ui.view">
        <field name="name">crm.lead.tree.lolirine</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contact_name']" position="after">
                <field name="storage_type" optional="show"/>
                <field name="desired_start_date" optional="show"/>
            </xpath>
        </field>
    </record>
    
    <!-- Vue kanban étendue -->
    <record id="view_crm_lead_kanban_lolirine" model="ir.ui.view">
        <field name="name">crm.lead.kanban.lolirine</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="storage_type"/>
                <field name="desired_start_date"/>
            </xpath>
        </field>
    </record>
    
    <!-- Filtre pour les demandes web -->
    <record id="view_crm_lead_search_lolirine" model="ir.ui.view">
        <field name="name">crm.lead.search.lolirine</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/filter[1]" position="before">
                <filter string="Demandes Web" name="web_requests" domain="[('name', 'ilike', 'Demande web')]"/>
                <filter string="Début ce mois" name="start_this_month" domain="[('desired_start_date', '!=', False)]"/>
                <separator/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter string="Type de box" name="group_storage_type" context="{'group_by': 'storage_type'}"/>
                <filter string="Durée estimée" name="group_storage_duration" context="{'group_by': 'storage_duration'}"/>
            </xpath>
        </field>
    </record>
    
</odoo>
