<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== TAGS DE FACTURES ==================== -->
    
    <!-- Vue formulaire -->
    <record id="view_invoice_tag_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.tag.form</field>
        <field name="model">lolirine.invoice.tag</field>
        <field name="arch" type="xml">
            <form string="Tag de facture">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Factures"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste -->
    <record id="view_invoice_tag_list" model="ir.ui.view">
        <field name="name">lolirine.invoice.tag.list</field>
        <field name="model">lolirine.invoice.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="invoice_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_invoice_tags" model="ir.actions.act_window">
        <field name="name">Tags de factures</field>
        <field name="res_model">lolirine.invoice.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creez votre premier tag
            </p>
            <p>
                Les tags permettent de classifier vos factures (Self-Storage, Pool, Urgent, etc.)
            </p>
        </field>
    </record>

</odoo>
