<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire créneau -->
    <record id="visite_creneau_view_form" model="ir.ui.view">
        <field name="name">visite.creneau.view.form</field>
        <field name="model">visite.creneau</field>
        <field name="arch" type="xml">
            <form string="Créneau horaire">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visites" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="visite_count" widget="statinfo" string="Visites"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="jour_semaine"/>
                            <field name="heure_debut" widget="float_time"/>
                            <field name="heure_fin" widget="float_time"/>
                        </group>
                        <group>
                            <field name="duree" widget="float_time" readonly="1"/>
                            <field name="max_visites"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste créneau -->
    <record id="visite_creneau_view_tree" model="ir.ui.view">
        <field name="name">visite.creneau.view.tree</field>
        <field name="model">visite.creneau</field>
        <field name="arch" type="xml">
            <tree string="Créneaux horaires">
                <field name="jour_semaine"/>
                <field name="heure_debut" widget="float_time"/>
                <field name="heure_fin" widget="float_time"/>
                <field name="duree" widget="float_time"/>
                <field name="max_visites"/>
                <field name="user_id"/>
                <field name="visite_count"/>
            </tree>
        </field>
    </record>

    <!-- Action créneaux -->
    <record id="visite_creneau_action" model="ir.actions.act_window">
        <field name="name">Créneaux horaires</field>
        <field name="res_model">visite.creneau</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Définir les créneaux horaires disponibles
            </p>
            <p>
                Configurez les plages horaires pendant lesquelles vous pouvez recevoir des visites.
            </p>
        </field>
    </record>
</odoo>
