<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Page Promotions principale                   -->
    <!-- Entièrement modulable via le Website Builder -->
    <!-- ============================================ -->
    <template id="promotions_page" name="Promotions">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'promotions'"/>
            <t t-set="additional_title">Promotions</t>

            <div id="wrap" class="oe_structure oe_empty">

                <!-- ============================================ -->
                <!-- SECTION 1 : Hero Banner Promotions           -->
                <!-- ============================================ -->
                <section class="s_cover pt96 pb96 o_cc o_cc1" data-snippet="s_cover"
                         style="background-image: linear-gradient(135deg, #0077b6 0%, #00b4d8 50%, #90e0ef 100%);">
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container text-center">
                        <h1 class="display-3 fw-bold text-white"
                            style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">
                            &#x1F3CA; Promotions Piscine
                        </h1>
                        <p class="lead text-white mt-3 mb-4" style="font-size: 1.4rem;">
                            Découvrez nos offres exceptionnelles sur l'équipement piscine, spa et accessoires
                        </p>
                        <a href="/shop" class="btn btn-lg btn-light rounded-pill px-5 py-3 fw-bold shadow">
                            Voir la boutique &#x2192;
                        </a>
                    </div>
                </section>

                <!-- ============================================ -->
                <!-- SECTION 2 : Bandeau urgence                  -->
                <!-- ============================================ -->
                <section class="s_text_block pt24 pb24" data-snippet="s_text_block"
                         style="background-color: #e63946;">
                    <div class="container">
                        <div class="row align-items-center justify-content-center text-center text-white">
                            <div class="col-lg-8">
                                <h3 class="fw-bold mb-0">
                                    &#x1F525; Offre limitée — Jusqu'à -30% sur une sélection d'articles !
                                </h3>
                                <p class="mb-0 mt-2 opacity-75">
                                    Profitez-en avant la fin de la saison. Stock limité.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============================================ -->
                <!-- SECTION 3 : Zone libre avant produits        -->
                <!-- ============================================ -->
                <div id="promo_pre_products_zone" class="oe_structure oe_empty"/>

                <!-- ============================================ -->
                <!-- SECTION 4 : Grille dynamique des produits    -->
                <!--             en promotion (depuis le catalog) -->
                <!-- ============================================ -->
                <section class="s_dynamic_promo_grid pt48 pb48">
                    <div class="container">
                        <div class="text-center mb-5">
                            <h2 class="fw-bold" style="color: #0077b6;">
                                Nos meilleures offres
                            </h2>
                            <p class="text-muted lead">
                                Sélectionnés pour préparer votre saison piscine
                            </p>
                        </div>

                        <t t-if="promo_products">
                            <div class="row justify-content-center">
                                <t t-foreach="promo_products" t-as="promo">
                                    <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                                        <div class="card promo-product-card shadow-sm border-0 h-100 overflow-hidden">
                                            <!-- Image produit -->
                                            <div class="position-relative">
                                                <a t-attf-href="/shop/{{ slug(promo['product']) }}">
                                                    <img t-att-src="'/web/image/product.template/%s/image_512' % promo['product'].id"
                                                         class="card-img-top"
                                                         t-att-alt="promo['product'].name"
                                                         style="height: 220px; object-fit: contain; background: #f8f9fa; padding: 10px;"
                                                         loading="lazy"/>
                                                </a>
                                                <!-- Badge réduction -->
                                                <span class="position-absolute top-0 end-0 m-2 badge rounded-pill fs-6 promo-badge">
                                                    -<t t-out="promo['discount_pct']"/>%
                                                </span>
                                            </div>
                                            <!-- Infos produit -->
                                            <div class="card-body text-center d-flex flex-column">
                                                <h6 class="card-title fw-bold mb-2">
                                                    <a t-attf-href="/shop/{{ slug(promo['product']) }}"
                                                       class="text-decoration-none text-dark">
                                                        <t t-out="promo['product'].name"/>
                                                    </a>
                                                </h6>
                                                <div class="mt-auto">
                                                    <div class="mb-3">
                                                        <span class="text-decoration-line-through text-muted me-2">
                                                            <t t-out="'%.2f' % promo['original_price']"/>&#x20AC;
                                                        </span>
                                                        <span class="fs-5 fw-bold promo-price">
                                                            <t t-out="'%.2f' % promo['promo_price']"/>&#x20AC;
                                                        </span>
                                                    </div>
                                                    <a t-attf-href="/shop/{{ slug(promo['product']) }}"
                                                       class="btn btn-sm rounded-pill px-4 btn-promo-cta">
                                                        Voir le produit
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- Message si aucune promo -->
                        <t t-else="">
                            <div class="text-center py-5">
                                <div style="font-size: 4rem;">&#x1F50D;</div>
                                <h4 class="text-muted mt-3">
                                    Aucune promotion en cours pour le moment
                                </h4>
                                <p class="text-muted">
                                    Revenez bientôt ou parcourez notre catalogue complet
                                </p>
                                <a href="/shop" class="btn btn-outline-primary rounded-pill px-4 mt-2">
                                    Voir tous les produits
                                </a>
                            </div>
                        </t>
                    </div>
                </section>

                <!-- ============================================ -->
                <!-- SECTION 5 : Zone libre après produits        -->
                <!-- ============================================ -->
                <div id="promo_post_products_zone" class="oe_structure oe_empty"/>

                <!-- ============================================ -->
                <!-- SECTION 6 : Avantages / Réassurance          -->
                <!-- ============================================ -->
                <section class="s_text_image pt48 pb48" data-snippet="s_text_image"
                         style="background-color: #f8f9fa;">
                    <div class="container">
                        <div class="row text-center">
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="p-4">
                                    <div style="font-size: 3rem;">&#x1F69A;</div>
                                    <h5 class="fw-bold mt-3">Livraison rapide</h5>
                                    <p class="text-muted small">
                                        Expédition sous 24-48h pour les articles en stock
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="p-4">
                                    <div style="font-size: 3rem;">&#x1F4B0;</div>
                                    <h5 class="fw-bold mt-3">Prix imbattables</h5>
                                    <p class="text-muted small">
                                        Les meilleurs tarifs sur l'équipement piscine
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="p-4">
                                    <div style="font-size: 3rem;">&#x1F6E1;</div>
                                    <h5 class="fw-bold mt-3">Garantie fabricant</h5>
                                    <p class="text-muted small">
                                        Tous nos produits sont garantis constructeur
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="p-4">
                                    <div style="font-size: 3rem;">&#x1F4DE;</div>
                                    <h5 class="fw-bold mt-3">Conseil expert</h5>
                                    <p class="text-muted small">
                                        Notre équipe vous accompagne dans vos choix
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============================================ -->
                <!-- SECTION 7 : Zone libre contenu extra         -->
                <!-- ============================================ -->
                <div id="promo_extra_zone" class="oe_structure oe_empty"/>

                <!-- ============================================ -->
                <!-- SECTION 8 : Call to Action final              -->
                <!-- ============================================ -->
                <section class="s_text_block pt64 pb64" data-snippet="s_text_block"
                         style="background: linear-gradient(135deg, #023e8a 0%, #0077b6 100%);">
                    <div class="container text-center">
                        <h2 class="display-5 fw-bold text-white mb-3">
                            Prêt à équiper votre piscine ?
                        </h2>
                        <p class="lead text-white opacity-75 mb-4">
                            Parcourez notre catalogue complet et profitez de nos promotions exclusives
                        </p>
                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <a href="/shop" class="btn btn-light btn-lg rounded-pill px-5 fw-bold shadow">
                                &#x1F6D2; Voir la boutique
                            </a>
                            <a href="/contactus"
                               class="btn btn-outline-light btn-lg rounded-pill px-5 fw-bold">
                                &#x1F4E7; Nous contacter
                            </a>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <!-- ============================================ -->
    <!-- Enregistrement de la page website            -->
    <!-- ============================================ -->
    <record id="promotions_page_view" model="website.page">
        <field name="name">Promotions</field>
        <field name="url">/promotions</field>
        <field name="view_id" ref="promotions_page"/>
        <field name="website_indexed" eval="True"/>
        <field name="is_published" eval="True"/>
    </record>

</odoo>
