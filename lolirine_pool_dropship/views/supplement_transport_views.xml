<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_supplement" model="ir.ui.view">
        <field name="name">delivery.carrier.form.pool.supplement</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="currency_id" invisible="1"/>
                <field name="pool_supplement_transport" widget="monetary"/>
                <field name="pool_marge_min_active"/>
                <field name="pool_marge_plafond" widget="monetary" invisible="not pool_marge_min_active"/>
                <field name="pool_appoint_minimum" widget="monetary"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_supplement" model="ir.ui.view">
        <field name="name">product.template.form.pool.supplement</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="pool_supplement_transport" invisible="not sale_ok"/>
                <field name="pool_adr" invisible="not sale_ok"/>
                <field name="pool_appoint" invisible="not sale_ok"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_bareme_port" model="ir.ui.view">
        <field name="name">res.partner.form.pool.bareme.port</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="pool_bareme_port" invisible="not is_company"/>
                <field name="pool_marge_min_livraison" invisible="not pool_bareme_port"/>
            </xpath>
        </field>
    </record>

    <!-- Fiche produit du site : mention « article d'appoint » sous le bouton d'ajout au panier -->
    <template id="product_appoint_notice" name="Pool Store : mention article d'appoint"
              inherit_id="website_sale.product" priority="70">
        <xpath expr="//form[@t-if='is_add_to_cart_possible']" position="after">
            <t t-if="product.pool_appoint">
                <t t-set="pool_appoint_carrier"
                   t-value="request.env['delivery.carrier'].sudo().search([('pool_appoint_minimum', '>', 0)], limit=1)"/>
                <div t-if="pool_appoint_carrier" class="alert alert-info mt-3 mb-0 py-2 px-3 small" role="note">
                    <strong>Article d'appoint.</strong>
                    Commande possible à partir de
                    <t t-out="('%.0f' % pool_appoint_carrier.pool_appoint_minimum)"/> € HTVA d'achats
                    (<t t-out="('%.2f' % (pool_appoint_carrier.pool_appoint_minimum * 1.21)).replace('.', ',')"/> € TVAC) :
                    ajoutez-le à une commande plus complète.
                </div>
            </t>
        </xpath>
    </template>

    <!-- Étape de livraison : message quand le minimum d'achats des articles d'appoint n'est pas atteint -->
    <template id="delivery_form_appoint_notice" name="Pool Store : minimum d'achats (articles d'appoint)"
              inherit_id="website_sale.delivery_form" priority="70">
        <xpath expr="//form[@id='o_delivery_form']/h4" position="after">
            <t t-set="pool_appoint_min"
               t-value="request.env['delivery.carrier'].sudo().search([('pool_appoint_minimum', '>', 0)], limit=1).pool_appoint_minimum"/>
            <t t-set="pool_appoint_manque"
               t-value="order and pool_appoint_min and order.sudo()._pool_appoint_manque(pool_appoint_min) or 0"/>
            <div t-if="pool_appoint_manque" class="alert alert-warning mb-3" role="alert">
                <strong>Minimum d'achats non atteint.</strong>
                Votre panier contient un article d'appoint, commandable à partir de
                <t t-out="('%.0f' % pool_appoint_min)"/> € HTVA d'achats.
                Il vous manque
                <strong><t t-out="('%.2f' % pool_appoint_manque).replace('.', ',')"/> € HTVA</strong>
                (<t t-out="('%.2f' % (pool_appoint_manque * 1.21)).replace('.', ',')"/> € TVAC).
                <a href="/shop">Compléter mon panier</a>
            </div>
        </xpath>
        <!-- Sous le minimum, aucun mode n'est commandable : la liste est masquée, l'encadré suffit -->
        <xpath expr="//li[@name='o_delivery_method']" position="attributes">
            <attribute name="t-if">not pool_appoint_manque</attribute>
        </xpath>
    </template>
</odoo>
