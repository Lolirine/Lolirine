<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension de res.config.settings pour Odoo 18 -->
    <record id="res_config_settings_view_form_indexation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.indexation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Indexation" string="Indexation" data-key="storage_indexation" groups="base.group_system">
                    <h2>Configuration de l'indexation</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="indexation_index_type"/>
                                <div class="text-muted">
                                    Indice utilisé par défaut pour les nouvelles indexations
                                </div>
                                <div class="content-group">
                                    <field name="indexation_index_type"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="indexation_auto_fetch"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="indexation_auto_fetch"/>
                                <div class="text-muted">
                                    Récupère automatiquement l'indice santé depuis Statbel chaque mois
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <h2>Notifications</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="indexation_notification_days"/>
                                <div class="text-muted">
                                    Nombre de jours avant la date d'application pour notifier les clients
                                </div>
                                <div class="content-group">
                                    <field name="indexation_notification_days"/> jours
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="indexation_email_template_id"/>
                                <div class="text-muted">
                                    Template utilisé pour les notifications d'indexation
                                </div>
                                <div class="content-group">
                                    <field name="indexation_email_template_id"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2>Options avancées</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="indexation_auto_apply"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="indexation_auto_apply"/>
                                <div class="text-muted">
                                    Applique automatiquement l'indexation (non recommandé)
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="indexation_min_increase"/>
                                <div class="text-muted">
                                    Pourcentage minimum d'augmentation pour déclencher une indexation
                                </div>
                                <div class="content-group">
                                    <field name="indexation_min_increase"/> %
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="indexation_round_precision"/>
                                <div class="text-muted">
                                    Précision pour l'arrondi des nouveaux prix
                                </div>
                                <div class="content-group">
                                    <field name="indexation_round_precision"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
