<?xml version="1.0"?>
<odoo>

    <template id="report_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="lolirine_contract.report_contract_content"/>
            </t>
        </t>
    </template>

    <template id="report_contract_content">
        <t t-set="company" t-value="doc.company_id or res_company"/>
        <div class="page" style="font-family: Arial, sans-serif; font-size: 11pt;">
            <div style="text-align: center; margin-bottom: 20px;">
                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px;" alt="Logo"/>
                <h2 t-if="not company.logo" style="color: #c41e3a; font-size: 24pt; margin: 0;">Lolirine SPRL</h2>
                <p style="color: #c41e3a; margin: 0;">Garde-meubles</p>
            </div>
            <p style="text-align: center;">Le present contrat est conclu entre:</p>
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                <tr>
                    <td style="width: 45%; border: 1px solid #ccc; padding: 10px; background-color: #f9f9f9;">
                        <strong style="color: #c41e3a;">Le Bailleur (Srl Lolirine)</strong>
                    </td>
                    <td style="width: 10%; text-align: center;">Et,</td>
                    <td style="width: 45%; border: 1px solid #ccc; padding: 10px; background-color: #f9f9f9;">
                        <strong style="color: #c41e3a;">Le Preneur (Client)</strong>
                    </td>
                </tr>
                <tr>
                    <td style="border: 1px solid #ccc; padding: 10px;">
                        <strong>Srl Lolirine</strong><br/>
                        Rue Bois D Esneux 110<br/>
                        B - 5021 Boninne<br/><br/>
                        GSM: 0498/52.11.31<br/>
                        Mail: gardemeublelolirine@gmail.com
                    </td>
                    <td></td>
                    <td style="border: 1px solid #ccc; padding: 10px;">
                        <strong><t t-esc="doc.partner_id.name"/></strong><br/>
                        <t t-if="doc.partner_id.street"><t t-esc="doc.partner_id.street"/><br/></t>
                        B - <t t-esc="doc.partner_id.zip"/> <t t-esc="doc.partner_id.city"/><br/><br/>
                        <t t-if="doc.partner_id.mobile">GSM: <t t-esc="doc.partner_id.mobile"/><br/></t>
                        <t t-if="doc.partner_id.email">Mail: <t t-esc="doc.partner_id.email"/></t>
                    </td>
                </tr>
            </table>
            <h2 style="text-align: center; font-size: 14pt;">
                Bail n. <t t-esc="doc.name"/> de location garde-meubles
            </h2>
            <table style="width: 100%; margin-bottom: 20px;">
                <tr>
                    <td><strong>CODE ACCES:</strong> <t t-esc="doc.contract_access_code or '________'"/></td>
                    <td style="text-align: right;"><strong>CODE GERBEUR:</strong> <t t-esc="doc.contract_forklift_code or '________'"/></td>
                </tr>
            </table>
            <div style="background-color: #f5f5f5; padding: 8px; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">1. Objet du Contrat</strong>
            </div>
            <p>Location d un emplacement de garde-meubles:</p>
            <p><strong>Localisation:</strong> Rue de la Dreve Boninnas 2, B-5021 BONINNE</p>
            <t t-foreach="doc.order_line" t-as="line">
                <t t-if="line.product_id">
                    <p><strong>Box:</strong> <span style="color: #c41e3a;"><t t-esc="line.product_id.name"/></span></p>
                </t>
            </t>
            <div style="background-color: #f5f5f5; padding: 8px; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">2. Loyer</strong>
            </div>
            <p>Loyer mensuel: <strong><t t-esc="'%.2f' % doc.contract_monthly_rent"/> EUR</strong></p>
            <div style="background-color: #f5f5f5; padding: 8px; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">3. Depot de garantie</strong>
            </div>
            <p>Caution: <strong><t t-esc="'%.2f' % doc.contract_deposit_amount"/> EUR</strong> (2 mois)</p>
            <p>Compte: SRL LOLIRINE - BE30 7320 8038 9611</p>
            <div style="page-break-before: always;"></div>
            <div style="background-color: #f5f5f5; padding: 8px; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">4. Conditions generales</strong>
            </div>
            <p>Le locataire reconnait avoir pris connaissance des conditions generales.</p>
            <div style="background-color: #f5f5f5; padding: 8px; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">5. Signatures</strong>
            </div>
            <p style="margin-top: 30px;">
                Fait a <t t-esc="doc.contract_signature_location or 'Boninne'"/>,
                le <t t-if="doc.contract_signature_date"><t t-esc="doc.contract_signature_date"/></t><t t-else="">___/___/______</t>
            </p>
            <table style="width: 100%; margin-top: 50px;">
                <tr>
                    <td style="width: 50%; text-align: center;">
                        <strong>Le Bailleur</strong><br/><br/><br/>______________________
                    </td>
                    <td style="width: 50%; text-align: center;">
                        <strong>Le Preneur</strong><br/><br/><br/>______________________
                    </td>
                </tr>
            </table>
        </div>
    </template>

</odoo>
