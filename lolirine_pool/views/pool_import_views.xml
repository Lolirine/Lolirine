<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue formulaire log d'import -->
    <record id="pool_import_log_view_form" model="ir.ui.view">
        <field name="name">pool.import.log.form</field>
        <field name="model">pool.import.log</field>
        <field name="arch" type="xml">
            <form string="Import Piscine">
                <header>
                    <button name="action_process" 
                            type="object" 
                            string="Lancer l'import" 
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" 
                            type="object" 
                            string="Annuler"
                            invisible="state not in ['draft', 'processing']"/>
                    <button name="action_reset" 
                            type="object" 
                            string="Remettre en brouillon"
                            invisible="state not in ['done', 'error', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Import">
                            <field name="supplier_id"/>
                            <field name="import_method"/>
                            <field name="file_data" filename="file_name" invisible="import_method != 'csv'"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group string="Options">
                            <field name="update_existing"/>
                            <field name="create_category"/>
                            <field name="import_images"/>
                        </group>
                    </group>
                    <group string="Statistiques" invisible="state == 'draft'">
                        <group>
                            <field name="total_lines"/>
                            <field name="imported_count"/>
                            <field name="updated_count"/>
                        </group>
                        <group>
                            <field name="error_count"/>
                            <field name="skipped_count"/>
                        </group>
                    </group>
                    <group string="Erreur" invisible="state != 'error'">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Lignes importées" name="lines">
                            <field name="line_ids">
                                <list string="Lignes" decoration-success="state == 'done'" decoration-warning="state == 'updated'" decoration-danger="state == 'error'" decoration-muted="state == 'skipped'">
                                    <field name="product_ref"/>
                                    <field name="product_name"/>
                                    <field name="cost_price"/>
                                    <field name="category_name"/>
                                    <field name="brand_name"/>
                                    <field name="state"/>
                                    <field name="product_id"/>
                                    <field name="error_message" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue liste logs d'import -->
    <record id="pool_import_log_view_tree" model="ir.ui.view">
        <field name="name">pool.import.log.tree</field>
        <field name="model">pool.import.log</field>
        <field name="arch" type="xml">
            <list string="Imports Piscine" decoration-success="state == 'done'" decoration-danger="state == 'error'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="import_method"/>
                <field name="create_date"/>
                <field name="total_lines"/>
                <field name="imported_count"/>
                <field name="updated_count"/>
                <field name="error_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Vue recherche imports -->
    <record id="pool_import_log_view_search" model="ir.ui.view">
        <field name="name">pool.import.log.search</field>
        <field name="model">pool.import.log</field>
        <field name="arch" type="xml">
            <search string="Rechercher import">
                <field name="name"/>
                <field name="supplier_id"/>
                <filter string="Brouillon" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Terminé" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Erreur" name="error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="today" domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="false" string="Grouper par">
                    <filter string="Fournisseur" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action logs d'import -->
    <record id="pool_import_log_action" model="ir.actions.act_window">
        <field name="name">Historique des imports</field>
        <field name="res_model">pool.import.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun import effectué
            </p>
            <p>
                Les imports de produits apparaîtront ici.
            </p>
        </field>
    </record>

</odoo>
