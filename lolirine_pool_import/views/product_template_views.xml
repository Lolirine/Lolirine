<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
    <!-- Product Template Form Extension -->
    <record id="product_template_form_pool" model="ir.ui.view">
        <field name="name">product.template.form.pool</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_extractions"
                        icon="fa-crop"
                        invisible="x_pool_extraction_count == 0">
                    <field name="x_pool_extraction_count" widget="statinfo" string="Extractions"/>
                </button>
            </xpath>
            
            <!-- Bouton re-extraction dans le header -->
            <xpath expr="//form/header" position="inside">
                <button name="action_view_extraction_form"
                        string="Re-extraire images"
                        type="object"
                        class="btn-secondary"
                        icon="fa-crop"
                        invisible="not x_pool_supplier_id"/>
            </xpath>
            
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Piscine" name="pool_info">
                    <group>
                        <group string="Fournisseur">
                            <field name="x_pool_supplier_id"/>
                            <field name="x_pool_supplier_ref"/>
                            <field name="x_pool_brand"/>
                            <field name="x_pool_category"/>
                            <field name="x_pool_subcategory"/>
                        </group>
                        <group string="Rentabilité">
                            <field name="x_purchase_margin" widget="percentage"/>
                            <field name="x_profit_amount"/>
                        </group>
                    </group>
                    
                    <group string="Spécifications Techniques">
                        <group>
                            <field name="x_power_kw"/>
                            <field name="x_power_cv"/>
                            <field name="x_voltage"/>
                            <field name="x_flow_rate"/>
                        </group>
                        <group>
                            <field name="x_diameter_mm"/>
                            <field name="x_filter_area"/>
                            <field name="x_cop"/>
                            <field name="x_noise_level"/>
                        </group>
                    </group>
                    
                    <group string="Descriptions">
                        <field name="x_description_fr" colspan="2"/>
                        <field name="x_description_nl" colspan="2"/>
                    </group>
                    
                    <group string="Import">
                        <field name="x_pool_import_date" readonly="1"/>
                        <field name="x_pool_import_source" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product Template Tree Extension -->
    <record id="product_template_tree_pool" model="ir.ui.view">
        <field name="name">product.template.tree.pool</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="x_pool_supplier_id" optional="hide"/>
                <field name="x_pool_brand" optional="hide"/>
                <field name="x_pool_extraction_count" string="Extractions" optional="hide"/>
                <field name="x_purchase_margin" widget="percentage" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Search View Extension -->
    <record id="product_template_search_pool" model="ir.ui.view">
        <field name="name">product.template.search.pool</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Ajout de champs de recherche -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_pool_supplier_id"/>
                <field name="x_pool_brand"/>
            </xpath>
            <!-- Ajout des filtres piscine à la fin -->
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="pool_products" string="Produits Piscine" domain="[('x_pool_supplier_id', '!=', False)]"/>
                <filter name="with_extraction" string="Avec extraction" domain="[('x_pool_extraction_count', '>', 0)]"/>
                <filter name="without_extraction" string="Sans extraction" domain="[('x_pool_extraction_count', '=', 0), ('x_pool_supplier_id', '!=', False)]"/>
                <filter name="low_margin" string="Marge faible (&lt;25%)" domain="[('x_purchase_margin', '&lt;', 25)]"/>
                <separator/>
                <filter name="group_pool_supplier" string="Fournisseur Piscine" context="{'group_by': 'x_pool_supplier_id'}"/>
                <filter name="group_pool_brand" string="Marque" context="{'group_by': 'x_pool_brand'}"/>
                <filter name="group_pool_category" string="Catégorie Catalogue" context="{'group_by': 'x_pool_category'}"/>
            </xpath>
        </field>
    </record>

    <!-- Pool Products Action -->
    <record id="action_pool_products" model="ir.actions.act_window">
        <field name="name">Produits Piscine</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('x_pool_supplier_id', '!=', False)]</field>
        <field name="context">{'search_default_pool_products': 1}</field>
    </record>

    <!-- Pool Website Products Action (ALL products on pool store website) -->
    <record id="action_pool_website_products" model="ir.actions.act_window">
        <field name="name">Produits du site web</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[
            '|',
            ('x_pool_supplier_id', '!=', False),
            ('x_pool_import_source', '!=', False)
        ]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun produit piscine trouvé
            </p>
            <p>
                Les produits importés via l'extracteur de catalogue ou l'import JSON/CSV apparaîtront ici.
            </p>
        </field>
    </record>
    
    <!-- Server action: Batch re-extraction -->
    <record id="action_batch_reextraction" model="ir.actions.server">
        <field name="name">Créer extraction pour re-cadrage images</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_batch_create_reextraction()
        </field>
    </record>
    
    <!-- Server action: Sync website products -->
    <record id="action_sync_website_products" model="ir.actions.server">
        <field name="name">Synchroniser produits du site web</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_sync_website_products()
        </field>
    </record>
    
    <!-- Cron-like manual trigger via menu -->
    <record id="action_sync_website_products_menu" model="ir.actions.client">
        <field name="name">Synchroniser produits du site web</field>
        <field name="tag">display_notification</field>
    </record>

    </data>
</odoo>
