        <!-- ============================================================ -->
        <!-- Email Template: Annonce Portail - Basé sur Abonnements       -->
        <!-- Version compatible Gmail + syntaxe QWeb Odoo                 -->
        <!-- ============================================================ -->
        <record id="email_template_annonce_portail_subscription" model="mail.template">
            <field name="name">Lolirine - Annonce Portail Client (Abonnements)</field>
            <field name="model_id" ref="sale_subscription.model_sale_order"/>
            <field name="subject">Lolirine évolue : Découvrez votre nouvel espace client en ligne</field>
            <field name="email_from">gardemeublelolirine@gmail.com</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f5f5f5;font-family:Arial,sans-serif;">
<tr><td align="center" style="padding:20px;">
<table cellpadding="0" cellspacing="0" border="0" width="600" style="background-color:#ffffff;">

<!-- HEADER ROUGE -->
<tr><td align="center" bgcolor="#C91E18" style="padding:30px 40px;background-color:#C91E18;">
<font color="#ffffff" style="font-size:28px;font-weight:bold;">LOLIRINE</font><br/>
<font color="#ffcccc" style="font-size:14px;">GARDE-MEUBLES</font>
</td></tr>

<!-- CONTENU -->
<tr><td style="padding:40px;">

<p style="color:#333333;font-size:16px;margin:0 0 20px 0;">
Bonjour <t t-if="object.partner_id.name"><t t-out="object.partner_id.name"/></t><t t-else="">cher(e) client(e)</t>,
</p>

<p style="color:#555555;font-size:15px;margin:0 0 20px 0;line-height:1.6;">
Nous avons le plaisir de vous annoncer une évolution importante dans la gestion de nos services de garde-meubles.
</p>

<!-- BOX HIGHLIGHT -->
<table cellpadding="0" cellspacing="0" border="0" width="100%">
<tr>
<td width="4" bgcolor="#C91E18" style="background-color:#C91E18;"></td>
<td bgcolor="#fce8e8" style="background-color:#fce8e8;padding:20px;">
<font color="#8b1510" style="font-size:18px;font-weight:bold;">🚀 Lolirine se digitalise pour mieux vous servir.</font>
</td>
</tr>
</table>

<p style="color:#555555;font-size:15px;margin:25px 0 20px 0;line-height:1.6;">
Dans les prochaines semaines, nous mettons en place une nouvelle plateforme de gestion qui vous permettra de gérer votre abonnement en toute autonomie, <b>24h/24 et 7j/7</b>.
</p>

<!-- SECTION CE QUI CHANGE -->
<p style="color:#8b1510;font-size:18px;font-weight:bold;margin:30px 0 15px 0;border-bottom:2px solid #C91E18;padding-bottom:8px;">
✨ Ce qui change pour vous
</p>

<p style="color:#555555;font-size:15px;margin:0 0 15px 0;">
Une fois inscrit(e), vous pourrez :
</p>

<p style="color:#555555;font-size:14px;margin:0 0 8px 20px;"><font color="#C91E18"><b>✓</b></font> Consulter les détails de votre contrat et votre historique</p>
<p style="color:#555555;font-size:14px;margin:0 0 8px 20px;"><font color="#C91E18"><b>✓</b></font> Télécharger vos factures à tout moment</p>
<p style="color:#555555;font-size:14px;margin:0 0 8px 20px;"><font color="#C91E18"><b>✓</b></font> Suivre vos paiements en temps réel</p>
<p style="color:#555555;font-size:14px;margin:0 0 8px 20px;"><font color="#C91E18"><b>✓</b></font> Mettre à jour vos informations personnelles</p>
<p style="color:#555555;font-size:14px;margin:0 0 8px 20px;"><font color="#C91E18"><b>✓</b></font> Communiquer directement avec notre équipe</p>

<!-- BOUTON CTA -->
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:35px 0;">
<tr><td align="center">
<table cellpadding="0" cellspacing="0" border="0">
<tr>
<td bgcolor="#C91E18" style="background-color:#C91E18;padding:18px 45px;border-radius:8px;">
