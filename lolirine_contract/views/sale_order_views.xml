<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_contract_fields" model="ir.ui.view">
        <field name="name">sale.order.form.contract.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Contrat" name="contract_info" invisible="not is_subscription">
                    <group>
                        <group string="Codes">
                            <field name="contract_access_code"/>
                            <field name="contract_forklift_code"/>
                        </group>
                        <group string="Dates">
                            <field name="contract_signature_date"/>
                            <field name="contract_deposit_date"/>
                            <field name="contract_signature_location"/>
                        </group>
                    </group>
                    <group>
                        <group string="Montants">
                            <field name="contract_monthly_rent" readonly="1"/>
                            <field name="contract_dossier_fees" readonly="1"/>
                            <field name="contract_deposit_amount" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Caution / Dépôt de garantie"/>
                    <group>
                        <group string="Statut">
                            <field name="contract_deposit_state" widget="badge"
                                decoration-success="contract_deposit_state == 'received'"
                                decoration-warning="contract_deposit_state == 'refunded'"
                                decoration-danger="contract_deposit_state == 'not_received'"
                            />
                            <field name="contract_deposit_received_date"
                                invisible="contract_deposit_state == 'not_received'"/>
                            <field name="contract_deposit_refund_date"
                                invisible="contract_deposit_state != 'refunded'"/>
                        </group>
                        <group string="Transaction bancaire">
                            <field name="contract_deposit_move_id"
                                invisible="contract_deposit_state == 'not_received'"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>
                    <separator string="Carte d'identité du client"/>
                    <group>
                        <group string="Recto">
                            <field name="partner_id_card_recto" widget="image" options="{'size': [250, 160]}" readonly="1" string=""/>
                        </group>
                        <group string="Verso">
                            <field name="partner_id_card_verso" widget="image" options="{'size': [250, 160]}" readonly="1" string=""/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="partner_id_card_uploaded">
                        <strong>Attention:</strong> Le client n'a pas encore fourni sa carte d'identité.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Boutons header -->
    <record id="view_order_form_contract_button" model="ir.ui.view">
        <field name="name">sale.order.form.contract.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_preview_quotation" type="object" string="Aperçu devis"
                    class="btn-secondary"
                    invisible="not is_subscription or state == 'sale'"/>
                <button name="action_send_quotation" type="object" string="Envoyer le devis"
                    class="btn-secondary"
                    invisible="not is_subscription or state == 'sale'"/>
                <button name="action_switch_to_location" type="object" string="Passer en location"
                    class="btn-primary"
                    invisible="not is_subscription or state != 'sale' or not note"
                    confirm="Cela va changer le modèle vers 'Location de box mensuelle' et retirer les conditions générales. Continuer ?"/>
                <button name="action_preview_contract" type="object" string="Aperçu contrat"
                    class="btn-secondary"
                    invisible="state != 'sale' or not is_subscription"/>
                <button name="action_send_contract" type="object" string="Envoyer le contrat"
                    class="btn-secondary"
                    invisible="state != 'sale' or not is_subscription"/>
                <button name="action_mark_deposit_received" type="object"
                    string="✓ Caution reçue"
                    class="btn-success"
                    invisible="contract_deposit_state != 'not_received' or not is_subscription"
                    confirm="Marquer la caution comme versée ?"/>
                <button name="action_mark_deposit_refunded" type="object"
                    string="↩ Caution remboursée"
                    class="btn-warning"
                    invisible="contract_deposit_state != 'received' or not is_subscription"
                    confirm="Marquer la caution comme remboursée ?"/>
            </xpath>
        </field>
    </record>
</odoo>
