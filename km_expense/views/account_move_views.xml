<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Bouton sur les factures fournisseurs -->
    <!-- ============================================ -->
    
    <record id="view_move_form_inherit_km_expense" model="ir.ui.view">
        <field name="name">account.move.form.inherit.km_expense</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter le bouton dans la zone des boutons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_km_trajets" type="object"
                        class="oe_stat_button" icon="fa-road"
                        invisible="km_trajet_count == 0">
                    <field name="km_trajet_count" widget="statinfo" string="Trajets"/>
                </button>
            </xpath>
            
            <!-- Ajouter les boutons "Créer trajet" après les boutons d'action -->
            <xpath expr="//header" position="inside">
                <button name="action_create_km_trajet" string="Créer trajet (wizard)" 
                        type="object" class="btn-secondary"
                        invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund') or km_trajet_count > 0"
                        icon="fa-car"/>
                <button name="action_create_km_trajet_auto" string="Créer trajet auto" 
                        type="object" class="btn-secondary"
                        invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund') or km_trajet_count > 0"
                        icon="fa-magic"
                        confirm="Créer automatiquement un trajet pour cette facture ?"/>
            </xpath>
            
            <!-- Champs cachés pour le trajet automatique -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="km_skip_auto_trajet" invisible="1"/>
                <field name="km_trajet_auto_created" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Action serveur pour créer des trajets en masse -->
    <record id="action_create_km_trajets_batch" model="ir.actions.server">
        <field name="name">Créer trajets KM</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_create_km_trajets_batch()
        </field>
    </record>

</odoo>
