<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron pour vérifier les changements de trimestre -->
        <record id="ir_cron_check_trimestre_bareme" model="ir.cron">
            <field name="name">IK: Vérifier changement de trimestre</field>
            <field name="model_id" ref="model_km_bareme"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_trimestre_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        
    </data>
</odoo>
