<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="apartment_property_view_form" model="ir.ui.view">
        <field name="name">apartment.property.form</field>
        <field name="model">apartment.property</field>
        <field name="arch" type="xml">
            <form string="Bien Immobilier">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,rented,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leases" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="lease_count" widget="statinfo" string="Baux"/>
                        </button>
                        <button name="action_view_inventories" type="object" class="oe_stat_button" icon="fa-clipboard">
                            <field name="inventory_count" widget="statinfo" string="États des lieux"/>
                        </button>
                        <button name="action_view_visits" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="visit_count" widget="statinfo" string="Visites"/>
                        </button>
                        <button name="action_view_interventions" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="intervention_count" widget="statinfo" string="Interventions"/>
                        </button>
                        <button name="action_view_initial_photos" type="object" class="oe_stat_button" icon="fa-camera">
                            <field name="initial_photo_count" widget="statinfo" string="Photos initiales"/>
                        </button>
                        <button name="action_view_maintenance_contracts" type="object" class="oe_stat_button" icon="fa-cogs">
                            <field name="maintenance_contract_count" widget="statinfo" string="Contrats"/>
                        </button>
                    </div>
                    <field name="image_main" widget="image" class="oe_avatar" options="{'preview_image': 'image_main', 'size': [128, 128]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nom du bien"/>
                        </h1>
                        <field name="reference" readonly="1"/>
                    </div>
                    <group>
                        <group string="Adresse">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="zip_code"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Caractéristiques">
                            <field name="property_type"/>
                            <field name="surface" widget="float"/>
                            <field name="num_rooms"/>
                            <field name="num_bedrooms"/>
                            <field name="num_bathrooms"/>
                            <field name="floor"/>
                            <field name="has_elevator"/>
                        </group>
                    </group>
                    <group>
                        <group string="Énergie">
                            <field name="energy_class"/>
                            <field name="peb_certificate"/>
                            <field name="peb_expiry_date"/>
                            <field name="heating_type"/>
                        </group>
                        <group string="Finances">
                            <field name="monthly_rent"/>
                            <field name="monthly_charges"/>
                            <field name="cadastral_income"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description détaillée du bien..."/>
                        </page>
                        <page string="Équipements" name="equipment">
                            <field name="equipment" placeholder="Liste des équipements..."/>
                        </page>
                        <page string="Photos" name="photos">
                            <field name="image_ids"/>
                        </page>
                        <page string="Photos initiales" name="initial_photos">
                            <group>
                                <field name="initial_photo_date"/>
                            </group>
                            <field name="initial_photo_ids">
                                <kanban>
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="image_thumbnail"/>
                                    <field name="room_type_id"/>
                                    <field name="photo_type"/>
                                    <field name="taken_date"/>
                                    <templates>
                                        <t t-name="card">
                                            <field name="image_thumbnail" widget="image" options="{'size': [150, 150]}"/>
                                            <div class="mt-2">
                                                <field name="name" class="fw-bold"/>
                                            </div>
                                            <div class="text-muted small">
                                                <field name="room_type_id"/> - <field name="photo_type"/>
                                            </div>
                                            <div class="text-muted small">
                                                <field name="taken_date"/>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Contrats d'entretien" name="maintenance_contracts">
                            <field name="maintenance_contract_ids">
                                <list decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'">
                                    <field name="name"/>
                                    <field name="contract_type"/>
                                    <field name="provider_id"/>
                                    <field name="payment_amount"/>
                                    <field name="payment_frequency"/>
                                    <field name="next_payment_date"/>
                                    <field name="days_until_payment"/>
                                    <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Compteurs" name="meters">
                            <field name="meter_ids"/>
                        </page>
                        <page string="Locataire Actuel" name="current_tenant" invisible="state != 'rented'">
                            <group>
                                <field name="current_lease_id"/>
                                <field name="current_tenant_id"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="apartment_property_view_tree" model="ir.ui.view">
        <field name="name">apartment.property.tree</field>
        <field name="model">apartment.property</field>
        <field name="arch" type="xml">
            <list string="Biens Immobiliers" decoration-success="state == 'available'" decoration-info="state == 'rented'" decoration-warning="state == 'maintenance'">
                <field name="reference"/>
                <field name="name"/>
                <field name="city"/>
                <field name="property_type"/>
                <field name="surface"/>
                <field name="num_rooms"/>
                <field name="monthly_rent"/>
                <field name="current_tenant_id"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-info="state == 'rented'" decoration-warning="state == 'maintenance'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="apartment_property_view_kanban" model="ir.ui.view">
        <field name="name">apartment.property.kanban</field>
        <field name="model">apartment.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="city"/>
                <field name="monthly_rent"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="city"/>
                        <div><field name="monthly_rent"/> € /mois</div>
                        <field name="state" widget="badge" decoration-success="state == 'available'" decoration-info="state == 'rented'" decoration-warning="state == 'maintenance'"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="apartment_property_view_search" model="ir.ui.view">
        <field name="name">apartment.property.search</field>
        <field name="model">apartment.property</field>
        <field name="arch" type="xml">
            <search string="Rechercher un bien">
                <field name="name"/>
                <field name="reference"/>
                <field name="city"/>
                <filter string="Disponible" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Loué" name="rented" domain="[('state', '=', 'rented')]"/>
                <filter string="En maintenance" name="maintenance" domain="[('state', '=', 'maintenance')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="apartment_property_action" model="ir.actions.act_window">
        <field name="name">Biens Immobiliers</field>
        <field name="res_model">apartment.property</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="apartment_property_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier bien immobilier
            </p>
            <p>
                Gérez vos biens en location : appartements, maisons, studios...
            </p>
        </field>
    </record>

</odoo>
