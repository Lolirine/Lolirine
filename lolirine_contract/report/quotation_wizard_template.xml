<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rapport pour le devis wizard -->
    <record id="action_report_quotation_wizard" model="ir.actions.report">
        <field name="name">Devis Lolirine (General)</field>
        <field name="model">lolirine.quotation.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_contract.report_quotation_wizard_document</field>
        <field name="report_file">lolirine_contract.report_quotation_wizard_document</field>
        <field name="print_report_name">'Devis_Lolirine'</field>
    </record>
    
    <!-- Template du devis wizard -->
    <template id="report_quotation_wizard_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <div class="article" style="font-family: Arial, sans-serif; font-size: 11pt; padding: 20px;">
                    <meta charset="UTF-8"/>
                    
                    <!-- En-tête avec logo et coordonnées -->
                    <table style="width: 100%; margin-bottom: 30px;">
                        <tr>
                            <td style="width: 50%; vertical-align: top;">
                                <img t-if="wizard.env.company.logo" t-att-src="image_data_uri(wizard.env.company.logo)" style="max-height: 100px; max-width: 250px;" alt="Logo"/>
                            </td>
                            <td style="width: 50%; vertical-align: top; text-align: right;">
                                <table style="margin-left: auto; border: 1px solid #ccc; padding: 10px;">
                                    <tr><td style="text-align: right; padding: 3px;"><strong>Lolirine Garde-Meubles</strong></td></tr>
                                    <tr><td style="text-align: right; padding: 3px;">Rue Bois d'Esneux 110, 5021 Boninne</td></tr>
                                    <tr><td style="text-align: right; padding: 3px;">Tél: +32 497 44 41 46 - +32 498 52 11 31</td></tr>
                                    <tr><td style="text-align: right; padding: 3px;">E-mail: gardemeublelolirine@gmail.com</td></tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                    
                    <!-- Informations client (si présent) et date -->
                    <table style="width: 100%; margin-bottom: 25px;">
                        <tr>
                            <td style="width: 55%; vertical-align: top;">
                                <t t-if="wizard.partner_id">
                                    <table style="border: 1px solid #ccc;">
                                        <tr>
                                            <td style="padding: 8px; vertical-align: top; width: 60px;"><strong>Client:</strong></td>
                                            <td style="padding: 8px;">
                                                <strong><t t-esc="wizard.partner_id.name"/></strong><br/>
                                                <t t-if="wizard.partner_id.street"><t t-esc="wizard.partner_id.street"/>, </t>
                                                <t t-if="wizard.partner_id.city"><t t-esc="wizard.partner_id.city"/>,</t><br/>
                                                <t t-if="wizard.partner_id.country_id"><t t-esc="wizard.partner_id.country_id.name"/></t>
                                            </td>
                                        </tr>
                                    </table>
                                </t>
                                <t t-else="">
                                    <table style="border: 1px solid #ccc;">
                                        <tr>
                                            <td style="padding: 8px; vertical-align: top; width: 60px;"><strong>Client:</strong></td>
                                            <td style="padding: 8px;">
                                                <em style="color: #666;">____________________________________</em><br/>
                                                <em style="color: #666;">____________________________________</em><br/>
                                                <em style="color: #666;">____________________________________</em>
                                            </td>
                                        </tr>
                                    </table>
                                </t>
                            </td>
                            <td style="width: 45%; vertical-align: top;">
                                <table style="margin-left: auto; border: 1px solid #ccc;">
                                    <tr>
                                        <td style="padding: 8px; text-align: right;">Date du devis:</td>
                                        <td style="padding: 8px; text-align: right;"><strong><t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></strong></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px; text-align: right;">Devis N°:</td>
                                        <td style="padding: 8px; text-align: right;"><strong>DEV/<t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y')"/>/XXXX</strong></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                    
                    <!-- Objet -->
                    <h2 style="color: #c0392b; font-size: 16pt; margin-bottom: 20px;">
                        Objet : Offre de prix pour la location d'un box de stockage
                    </h2>
                    
                    <!-- Tableau des lignes -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                        <thead>
                            <tr style="background-color: #c0392b; color: white;">
                                <th style="padding: 10px; text-align: left; width: 50%;">Désignation</th>
                                <th style="padding: 10px; text-align: center; width: 10%;">Qté</th>
                                <th style="padding: 10px; text-align: right; width: 20%;">Prix unit. HTVA</th>
                                <th style="padding: 10px; text-align: right; width: 20%;">Total HTVA</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="wizard.line_ids" t-as="line">
                                <tr style="border-bottom: 1px solid #eee;">
                                    <td style="padding: 10px;"><t t-esc="line.product_id.display_name"/></td>
                                    <td style="padding: 10px; text-align: center;"><t t-esc="int(line.quantity)"/></td>
                                    <td style="padding: 10px; text-align: right;"><t t-esc="'%.2f' % line.price_unit"/> €</td>
                                    <td style="padding: 10px; text-align: right;"><t t-esc="'%.2f' % line.subtotal"/> €</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <!-- Totaux -->
                    <table style="width: 250px; margin-left: auto; margin-bottom: 30px;">
                        <tr>
                            <td style="padding: 5px; text-align: right;">Total HTVA:</td>
                            <td style="padding: 5px; text-align: right; width: 100px;"><t t-esc="'%.2f' % wizard.amount_untaxed"/> €</td>
                        </tr>
                        <tr>
                            <td style="padding: 5px; text-align: right;">TVA (21%):</td>
                            <td style="padding: 5px; text-align: right;"><t t-esc="'%.2f' % wizard.amount_tax"/> €</td>
                        </tr>
                        <tr style="font-weight: bold; font-size: 14pt;">
                            <td style="padding: 10px 5px; text-align: right;">Total TVAC:</td>
                            <td style="padding: 10px 5px; text-align: right;"><t t-esc="'%.2f' % wizard.amount_total"/> €</td>
                        </tr>
                    </table>
                    
                    <!-- Conditions -->
                    <div style="margin-bottom: 30px;">
                        <h3 style="font-size: 12pt; margin-bottom: 10px; border-bottom: 1px solid #ccc; padding-bottom: 5px;">Conditions et validité de l'offre</h3>
                        <div style="font-size: 9pt; line-height: 1.6;">
                            <p style="margin: 2px 0;">Durée minimale : 1 mois.</p>
                            <p style="margin: 2px 0;">Caution : 2 mois de loyer, à verser avant l'entrée dans les lieux.</p>
                            <p style="margin: 2px 0;">Frais de dossier : 15 €, non remboursables.</p>
                            <p style="margin: 2px 0;">Paiement : à terme échu (le paiement intervient en fin de période de location).</p>
                            <p style="margin: 2px 0;">Préavis de départ : le client doit prévenir 15 jours avant la fin de la période en cours.</p>
                            <p style="margin: 2px 0;">Assurance : le locataire doit souscrire sa propre assurance couvrant le contenu entreposé et les risques liés à l'occupation du box.</p>
                            <p style="margin: 2px 0;">Accès et usage : l'espace loué est strictement réservé au stockage de biens licites et non dangereux.</p>
                            <p style="margin: 2px 0;">Montant indiqué : tous les montants sont TVAC (toutes taxes comprises).</p>
                            <p style="margin: 2px 0;">Renouvellement : tacite de mois en mois sauf préavis respecté.</p>
                            <p style="margin: 2px 0;">Restitution : le box doit être vidé et rendu propre à la fin de la location.</p>
                            <p style="margin: 2px 0;">Validité du devis : 30 jours à compter de sa date d'émission.</p>
                        </div>
                    </div>
                    
                    <!-- Signature -->
                    <div style="margin-top: 40px;">
                        <p style="margin-bottom: 5px;">Pour accord, le client:</p>
                        <div style="border-bottom: 1px solid #333; width: 250px; height: 40px;"></div>
                        <p style="margin-top: 20px; margin-bottom: 5px;">Date:</p>
                        <div style="border-bottom: 1px solid #333; width: 250px; height: 25px;"></div>
                    </div>
                    
                </div>
            </t>
        </t>
    </template>
</odoo>
