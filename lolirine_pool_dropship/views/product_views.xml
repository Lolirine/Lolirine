<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- EXTENSION FORMULAIRE PRODUIT -->
    <!-- ============================================ -->

    <record id="view_product_template_form_dropship" model="ir.ui.view">
        <field name="name">product.template.form.dropship</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Onglet Dropshipping -->
            <xpath expr="//notebook" position="inside">
                <page string="Dropshipping" name="dropship_tab"
                      invisible="not is_dropship_product">
                    <group>
                        <group string="Configuration">
                            <field name="is_dropship_product"/>
                            <field name="preferred_dropship_supplier_id" 
                                   domain="[('is_dropship_supplier', '=', True)]"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Résumé">
                            <field name="dropship_supplier_count" string="Nb fournisseurs"/>
                        </group>
                    </group>
                    <field name="dropship_supplier_ids" string="Fournisseurs dropship">
                        <list editable="bottom">
                            <field name="supplier_id" string="Fournisseur"
                                   domain="[('is_dropship_supplier', '=', True)]"/>
                            <field name="price" string="Prix catalogue HT"/>
                            <field name="discount_percent" string="Réduction %"/>
                            <field name="negotiated_price" string="Prix négocié HT" readonly="1"/>
                            <field name="delay" string="Délai (j)"/>
                            <field name="is_priority" string="Prioritaire"/>
                            <field name="is_active" string="Actif"/>
                            <field name="supplier_product_ref" string="Réf. fournisseur" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- VUE LISTE PRODUITS DROPSHIP -->
    <!-- ============================================ -->

    <record id="view_product_template_dropship_list" model="ir.ui.view">
        <field name="name">product.template.dropship.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Produits Dropship" default_order="name asc"
                  decoration-muted="dropship_supplier_count == 0">
                <field name="name" string="Produit"/>
                <field name="default_code" string="Réf."/>
                <field name="list_price" string="Prix vente HT"/>
                <field name="preferred_dropship_supplier_id" string="Fournisseur préféré"
                       domain="[('is_dropship_supplier', '=', True)]"
                       options="{'no_create': True}"/>
                <field name="dropship_supplier_count" string="Nb fourn."
                       decoration-danger="dropship_supplier_count == 0"/>
                <field name="categ_id" string="Catégorie" optional="show"/>
                <field name="is_dropship_product" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_product_template_dropship_search" model="ir.ui.view">
        <field name="name">product.template.dropship.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Produits Dropship">
                <field name="name"/>
                <field name="default_code"/>
                <field name="categ_id"/>
                <filter string="Sans fournisseur" name="no_supplier"
                        domain="[('dropship_supplier_count', '=', 0)]"/>
                <filter string="Avec fournisseur" name="with_supplier"
                        domain="[('dropship_supplier_count', '>', 0)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Catégorie" name="group_categ" context="{'group_by': 'categ_id'}"/>
                    <filter string="Fournisseur préféré" name="group_supplier"
                            context="{'group_by': 'preferred_dropship_supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Catalogue produits dropship -->
    <record id="action_product_dropship_catalog" model="ir.actions.act_window">
        <field name="name">Catalogue Dropship</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_dropship_product', '=', True), ('website_id', '=', 6)]</field>
        <field name="search_view_id" ref="view_product_template_dropship_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_template_dropship_list')})]"/>
    </record>

    <!-- Action: Produits sans fournisseur -->
    <record id="action_product_dropship_no_supplier" model="ir.actions.act_window">
        <field name="name">Sans fournisseur</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_dropship_product', '=', True), ('website_id', '=', 6), ('dropship_supplier_count', '=', 0)]</field>
        <field name="search_view_id" ref="view_product_template_dropship_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_template_dropship_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tous les produits ont un fournisseur !
            </p>
        </field>
    </record>

</odoo>
