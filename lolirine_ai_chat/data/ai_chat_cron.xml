<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate="1">
    <record id="cron_ai_chat_knowledge" model="ir.cron">
        <field name="name">Assistant IA : relire le contenu du site</field>
        <field name="model_id" ref="model_ai_chat_knowledge"/>
        <field name="state">code</field>
        <field name="code">model._cron_reconstruire()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:30:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
