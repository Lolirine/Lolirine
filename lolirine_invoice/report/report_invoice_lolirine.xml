<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Définition du rapport -->
    <record id="action_report_invoice_lolirine" model="ir.actions.report">
        <field name="name">Facture Lolirine</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_invoice.report_invoice_lolirine</field>
        <field name="report_file">lolirine_invoice.report_invoice_lolirine</field>
        <field name="print_report_name">'Facture_%s' % (object.name or 'Brouillon').replace('/','_')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Template principal -->
    <template id="report_invoice_lolirine">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="lolirine_invoice.report_invoice_lolirine_document"/>
            </t>
        </t>
    </template>

    <!-- Document de facture -->
    <template id="report_invoice_lolirine_document">
        <div class="article" style="font-family: Arial, sans-serif; font-size: 9pt; padding: 0; margin: 0;">
            <!-- Style CSS optimise -->
            <style>
                @page {
                    margin: 10mm;
                    margin-top: 5mm;
                    margin-bottom: 15mm;
                }
                .lolirine-invoice {
                    font-family: Arial, sans-serif;
                    font-size: 9pt;
                    color: #333;
                    padding: 0;
                    margin: 0;
                }
                .lolirine-logo {
                    max-height: 50px;
                    max-width: 150px;
                }
                .lolirine-company-info {
                    text-align: right;
                    font-size: 8pt;
                    line-height: 1.3;
                }
                .lolirine-slogan {
                    color: #c0392b;
                    font-style: italic;
                    font-size: 9pt;
                    margin-top: 3px;
                }
                .lolirine-client-block {
                    margin: 10px 0;
                    font-size: 9pt;
                }
                .lolirine-title {
                    color: #c0392b;
                    font-size: 16pt;
                    font-weight: bold;
                    margin: 10px 0;
                }
                .lolirine-dates-table {
                    width: 100%;
                    margin: 8px 0;
                    font-size: 8pt;
                }
                .lolirine-dates-table td {
                    padding: 3px 8px;
                    border: 1px solid #ddd;
                }
                .lolirine-dates-table .label {
                    background-color: #f8f9fa;
                    font-weight: bold;
                    width: 30%;
                }
                .lolirine-lines-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin: 10px 0;
                    font-size: 8pt;
                }
                .lolirine-lines-table th {
                    background-color: #c0392b;
                    color: white;
                    padding: 6px;
                    text-align: left;
                    font-weight: bold;
                }
                .lolirine-lines-table td {
                    padding: 5px;
                    border-bottom: 1px solid #eee;
                }
                .lolirine-lines-table tr:nth-child(even) {
                    background-color: #f9f9f9;
                }
                .lolirine-totals {
                    width: 40%;
                    float: right;
                    margin-top: 10px;
                    font-size: 9pt;
                }
                .lolirine-totals td {
                    padding: 4px 8px;
                }
                .lolirine-totals .total-line {
                    font-weight: bold;
                    font-size: 11pt;
                    background-color: #c0392b;
                    color: white;
                }
                .lolirine-payment-info {
                    clear: both;
                    margin-top: 15px;
                    padding: 8px;
                    background-color: #f8f9fa;
                    border-left: 3px solid #c0392b;
                    font-size: 8pt;
                }
                .lolirine-footer {
                    margin-top: 15px;
                    padding-top: 8px;
                    border-top: 1px solid #ddd;
                    font-size: 7pt;
                    color: #666;
                    text-align: center;
                }
            </style>

            <div class="lolirine-invoice">
                <!-- En-tete avec logo et infos societe -->
                <table style="width: 100%; margin-bottom: 10px;">
                    <tr>
                        <td style="width: 50%; vertical-align: top;">
                            <t t-if="o.company_id.logo">
                                <img t-att-src="image_data_uri(o.company_id.logo)" class="lolirine-logo"/>
                            </t>
                            <div class="lolirine-slogan">Votre espace, notre priorite</div>
                        </td>
                        <td style="width: 50%; vertical-align: top;" class="lolirine-company-info">
                            <strong><t t-esc="o.company_id.name"/></strong><br/>
                            <t t-if="o.company_id.street"><t t-esc="o.company_id.street"/><br/></t>
                            <t t-if="o.company_id.zip or o.company_id.city">
                                <t t-esc="o.company_id.zip"/> <t t-esc="o.company_id.city"/><br/>
                            </t>
                            <t t-if="o.company_id.phone">Tel: <t t-esc="o.company_id.phone"/><br/></t>
                            <t t-if="o.company_id.email"><t t-esc="o.company_id.email"/><br/></t>
                            <t t-if="o.company_id.vat">TVA: <t t-esc="o.company_id.vat"/></t>
                        </td>
                    </tr>
                </table>

                <!-- Bloc client - CORRIGE: suppression de partner_id.title -->
                <div class="lolirine-client-block">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 60%;"></td>
                            <td style="width: 40%; border: 1px solid #ddd; padding: 10px; background-color: #fafafa;">
                                <strong><t t-esc="o.partner_id.name"/></strong><br/>
                                <t t-if="o.partner_id.street"><t t-esc="o.partner_id.street"/><br/></t>
                                <t t-if="o.partner_id.street2"><t t-esc="o.partner_id.street2"/><br/></t>
                                <t t-esc="o.partner_id.zip"/> <t t-esc="o.partner_id.city"/><br/>
                                <t t-if="o.partner_id.country_id"><t t-esc="o.partner_id.country_id.name"/><br/></t>
                                <t t-if="o.partner_id.vat">TVA: <t t-esc="o.partner_id.vat"/></t>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Titre facture -->
                <div class="lolirine-title">
                    <t t-if="o.move_type == 'out_invoice'">
                        <t t-if="o.state == 'posted'">Facture <t t-esc="o.name"/></t>
                        <t t-else="">Facture Brouillon</t>
                    </t>
                    <t t-elif="o.move_type == 'out_refund'">
                        Avoir <t t-esc="o.name or 'Brouillon'"/>
                    </t>
                </div>

                <!-- Tableau des dates -->
                <table class="lolirine-dates-table">
                    <tr>
                        <td class="label">Date de facture</td>
                        <td><t t-esc="o.invoice_date" t-options='{"widget": "date"}'/></td>
                        <td class="label">Date d'echeance</td>
                        <td><t t-esc="o.invoice_date_due" t-options='{"widget": "date"}'/></td>
                    </tr>
                    <tr t-if="o.invoice_origin">
                        <td class="label">Reference</td>
                        <td colspan="3"><t t-esc="o.invoice_origin"/></td>
                    </tr>
                    <tr t-if="o.ref">
                        <td class="label">Communication</td>
                        <td colspan="3"><t t-esc="o.ref"/></td>
                    </tr>
                </table>

                <!-- Tableau des lignes -->
                <table class="lolirine-lines-table">
                    <thead>
                        <tr>
                            <th style="width: 45%;">Description</th>
                            <th style="width: 10%; text-align: center;">Qte</th>
                            <th style="width: 15%; text-align: right;">Prix unit.</th>
                            <th style="width: 10%; text-align: center;">TVA</th>
                            <th style="width: 20%; text-align: right;">Total HT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids.filtered(lambda l: not l.display_type)" t-as="line">
                            <tr>
                                <td>
                                    <strong><t t-esc="line.product_id.name or line.name"/></strong>
                                    <t t-if="line.name and line.name != line.product_id.name">
                                        <br/><span style="font-size: 7pt; color: #666;"><t t-esc="line.name"/></span>
                                    </t>
                                </td>
                                <td style="text-align: center;"><t t-esc="line.quantity"/> <t t-esc="line.product_uom_id.name"/></td>
                                <td style="text-align: right;"><t t-esc="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td style="text-align: center;">
                                    <t t-foreach="line.tax_ids" t-as="tax">
                                        <t t-esc="tax.amount"/>%
                                    </t>
                                </td>
                                <td style="text-align: right;"><t t-esc="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Totaux -->
                <table class="lolirine-totals">
                    <tr>
                        <td>Total HT</td>
                        <td style="text-align: right;"><t t-esc="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                    </tr>
                    <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                        <tr>
                            <td><t t-esc="amount_by_group[0]"/></td>
                            <td style="text-align: right;"><t t-esc="amount_by_group[1]" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                    </t>
                    <tr class="total-line">
                        <td>TOTAL TTC</td>
                        <td style="text-align: right;"><t t-esc="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                    </tr>
                    <tr t-if="o.amount_residual and o.amount_residual != o.amount_total">
                        <td>Reste a payer</td>
                        <td style="text-align: right;"><t t-esc="o.amount_residual" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                    </tr>
                </table>

                <!-- Informations de paiement -->
                <div class="lolirine-payment-info">
                    <strong>Modalites de paiement :</strong><br/>
                    Paiement a effectuer avant le <t t-esc="o.invoice_date_due" t-options='{"widget": "date"}'/><br/>
                    <t t-if="o.company_id.partner_id.bank_ids">
                        <t t-set="bank" t-value="o.company_id.partner_id.bank_ids[0]"/>
                        Compte bancaire : <strong><t t-esc="bank.acc_number"/></strong>
                        <t t-if="bank.bank_id"> - <t t-esc="bank.bank_id.name"/></t>
                        <br/>
                    </t>
                    <t t-if="o.payment_reference">
                        Communication structuree : <strong><t t-esc="o.payment_reference"/></strong>
                    </t>
                </div>

                <!-- Notes -->
                <t t-if="o.narration">
                    <div style="margin-top: 10px; font-size: 8pt;">
                        <strong>Notes :</strong><br/>
                        <t t-raw="o.narration"/>
                    </div>
                </t>

                <!-- Footer -->
                <div class="lolirine-footer">
                    <t t-esc="o.company_id.name"/> - 
                    <t t-if="o.company_id.street"><t t-esc="o.company_id.street"/>, </t>
                    <t t-esc="o.company_id.zip"/> <t t-esc="o.company_id.city"/>
                    <t t-if="o.company_id.phone"> - Tel: <t t-esc="o.company_id.phone"/></t>
                    <t t-if="o.company_id.email"> - <t t-esc="o.company_id.email"/></t>
                    <t t-if="o.company_id.website"> - <t t-esc="o.company_id.website"/></t>
                    <br/>
                    <t t-if="o.company_id.vat">TVA: <t t-esc="o.company_id.vat"/></t>
                    <t t-if="o.company_id.partner_id.bank_ids">
                         | <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.name or ''"/>: <t t-esc="o.company_id.partner_id.bank_ids[0].acc_number"/>
                    </t>
                </div>
            </div>
        </div>

        <!-- Saut de page entre les factures -->
        <p style="page-break-after: always;"/>
    </template>
</odoo>
