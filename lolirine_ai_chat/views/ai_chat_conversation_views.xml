<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- CONVERSATION TREE VIEW -->
    <!-- ============================================================ -->
    <record id="view_ai_chat_conversation_tree" model="ir.ui.view">
        <field name="name">ai.chat.conversation.tree</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversations IA"
                   decoration-info="state == 'active'"
                   decoration-muted="state == 'archived'">
                <field name="display_name"/>
                <field name="partner_id" optional="show"/>
                <field name="visitor_name" optional="hide"/>
                <field name="first_message" optional="show"/>
                <field name="message_count" string="Messages"/>
                <field name="web_searches_count" string="Recherches" optional="show"/>
                <field name="start_date"/>
                <field name="last_message_date"/>
                <field name="duration_minutes" string="Durée (min)" optional="show"/>
                <field name="rating" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'closed'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- CONVERSATION FORM VIEW -->
    <!-- ============================================================ -->
    <record id="view_ai_chat_conversation_form" model="ir.ui.view">
        <field name="name">ai.chat.conversation.form</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation IA">
                <header>
                    <button name="action_close" type="object" string="Terminer"
                            class="btn-primary"
                            invisible="state != 'active'"/>
                    <button name="action_archive" type="object" string="Archiver"
                            invisible="state != 'closed'"/>
                    <button name="action_reopen" type="object" string="Réouvrir"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,closed,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="session_id"/>
                            <field name="partner_id"/>
                            <field name="visitor_name"/>
                            <field name="rating" widget="priority"/>
                        </group>
                        <group string="Statistiques">
                            <field name="message_count"/>
                            <field name="web_searches_count"/>
                            <field name="start_date"/>
                            <field name="last_message_date"/>
                            <field name="duration_minutes"/>
                        </group>
                    </group>
                    <group string="Métadonnées" groups="base.group_no_one">
                        <group>
                            <field name="source_url"/>
                            <field name="ip_address"/>
                        </group>
                        <group>
                            <field name="user_agent"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="message_ids" nolabel="1">
                                <list string="Messages" create="0" edit="0">
                                    <field name="create_date" string="Date"/>
                                    <field name="role" widget="badge"
                                           decoration-info="role == 'user'"
                                           decoration-success="role == 'assistant'"
                                           decoration-warning="role == 'system'"/>
                                    <field name="content" widget="text"/>
                                    <field name="has_web_search" widget="boolean_toggle" optional="show"/>
                                    <field name="tokens_used" optional="show"/>
                                    <field name="response_time_ms" string="Temps (ms)" optional="show"/>
                                    <field name="model_used" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Produits mentionnés" name="products">
                            <field name="message_ids" nolabel="1">
                                <list string="Messages avec produits" create="0" edit="0">
                                    <field name="create_date"/>
                                    <field name="role"/>
                                    <field name="product_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- CONVERSATION SEARCH VIEW -->
    <!-- ============================================================ -->
    <record id="view_ai_chat_conversation_search" model="ir.ui.view">
        <field name="name">ai.chat.conversation.search</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <search string="Rechercher conversations">
                <field name="display_name"/>
                <field name="partner_id"/>
                <field name="visitor_name"/>
                <field name="first_message"/>
                <field name="session_id"/>
                <separator/>
                <filter string="Actives" name="active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Terminées" name="closed"
                        domain="[('state', '=', 'closed')]"/>
                <filter string="Archivées" name="archived"
                        domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter string="Avec recherche web" name="web_search"
                        domain="[('web_searches_count', '>', 0)]"/>
                <filter string="Avec client identifié" name="identified"
                        domain="[('partner_id', '!=', False)]"/>
                <filter string="Évaluées" name="rated"
                        domain="[('rating', '!=', False)]"/>
                <separator/>
                <filter string="Aujourd'hui" name="today"
                        domain="[('start_date', '>=', (context_today()).strftime('%%Y-%%m-%%d'))]"/>
                <filter string="Cette semaine" name="this_week"
                        domain="[('start_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Jour" name="group_day" context="{'group_by': 'start_date:day'}"/>
                    <filter string="Satisfaction" name="group_rating" context="{'group_by': 'rating'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- CONVERSATION ACTION -->
    <!-- ============================================================ -->
    <record id="action_ai_chat_conversation" model="ir.actions.act_window">
        <field name="name">Conversations IA</field>
        <field name="res_model">ai.chat.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_chat_conversation_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune conversation IA pour l'instant
            </p>
            <p>
                Les conversations des visiteurs avec l'assistant IA apparaîtront ici
                dès que le widget sera activé sur votre site.
            </p>
        </field>
    </record>

</odoo>
