<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- ================================================================== -->
    <!-- DNA DETAIL REPORT TEMPLATE                                        -->
    <!-- ================================================================== -->
    
    <template id="report_dna_detail">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="text-center mb-4">
                            <h2>DÉTAIL DES DÉPENSES NON ADMISES (DNA)</h2>
                            <h4>
                                <span t-field="doc.company_id.name"/>
                            </h4>
                            <p class="text-muted">
                                Exercice du <span t-field="doc.fiscal_year_start"/> 
                                au <span t-field="doc.fiscal_year_end"/>
                                <br/>
                                Exercice d'imposition <span t-field="doc.assessment_year"/>
                            </p>
                        </div>
                        
                        <t t-set="data" t-value="report_data[doc_index]"/>
                        
                        <!-- DNA by category -->
                        <t t-if="data['dna_by_category']">
                            <t t-foreach="data['dna_by_category'].items()" t-as="category">
                                <div class="mb-4">
                                    <h5 class="bg-warning p-2">
                                        <t t-esc="category[1]['name']"/>
                                    </h5>
                                    
                                    <table class="table table-sm table-striped table-bordered">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Description</th>
                                                <th style="width: 100px;">Code fiscal</th>
                                                <th style="width: 120px;">Base</th>
                                                <th style="width: 80px;">% DNA</th>
                                                <th style="width: 120px;" class="text-end">Montant DNA</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="category[1]['items']" t-as="adj">
                                                <tr>
                                                    <td>
                                                        <t t-esc="adj.name"/>
                                                        <t t-if="adj.description">
                                                            <br/>
                                                            <small class="text-muted"><t t-esc="adj.description"/></small>
                                                        </t>
                                                    </td>
                                                    <td>
                                                        <t t-if="adj.tax_code_id">
                                                            <span t-field="adj.tax_code_id.code"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="adj.base_amount">
                                                            <t t-esc="'{:,.2f}'.format(adj.base_amount).replace(',', ' ')"/> €
                                                        </t>
                                                    </td>
                                                    <td class="text-center">
                                                        <t t-if="adj.dna_percentage">
                                                            <t t-esc="'{:.1f}'.format(adj.dna_percentage)"/>%
                                                        </t>
                                                    </td>
                                                    <td class="text-end fw-bold">
                                                        <t t-esc="'{:,.2f}'.format(adj.amount).replace(',', ' ')"/> €
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot class="table-secondary">
                                            <tr class="fw-bold">
                                                <td colspan="4">Sous-total <t t-esc="category[1]['name']"/></td>
                                                <td class="text-end">
                                                    <t t-esc="'{:,.2f}'.format(category[1]['total']).replace(',', ' ')"/> €
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </t>
                            
                            <!-- Total DNA -->
                            <div class="bg-danger text-white p-3 text-end fs-5 fw-bold">
                                TOTAL DNA: <t t-esc="'{:,.2f}'.format(data['total_dna']).replace(',', ' ')"/> €
                            </div>
                        </t>
                        
                        <t t-else="">
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"/> Aucune dépense non admise (DNA) pour cet exercice.
                            </div>
                        </t>
                        
                        <!-- Rappel des règles DNA -->
                        <div class="mt-4 p-3 bg-light border">
                            <h6>Rappel des règles DNA principales</h6>
                            <table class="table table-sm mb-0">
                                <tr>
                                    <td>Frais de restaurant</td>
                                    <td>31% non déductible</td>
                                </tr>
                                <tr>
                                    <td>Frais de réception</td>
                                    <td>50% non déductible</td>
                                </tr>
                                <tr>
                                    <td>Cadeaux d'affaires</td>
                                    <td>50% non déductible (max 125€/cadeau)</td>
                                </tr>
                                <tr>
                                    <td>Vêtements non spécifiques</td>
                                    <td>100% non déductible</td>
                                </tr>
                                <tr>
                                    <td>Amendes</td>
                                    <td>100% non déductible</td>
                                </tr>
                                <tr>
                                    <td>Véhicules (selon CO2)</td>
                                    <td>Variable selon émissions et carburant</td>
                                </tr>
                            </table>
                        </div>
                        
                        <!-- Footer -->
                        <div class="mt-4 pt-3 border-top">
                            <div class="row">
                                <div class="col-6">
                                    <small class="text-muted">
                                        Document généré depuis Odoo - Module Biztax<br/>
                                        Référence déclaration: <span t-field="doc.name"/>
                                    </small>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">
                                        BCE: <span t-field="doc.enterprise_number"/><br/>
                                        Généré le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
