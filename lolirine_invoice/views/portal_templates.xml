<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Ce template force l'affichage du PDF dans le portail au lieu du HTML.
        Utilise <embed> au lieu de <iframe> pour éviter les erreurs JavaScript.
    -->
    <template id="portal_invoice_page_embed_pdf" inherit_id="account.portal_invoice_page" priority="20">
        <!-- Remplacer toute la zone d'affichage HTML par un embed PDF -->
        <xpath expr="//div[hasclass('o_portal_html_view')]" position="replace">
            <div class="position-relative bg-white shadow overflow-hidden" style="min-height: 700px;">
                <embed 
                    t-att-src="invoice.get_portal_url(report_type='pdf')"
                    type="application/pdf"
                    width="100%" 
                    height="800px"
                    style="min-height: 750px; border: none;"/>
            </div>
        </xpath>
    </template>
</odoo>
