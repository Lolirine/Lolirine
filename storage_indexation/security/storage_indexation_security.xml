<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Catégorie de module -->
        <record id="module_category_storage_indexation" model="ir.module.category">
            <field name="name">Indexation Garde-Meubles</field>
            <field name="description">Gestion de l'indexation des prix de stockage</field>
            <field name="sequence">50</field>
        </record>

        <!-- Groupe Utilisateur -->
        <record id="group_storage_indexation_user" model="res.groups">
            <field name="name">Utilisateur Indexation</field>
            <field name="category_id" ref="module_category_storage_indexation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Peut consulter les indexations et les indices.</field>
        </record>

        <!-- Groupe Manager -->
        <record id="group_storage_indexation_manager" model="res.groups">
            <field name="name">Responsable Indexation</field>
            <field name="category_id" ref="module_category_storage_indexation"/>
            <field name="implied_ids" eval="[(4, ref('group_storage_indexation_user'))]"/>
            <field name="comment">Peut créer, modifier et appliquer les indexations.</field>
        </record>

        <!-- Règle d'enregistrement pour multi-société -->
        <record id="storage_price_index_company_rule" model="ir.rule">
            <field name="name">Indices de prix: multi-société</field>
            <field name="model_id" ref="model_storage_price_index"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="storage_indexation_company_rule" model="ir.rule">
            <field name="name">Indexations: multi-société</field>
            <field name="model_id" ref="model_storage_indexation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
