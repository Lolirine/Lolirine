<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================ -->
        <!-- TEMPLATE DEVIS PISCINE (NOUVEAU) -->
        <!-- ============================================ -->
        <record id="email_template_dropship_quote" model="mail.template">
            <field name="name">Dropshipping: Devis piscine</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Lolirine Pool Store - Votre devis {{ object.dropship_ref or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="report_template_ids" eval="[(4, ref('lolirine_pool_dropship.action_report_pool_devis'))]"/>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #0078D4; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Lolirine Pool Store</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong><t t-out="object.partner_id.name"/></strong>,</p>
        <p>Suite a votre demande, nous avons le plaisir de vous transmettre notre devis pour votre projet piscine.</p>
        <div style="background: #f0f7ff; border-left: 4px solid #0078D4; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Reference devis :</strong> <t t-out="object.dropship_ref or object.name"/></p>
            <p style="margin: 5px 0 0 0;"><strong>Montant total :</strong> <t t-out="&#39;%.2f&#39; % object.amount_total"/> EUR TTC</p>
            <p style="margin: 5px 0 0 0;"><strong>Validite :</strong> <t t-out="object.validity_date or &#39;Non definie&#39;"/></p>
        </div>
        <p>Vous trouverez ci-joint le detail complet de notre offre au format PDF.</p>
        <div style="background: #e8f5e9; padding: 15px; border-radius: 4px; margin: 20px 0;">
            <strong>Prochaine etape :</strong><br/>
            Si ce devis vous convient, confirmez votre accord par retour d'e-mail
            ou par telephone et nous lancerons immediatement la commande.
        </div>
        <p>Pour toute question : <strong>+32 (0)497 44 41 46</strong></p>
        <p style="margin-top: 25px;">Cordialement,<br/>
        <strong>L'equipe Lolirine Pool Store</strong><br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE CONFIRMATION COMMANDE (NOUVEAU) -->
        <!-- ============================================ -->
        <record id="email_template_dropship_order_confirmed" model="mail.template">
            <field name="name">Dropshipping: Confirmation commande client</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Lolirine Pool Store - Confirmation de votre commande {{ object.dropship_ref or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="report_template_ids" eval="[(4, ref('lolirine_pool_dropship.action_report_pool_order'))]"/>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #0078D4; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Lolirine Pool Store</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong><t t-out="object.partner_id.name"/></strong>,</p>
        <p>Nous avons bien recu votre commande et nous vous en remercions !</p>
        <div style="background: #f0f7ff; border-left: 4px solid #0078D4; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Reference commande :</strong> <t t-out="object.dropship_ref or object.name"/></p>
            <p style="margin: 5px 0 0 0;"><strong>Montant :</strong> <t t-out="&#39;%.2f&#39; % object.amount_total"/> EUR TTC</p>
        </div>
        <h3 style="color: #0078D4;">Prochaines etapes</h3>
        <ol style="line-height: 1.8;">
            <li>Commande confirmee et en cours de traitement</li>
            <li>Preparation et expedition par notre partenaire logistique</li>
            <li>Vous recevrez un email avec le suivi des l'expedition</li>
            <li>Livraison a votre adresse</li>
        </ol>
        <div style="background: #fff3cd; padding: 12px; border-radius: 4px; margin: 15px 0;">
            <strong>Adresse de livraison :</strong><br/>
            <t t-out="object.partner_shipping_id.name"/><br/>
            <t t-out="object.partner_shipping_id.street or &#39;&#39;"/><br/>
            <t t-out="object.partner_shipping_id.zip or &#39;&#39;"/> <t t-out="object.partner_shipping_id.city or &#39;&#39;"/><br/>
            <t t-out="object.partner_shipping_id.country_id.name or &#39;&#39;"/>
        </div>
        <p>Pour toute question : <strong>+32 (0)497 44 41 46</strong></p>
        <p style="margin-top: 25px;">Cordialement,<br/>
        <strong>L'equipe Lolirine Pool Store</strong><br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE COMMANDE EN PREPARATION -->
        <!-- ============================================ -->
        <record id="email_template_dropship_po_sent" model="mail.template">
            <field name="name">Dropshipping: Commande en preparation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre commande {{ object.dropship_ref or object.name }} est en preparation</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #0078D4; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Lolirine Pool Store</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong><t t-out="object.partner_id.name"/></strong>,</p>
        <p>Votre commande <strong><t t-out="object.dropship_ref or object.name"/></strong> a ete transmise a notre partenaire logistique pour preparation.</p>
        <div style="background: #d4edda; border-left: 4px solid #28a745; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Statut :</strong> En preparation</p>
            <p style="margin: 5px 0 0 0;">Vous recevrez un email avec le numero de suivi des que votre commande sera expediee.</p>
        </div>
        <p>Cordialement,<br/><strong>L'equipe Lolirine Pool Store</strong></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE COMMANDE FOURNISSEUR -->
        <!-- ============================================ -->
        <record id="email_template_dropship_po" model="mail.template">
            <field name="name">Dropshipping: Commande fournisseur</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Bon de commande {{ object.name }} — {{ object.company_id.name }} (Lolirine Pool Store)</field>
            <field name="email_from">{{ (user.email_formatted or object.company_id.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.dropship_order_email or object.partner_id.email }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="report_template_ids" eval="[(4, ref('purchase.action_report_purchase_order'))]"/>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 13px; color: #222; max-width: 680px;">
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 14px;">
        <tr>
            <td style="vertical-align: top;">
                <div style="font-size: 18px; font-weight: bold; color: #0b5d7a;">Lolirine Pool Store</div>
                <div><t t-out="object.company_id.name"/></div>
                <div t-if="object.company_id.street"><t t-out="object.company_id.street"/></div>
                <div><t t-out="object.company_id.zip or ''"/> <t t-out="object.company_id.city or ''"/>
                    <t t-if="object.company_id.country_id"> — <t t-out="object.company_id.country_id.name"/></t></div>
                <div t-if="object.company_id.vat">TVA <t t-out="object.company_id.vat"/></div>
                <div>+32 497 44 41 46 — info@lolirinepoolstore.be</div>
            </td>
            <td style="vertical-align: top; text-align: right;">
                <div style="font-size: 16px; font-weight: bold;">Bon de commande <t t-out="object.name"/></div>
                <div>Date : <t t-out="format_date(object.date_approve or object.date_order)"/></div>
                <div t-if="object.partner_ref">Votre référence : <t t-out="object.partner_ref"/></div>
                <div t-if="object.dropship_sale_id">Notre référence client : <t t-out="object.dropship_sale_id.name"/></div>
            </td>
        </tr>
    </table>

    <p>Bonjour,</p>
    <p>Veuillez trouver ci-dessous notre commande <strong t-out="object.name"/>, à livrer
        <strong>directement chez notre client</strong>. Le bon de commande complet est joint en PDF.</p>

    <table style="width: 100%; border-collapse: collapse; margin: 12px 0;">
        <thead>
            <tr>
                <th style="padding: 6px; text-align: left; color: #0b5d7a; font-weight: bold; border-bottom: 2px solid #0b5d7a; white-space: nowrap;">Votre réf.</th>
                <th style="padding: 6px; text-align: left; color: #0b5d7a; font-weight: bold; border-bottom: 2px solid #0b5d7a; white-space: nowrap;">Désignation</th>
                <th style="padding: 6px; text-align: right; color: #0b5d7a; font-weight: bold; border-bottom: 2px solid #0b5d7a; white-space: nowrap;">Qté</th>
                <th style="padding: 6px; text-align: right; color: #0b5d7a; font-weight: bold; border-bottom: 2px solid #0b5d7a; white-space: nowrap;">Prix unit. HT</th>
                <th style="padding: 6px; text-align: right; color: #0b5d7a; font-weight: bold; border-bottom: 2px solid #0b5d7a; white-space: nowrap;">Remise</th>
                <th style="padding: 6px; text-align: right; color: #0b5d7a; font-weight: bold; border-bottom: 2px solid #0b5d7a; white-space: nowrap;">Total HT</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="object.order_line.filtered(lambda l: not l.display_type)" t-as="l">
                <tr style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 5px; white-space: nowrap;"
                        t-out="l.product_id.seller_ids.filtered(lambda s: s.partner_id == object.partner_id.commercial_partner_id)[:1].product_code or ''"/>
                    <td style="padding: 5px;" t-out="(l.name or '').split('\n')[-1]"/>
                    <td style="padding: 5px; text-align: right; white-space: nowrap;">
                        <t t-out="('%g' % l.product_qty).replace('.', ',')"/> <t t-out="l.product_uom_id.name"/></td>
                    <td style="padding: 5px; text-align: right; white-space: nowrap;" t-out="format_amount(l.price_unit, object.currency_id)"/>
                    <td style="padding: 5px; text-align: right; white-space: nowrap;"><t t-if="l.discount"><t t-out="('%g' % l.discount).replace('.', ',')"/> %</t></td>
                    <td style="padding: 5px; text-align: right; white-space: nowrap;" t-out="format_amount(l.price_subtotal, object.currency_id)"/>
                </tr>
            </t>
        </tbody>
        <tfoot>
            <tr><td colspan="5" style="padding: 5px; text-align: right; white-space: nowrap;">Total HT</td>
                <td style="padding: 5px; text-align: right; font-weight: bold; white-space: nowrap;" t-out="format_amount(object.amount_untaxed, object.currency_id)"/></tr>
            <tr><td colspan="5" style="padding: 5px; text-align: right; white-space: nowrap;">TVA</td>
                <td style="padding: 5px; text-align: right; white-space: nowrap;" t-out="format_amount(object.amount_tax, object.currency_id)"/></tr>
            <tr><td colspan="5" style="padding: 5px; text-align: right; white-space: nowrap;">Total TVAC</td>
                <td style="padding: 5px; text-align: right; font-weight: bold; white-space: nowrap;" t-out="format_amount(object.amount_total, object.currency_id)"/></tr>
        </tfoot>
    </table>

    <div t-if="object.dest_address_id" style="background: #fff3cd; border-left: 4px solid #ffc107; padding: 12px; margin: 14px 0;">
        <strong>LIVRAISON DIRECTE AU CLIENT FINAL :</strong><br/>
        <t t-out="object.dest_address_id.name"/><br/>
        <t t-out="object.dest_address_id.street or ''"/><t t-if="object.dest_address_id.street2"> <t t-out="object.dest_address_id.street2"/></t><br/>
        <t t-out="object.dest_address_id.zip or ''"/> <t t-out="object.dest_address_id.city or ''"/> — <t t-out="object.dest_address_id.country_id.name or ''"/><br/>
        <t t-if="object.dest_address_id.phone">Tél. : <t t-out="object.dest_address_id.phone"/></t>
    </div>
    <div style="background: #f8d7da; padding: 10px 12px; margin: 14px 0;">
        <strong>EMBALLAGE NEUTRE</strong>, sans mention de votre société ni de prix, et
        <strong>sans facture ni bon de livraison chiffré dans le colis</strong>.
    </div>

    <p>Merci de nous <strong>confirmer la commande</strong> avec le délai de livraison, puis de nous
        communiquer le <strong>numéro de suivi</strong> à l'expédition.</p>
    <p>Facturation : <t t-out="object.company_id.name"/><t t-if="object.company_id.vat"> (TVA <t t-out="object.company_id.vat"/>)</t>,
        <t t-out="object.company_id.street or ''"/>, <t t-out="object.company_id.zip or ''"/> <t t-out="object.company_id.city or ''"/>.</p>
    <p>Cordialement,<br/>
        <t t-out="user.name"/><br/>
        Lolirine Pool Store — <t t-out="object.company_id.name"/><br/>
        +32 497 44 41 46 — info@lolirinepoolstore.be</p>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE EXPEDITION -->
        <!-- ============================================ -->
        <record id="email_template_dropship_shipped" model="mail.template">
            <field name="name">Dropshipping: Notification expedition</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre commande {{ object.dropship_ref or object.name }} a ete expediee</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #28a745; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Commande expediee !</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong><t t-out="object.partner_id.name"/></strong>,</p>
        <p>Bonne nouvelle ! Votre commande <strong><t t-out="object.dropship_ref or object.name"/></strong> vient d'etre expediee.</p>
        <div style="background: #fff3cd; padding: 12px; border-radius: 4px; margin: 15px 0;">
            <strong>Livraison prevue a :</strong><br/>
            <t t-out="object.partner_shipping_id.name"/><br/>
            <t t-out="object.partner_shipping_id.street or &#39;&#39;"/><br/>
            <t t-out="object.partner_shipping_id.zip or &#39;&#39;"/> <t t-out="object.partner_shipping_id.city or &#39;&#39;"/>
        </div>
        <p>Cordialement,<br/><strong>L'equipe Lolirine Pool Store</strong><br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE LIVRAISON -->
        <!-- ============================================ -->
        <record id="email_template_dropship_delivered" model="mail.template">
            <field name="name">Dropshipping: Confirmation livraison</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre commande {{ object.dropship_ref or object.name }} a ete livree</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #28a745; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Commande livree !</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong><t t-out="object.partner_id.name"/></strong>,</p>
        <p>Votre commande <strong><t t-out="object.dropship_ref or object.name"/></strong> a ete livree avec succes.</p>
        <p>Si vous avez la moindre question, n'hesitez pas a nous contacter.</p>
        <p>Merci pour votre confiance !<br/>
        <strong>L'equipe Lolirine Pool Store</strong><br/>
        +32 (0)497 44 41 46<br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE PROBLEME -->
        <!-- ============================================ -->
        <record id="email_template_dropship_issue" model="mail.template">
            <field name="name">Dropshipping: Notification probleme</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Information sur votre commande {{ object.dropship_ref or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #dc3545; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Information importante</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong><t t-out="object.partner_id.name"/></strong>,</p>
        <p>Nous vous contactons au sujet de votre commande <strong><t t-out="object.dropship_ref or object.name"/></strong>.</p>
        <p>Un point necessite notre attention. Notre equipe traite la situation dans les meilleurs delais.</p>
        <p>Pour toute question urgente : <strong>+32 (0)497 44 41 46</strong></p>
        <p>Cordialement,<br/><strong>L'equipe Lolirine Pool Store</strong></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
