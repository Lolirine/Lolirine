<odoo>
  <data noupdate="1">
    <record id="mail_template_visite_confirmation" model="mail.template">
      <field name="name">Confirmation de visite</field>
      <field name="model_id" ref="model_visite_box"/>
      <field name="subject">Votre rendez-vous chez Lolirine</field>
      <field name="email_from">gardemeuble@lolirine.be</field>
      <field name="email_to">${object.email}</field>
      <field name="body_html" type="html">
        <![CDATA[
        <p>Bonjour ${object.name},</p>
        <p>Votre visite est confirmée pour le ${object.date_visite}.</p>
        <p>Pour toute modification ou reprogrammation, veuillez utiliser ce lien Calendly :
        <a href="https://calendly.com/gardemeublelolirine/30min">Prendre rendez-vous</a>.</p>
        <p>À bientôt,</p>
        <p><strong>L&apos;équipe Lolirine Garde-meubles</strong></p>
        ]]>
      </field>
    </record>
  </data>
</odoo>
