<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== BAREME VIEWS ==================== -->

    <!-- Form View -->
    <record id="km_bareme_view_form" model="ir.ui.view">
        <field name="name">km.bareme.form</field>
        <field name="model">km.bareme</field>
        <field name="arch" type="xml">
            <form string="Barème Kilométrique">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="type_vehicule"/>
                            <field name="puissance_fiscale"/>
                        </group>
                        <group string="Période de validité">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="trimestre" readonly="1"/>
                            <field name="annee" readonly="1"/>
                        </group>
                    </group>
                    <group string="Taux kilométriques">
                        <group>
                            <field name="taux_jusqu_5000"/>
                            <field name="taux_5001_20000"/>
                            <field name="majoration_5001_20000"/>
                            <field name="taux_au_dela_20000"/>
                        </group>
                        <group>
                            <field name="source_officielle" placeholder="Ex: AR du 01/07/2024"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="km_bareme_view_tree" model="ir.ui.view">
        <field name="name">km.bareme.tree</field>
        <field name="model">km.bareme</field>
        <field name="arch" type="xml">
            <list string="Barèmes Kilométriques" decoration-muted="not active">
                <field name="trimestre" optional="show"/>
                <field name="annee" optional="show"/>
                <field name="type_vehicule"/>
                <field name="puissance_fiscale"/>
                <field name="taux_jusqu_5000" string="Taux (€/km)"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="source_officielle" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="km_bareme_action" model="ir.actions.act_window">
        <field name="name">Baremes Kilometriques</field>
        <field name="res_model">km.bareme</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez vos baremes kilometriques
            </p>
            <p>
                Les baremes definissent le taux de remboursement par kilometre
                selon la puissance fiscale du vehicule et le type de vehicule.
                <br/><br/>
                <strong>Rappel :</strong> En Belgique, le taux est revise chaque trimestre.
            </p>
        </field>
    </record>

    <!-- Action pour préparer le trimestre suivant -->
    <record id="km_bareme_action_preparer_trimestre" model="ir.actions.server">
        <field name="name">Préparer barèmes trimestre suivant</field>
        <field name="model_id" ref="model_km_bareme"/>
        <field name="binding_model_id" ref="model_km_bareme"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_creer_bareme_trimestre_suivant()</field>
    </record>

</odoo>
