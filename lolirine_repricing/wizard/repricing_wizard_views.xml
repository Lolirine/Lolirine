<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repricing_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.repricing.wizard.form</field>
        <field name="model">lolirine.repricing.wizard</field>
        <field name="arch" type="xml">
            <form string="Repricing Pool Store">

                <!-- ═══ CONFIGURATION ═══ -->
                <group invisible="state != 'draft'" string="Identifiants DataForSEO">
                    <field name="dataforseo_login"    placeholder="votre@email.com"/>
                    <field name="dataforseo_password" password="True"/>
                    <field name="save_credentials"/>
                </group>

                <group invisible="state != 'draft'" string="Marchés à comparer">
                    <group>
                        <field name="market_be"/>
                        <field name="market_fr"/>
                        <field name="market_de"/>
                    </group>
                    <group>
                        <field name="market_nl"/>
                        <field name="market_lu"/>
                    </group>
                </group>

                <group invisible="state != 'draft'" string="Options">
                    <field name="only_no_price"/>
                    <field name="dry_run"/>
                    <field name="product_limit"
                           help="0 = tous les produits. Mettre ex. 50 pour un test."/>
                </group>

                <!-- ═══ RÉSULTATS ═══ -->
                <group invisible="state != 'done'" string="Résultats — Session">
                    <field name="session_name" readonly="1"/>
                </group>

                <group invisible="state != 'done'" string="Récapitulatif">
                    <group>
                        <field name="result_total"     readonly="1"/>
                        <field name="result_updated"   readonly="1"/>
                        <field name="result_init"      readonly="1"/>
                        <field name="result_floor"     readonly="1"/>
                    </group>
                    <group>
                        <field name="result_fallback"  readonly="1"/>
                        <field name="result_unchanged" readonly="1"/>
                        <field name="result_no_data"   readonly="1"/>
                        <field name="result_skipped"   readonly="1"/>
                    </group>
                </group>

                <footer>
                    <!-- Bouton principal -->
                    <button name="action_run"
                            string="▶  Lancer le repricing"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <!-- Après exécution -->
                    <button name="action_view_logs"
                            string="Voir les logs détaillés"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'done'"/>

                    <button string="Fermer"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard -->
    <record id="action_repricing_wizard" model="ir.actions.act_window">
        <field name="name">Lancer le repricing</field>
        <field name="res_model">lolirine.repricing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
