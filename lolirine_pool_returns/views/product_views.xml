<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_public_category_form_pool_return" model="ir.ui.view">
        <field name="name">product.public.category.form.pool.return</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
        <field name="arch" type="xml">
            <field name="website_description" position="after">
                <field name="x_non_retournable"/>
                <field name="x_motif_non_retour" invisible="not x_non_retournable"/>
            </field>
        </field>
    </record>

    <record id="product_template_form_pool_return" model="ir.ui.view">
        <field name="name">product.template.form.pool.return</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="upsell" position="after">
                <group name="lpr_retours" string="Retours">
                    <field name="x_non_retournable"/>
                    <field name="x_motif_non_retour" invisible="x_non_retournable != 'oui'"
                           placeholder="ex. Produit chimique : non repris une fois ouvert"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
