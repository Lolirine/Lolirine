<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste des réservations -->
    <record id="view_box_reservation_tree" model="ir.ui.view">
        <field name="name">box.reservation.tree</field>
        <field name="model">box.reservation</field>
        <field name="arch" type="xml">
            <tree string="Réservations" decoration-info="state == 'pending'" 
                  decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="box_id"/>
                <field name="reservation_date"/>
                <field name="appointment_date"/>
                <field name="reservation_type"/>
                <field name="state" widget="badge" 
                       decoration-info="state in ['draft', 'pending']"
                       decoration-success="state in ['confirmed', 'ongoing']"
                       decoration-muted="state in ['completed', 'cancelled']"/>
            </tree>
        </field>
    </record>

    <!-- Vue formulaire des réservations -->
    <record id="view_box_reservation_form" model="ir.ui.view">
        <field name="name">box.reservation.form</field>
        <field name="model">box.reservation</field>
        <field name="arch" type="xml">
            <form string="Réservation">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" 
                            class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_start" string="Démarrer" type="object" 
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_complete" string="Terminer" type="object" 
                            invisible="state != 'ongoing'"/>
                    <button name="action_cancel" string="Annuler" type="object" 
                            invisible="state in ['completed', 'cancelled']" 
                            confirm="Êtes-vous sûr de vouloir annuler cette réservation ?"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,pending,confirmed,ongoing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations client">
                            <field name="customer_name"/>
                            <field name="customer_email" widget="email"/>
                            <field name="customer_phone" widget="phone"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Box">
                            <field name="box_id"/>
                            <field name="monthly_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="registration_fee" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="deposit_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="reservation_date"/>
                            <field name="appointment_date" 
                                   invisible="reservation_type != 'appointment'"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Type et montant">
                            <field name="reservation_type"/>
                            <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes du client..."/>
                        </page>
                        <page string="Notes internes">
                            <field name="internal_notes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue recherche des réservations -->
    <record id="view_box_reservation_search" model="ir.ui.view">
        <field name="name">box.reservation.search</field>
        <field name="model">box.reservation</field>
        <field name="arch" type="xml">
            <search string="Recherche réservations">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="box_id"/>
                <filter string="En attente" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Confirmé" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="En cours" name="ongoing" domain="[('state', '=', 'ongoing')]"/>
                <separator/>
                <filter string="Rendez-vous" name="appointment" domain="[('reservation_type', '=', 'appointment')]"/>
                <filter string="Réservation" name="reservation" domain="[('reservation_type', '=', 'reservation')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="today" 
                        domain="[('reservation_date', '&gt;=', datetime.datetime.now().replace(hour=0, minute=0, second=0)), 
                                 ('reservation_date', '&lt;=', datetime.datetime.now().replace(hour=23, minute=59, second=59))]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Box" name="group_box" context="{'group_by': 'box_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'reservation_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action pour les réservations -->
    <record id="action_box_reservation" model="ir.actions.act_window">
        <field name="name">Réservations</field>
        <field name="res_model">box.reservation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <!-- Séquence pour les réservations -->
    <record id="seq_box_reservation" model="ir.sequence">
        <field name="name">Réservation Box</field>
        <field name="code">box.reservation</field>
        <field name="prefix">RES</field>
        <field name="padding">5</field>
    </record>
</odoo>
