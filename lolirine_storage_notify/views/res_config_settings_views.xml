<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vue form dédiée (modèle lolirine.notify.config) ── -->
    <record id="view_lolirine_notify_config_form" model="ir.ui.view">
        <field name="name">lolirine.notify.config.form</field>
        <field name="model">lolirine.notify.config</field>
        <field name="arch" type="xml">
            <form string="Notifications Lolirine – Configuration">
                <sheet>
                    <div class="row">
                        <div class="col-12 d-flex align-items-center mb-2">
                            <img src="/lolirine_storage_notify/static/description/icon.png"
                                 style="height:48px; margin-right:14px;"/>
                            <div>
                                <h2 class="mb-0">Notifications Lolirine</h2>
                                <span class="text-muted">
                                    3 canaux : toast backend · activité mail · Web Push OS
                                </span>
                            </div>
                        </div>
                        <hr class="w-100"/>
                    </div>

                    <group string="Événements surveillés">
                        <group>
                            <field name="notify_signup"
                                   widget="boolean_toggle"
                                   string="Inscriptions portail"/>
                            <field name="notify_rdv"
                                   widget="boolean_toggle"
                                   string="Demandes de rendez-vous"/>
                        </group>
                        <group>
                            <field name="notify_contact"
                                   widget="boolean_toggle"
                                   string="Formulaires de contact web"/>
                            <field name="notify_portal_msg"
                                   widget="boolean_toggle"
                                   string="Messages portail client"/>
                        </group>
                    </group>

                    <group string="Web Push – Clés VAPID">
                        <div class="col-12 mb-2">
                            <span class="text-muted">
                                Notifications au niveau OS, même navigateur fermé.
                                Prérequis : <code>pywebpush</code> dans requirements.txt.
                            </span>
                        </div>
                        <group>
                            <field name="vapid_email" string="Email de contact"/>
                            <field name="vapid_public_key"
                                   string="Clé publique"
                                   placeholder="Générée via l'assistant →"/>
                        </group>
                        <group>
                            <field name="vapid_private_key"
                                   string="Clé privée"
                                   password="True"
                                   placeholder="Générée via l'assistant →"/>
                            <div class="text-danger">
                                ⚠️ Ne jamais partager la clé privée.
                            </div>
                        </group>
                    </group>

                    <group string="Actions">
                        <div>
                            <button name="action_open_vapid_wizard"
                                    type="object"
                                    string="🔑 Générer les clés VAPID"
                                    class="btn btn-secondary me-2"/>
                            <button name="action_test_notification"
                                    type="object"
                                    string="🔔 Tester les notifications"
                                    class="btn btn-info"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ── -->
    <record id="action_lolirine_notify_config" model="ir.actions.act_window">
        <field name="name">Notifications Lolirine</field>
        <field name="res_model">lolirine.notify.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_lolirine_notify_config_form"/>
        <field name="target">current</field>
    </record>

    <!-- ── Menus sous Technique ── -->
    <menuitem
        id="menu_lolirine_notify_root"
        name="Lolirine Notify"
        parent="base.menu_administration"
        sequence="100"
        groups="base.group_system"
    />
    <menuitem
        id="menu_lolirine_notify_config"
        name="Configuration notifications"
        parent="menu_lolirine_notify_root"
        action="action_lolirine_notify_config"
        sequence="10"
        groups="base.group_system"
    />
    <menuitem
        id="menu_push_subscriptions"
        name="Abonnements Web Push"
        parent="menu_lolirine_notify_root"
        action="action_push_subscription"
        sequence="20"
        groups="base.group_system"
    />

</odoo>
