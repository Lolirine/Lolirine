<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="storage_plan_page" name="Plan Interactif Garde-Meubles">
        <t t-call="website.layout">
            <div id="wrap" class="storage-plan-wrapper">
                <!-- Zone pour ajouter des blocs AU-DESSUS du plan -->
                <div class="oe_structure oe_empty" id="storage_plan_above"></div>

                <!-- Section Plan Interactif avec ancrage -->
                <section class="s_text_block" id="plan" data-anchor="true" data-snippet="s_text_block" data-name="Plan Interactif">
                <div class="storage-plan-container">
                    <div class="main-layout">
                        <div class="plans-section">
                            <!-- Disponibilités : même présentation que www.lolirine.be -->
                            <div class="plan-dispo-card" data-oe-protected="true">
                                <t t-if="plan_available">
                                    <div class="plan-dispo-title">Disponible maintenant ou prochainement</div>
                                    <div class="plan-dispo-scroll">
                                    <table class="plan-dispo-table">
                                        <thead><tr><th>Box</th><th>Niveau</th><th class="num">Dimensions (L×l×h)</th><th class="num">Volume</th><th class="num">Prix / mois TVAC</th><th>Disponibilité</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="plan_available" t-as="pa" class="plan-box" t-att-data-box-id="pa['id']">
                                                <td><strong t-esc="pa['code']"/></td>
                                                <td t-esc="pa['floor']"/>
                                                <td class="num" t-esc="pa['dims']"/>
                                                <td class="num"><t t-esc="pa['vol']"/> m³</td>
                                                <td class="num"><strong><t t-esc="pa['price']"/> €</strong></td>
                                                <td><span t-attf-class="plan-badge plan-badge-#{pa['status']}" t-esc="pa['dispo']"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    </div>
                                </t>
                                <t t-else="">
                                    <p class="plan-dispo-complet"><span class="plan-badge plan-badge-occupe">Actuellement complet</span> — tous nos box sont loués.
                                    <a href="/contactus">Laissez-nous vos coordonnées</a> : nous vous prévenons dès qu'un box se libère.</p>
                                </t>
                            </div>
                            <p class="plan-hint" data-oe-protected="true">Cliquez sur un box pour voir les informations complètes.</p>
                            <div class="floors-row">
                                
                                <!-- ==================== REZ-DE-CHAUSSÉE ==================== -->
                                <div class="floor-container">
                                    <div class="floor-title o_default_snippet_text">Rez-de-chaussée</div>
                                    <t t-set="plan_floor" t-value="plan_floors[0]"/>
                                    <t t-call="storage_plan_module.storage_plan_svg"/>
                                </div>

                                <!-- ==================== PREMIER ÉTAGE ==================== -->
                                <div class="floor-container">
                                    <div class="floor-title o_default_snippet_text">1er étage</div>
                                    <t t-set="plan_floor" t-value="plan_floors[1]"/>
                                    <t t-call="storage_plan_module.storage_plan_svg"/>
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar -->
                        <div class="sidebar-section">
                            <div class="sidebar-content">
                                <div class="example-box-card s_card s_allow_columns" data-name="Exemple Box">
                                    <div class="example-title s_text_block">Exemple de box</div>
                                    <div class="example-box-demo">
                                        <div class="demo-id s_text_block">Numéro du box</div>
                                        <div class="demo-volume s_text_block">Volume (m³)</div>
                                    </div>
                                </div>
                                
                                <div class="legend-card s_card s_allow_columns" data-name="Légende">
                                    <div class="legend-title s_text_block">Légende des couleurs</div>
                                    <div class="legend-items">
                                        <t t-foreach="status_legend" t-as="status">
                                            <div class="legend-item">
                                                <span class="legend-color" t-attf-style="background-color: #{status['color']};"></span>
                                                <span class="legend-label"><t t-esc="status['label']"/></span>
                                            </div>
                                        </t>
                                    </div>
                                    <a href="/contactus" class="btn btn-danger btn-lg btn-demande-generale s_btn" data-name="Bouton Demande"><span>Demande générale</span></a>
                                </div>
                                
                                <div class="forklift-image">
                                    <img src="/storage_plan_module/static/src/img/forklift.png" alt="Chariot"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                </section>

                <!-- Modal - protégé de l'édition -->
                <div class="modal fade" id="boxDetailsModal" tabindex="-1" role="dialog" data-oe-protected="true">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Détails du Box</h5>
                                <button type="button" class="close" data-dismiss="modal" id="btn-close-modal"><span>×</span></button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-md-6"><canvas id="box-3d-canvas" width="400" height="400"></canvas></div>
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-5">Box N°:</dt><dd class="col-sm-7" id="detail-box-name"></dd>
                                            <dt class="col-sm-5">Largeur:</dt><dd class="col-sm-7" id="detail-width"></dd>
                                            <dt class="col-sm-5">Profondeur:</dt><dd class="col-sm-7" id="detail-depth"></dd>
                                            <dt class="col-sm-5">Hauteur:</dt><dd class="col-sm-7" id="detail-height"></dd>
                                            <dt class="col-sm-5">Volume:</dt><dd class="col-sm-7" id="detail-volume"></dd>
                                            <dt class="col-sm-5">Surface:</dt><dd class="col-sm-7" id="detail-surface"></dd>
                                            <dt class="col-sm-5">Prix:</dt><dd class="col-sm-7" id="detail-price"></dd>
                                            <dt class="col-sm-5">Statut:</dt><dd class="col-sm-7"><span class="badge" id="detail-status"></span></dd>
                                        </dl>
                                        <a href="/contactus" class="btn btn-secondary w-100 mb-2" id="btn-appointment" target="_blank">Prendre rendez-vous</a>
                                        <a href="/contactus" class="btn btn-danger w-100" id="btn-reserve" target="_blank">Réserver ce box</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- ==================== CONFIGURATION BOUTONS MODALE ==================== -->
                <!-- Cette section est visible UNIQUEMENT en mode édition -->
                <section class="s_text_block modal-buttons-config-section" data-snippet="s_text_block" data-name="Boutons fenêtre modale">
                    <div class="container">
                        <div class="modal-buttons-config-inner">
                            <div class="config-header">
                                <i class="fa fa-cog"></i> Configuration des boutons de la fenêtre modale
                            </div>
                            <p class="config-description">Ces boutons apparaissent quand un visiteur clique sur un box. Modifiez leur texte et leur lien ici :</p>
                            <div class="config-buttons-row">
                                <a href="/contactus" class="btn btn-secondary btn-lg" id="config-btn-appointment">Prendre rendez-vous</a>
                                <a href="/contactus" class="btn btn-danger btn-lg" id="config-btn-reserve">Réserver ce box</a>
                            </div>
                            <p class="config-hint"><i class="fa fa-info-circle"></i> Cliquez sur un bouton pour modifier son texte, son lien et son style.</p>
                        </div>
                    </div>
                </section>

                <!-- Zone pour ajouter des blocs ENTRE le plan et le calculateur -->
                <div class="oe_structure oe_empty" id="storage_plan_between"></div>

                <!-- ==================== CALCULATEUR DE VOLUME ==================== -->
                <section class="s_text_block pt48 pb48" id="calculateur" data-anchor="true" data-snippet="s_text_block" data-name="Calculateur de Volume">
                    <div class="container volume-calculator-section">
                        <!-- En-tête éditable -->
                        <div class="row">
                            <div class="col-12 text-center pb32">
                                <h2 style="text-align: center;">Estimez votre besoin en volume</h2>
                                <p class="lead" style="text-align: center;">Utilisez notre calculateur pour trouver le box parfait.</p>
                            </div>
                        </div>
                        
                        <div class="calculator-layout">
                            <!-- Zone principale avec onglets et meubles - protégée de l'édition -->
                            <div class="calculator-main" data-oe-protected="true">
                                <!-- Onglets des catégories -->
                                <div class="category-tabs">
                                    <t t-foreach="furniture_categories" t-as="cat">
                                        <button type="button" t-attf-class="category-tab #{'active' if cat_first else ''}" 
                                             t-att-data-category-id="cat['id']">
                                            <i t-attf-class="fa #{cat['icon']}"></i>
                                            <span><t t-esc="cat['name']"/></span>
                                        </button>
                                    </t>
                                </div>
                                
                                <!-- Panneaux de meubles par catégorie -->
                                <t t-foreach="furniture_categories" t-as="cat">
                                    <div t-attf-class="furniture-category-panel #{'active' if cat_first else ''}"
                                         t-att-data-category-id="cat['id']">
                                        <div class="furniture-grid">
                                            <t t-foreach="cat['furniture']" t-as="furniture">
                                                <div class="furniture-item" 
                                                     t-att-data-furniture-id="furniture['id']"
                                                     t-att-data-name="furniture['name']"
                                                     t-att-data-width="furniture['width']"
                                                     t-att-data-depth="furniture['depth']"
                                                     t-att-data-height="furniture['height']"
                                                     t-att-data-volume="furniture['volume']"
                                                     t-att-data-color="furniture['color']">
                                                    <div class="furniture-name"><t t-esc="furniture['name']"/></div>
                                                    <div class="furniture-controls">
                                                        <button type="button" class="furniture-btn-minus" 
                                                                t-att-data-furniture-id="furniture['id']">-</button>
                                                        <span class="furniture-qty">0</span>
                                                        <button type="button" class="furniture-btn-plus"
                                                                t-att-data-furniture-id="furniture['id']">+</button>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            
                            <!-- Sidebar avec résultat et 3D -->
                            <div class="calculator-sidebar">
                                <!-- Volume total - carte éditable -->
                                <div class="volume-result-card">
                                    <div class="volume-result-title">Volume total estimé</div>
                                    <div class="volume-result-value" data-oe-protected="true">
                                        <span class="total-volume-value">0.00</span>
                                        <span class="total-volume-unit"> m³</span>
                                    </div>
                                </div>
                                
                                <!-- Recommandation - carte éditable -->
                                <div class="recommendation-card">
                                    <div class="recommendation-title">Notre recommandation</div>
                                    <div class="recommendation-content" data-oe-protected="true">
                                        <p class="text-muted">Ajoutez des objets pour obtenir une suggestion.</p>
                                    </div>
                                    <div class="recommended-boxes" data-oe-protected="true"></div>
                                    
                                    <!-- Données cachées des boxes disponibles -->
                                    <div style="display:none;" data-oe-protected="true">
                                        <t t-foreach="boxes_list" t-as="box">
                                            <div class="box-volume-item"
                                                 t-att-data-id="box['id']"
                                                 t-att-data-name="box['name']"
                                                 t-att-data-volume="box['volume']"
                                                 t-att-data-surface="box['surface']"
                                                 t-att-data-price="box['price_monthly']"></div>
                                        </t>
                                    </div>
                                </div>
                                
                                <!-- Boutons d'action éditables -->
                                <div class="calculator-actions">
                                    <a href="#" class="btn btn-secondary btn-reset-calculator">
                                        <i class="fa fa-refresh"></i> Réinitialiser
                                    </a>
                                    <a href="#" class="btn btn-primary btn-view-boxes">
                                        <i class="fa fa-search"></i> Voir les boxes disponibles
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Visualisation 3D - PLEINE LARGEUR CENTRÉE -->
                        <div class="row mt32">
                            <div class="col-12">
                                <div class="visualization-3d-card-fullwidth">
                                    <div class="visualization-3d-title">
                                        <i class="fa fa-cube"></i> Visualisation 3D
                                    </div>
                                    <div class="canvas-container" data-oe-protected="true">
                                        <canvas id="volume-3d-canvas"></canvas>
                                    </div>
                                    <p class="visualization-3d-hint">
                                        <i class="fa fa-hand-pointer-o"></i> Glissez pour faire pivoter
                                    </p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Note importante - section éditable -->
                        <div class="row mt32">
                            <div class="col-12">
                                <div class="calculator-note alert alert-info">
                                    <h4><i class="fa fa-info-circle"></i> Note importante</h4>
                                    <ul>
                                        <li>Ce calculateur fournit une estimation. Le volume réel peut varier.</li>
                                        <li>Pensez à l'espace nécessaire pour circuler dans votre box.</li>
                                        <li>Pour des objets non listés ou de grande taille, contactez-nous.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Zone pour ajouter des blocs APRÈS le calculateur -->
                <div class="oe_structure oe_empty" id="storage_plan_footer"></div>
                
                <!-- Three.js pour la visualisation 3D du calculateur de volume -->
                <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
                <script>
                    // OrbitControls intégré (version simplifiée)
                    THREE.OrbitControls = function(camera, domElement) {
                        this.camera = camera;
                        this.domElement = domElement;
                        this.enabled = true;
                        this.enableDamping = false;
                        this.dampingFactor = 0.05;
                        this.minDistance = 1;
                        this.maxDistance = 100;
                        
                        var scope = this;
                        var rotateStart = new THREE.Vector2();
                        var rotateEnd = new THREE.Vector2();
                        var rotateDelta = new THREE.Vector2();
                        var spherical = new THREE.Spherical();
                        var sphericalDelta = new THREE.Spherical();
                        
                        spherical.setFromVector3(camera.position);
                        
                        function onMouseDown(event) {
                            if (!scope.enabled) return;
                            event.preventDefault();
                            rotateStart.set(event.clientX, event.clientY);
                            domElement.addEventListener('mousemove', onMouseMove, false);
                            domElement.addEventListener('mouseup', onMouseUp, false);
                        }
                        
                        function onMouseMove(event) {
                            if (!scope.enabled) return;
                            rotateEnd.set(event.clientX, event.clientY);
                            rotateDelta.subVectors(rotateEnd, rotateStart);
                            sphericalDelta.theta = -2 * Math.PI * rotateDelta.x / domElement.clientWidth;
                            sphericalDelta.phi = -2 * Math.PI * rotateDelta.y / domElement.clientHeight;
                            rotateStart.copy(rotateEnd);
                        }
                        
                        function onMouseUp() {
                            domElement.removeEventListener('mousemove', onMouseMove, false);
                            domElement.removeEventListener('mouseup', onMouseUp, false);
                        }
                        
                        function onWheel(event) {
                            if (!scope.enabled) return;
                            event.preventDefault();
                            var delta = event.deltaY > 0 ? 1.1 : 0.9;
                            spherical.radius = Math.max(scope.minDistance, Math.min(scope.maxDistance, spherical.radius * delta));
                        }
                        
                        domElement.addEventListener('mousedown', onMouseDown, false);
                        domElement.addEventListener('wheel', onWheel, false);
                        
                        this.update = function() {
                            spherical.theta += sphericalDelta.theta;
                            spherical.phi += sphericalDelta.phi;
                            spherical.phi = Math.max(0.1, Math.min(Math.PI - 0.1, spherical.phi));
                            
                            if (scope.enableDamping) {
                                sphericalDelta.theta *= (1 - scope.dampingFactor);
                                sphericalDelta.phi *= (1 - scope.dampingFactor);
                            } else {
                                sphericalDelta.set(0, 0, 0);
                            }
                            
                            camera.position.setFromSpherical(spherical);
                            camera.lookAt(0, 0, 0);
                        };
                    };
                </script>
            </div>
        </t>
    </template>
    <!-- Plan d'un niveau en SVG : géométrie et couleurs identiques à www.lolirine.be -->
    <template id="storage_plan_svg" name="Plan du hangar (SVG d'un niveau)">
        <svg class="plan-svg" t-att-viewBox="plan_viewbox" role="img" t-att-aria-label="'Plan ' + plan_floor['title']" data-oe-protected="true">
            <rect x="0" y="0" width="310" height="460" fill="#FFFFFF"/>
            <t t-foreach="plan_floor['shapes']" t-as="sh">
                <t t-if="sh['tech']">
                    <rect t-att-x="sh['x']" t-att-y="sh['y']" t-att-width="sh['w']" t-att-height="sh['h']" fill="white" fill-opacity="0.4" stroke="#555555" stroke-opacity="0.8"/>
                    <text t-att-x="sh['tx']" t-att-y="sh['ty']" font-size="8" font-family="Verdana, sans-serif" font-weight="bold" text-anchor="end" fill="#000000"><t t-esc="sh['code']"/></text>
                </t>
                <t t-else="">
                    <g class="plan-box" t-att-data-box-id="sh['id']" t-att-data-status="sh['status']">
                        <rect class="plan-box-rect" t-att-x="sh['x']" t-att-y="sh['y']" t-att-width="sh['w']" t-att-height="sh['h']" t-att-fill="sh['fill']" fill-opacity="0.4" stroke="blue" stroke-opacity="0.8"><title><t t-esc="sh['tip']"/></title></rect>
                        <text t-att-x="sh['tx']" t-att-y="sh['ty']" font-size="8" font-family="Verdana, sans-serif" font-weight="bold" text-anchor="end" fill="#000000"><t t-esc="sh['code']"/></text>
                        <text t-att-x="sh['vx']" t-att-y="sh['vy']" font-size="10" font-family="Verdana, sans-serif" font-weight="bold" text-anchor="start" fill="#C70039" fill-opacity="0.6"><t t-esc="sh['vol']"/></text>
                    </g>
                </t>
            </t>
        </svg>
    </template>

</odoo>
