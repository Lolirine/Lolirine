<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Séquence ══ -->
    <record id="seq_pool_checklist_report" model="ir.sequence">
        <field name="name">Fiche de visite piscine</field>
        <field name="code">pool.checklist.report</field>
        <field name="prefix">LPS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- ══ Vue liste ══ -->
    <record id="view_pool_checklist_list" model="ir.ui.view">
        <field name="name">pool.checklist.report.list</field>
        <field name="model">pool.checklist.report</field>
        <field name="arch" type="xml">
            <list string="Fiches de visite"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="client_name" optional="show"/>
                <field name="intervention_type"/>
                <field name="technician_id"/>
                <field name="items_total"/>
                <field name="items_ok"/>
                <field name="estimate_total" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'draft'"/>
                <field name="sale_order_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ══ Vue formulaire ══ -->
    <record id="view_pool_checklist_form" model="ir.ui.view">
        <field name="name">pool.checklist.report.form</field>
        <field name="model">pool.checklist.report</field>
        <field name="arch" type="xml">
            <form string="Fiche de visite chantier">
                <header>
                    <button name="action_validate" string="Valider" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Remettre en brouillon"
                            type="object" invisible="state == 'draft'"/>
                    <button name="action_view_sale_order" string="Voir le devis"
                            type="object" invisible="not sale_order_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Client et chantier">
                            <field name="partner_id"/>
                            <field name="client_name"/>
                            <field name="address"/>
                            <field name="tel"/>
                        </group>
                        <group string="Intervention">
                            <field name="intervention_type"/>
                            <field name="plan_type"/>
                            <field name="date"/>
                            <field name="technician_id"/>
                            <field name="ref_dossier"/>
                        </group>
                    </group>
                    <group string="Statistiques">
                        <group>
                            <field name="items_total"/>
                            <field name="items_ok"/>
                            <field name="items_warning"/>
                            <field name="items_action"/>
                            <field name="completion_pct"/>
                        </group>
                        <group>
                            <field name="estimate_total"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══ Action fenêtre ══ -->
    <record id="action_pool_checklist_report" model="ir.actions.act_window">
        <field name="name">Fiches de visite piscine</field>
        <field name="res_model">pool.checklist.report</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
