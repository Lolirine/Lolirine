<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menu racine de l'application -->
    <menuitem id="pool_menu_root"
              name="Piscine"
              sequence="50"
              web_icon="lolirine_pool,static/description/icon.png"/>

    <!-- Menu Catalogue -->
    <menuitem id="pool_menu_catalog"
              name="Catalogue"
              parent="pool_menu_root"
              sequence="10"/>

    <menuitem id="pool_menu_products"
              name="Produits"
              parent="pool_menu_catalog"
              action="pool_product_action"
              sequence="10"/>

    <menuitem id="pool_menu_categories"
              name="Catégories"
              parent="pool_menu_catalog"
              action="pool_product_category_action"
              sequence="20"/>

    <menuitem id="pool_menu_brands"
              name="Marques"
              parent="pool_menu_catalog"
              action="pool_brand_action"
              sequence="30"/>

    <!-- Menu Fournisseurs & Import -->
    <menuitem id="pool_menu_suppliers"
              name="Fournisseurs &amp; Import"
              parent="pool_menu_root"
              sequence="20"
              groups="group_pool_manager"/>

    <menuitem id="pool_menu_supplier_list"
              name="Fournisseurs"
              parent="pool_menu_suppliers"
              action="pool_supplier_action"
              sequence="10"/>

    <menuitem id="pool_menu_import_logs"
              name="Historique des imports"
              parent="pool_menu_suppliers"
              action="pool_import_log_action"
              sequence="20"/>

    <!-- Menu Configuration -->
    <menuitem id="pool_menu_configuration"
              name="Configuration"
              parent="pool_menu_root"
              sequence="90"
              groups="group_pool_manager"/>

    <menuitem id="pool_menu_attributes"
              name="Attributs techniques"
              parent="pool_menu_configuration"
              action="pool_attribute_action"
              sequence="10"/>

</odoo>
