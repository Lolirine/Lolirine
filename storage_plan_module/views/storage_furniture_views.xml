<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================
         CATÉGORIES DE MEUBLES
         ============================================ -->
    
    <!-- Tree View -->
    <record id="view_storage_furniture_category_tree" model="ir.ui.view">
        <field name="name">storage.furniture.category.tree</field>
        <field name="model">storage.furniture.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="furniture_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_storage_furniture_category_form" model="ir.ui.view">
        <field name="name">storage.furniture.category.form</field>
        <field name="model">storage.furniture.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="icon" placeholder="fa-couch"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Meubles" name="furniture">
                            <field name="furniture_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="width"/>
                                    <field name="depth"/>
                                    <field name="height"/>
                                    <field name="volume"/>
                                    <field name="color_3d" widget="color"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_storage_furniture_category" model="ir.actions.act_window">
        <field name="name">Catégories de meubles</field>
        <field name="res_model">storage.furniture.category</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première catégorie de meubles
            </p>
            <p>
                Les catégories permettent d'organiser les types de meubles pour le calculateur de volume.
            </p>
        </field>
    </record>
    
    <!-- ============================================
         TYPES DE MEUBLES
         ============================================ -->
    
    <!-- Tree View -->
    <record id="view_storage_furniture_type_tree" model="ir.ui.view">
        <field name="name">storage.furniture.type.tree</field>
        <field name="model">storage.furniture.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="width"/>
                <field name="depth"/>
                <field name="height"/>
                <field name="volume" decoration-bf="1"/>
                <field name="color_3d" widget="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_storage_furniture_type_form" model="ir.ui.view">
        <field name="name">storage.furniture.type.form</field>
        <field name="model">storage.furniture.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Informations générales">
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="icon" placeholder="🛋️"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Dimensions (en cm)">
                            <field name="width"/>
                            <field name="depth"/>
                            <field name="height"/>
                            <field name="volume" readonly="1"/>
                        </group>
                    </group>
                    <group string="Visualisation 3D">
                        <field name="color_3d" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_storage_furniture_type_search" model="ir.ui.view">
        <field name="name">storage.furniture.type.search</field>
        <field name="model">storage.furniture.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter string="Actifs" name="active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Catégorie" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_storage_furniture_type" model="ir.actions.act_window">
        <field name="name">Types de meubles</field>
        <field name="res_model">storage.furniture.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier type de meuble
            </p>
            <p>
                Définissez les dimensions des meubles courants pour aider vos clients à estimer leur besoin en volume.
            </p>
        </field>
    </record>
    
    <!-- Menu items -->
    <menuitem id="menu_storage_furniture"
              name="Calculateur Volume"
              parent="menu_storage_configuration"
              sequence="30"/>
    
    <menuitem id="menu_storage_furniture_category"
              name="Catégories"
              parent="menu_storage_furniture"
              action="action_storage_furniture_category"
              sequence="10"/>
    
    <menuitem id="menu_storage_furniture_type"
              name="Types de meubles"
              parent="menu_storage_furniture"
              action="action_storage_furniture_type"
              sequence="20"/>
</odoo>
