<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_accessories"
              name="Lolirine — accessoires recommandés sur fiche"
              inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_full_description']" position="after">
            <section t-if="product.accessory_product_ids" class="o_lp_accessories mt-4 pt-3">
                <div class="o_wsale_product_details_content_section">
                    <h4 class="mb-3">Accessoires recommandés</h4>
                    <div class="row g-3">
                        <t t-foreach="product.accessory_product_ids[:4]" t-as="acc">
                            <div class="col-6 col-lg-3">
                                <a t-attf-href="/shop/#{slug(acc.product_tmpl_id)}"
                                   class="text-decoration-none text-dark d-block h-100 border rounded-3 p-2">
                                    <div class="text-center mb-2" style="height:120px;overflow:hidden;">
                                        <img t-att-src="'/web/image/product.product/%s/image_256' % acc.id"
                                             class="img-fluid h-100" style="object-fit:contain;"
                                             t-att-alt="acc.name"/>
                                    </div>
                                    <p class="small fw-bold mb-1" t-out="acc.name"/>
                                    <span class="text-primary fw-bold" t-out="acc.list_price"
                                          t-options='{"widget":"monetary","display_currency":website.currency_id}'/>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
