<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_trajet_min_tree" model="ir.ui.view">
        <field name="name">trajet.intervention.tree</field>
        <field name="model">trajet.intervention</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Trajets">
                <field name="name"/>
                <field name="date"/>
                <field name="location"/>
                <field name="completed"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_trajet_min_form" model="ir.ui.view">
        <field name="name">trajet.intervention.form</field>
        <field name="model">trajet.intervention</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Trajet Intervention">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="location"/>
                        <field name="completed"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
