<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_ai_chat_conversation_tree" model="ir.ui.view">
        <field name="name">ai.chat.conversation.tree</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversations IA">
                <field name="display_name" />
                <field name="partner_id" optional="show" />
                <field name="visitor_name" optional="hide" />
                <field name="first_message" optional="show" />
                <field name="message_count" />
                <field name="web_searches_count" optional="show" />
                <field name="start_date" />
                <field name="last_message_date" />
                <field name="duration_minutes" optional="show" />
                <field name="rating" optional="show" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>
    <record id="view_ai_chat_conversation_form" model="ir.ui.view">
        <field name="name">ai.chat.conversation.form</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation IA">
                <header>
                    <button name="action_close" type="object" string="Terminer" class="btn-primary" invisible="state != 'active'" />
                    <button name="action_archive" type="object" string="Archiver" invisible="state != 'closed'" />
                    <button name="action_reopen" type="object" string="Reouvrir" invisible="state != 'closed'" />
                    <field name="state" widget="statusbar" statusbar_visible="active,closed,archived" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="session_id" />
                            <field name="partner_id" />
                            <field name="visitor_name" />
                            <field name="rating" />
                        </group>
                        <group string="Statistiques">
                            <field name="message_count" />
                            <field name="web_searches_count" />
                            <field name="start_date" />
                            <field name="last_message_date" />
                            <field name="duration_minutes" />
                        </group>
                    </group>
                    <group string="Technique" groups="base.group_no_one">
                        <group>
                            <field name="source_url" />
                            <field name="ip_address" />
                        </group>
                        <group>
                            <field name="user_agent" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="message_ids" nolabel="1">
                                <list string="Messages" create="0" edit="0">
                                    <field name="create_date" string="Date" />
                                    <field name="role" widget="badge" />
                                    <field name="content" widget="text" />
                                    <field name="has_web_search" optional="show" />
                                    <field name="tokens_used" optional="show" />
                                    <field name="response_time_ms" optional="show" />
                                    <field name="model_used" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page string="Produits" name="products">
                            <field name="message_ids" nolabel="1">
                                <list string="Produits" create="0" edit="0">
                                    <field name="create_date" />
                                    <field name="role" />
                                    <field name="product_ids" widget="many2many_tags" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ai_chat_conversation_search" model="ir.ui.view">
        <field name="name">ai.chat.conversation.search</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <search string="Rechercher">
                <field name="partner_id" />
                <field name="visitor_name" />
                <field name="first_message" />
                <separator />
                <filter string="Actives" name="filter_active" domain="[('state', '=', 'active')]" />
                <filter string="Terminees" name="filter_closed" domain="[('state', '=', 'closed')]" />
                <filter string="Archivees" name="filter_archived" domain="[('state', '=', 'archived')]" />
                <separator />
                <filter string="Recherche web" name="filter_web" domain="[('web_searches_count', '&gt;', 0)]" />
                <filter string="Client identifie" name="filter_partner" domain="[('partner_id', '!=', False)]" />
                <filter string="Avec evaluation" name="filter_rated" domain="[('rating', '!=', False)]" />
                <separator />
                <filter string="Date" name="filter_date" date="start_date" />
                <separator />
                <group expand="0" string="Grouper par">
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}" />
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}" />
                    <filter string="Jour" name="group_day" context="{'group_by': 'start_date:day'}" />
                    <filter string="Satisfaction" name="group_rating" context="{'group_by': 'rating'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_ai_chat_conversation" model="ir.actions.act_window">
        <field name="name">Conversations IA</field>
        <field name="res_model">ai.chat.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_chat_conversation_search" />
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune conversation IA</p>
            <p>Les conversations apparaitront ici automatiquement.</p>
        </field>
    </record>
</odoo>