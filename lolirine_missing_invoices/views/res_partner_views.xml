<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liste editable autonome : aucune heritance de vue standard, donc aucun
         risque d'xmlid manquant. C'est l'ecran de configuration principal. -->
    <record id="view_partner_invoice_policy_list" model="ir.ui.view">
        <field name="name">lolirine.partner.invoice.policy.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false"
                  default_order="x_invoice_policy desc, name">
                <field name="name" readonly="1"/>
                <field name="x_invoice_policy"/>
                <field name="x_bank_label"
                       placeholder="ANTHROPIC|CLAUDE.AI"/>
                <field name="supplier_rank" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_partner_invoice_policy_search" model="ir.ui.view">
        <field name="name">lolirine.partner.invoice.policy.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="x_bank_label"/>
                <filter name="p_expected" string="Facture attendue"
                        domain="[('x_invoice_policy', '=', 'expected')]"/>
                <filter name="p_none" string="Jamais de facture"
                        domain="[('x_invoice_policy', '=', 'none')]"/>
                <filter name="p_todo" string="Non defini"
                        domain="[('x_invoice_policy', '=', False)]"/>
                <separator/>
                <filter name="p_label" string="Motif bancaire configuré"
                        domain="[('x_bank_label', '!=', False)]"/>
                <separator/>
                <filter name="group_policy" string="Politique"
                        context="{'group_by': 'x_invoice_policy'}"/>
            </search>
        </field>
    </record>

    <record id="action_partner_invoice_policy" model="ir.actions.act_window">
        <field name="name">Fournisseurs : factures attendues</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_partner_invoice_policy_list"/>
        <field name="search_view_id" ref="view_partner_invoice_policy_search"/>
        <field name="domain">[('supplier_rank', '>', 0)]</field>
        <field name="context">{'search_default_p_todo': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tous les fournisseurs sont configurés !
            </p>
            <p>Indiquez pour chaque fournisseur s'il émet une facture à récupérer
               ou non. Le motif de libellé bancaire sert à le reconnaître dans les
               transactions qui ne portent pas son nom exact.</p>
        </field>
    </record>

    <menuitem id="menu_partner_invoice_policy"
              name="Fournisseurs : factures attendues"
              parent="account.menu_finance_configuration"
              action="action_partner_invoice_policy"
              sequence="90"/>

</odoo>
