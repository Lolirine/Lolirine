<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="pool_import_wizard_form" model="ir.ui.view">
        <field name="name">pool.import.wizard.form</field>
        <field name="model">pool.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Catalogue Fluidra">
                <group>
                    <group string="Source">
                        <field name="supplier_id"/>
                        <field name="import_type"/>
                        <field name="import_file" filename="import_filename"/>
                        <field name="import_filename" invisible="1"/>
                    </group>
                    <group string="Options">
                        <field name="update_existing"/>
                        <field name="recalculate_prices"/>
                        <field name="import_templates"/>
                    </group>
                </group>
                
                <group string="Aperçu">
                    <div class="alert alert-info" role="alert">
                        <strong>Résumé:</strong>
                        <field name="preview_count" class="oe_inline"/> produits simples,
                        <field name="preview_templates_count" class="oe_inline"/> templates à importer
                    </div>
                </group>
                
                <field name="preview_line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="supplier_ref"/>
                        <field name="name"/>
                        <field name="brand" optional="hide"/>
                        <field name="category" optional="hide"/>
                        <field name="purchase_price"/>
                        <field name="selling_price"/>
                        <field name="is_template"/>
                        <field name="variants_count" optional="hide"/>
                        <field name="attributes_info" optional="hide"/>
                        <field name="existing_product_id" optional="hide"/>
                        <field name="action"/>
                    </list>
                </field>
                
                <footer>
                    <button name="action_import" string="Importer" type="object" class="btn-primary"/>
                    <button name="action_preview" string="Rafraîchir l'aperçu" type="object" class="btn-secondary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_pool_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer Catalogue</field>
        <field name="res_model">pool.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
