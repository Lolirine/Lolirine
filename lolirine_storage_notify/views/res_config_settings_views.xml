<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo 19 : La structure de res.config.settings a changé.
        On utilise une vue de configuration standalone plutôt que
        d'injecter dans la page settings globale (xpath fragile).
    -->

    <!-- ── Vue form dédiée ──────────────────────────────── -->
    <record id="view_lolirine_notify_config_form" model="ir.ui.view">
        <field name="name">lolirine.notify.config.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Notifications Lolirine – Configuration" class="oe_form_configuration">
                <sheet>
                    <div class="row">
                        <div class="col-12">
                            <h2>
                                <img src="/lolirine_storage_notify/static/description/icon.png"
                                     style="height:40px; margin-right:10px; vertical-align:middle;"/>
                                Notifications Lolirine (Garde-Meuble)
                            </h2>
                            <p class="text-muted">
                                Configure les 3 canaux de notification en temps réel :
                                toast backend (bus Odoo), activités mail (pastille orange),
                                et Web Push au niveau OS.
                            </p>
                            <hr/>
                        </div>
                    </div>

                    <!-- Événements -->
                    <group string="Événements surveillés">
                        <group>
                            <field name="lolirine_notify_signup"
                                   widget="boolean_toggle"
                                   string="Inscriptions portail"/>
                            <field name="lolirine_notify_rdv"
                                   widget="boolean_toggle"
                                   string="Demandes de rendez-vous"/>
                        </group>
                        <group>
                            <field name="lolirine_notify_contact"
                                   widget="boolean_toggle"
                                   string="Formulaires de contact web"/>
                            <field name="lolirine_notify_portal_msg"
                                   widget="boolean_toggle"
                                   string="Messages portail client"/>
                        </group>
                    </group>

                    <!-- VAPID -->
                    <group string="Web Push – Clés VAPID">
                        <div class="col-12 mb-2">
                            <span class="text-muted">
                                Nécessaire pour les notifications OS-level (même navigateur fermé).
                                Prérequis : <code>pywebpush</code> dans requirements.txt.
                            </span>
                        </div>
                        <group>
                            <field name="lolirine_notify_vapid_email"
                                   string="Email de contact VAPID"/>
                            <field name="lolirine_notify_vapid_public"
                                   string="Clé publique"
                                   placeholder="Générée via l'assistant →"/>
                        </group>
                        <group>
                            <field name="lolirine_notify_vapid_private"
                                   string="Clé privée"
                                   password="True"
                                   placeholder="Générée via l'assistant →"/>
                            <div class="text-muted text-danger">
                                ⚠️ Ne jamais partager la clé privée.
                            </div>
                        </group>
                    </group>

                    <!-- Actions -->
                    <group string="Actions">
                        <div>
                            <button name="action_open_vapid_wizard"
                                    type="object"
                                    string="🔑 Générer les clés VAPID"
                                    class="btn btn-secondary me-2"/>
                            <button name="action_test_notification_config"
                                    type="object"
                                    string="🔔 Tester les notifications"
                                    class="btn btn-info"/>
                        </div>
                    </group>
                </sheet>

                <footer>
                    <button name="execute" type="object"
                            string="Sauvegarder" class="btn btn-primary"/>
                    <button name="cancel" type="object"
                            string="Annuler" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Action ──────────────────────────────────────── -->
    <record id="action_lolirine_notify_config" model="ir.actions.act_window">
        <field name="name">Notifications Lolirine</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_lolirine_notify_config_form"/>
        <field name="target">inline</field>
        <field name="context">{'module': 'lolirine_storage_notify'}</field>
    </record>

    <!-- ── Menus ────────────────────────────────────────── -->
    <menuitem
        id="menu_lolirine_notify_root"
        name="Lolirine Notify"
        parent="base.menu_administration"
        sequence="100"
        groups="base.group_system"
    />

    <menuitem
        id="menu_lolirine_notify_config"
        name="Configuration notifications"
        parent="menu_lolirine_notify_root"
        action="action_lolirine_notify_config"
        sequence="10"
        groups="base.group_system"
    />

    <menuitem
        id="menu_push_subscriptions"
        name="Abonnements Web Push"
        parent="menu_lolirine_notify_root"
        action="action_push_subscription"
        sequence="20"
        groups="base.group_system"
    />

</odoo>
