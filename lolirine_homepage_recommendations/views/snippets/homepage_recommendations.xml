                    </button>
                </div>
            </div>
        </section>
    </template>
    
    <!-- ============================================ -->
    <!-- SNIPPET: Grille de catégories préférées     -->
    <!-- ============================================ -->
    <template id="s_preferred_categories" name="Vos catégories préférées">
        <section class="s_preferred_categories pt-4 pb-4" 
                 data-snippet="s_preferred_categories"
                 data-name="Vos catégories préférées">
            <div class="container">
                <div class="row mb-3">
                    <div class="col-12">
                        <h3 class="recommendations-title mb-0">
                            <i class="fa fa-th-large me-2 text-primary"></i>
                            <span class="title-text">Découvrez nos catégories</span>
                        </h3>
                    </div>
                </div>
                
                <div class="preferred-categories-grid" data-limit="6">
                    <!-- Chargé dynamiquement -->
                    <div class="categories-skeleton">
                        <div class="skeleton-category" t-foreach="range(6)" t-as="i">
                            <div class="skeleton-cat-image"></div>
                            <div class="skeleton-cat-text"></div>
                        </div>
                    </div>
                    <div class="categories-content row g-3"></div>
                </div>
            </div>
        </section>
    </template>
    
    <!-- ============================================ -->
    <!-- Enregistrement des snippets                 -->
    <!-- EXCLUSIVEMENT POUR LOLIRINE POOL            -->
    <!-- ============================================ -->
    <template id="homepage_recommendations_snippets" inherit_id="website.snippets" name="Homepage Recommendations Snippets - Lolirine Pool">
        <!-- 
            Ces snippets sont disponibles dans le Website Builder pour Lolirine Pool.
            Ils ne devraient être utilisés que sur le site Pool, pas sur le site Storage.
        -->
        <xpath expr="//t[@t-snippet='website.s_text_image']" position="after">
            <t t-snippet="lolirine_homepage_recommendations.s_recommendations_section" 
               t-thumbnail="/lolirine_homepage_recommendations/static/src/img/s_recommendations.svg"
               string="[Pool] Recommandations Produits"/>
            <t t-snippet="lolirine_homepage_recommendations.s_recently_viewed" 
               t-thumbnail="/lolirine_homepage_recommendations/static/src/img/s_recently_viewed.svg"
               string="[Pool] Produits Récemment Consultés"/>
            <t t-snippet="lolirine_homepage_recommendations.s_continue_shopping" 
               t-thumbnail="/lolirine_homepage_recommendations/static/src/img/s_continue_shopping.svg"
               string="[Pool] Continuez vos achats"/>
            <t t-snippet="lolirine_homepage_recommendations.s_top_rated" 
               t-thumbnail="/lolirine_homepage_recommendations/static/src/img/s_top_rated.svg"
               string="[Pool] Produits les mieux notés"/>
            <t t-snippet="lolirine_homepage_recommendations.s_promotions" 
               t-thumbnail="/lolirine_homepage_recommendations/static/src/img/s_promotions.svg"
               string="[Pool] Offres du moment"/>
            <t t-snippet="lolirine_homepage_recommendations.s_new_arrivals" 
               t-thumbnail="/lolirine_homepage_recommendations/static/src/img/s_new_arrivals.svg"
               string="[Pool] Nouveautés"/>
            <t t-snippet="lolirine_homepage_recommendations.s_related_to_viewed" 
               t-thumbnail="/lolirine_homepage_recommendations/static/src/img/s_related.svg"
               string="[Pool] En lien avec vos consultations"/>
            <t t-snippet="lolirine_homepage_recommendations.s_for_category" 
               t-thumbnail="/lolirine_homepage_recommendations/static/src/img/s_category.svg"
               string="[Pool] Pour vous dans une catégorie"/>
            <t t-snippet="lolirine_homepage_recommendations.s_preferred_categories" 
               t-thumbnail="/lolirine_homepage_recommendations/static/src/img/s_categories_grid.svg"
               string="[Pool] Grille de catégories"/>
        </xpath>
    </template>
    
</odoo>
