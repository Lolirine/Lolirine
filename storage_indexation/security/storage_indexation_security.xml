<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Règle d'enregistrement pour multi-société - storage.price.index -->
        <record id="storage_price_index_company_rule" model="ir.rule">
            <field name="name">Indices de prix: multi-societe</field>
            <field name="model_id" ref="storage_indexation.model_storage_price_index"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Règle d'enregistrement pour multi-société - storage.indexation -->
        <record id="storage_indexation_company_rule" model="ir.rule">
            <field name="name">Indexations: multi-societe</field>
            <field name="model_id" ref="storage_indexation.model_storage_indexation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
