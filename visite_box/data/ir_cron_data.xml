<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron pour envoyer les rappels 24h avant -->
        <record id="ir_cron_visite_reminder" model="ir.cron">
            <field name="name">Visites: Envoi des rappels automatiques</field>
            <field name="model_id" ref="model_visite_box"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
