<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension de res.config.settings -->
    <record id="res_config_settings_view_form_indexation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.indexation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Indexation" string="Indexation" name="storage_indexation" groups="storage_indexation.group_storage_indexation_manager">
                    <block title="Configuration de l'indexation" name="indexation_config">
                        <setting string="Type d'indice par défaut" help="Indice utilisé par défaut pour les nouvelles indexations">
                            <field name="indexation_index_type"/>
                        </setting>
                        <setting string="Récupération automatique" help="Récupère automatiquement l'indice santé depuis Statbel">
                            <field name="indexation_auto_fetch"/>
                        </setting>
                    </block>
                    <block title="Notifications" name="indexation_notifications">
                        <setting string="Délai de notification" help="Nombre de jours avant la date d'application pour notifier les clients">
                            <field name="indexation_notification_days"/> jours
                        </setting>
                        <setting string="Template d'email" help="Template utilisé pour les notifications">
                            <field name="indexation_email_template_id"/>
                        </setting>
                    </block>
                    <block title="Options avancées" name="indexation_advanced">
                        <setting string="Application automatique" help="Applique automatiquement l'indexation (non recommandé)">
                            <field name="indexation_auto_apply"/>
                        </setting>
                        <setting string="Seuil minimum" help="Pourcentage minimum d'augmentation pour déclencher une indexation">
                            <field name="indexation_min_increase"/> %
                        </setting>
                        <setting string="Précision d'arrondi" help="Précision pour l'arrondi des nouveaux prix">
                            <field name="indexation_round_precision"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
