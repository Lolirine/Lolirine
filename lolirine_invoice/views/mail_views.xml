<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== VUE LISTE EMAILS AMELIOREE ==================== -->
    
    <record id="view_mail_mail_tree_lolirine" model="ir.ui.view">
        <field name="name">mail.mail.tree.lolirine</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_mail_tree"/>
        <field name="arch" type="xml">
            <!-- Ajouter des colonnes utiles -->
            <xpath expr="//field[@name='subject']" position="after">
                <field name="email_to" string="Destinataire"/>
                <field name="email_from" string="Expéditeur"/>
                <field name="model" string="Modèle"/>
                <field name="res_id" string="ID Doc"/>
            </xpath>
            
            <!-- Ajouter la date d'envoi -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="date" string="Date"/>
            </xpath>
            
            <!-- Ajouter raison d'échec si visible -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="failure_reason" string="Erreur" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ==================== VUE FORMULAIRE EMAILS AMELIOREE ==================== -->
    
    <record id="view_mail_mail_form_lolirine" model="ir.ui.view">
        <field name="name">mail.mail.form.lolirine</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_mail_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter un groupe avec les infos de suivi -->
            <xpath expr="//group" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_related_document" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-file-text-o"
                            invisible="not res_id">
                        <field name="res_id" widget="statinfo" string="Document"/>
                    </button>
                </div>
            </xpath>
            
            <!-- Améliorer le groupe principal -->
            <xpath expr="//field[@name='email_to']" position="after">
                <field name="email_cc" string="CC" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>

    <!-- ==================== VUE RECHERCHE EMAILS AMELIOREE ==================== -->
    
    <record id="view_mail_mail_search_lolirine" model="ir.ui.view">
        <field name="name">mail.mail.search.lolirine</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_mail_search"/>
        <field name="arch" type="xml">
            <!-- Ajouter des filtres utiles -->
            <xpath expr="//search" position="inside">
                <field name="email_to" string="Destinataire"/>
                <field name="email_from" string="Expéditeur"/>
                <field name="model" string="Modèle"/>
                
                <separator/>
                
                <filter name="filter_today" string="Aujourd'hui" 
                        domain="[('date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                
                <filter name="filter_this_week" string="Cette semaine"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                
                <filter name="filter_invoices" string="Factures" 
                        domain="[('model', '=', 'account.move')]"/>
                
                <filter name="filter_subscriptions" string="Abonnements" 
                        domain="[('model', '=', 'sale.order')]"/>
                
                <separator/>
                
                <filter name="filter_sent" string="Envoyés" 
                        domain="[('state', '=', 'sent')]"/>
                
                <filter name="filter_failed" string="Échoués" 
                        domain="[('state', '=', 'exception')]"/>
                
                <filter name="filter_outgoing" string="En attente" 
                        domain="[('state', '=', 'outgoing')]"/>
                
                <separator/>
                
                <group expand="0" string="Grouper par">
                    <filter name="group_state" string="Statut" context="{'group_by': 'state'}"/>
                    <filter name="group_model" string="Modèle" context="{'group_by': 'model'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
                    <filter name="group_email_from" string="Expéditeur" context="{'group_by': 'email_from'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ==================== ACTION EMAILS PERSONNALISEE ==================== -->
    
    <record id="action_view_mail_mail_lolirine" model="ir.actions.act_window">
        <field name="name">Emails Lolirine</field>
        <field name="res_model">mail.mail</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_filter_invoices': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun email trouvé
            </p>
            <p>
                Les emails envoyés depuis les factures et abonnements apparaîtront ici.
            </p>
        </field>
    </record>

</odoo>
