<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu principal - ouvre directement la liste des scans -->
    <menuitem id="menu_scan_tva_root" 
              name="Scan TVA" 
              action="action_scan_tva"
              web_icon="lolirine_scan_tva,static/description/icon.png"
              sequence="90"/>
    
    <!-- Sous-menu Scans -->
    <menuitem id="menu_scan_tva_scans"
              name="Scans"
              parent="menu_scan_tva_root"
              sequence="10"/>
    
    <!-- Nouveau scan (wizard rapide) -->
    <menuitem id="menu_scan_tva_new"
              name="Nouveau scan"
              parent="menu_scan_tva_scans"
              action="action_scan_tva_wizard"
              sequence="1"/>
    
    <!-- Tous les scans -->
    <menuitem id="menu_scan_tva_all"
              name="Tous les scans"
              parent="menu_scan_tva_scans"
              action="action_scan_tva"
              sequence="10"/>
    
    <!-- A traiter -->
    <menuitem id="menu_scan_tva_to_process"
              name="A traiter"
              parent="menu_scan_tva_scans"
              action="action_scan_tva_to_process"
              sequence="20"/>
    
    <!-- Factures creees -->
    <menuitem id="menu_scan_tva_invoiced"
              name="Factures creees"
              parent="menu_scan_tva_scans"
              action="action_scan_tva_invoiced"
              sequence="30"/>
    
    <!-- Configuration -->
    <menuitem id="menu_scan_tva_config"
              name="Configuration"
              parent="menu_scan_tva_root"
              sequence="100"/>
    
    <menuitem id="menu_scan_tva_config_accounts"
              name="Plan comptable"
              parent="menu_scan_tva_config"
              action="account.action_account_form"
              sequence="10"/>
</odoo>
