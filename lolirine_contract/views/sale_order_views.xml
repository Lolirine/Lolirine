<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ajouter les champs du contrat dans le formulaire de vente/abonnement -->
    <record id="view_order_form_contract_fields" model="ir.ui.view">
        <field name="name">sale.order.form.contract.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="arch" type="xml">
            <!-- Ajouter un onglet "Contrat" -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Contrat Garde-Meubles" name="contract_info" 
                      invisible="not is_subscription">
                    <group>
                        <group string="Codes d'accès">
                            <field name="contract_access_code" placeholder="Ex: 1234"/>
                            <field name="contract_forklift_code" placeholder="Ex: 5678"/>
                        </group>
                        <group string="Dates">
                            <field name="contract_signature_date"/>
                            <field name="contract_deposit_date"/>
                            <field name="contract_signature_location"/>
                        </group>
                    </group>
                    <group>
                        <group string="Montants du contrat">
                            <field name="contract_monthly_rent" readonly="1"/>
                            <field name="contract_dossier_fees" readonly="1"/>
                            <field name="contract_deposit_amount" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <div class="alert alert-info" role="alert">
                            <strong>Actions disponibles :</strong>
                            <ul class="mb-0">
                                <li>Utilisez le menu <strong>Imprimer → Contrat de Garde-Meubles</strong> pour générer le PDF</li>
                                <li>Utilisez l'action <strong>Envoyer le contrat par email</strong> pour l'envoyer au client</li>
                                <li>Le contrat sera envoyé automatiquement lors de la confirmation de l'abonnement</li>
                            </ul>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Ajouter un bouton "Envoyer le contrat" dans l'en-tête -->
    <record id="view_order_form_contract_button" model="ir.ui.view">
        <field name="name">sale.order.form.contract.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_send_contract" 
                        type="object" 
                        string="📧 Envoyer le contrat"
                        class="btn-secondary"
                        invisible="state != 'sale' or not is_subscription"/>
            </xpath>
        </field>
    </record>

    <!-- Ajouter les champs dans la vue liste -->
    <record id="view_order_list_contract_fields" model="ir.ui.view">
        <field name="name">sale.order.list.contract.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_access_code" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Permettre la recherche par code d'accès -->
    <record id="view_order_search_contract_fields" model="ir.ui.view">
        <field name="name">sale.order.search.contract.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_access_code" string="Code d'accès"/>
            </xpath>
        </field>
    </record>

</odoo>
