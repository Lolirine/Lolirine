<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Menu principal de l'application Piscine -->
    <menuitem id="menu_pool_root"
        name="Piscine"
        web_icon="lolirine_pool_import,static/description/icon.png"
        sequence="50"/>
    
    <!-- Products Submenu -->
    <menuitem id="menu_pool_products"
        name="Produits Piscine"
        parent="menu_pool_root"
        action="action_pool_products"
        sequence="10"/>
    
    <!-- Produits du site web (tous les produits pool store) -->
    <menuitem id="menu_pool_website_products"
        name="Produits du site web"
        parent="menu_pool_root"
        action="action_pool_website_products"
        sequence="12"/>
    
    <!-- Extracteur de Catalogue (nouvelle vue split) -->
    <record id="action_pool_catalog_extractor" model="ir.actions.client">
        <field name="name">Extracteur de Catalogue IA</field>
        <field name="tag">pool_catalog_extractor</field>
    </record>
    
    <menuitem id="menu_pool_extractor"
        name="Extracteur IA"
        parent="menu_pool_root"
        action="action_pool_catalog_extractor"
        sequence="15"/>
    
    <!-- Extractions OCR (historique) -->
    <menuitem id="menu_pool_extractions"
        name="Extractions OCR"
        parent="menu_pool_root"
        action="action_pool_catalog_extraction"
        sequence="16"/>
    
    <!-- Catalogues (liste des catalogues créés) -->
    <menuitem id="menu_pool_catalogs"
        name="Catalogues"
        parent="menu_pool_root"
        action="action_pool_catalog"
        sequence="20"/>
    
    <!-- Import Submenu (wizard rapide) -->
    <menuitem id="menu_pool_import"
        name="Import rapide (JSON/CSV)"
        parent="menu_pool_root"
        action="action_pool_import_wizard"
        sequence="30"/>
    
    <!-- Import PDF Catalogue Fluidra -->
    <menuitem id="menu_pool_pdf_import"
        name="Import PDF Fluidra"
        parent="menu_pool_root"
        action="lolirine_pool_import.action_pool_catalog_pdf_parser"
        sequence="32"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_pool_config"
        name="Configuration"
        parent="menu_pool_root"
        sequence="100"/>
    
    <menuitem id="menu_pool_suppliers"
        name="Fournisseurs"
        parent="menu_pool_config"
        action="action_pool_supplier"
        sequence="10"/>
    
    <menuitem id="menu_pool_import_log"
        name="Historique des imports"
        parent="menu_pool_config"
        action="action_pool_import_log"
        sequence="20"/>
    
    <menuitem id="menu_pool_catalog_items"
        name="Éléments de catalogue"
        parent="menu_pool_config"
        action="action_pool_catalog_item"
        sequence="30"/>
    
    <menuitem id="menu_pool_extraction_products"
        name="Produits extraits"
        parent="menu_pool_config"
        action="action_pool_catalog_extraction_product"
        sequence="35"/>
    
    <menuitem id="menu_pool_sync_website"
        name="Synchroniser produits site web"
        parent="menu_pool_config"
        action="action_sync_website_products"
        sequence="40"/>
</data>
</odoo>
