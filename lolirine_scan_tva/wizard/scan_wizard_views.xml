<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue du wizard de scan avec 3 options -->
    <record id="view_lolirine_scan_tva_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.wizard.form</field>
        <field name="model">lolirine.scan.tva.wizard</field>
        <field name="arch" type="xml">
            <form string="Scanner une souche TVA">
                <sheet>
                    <!-- Sélection du mode -->
                    <group>
                        <group string="Mode de capture">
                            <field name="capture_mode" widget="radio"/>
                        </group>
                    </group>
                    
                    <!-- Mode Upload / Drag & Drop -->
                    <group invisible="capture_mode != 'upload'">
                        <group string="Uploader votre document" colspan="2">
                            <div colspan="2" class="text-center p-4" style="border: 3px dashed #ccc; border-radius: 10px; background: #fafafa;">
                                <p><i class="fa fa-cloud-upload fa-4x text-muted mb-3"/></p>
                                <h4>Glissez votre fichier ou cliquez pour parcourir</h4>
                                <field name="document" filename="document_filename" widget="binary" class="mt-3"/>
                                <field name="document_filename" invisible="1"/>
                                <p class="text-muted mt-2">
                                    <small><i class="fa fa-info-circle"/> Formats acceptés : JPG, PNG, PDF</small>
                                </p>
                            </div>
                        </group>
                    </group>
                    
                    <!-- Mode Webcam -->
                    <group invisible="capture_mode != 'webcam'">
                        <group string="Capture par camera" colspan="2">
                            <div colspan="2" class="alert alert-info">
                                <h4><i class="fa fa-camera"/> Capture par Webcam</h4>
                                <p>Cette fonctionnalité utilise la caméra de votre appareil.</p>
                                <ol>
                                    <li>Autorisez l'accès à la caméra si demandé par le navigateur</li>
                                    <li>Placez votre ticket face à la caméra</li>
                                    <li>Prenez une photo avec votre application caméra ou capture d'écran</li>
                                    <li>Enregistrez l'image et utilisez le mode "Uploader" ci-dessus</li>
                                </ol>
                                <p><strong>Astuce Mac :</strong> <kbd>⌘</kbd> + <kbd>Shift</kbd> + <kbd>5</kbd> pour capturer l'écran</p>
                            </div>
                            <div colspan="2">
                                <field name="document" filename="document_filename" widget="binary"/>
                                <field name="document_filename" invisible="1"/>
                            </div>
                        </group>
                    </group>
                    
                    <!-- Mode Scanner Mac -->
                    <group invisible="capture_mode != 'scanner'">
                        <group string="Scanner avec votre Mac" colspan="2">
                            <div colspan="2">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="alert alert-primary">
                                            <h5><i class="fa fa-apple"/> Méthode 1 : Transfert d'images</h5>
                                            <ol class="mb-0">
                                                <li>Appuyez sur <kbd>⌘</kbd> + <kbd>Espace</kbd></li>
                                                <li>Tapez <strong>"Transfert d'images"</strong></li>
                                                <li>Sélectionnez votre scanner</li>
                                                <li>Cliquez sur <strong>"Scanner"</strong></li>
                                                <li>Enregistrez puis uploadez ci-dessous</li>
                                            </ol>
                                        </div>
                                        
                                        <div class="alert alert-success">
                                            <h5><i class="fa fa-apple"/> Méthode 2 : Aperçu</h5>
                                            <ol class="mb-0">
                                                <li>Ouvrez <strong>Aperçu</strong> (Preview)</li>
                                                <li>Menu <strong>Fichier → Importer depuis le scanner</strong></li>
                                                <li>Scannez et enregistrez</li>
                                                <li>Uploadez ci-dessous</li>
                                            </ol>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="alert alert-info">
                                            <h5><i class="fa fa-mobile"/> Méthode 3 : iPhone/iPad</h5>
                                            <ol class="mb-0">
                                                <li>Ouvrez <strong>Notes</strong> ou <strong>Fichiers</strong></li>
                                                <li>Touchez <strong>+</strong> → <strong>Scanner</strong></li>
                                                <li>Photographiez votre ticket</li>
                                                <li>Envoyez par <strong>AirDrop</strong></li>
                                                <li>Uploadez ci-dessous</li>
                                            </ol>
                                        </div>
                                        
                                        <div class="alert alert-secondary text-center">
                                            <h5><i class="fa fa-keyboard-o"/> Raccourci rapide</h5>
                                            <p class="h4">
                                                <kbd>⌘</kbd> + <kbd>Shift</kbd> + <kbd>I</kbd>
                                            </p>
                                            <p class="mb-0 text-muted">Ouvre Transfert d'images</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div colspan="2" class="mt-3">
                                <span class="o_form_label">Uploader le fichier scanne :</span>
                                <field name="document" filename="document_filename" widget="binary"/>
                                <field name="document_filename" invisible="1"/>
                            </div>
                        </group>
                    </group>
                    
                    <!-- Notes -->
                    <group>
                        <group string="Notes">
                            <field name="notes" placeholder="Notes optionnelles..." nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
                
                <footer>
                    <button name="action_create_scan" 
                            type="object" 
                            string="Scanner et extraire" 
                            class="btn-primary"
                            icon="fa-magic"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Vue du wizard d'extraction manuelle -->
    <record id="view_lolirine_scan_tva_extract_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.extract.wizard.form</field>
        <field name="model">lolirine.scan.tva.extract.wizard</field>
        <field name="arch" type="xml">
            <form string="Extraction manuelle">
                <group>
                    <group string="Fournisseur">
                        <field name="supplier_vat" placeholder="BE0123456789"/>
                        <field name="supplier_name"/>
                    </group>
                    <group string="Facture">
                        <field name="invoice_number"/>
                        <field name="invoice_date"/>
                    </group>
                </group>
                <group>
                    <group string="Montants">
                        <field name="tax_rate"/>
                        <field name="amount_untaxed"/>
                        <field name="amount_tax"/>
                        <field name="amount_total"/>
                    </group>
                    <group string="Texte OCR (reference)">
                        <field name="ocr_text" readonly="1" nolabel="1"/>
                    </group>
                </group>
                <field name="scan_id" invisible="1"/>
                <footer>
                    <button name="action_apply" 
                            type="object" 
                            string="Appliquer" 
                            class="btn-primary"
                            icon="fa-check"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
