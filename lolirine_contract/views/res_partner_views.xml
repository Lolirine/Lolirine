<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_id_card" model="ir.ui.view">
        <field name="name">res.partner.form.id.card</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Carte d'identite" name="id_card">
                    <group>
                        <group string="Recto">
                            <field name="id_card_recto" widget="image" class="oe_avatar" options="{'size': [300, 200]}"/>
                            <field name="id_card_recto_filename" invisible="1"/>
                            <field name="id_card_recto" filename="id_card_recto_filename" widget="binary" string="Telecharger/Modifier"/>
                        </group>
                        <group string="Verso">
                            <field name="id_card_verso" widget="image" class="oe_avatar" options="{'size': [300, 200]}"/>
                            <field name="id_card_verso_filename" invisible="1"/>
                            <field name="id_card_verso" filename="id_card_verso_filename" widget="binary" string="Telecharger/Modifier"/>
                        </group>
                    </group>
                    <group>
                        <field name="id_card_uploaded" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
