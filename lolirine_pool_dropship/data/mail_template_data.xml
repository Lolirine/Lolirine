<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================ -->
        <!-- TEMPLATE DEVIS PISCINE (NOUVEAU) -->
        <!-- ============================================ -->
        <record id="email_template_dropship_quote" model="mail.template">
            <field name="name">Dropshipping: Devis piscine</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Lolirine Pool Store - Votre devis {{ object.dropship_ref or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="report_template_ids" eval="[(4, ref('sale.action_report_saleorder'))]"/>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #0078D4; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Lolirine Pool Store</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Suite a votre demande, nous avons le plaisir de vous transmettre notre devis pour votre projet piscine.</p>
        <div style="background: #f0f7ff; border-left: 4px solid #0078D4; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Reference devis :</strong> {{ object.dropship_ref or object.name }}</p>
            <p style="margin: 5px 0 0 0;"><strong>Montant total :</strong> {{ '%.2f' % object.amount_total }} EUR TTC</p>
            <p style="margin: 5px 0 0 0;"><strong>Validite :</strong> {{ object.validity_date or 'Non definie' }}</p>
        </div>
        <p>Vous trouverez ci-joint le detail complet de notre offre au format PDF.</p>
        <div style="background: #e8f5e9; padding: 15px; border-radius: 4px; margin: 20px 0;">
            <strong>Prochaine etape :</strong><br/>
            Si ce devis vous convient, confirmez votre accord par retour d'e-mail
            ou par telephone et nous lancerons immediatement la commande.
        </div>
        <p>Pour toute question : <strong>+32 (0)497 44 41 46</strong></p>
        <p style="margin-top: 25px;">Cordialement,<br/>
        <strong>L'equipe Lolirine Pool Store</strong><br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE CONFIRMATION COMMANDE (NOUVEAU) -->
        <!-- ============================================ -->
        <record id="email_template_dropship_order_confirmed" model="mail.template">
            <field name="name">Dropshipping: Confirmation commande client</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Lolirine Pool Store - Confirmation de votre commande {{ object.dropship_ref or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="report_template_ids" eval="[(4, ref('sale.action_report_saleorder'))]"/>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #0078D4; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Lolirine Pool Store</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Nous avons bien recu votre commande et nous vous en remercions !</p>
        <div style="background: #f0f7ff; border-left: 4px solid #0078D4; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Reference commande :</strong> {{ object.dropship_ref or object.name }}</p>
            <p style="margin: 5px 0 0 0;"><strong>Montant :</strong> {{ '%.2f' % object.amount_total }} EUR TTC</p>
        </div>
        <h3 style="color: #0078D4;">Prochaines etapes</h3>
        <ol style="line-height: 1.8;">
            <li>Commande confirmee et en cours de traitement</li>
            <li>Preparation et expedition par notre partenaire logistique</li>
            <li>Vous recevrez un email avec le suivi des l'expedition</li>
            <li>Livraison a votre adresse</li>
        </ol>
        <div style="background: #fff3cd; padding: 12px; border-radius: 4px; margin: 15px 0;">
            <strong>Adresse de livraison :</strong><br/>
            {{ object.partner_shipping_id.name }}<br/>
            {{ object.partner_shipping_id.street or '' }}<br/>
            {{ object.partner_shipping_id.zip or '' }} {{ object.partner_shipping_id.city or '' }}<br/>
            {{ object.partner_shipping_id.country_id.name or '' }}
        </div>
        <p>Pour toute question : <strong>+32 (0)497 44 41 46</strong></p>
        <p style="margin-top: 25px;">Cordialement,<br/>
        <strong>L'equipe Lolirine Pool Store</strong><br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE COMMANDE EN PREPARATION -->
        <!-- ============================================ -->
        <record id="email_template_dropship_po_sent" model="mail.template">
            <field name="name">Dropshipping: Commande en preparation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre commande {{ object.dropship_ref or object.name }} est en preparation</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #0078D4; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Lolirine Pool Store</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Votre commande <strong>{{ object.dropship_ref or object.name }}</strong> a ete transmise a notre partenaire logistique pour preparation.</p>
        <div style="background: #d4edda; border-left: 4px solid #28a745; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Statut :</strong> En preparation</p>
            <p style="margin: 5px 0 0 0;">Vous recevrez un email avec le numero de suivi des que votre commande sera expediee.</p>
        </div>
        <p>Cordialement,<br/><strong>L'equipe Lolirine Pool Store</strong></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE COMMANDE FOURNISSEUR -->
        <!-- ============================================ -->
        <record id="email_template_dropship_po" model="mail.template">
            <field name="name">Dropshipping: Commande fournisseur</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Commande Dropshipping {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.dropship_order_email or object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #343a40; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Commande Dropshipping</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour,</p>
        <p>Veuillez trouver ci-dessous notre commande <strong>{{ object.name }}</strong>.</p>
        <div style="background: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>LIVRAISON DIRECTE AU CLIENT FINAL :</strong></p>
            <p style="margin: 5px 0 0 0;">
                <strong>{{ object.dest_address_id.name }}</strong><br/>
                {{ object.dest_address_id.street or '' }}<br/>
                {{ object.dest_address_id.zip or '' }} {{ object.dest_address_id.city or '' }}<br/>
                {{ object.dest_address_id.country_id.name or '' }}
            </p>
        </div>
        <div style="background: #f8d7da; padding: 12px; border-radius: 4px; margin: 15px 0;">
            <strong>EMBALLAGE NEUTRE REQUIS</strong><br/>
            NE PAS INCLURE DE FACTURE DANS LE COLIS
        </div>
        <p>Merci de confirmer la reception et le delai de livraison estime.</p>
        <p>Cordialement,<br/>{{ object.company_id.name }}</p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE EXPEDITION -->
        <!-- ============================================ -->
        <record id="email_template_dropship_shipped" model="mail.template">
            <field name="name">Dropshipping: Notification expedition</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre commande {{ object.dropship_ref or object.name }} a ete expediee</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #28a745; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Commande expediee !</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Bonne nouvelle ! Votre commande <strong>{{ object.dropship_ref or object.name }}</strong> vient d'etre expediee.</p>
        <div style="background: #fff3cd; padding: 12px; border-radius: 4px; margin: 15px 0;">
            <strong>Livraison prevue a :</strong><br/>
            {{ object.partner_shipping_id.name }}<br/>
            {{ object.partner_shipping_id.street or '' }}<br/>
            {{ object.partner_shipping_id.zip or '' }} {{ object.partner_shipping_id.city or '' }}
        </div>
        <p>Cordialement,<br/><strong>L'equipe Lolirine Pool Store</strong><br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE LIVRAISON -->
        <!-- ============================================ -->
        <record id="email_template_dropship_delivered" model="mail.template">
            <field name="name">Dropshipping: Confirmation livraison</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre commande {{ object.dropship_ref or object.name }} a ete livree</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #28a745; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Commande livree !</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Votre commande <strong>{{ object.dropship_ref or object.name }}</strong> a ete livree avec succes.</p>
        <p>Si vous avez la moindre question, n'hesitez pas a nous contacter.</p>
        <p>Merci pour votre confiance !<br/>
        <strong>L'equipe Lolirine Pool Store</strong><br/>
        +32 (0)497 44 41 46<br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE PROBLEME -->
        <!-- ============================================ -->
        <record id="email_template_dropship_issue" model="mail.template">
            <field name="name">Dropshipping: Notification probleme</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Information sur votre commande {{ object.dropship_ref or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #dc3545; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Information importante</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Nous vous contactons au sujet de votre commande <strong>{{ object.dropship_ref or object.name }}</strong>.</p>
        <p>Un point necessite notre attention. Notre equipe traite la situation dans les meilleurs delais.</p>
        <p>Pour toute question urgente : <strong>+32 (0)497 44 41 46</strong></p>
        <p>Cordialement,<br/><strong>L'equipe Lolirine Pool Store</strong></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
