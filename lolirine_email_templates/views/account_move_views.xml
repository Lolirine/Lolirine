<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================= -->
    <!-- FACTURE - EXTENSION FORMULAIRE -->
    <!-- ============================================= -->
    <record id="view_move_form_email_scheduled" model="ir.ui.view">
        <field name="name">account.move.form.email.scheduled</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter les champs après le champ invoice_date_due -->
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="scheduled_email_send" 
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="email_send_date" 
                       invisible="move_type not in ('out_invoice', 'out_refund') or not scheduled_email_send"/>
                <field name="email_pending" readonly="1"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not scheduled_email_send"/>
                <field name="email_sent" readonly="1"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="email_sent_date" readonly="1"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not email_sent"/>
            </xpath>
            
            <!-- Ajouter bouton "Envoyer Email" dans le header -->
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_send_invoice_email_now" 
                        string="📧 Envoyer Email"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'posted' or email_sent or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
    
    <!-- ============================================= -->
    <!-- ACTION - FACTURES EN ATTENTE D'ENVOI -->
    <!-- ============================================= -->
    <record id="action_invoices_pending_email" model="ir.actions.act_window">
        <field name="name">Factures en attente d'envoi</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[
            ('email_pending', '=', True),
            ('email_sent', '=', False),
            ('move_type', 'in', ['out_invoice', 'out_refund']),
            ('state', '=', 'posted')
        ]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune facture en attente d'envoi
            </p>
            <p>
                Les factures avec "Envoi email planifié" coché apparaîtront ici
                jusqu'à ce que l'email soit envoyé à leur date de facturation.
            </p>
        </field>
    </record>
    
</odoo>
