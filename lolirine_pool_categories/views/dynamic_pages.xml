<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- PAGE BOUTIQUE DYNAMIQUE - ÉDITABLE         -->
    <!-- ============================================ -->
    
    <template id="page_boutique_dynamic" name="Pool Store - Boutique (Dynamic)">
        <t t-call="website.layout">
            <div id="wrap" class="pool-shop-wrap">
                <div class="oe_structure oe_empty">
                
                    <!-- HERO - Structure éditable -->
                    <section class="s_cover parallax s_parallax_is_fixed pt96 pb96 o_cc o_cc1" 
                             data-scroll-background-ratio="1"
                             data-snippet="s_cover"
                             data-name="Couverture">
                        <span class="s_parallax_bg_wrap" data-snippet="s_parallax_bg">
                            <span class="s_parallax_bg oe_img_bg oe_custom_bg o_bg_img_center" style="background-image: url('/web/image/website.library_image_10'); background-position: 50% 50%;"/>
                        </span>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="container s_allow_columns">
                            <div class="row s_nb_column_fixed">
                                <div class="col-lg-7 pt48 pb48">
                                    <h1 class="display-4 fw-bold o_default_snippet_text">
                                        Tout pour votre piscine &amp; spa
                                    </h1>
                                    <p class="lead o_default_snippet_text">
                                        Découvrez notre sélection de produits de qualité professionnelle pour l'entretien et l'équipement de votre espace aquatique.
                                    </p>
                                    <div class="d-flex gap-3 flex-wrap mt-4">
                                        <a href="/shop" class="btn btn-primary btn-lg rounded-pill px-4">
                                            <i class="fa fa-shopping-bag me-2"/>Tous les produits
                                        </a>
                                        <a href="/pool/devis" class="btn btn-outline-primary btn-lg rounded-pill px-4">
                                            <i class="fa fa-headset me-2"/>Besoin de conseils ?
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                
                <!-- SECTION: EXPLOREZ NOS UNIVERS - Cartes dynamiques avec images de catégorie -->
                    <section class="s_text_block py-5 bg-white" data-snippet="s_text_block" data-name="Univers">
                        <div class="container py-4">
                            <div class="text-center mb-5">
                                <h2 class="h1 fw-bold o_default_snippet_text">Explorez nos univers</h2>
                                <p class="lead text-muted o_default_snippet_text">
                                    Trouvez tout ce dont vous avez besoin, classé par catégorie.
                                </p>
                            </div>
                            
                            <div class="row g-4">
                                <!-- Boucle sur les univers -->
                                <t t-foreach="universes" t-as="universe">
                                    <div class="col-lg-3 col-md-6">
                                        <a t-att-href="universe['page_url']" class="text-decoration-none">
                                            <div class="card border-0 rounded-4 overflow-hidden shadow-sm" style="height: 280px;">
                                                <!-- Si la catégorie a une image, l'utiliser comme background -->
                                                <t t-if="universe.get('category') and universe['category'].image_1920">
                                                    <div class="h-100 position-relative o_bg_img_center" 
                                                         t-attf-style="background-image: url('/web/image/product.public.category/#{universe['category'].id}/image_1920'); background-size: cover;">
                                                        <div class="position-absolute top-0 start-0 w-100 h-100" t-att-style="'background: %s;' % universe.get('overlay', 'linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.7))')"/>
                                                        <div class="position-absolute bottom-0 start-0 p-4 text-white">
                                                            <h4 class="fw-bold mb-1" t-esc="universe['name']"/>
                                                            <span class="small fw-semibold opacity-75">Découvrir <i class="fa fa-arrow-right ms-1"/></span>
                                                        </div>
                                                    </div>
                                                </t>
                                                <!-- Sinon utiliser le dégradé de couleur avec icône -->
                                                <t t-else="">
                                                    <div class="h-100 position-relative" t-att-style="'background: %s;' % universe['gradient']">
                                                        <div class="position-absolute top-50 start-50 translate-middle text-center text-white" style="opacity: 0.3;">
                                                            <i t-att-class="'fa %s fa-4x' % universe['icon']"/>
                                                        </div>
                                                        <div class="position-absolute bottom-0 start-0 p-4 text-white">
                                                            <h4 class="fw-bold mb-1" t-esc="universe['name']"/>
                                                            <span class="small fw-semibold opacity-75">Découvrir <i class="fa fa-arrow-right ms-1"/></span>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </section>
                
                <!-- SECTION: AVANTAGES ÉDITABLE -->
                <section class="s_text_block py-5 pshop-bg-light" data-snippet="s_text_block" data-name="Avantages Boutique">
                    <div class="container">
                        <div class="row g-4 text-center oe_structure" data-name="Grille Avantages">
                            <div class="col-md-3 col-6">
                                <div class="pshop-advantage">
                                    <div class="pshop-advantage-icon">
                                        <i class="fa fa-truck"/>
                                    </div>
                                    <h5>Livraison rapide</h5>
                                    <p>Expédition sous 24-48h</p>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="pshop-advantage">
                                    <div class="pshop-advantage-icon">
                                        <i class="fa fa-shield-alt"/>
                                    </div>
                                    <h5>Paiement sécurisé</h5>
                                    <p>CB, Bancontact, PayPal</p>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="pshop-advantage">
                                    <div class="pshop-advantage-icon">
                                        <i class="fa fa-headset"/>
                                    </div>
                                    <h5>Conseils experts</h5>
                                    <p>Une équipe à votre écoute</p>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="pshop-advantage">
                                    <div class="pshop-advantage-icon">
                                        <i class="fa fa-medal"/>
                                    </div>
                                    <h5>Qualité pro</h5>
                                    <p>Produits sélectionnés</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- ZONE ÉDITABLE -->
                <div class="oe_structure oe_empty" data-name="Zone personnalisable Boutique"/>
                
                <!-- CTA ÉDITABLE -->
                <section class="s_cover pshop-cta o_cc o_cc1" 
                         data-snippet="s_cover" 
                         data-name="CTA Boutique"
                         style="background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);">
                    <div class="container py-5 oe_structure" data-name="Contenu CTA Boutique">
                        <div class="row align-items-center">
                            <div class="col-lg-8 mb-4 mb-lg-0">
                                <h2 class="o_default_snippet_text">Besoin d'un conseil personnalisé ?</h2>
                                <p class="o_default_snippet_text">Notre équipe d'experts est là pour vous accompagner dans vos choix.</p>
                            </div>
                            <div class="col-lg-4 text-lg-end">
                                <a href="tel:+32497444146" class="btn btn-light btn-lg rounded-pill">
                                    <i class="fa fa-phone me-2"/>+32 497 44 41 46
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
                
                </div>
            </div>
        </t>
    </template>


    <!-- ============================================ -->
    <!-- TEMPLATE UNIVERS DYNAMIQUE - ÉDITABLE     -->
    <!-- ============================================ -->
    
    <template id="page_univers_dynamic" name="Pool Store - Page Univers (Dynamic)">
        <t t-call="website.layout">
            <div id="wrap" class="pool-shop-wrap">
                <div class="oe_structure oe_empty">
                
                    <!-- HERO - Structure éditable avec variables dynamiques -->
                    <section class="s_cover parallax s_parallax_is_fixed pt80 pb80 o_cc o_cc1"
                             data-scroll-background-ratio="1"
                             data-snippet="s_cover"
                             data-name="Couverture">
                        <span class="s_parallax_bg_wrap" data-snippet="s_parallax_bg">
                            <span class="s_parallax_bg oe_img_bg oe_custom_bg o_bg_img_center" 
                                  t-att-style="'background-image: url(%s); background-position: 50%% 50%%;' % (hero_image or '/web/image/website.library_image_08')"/>
                        </span>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="container s_allow_columns">
                            <div class="row s_nb_column_fixed">
                                <div class="col-lg-8 pt32 pb32">
                                    <nav class="mb-3 small">
                                        <a href="/" class="text-white-50 text-decoration-none">Accueil</a> 
                                        <span class="text-white-50 mx-2">/</span> 
                                        <a href="/boutique" class="text-white-50 text-decoration-none">Boutique</a> 
                                        <span class="text-white-50 mx-2">/</span> 
                                        <span t-esc="universe_name"/>
                                    </nav>
                                    <h1 class="display-5 fw-bold o_default_snippet_text" t-esc="universe_name"/>
                                    <p class="lead o_default_snippet_text" t-esc="universe_description"/>
                                    <a t-att-href="parent_url" class="btn btn-outline-primary rounded-pill px-4 mt-3">
                                        <i class="fa fa-th me-2"/>Voir tous les produits
                                    </a>
                                </div>
                                <div class="col-lg-4 text-center d-none d-lg-flex align-items-center justify-content-center">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; background: rgba(255,255,255,0.15);">
                                        <i t-att-class="'fa %s fa-3x text-white' % universe_icon"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                
                <!-- SOUS-CATÉGORIES DYNAMIQUES -->
                <section class="s_text_block py-5" data-snippet="s_text_block" data-name="Sous-catégories">
                    <div class="container">
                        <h2 class="pshop-content-title mb-4 oe_structure" data-name="Titre catégories">Parcourir les catégories</h2>
                        
                        <div class="row g-4">
                            <t t-foreach="subcategories" t-as="subcat">
                                <div class="col-lg-4 col-md-6">
                                    <a t-att-href="subcat['url']" class="text-decoration-none">
                                        <div class="pshop-subcat-card">
                                            <div class="pshop-subcat-img">
                                                <!-- Image si disponible -->
                                                <t t-if="subcat.get('image')">
                                                    <img t-att-src="'/web/image/product.public.category/%s/image_1920' % subcat['id']"
                                                         t-att-alt="subcat['name']"/>
                                                </t>
                                                <!-- Sinon placeholder -->
                                                <t t-else="">
                                                    <div t-att-class="'pshop-subcat-placeholder pshop-bg-%s' % universe_color">
                                                        <i t-att-class="'fa %s' % subcat.get('icon', 'fa-box')"/>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="pshop-subcat-content">
                                                <h4 t-esc="subcat['name']"/>
                                                <p t-if="subcat.get('description')" t-esc="subcat['description']"/>
                                                <p t-else="">Voir nos produits</p>
                                                <span class="pshop-subcat-link">
                                                    Voir les produits <i class="fa fa-arrow-right ms-1"/>
                                                </span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                        
                        <!-- Message si pas de sous-catégories -->
                        <t t-if="not subcategories">
                            <div class="text-center py-5">
                                <i class="fa fa-inbox fa-3x text-muted mb-3"/>
                                <p class="text-muted">Les catégories seront bientôt disponibles.</p>
                                <a t-att-href="parent_url" class="pshop-btn-primary">
                                    Voir tous les produits
                                </a>
                            </div>
                        </t>
                        
                        <!-- Bouton voir tous -->
                        <t t-if="subcategories">
                            <div class="text-center mt-5">
                                <a t-att-href="parent_url" class="btn btn-primary rounded-pill px-4">
                                    <i class="fa fa-th me-2"/>Voir tous les produits <t t-esc="universe_name"/>
                                </a>
                            </div>
                        </t>
                    </div>
                </section>
                
                </div>
            </div>
        </t>
    </template>


    <!-- ============================================ -->
    <!-- PAGE WELLNESS SPÉCIFIQUE - ÉDITABLE        -->
    <!-- ============================================ -->
    
    <template id="page_wellness" name="Pool Store - Espace Wellness">
        <t t-call="website.layout">
            <div id="wrap" class="pool-shop-wrap">
                <div class="oe_structure oe_empty">
                
                    <!-- HERO WELLNESS - Structure éditable -->
                    <section class="s_cover parallax s_parallax_is_fixed pt80 pb80 o_cc o_cc1" 
                             data-scroll-background-ratio="1"
                             data-snippet="s_cover"
                             data-name="Couverture">
                        <span class="s_parallax_bg_wrap" data-snippet="s_parallax_bg">
                            <span class="s_parallax_bg oe_img_bg oe_custom_bg o_bg_img_center" style="background-image: url('/web/image/website.library_image_03'); background-position: 50% 50%;"/>
                        </span>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="container s_allow_columns">
                            <div class="row s_nb_column_fixed">
                                <div class="col-lg-8 pt32 pb32">
                                    <nav class="mb-3 small">
                                        <a href="/" class="text-white-50 text-decoration-none">Accueil</a> 
                                        <span class="text-white-50 mx-2">/</span> 
                                        <a href="/boutique" class="text-white-50 text-decoration-none">Boutique</a> 
                                        <span class="text-white-50 mx-2">/</span> 
                                        <span>Espace Wellness</span>
                                    </nav>
                                    <h1 class="display-5 fw-bold o_default_snippet_text">Espace Wellness</h1>
                                    <p class="lead o_default_snippet_text">Spa, jacuzzi, sauna et accessoires bien-être. Transformez votre jardin en oasis de détente.</p>
                                    <a href="/shop/category/wellness" class="btn btn-outline-primary rounded-pill px-4 mt-3">
                                        <i class="fa fa-th me-2"/>Voir tous les produits Wellness
                                    </a>
                                </div>
                                <div class="col-lg-4 text-center d-none d-lg-flex align-items-center justify-content-center">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; background: rgba(139, 92, 246, 0.3);">
                                        <i class="fa fa-hot-tub fa-3x text-white"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                
                <!-- CATÉGORIES WELLNESS -->
                <section class="s_text_block py-5" data-snippet="s_text_block" data-name="Catégories Wellness">
                    <div class="container">
                        <div class="text-center mb-5 oe_structure" data-name="Intro Wellness">
                            <h2 class="pshop-section-title">Nos univers bien-être</h2>
                            <p class="pshop-section-subtitle">Découvrez notre sélection pour votre confort et relaxation</p>
                        </div>
                        
                        <div class="row g-4 oe_structure" data-name="Grille Wellness">
                            <!-- Spa & Jacuzzi -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/shop/category/spa-jacuzzi" class="text-decoration-none">
                                    <div class="pshop-subcat-card">
                                        <div class="pshop-subcat-img">
                                            <div class="pshop-subcat-placeholder pshop-bg-purple">
                                                <i class="fa fa-hot-tub"/>
                                            </div>
                                        </div>
                                        <div class="pshop-subcat-content">
                                            <h4>Spa &amp; Jacuzzi</h4>
                                            <p>Bains à remous, spas gonflables et encastrés</p>
                                            <span class="pshop-subcat-link">
                                                Découvrir <i class="fa fa-arrow-right ms-1"/>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            
                            <!-- Sauna -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/shop/category/sauna" class="text-decoration-none">
                                    <div class="pshop-subcat-card">
                                        <div class="pshop-subcat-img">
                                            <div class="pshop-subcat-placeholder pshop-bg-orange">
                                                <i class="fa fa-temperature-high"/>
                                            </div>
                                        </div>
                                        <div class="pshop-subcat-content">
                                            <h4>Sauna</h4>
                                            <p>Cabines sauna traditionnelles et infrarouges</p>
                                            <span class="pshop-subcat-link">
                                                Découvrir <i class="fa fa-arrow-right ms-1"/>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            
                            <!-- Accessoires Wellness -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/shop/category/accessoires-wellness" class="text-decoration-none">
                                    <div class="pshop-subcat-card">
                                        <div class="pshop-subcat-img">
                                            <div class="pshop-subcat-placeholder pshop-bg-cyan">
                                                <i class="fa fa-spa"/>
                                            </div>
                                        </div>
                                        <div class="pshop-subcat-content">
                                            <h4>Accessoires Wellness</h4>
                                            <p class="o_default_snippet_text">Aromathérapie, produits de soin et équipements</p>
                                            <span class="text-primary fw-bold">
                                                Découvrir <i class="fa fa-arrow-right ms-1"/>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
                
                    <!-- CTA WELLNESS -->
                    <section class="s_text_block py-5 bg-primary" data-snippet="s_text_block" data-name="CTA Wellness">
                        <div class="container text-center text-white py-4">
                            <h2 class="display-6 fw-bold mb-3 o_default_snippet_text">Envie de vous faire conseiller ?</h2>
                            <p class="lead mb-4 o_default_snippet_text">Nos experts wellness sont à votre disposition pour vous guider vers la solution idéale.</p>
                            <a href="/pool/devis" class="btn btn-lg btn-light px-5 py-3 rounded-pill">
                                <i class="fa fa-paper-plane me-2"/>Demander un devis
                            </a>
                        </div>
                    </section>
                
                </div>
            </div>
        </t>
    </template>

</odoo>
