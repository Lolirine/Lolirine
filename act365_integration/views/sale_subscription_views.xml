<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit sale.order (subscription) form view -->
    <record id="sale_subscription_view_form_inherit_act365" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.act365</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="arch" type="xml">
            <!-- Add ACT365 button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_assign_act365_code" 
                        type="object" 
                        string="🔑 Code ACT365"
                        class="btn-secondary"
                        invisible="not is_subscription"/>
            </xpath>
            
            <!-- Add ACT365 page in notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Accès ACT365" name="act365_access" invisible="not is_subscription">
                    <group>
                        <group string="Code d'accès">
                            <field name="act365_access_code" password="True"/>
                            <field name="act365_group_id"/>
                            <field name="act365_cardholder_id" readonly="1"/>
                        </group>
                        <group string="Statut">
                            <field name="act365_synced" readonly="1"/>
                            <field name="act365_enabled" readonly="1"/>
                            <field name="act365_last_sync" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Période de validité">
                            <field name="act365_valid_from"/>
                            <field name="act365_valid_to"/>
                        </group>
                    </group>
                    <group>
                        <div class="d-flex gap-2">
                            <button name="action_assign_act365_code" 
                                    type="object" 
                                    string="🔑 Attribuer un code"
                                    class="btn-primary"/>
                            <button name="action_sync_act365" 
                                    type="object" 
                                    string="🔄 Synchroniser"
                                    class="btn-secondary"
                                    invisible="not act365_access_code"/>
                            <button name="action_enable_act365_access" 
                                    type="object" 
                                    string="✓ Activer l'accès"
                                    class="btn-success"
                                    invisible="not act365_cardholder_id or act365_enabled"/>
                            <button name="action_disable_act365_access" 
                                    type="object" 
                                    string="✗ Désactiver l'accès"
                                    class="btn-warning"
                                    invisible="not act365_cardholder_id or not act365_enabled"/>
                            <button name="action_view_act365_info" 
                                    type="object" 
                                    string="ℹ️ Infos ACT365"
                                    class="btn-secondary"
                                    invisible="not act365_cardholder_id"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Add ACT365 code to subscription tree view -->
    <record id="sale_subscription_view_tree_inherit_act365" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.act365</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="act365_access_code" optional="show" string="Code accès"/>
                <field name="act365_enabled" optional="hide" string="Accès actif"/>
            </xpath>
        </field>
    </record>

    <!-- Search filter for ACT365 -->
    <record id="sale_subscription_view_search_inherit_act365" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.act365</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_subscriptions']" position="after">
                <separator/>
                <filter name="has_act365_code" string="Avec code ACT365" 
                        domain="[('act365_access_code', '!=', False)]"/>
                <filter name="act365_enabled" string="Accès ACT365 actif" 
                        domain="[('act365_enabled', '=', True)]"/>
                <filter name="act365_not_synced" string="Non synchronisé" 
                        domain="[('act365_access_code', '!=', False), ('act365_synced', '=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
