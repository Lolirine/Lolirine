<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pool_return_list" model="ir.ui.view">
        <field name="name">pool.return.list</field>
        <field name="model">pool.return</field>
        <field name="arch" type="xml">
            <list string="Retours clients" decoration-info="state == 'submitted'" decoration-muted="state in ('cancel', 'refused')"
                  decoration-success="state == 'refunded'">
                <field name="name"/>
                <field name="date_demande"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="motif"/>
                <field name="type_retour" optional="show"/>
                <field name="eligible" widget="boolean" optional="show"/>
                <field name="montant_rembourse" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-warning="state == 'approved'"
                       decoration-success="state in ('received', 'refunded')" decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="view_pool_return_form" model="ir.ui.view">
        <field name="name">pool.return.form</field>
        <field name="model">pool.return</field>
        <field name="arch" type="xml">
            <form string="Retour client">
                <header>
                    <button name="action_soumettre" type="object" string="Soumettre" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_accepter" type="object" string="Accepter et envoyer le bon" class="btn-primary"
                            invisible="state not in ('submitted', 'refused')"/>
                    <button name="action_refuser" type="object" string="Refuser" invisible="state != 'submitted'"
                            confirm="Refuser ce retour ? Pensez à expliquer le motif au client dans le fil de discussion."/>
                    <button name="action_recu" type="object" string="Article reçu" class="btn-primary"
                            invisible="state != 'approved' or sans_renvoi"/>
                    <button name="action_creer_avoir" type="object" string="Créer l'avoir" class="btn-primary"
                            invisible="state not in ('received', 'approved') or refund_id or (state == 'approved' and not sans_renvoi)"/>
                    <button name="action_voir_avoir" type="object" string="Voir l'avoir" invisible="not refund_id"/>
                    <button name="action_marquer_rembourse" type="object" string="Marquer remboursé"
                            invisible="state not in ('received', 'approved') or not refund_id"/>
                    <button name="action_demander_rma" type="object" string="Demander le RMA"
                            invisible="state not in ('submitted', 'approved') or not fournisseur_id"/>
                    <button name="action_imprimer_bon" type="object" string="Bon de retour" invisible="state in ('draft', 'cancel')"/>
                    <button name="action_annuler" type="object" string="Annuler" invisible="state in ('cancel', 'refunded')"/>
                    <button name="action_remettre_brouillon" type="object" string="Remettre en brouillon" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,approved,received,refunded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_avoir" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not refund_id">
                            <div class="o_stat_info"><span class="o_stat_text">Avoir</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Hors conditions" bg_color="text-bg-danger" invisible="eligible or state in ('cancel', 'refunded')"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Demande">
                            <field name="order_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="motif" readonly="state not in ('draft', 'submitted')"/>
                            <field name="type_retour"/>
                            <field name="date_demande"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Conditions">
                            <field name="date_livraison"/>
                            <field name="date_limite"/>
                            <field name="est_professionnel"/>
                            <field name="eligible"/>
                            <field name="eligibilite_note" nolabel="1" colspan="2" class="text-muted"/>
                        </group>
                    </group>
                    <group>
                        <group string="Renvoi">
                            <field name="fournisseur_id"/>
                            <field name="retour_direct_fournisseur" invisible="type_retour != 'retractation'"/>
                            <field name="date_limite_fournisseur" invisible="not retour_direct_fournisseur"/>
                            <field name="rma_fournisseur" invisible="sans_renvoi"/>
                            <field name="rma_attachment_ids" widget="many2many_binary" invisible="sans_renvoi"/>
                            <field name="sans_renvoi"/>
                            <field name="frais_renvoi" invisible="sans_renvoi"/>
                            <field name="adresse_retour" invisible="sans_renvoi" placeholder="Adresse où le client renvoie l'article"/>
                            <div colspan="2" invisible="sans_renvoi or state not in ('draft', 'submitted')">
                                <button name="action_adresse_fournisseur" type="object" string="Adresse du fournisseur" class="btn-link"/>
                                <button name="action_adresse_boninne" type="object" string="Adresse de Boninne" class="btn-link"/>
                            </div>
                            <field name="date_reception" invisible="sans_renvoi"/>
                        </group>
                        <group string="Montants">
                            <field name="currency_id" invisible="1"/>
                            <field name="montant_articles"/>
                            <field name="frais_remise_stock" invisible="not frais_remise_stock"/>
                            <field name="montant_rembourse"/>
                            <field name="refund_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Articles" name="lignes">
                            <field name="line_ids" readonly="state not in ('draft', 'submitted')">
                                <list editable="bottom">
                                    <field name="order_line_id" domain="[('order_id', '=', parent.order_id), ('display_type', '=', False)]"
                                           options="{'no_create': True}"/>
                                    <field name="product_id"/>
                                    <field name="quantite"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="prix_unitaire"/>
                                    <field name="montant" sum="Total"/>
                                    <field name="exclu" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                        <page string="Commentaire du client" name="commentaire">
                            <field name="commentaire" placeholder="Explication donnée par le client"/>
                        </page>
                        <page string="Note interne" name="note">
                            <field name="note_interne" placeholder="Décision, échange avec le fournisseur, n° d'accord de retour SCP / Fluidra…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pool_return_search" model="ir.ui.view">
        <field name="name">pool.return.search</field>
        <field name="model">pool.return</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <filter name="a_traiter" string="À traiter" domain="[('state', 'in', ('submitted', 'approved', 'received'))]"/>
                <filter name="hors_conditions" string="Hors conditions" domain="[('eligible', '=', False)]"/>
                <separator/>
                <filter name="retractation" string="Rétractations" domain="[('type_retour', '=', 'retractation')]"/>
                <filter name="garantie" string="Garantie / dommages" domain="[('type_retour', 'in', ('defaut', 'dommage', 'erreur'))]"/>
                <group>
                    <filter name="grp_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="grp_motif" string="Motif" context="{'group_by': 'motif'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pool_return" model="ir.actions.act_window">
        <field name="name">Retours clients</field>
        <field name="res_model">pool.return</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_a_traiter': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun retour à traiter</p>
            <p>Les clients demandent un retour depuis leur espace client, sur la page de leur commande.</p>
        </field>
    </record>

    <menuitem id="menu_pool_return" name="Retours clients" parent="sale.sale_order_menu"
              action="action_pool_return" sequence="40"/>

    <record id="view_pool_return_regle_list" model="ir.ui.view">
        <field name="name">pool.return.regle.list</field>
        <field name="model">pool.return.regle</field>
        <field name="arch" type="xml">
            <list string="Conditions de retour par fournisseur">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="delai_reprise"/>
                <field name="delai_reprise_max"/>
                <field name="frais_apres_pct"/>
                <field name="delai_dommage_heures"/>
                <field name="garantie_mois"/>
                <field name="email_rma_neuf" optional="show"/>
                <field name="email_rma_sav" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_pool_return_regle_form" model="ir.ui.view">
        <field name="name">pool.return.regle.form</field>
        <field name="model">pool.return.regle</field>
        <field name="arch" type="xml">
            <form string="Conditions de retour du fournisseur">
                <sheet>
                    <group>
                        <group string="Fournisseur">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Délais">
                            <field name="delai_reprise"/>
                            <field name="delai_reprise_max"/>
                            <field name="frais_apres_pct"/>
                            <field name="delai_dommage_heures"/>
                            <field name="garantie_mois"/>
                        </group>
                        <group string="Contacts RMA">
                            <field name="email_rma_neuf"/>
                            <field name="email_rma_sav"/>
                        </group>
                        <group string="Adresse de retour">
                            <field name="adresse_retour" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Rappels tirés des CGV du fournisseur…"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pool_return_regle" model="ir.actions.act_window">
        <field name="name">Conditions de retour fournisseurs</field>
        <field name="res_model">pool.return.regle</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_pool_return_regle" name="Conditions de retour fournisseurs" parent="sale.menu_sale_config"
              action="action_pool_return_regle" sequence="60"/>

    <record id="view_order_form_pool_return" model="ir.ui.view">
        <field name="name">sale.order.form.pool.return</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_voir_retours" type="object" class="oe_stat_button" icon="fa-undo"
                        invisible="pool_return_count == 0">
                    <field name="pool_return_count" widget="statinfo" string="Retours"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
