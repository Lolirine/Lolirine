<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_lolirine_invoice_audit_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.audit.wizard.form</field>
        <field name="model">lolirine.invoice.audit.wizard</field>
        <field name="arch" type="xml">
            <form string="Audit mensuel de la facturation">
                <header>
                    <button name="action_run_audit"
                            type="object"
                            string="Lancer l'audit"
                            class="btn-primary"/>
                    <button name="action_send_selected"
                            type="object"
                            string="Envoyer la sélection"
                            class="btn-success"
                            invisible="total_not_sent == 0"/>
                    <button name="action_select_all_not_sent"
                            type="object"
                            string="Sélectionner toutes les non-envoyées"
                            class="btn-secondary"
                            invisible="total_not_sent == 0"/>
                    <button name="action_unselect_all"
                            type="object"
                            string="Tout désélectionner"
                            class="btn-secondary"
                            invisible="not has_results"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Audit mensuel de la facturation</h1>
                        <p class="text-muted">
                            Vérifie que chaque abonnement actif a bien sa facture pour la date sélectionnée,
                            et permet de relancer l'envoi par email pour les non-envoyées.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="target_date"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Synthèse" invisible="not has_results">
                            <field name="total_subs"/>
                            <field name="total_ok"/>
                            <field name="total_not_sent"/>
                            <field name="total_missing"/>
                            <field name="total_draft"/>
                            <field name="total_legit_skip"/>
                            <field name="total_no_email"/>
                            <field name="total_cancelled"/>
                            <field name="total_amount" widget="float" digits="[12, 2]"/>
                        </group>
                    </group>
                    <field name="has_results" invisible="1"/>
                    <notebook invisible="not has_results">
                        <page string="Résultats" name="results">
                            <field name="audit_line_ids">
                                <list editable="bottom"
                                      create="false"
                                      delete="false"
                                      decoration-success="status == 'ok'"
                                      decoration-warning="status in ('not_sent', 'no_email', 'draft')"
                                      decoration-danger="status in ('missing', 'cancelled_only')"
                                      decoration-muted="status == 'legitimate_skip'">
                                    <field name="selected" widget="boolean_toggle"
                                           readonly="status != 'not_sent'"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'ok'"
                                           decoration-warning="status in ('not_sent', 'no_email', 'draft')"
                                           decoration-danger="status in ('missing', 'cancelled_only')"
                                           decoration-muted="status == 'legitimate_skip'"/>
                                    <field name="subscription_id" readonly="1"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="partner_email" readonly="1" optional="show"/>
                                    <field name="invoice_id" readonly="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="notes" readonly="1"/>
                                    <button name="action_open_subscription"
                                            type="object"
                                            icon="fa-external-link"
                                            title="Voir le contrat"/>
                                    <button name="action_open_invoice"
                                            type="object"
                                            icon="fa-file-text-o"
                                            title="Voir la facture"
                                            invisible="not invoice_id"/>
                                    <button name="action_send_one"
                                            type="object"
                                            icon="fa-envelope"
                                            title="Envoyer cette facture"
                                            invisible="status != 'not_sent'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button special="cancel" string="Fermer" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_lolirine_invoice_audit_wizard" model="ir.actions.act_window">
        <field name="name">Audit mensuel de facturation</field>
        <field name="res_model">lolirine.invoice.audit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ==================== MENU ==================== -->
    <menuitem id="menu_lolirine_invoice_audit_wizard"
              name="Audit mensuel facturation"
              parent="account.menu_finance_receivables"
              action="action_lolirine_invoice_audit_wizard"
              sequence="100"/>

</odoo>
