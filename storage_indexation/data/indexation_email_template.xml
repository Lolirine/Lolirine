<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- =====================================================================
             TEMPLATE EMAIL INDEXATION ANNUELLE
             Modifie le template existant 'email_template_indexation_notification'
             du module storage_indexation pour le personnaliser aux couleurs
             et coordonnées Lolirine.
             ===================================================================== -->
        <record id="storage_indexation.email_template_indexation_notification"
                model="mail.template">
            <field name="name">Indexation annuelle - Notification client</field>
            <field name="model_id" ref="storage_indexation.model_storage_indexation_line"/>
            <field name="subject">Indexation annuelle de votre loyer Box {{ object.product_id.default_code or '' }}</field>
            <field name="email_from">"Lolirine - Garde-meuble" &lt;gardemeublelolirine@gmail.com&gt;</field>
            <field name="reply_to">gardemeublelolirine@gmail.com</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="lang">{{ object.partner_id.lang or 'fr_BE' }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333333;">

    <!-- HEADER avec logo et bandeau rouge Lolirine -->
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse; background-color: #f4f4f4;">
        <tr>
            <td align="center" style="padding: 0;">
                <table border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff; border-collapse: collapse; max-width: 600px;">

                    <!-- Bandeau supérieur rouge Lolirine -->
                    <tr>
                        <td style="background-color: #C91E18; padding: 20px 30px; text-align: center;">
                            <h1 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: bold;">
                                LOLIRINE GARDE-MEUBLE
                            </h1>
                            <p style="color: #ffffff; margin: 5px 0 0 0; font-size: 13px; opacity: 0.9;">
                                Notification d'indexation annuelle
                            </p>
                        </td>
                    </tr>

                    <!-- Corps du message -->
                    <tr>
                        <td style="padding: 30px;">

                            <p style="margin: 0 0 15px 0;">
                                Bonjour <strong t-out="object.partner_id.name or ''">[Client]</strong>,
                            </p>

                            <p style="margin: 0 0 15px 0;">
                                Conformément à la clause d'indexation prévue dans votre contrat
                                de location de box, et en application de l'évolution de l'indice
                                santé belge publié par Statbel, nous vous informons de
                                l'indexation annuelle de votre loyer.
                            </p>

                            <!-- Tableau de détail -->
                            <table border="0" cellpadding="0" cellspacing="0" width="100%"
                                   style="border-collapse: collapse; margin: 20px 0; border: 1px solid #e0e0e0;">
                                <tr>
                                    <td colspan="2" style="background-color: #C91E18; color: #ffffff; padding: 12px 15px; font-size: 15px; font-weight: bold;">
                                        📋 Détail de l'indexation
                                    </td>
                                </tr>
                                <tr style="background-color: #f9f9f9;">
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0; width: 50%;">
                                        <strong>Box concerné</strong>
                                    </td>
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0;">
                                        <span t-out="object.product_id.name or ''">[Box]</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0;">
                                        <strong>Référence contrat</strong>
                                    </td>
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0;">
                                        <span t-out="object.subscription_id.name or ''">[Contrat]</span>
                                    </td>
                                </tr>
                                <tr style="background-color: #f9f9f9;">
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0;">
                                        Loyer actuel
                                    </td>
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0;">
                                        <span t-out="'%.2f' % object.old_price">0.00</span> € / mois
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0;">
                                        <strong style="color: #C91E18;">Nouveau loyer</strong>
                                    </td>
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0;">
                                        <strong style="color: #C91E18; font-size: 15px;">
                                            <span t-out="'%.2f' % object.new_price">0.00</span> € / mois
                                        </strong>
                                    </td>
                                </tr>
                                <tr style="background-color: #fff8f7;">
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0;">
                                        <strong>Augmentation mensuelle</strong>
                                    </td>
                                    <td style="padding: 10px 15px; border-bottom: 1px solid #e0e0e0;">
                                        <strong>+ <span t-out="'%.2f' % object.price_increase">0.00</span> €</strong>
                                        (+ <span t-out="'%.2f' % object.increase_percentage">0.00</span> %)
                                    </td>
                                </tr>
                            </table>

                            <!-- Indices utilisés -->
                            <table border="0" cellpadding="0" cellspacing="0" width="100%"
                                   style="border-collapse: collapse; margin: 0 0 20px 0; border: 1px solid #e0e0e0;">
                                <tr>
                                    <td colspan="2" style="background-color: #f4f4f4; padding: 10px 15px; font-size: 13px; font-weight: bold; color: #555;">
                                        📊 Indices de référence (base 2025=100)
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 8px 15px; font-size: 13px; color: #555; width: 50%;">
                                        Indice de base (signature contrat)
                                    </td>
                                    <td style="padding: 8px 15px; font-size: 13px; color: #555;">
                                        <span t-out="'%.2f' % object.base_index_value">0.00</span>
                                    </td>
                                </tr>
                                <tr style="background-color: #fafafa;">
                                    <td style="padding: 8px 15px; font-size: 13px; color: #555;">
                                        Nouvel indice (cible)
                                    </td>
                                    <td style="padding: 8px 15px; font-size: 13px; color: #555;">
                                        <span t-out="'%.2f' % object.new_index_value">0.00</span>
                                    </td>
                                </tr>
                            </table>

                            <!-- Bloc date d'application -->
                            <div style="background-color: #f9f9f9; border-left: 4px solid #C91E18; padding: 15px 20px; margin: 20px 0;">
                                <p style="margin: 0 0 5px 0; font-weight: bold; color: #C91E18;">
                                    📅 Date d'application
                                </p>
                                <p style="margin: 0;">
                                    Cette indexation prendra effet à compter du
                                    <strong>
                                        <span t-out="(object.indexation_id.application_date and object.indexation_id.application_date.strftime('%d/%m/%Y')) or '[date]'">[date]</span>
                                    </strong>.
                                    <br/>
                                    Aucune action n'est requise de votre part — le nouveau montant
                                    sera automatiquement appliqué sur votre prochaine facture
                                    suivant cette date.
                                </p>
                            </div>

                            <!-- Contact -->
                            <div style="background-color: #f4f4f4; padding: 15px 20px; margin: 20px 0; border-radius: 4px;">
                                <p style="margin: 0 0 8px 0; font-weight: bold;">
                                    ❓ Questions ?
                                </p>
                                <p style="margin: 0; font-size: 13px;">
                                    Pour toute question, n'hésitez pas à nous contacter :<br/>
                                    📧 <a href="mailto:gardemeublelolirine@gmail.com"
                                          style="color: #C91E18; text-decoration: none;">gardemeublelolirine@gmail.com</a><br/>
                                    📞 <a href="tel:+32497444146"
                                          style="color: #C91E18; text-decoration: none;">0497 / 444 146</a>
                                </p>
                            </div>

                            <p style="margin: 25px 0 5px 0;">
                                Nous vous remercions de votre confiance et restons à votre disposition.
                            </p>
                            <p style="margin: 0;">
                                Cordialement,<br/>
                                <strong>L'équipe Lolirine Garde-meuble</strong>
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f4f4f4; padding: 20px 30px; text-align: center; font-size: 11px; color: #888;">
                            <p style="margin: 0 0 5px 0;">
                                <strong>Lolirine SRL</strong> — BCE BE 0650.891.279<br/>
                                Garde-meuble situé à Boninne (Namur)
                            </p>
                            <p style="margin: 5px 0 0 0;">
                                gardemeublelolirine@gmail.com — 0497/444 146
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</div>
            </field>
        </record>

    </data>
</odoo>
