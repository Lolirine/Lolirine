<odoo>
  <record id="view_form_box_stockage" model="ir.ui.view">
    <field name="name">box.stockage.form</field>
    <field name="model">box.stockage</field>
    <field name="arch" type="xml">
      <form string="Box de Stockage">
        <group>
          <field name="name"/>
          <field name="largeur"/>
          <field name="profondeur"/>
          <field name="hauteur"/>
          <field name="volume" readonly="1"/>
          <field name="cout_mensuel"/>
          <field name="etat"/>
          <field name="x"/>
          <field name="y"/>
        </group>
      </form>
    </field>
  </record>

  <record id="view_tree_box_stockage" model="ir.ui.view">
    <field name="name">box.stockage.tree</field>
    <field name="model">box.stockage</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="etat"/>
        <field name="volume"/>
        <field name="cout_mensuel"/>
      </tree>
    </field>
  </record>

  <record id="action_box_stockage" model="ir.actions.act_window">
    <field name="name">Boxes</field>
    <field name="res_model">box.stockage</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_box_root" name="Garde-meubles"/>
  <menuitem id="menu_box_stockage" name="Boxes" parent="menu_box_root" action="action_box_stockage"/>
</odoo>