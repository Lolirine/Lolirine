<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Indexation Wizard Form View -->
    <record id="apartment_indexation_wizard_view_form" model="ir.ui.view">
        <field name="name">apartment.indexation.wizard.view.form</field>
        <field name="model">apartment.indexation.wizard</field>
        <field name="arch" type="xml">
            <form string="Indexation des loyers">
                <group>
                    <group string="Paramètres d'indexation">
                        <field name="all_eligible"/>
                        <field name="lease_ids" widget="many2many_tags" 
                               invisible="all_eligible"
                               options="{'no_create': True}"/>
                        <field name="index_date"/>
                    </group>
                    <group string="Indice">
                        <field name="index_type"/>
                        <field name="source"/>
                        <field name="new_index"/>
                    </group>
                </group>
                
                <group>
                    <field name="send_notifications"/>
                </group>
                
                <group string="Aperçu des indexations">
                    <field name="preview_line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="lease_id" readonly="1"/>
                            <field name="tenant_name" readonly="1"/>
                            <field name="property_name" readonly="1"/>
                            <field name="current_rent" readonly="1" widget="monetary"/>
                            <field name="base_index" readonly="1"/>
                            <field name="new_index" readonly="1"/>
                            <field name="new_rent" readonly="1" widget="monetary"/>
                            <field name="increase_amount" readonly="1" widget="monetary" 
                                   decoration-success="increase_amount > 0"
                                   decoration-danger="increase_amount &lt; 0"/>
                            <field name="increase_percentage" readonly="1" widget="percentage"/>
                        </list>
                    </field>
                </group>
                
                <div class="alert alert-info" role="alert">
                    <strong>Formule d'indexation belge:</strong>
                    <br/>
                    Nouveau loyer = (Loyer de base × Nouvel indice) / Indice de base
                    <br/><br/>
                    <strong>Où trouver l'indice santé:</strong>
                    <a href="https://statbel.fgov.be/fr/themes/prix-la-consommation/indice-sante" target="_blank">
                        StatBel - Indice santé
                    </a>
                </div>
                
                <footer>
                    <button name="action_apply" string="Appliquer l'indexation" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Indexation Wizard Action -->
    <record id="apartment_indexation_wizard_action" model="ir.actions.act_window">
        <field name="name">Indexation des loyers</field>
        <field name="res_model">apartment.indexation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Add wizard to menu -->
    <menuitem id="apartment_rental_menu_wizard_indexation"
              name="Indexation des loyers"
              parent="apartment_rental_menu_finance"
              action="apartment_indexation_wizard_action"
              sequence="50"/>

    <menuitem id="apartment_rental_menu_wizard_generate_rent"
              name="Générer les loyers"
              parent="apartment_rental_menu_finance"
              action="apartment_generate_rent_wizard_action"
              sequence="60"/>

</odoo>
