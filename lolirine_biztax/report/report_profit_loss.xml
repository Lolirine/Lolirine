<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- ================================================================== -->
    <!-- PROFIT & LOSS REPORT TEMPLATE                                     -->
    <!-- ================================================================== -->
    
    <template id="report_profit_loss">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="text-center mb-4">
                            <h2>COMPTE DE RÉSULTATS</h2>
                            <h4>
                                <span t-field="doc.company_id.name"/>
                            </h4>
                            <p class="text-muted">
                                Exercice du <span t-field="doc.fiscal_year_start"/> 
                                au <span t-field="doc.fiscal_year_end"/>
                                <br/>
                                Exercice d'imposition <span t-field="doc.assessment_year"/>
                            </p>
                        </div>
                        
                        <t t-set="data" t-value="report_data[doc_index]"/>
                        
                        <!-- Two column layout -->
                        <div class="row">
                            <!-- PRODUITS -->
                            <div class="col-6">
                                <h5 class="bg-success text-white p-2">PRODUITS</h5>
                                
                                <t t-foreach="data['revenues'].items()" t-as="section">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th colspan="2"><t t-esc="section[1]['name']"/></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="section[1]['items']" t-as="item">
                                                <tr>
                                                    <td>
                                                        <small class="text-muted"><t t-esc="item['code']"/></small>
                                                        <t t-esc="item['name']"/>
                                                    </td>
                                                    <td class="text-end" style="width: 120px;">
                                                        <t t-esc="'{:,.2f}'.format(item['amount']).replace(',', ' ')"/> €
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr class="table-light fw-bold">
                                                <td>Sous-total</td>
                                                <td class="text-end">
                                                    <t t-esc="'{:,.2f}'.format(sum(i['amount'] for i in section[1]['items'])).replace(',', ' ')"/> €
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                
                                <!-- Total Produits -->
                                <div class="bg-success text-white p-2 text-end fw-bold">
                                    TOTAL PRODUITS: <t t-esc="'{:,.2f}'.format(data['total_revenues']).replace(',', ' ')"/> €
                                </div>
                            </div>
                            
                            <!-- CHARGES -->
                            <div class="col-6">
                                <h5 class="bg-danger text-white p-2">CHARGES</h5>
                                
                                <t t-foreach="data['expenses'].items()" t-as="section">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th colspan="2"><t t-esc="section[1]['name']"/></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="section[1]['items']" t-as="item">
                                                <tr>
                                                    <td>
                                                        <small class="text-muted"><t t-esc="item['code']"/></small>
                                                        <t t-esc="item['name']"/>
                                                    </td>
                                                    <td class="text-end" style="width: 120px;">
                                                        <t t-esc="'{:,.2f}'.format(item['amount']).replace(',', ' ')"/> €
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr class="table-light fw-bold">
                                                <td>Sous-total</td>
                                                <td class="text-end">
                                                    <t t-esc="'{:,.2f}'.format(sum(i['amount'] for i in section[1]['items'])).replace(',', ' ')"/> €
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                
                                <!-- Total Charges -->
                                <div class="bg-danger text-white p-2 text-end fw-bold">
                                    TOTAL CHARGES: <t t-esc="'{:,.2f}'.format(data['total_expenses']).replace(',', ' ')"/> €
                                </div>
                            </div>
                        </div>
                        
                        <!-- Résultat -->
                        <div class="mt-4">
                            <div class="row">
                                <div class="col-12">
                                    <table class="table table-bordered">
                                        <tbody>
                                            <tr class="table-primary fw-bold fs-5">
                                                <td>RÉSULTAT DE L'EXERCICE</td>
                                                <td class="text-end" style="width: 150px;">
                                                    <t t-if="data['result'] >= 0">
                                                        <span class="text-success">
                                                            + <t t-esc="'{:,.2f}'.format(data['result']).replace(',', ' ')"/> €
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-danger">
                                                            <t t-esc="'{:,.2f}'.format(data['result']).replace(',', ' ')"/> €
                                                        </span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Rapprochement avec déclaration -->
                        <div class="mt-3 p-3 bg-light border">
                            <h6>Rapprochement avec la déclaration fiscale</h6>
                            <table class="table table-sm mb-0">
                                <tr>
                                    <td>Résultat comptable (compte de résultats)</td>
                                    <td class="text-end"><t t-esc="'{:,.2f}'.format(data['result']).replace(',', ' ')"/> €</td>
                                </tr>
                                <tr>
                                    <td>Résultat comptable (déclaration Biztax)</td>
                                    <td class="text-end"><span t-field="doc.accounting_result" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Écart</td>
                                    <td class="text-end">
                                        <t t-set="ecart" t-value="data['result'] - doc.accounting_result"/>
                                        <t t-if="abs(ecart) &lt; 0.01">
                                            <span class="text-success">✓ OK</span>
                                        </t>
                                        <t t-else="">
                                            <span class="text-danger">
                                                <t t-esc="'{:,.2f}'.format(ecart).replace(',', ' ')"/> €
                                            </span>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        
                        <!-- Footer -->
                        <div class="mt-4 pt-3 border-top">
                            <div class="row">
                                <div class="col-6">
                                    <small class="text-muted">
                                        Document généré depuis Odoo - Module Biztax<br/>
                                        Référence déclaration: <span t-field="doc.name"/>
                                    </small>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">
                                        BCE: <span t-field="doc.enterprise_number"/><br/>
                                        Généré le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
