<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Top-level menu -->
    <menuitem id="menu_ai_chat_root"
              name="Assistant IA"
              web_icon="lolirine_ai_chat,static/description/icon.png"
              sequence="90"/>

    <!-- Conversations submenu -->
    <menuitem id="menu_ai_chat_conversations"
              name="Conversations"
              parent="menu_ai_chat_root"
              action="action_ai_chat_conversation"
              sequence="10"/>

    <!-- Configuration submenu -->
    <menuitem id="menu_ai_chat_config"
              name="Configuration"
              parent="menu_ai_chat_root"
              sequence="90"/>

    <menuitem id="menu_ai_chat_settings"
              name="Paramètres"
              parent="menu_ai_chat_config"
              action="base.action_general_configuration"
              sequence="10"/>

</odoo>
