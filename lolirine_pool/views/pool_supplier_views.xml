<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue formulaire Fournisseur -->
    <record id="pool_supplier_view_form" model="ir.ui.view">
        <field name="name">pool.supplier.form</field>
        <field name="model">pool.supplier</field>
        <field name="arch" type="xml">
            <form string="Fournisseur Piscine">
                <header>
                    <button name="action_open_import_wizard" type="object" 
                            string="Importer des produits" class="btn-primary"
                            invisible="not active"/>
                    <button name="action_test_connection" type="object" 
                            string="Tester la connexion" 
                            invisible="import_method != 'api'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" 
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Produits"/>
                        </button>
                        <button name="%(lolirine_pool.action_pool_import_log)d" type="action"
                                class="oe_stat_button" icon="fa-history"
                                context="{'search_default_supplier_id': active_id}">
                            <field name="import_count" widget="statinfo" string="Imports"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du fournisseur"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="supplier_type"/>
                            <field name="partner_id" context="{'default_supplier_rank': 1}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="import_method"/>
                            <field name="website_url" widget="url"/>
                            <field name="catalog_url" widget="url"/>
                            <field name="last_import_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration Import" name="import_config">
                            <group string="Connexion API" invisible="import_method != 'api'">
                                <group>
                                    <field name="api_endpoint"/>
                                    <field name="api_key" password="True"/>
                                    <field name="api_secret" password="True"/>
                                </group>
                                <group>
                                    <field name="login"/>
                                    <field name="password" password="True"/>
                                </group>
                            </group>
                            <group string="Configuration des prix">
                                <group>
                                    <field name="price_field"/>
                                    <field name="margin_type"/>
                                </group>
                                <group>
                                    <field name="default_margin" invisible="margin_type == 'formula'"/>
                                    <field name="margin_formula" invisible="margin_type != 'formula'"/>
                                </group>
                            </group>
                            <group string="Catégorie par défaut">
                                <field name="default_category_id" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Mapping des champs" name="field_mapping">
                            <field name="field_mapping_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_field"/>
                                    <field name="target_field"/>
                                    <field name="transformation"/>
                                    <field name="custom_code" invisible="transformation != 'custom'"/>
                                    <field name="default_value"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes &amp; Instructions" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue liste Fournisseur -->
    <record id="pool_supplier_view_tree" model="ir.ui.view">
        <field name="name">pool.supplier.tree</field>
        <field name="model">pool.supplier</field>
        <field name="arch" type="xml">
            <tree string="Fournisseurs Piscine">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="supplier_type"/>
                <field name="import_method"/>
                <field name="product_count"/>
                <field name="last_import_date"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Vue kanban Fournisseur -->
    <record id="pool_supplier_view_kanban" model="ir.ui.view">
        <field name="name">pool.supplier.kanban</field>
        <field name="model">pool.supplier</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="supplier_type"/>
                <field name="product_count"/>
                <field name="last_import_date"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="name"/></strong>
                            <span class="badge text-bg-primary"><field name="code"/></span>
                        </div>
                        <div class="text-muted">
                            <field name="supplier_type"/>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <span><i class="fa fa-cubes"/> <field name="product_count"/> produits</span>
                            <span class="text-muted" t-if="record.last_import_date.raw_value">
                                <i class="fa fa-clock-o"/> <field name="last_import_date"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Recherche Fournisseur -->
    <record id="pool_supplier_view_search" model="ir.ui.view">
        <field name="name">pool.supplier.search</field>
        <field name="model">pool.supplier</field>
        <field name="arch" type="xml">
            <search string="Recherche Fournisseurs">
                <field name="name"/>
                <field name="code"/>
                <filter string="Actifs" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivés" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Fluidra" name="fluidra" domain="[('supplier_type', '=', 'fluidra')]"/>
                <filter string="SCP" name="scp" domain="[('supplier_type', '=', 'scp')]"/>
                <filter string="Allforpools" name="allforpools" domain="[('supplier_type', '=', 'allforpools')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Type" name="group_type" context="{'group_by': 'supplier_type'}"/>
                    <filter string="Méthode import" name="group_method" context="{'group_by': 'import_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Fournisseurs -->
    <record id="action_pool_supplier" model="ir.actions.act_window">
        <field name="name">Fournisseurs</field>
        <field name="res_model">pool.supplier</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="pool_supplier_view_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez vos fournisseurs de matériel piscine
            </p>
            <p>
                Ajoutez Fluidra, SCP Bénélux, Allforpools ou tout autre fournisseur
                avec leur configuration d'import spécifique.
            </p>
        </field>
    </record>

</odoo>
