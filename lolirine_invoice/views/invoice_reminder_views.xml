<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_invoice_reminder_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.form</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <form string="Relance">
                <header>
                    <button name="action_send_reminder" type="object" string="Envoyer par email" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_composer" type="object" string="Previsualiser" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Marquer payee" class="btn-success" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_create_next_reminder" type="object" string="Relance suivante" invisible="state != 'sent' or reminder_type == 'lawyer'"/>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon" invisible="state not in ('sent', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <span class="o_stat_text">Voir Facture</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Relance">
                            <field name="invoice_id"/>
                            <field name="partner_id"/>
                            <field name="reminder_type"/>
                            <field name="date"/>
                        </group>
                        <group string="Montants">
                            <field name="amount_due"/>
                            <field name="days_overdue"/>
                            <field name="penalty_amount"/>
                            <field name="total_due"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Envoi">
                            <field name="send_date" readonly="1"/>
                            <field name="email_sent"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" placeholder="Notes internes..."/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_invoice_reminder_list" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.list</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <list string="Relances" default_order="date desc">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="reminder_type"/>
                <field name="date"/>
                <field name="days_overdue"/>
                <field name="amount_due" sum="Total du"/>
                <field name="penalty_amount" sum="Total penalites"/>
                <field name="total_due" sum="Total"/>
                <field name="email_sent"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_invoice_reminders" model="ir.actions.act_window">
        <field name="name">Relances</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_invoice_reminders_to_send" model="ir.actions.act_window">
        <field name="name">Relances a envoyer</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
    </record>

    <record id="action_invoice_reminders_sent" model="ir.actions.act_window">
        <field name="name">Relances en attente</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent')]</field>
    </record>

    <record id="view_invoice_reminder_config_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.config.form</field>
        <field name="model">lolirine.invoice.reminder.config</field>
        <field name="arch" type="xml">
            <form string="Configuration relances">
                <sheet>
                    <group>
                        <group string="Delais de relance">
                            <field name="reminder_1_days"/>
                            <field name="reminder_2_days"/>
                            <field name="reminder_3_days"/>
                            <field name="formal_notice_days"/>
                        </group>
                        <group string="Penalites">
                            <field name="penalty_rate"/>
                            <field name="auto_reminder"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_invoice_reminder_config" model="ir.actions.act_window">
        <field name="name">Configuration relances</field>
        <field name="res_model">lolirine.invoice.reminder.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
