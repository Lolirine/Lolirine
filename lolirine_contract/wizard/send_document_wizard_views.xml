<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire du wizard -->
    <record id="view_send_document_wizard_form" model="ir.ui.view">
        <field name="name">send.document.wizard.form</field>
        <field name="model">send.document.wizard</field>
        <field name="arch" type="xml">
            <form string="Envoyer le document">
                <sheet>
                    <group>
                        <group string="Document">
                            <field name="sale_order_id" readonly="1"/>
                            <field name="document_type" readonly="1"/>
                            <field name="preview_url" invisible="1"/>
                        </group>
                        <group string="Aperçu">
                            <div class="text-center">
                                <button name="action_preview" type="object" 
                                        string="📄 Voir l'aperçu du document" 
                                        class="btn-primary btn-lg"
                                        icon="fa-file-pdf-o"/>
                            </div>
                        </group>
                    </group>
                    <separator string="Email"/>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="email_to" required="1"/>
                        </group>
                        <group>
                            <field name="email_subject" required="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="email_body" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send_and_close" type="object" string="Envoyer" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard (Contrat) -->
    <record id="action_send_contract_wizard" model="ir.actions.act_window">
        <field name="name">Envoyer le contrat</field>
        <field name="res_model">send.document.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_document_type': 'contract'}</field>
    </record>

    <!-- Action pour ouvrir le wizard (Devis) -->
    <record id="action_send_quotation_wizard" model="ir.actions.act_window">
        <field name="name">Envoyer le devis</field>
        <field name="res_model">send.document.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_document_type': 'quotation'}</field>
    </record>
</odoo>
