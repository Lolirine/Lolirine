<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List view ─────────────────────────────────── -->
    <record id="view_push_subscription_list" model="ir.ui.view">
        <field name="name">lolirine.push.subscription.list</field>
        <field name="model">lolirine.push.subscription</field>
        <field name="arch" type="xml">
            <list string="Abonnements Web Push" decoration-muted="not active">
                <field name="user_id"/>
                <field name="user_agent"/>
                <field name="last_seen"/>
                <field name="last_push"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="create_date" string="Enregistré le"/>
            </list>
        </field>
    </record>

    <!-- ── Form view ─────────────────────────────────── -->
    <record id="view_push_subscription_form" model="ir.ui.view">
        <field name="name">lolirine.push.subscription.form</field>
        <field name="model">lolirine.push.subscription</field>
        <field name="arch" type="xml">
            <form string="Abonnement Web Push">
                <sheet>
                    <group>
                        <group string="Utilisateur">
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Dates">
                            <field name="create_date" string="Enregistré le"/>
                            <field name="last_seen"/>
                            <field name="last_push"/>
                        </group>
                    </group>
                    <group string="Informations techniques">
                        <field name="user_agent" colspan="2"/>
                        <field name="endpoint" colspan="2"/>
                        <field name="p256dh" colspan="2"/>
                        <field name="auth" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────── -->
    <record id="action_push_subscription" model="ir.actions.act_window">
        <field name="name">Abonnements Web Push</field>
        <field name="res_model">lolirine.push.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- ── Menu ──────────────────────────────────────── -->
    <menuitem
        id="menu_lolirine_notify_root"
        name="Notifications Lolirine"
        parent="base.menu_administration"
        sequence="100"
        groups="base.group_system"
    />

    <menuitem
        id="menu_push_subscriptions"
        name="Abonnements Push"
        parent="base.menu_administration"
        action="action_push_subscription"
        sequence="101"
        groups="base.group_system"
    />

    <!-- Action test notification -->
    <record id="action_test_notification" model="ir.actions.server">
        <field name="name">Tester les notifications</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">
env['lolirine.notify.mixin']._lolirine_notify(
    event_type='default',
    title='Test Lolirine Notify',
    message='Les 3 canaux de notification fonctionnent correctement !',
    partner=env.user.partner_id,
    url='/odoo/settings',
    activity_summary='Test notification',
    activity_note='&lt;p&gt;Ceci est un test de notification Lolirine.&lt;/p&gt;',
    activity_deadline_days=0,
)
        </field>
    </record>

</odoo>
