<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Carte produit d'un défilé ══
         Variables : item, pu_dup (copie masquée pour la boucle continue) -->
    <template id="pool_universe_card" name="Lolirine — Carte de défilé">
        <li class="s_pu_item">
            <a class="s_pu_card"
               t-att-href="item['url']"
               t-att-tabindex="'-1' if pu_dup else None">
                <span class="s_pu_img">
                    <img t-att-src="item['image']" t-att-alt="item['name']"
                         loading="lazy" width="512" height="512"/>
                </span>
                <span class="s_pu_body">
                    <span t-if="item.get('tag')" class="s_pu_tag" t-out="item['tag']"/>
                    <span t-elif="item['brand']" class="s_pu_brand" t-out="item['brand']"/>
                    <span class="s_pu_name" t-out="item['name']"/>
                    <span class="s_pu_price">
                        <t t-if="item['from_price']">Dès </t>
                        <t t-out="item['price']"
                           t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    </span>
                </span>
            </a>
        </li>
    </template>

    <!-- ══ Bloc réutilisable : un défilé ══
         Variables : pu_data (dict de zone), pu_reverse (sens inversé) -->
    <template id="pool_universe_marquee" name="Lolirine — Défilé univers (bloc)">
        <section t-att-id="pu_data['anchor']"
                 t-attf-class="s_pool_universe o_not_editable #{'s_pu_reverse' if pu_reverse else ''}"
                 t-att-aria-label="pu_data['title']"
                 t-attf-style="--pu-duration: #{pu_data['duration']}s;">
            <div class="container s_pu_head">
                <div class="s_pu_intro">
                    <h2 class="s_pu_title" t-out="pu_data['title']"/>
                    <p t-if="pu_data['subtitle']" class="s_pu_subtitle" t-out="pu_data['subtitle']"/>
                </div>
                <nav class="s_pu_chips" aria-label="Gammes liées">
                    <t t-foreach="pu_data['chips']" t-as="chip">
                        <a class="s_pu_chip" t-att-href="chip['url']" t-out="chip['name']"/>
                    </t>
                </nav>
            </div>

            <div class="s_pu_viewport">
                <div class="s_pu_track">
                    <t t-foreach="[False, True]" t-as="pu_dup">
                        <ul class="s_pu_group" t-att-aria-hidden="'true' if pu_dup else None">
                            <t t-foreach="pu_data['items']" t-as="item">
                                <t t-call="lolirine_pool_universe.pool_universe_card"/>
                            </t>
                        </ul>
                    </t>
                </div>
            </div>
        </section>
    </template>

    <!-- ══ Fiche produit : un défilé selon l'univers du produit ══ -->
    <template id="product_universe_marquee"
              inherit_id="website_sale.product"
              name="Lolirine — Défilé univers produit">
        <xpath expr="//section[@id='product_detail']" position="after">
            <t t-set="pu_data" t-value="product._lolirine_universe_data(website)"/>
            <t t-if="pu_data">
                <t t-set="pu_reverse" t-value="False"/>
                <t t-call="lolirine_pool_universe.pool_universe_marquee"/>
            </t>
        </xpath>
    </template>

    <!-- ══ Page boutique : toutes les zones, uniquement sur /shop sans filtre ══ -->
    <template id="shop_universe_zones"
              inherit_id="website_sale.products"
              name="Lolirine — Zones univers (boutique)">
        <xpath expr="//div[@id='wrap']/*[1]" position="before">
            <t t-if="not category and not search">
                <t t-set="pu_zones" t-value="website._lolirine_shop_zones()"/>
                <div t-if="pu_zones" class="s_pu_zones">
                    <div class="container">
                        <nav class="s_pu_zonenav" aria-label="Univers de la boutique">
                            <t t-foreach="pu_zones" t-as="zone">
                                <a class="s_pu_zonelink" t-att-href="'#' + zone['anchor']" t-out="zone['name']"/>
                            </t>
                            <a class="s_pu_zonelink s_pu_zonelink_all" href="#products_grid">Tous les produits</a>
                        </nav>
                    </div>
                    <t t-foreach="pu_zones" t-as="pu_data">
                        <t t-set="pu_reverse" t-value="pu_data_index % 2 == 1"/>
                        <t t-call="lolirine_pool_universe.pool_universe_marquee"/>
                    </t>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
