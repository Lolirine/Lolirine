<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- ACTIONS SERVEUR pour conversion groupée     -->
    <!-- ============================================ -->

    <!-- Action : Convertir en Box de Stockage -->
    <record id="action_convert_to_storage_box" model="ir.actions.server">
        <field name="name">Convertir en Box de Stockage</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
records.write({'is_storage_box': True, 'storage_status': 'available'})
        </field>
    </record>

    <!-- Action : Retirer de Box de Stockage -->
    <record id="action_remove_from_storage_box" model="ir.actions.server">
        <field name="name">Retirer de Box de Stockage</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
records.write({'is_storage_box': False})
        </field>
    </record>

    <!-- Action : Marquer comme Disponible -->
    <record id="action_set_status_available" model="ir.actions.server">
        <field name="name">Box → Disponible</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
records.filtered('is_storage_box').write({'storage_status': 'available'})
        </field>
    </record>

    <!-- Action : Marquer comme Loué -->
    <record id="action_set_status_rented" model="ir.actions.server">
        <field name="name">Box → Loué</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
records.filtered('is_storage_box').write({'storage_status': 'rented'})
        </field>
    </record>

    <!-- Action : Marquer comme Réservé -->
    <record id="action_set_status_reserved" model="ir.actions.server">
        <field name="name">Box → Réservé</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
records.filtered('is_storage_box').write({'storage_status': 'reserved'})
        </field>
    </record>

    <!-- Action : Marquer en Maintenance -->
    <record id="action_set_status_maintenance" model="ir.actions.server">
        <field name="name">Box → En Maintenance</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
records.filtered('is_storage_box').write({'storage_status': 'maintenance'})
        </field>
    </record>

</odoo>
