<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Snippet : Barre de recherche piscine -->
    <template id="s_pool_search_bar" name="Barre recherche piscine">
        <section class="s_pool_search_bar py-4 bg-primary">
            <div class="container">
                <form action="/shop/pool/search" method="get" class="row g-2 justify-content-center">
                    <div class="col-md-6">
                        <div class="input-group input-group-lg">
                            <input type="text" name="search" class="form-control" 
                                   placeholder="Rechercher un produit piscine..."/>
                            <button type="submit" class="btn btn-light">
                                <i class="fa fa-search"/>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </section>
    </template>

    <!-- Snippet : Catégories en grille -->
    <template id="s_pool_categories_grid" name="Grille catégories piscine">
        <section class="s_pool_categories py-5">
            <div class="container">
                <h2 class="text-center mb-4">Nos univers</h2>
                <div class="row g-4">
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/shop?category=filtration" class="text-decoration-none">
                            <div class="card text-center p-4 h-100 pool-cat-card">
                                <i class="fa fa-filter fa-3x text-primary mb-3"/>
                                <h5>Filtration</h5>
                            </div>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/shop?category=pompes" class="text-decoration-none">
                            <div class="card text-center p-4 h-100 pool-cat-card">
                                <i class="fa fa-cogs fa-3x text-primary mb-3"/>
                                <h5>Pompes</h5>
                            </div>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/shop?category=robots" class="text-decoration-none">
                            <div class="card text-center p-4 h-100 pool-cat-card">
                                <i class="fa fa-android fa-3x text-primary mb-3"/>
                                <h5>Robots</h5>
                            </div>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/shop?category=traitement" class="text-decoration-none">
                            <div class="card text-center p-4 h-100 pool-cat-card">
                                <i class="fa fa-tint fa-3x text-primary mb-3"/>
                                <h5>Traitement</h5>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet : Bannière promo -->
    <template id="s_pool_promo_banner" name="Bannière promo piscine">
        <section class="s_pool_promo py-5 text-white" style="background: linear-gradient(135deg, #00B4D8 0%, #0077B6 100%);">
            <div class="container text-center">
                <h2 class="display-5 fw-bold">Préparez votre saison !</h2>
                <p class="lead">Profitez de nos offres sur le matériel de filtration et les robots nettoyeurs.</p>
                <a href="/shop" class="btn btn-light btn-lg">
                    <i class="fa fa-tag"/> Voir les promotions
                </a>
            </div>
        </section>
    </template>

    <!-- Snippet : Avantages -->
    <template id="s_pool_advantages" name="Avantages piscine">
        <section class="s_pool_advantages py-5 bg-light">
            <div class="container">
                <div class="row text-center g-4">
                    <div class="col-md-3">
                        <div class="p-3">
                            <i class="fa fa-truck fa-3x text-primary mb-3"/>
                            <h5>Livraison rapide</h5>
                            <p class="text-muted small">Expédition 24-48h</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3">
                            <i class="fa fa-undo fa-3x text-primary mb-3"/>
                            <h5>Retours gratuits</h5>
                            <p class="text-muted small">Sous 14 jours</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3">
                            <i class="fa fa-headphones fa-3x text-primary mb-3"/>
                            <h5>Conseil expert</h5>
                            <p class="text-muted small">Équipe à votre écoute</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3">
                            <i class="fa fa-shield fa-3x text-primary mb-3"/>
                            <h5>Paiement sécurisé</h5>
                            <p class="text-muted small">CB, Bancontact, virement</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet : Contact rapide -->
    <template id="s_pool_quick_contact" name="Contact rapide piscine">
        <section class="s_pool_contact py-4 bg-dark text-white">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h4 class="mb-0">Besoin d'un conseil ?</h4>
                        <p class="mb-0 text-muted">Notre équipe est disponible du lundi au vendredi de 9h à 18h.</p>
                    </div>
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        <a href="tel:+32XXXXXXXX" class="btn btn-outline-light me-2">
                            <i class="fa fa-phone"/> Appeler
                        </a>
                        <a href="/contactus" class="btn btn-primary">
                            <i class="fa fa-envelope"/> Contact
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet : Marques partenaires -->
    <template id="s_pool_brands" name="Marques partenaires piscine">
        <section class="s_pool_brands py-5">
            <div class="container">
                <h3 class="text-center text-muted mb-4">Nos marques partenaires</h3>
                <div class="row justify-content-center align-items-center g-4 text-center">
                    <div class="col-4 col-md-2">
                        <span class="badge bg-secondary p-3">AstralPool</span>
                    </div>
                    <div class="col-4 col-md-2">
                        <span class="badge bg-secondary p-3">Zodiac</span>
                    </div>
                    <div class="col-4 col-md-2">
                        <span class="badge bg-secondary p-3">Hayward</span>
                    </div>
                    <div class="col-4 col-md-2">
                        <span class="badge bg-secondary p-3">Pentair</span>
                    </div>
                    <div class="col-4 col-md-2">
                        <span class="badge bg-secondary p-3">Dolphin</span>
                    </div>
                    <div class="col-4 col-md-2">
                        <span class="badge bg-secondary p-3">Bayrol</span>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Enregistrement des snippets dans l'éditeur website -->
    <template id="pool_snippets" inherit_id="website.snippets" name="Snippets Piscine">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="lolirine_pool.s_pool_search_bar" t-thumbnail="/lolirine_pool/static/src/img/snippet_search.png"/>
            <t t-snippet="lolirine_pool.s_pool_categories_grid" t-thumbnail="/lolirine_pool/static/src/img/snippet_categories.png"/>
            <t t-snippet="lolirine_pool.s_pool_promo_banner" t-thumbnail="/lolirine_pool/static/src/img/snippet_promo.png"/>
            <t t-snippet="lolirine_pool.s_pool_advantages" t-thumbnail="/lolirine_pool/static/src/img/snippet_advantages.png"/>
            <t t-snippet="lolirine_pool.s_pool_quick_contact" t-thumbnail="/lolirine_pool/static/src/img/snippet_contact.png"/>
            <t t-snippet="lolirine_pool.s_pool_brands" t-thumbnail="/lolirine_pool/static/src/img/snippet_brands.png"/>
        </xpath>
    </template>

</odoo>
