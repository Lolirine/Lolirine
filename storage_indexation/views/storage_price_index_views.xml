<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste des indices -->
    <record id="view_storage_price_index_list" model="ir.ui.view">
        <field name="name">storage.price.index.list</field>
        <field name="model">storage.price.index</field>
        <field name="arch" type="xml">
            <list string="Indices de prix">
                <field name="name"/>
                <field name="index_type"/>
                <field name="date"/>
                <field name="value"/>
                <field name="base_year"/>
                <field name="source"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire des indices -->
    <record id="view_storage_price_index_form" model="ir.ui.view">
        <field name="name">storage.price.index.form</field>
        <field name="model">storage.price.index</field>
        <field name="arch" type="xml">
            <form string="Indice de prix">
                <header>
                    <button name="action_fetch_from_statbel" type="object" 
                            string="Récupérer depuis Statbel" 
                            class="btn-primary"
                            invisible="index_type != 'health'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Référence de l'indice"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="index_type"/>
                            <field name="date"/>
                            <field name="value"/>
                            <field name="base_year"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes ou commentaires..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue graphique -->
    <record id="view_storage_price_index_graph" model="ir.ui.view">
        <field name="name">storage.price.index.graph</field>
        <field name="model">storage.price.index</field>
        <field name="arch" type="xml">
            <graph string="Evolution des indices" type="line">
                <field name="date" type="row"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_storage_price_index" model="ir.actions.act_window">
        <field name="name">Indices de prix</field>
        <field name="res_model">storage.price.index</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creez votre premier indice de prix
            </p>
            <p>
                Les indices de prix sont utilises pour calculer l'indexation automatique des loyers.
                Vous pouvez recuperer automatiquement l'indice sante belge depuis Statbel.
            </p>
        </field>
    </record>
</odoo>
