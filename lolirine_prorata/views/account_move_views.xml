<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_prorata_button" model="ir.ui.view">
        <field name="name">account.move.form.prorata.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Bouton visible uniquement sur factures client en brouillon
                 liées à un contrat (invoice_origin rempli) -->
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="%(lolirine_prorata.action_prorata_wizard)d"
                        string="🗓️ Prorata"
                        type="action"
                        class="btn-secondary"
                        invisible="state != 'draft' or not invoice_origin or move_type != 'out_invoice'"
                        title="Calculer et appliquer un prorata sur les lignes de cette facture"/>
            </xpath>
        </field>
    </record>

</odoo>
