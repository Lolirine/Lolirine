<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension de la vue formulaire pour ajouter l'intégration Documents -->
    <record id="view_scan_tva_form_documents" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.form.documents</field>
        <field name="model">lolirine.scan.tva</field>
        <field name="inherit_id" ref="lolirine_scan_tva.view_scan_tva_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter le bouton statistique Archive dans le header -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_document" type="object"
                            class="oe_stat_button" icon="fa-archive"
                            invisible="not documents_document_id">
                        <span class="o_stat_text">Archive</span>
                    </button>
                </div>
            </xpath>
            
            <!-- Ajouter le champ documents_document_id et le bouton d'archivage -->
            <xpath expr="//field[@name='document_type']" position="after">
                <field name="documents_document_id" readonly="1" invisible="not documents_document_id"/>
                <button name="action_archive_to_documents" 
                        type="object" 
                        string="Archiver dans Documents"
                        class="btn-link"
                        icon="fa-archive"
                        invisible="documents_document_id or not document"/>
            </xpath>
        </field>
    </record>
    
    <!-- Extension de la vue liste pour montrer le statut d'archivage -->
    <record id="view_scan_tva_list_documents" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.list.documents</field>
        <field name="model">lolirine.scan.tva</field>
        <field name="inherit_id" ref="lolirine_scan_tva.view_scan_tva_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='responsible_id']" position="before">
                <field name="documents_document_id" string="Archive" widget="boolean_toggle" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
