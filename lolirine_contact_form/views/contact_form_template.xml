<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Page du formulaire de contact -->
    <template id="contact_form_page" name="Formulaire de contact Garde-Meubles">
        <t t-call="website.layout">
            <t t-set="additional_title">Demande de Réservation</t>
            
            <div id="wrap" class="oe_structure">
                
                <!-- Header -->
                <section class="pt-5 pb-5" style="background: linear-gradient(135deg, #C91E18 0%, #8b1510 100%);">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12 text-center text-white">
                                <h1 class="display-4 fw-bold">Demande de Réservation</h1>
                                <p class="lead">Remplissez ce formulaire et nous vous contacterons rapidement</p>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- Formulaire -->
                <section class="pt-5 pb-5 bg-light">
                    <div class="container">
                        <div class="row">
                            
                            <!-- Colonne formulaire -->
                            <div class="col-lg-8">
                                <div class="card shadow">
                                    <div class="card-header text-white" style="background-color: #C91E18;">
                                        <h3 class="mb-0"><i class="fa fa-user-plus me-2"/>Vos informations</h3>
                                    </div>
                                    <div class="card-body">
                                        <form action="/contact-garde-meubles/submit" method="POST" id="lolirine_contact_form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            
                                            <!-- ===== SECTION: Informations personnelles ===== -->
                                            <div class="form-section mb-4 p-3 bg-white rounded border-start border-4" style="border-color: #C91E18 !important;">
                                                <h5 class="mb-3" style="color: #C91E18;">
                                                    <i class="fa fa-user me-2"/>Informations personnelles
                                                </h5>
                                                
                                                <!-- Toggle entreprise -->
                                                <div class="mb-3">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" id="is_company" name="is_company" style="cursor: pointer;"/>
                                                        <label class="form-check-label fw-bold" for="is_company" style="cursor: pointer;">
                                                            Je représente une entreprise
                                                        </label>
                                                    </div>
                                                </div>
                                                
                                                <!-- Champs entreprise (cachés par défaut) -->
                                                <div id="company_fields" style="display: none;">
                                                    <div class="alert alert-info mb-3">
                                                        <i class="fa fa-building me-2"/>
                                                        <strong>Informations de l'entreprise</strong> - Tous les champs sont obligatoires
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label fw-bold">Nom commercial <span class="text-danger">*</span></label>
                                                            <input type="text" class="form-control" name="company_name" id="company_name" placeholder="Ex: Lolirine"/>
                                                            <small class="text-muted">Nom sous lequel l'entreprise est connue</small>
                                                        </div>
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label fw-bold">Dénomination sociale <span class="text-danger">*</span></label>
                                                            <input type="text" class="form-control" name="legal_name" id="legal_name" placeholder="Ex: Lolirine SRL"/>
                                                            <small class="text-muted">Forme juridique complète</small>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label fw-bold">Numéro de TVA <span class="text-danger">*</span></label>
                                                            <div class="input-group">
                                                                <span class="input-group-text">BE</span>
                                                                <input type="text" class="form-control" name="vat" id="vat_input" placeholder="0123.456.789"/>
                                                            </div>
                                                            <small class="text-muted">Format: 0123.456.789</small>
                                                        </div>
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label fw-bold">Personne de contact <span class="text-danger">*</span></label>
                                                            <input type="text" class="form-control" name="contact_person" id="contact_person" placeholder="Nom et prénom"/>
                                                        </div>
                                                    </div>
                                                    <hr/>
                                                </div>
                                                
                                                <!-- Nom et coordonnées -->
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label fw-bold" id="name_label">Nom complet <span class="text-danger">*</span></label>
                                                        <input type="text" class="form-control" name="name" id="name_input" required="" placeholder="Dupont Jean"/>
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                                                        <input type="email" class="form-control" name="email" required="" placeholder="jean.dupont@email.com"/>
                                                    </div>
                                                </div>
                                                
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Téléphone fixe</label>
                                                        <input type="tel" class="form-control" name="phone" placeholder="081/12 34 56"/>
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label fw-bold">GSM <span class="text-danger">*</span></label>
                                                        <input type="tel" class="form-control" name="mobile" required="" placeholder="0475/12 34 56"/>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <!-- ===== SECTION: Adresse ===== -->
                                            <div class="form-section mb-4 p-3 bg-white rounded border-start border-4" style="border-color: #C91E18 !important;">
                                                <h5 class="mb-3" style="color: #C91E18;">
                                                    <i class="fa fa-map-marker me-2"/>Votre adresse
                                                </h5>
                                                
                                                <!-- Recherche d'adresse Google -->
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Rechercher votre adresse</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text"><i class="fa fa-search"/></span>
                                                        <input type="text" class="form-control" id="address_autocomplete" placeholder="Commencez à taper votre adresse..."/>
                                                    </div>
                                                    <small class="text-muted">L'adresse sera complétée automatiquement</small>
                                                </div>
                                                
                                                <div class="row">
                                                    <div class="col-md-8 mb-3">
                                                        <label class="form-label fw-bold">Rue <span class="text-danger">*</span></label>
                                                        <input type="text" class="form-control" name="street" id="street" required="" placeholder="Rue de la Gare"/>
                                                    </div>
                                                    <div class="col-md-4 mb-3">
                                                        <label class="form-label fw-bold">Numéro <span class="text-danger">*</span></label>
                                                        <input type="text" class="form-control" name="street_number" id="street_number" required="" placeholder="123"/>
                                                    </div>
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <label class="form-label">Complément d'adresse</label>
                                                    <input type="text" class="form-control" name="street2" placeholder="Boîte, étage, bâtiment..."/>
                                                </div>
                                                
                                                <div class="row">
                                                    <div class="col-md-4 mb-3">
                                                        <label class="form-label fw-bold">Code postal <span class="text-danger">*</span></label>
                                                        <input type="text" class="form-control" name="zip" id="zip" required="" placeholder="5000"/>
                                                    </div>
                                                    <div class="col-md-5 mb-3">
                                                        <label class="form-label fw-bold">Ville <span class="text-danger">*</span></label>
                                                        <input type="text" class="form-control" name="city" id="city" required="" placeholder="Namur"/>
                                                    </div>
                                                    <div class="col-md-3 mb-3">
                                                        <label class="form-label">Pays</label>
                                                        <select class="form-select" name="country_id" id="country_id">
                                                            <t t-foreach="countries" t-as="country">
                                                                <option t-att-value="country.id" t-att-selected="country.id == default_country.id if default_country else False">
                                                                    <t t-esc="country.name"/>
                                                                </option>
                                                            </t>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <!-- ===== SECTION: Besoins stockage ===== -->
                                            <div class="form-section mb-4 p-3 bg-white rounded border-start border-4" style="border-color: #C91E18 !important;">
                                                <h5 class="mb-3" style="color: #C91E18;">
                                                    <i class="fa fa-archive me-2"/>Vos besoins en stockage
                                                </h5>
                                                
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label fw-bold">Taille du box souhaitée</label>
                                                        <select class="form-select" name="storage_type">
                                                            <option value="unknown">Je ne sais pas encore</option>
                                                            <option value="box_small">Petit box (&lt; 5 m²)</option>
                                                            <option value="box_medium">Box moyen (5-10 m²)</option>
                                                            <option value="box_large">Grand box (10-15 m²)</option>
                                                            <option value="box_xlarge">Très grand box (&gt; 15 m²)</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label fw-bold">Durée estimée</label>
                                                        <select class="form-select" name="storage_duration">
                                                            <option value="unknown">Je ne sais pas encore</option>
                                                            <option value="short">Court terme (&lt; 3 mois)</option>
                                                            <option value="medium">Moyen terme (3-12 mois)</option>
                                                            <option value="long">Long terme (&gt; 12 mois)</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Date de début souhaitée</label>
                                                    <input type="date" class="form-control" name="start_date" id="start_date"/>
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Que souhaitez-vous stocker ?</label>
                                                    <textarea class="form-control" name="storage_content" rows="3" placeholder="Meubles, cartons, électroménager, archives..."/>
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <label class="form-label">Demandes particulières</label>
                                                    <textarea class="form-control" name="special_requests" rows="2" placeholder="Accès spécifique, assurance, etc."/>
                                                </div>
                                            </div>
                                            
                                            <!-- ===== SECTION: Infos complémentaires ===== -->
                                            <div class="form-section mb-4 p-3 bg-white rounded border-start border-4" style="border-color: #C91E18 !important;">
                                                <h5 class="mb-3" style="color: #C91E18;">
                                                    <i class="fa fa-info-circle me-2"/>Informations complémentaires
                                                </h5>
                                                
                                                <div class="mb-3">
                                                    <label class="form-label">Comment nous avez-vous connu ?</label>
                                                    <select class="form-select" name="source">
                                                        <option value="">-- Sélectionnez --</option>
                                                        <option value="google">Recherche Google</option>
                                                        <option value="facebook">Facebook</option>
                                                        <option value="recommendation">Recommandation</option>
                                                        <option value="sign">Panneau publicitaire</option>
                                                        <option value="other">Autre</option>
                                                    </select>
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <label class="form-label">Message ou question</label>
                                                    <textarea class="form-control" name="message" rows="3" placeholder="Votre message..."/>
                                                </div>
                                            </div>
                                            
                                            <!-- Bouton soumettre -->
                                            <div class="d-grid gap-2">
                                                <button type="submit" class="btn btn-lg text-white" style="background-color: #C91E18;">
                                                    <i class="fa fa-paper-plane me-2"/>Envoyer ma demande
                                                </button>
                                            </div>
                                            
                                            <p class="text-muted text-center mt-3">
                                                <small>
                                                    <i class="fa fa-lock me-1"/>
                                                    Vos données sont protégées et ne seront utilisées que pour traiter votre demande.
                                                </small>
                                            </p>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Colonne informations -->
                            <div class="col-lg-4">
                                <!-- Carte contact -->
                                <div class="card shadow mb-4">
                                    <div class="card-header text-white" style="background-color: #C91E18;">
                                        <h5 class="mb-0"><i class="fa fa-building me-2"/>SRL Lolirine</h5>
                                    </div>
                                    <div class="card-body">
                                        <p><i class="fa fa-map-marker me-2" style="color: #C91E18;"/>5021 Boninne, Rue Bois D'Esneux 100</p>
                                        <p><i class="fa fa-phone me-2" style="color: #C91E18;"/><a href="tel:+32497444146">+32 497 44 41 46</a></p>
                                        <p><i class="fa fa-envelope me-2" style="color: #C91E18;"/><a href="mailto:gardemeublelolirine@gmail.com">gardemeublelolirine@gmail.com</a></p>
                                    </div>
                                </div>
                                
                                <!-- Horaires -->
                                <div class="card shadow mb-4">
                                    <div class="card-header text-white" style="background-color: #C91E18;">
                                        <h5 class="mb-0"><i class="fa fa-clock-o me-2"/>Horaires d'accès</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr><td>Lundi - Vendredi</td><td class="text-end fw-bold">9h - 18h</td></tr>
                                            <tr><td>Samedi</td><td class="text-end fw-bold">10h - 16h</td></tr>
                                            <tr><td>Dimanche et jours fériés</td><td class="text-end"><span class="badge bg-danger">Fermé</span></td></tr>
                                        </table>
                                    </div>
                                </div>
                                
                                <!-- Avantages -->
                                <div class="card shadow">
                                    <div class="card-header text-white" style="background-color: #27ae60;">
                                        <h5 class="mb-0"><i class="fa fa-check-circle me-2"/>Nos avantages</h5>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-2"><i class="fa fa-check text-success me-2"/>Site sécurisé 24h/24</li>
                                            <li class="mb-2"><i class="fa fa-check text-success me-2"/>Accès 7j/7</li>
                                            <li class="mb-2"><i class="fa fa-check text-success me-2"/>Contrats flexibles</li>
                                            <li class="mb-2"><i class="fa fa-check text-success me-2"/>Tarifs compétitifs</li>
                                            <li class="mb-2"><i class="fa fa-check text-success me-2"/>Box de 2m² à 25m²</li>
                                            <li><i class="fa fa-check text-success me-2"/>Personnel disponible</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </section>
                
            </div>
            
            <!-- Google Places API Script -->
            <t t-set="google_api_key" t-value="request.env['ir.config_parameter'].sudo().get_param('km_expense.distance_api_key', '')"/>
            <t t-if="google_api_key">
                <script t-attf-src="https://maps.googleapis.com/maps/api/js?key={{google_api_key}}&amp;libraries=places&amp;callback=initGoogleAutocomplete" async="" defer=""/>
            </t>
            
            <!-- JavaScript inline -->
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                    
                    // ===== Toggle champs entreprise =====
                    var isCompanyCheckbox = document.getElementById('is_company');
                    var companyFields = document.getElementById('company_fields');
                    var nameLabel = document.getElementById('name_label');
                    
                    if (isCompanyCheckbox) {
                        isCompanyCheckbox.addEventListener('change', function() {
                            if (this.checked) {
                                companyFields.style.display = 'block';
                                document.getElementById('company_name').required = true;
                                document.getElementById('legal_name').required = true;
                                document.getElementById('vat_input').required = true;
                                document.getElementById('contact_person').required = true;
                                if (nameLabel) nameLabel.innerHTML = 'Nom du responsable <span class="text-danger">*</span>';
                            } else {
                                companyFields.style.display = 'none';
                                document.getElementById('company_name').required = false;
                                document.getElementById('legal_name').required = false;
                                document.getElementById('vat_input').required = false;
                                document.getElementById('contact_person').required = false;
                                if (nameLabel) nameLabel.innerHTML = 'Nom complet <span class="text-danger">*</span>';
                            }
                        });
                    }
                    
                    // ===== Date minimum = aujourd'hui =====
                    var startDateInput = document.getElementById('start_date');
                    if (startDateInput) {
                        var today = new Date().toISOString().split('T')[0];
                        startDateInput.setAttribute('min', today);
                    }
                    
                    // ===== Validation formulaire =====
                    var form = document.getElementById('lolirine_contact_form');
                    if (form) {
                        form.addEventListener('submit', function(e) {
                            if (isCompanyCheckbox &amp;&amp; isCompanyCheckbox.checked) {
                                var fields = ['company_name', 'legal_name', 'vat_input', 'contact_person'];
                                var valid = true;
                                fields.forEach(function(id) {
                                    var field = document.getElementById(id);
                                    if (field &amp;&amp; !field.value.trim()) {
                                        field.classList.add('is-invalid');
                                        valid = false;
                                    } else if (field) {
                                        field.classList.remove('is-invalid');
                                    }
                                });
                                if (!valid) {
                                    e.preventDefault();
                                    alert('Veuillez remplir tous les champs obligatoires pour une entreprise.');
                                    return false;
                                }
                            }
                        });
                    }
                });
                
                // ===== Google Places Autocomplete =====
                function initGoogleAutocomplete() {
                    var input = document.getElementById('address_autocomplete');
                    if (!input || typeof google === 'undefined') return;
                    
                    var autocomplete = new google.maps.places.Autocomplete(input, {
                        types: ['address'],
                        componentRestrictions: { country: ['be', 'fr', 'lu', 'nl', 'de'] },
                        fields: ['address_components', 'formatted_address']
                    });
                    
                    autocomplete.addListener('place_changed', function() {
                        var place = autocomplete.getPlace();
                        if (!place.address_components) return;
                        
                        document.getElementById('street').value = '';
                        document.getElementById('street_number').value = '';
                        document.getElementById('zip').value = '';
                        document.getElementById('city').value = '';
                        
                        for (var i = 0; i &lt; place.address_components.length; i++) {
                            var component = place.address_components[i];
                            var type = component.types[0];
                            
                            if (type === 'street_number') {
                                document.getElementById('street_number').value = component.long_name;
                            } else if (type === 'route') {
                                document.getElementById('street').value = component.long_name;
                            } else if (type === 'postal_code') {
                                document.getElementById('zip').value = component.long_name;
                            } else if (type === 'locality' || type === 'sublocality' || type === 'postal_town') {
                                if (!document.getElementById('city').value) {
                                    document.getElementById('city').value = component.long_name;
                                }
                            }
                        }
                        input.value = '';
                    });
                }
            </script>
            
        </t>
    </template>
    
    <!-- Page de remerciement -->
    <template id="contact_form_thanks" name="Merci pour votre demande">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="pt-5 pb-5">
                    <div class="container text-center">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="card shadow">
                                    <div class="card-body p-5">
                                        <i class="fa fa-check-circle text-success" style="font-size: 80px;"/>
                                        <h1 class="mt-4 text-success">Merci pour votre demande !</h1>
                                        <p class="lead mt-4">
                                            Votre demande a bien été enregistrée. 
                                            Notre équipe vous contactera dans les plus brefs délais.
                                        </p>
                                        <hr class="my-4"/>
                                        <p>
                                            En attendant, n'hésitez pas à nous appeler au 
                                            <a href="tel:+32497444146"><strong>+32 497 44 41 46</strong></a>
                                            pour toute question urgente.
                                        </p>
                                        <div class="mt-4">
                                            <a href="/" class="btn btn-lg text-white" style="background-color: #C91E18;">
                                                <i class="fa fa-home me-2"/>Retour à l'accueil
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
    
    <!-- Page d'erreur -->
    <template id="contact_form_error" name="Erreur formulaire">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="pt-5 pb-5">
                    <div class="container text-center">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="card shadow border-danger">
                                    <div class="card-body p-5">
                                        <i class="fa fa-exclamation-triangle text-danger" style="font-size: 80px;"/>
                                        <h1 class="mt-4 text-danger">Oups ! Une erreur s'est produite</h1>
                                        <p class="lead mt-4">
                                            Nous n'avons pas pu enregistrer votre demande.
                                            Veuillez réessayer ou nous contacter directement.
                                        </p>
                                        <div class="mt-4">
                                            <a href="/contact-garde-meubles" class="btn btn-lg me-2 text-white" style="background-color: #C91E18;">
                                                <i class="fa fa-refresh me-2"/>Réessayer
                                            </a>
                                            <a href="tel:+32497444146" class="btn btn-outline-secondary btn-lg">
                                                <i class="fa fa-phone me-2"/>Appeler
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
    
</odoo>
