<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_id_card" model="ir.ui.view">
        <field name="name">res.partner.form.id.card</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Carte d'identite" name="id_card">
                    <div class="oe_button_box mb-3" name="button_box_id_card">
                        <button name="action_extract_id_card_info" type="object" 
                                class="oe_stat_button" icon="fa-magic"
                                invisible="not id_card_recto">
                            <span class="o_stat_text">Extraire infos</span>
                        </button>
                    </div>
                    <group>
                        <group string="Recto">
                            <field name="id_card_recto" widget="image" class="oe_avatar" options="{'size': [300, 200]}"/>
                            <field name="id_card_recto_filename" invisible="1"/>
                            <div class="d-flex gap-2 mt-2">
                                <field name="id_card_recto" filename="id_card_recto_filename" widget="binary" string="Modifier"/>
                                <button name="action_view_id_card_recto" type="object" 
                                        class="btn btn-secondary btn-sm" string="Voir en grand"
                                        icon="fa-search-plus" invisible="not id_card_recto"/>
                            </div>
                        </group>
                        <group string="Verso">
                            <field name="id_card_verso" widget="image" class="oe_avatar" options="{'size': [300, 200]}"/>
                            <field name="id_card_verso_filename" invisible="1"/>
                            <div class="d-flex gap-2 mt-2">
                                <field name="id_card_verso" filename="id_card_verso_filename" widget="binary" string="Modifier"/>
                                <button name="action_view_id_card_verso" type="object" 
                                        class="btn btn-secondary btn-sm" string="Voir en grand"
                                        icon="fa-search-plus" invisible="not id_card_verso"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <field name="id_card_uploaded" readonly="1" widget="boolean_toggle"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <h6><i class="fa fa-info-circle"></i> Extraction automatique</h6>
                        <p class="mb-0">
                            Cliquez sur "Extraire infos" pour analyser automatiquement la carte d'identite 
                            et remplir les champs du contact (nom, adresse, numero national, etc.).
                            <br/><strong>Note:</strong> Necessite une cle API Anthropic configuree dans les parametres systeme.
                        </p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
