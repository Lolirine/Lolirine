<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- ================================================================== -->
    <!-- FISCAL SUMMARY REPORT TEMPLATE                                    -->
    <!-- ================================================================== -->
    
    <template id="report_fiscal_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="text-center mb-4">
                            <h2>RÉSUMÉ DE LA DÉCLARATION FISCALE</h2>
                            <h3 class="text-primary">
                                <t t-if="doc.declaration_type == 'rcorp'">IMPÔT DES SOCIÉTÉS (ISOC)</t>
                                <t t-elif="doc.declaration_type == 'rle'">IMPÔT DES PERSONNES MORALES (IPM)</t>
                                <t t-else="">IMPÔT DES NON-RÉSIDENTS (INR)</t>
                            </h3>
                            <h4>
                                <span t-field="doc.company_id.name"/>
                            </h4>
                            <p class="text-muted">
                                Exercice d'imposition <span t-field="doc.assessment_year"/>
                            </p>
                        </div>
                        
                        <!-- Company Info -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div class="card">
                                    <div class="card-header bg-secondary text-white">
                                        <strong>Identification de l'entreprise</strong>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <td>Numéro BCE</td>
                                                <td class="fw-bold"><span t-field="doc.enterprise_number"/></td>
                                            </tr>
                                            <tr>
                                                <td>Forme juridique</td>
                                                <td><span t-field="doc.legal_form"/></td>
                                            </tr>
                                            <tr>
                                                <td>Numéro TVA</td>
                                                <td><span t-field="doc.vat_number"/></td>
                                            </tr>
                                            <tr>
                                                <td>PME</td>
                                                <td>
                                                    <t t-if="doc.is_sme">
                                                        <span class="badge bg-success">Oui</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-secondary">Non</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="card">
                                    <div class="card-header bg-secondary text-white">
                                        <strong>Période fiscale</strong>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <td>Début exercice</td>
                                                <td class="fw-bold"><span t-field="doc.fiscal_year_start"/></td>
                                            </tr>
                                            <tr>
                                                <td>Fin exercice</td>
                                                <td class="fw-bold"><span t-field="doc.fiscal_year_end"/></td>
                                            </tr>
                                            <tr>
                                                <td>Durée</td>
                                                <td><span t-field="doc.fiscal_year_months"/> mois</td>
                                            </tr>
                                            <tr>
                                                <td>Type déclaration</td>
                                                <td>
                                                    <t t-if="doc.declaration_status == 'initial'">
                                                        <span class="badge bg-primary">Initiale</span>
                                                    </t>
                                                    <t t-elif="doc.declaration_status == 'corrective'">
                                                        <span class="badge bg-warning">Corrective</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-info">Néant</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Calcul du résultat imposable -->
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white">
                                <strong>Calcul de la base imposable</strong>
                            </div>
                            <div class="card-body">
                                <table class="table table-bordered">
                                    <tbody>
                                        <tr>
                                            <td>Résultat comptable de l'exercice</td>
                                            <td class="text-end" style="width: 150px;">
                                                <span t-field="doc.accounting_result" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                            <td style="width: 80px;" class="text-muted text-center">9903</td>
                                        </tr>
                                        <tr class="table-warning">
                                            <td class="ps-4">+ Majorations (DNA, provisions, etc.)</td>
                                            <td class="text-end text-danger">
                                                + <span t-field="doc.total_increases" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                            <td class="text-muted text-center"></td>
                                        </tr>
                                        <tr class="table-success">
                                            <td class="ps-4">- Diminutions (RDT, exonérations, etc.)</td>
                                            <td class="text-end text-success">
                                                - <span t-field="doc.total_decreases" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                            <td class="text-muted text-center"></td>
                                        </tr>
                                        <tr class="table-primary fw-bold">
                                            <td>= Base imposable avant déduction pertes</td>
                                            <td class="text-end">
                                                <span t-field="doc.taxable_base" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                            <td class="text-muted text-center"></td>
                                        </tr>
                                        <tr t-if="doc.previous_losses > 0">
                                            <td class="ps-4">Pertes antérieures disponibles</td>
                                            <td class="text-end text-muted">
                                                (<span t-field="doc.previous_losses" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>)
                                            </td>
                                            <td class="text-muted text-center"></td>
                                        </tr>
                                        <tr t-if="doc.losses_used > 0" class="table-info">
                                            <td class="ps-4">- Pertes déduites (règle 70%)</td>
                                            <td class="text-end">
                                                - <span t-field="doc.losses_used" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                            <td class="text-muted text-center"></td>
                                        </tr>
                                        <tr class="table-dark fw-bold fs-5">
                                            <td>= BASE IMPOSABLE FINALE</td>
                                            <td class="text-end">
                                                <t t-set="final_base" t-value="max(0, doc.taxable_base - doc.losses_used)"/>
                                                <t t-esc="'{:,.2f}'.format(final_base).replace(',', ' ')"/> €
                                            </td>
                                            <td class="text-muted text-center"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Calcul de l'impôt -->
                        <div class="card mb-4">
                            <div class="card-header bg-danger text-white">
                                <strong>Calcul de l'impôt</strong>
                            </div>
                            <div class="card-body">
                                <table class="table table-bordered">
                                    <tbody>
                                        <tr t-if="doc.is_sme">
                                            <td>Taux réduit PME (20%) sur premiers 100.000 €</td>
                                            <td class="text-end" style="width: 150px;">
                                                <t t-set="sme_base" t-value="min(100000, max(0, doc.taxable_base - doc.losses_used))"/>
                                                <t t-esc="'{:,.2f}'.format(sme_base * 0.20).replace(',', ' ')"/> €
                                            </td>
                                        </tr>
                                        <tr t-if="doc.is_sme and (doc.taxable_base - doc.losses_used) > 100000">
                                            <td>Taux normal (25%) sur le surplus</td>
                                            <td class="text-end">
                                                <t t-set="surplus" t-value="max(0, doc.taxable_base - doc.losses_used - 100000)"/>
                                                <t t-esc="'{:,.2f}'.format(surplus * 0.25).replace(',', ' ')"/> €
                                            </td>
                                        </tr>
                                        <tr t-if="not doc.is_sme">
                                            <td>Taux normal (<span t-field="doc.tax_rate"/>%)</td>
                                            <td class="text-end">
                                                <span t-field="doc.tax_due" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr class="table-danger fw-bold">
                                            <td>= IMPÔT TOTAL DÛ</td>
                                            <td class="text-end">
                                                <span t-field="doc.tax_due" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="ps-4">- Versements anticipés</td>
                                            <td class="text-end text-success">
                                                - <span t-field="doc.prepayments" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="ps-4">- Précomptes imputables</td>
                                            <td class="text-end text-success">
                                                - <span t-field="doc.withholding_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr class="table-primary fw-bold fs-5">
                                            <td>= SOLDE À PAYER / À RÉCUPÉRER</td>
                                            <td class="text-end">
                                                <t t-if="doc.tax_balance >= 0">
                                                    <span class="text-danger">
                                                        <span t-field="doc.tax_balance" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-success">
                                                        <span t-field="doc.tax_balance" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                    </span>
                                                </t>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Détail des ajustements -->
                        <div class="card mb-4" t-if="doc.adjustment_ids">
                            <div class="card-header bg-warning">
                                <strong>Détail des ajustements fiscaux</strong>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th>Description</th>
                                            <th>Catégorie</th>
                                            <th>Type</th>
                                            <th class="text-end">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.adjustment_ids" t-as="adj">
                                            <tr>
                                                <td><t t-esc="adj.name"/></td>
                                                <td><small><t t-esc="adj.category"/></small></td>
                                                <td>
                                                    <t t-if="adj.adjustment_type == 'increase'">
                                                        <span class="badge bg-danger">+</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-success">-</span>
                                                    </t>
                                                </td>
                                                <td class="text-end">
                                                    <span t-field="adj.amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Annexes -->
                        <div class="card mb-4" t-if="doc.attachment_ids">
                            <div class="card-header bg-info text-white">
                                <strong>Annexes jointes</strong>
                            </div>
                            <div class="card-body">
                                <ul class="list-group">
                                    <t t-foreach="doc.attachment_ids" t-as="att">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>
                                                <i class="fa fa-file-pdf-o text-danger"/> 
                                                <t t-esc="att.name"/>
                                            </span>
                                            <span>
                                                <t t-if="att.is_mandatory">
                                                    <span class="badge bg-warning">Obligatoire</span>
                                                </t>
                                                <span class="badge bg-secondary"><t t-esc="att.file_size"/> Ko</span>
                                            </span>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                        
                        <!-- Signature -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <p>Fait à ________________________</p>
                                <p>Le ________________________</p>
                            </div>
                            <div class="col-6 text-center">
                                <p>Signature du représentant légal</p>
                                <br/><br/>
                                <p>________________________</p>
                                <p class="text-muted">
                                    <t t-if="doc.company_id.biztax_representative_id">
                                        <span t-field="doc.company_id.biztax_representative_id.name"/>
                                    </t>
                                </p>
                            </div>
                        </div>
                        
                        <!-- Footer -->
                        <div class="mt-4 pt-3 border-top">
                            <div class="row">
                                <div class="col-6">
                                    <small class="text-muted">
                                        Document généré depuis Odoo - Module Biztax<br/>
                                        Référence: <span t-field="doc.name"/>
                                        | Taxonomie: <span t-field="doc.taxonomy_version"/>
                                    </small>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">
                                        BCE: <span t-field="doc.enterprise_number"/><br/>
                                        Généré le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
