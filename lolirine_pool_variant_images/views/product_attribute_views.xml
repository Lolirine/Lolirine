<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Améliorer la vue liste des valeurs d'attribut                -->
    <!-- avec un aperçu visuel (image/couleur)                        -->
    <!-- ============================================================ -->
    
    <record id="product_attribute_value_view_list_images" model="ir.ui.view">
        <field name="name">product.attribute.value.list.images</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product.product_attribute_value_view_tree"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="visual_preview" string="Visuel" 
                       class="text-center" style="width: 60px;"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Améliorer le formulaire de valeur d'attribut                 -->
    <!-- pour faciliter l'upload d'images                             -->
    <!-- ============================================================ -->
    <record id="product_attribute_value_view_form_images" model="ir.ui.view">
        <field name="name">product.attribute.value.form.images</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product.product_attribute_value_view_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='html_color']" position="after">
                <field name="image" widget="image" 
                       options="{'size': [150, 150]}"
                       string="Image/Texture"
                       help="Uploadez une photo de la texture ou matière"/>
                <field name="visual_preview" string="Aperçu"/>
            </xpath>
        </field>
    </record>
</odoo>
