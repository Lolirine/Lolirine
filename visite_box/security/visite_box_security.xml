<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catégorie du module -->
    <record id="module_category_visite_box" model="ir.module.category">
        <field name="name">Visites &amp; Parcours Client</field>
        <field name="description">Gestion des visites et du parcours client pré-contrat</field>
        <field name="sequence">50</field>
    </record>

    <!-- Groupes d'utilisateurs -->
    <record id="group_visite_user" model="res.groups">
        <field name="name">Utilisateur Visites</field>
        <field name="category_id" ref="module_category_visite_box"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_visite_manager" model="res.groups">
        <field name="name">Responsable Visites</field>
        <field name="category_id" ref="module_category_visite_box"/>
        <field name="implied_ids" eval="[(4, ref('group_visite_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Règles d'enregistrement -->
    <record id="visite_box_rule_user" model="ir.rule">
        <field name="name">Visites: utilisateur voit ses visites</field>
        <field name="model_id" ref="model_visite_box"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_visite_user'))]"/>
    </record>

    <record id="visite_box_rule_manager" model="ir.rule">
        <field name="name">Visites: responsable voit tout</field>
        <field name="model_id" ref="model_visite_box"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visite_manager'))]"/>
    </record>

    <record id="storage_box_rule_all" model="ir.rule">
        <field name="name">Box: tous les utilisateurs</field>
        <field name="model_id" ref="model_storage_box"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visite_user'))]"/>
    </record>
</odoo>
