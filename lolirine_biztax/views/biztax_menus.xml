<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- ROOT MENU - APPLICATION BIZTAX                                    -->
    <!-- ================================================================== -->
    
    <menuitem id="menu_biztax_root"
              name="Biztax"
              web_icon="lolirine_biztax,static/description/icon.png"
              groups="lolirine_biztax.group_biztax_user"
              sequence="85"/>

    <!-- ================================================================== -->
    <!-- DECLARATIONS MENU                                                 -->
    <!-- ================================================================== -->
    
    <menuitem id="menu_biztax_declarations"
              name="Déclarations"
              parent="menu_biztax_root"
              groups="lolirine_biztax.group_biztax_user"
              sequence="10"/>

    <menuitem id="menu_biztax_declaration_wizard"
              name="Nouvelle déclaration"
              parent="menu_biztax_declarations"
              action="action_biztax_declaration_wizard"
              groups="lolirine_biztax.group_biztax_user"
              sequence="1"/>

    <menuitem id="menu_biztax_declaration_list"
              name="Toutes les déclarations"
              parent="menu_biztax_declarations"
              action="action_biztax_declaration"
              groups="lolirine_biztax.group_biztax_user"
              sequence="10"/>

    <menuitem id="menu_biztax_adjustment_list"
              name="Ajustements fiscaux"
              parent="menu_biztax_declarations"
              action="action_biztax_adjustment"
              groups="lolirine_biztax.group_biztax_user"
              sequence="20"/>
              
    <menuitem id="menu_biztax_attachment_list"
              name="Annexes"
              parent="menu_biztax_declarations"
              action="action_biztax_attachment"
              groups="lolirine_biztax.group_biztax_user"
              sequence="30"/>

    <!-- ================================================================== -->
    <!-- REPORTING MENU                                                    -->
    <!-- ================================================================== -->
    
    <menuitem id="menu_biztax_reporting"
              name="Rapports"
              parent="menu_biztax_root"
              groups="lolirine_biztax.group_biztax_user"
              sequence="20"/>
    
    <!-- Note: Les rapports sont accessibles via le menu Imprimer de chaque déclaration -->
    <!-- Ces actions permettent d'y accéder directement -->
    
    <record id="action_print_balance_sheet" model="ir.actions.server">
        <field name="name">Imprimer Bilan</field>
        <field name="model_id" ref="model_biztax_declaration"/>
        <field name="binding_model_id" ref="model_biztax_declaration"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_generate_balance_sheet()
        </field>
    </record>
    
    <record id="action_print_profit_loss" model="ir.actions.server">
        <field name="name">Imprimer Compte de résultats</field>
        <field name="model_id" ref="model_biztax_declaration"/>
        <field name="binding_model_id" ref="model_biztax_declaration"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_generate_profit_loss()
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- CONFIGURATION MENU                                                -->
    <!-- ================================================================== -->
    
    <!-- ACTION: OPEN SETTINGS - Must be defined before menuitem -->
    <record id="action_biztax_config_settings" model="ir.actions.act_window">
        <field name="name">Paramètres Biztax</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'lolirine_biztax', 'bin_size': False}</field>
    </record>
    
    <menuitem id="menu_biztax_config"
              name="Configuration"
              parent="menu_biztax_root"
              groups="lolirine_biztax.group_biztax_manager"
              sequence="90"/>

    <!-- Settings shortcut -->
    <menuitem id="menu_biztax_settings"
              name="Paramètres"
              parent="menu_biztax_config"
              action="action_biztax_config_settings"
              groups="lolirine_biztax.group_biztax_manager"
              sequence="0"/>

    <!-- Reference Data -->
    <menuitem id="menu_biztax_config_data"
              name="Données de référence"
              parent="menu_biztax_config"
              groups="lolirine_biztax.group_biztax_manager"
              sequence="10"/>
              
    <menuitem id="menu_biztax_declaration_types"
              name="Types de déclaration"
              parent="menu_biztax_config_data"
              action="action_biztax_declaration_type"
              groups="lolirine_biztax.group_biztax_manager"
              sequence="10"/>

    <menuitem id="menu_biztax_tax_codes"
              name="Codes fiscaux XBRL"
              parent="menu_biztax_config_data"
              action="action_biztax_tax_code"
              groups="lolirine_biztax.group_biztax_manager"
              sequence="20"/>
              
    <menuitem id="menu_biztax_annexe_types"
              name="Types d'annexes"
              parent="menu_biztax_config_data"
              action="action_biztax_annexe_type"
              groups="lolirine_biztax.group_biztax_manager"
              sequence="30"/>
    
</odoo>
