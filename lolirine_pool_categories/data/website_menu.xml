<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Menu principal: Boutique -->
        <record id="menu_boutique" model="website.menu">
            <field name="name">Boutique</field>
            <field name="url">/boutique</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
        </record>

        <!-- Sous-menu: Traitement de l'eau -->
        <record id="menu_traitement_eau" model="website.menu">
            <field name="name">Traitement de l'eau</field>
            <field name="url">/boutique/traitement-eau</field>
            <field name="parent_id" ref="lolirine_pool_categories.menu_boutique"/>
            <field name="sequence">10</field>
        </record>

        <!-- Sous-menu: Nettoyage & Robots -->
        <record id="menu_nettoyage" model="website.menu">
            <field name="name">Nettoyage &amp; Robots</field>
            <field name="url">/boutique/nettoyage-robots</field>
            <field name="parent_id" ref="lolirine_pool_categories.menu_boutique"/>
            <field name="sequence">20</field>
        </record>

        <!-- Sous-menu: Espace Wellness -->
        <record id="menu_wellness" model="website.menu">
            <field name="name">Espace Wellness</field>
            <field name="url">/boutique/wellness</field>
            <field name="parent_id" ref="lolirine_pool_categories.menu_boutique"/>
            <field name="sequence">30</field>
        </record>

        <!-- Sous-menu: Équipements & Pièces -->
        <record id="menu_equipements" model="website.menu">
            <field name="name">Équipements &amp; Pièces</field>
            <field name="url">/boutique/equipements</field>
            <field name="parent_id" ref="lolirine_pool_categories.menu_boutique"/>
            <field name="sequence">40</field>
        </record>

        <!-- Sous-menu: Tous les produits -->
        <record id="menu_tous_produits" model="website.menu">
            <field name="name">Tous les produits</field>
            <field name="url">/shop</field>
            <field name="parent_id" ref="lolirine_pool_categories.menu_boutique"/>
            <field name="sequence">50</field>
        </record>

    </data>
</odoo>
