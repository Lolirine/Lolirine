<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="promotions_page_template" name="Promotions Pool Store">
        <div id="wrap">
            <div class="container py-5">
                <div class="text-center mb-5">
                    <h1 class="display-4 fw-bold" style="color: #1a3a5c;">Nos Promotions</h1>
                    <p class="lead text-muted">Profitez de nos offres spéciales sur une sélection de produits piscine et spa</p>
                </div>
                <t t-if="not promotions">
                    <div class="text-center py-5">
                        <p class="text-muted fs-5">Aucune promotion en cours pour le moment. Revenez bientôt !</p>
                        <a href="/shop" class="btn btn-primary mt-3">Voir notre catalogue</a>
                    </div>
                </t>
                <t t-foreach="promotions" t-as="promo">
                    <div class="mb-5">
                        <div class="rounded-3 p-4 p-lg-5 text-white position-relative overflow-hidden" t-attf-style="background: linear-gradient(135deg, #{promo.banner_color or '#0369a1'} 0%, #1a3a5c 100%); min-height: 120px;">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div>
                                    <h2 class="fw-bold mb-1" t-esc="promo.name" />
                                    <p class="mb-2 opacity-75" t-if="promo.subtitle" t-esc="promo.subtitle" />
                                    <span t-if="promo.discount_text" class="badge bg-warning text-dark fs-5 px-3 py-2" t-esc="promo.discount_text" />
                                </div>
                                <div>
                                    <a t-att-href="promo.button_url or &quot;/shop&quot;" class="btn btn-light btn-lg fw-semibold px-4 rounded-pill">
                                        <span t-esc="promo.button_text or 'En profiter'" />
                                        <span> →</span>
                                    </a>
                                </div>
                            </div>
                            <div class="mt-3 small opacity-75">
                                <span>Valable du </span>
                                <span t-field="promo.date_start" />
                                <span> au </span>
                                <span t-field="promo.date_end" />
                            </div>
                        </div>
                        <t t-if="promo.description">
                            <div class="mt-3 px-3">
                                <div t-out="promo.description" />
                            </div>
                        </t>
                        <t t-if="promo.product_ids">
                            <h4 class="mt-4 mb-3 px-1" style="color: #1a3a5c;">Produits concernés</h4>
                            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                                <t t-foreach="promo.product_ids" t-as="product">
                                    <div class="col">
                                        <div class="card h-100 border-0 shadow-sm">
                                            <a t-attf-href="/shop/product/#{slug(product)}">
                                                <img class="card-img-top p-2" t-attf-src="/web/image/product.template/#{product.id}/image_256" t-att-alt="product.name" style="height: 200px; object-fit: contain;" loading="lazy" />
                                            </a>
                                            <div class="card-body text-center p-2">
                                                <h6 class="card-title mb-1 small">
                                                    <a t-attf-href="/shop/product/#{slug(product)}" class="text-decoration-none text-dark" t-esc="product.name" />
                                                </h6>
                                                <p class="fw-bold mb-0" style="color: #0369a1;">
                                                    <span t-esc="str('%.2f' % product.list_price).replace('.', ',') + ' €'" />
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                    <hr class="my-4" t-if="not promo_last" />
                </t>
            </div>
        </div>
    </template>
</odoo>