<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire : un onglet dédié -->
    <record id="product_template_form_view_scp" model="ir.ui.view">
        <field name="name">product.template.form.tarification.scp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Tarification SCP" name="tarification_scp">
                    <group>
                        <group string="Données du catalogue">
                            <field name="x_lettre_scp"/>
                            <field name="x_prix_catalogue"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="x_remise_scp" readonly="1"/>
                            <field name="x_coef_vente"/>
                        </group>
                        <group string="Calcul">
                            <field name="x_cout_calcule"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="x_pv_calcule"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="x_marge_eur"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="x_marge_pct" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Confrontation aux valeurs enregistrées">
                            <field name="x_ecart_prix"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="x_marge_reelle_pct" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_appliquer_tarif_scp"
                                    string="Appliquer au coût et au prix"
                                    type="object"
                                    class="btn-primary"
                                    invisible="not x_lettre_scp or not x_prix_catalogue"/>
                            <button name="action_deduire_prix_catalogue"
                                    string="Déduire le prix catalogue du prix de vente"
                                    type="object"
                                    class="btn-secondary"
                                    invisible="x_prix_catalogue"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        <p>
                            Le coût est le prix catalogue diminué de la remise de la lettre.
                            Le prix de vente est le prix catalogue multiplié par le
                            coefficient de vente, 0,95 par défaut.
                        </p>
                        <p>
                            Pour une promotion, descendre le coefficient de vente :
                            0,85 revient à vendre 15 % sous le tarif catalogue.
                            La marge calculée indique aussitôt si l'opération reste tenable.
                        </p>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Liste : colonnes optionnelles -->
    <record id="product_template_tree_view_scp" model="ir.ui.view">
        <field name="name">product.template.list.tarification.scp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="x_lettre_scp" optional="hide"/>
                <field name="x_prix_catalogue" optional="hide"/>
                <field name="x_cout_calcule" optional="hide"/>
                <field name="x_marge_pct" optional="hide"/>
                <field name="x_marge_reelle_pct" optional="hide"/>
                <field name="x_ecart_prix" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Action de masse depuis la liste -->
    <record id="action_appliquer_tarif_scp" model="ir.actions.server">
        <field name="name">Appliquer la tarification SCP</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_appliquer_tarif_scp()</field>
    </record>

</odoo>
