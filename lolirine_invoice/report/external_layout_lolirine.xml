<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template de layout externe Lolirine - Version corrigée pour portail -->
    <template id="external_layout_lolirine">
        <!-- HEADER -->
        <div t-attf-class="header o_company_#{company.id}_layout" style="border-bottom: 3px solid #c0392b; padding-bottom: 10px; margin-bottom: 20px;">
            <table style="width: 100%; border-collapse: collapse;">
                <tr>
                    <td style="width: 50%; vertical-align: top;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px; max-width: 200px;" alt="Logo"/>
                        <div t-if="company.report_header" t-field="company.report_header" style="color: #c0392b; font-style: italic; font-size: 11px; margin-top: 5px;"/>
                    </td>
                    <td style="width: 50%; vertical-align: top; text-align: right;">
                        <div style="font-size: 11px; line-height: 1.4;">
                            <strong t-field="company.name">Company Name</strong><br/>
                            <span t-field="company.street">Street</span><br/>
                            <t t-if="company.street2"><span t-field="company.street2"/><br/></t>
                            <span t-field="company.zip"/> <span t-field="company.city"/><br/>
                            <span t-field="company.country_id.name">Country</span><br/>
                            <t t-if="company.phone">Tel: <span t-field="company.phone"/><br/></t>
                            <t t-if="company.email">Email: <span t-field="company.email"/><br/></t>
                            <t t-if="company.vat">TVA: <span t-field="company.vat"/></t>
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <!-- BODY -->
        <div t-attf-class="article o_report_layout_lolirine o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>

        <!-- FOOTER -->
        <div t-attf-class="footer o_company_#{company.id}_layout" style="border-top: 2px solid #c0392b; padding-top: 8px; font-size: 9px; text-align: center;">
            <div t-if="company.report_footer" t-field="company.report_footer" style="margin-bottom: 5px;"/>
            <div style="color: #666;">
                <t t-if="company.email">Email: <span t-field="company.email"/> | </t>
                <t t-if="company.website">Site: <span t-field="company.website"/> | </t>
                <t t-if="company.vat">TVA: <span t-field="company.vat"/> | </t>
                <t t-if="company.company_registry">BCE: <span t-field="company.company_registry"/></t>
            </div>
            <div style="color: #666;" t-if="report_type == 'pdf'">
                Page <span class="page"/> / <span class="topage"/>
            </div>
        </div>
    </template>

    <!-- Créer l'enregistrement du layout pour qu'il apparaisse dans la liste de sélection -->
    <record id="report_layout_lolirine" model="report.layout">
        <field name="name">Lolirine</field>
        <field name="sequence">100</field>
        <field name="view_id" ref="external_layout_lolirine"/>
        <field name="image">/lolirine_invoice/static/description/layout_lolirine.png</field>
    </record>
</odoo>
