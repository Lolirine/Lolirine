<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- SNIPPET PRINCIPAL : Boutons Box de Stockage -->
    <!-- Remplace "Ajouter au panier"                -->
    <!-- ============================================ -->
    
    <template id="s_storage_box_buttons" name="Storage Box Buttons">
        <section class="s_storage_box_buttons pt-3 pb-3">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <t t-if="product and product.is_storage_box">
                            
                            <!-- Badge de statut -->
                            <t t-set="show_badge" t-value="request.env['ir.config_parameter'].sudo().get_param('lolirine_storage.show_status_badge', 'False') == 'True'"/>
                            <div t-if="show_badge" class="storage-status-badge mb-3 text-center">
                                <span t-if="product.storage_status == 'available'" 
                                      class="badge text-bg-success fs-5 px-4 py-2">
                                    <i class="fa fa-check-circle me-2"/> Disponible
                                </span>
                                <span t-elif="product.storage_status == 'rented'" 
                                      class="badge text-bg-danger fs-5 px-4 py-2">
                                    <i class="fa fa-lock me-2"/> Loué
                                </span>
                                <span t-elif="product.storage_status == 'reserved'" 
                                      class="badge text-bg-warning fs-5 px-4 py-2">
                                    <i class="fa fa-clock-o me-2"/> Réservé
                                </span>
                                <span t-elif="product.storage_status == 'maintenance'" 
                                      class="badge text-bg-secondary fs-5 px-4 py-2">
                                    <i class="fa fa-wrench me-2"/> En maintenance
                                </span>
                            </div>
                            
                            <!-- BOUTON 1: Rendez-vous (Box DISPONIBLE) -->
                            <t t-if="product.show_appointment_button">
                                <div class="storage-appointment-button text-center mb-3">
                                    <a t-att-href="product.appointment_url" 
                                       class="btn btn-primary btn-lg px-5 py-3 w-100">
                                        <i class="fa fa-calendar me-2"/>
                                        <t t-esc="product.appointment_button_label"/>
                                    </a>
                                    <p class="text-muted small mt-2">
                                        <i class="fa fa-info-circle me-1"/>
                                        Prenez rendez-vous pour visiter ce box de stockage
                                    </p>
                                </div>
                            </t>
                            
                            <!-- BOUTON 2: Demande générale (Box NON DISPONIBLE) -->
                            <t t-if="product.show_general_inquiry_button">
                                <div class="storage-general-inquiry-button text-center mb-3">
                                    <a t-att-href="product.general_inquiry_url" 
                                       class="btn btn-secondary btn-lg px-5 py-3 w-100">
                                        <i class="fa fa-envelope me-2"/>
                                        <t t-esc="product.general_inquiry_button_label"/>
                                    </a>
                                    <p class="text-muted small mt-2">
                                        <i class="fa fa-info-circle me-1"/>
                                        Ce box n'est pas disponible actuellement. 
                                        Contactez-nous pour plus d'informations.
                                    </p>
                                </div>
                            </t>
                            
                        </t>
                        
                        <!-- Message si pas un box de stockage (visible uniquement en mode édition) -->
                        <div t-if="not product or not product.is_storage_box" 
                             class="alert alert-info text-center o_not_editable" 
                             contenteditable="false">
                            <i class="fa fa-info-circle me-2"/>
                            <strong>Snippet Box de Stockage</strong><br/>
                            Ce snippet remplace le bouton "Ajouter au panier" par :<br/>
                            • <strong>Bouton RDV</strong> si le box est disponible<br/>
                            • <strong>Bouton Demande générale</strong> si le box n'est pas disponible
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Enregistrement du snippet principal -->
    <template id="snippets_main" inherit_id="website.snippets" name="Storage Box Main Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="lolirine_storage_availability.s_storage_box_buttons"
               t-thumbnail="/lolirine_storage_availability/static/description/icon.png"
               string="Boutons Box Stockage"/>
        </xpath>
    </template>

    <!-- ============================================ -->
    <!-- SNIPPET : Badge seul                        -->
    <!-- ============================================ -->
    
    <template id="s_storage_badge_only" name="Storage Badge Only">
        <section class="s_storage_badge_only py-2">
            <div class="container">
                <t t-if="product and product.is_storage_box">
                    <t t-set="show_badge" t-value="request.env['ir.config_parameter'].sudo().get_param('lolirine_storage.show_status_badge', 'False') == 'True'"/>
                    <div t-if="show_badge" class="storage-status-badge text-center">
                        <span t-if="product.storage_status == 'available'" 
                              class="badge text-bg-success fs-6 px-3 py-2">
                            <i class="fa fa-check-circle me-1"/> Disponible
                        </span>
                        <span t-elif="product.storage_status == 'rented'" 
                              class="badge text-bg-danger fs-6 px-3 py-2">
                            <i class="fa fa-lock me-1"/> Loué
                        </span>
                        <span t-elif="product.storage_status == 'reserved'" 
                              class="badge text-bg-warning fs-6 px-3 py-2">
                            <i class="fa fa-clock-o me-1"/> Réservé
                        </span>
                        <span t-elif="product.storage_status == 'maintenance'" 
                              class="badge text-bg-secondary fs-6 px-3 py-2">
                            <i class="fa fa-wrench me-1"/> En maintenance
                        </span>
                    </div>
                    <div t-else="" class="storage-status-badge text-center">
                        <span t-if="product.storage_status == 'available'" 
                              class="badge text-bg-success fs-6 px-3 py-2">
                            <i class="fa fa-check-circle me-1"/> Disponible
                        </span>
                        <span t-elif="product.storage_status == 'rented'" 
                              class="badge text-bg-danger fs-6 px-3 py-2">
                            <i class="fa fa-lock me-1"/> Loué
                        </span>
                        <span t-elif="product.storage_status == 'reserved'" 
                              class="badge text-bg-warning fs-6 px-3 py-2">
                            <i class="fa fa-clock-o me-1"/> Réservé
                        </span>
                        <span t-elif="product.storage_status == 'maintenance'" 
                              class="badge text-bg-secondary fs-6 px-3 py-2">
                            <i class="fa fa-wrench me-1"/> En maintenance
                        </span>
                    </div>
                </t>
                <div t-if="not product or not product.is_storage_box" 
                     class="alert alert-secondary small o_not_editable py-1 px-2 text-center" 
                     contenteditable="false">
                    <i class="fa fa-tag me-1"/> Badge statut box
                </div>
            </div>
        </section>
    </template>

    <template id="snippets_badge" inherit_id="website.snippets" name="Storage Badge Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="lolirine_storage_availability.s_storage_badge_only"
               t-thumbnail="/lolirine_storage_availability/static/description/icon.png"
               string="Badge Statut Box"/>
        </xpath>
    </template>

    <!-- ============================================ -->
    <!-- SNIPPET : Bouton RDV seul (disponible)      -->
    <!-- ============================================ -->
    
    <template id="s_storage_appointment_only" name="Storage Appointment Only">
        <section class="s_storage_appointment_only py-2">
            <div class="container">
                <t t-if="product and product.is_storage_box and product.show_appointment_button">
                    <div class="storage-appointment-button text-center">
                        <a t-att-href="product.appointment_url" 
                           class="btn btn-primary btn-lg w-100 py-3">
                            <i class="fa fa-calendar me-2"/>
                            <t t-esc="product.appointment_button_label"/>
                        </a>
                    </div>
                </t>
                <div t-if="not product or not product.is_storage_box or not product.show_appointment_button" 
                     class="alert alert-secondary small o_not_editable py-1 px-2 text-center" 
                     contenteditable="false">
                    <i class="fa fa-calendar me-1"/> Bouton Rendez-vous (box disponible)
                </div>
            </div>
        </section>
    </template>

    <template id="snippets_appointment" inherit_id="website.snippets" name="Storage Appointment Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="lolirine_storage_availability.s_storage_appointment_only"
               t-thumbnail="/lolirine_storage_availability/static/description/icon.png"
               string="Bouton RDV Box"/>
        </xpath>
    </template>

    <!-- ============================================ -->
    <!-- SNIPPET : Bouton Demande générale seul      -->
    <!-- ============================================ -->
    
    <template id="s_storage_general_inquiry_only" name="Storage General Inquiry Only">
        <section class="s_storage_general_inquiry_only py-2">
            <div class="container">
                <t t-if="product and product.is_storage_box and product.show_general_inquiry_button">
                    <div class="storage-general-inquiry-button text-center">
                        <a t-att-href="product.general_inquiry_url" 
                           class="btn btn-secondary btn-lg w-100 py-3">
                            <i class="fa fa-envelope me-2"/>
                            <t t-esc="product.general_inquiry_button_label"/>
                        </a>
                    </div>
                </t>
                <div t-if="not product or not product.is_storage_box or not product.show_general_inquiry_button" 
                     class="alert alert-secondary small o_not_editable py-1 px-2 text-center" 
                     contenteditable="false">
                    <i class="fa fa-envelope me-1"/> Bouton Demande générale (box non disponible)
                </div>
            </div>
        </section>
    </template>

    <template id="snippets_general_inquiry" inherit_id="website.snippets" name="Storage General Inquiry Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="lolirine_storage_availability.s_storage_general_inquiry_only"
               t-thumbnail="/lolirine_storage_availability/static/description/icon.png"
               string="Bouton Demande Générale"/>
        </xpath>
    </template>

</odoo>
