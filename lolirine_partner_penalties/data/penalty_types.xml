<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Séquence pour les pénalités -->
        <record id="seq_partner_penalty" model="ir.sequence">
            <field name="name">Pénalité client</field>
            <field name="code">partner.penalty</field>
            <field name="prefix">PEN/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <!-- 1. Frais liés aux retards et manquements financiers -->
        <record id="penalty_type_late_payment" model="partner.penalty.type">
            <field name="name">Frais de retard de paiement</field>
            <field name="code">LATE_PAYMENT</field>
            <field name="category">financial</field>
            <field name="default_amount">25.00</field>
            <field name="sequence">10</field>
        </record>
        <record id="penalty_type_late_interest" model="partner.penalty.type">
            <field name="name">Intérêts de retard</field>
            <field name="code">LATE_INTEREST</field>
            <field name="category">financial</field>
            <field name="default_amount">1.5</field>
            <field name="is_percentage">True</field>
            <field name="sequence">20</field>
        </record>
        <record id="penalty_type_reminder" model="partner.penalty.type">
            <field name="name">Frais de rappel et mise en demeure</field>
            <field name="code">REMINDER</field>
            <field name="category">financial</field>
            <field name="default_amount">15.00</field>
            <field name="sequence">30</field>
        </record>
        <record id="penalty_type_admin_unpaid" model="partner.penalty.type">
            <field name="name">Frais administratifs de gestion d'impayé</field>
            <field name="code">ADMIN_UNPAID</field>
            <field name="category">financial</field>
            <field name="default_amount">35.00</field>
            <field name="sequence">40</field>
        </record>
        <record id="penalty_type_access_suspension" model="partner.penalty.type">
            <field name="name">Frais de suspension d'accès au box</field>
            <field name="code">ACCESS_SUSPENSION</field>
            <field name="category">financial</field>
            <field name="default_amount">50.00</field>
            <field name="sequence">50</field>
        </record>
        <record id="penalty_type_reactivation" model="partner.penalty.type">
            <field name="name">Frais de réactivation du contrat</field>
            <field name="code">REACTIVATION</field>
            <field name="category">financial</field>
            <field name="default_amount">75.00</field>
            <field name="sequence">60</field>
        </record>

        <!-- 2. Frais liés au non-respect du règlement intérieur -->
        <record id="penalty_type_forced_opening" model="partner.penalty.type">
            <field name="name">Frais d'ouverture forcée du box</field>
            <field name="code">FORCED_OPENING</field>
            <field name="category">rules</field>
            <field name="default_amount">150.00</field>
            <field name="sequence">10</field>
        </record>
        <record id="penalty_type_padlock_change" model="partner.penalty.type">
            <field name="name">Frais de changement de cadenas</field>
            <field name="code">PADLOCK_CHANGE</field>
            <field name="category">rules</field>
            <field name="default_amount">45.00</field>
            <field name="sequence">20</field>
        </record>
        <record id="penalty_type_useless_trip" model="partner.penalty.type">
            <field name="name">Frais de déplacement inutile</field>
            <field name="code">USELESS_TRIP</field>
            <field name="category">rules</field>
            <field name="default_amount">50.00</field>
            <field name="sequence">30</field>
        </record>
        <record id="penalty_type_hours_violation" model="partner.penalty.type">
            <field name="name">Frais de non-respect des horaires</field>
            <field name="code">HOURS_VIOLATION</field>
            <field name="category">rules</field>
            <field name="default_amount">30.00</field>
            <field name="sequence">40</field>
        </record>
        <record id="penalty_type_nuisance" model="partner.penalty.type">
            <field name="name">Frais de nuisance</field>
            <field name="code">NUISANCE</field>
            <field name="category">rules</field>
            <field name="default_amount">100.00</field>
            <field name="sequence">50</field>
        </record>

        <!-- 3. Frais liés à la dégradation ou à l'état du box -->
        <record id="penalty_type_deep_cleaning" model="partner.penalty.type">
            <field name="name">Frais de nettoyage approfondi</field>
            <field name="code">DEEP_CLEANING</field>
            <field name="category">damage</field>
            <field name="default_amount">150.00</field>
            <field name="sequence">10</field>
        </record>
        <record id="penalty_type_disinfection" model="partner.penalty.type">
            <field name="name">Frais de désinfection / dératisation</field>
            <field name="code">DISINFECTION</field>
            <field name="category">damage</field>
            <field name="default_amount">250.00</field>
            <field name="sequence">20</field>
        </record>
        <record id="penalty_type_restoration" model="partner.penalty.type">
            <field name="name">Frais de remise en état du box</field>
            <field name="code">RESTORATION</field>
            <field name="category">damage</field>
            <field name="default_amount">500.00</field>
            <field name="sequence">30</field>
        </record>
        <record id="penalty_type_waste_disposal" model="partner.penalty.type">
            <field name="name">Frais de traitement des déchets</field>
            <field name="code">WASTE_DISPOSAL</field>
            <field name="category">damage</field>
            <field name="default_amount">200.00</field>
            <field name="sequence">40</field>
        </record>
        <record id="penalty_type_abandoned_goods" model="partner.penalty.type">
            <field name="name">Frais de gestion d'abandon de biens</field>
            <field name="code">ABANDONED_GOODS</field>
            <field name="category">damage</field>
            <field name="default_amount">350.00</field>
            <field name="sequence">50</field>
        </record>

        <!-- 4. Frais liés à l'usage interdit ou dangereux -->
        <record id="penalty_type_infraction" model="partner.penalty.type">
            <field name="name">Frais de constat d'infraction</field>
            <field name="code">INFRACTION</field>
            <field name="category">forbidden</field>
            <field name="default_amount">100.00</field>
            <field name="sequence">10</field>
        </record>
        <record id="penalty_type_emergency_security" model="partner.penalty.type">
            <field name="name">Frais de sécurisation d'urgence</field>
            <field name="code">EMERGENCY_SECURITY</field>
            <field name="category">forbidden</field>
            <field name="default_amount">250.00</field>
            <field name="sequence">20</field>
        </record>
        <record id="penalty_type_forbidden_products" model="partner.penalty.type">
            <field name="name">Frais présence de produits interdits</field>
            <field name="code">FORBIDDEN_PRODUCTS</field>
            <field name="category">forbidden</field>
            <field name="default_amount">500.00</field>
            <field name="sequence">30</field>
        </record>
        <record id="penalty_type_external_intervention" model="partner.penalty.type">
            <field name="name">Frais d'intervention externe</field>
            <field name="code">EXTERNAL_INTERVENTION</field>
            <field name="category">forbidden</field>
            <field name="default_amount">0.00</field>
            <field name="description">Pompiers, police, société spécialisée - montant variable</field>
            <field name="sequence">40</field>
        </record>
        <record id="penalty_type_immediate_termination" model="partner.penalty.type">
            <field name="name">Frais de résiliation immédiate pour faute grave</field>
            <field name="code">IMMEDIATE_TERMINATION</field>
            <field name="category">forbidden</field>
            <field name="default_amount">0.00</field>
            <field name="description">Montant selon gravité</field>
            <field name="sequence">50</field>
        </record>

        <!-- 5. Frais contractuels et juridiques -->
        <record id="penalty_type_early_termination" model="partner.penalty.type">
            <field name="name">Indemnité de résiliation anticipée</field>
            <field name="code">EARLY_TERMINATION</field>
            <field name="category">legal</field>
            <field name="default_amount">0.00</field>
            <field name="description">Selon conditions du contrat</field>
            <field name="sequence">10</field>
        </record>
        <record id="penalty_type_penalty_clause" model="partner.penalty.type">
            <field name="name">Clause pénale forfaitaire</field>
            <field name="code">PENALTY_CLAUSE</field>
            <field name="category">legal</field>
            <field name="default_amount">200.00</field>
            <field name="sequence">20</field>
        </record>
        <record id="penalty_type_litigation_file" model="partner.penalty.type">
            <field name="name">Frais de dossier contentieux</field>
            <field name="code">LITIGATION_FILE</field>
            <field name="category">legal</field>
            <field name="default_amount">150.00</field>
            <field name="sequence">30</field>
        </record>
        <record id="penalty_type_amicable_recovery" model="partner.penalty.type">
            <field name="name">Frais de recouvrement amiable</field>
            <field name="code">AMICABLE_RECOVERY</field>
            <field name="category">legal</field>
            <field name="default_amount">75.00</field>
            <field name="sequence">40</field>
        </record>
        <record id="penalty_type_judicial_recovery" model="partner.penalty.type">
            <field name="name">Frais de recouvrement judiciaire</field>
            <field name="code">JUDICIAL_RECOVERY</field>
            <field name="category">legal</field>
            <field name="default_amount">0.00</field>
            <field name="description">Selon procédure</field>
            <field name="sequence">50</field>
        </record>
        <record id="penalty_type_bailiff" model="partner.penalty.type">
            <field name="name">Frais d'expertise / constat huissier</field>
            <field name="code">BAILIFF</field>
            <field name="category">legal</field>
            <field name="default_amount">0.00</field>
            <field name="description">Selon tarifs huissier</field>
            <field name="sequence">60</field>
        </record>
    </data>
</odoo>
