<odoo>
    <record id="view_visite_site_form" model="ir.ui.view">
        <field name="name">visite.site.form</field>
        <field name="model">visite.site</field>
        <field name="arch" type="xml">
            <form string="Visite du site">
                <sheet>
                    <group>
                        <field name="client_id"/>
                        <field name="date_visite"/>
                        <field name="box_souhaite_id"/>
                        <field name="etat"/>
                        <field name="commentaire"/>
                    </group>
                </sheet>
            </form>
        </field>
        <field name="type">form</field>
    </record>

    <record id="view_visite_site_tree" model="ir.ui.view">
        <field name="name">visite.site.tree</field>
        <field name="model">visite.site</field>
        <field name="arch" type="xml">
            <tree string="Visites du site">
                <field name="client_id"/>
                <field name="date_visite"/>
                <field name="box_souhaite_id"/>
                <field name="etat"/>
            </tree>
        </field>
        <field name="type">tree</field>
    </record>

    <menuitem id="menu_visite_site_root" name="Visites" sequence="10"/>
    <menuitem id="menu_visite_site" name="Visites du site" parent="menu_visite_site_root" action="action_visite_site"/>

    <record id="action_visite_site" model="ir.actions.act_window">
        <field name="name">Visites du site</field>
        <field name="res_model">visite.site</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
