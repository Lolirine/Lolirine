<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_visite_fiche">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Fiche de Visite</h2>
                        <h4 class="text-center text-muted">
                            <t t-esc="o.name"/>
                        </h4>
                        
                        <div class="row mt-4">
                            <div class="col-6">
                                <h5>Informations client</h5>
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Nom:</strong></td>
                                        <td><t t-esc="o.partner_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Téléphone:</strong></td>
                                        <td><t t-esc="o.partner_phone or '-'"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Mobile:</strong></td>
                                        <td><t t-esc="o.partner_mobile or '-'"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Email:</strong></td>
                                        <td><t t-esc="o.partner_email or '-'"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <h5>Informations visite</h5>
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Date:</strong></td>
                                        <td><t t-esc="o.date_visite" t-options="{'widget': 'datetime'}"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Commercial:</strong></td>
                                        <td><t t-esc="o.user_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>État:</strong></td>
                                        <td><t t-esc="dict(o._fields['state'].selection).get(o.state, '')"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5>Besoins du client</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="25%"><strong>Type de stockage:</strong></td>
                                        <td><t t-esc="dict(o._fields['type_stockage'].selection).get(o.type_stockage, '')"/></td>
                                        <td width="25%"><strong>Volume estimé:</strong></td>
                                        <td><t t-esc="o.volume_estime"/> m³</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Surface estimée:</strong></td>
                                        <td><t t-esc="'%.1f' % o.surface_estimee"/> m²</td>
                                        <td><strong>Durée prévue:</strong></td>
                                        <td><t t-esc="dict(o._fields['duree_prevue'].selection).get(o.duree_prevue, '')"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Fréquence d'accès:</strong></td>
                                        <td><t t-esc="dict(o._fields['acces_frequence'].selection).get(o.acces_frequence, '')"/></td>
                                        <td><strong>Objets sensibles:</strong></td>
                                        <td><t t-if="o.objets_sensibles">Oui - <t t-esc="o.objets_sensibles_detail or ''"/></t><t t-else="">Non</t></td>
                                    </tr>
                                </table>
                                
                                <t t-if="o.besoin_description">
                                    <p><strong>Description du besoin:</strong></p>
                                    <p class="text-muted"><t t-esc="o.besoin_description"/></p>
                                </t>
                            </div>
                        </div>
                        
                        <t t-if="o.box_ids">
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h5>Box présentées</h5>
                                    <table class="table table-bordered table-sm">
                                        <thead>
                                            <tr>
                                                <th>Référence</th>
                                                <th>Surface</th>
                                                <th>Étage</th>
                                                <th>Prix mensuel</th>
                                                <th>Sélectionnée</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="o.box_ids" t-as="box">
                                                <tr>
                                                    <td><t t-esc="box.name"/></td>
                                                    <td><t t-esc="box.surface"/> m²</td>
                                                    <td><t t-esc="dict(box._fields['etage'].selection).get(box.etage, '')"/></td>
                                                    <td><t t-esc="'%.2f' % box.prix_mensuel"/> €</td>
                                                    <td>
                                                        <t t-if="box.id == o.box_selected_id.id">✓</t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>
                        
                        <t t-if="o.notes_client">
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h5>Notes</h5>
                                    <p><t t-esc="o.notes_client"/></p>
                                </div>
                            </div>
                        </t>
                        
                        <div class="row mt-5">
                            <div class="col-6">
                                <h6>Consentements</h6>
                                <p>
                                    <input type="checkbox" t-att-checked="o.consent_rgpd"/> 
                                    J'autorise le traitement de mes données personnelles (RGPD)
                                </p>
                                <p>
                                    <input type="checkbox" t-att-checked="o.consent_marketing"/> 
                                    J'accepte de recevoir des communications marketing
                                </p>
                            </div>
                            <div class="col-6 text-center">
                                <h6>Signature du client</h6>
                                <div style="border: 1px solid #ccc; min-height: 100px; padding: 10px;">
                                    <t t-if="o.signature">
                                        <img t-att-src="image_data_uri(o.signature)" style="max-width: 200px;"/>
                                    </t>
                                </div>
                                <t t-if="o.signature_date">
                                    <p class="text-muted mt-2">
                                        Signé le <t t-esc="o.signature_date" t-options="{'widget': 'datetime'}"/>
                                    </p>
                                </t>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-12 text-center text-muted">
                                <small>Document généré le <t t-esc="datetime.datetime.now()" t-options="{'widget': 'datetime'}"/></small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
