<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Groupe: Utilisateur -->
        <record id="group_dropship_user" model="res.groups">
            <field name="name">Dropshipping / Utilisateur</field>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="comment">Peut consulter les commandes dropshipping et voir les marges</field>
        </record>
        
        <!-- Groupe: Manager -->
        <record id="group_dropship_manager" model="res.groups">
            <field name="name">Dropshipping / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_dropship_user'))]"/>
            <field name="comment">Peut gérer les fournisseurs, configurer les règles et override les décisions</field>
        </record>
        
        <!-- Groupe: Admin -->
        <record id="group_dropship_admin" model="res.groups">
            <field name="name">Dropshipping / Administrateur</field>
            <field name="implied_ids" eval="[(4, ref('group_dropship_manager'))]"/>
            <field name="comment">Accès complet à la configuration du module</field>
        </record>
        
        <!-- Donner le groupe admin aux administrateurs système -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_dropship_admin'))]"/>
        </record>
        
        <!-- Règles d'accès aux enregistrements -->
        <record id="dropship_sale_order_rule" model="ir.rule">
            <field name="name">Dropship: Commandes de l'équipe</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('is_dropship_order', '=', True), '|', ('user_id', '=', user.id), ('team_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_dropship_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Les managers voient toutes les commandes -->
        <record id="dropship_sale_order_manager_rule" model="ir.rule">
            <field name="name">Dropship: Toutes les commandes (Manager)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dropship_manager'))]"/>
        </record>
    </data>
</odoo>
