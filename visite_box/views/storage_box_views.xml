<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire storage box -->
    <record id="storage_box_view_form" model="ir.ui.view">
        <field name="name">storage.box.view.form</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <form string="Box de stockage">
                <header>
                    <button name="action_set_available" string="Disponible" type="object" 
                            invisible="state == 'available'" class="oe_highlight"/>
                    <button name="action_set_maintenance" string="Maintenance" type="object" 
                            invisible="state == 'maintenance'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,occupied"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visites" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="visite_count" widget="statinfo" string="Visites"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Maintenance" bg_color="bg-warning" 
                            invisible="state != 'maintenance'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Référence"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Dimensions">
                            <field name="surface"/>
                            <field name="hauteur"/>
                            <field name="volume" readonly="1"/>
                            <field name="largeur"/>
                            <field name="profondeur"/>
                        </group>
                        <group string="Emplacement">
                            <field name="etage"/>
                            <field name="batiment"/>
                            <field name="zone"/>
                            <field name="plain_pied" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tarification">
                            <field name="prix_mensuel"/>
                            <field name="prix_journalier" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Caractéristiques">
                            <field name="climatise"/>
                            <field name="alarme"/>
                            <field name="acces_24h"/>
                            <field name="acces_vehicule"/>
                        </group>
                    </group>
                    <group>
                        <group string="Location">
                            <field name="partner_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Notes"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste storage box -->
    <record id="storage_box_view_tree" model="ir.ui.view">
        <field name="name">storage.box.view.tree</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <tree string="Box de stockage" decoration-muted="state == 'maintenance'"
                  decoration-success="state == 'available'"
                  decoration-warning="state == 'reserved'"
                  decoration-danger="state == 'occupied'">
                <field name="name"/>
                <field name="surface"/>
                <field name="volume"/>
                <field name="etage"/>
                <field name="prix_mensuel"/>
                <field name="partner_id"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'reserved'"
                       decoration-danger="state == 'occupied'"
                       decoration-muted="state == 'maintenance'"/>
                <field name="climatise" optional="hide"/>
                <field name="acces_24h" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Vue Kanban storage box -->
    <record id="storage_box_view_kanban" model="ir.ui.view">
        <field name="name">storage.box.view.kanban</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="surface"/>
                <field name="prix_mensuel"/>
                <field name="state"/>
                <field name="partner_id"/>
                <field name="climatise"/>
                <field name="acces_24h"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><strong><field name="surface"/>m²</strong></div>
                                    <div class="text-muted">
                                        <field name="prix_mensuel" widget="monetary"/>€/mois
                                    </div>
                                    <div class="mt-2" t-if="record.partner_id.raw_value">
                                        <i class="fa fa-user"/> <field name="partner_id"/>
                                    </div>
                                    <div class="mt-1">
                                        <span t-if="record.climatise.raw_value" class="badge text-bg-info">
                                            <i class="fa fa-snowflake-o"/> Clim
                                        </span>
                                        <span t-if="record.acces_24h.raw_value" class="badge text-bg-secondary">
                                            24h
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue recherche storage box -->
    <record id="storage_box_view_search" model="ir.ui.view">
        <field name="name">storage.box.view.search</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <search string="Rechercher une box">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Disponibles" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Réservées" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Occupées" name="occupied" domain="[('state', '=', 'occupied')]"/>
                <separator/>
                <filter string="RDC" name="rdc" domain="[('etage', '=', 'rdc')]"/>
                <filter string="Climatisées" name="climatise" domain="[('climatise', '=', True)]"/>
                <filter string="Accès 24h" name="acces_24h" domain="[('acces_24h', '=', True)]"/>
                <separator/>
                <filter string="Archivées" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Grouper par">
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Étage" name="group_etage" context="{'group_by': 'etage'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action storage box -->
    <record id="storage_box_action" model="ir.actions.act_window">
        <field name="name">Box de stockage</field>
        <field name="res_model">storage.box</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="storage_box_view_search"/>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle box de stockage
            </p>
            <p>
                Gérez l'inventaire de vos box de stockage et leur disponibilité.
            </p>
        </field>
    </record>
</odoo>
