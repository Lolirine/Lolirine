<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_act365_assign_code_wizard_form" model="ir.ui.view">
        <field name="name">act365.assign.code.wizard.form</field>
        <field name="model">act365.assign.code.wizard</field>
        <field name="arch" type="xml">
            <form string="Attribuer un code ACT365">
                <group>
                    <group string="Abonnement">
                        <field name="subscription_id" readonly="1"/>
                        <field name="partner_id"/>
                    </group>
                    <group string="Configuration ACT365">
                        <field name="act365_group_id"/>
                    </group>
                </group>
                
                <group string="Code d'accès">
                    <group>
                        <field name="code_generation_mode" widget="radio"/>
                        <field name="pin_length" invisible="code_generation_mode != 'auto'"/>
                    </group>
                    <group>
                        <field name="access_code" 
                               password="True" 
                               readonly="code_generation_mode == 'auto'"
                               placeholder="Ex: 4587"/>
                        <button name="action_generate_pin" 
                                string="🔄 Régénérer" 
                                type="object"
                                class="btn-secondary"
                                invisible="code_generation_mode != 'auto'"/>
                    </group>
                </group>
                
                <group string="Validité">
                    <group>
                        <field name="valid_from"/>
                    </group>
                    <group>
                        <field name="valid_to"/>
                    </group>
                </group>
                
                <group string="Options">
                    <field name="sync_immediately"/>
                    <field name="update_partner"/>
                </group>
                
                <footer>
                    <button name="action_confirm" 
                            string="✓ Attribuer le code" 
                            type="object" 
                            class="btn-primary"/>
                    <button name="action_open_act365_portal" 
                            string="🌐 Ouvrir ACT365" 
                            type="object"
                            class="btn-secondary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_act365_assign_code_wizard" model="ir.actions.act_window">
        <field name="name">Attribuer un code ACT365</field>
        <field name="res_model">act365.assign.code.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
