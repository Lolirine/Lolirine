<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== RELANCES DE FACTURES ==================== -->
    
    <!-- Vue formulaire relance -->
    <record id="view_invoice_reminder_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.form</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <form string="Relance">
                <header>
                    <button name="action_send_reminder" type="object" string="📧 Envoyer par email"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_composer" type="object" string="📝 Prévisualiser"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="✅ Marquer payée"
                            class="btn-success" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_create_next_reminder" type="object" string="➡️ Relance suivante"
                            invisible="state != 'sent' or reminder_type == 'lawyer'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon"
                            invisible="state not in ('sent', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" 
                                class="oe_stat_button" icon="fa-file-text-o">
                            <span class="o_stat_text">Voir Facture</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Envoyée" bg_color="text-bg-success" invisible="state != 'sent'"/>
                    <widget name="web_ribbon" title="Payée" bg_color="text-bg-info" invisible="state != 'paid'"/>
                    <widget name="web_ribbon" title="Annulée" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Relance">
                            <field name="invoice_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="reminder_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="date"/>
                        </group>
                        <group string="Montants">
                            <field name="amount_due"/>
                            <field name="days_overdue"/>
                            <field name="penalty_amount"/>
                            <field name="total_due" class="fw-bold text-danger"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Envoi">
                            <field name="send_date" readonly="1"/>
                            <field name="email_sent"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" placeholder="Notes internes sur cette relance..." nolabel="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue liste relances -->
    <record id="view_invoice_reminder_list" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.list</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <list string="Relances" decoration-danger="state == 'draft' and days_overdue &gt; 30"
                  decoration-warning="state == 'draft' and days_overdue &gt; 14"
                  decoration-success="state == 'paid'"
                  decoration-muted="state == 'cancelled'"
                  default_order="date desc">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="reminder_type" widget="badge"
                       decoration-info="reminder_type == 'reminder_1'"
                       decoration-warning="reminder_type == 'reminder_2'"
                       decoration-danger="reminder_type in ('reminder_3', 'formal_notice', 'lawyer')"/>
                <field name="date"/>
                <field name="days_overdue"/>
                <field name="amount_due" sum="Total du"/>
                <field name="penalty_amount" sum="Total penalites" optional="hide"/>
                <field name="total_due" sum="Total" optional="show"/>
                <field name="email_sent" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'sent'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vue recherche relances -->
    <record id="view_invoice_reminder_search" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.search</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <search string="Rechercher relances">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Brouillon" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Envoyées" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Payées" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter string="1er Rappel" name="filter_reminder_1" domain="[('reminder_type', '=', 'reminder_1')]"/>
                <filter string="2ème Rappel" name="filter_reminder_2" domain="[('reminder_type', '=', 'reminder_2')]"/>
                <filter string="3ème Rappel" name="filter_reminder_3" domain="[('reminder_type', '=', 'reminder_3')]"/>
                <filter string="Mise en demeure" name="filter_formal" domain="[('reminder_type', '=', 'formal_notice')]"/>
                <separator/>
                <filter string="Retard &gt; 7 jours" name="filter_overdue_7" domain="[('days_overdue', '&gt;', 7)]"/>
                <filter string="Retard &gt; 14 jours" name="filter_overdue_14" domain="[('days_overdue', '&gt;', 14)]"/>
                <filter string="Retard &gt; 30 jours" name="filter_overdue_30" domain="[('days_overdue', '&gt;', 30)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'reminder_type'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action relances -->
    <record id="action_invoice_reminders" model="ir.actions.act_window">
        <field name="name">Relances</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune relance
            </p>
            <p>
                Les relances sont créées depuis les factures impayées.
            </p>
        </field>
    </record>

    <!-- Action relances à envoyer -->
    <record id="action_invoice_reminders_to_send" model="ir.actions.act_window">
        <field name="name">Relances à envoyer</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
    </record>

    <!-- Action relances envoyées -->
    <record id="action_invoice_reminders_sent" model="ir.actions.act_window">
        <field name="name">Relances en attente</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent')]</field>
    </record>

    <!-- ==================== CONFIGURATION RELANCES ==================== -->
    
    <record id="view_invoice_reminder_config_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.config.form</field>
        <field name="model">lolirine.invoice.reminder.config</field>
        <field name="arch" type="xml">
            <form string="Configuration relances">
                <sheet>
                    <group>
                        <group string="Délais de relance (jours après échéance)">
                            <field name="reminder_1_days"/>
                            <field name="reminder_2_days"/>
                            <field name="reminder_3_days"/>
                            <field name="formal_notice_days"/>
                        </group>
                        <group string="Pénalités">
                            <field name="penalty_rate"/>
                            <field name="auto_reminder"/>
                        </group>
                    </group>
                    <div class="alert alert-info">
                        <strong>Information :</strong> Le taux légal belge pour les pénalités de retard 
                        est de 10,5% annuel (2024). Ce taux est appliqué proportionnellement 
                        au nombre de jours de retard.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_invoice_reminder_config" model="ir.actions.act_window">
        <field name="name">Configuration relances</field>
        <field name="res_model">lolirine.invoice.reminder.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
