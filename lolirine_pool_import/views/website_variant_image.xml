<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         CSS pour les vignettes variantes (injecté dans le head)
         website.layout existe toujours dans toutes les versions Odoo.
         ============================================================ -->

    <template id="pool_variant_image_style"
              inherit_id="website.layout"
              name="Pool Variant Image CSS">
        <xpath expr="//head" position="inside">
            <style>
                /* Vignettes variantes sur les sélecteurs */
                .pool-variant-thumb {
                    width: 32px;
                    height: 32px;
                    object-fit: cover;
                    border-radius: 4px;
                    margin-right: 6px;
                    vertical-align: middle;
                    border: 1px solid #ddd;
                    transition: border-color 0.2s, box-shadow 0.2s;
                }
                .pool-variant-thumb:hover {
                    border-color: #3aadaa;
                    box-shadow: 0 0 0 2px rgba(58,173,170,.25);
                }
                /* Transition fluide image principale */
                .product_detail_img,
                .o_wsale_product_main_image img,
                #o-carousel-product .carousel-item img {
                    transition: opacity .25s ease;
                }
                /* Couleurs arrondies */
                .css_attribute_color .pool-variant-thumb {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                }
                /* Sélection active */
                input:checked + label .pool-variant-thumb,
                .btn.active .pool-variant-thumb {
                    border-color: #3aadaa;
                    box-shadow: 0 0 0 2px rgba(58,173,170,.4);
                }
            </style>
        </xpath>
    </template>

</odoo>
