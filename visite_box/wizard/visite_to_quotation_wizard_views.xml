<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire wizard -->
    <record id="visite_to_quotation_wizard_view_form" model="ir.ui.view">
        <field name="name">visite.to.quotation.wizard.view.form</field>
        <field name="model">visite.to.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Convertir en devis">
                <group>
                    <field name="visite_id" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                </group>
                <group>
                    <group>
                        <field name="creation_type" widget="radio"/>
                        <field name="box_id" options="{'no_create': True}"/>
                        <field name="date_start"/>
                        <field name="duree_prevue"/>
                    </group>
                    <group>
                        <field name="include_depot_garantie"/>
                        <field name="depot_garantie_mois" invisible="not include_depot_garantie"/>
                        <field name="include_assurance"/>
                    </group>
                </group>
                <separator string="Notes"/>
                <field name="notes" placeholder="Notes à inclure dans le devis..."/>
                <footer>
                    <button name="action_create_quotation" string="Créer le devis" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
