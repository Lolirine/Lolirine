<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension du formulaire partenaire -->
    <record id="res_partner_view_form_penalties" model="ir.ui.view">
        <field name="name">res.partner.form.penalties</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Boutons statistiques -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_penalties"
                        icon="fa-exclamation-triangle"
                        invisible="penalty_count == 0">
                    <div class="o_stat_info">
                        <field name="penalty_count" class="o_stat_value"/>
                        <span class="o_stat_text">Pénalités</span>
                    </div>
                </button>
            </xpath>

            <!-- Nouvel onglet "Garde-Meubles" -->
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Garde-Meubles" name="storage_penalties">
                    <group>
                        <group string="Box de stockage">
                            <field name="storage_product_id" 
                                   options="{'no_create': True}"/>
                            <field name="storage_subscription_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Évaluation client">
                            <field name="behavior_rating" widget="radio"/>
                            <field name="penalty_total"/>
                            <field name="penalty_unpaid" 
                                   decoration-danger="penalty_unpaid > 0"/>
                        </group>
                    </group>
                    
                    <group string="Remarques sur le comportement">
                        <field name="behavior_notes" nolabel="1" 
                               placeholder="Notes sur le comportement du client (paiements, respect des règles, incidents, etc.)"/>
                    </group>

                    <group string="Pénalités">
                        <field name="penalty_ids" nolabel="1" colspan="2"/>
                        <button name="action_add_penalty" type="object" 
                                string="Ajouter une pénalité" class="btn-secondary"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
