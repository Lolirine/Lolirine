<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Template du popup injecté dans toutes les pages -->
    <template id="lolirine_popup_template" inherit_id="website.layout" name="Lolirine Popup">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <t t-set="popup_config" t-value="request.env['lolirine.popup.config'].sudo().get_active_popup()"/>
            <t t-if="popup_config">
                <!-- Popup Container -->
                <div id="lolirine_popup_overlay" class="lolirine-popup-overlay" style="display: none;"
                     t-att-data-delay="popup_config.get('show_delay', 3000)"
                     t-att-data-hide-duration="popup_config.get('hide_duration', 7)"
                     t-att-data-display-mode="popup_config.get('display_mode', 'all')"
                     t-att-data-specific-urls="','.join(popup_config.get('specific_urls', []))"
                     t-att-data-popup-id="popup_config.get('id')"
                     t-att-data-popup-type="popup_config.get('popup_type', 'standard')"
                     t-att-data-max-boxes="popup_config.get('max_boxes_display', 5)"
                     t-att-data-boxes-button-text="popup_config.get('boxes_button_text', 'Réserver')"
                     t-att-data-boxes-contact-url="popup_config.get('boxes_contact_url', '/contact-garde-meubles')"
                     t-att-data-show-price="popup_config.get('show_box_price', True)"
                     t-att-data-show-size="popup_config.get('show_box_size', True)">
                    
                    <div class="lolirine-popup-modal">
                        <!-- Header avec bouton fermer -->
                        <div class="lolirine-popup-header" t-att-style="'background-color: %s;' % popup_config.get('background_color', '#C91E18')">
                            <button type="button" class="lolirine-popup-close" aria-label="Fermer">
                                <span>×</span>
                            </button>
                        </div>
                        
                        <!-- Contenu -->
                        <div class="lolirine-popup-content">
                            <h2 class="lolirine-popup-title" t-esc="popup_config.get('title', 'Box Disponible')"/>
                            <p class="lolirine-popup-subtitle" t-esc="popup_config.get('subtitle', '')"/>
                            
                            <!-- Contenu Standard -->
                            <div class="lolirine-popup-standard" t-if="popup_config.get('popup_type') == 'standard'">
                                <div class="lolirine-popup-buttons">
                                    <a t-att-href="popup_config.get('button_url', '/contact-garde-meubles')"
                                       t-att-target="popup_config.get('button_target', '_self')"
                                       class="btn lolirine-popup-btn-primary"
                                       t-att-style="'background-color: %s; border-color: %s;' % (popup_config.get('background_color', '#C91E18'), popup_config.get('background_color', '#C91E18'))">
                                        <t t-esc="popup_config.get('button_text', 'Vers le Formulaire')"/>
                                    </a>
                                    
                                    <t t-if="popup_config.get('show_secondary_button')">
                                        <a t-att-href="popup_config.get('secondary_button_url', '#')"
                                           class="btn lolirine-popup-btn-secondary">
                                            <t t-esc="popup_config.get('secondary_button_text', 'En savoir plus')"/>
                                        </a>
                                    </t>
                                </div>
                            </div>
                            
                            <!-- Contenu Boxes Disponibles (rempli dynamiquement via JS) -->
                            <div class="lolirine-popup-boxes" t-if="popup_config.get('popup_type') == 'available_boxes'">
                                <div class="lolirine-boxes-loading">
                                    <i class="fa fa-spinner fa-spin"></i> Chargement des boxes disponibles...
                                </div>
                                <div class="lolirine-boxes-list"></div>
                                <div class="lolirine-boxes-empty" style="display: none;">
                                    <p>Aucun box disponible pour le moment.</p>
                                    <a href="/contact-garde-meubles" class="btn lolirine-popup-btn-primary">
                                        Nous contacter
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
    
</odoo>
