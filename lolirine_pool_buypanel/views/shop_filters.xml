<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Filtres de la boutique : n'afficher que les valeurs présentes sur les
        produits de la recherche (dictionnaire lp_vals calculé par
        controllers/shop_filters.py, Pool Store uniquement). Sans lp_vals
        (autres sites), le comportement d'Odoo est inchangé.
    -->
    <template id="lp_filter_color" inherit_id="website_sale.filter_color_attributes" name="Pool Store : filtres couleur limités">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute name="t-foreach">(lp_vals or {}).get(a.id, a.value_ids)</attribute>
        </xpath>
    </template>

    <template id="lp_filter_image" inherit_id="website_sale.filter_image_attributes" name="Pool Store : filtres image limités">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute name="t-foreach">(lp_vals or {}).get(a.id, a.value_ids)</attribute>
        </xpath>
    </template>

    <template id="lp_filter_select" inherit_id="website_sale.filter_select_attributes" name="Pool Store : filtres liste limités">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute name="t-foreach">(lp_vals or {}).get(a.id, a.value_ids)</attribute>
        </xpath>
    </template>

    <template id="lp_filter_pills" inherit_id="website_sale.filter_pills_attributes" name="Pool Store : filtres pastilles limités">
        <xpath expr="//t[@t-foreach='a.value_ids']" position="attributes">
            <attribute name="t-foreach">(lp_vals or {}).get(a.id, a.value_ids)</attribute>
        </xpath>
    </template>

    <template id="lp_filter_radio_multi" inherit_id="website_sale.filter_radio_and_multi_attributes" name="Pool Store : filtres cases limités">
        <xpath expr="//t[@t-set='sorted_values']" position="attributes">
            <attribute name="t-value">sorted((lp_vals or {}).get(a.id, a.value_ids), key=lambda v: v.id not in attrib_set)</attribute>
        </xpath>
        <xpath expr="//input[hasclass('o_wsale_attribute_search_bar')]" position="attributes">
            <attribute name="t-attf-placeholder">Search {{a.name}} ({{len(sorted_values)}})</attribute>
        </xpath>
    </template>

    <template id="lp_filter_form" inherit_id="website_sale.product_attribute_filters_form" name="Pool Store : filtres masqués s'il reste une seule valeur">
        <xpath expr="//t[@t-set='visible_attributes']" position="attributes">
            <attribute name="t-value">len([a for a in attributes if len((lp_vals or {}).get(a.id, a.value_ids)) &gt; 1])</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-if, 'len(a.value_ids)')]" position="attributes">
            <attribute name="t-if">len((lp_vals or {}).get(a.id, a.value_ids)) &gt; 1</attribute>
        </xpath>
    </template>
</odoo>
