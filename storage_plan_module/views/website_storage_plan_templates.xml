                                                <div class="box-vol"><t t-esc="b.get('volume', '')"/> m³</div>
                                                <t t-if="b.get('status') != 'disponible' and b.get('date_available')"><div class="box-date">Dispo: <t t-esc="b.get('date_available')"/></div></t>
                                            </div>
                                        </div>
                                        <div class="box-cell cell-1d33">
                                            <t t-set="b" t-value="boxes.get('1D33', {})"/>
                                            <div t-if="b" class="storage-box" t-att-data-box-id="b.get('id')" t-att-data-status="b.get('status')" t-attf-style="background-color: #{b.get('status_color', '#ccc')};">
                                                <div class="box-name">1D33</div>
                                                <div class="box-vol"><t t-esc="b.get('volume', '')"/> m³</div>
                                                <t t-if="b.get('status') != 'disponible' and b.get('date_available')"><div class="box-date">Dispo: <t t-esc="b.get('date_available')"/></div></t>
                                            </div>
                                        </div>
                                        
                                        <!-- BUR, 1G01, WC, 1D34 -->
                                        <div class="zone-bur">BUR</div>
                                        <div class="box-cell cell-1g01">
                                            <t t-set="b" t-value="boxes.get('1G01', {})"/>
                                            <div t-if="b" class="storage-box" t-att-data-box-id="b.get('id')" t-att-data-status="b.get('status')" t-attf-style="background-color: #{b.get('status_color', '#ccc')};">
                                                <div class="box-name">1G01</div>
                                                <div class="box-vol"><t t-esc="b.get('volume', '')"/> m³</div>
                                                <t t-if="b.get('status') != 'disponible' and b.get('date_available')"><div class="box-date">Dispo: <t t-esc="b.get('date_available')"/></div></t>
                                            </div>
                                        </div>
                                        <div class="zone-wc">WC</div>
                                        <div class="box-cell cell-1d34">
                                            <t t-set="b" t-value="boxes.get('1D34', {})"/>
                                            <div t-if="b" class="storage-box" t-att-data-box-id="b.get('id')" t-att-data-status="b.get('status')" t-attf-style="background-color: #{b.get('status_color', '#ccc')};">
                                                <div class="box-name">1D34</div>
                                                <div class="box-vol"><t t-esc="b.get('volume', '')"/> m³</div>
                                                <t t-if="b.get('status') != 'disponible' and b.get('date_available')"><div class="box-date">Dispo: <t t-esc="b.get('date_available')"/></div></t>
                                            </div>
                                        </div>
                                        
                                        <!-- TECH -->
                                        <div class="zone-tech">TECH</div>
                                    </div>
                                </div>

                                <!-- ==================== PREMIER ÉTAGE ==================== -->
                                <div class="floor-container">
                                    <div class="floor-title">Premier étage</div>
                                    <div class="floor-grid r1-grid">
                                        <!-- Zone CNC2 -->
                                        <div class="zone-cnc cnc2">CNC2</div>
                                        
                                        <!-- Toutes les cellules du premier étage -->
                                        <t t-foreach="['2D61', '2D62', '2D60', '2D63', '2D59', '2D64', '2G43', '2G44', '2D58', '2D65', '2D57', '2D66', '2G42', '2G45', '2D56', '2D67', '2G41', '2G46', '2D55', '2D68', '2G40', '2G47', '2D54', '2D69', '2G39', '2G48', '2D53', '2D70', '2G38', '2G49', '2D52', '2D71', '2G37', '2G50', '2G51', '2D72', '2G36', '2D73', '2G35', '2G75', '2D74']" t-as="box_name">
                                            <div t-attf-class="box-cell cell-#{box_name.lower()}">
                                                <t t-set="b" t-value="boxes.get(box_name, {})"/>
                                                <div t-if="b" class="storage-box" t-att-data-box-id="b.get('id')" t-att-data-status="b.get('status')" t-attf-style="background-color: #{b.get('status_color', '#ccc')};">
                                                    <div class="box-name"><t t-esc="box_name"/></div>
                                                    <div class="box-vol"><t t-esc="b.get('volume', '')"/> m³</div>
                                                    <t t-if="b.get('status') != 'disponible' and b.get('date_available')"><div class="box-date">Dispo: <t t-esc="b.get('date_available')"/></div></t>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar -->
                        <div class="sidebar-section">
                            <div class="sidebar-content">
                                <div class="example-box-card">
                                    <div class="example-title">Exemple de box</div>
                                    <div class="example-box-demo">
                                        <div class="demo-id">ID du Box</div>
                                        <div class="demo-volume">Volume (m³)</div>
                                    </div>
                                </div>
                                
                                <div class="legend-card">
                                    <div class="legend-title">Légende des couleurs</div>
                                    <div class="legend-items">
                                        <t t-foreach="status_legend" t-as="status">
                                            <div class="legend-item">
                                                <span class="legend-color" t-attf-style="background-color: #{status['color']};"></span>
                                                <span class="legend-label"><t t-esc="status['label']"/></span>
                                            </div>
                                        </t>
                                    </div>
                                    <a href="/contactus" class="btn-demande-generale" id="general-inquiry-btn">Demande générale</a>
                                </div>
                                
                                <div class="forklift-image">
                                    <img src="/storage_plan_module/static/src/img/forklift.png" alt="Chariot"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal -->
                <div class="modal fade" id="boxDetailsModal" tabindex="-1" role="dialog">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Détails du Box</h5>
                                <button type="button" class="close" data-dismiss="modal" id="btn-close-modal"><span>×</span></button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-md-6"><canvas id="box-3d-canvas" width="400" height="400"></canvas></div>
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-5">Box N°:</dt><dd class="col-sm-7" id="detail-box-name"></dd>
                                            <dt class="col-sm-5">Largeur:</dt><dd class="col-sm-7" id="detail-width"></dd>
                                            <dt class="col-sm-5">Profondeur:</dt><dd class="col-sm-7" id="detail-depth"></dd>
                                            <dt class="col-sm-5">Hauteur:</dt><dd class="col-sm-7" id="detail-height"></dd>
                                            <dt class="col-sm-5">Volume:</dt><dd class="col-sm-7" id="detail-volume"></dd>
                                            <dt class="col-sm-5">Prix:</dt><dd class="col-sm-7" id="detail-price"></dd>
                                            <dt class="col-sm-5">Statut:</dt><dd class="col-sm-7"><span class="badge" id="detail-status"></span></dd>
                                            <dt class="col-sm-5" id="detail-date-available-label" style="display:none;">Disponible le:</dt>
                                            <dd class="col-sm-7" id="detail-date-available" style="display:none;"></dd>
                                        </dl>
                                        <a href="/contactus" class="btn btn-secondary w-100 mb-2" id="btn-appointment" target="_blank">Prendre rendez-vous</a>
                                        <a href="/contactus" class="btn btn-danger w-100" id="btn-reserve" target="_blank">Réserver ce box</a>
                                        <small class="text-muted d-block mt-2">Frais: <span id="detail-registration-fee"></span> | Caution: <span id="detail-deposit"></span></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="oe_structure" id="storage_plan_footer"></div>
            </div>
        </t>
    </template>
</odoo>
