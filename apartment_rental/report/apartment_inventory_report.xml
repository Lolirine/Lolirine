<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inventory Report Action -->
    <record id="action_report_apartment_inventory" model="ir.actions.report">
        <field name="name">État des lieux</field>
        <field name="model">apartment.inventory</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">apartment_rental.report_apartment_inventory</field>
        <field name="report_file">apartment_rental.report_apartment_inventory</field>
        <field name="print_report_name">'État des lieux - %s - %s' % (object.name, object.date.strftime('%d-%m-%Y'))</field>
        <field name="binding_model_id" ref="model_apartment_inventory"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Comparison Report Action -->
    <record id="action_report_apartment_inventory_comparison" model="ir.actions.report">
        <field name="name">Comparaison entrée/sortie</field>
        <field name="model">apartment.inventory</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">apartment_rental.report_apartment_inventory_comparison</field>
        <field name="report_file">apartment_rental.report_apartment_inventory_comparison</field>
        <field name="print_report_name">'Comparaison état des lieux - %s' % object.lease_id.name</field>
        <field name="binding_model_id" ref="model_apartment_inventory"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
