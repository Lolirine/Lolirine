<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu racine -->
    <menuitem id="menu_storage_indexation_root"
              name="Indexation"
              web_icon="storage_indexation,static/description/icon.png"
              sequence="45"
              groups="storage_indexation.group_storage_indexation_user"/>

    <!-- Menu principal - Indexations -->
    <menuitem id="menu_storage_indexation_main"
              name="Indexations"
              parent="menu_storage_indexation_root"
              sequence="10"/>

    <menuitem id="menu_storage_indexation_list"
              name="Toutes les indexations"
              parent="menu_storage_indexation_main"
              action="action_storage_indexation"
              sequence="10"/>

    <menuitem id="menu_storage_indexation_new"
              name="Nouvelle indexation"
              parent="menu_storage_indexation_main"
              action="action_storage_indexation_wizard"
              sequence="20"
              groups="storage_indexation.group_storage_indexation_manager"/>

    <!-- Menu - Indices de prix -->
    <menuitem id="menu_storage_price_index"
              name="Indices de prix"
              parent="menu_storage_indexation_root"
              action="action_storage_price_index"
              sequence="20"/>

    <!-- Menu - Rapports -->
    <menuitem id="menu_storage_indexation_reports"
              name="Rapports"
              parent="menu_storage_indexation_root"
              sequence="30"/>

    <menuitem id="menu_storage_indexation_line_report"
              name="Détails des indexations"
              parent="menu_storage_indexation_reports"
              action="action_storage_indexation_line"
              sequence="10"/>

    <!-- Menu - Configuration -->
    <menuitem id="menu_storage_indexation_config"
              name="Configuration"
              parent="menu_storage_indexation_root"
              sequence="100"
              groups="storage_indexation.group_storage_indexation_manager"/>

    <menuitem id="menu_storage_indexation_settings"
              name="Paramètres"
              parent="menu_storage_indexation_config"
              action="base.action_res_company_form"
              sequence="10"/>
