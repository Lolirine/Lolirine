<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================= -->
    <!-- ABONNEMENT - EXTENSION FORMULAIRE -->
    <!-- ============================================= -->
    <record id="view_sale_order_form_email_auto" model="ir.ui.view">
        <field name="name">sale.order.form.email.auto</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="arch" type="xml">
            <!-- Ajouter le champ dans la section récurrence ou autre info -->
            <xpath expr="//group[@name='technical']" position="inside">
                <field name="auto_send_invoice_email" 
                       string="📧 Envoi email factures auto"
                       help="Les factures générées par cet abonnement seront envoyées automatiquement par email à leur date de facturation"/>
            </xpath>
        </field>
    </record>
    
    <!-- Fallback si la vue principale n'existe pas -->
    <record id="view_sale_order_form_email_auto_fallback" model="ir.ui.view">
        <field name="name">sale.order.form.email.auto.fallback</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//group[@name='sale_info']" position="after">
                <group string="📧 Envoi Email" invisible="not is_subscription">
                    <field name="auto_send_invoice_email" 
                           string="Envoi email factures auto"/>
                </group>
            </xpath>
        </field>
    </record>
    
</odoo>
