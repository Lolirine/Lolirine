<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_invoice_reminder_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.form</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <form string="Relance">
                <header>
                    <button name="action_send_reminder" 
                            string="Envoyer par email" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'draft'"
                            icon="fa-paper-plane"/>
                    
                    <button name="action_open_composer" 
                            string="Previsualiser" 
                            type="object"
                            invisible="state != 'draft'"
                            icon="fa-eye"/>
                    
                    <button name="action_mark_paid" 
                            string="Marquer payee" 
                            type="object" 
                            class="btn-success"
                            invisible="state not in ('draft', 'sent')"
                            icon="fa-check"/>
                    
                    <button name="action_cancel" 
                            string="Annuler" 
                            type="object"
                            invisible="state not in ('draft', 'sent')"
                            icon="fa-times"/>
                    
                    <button name="action_reset_draft" 
                            string="Remettre en brouillon" 
                            type="object"
                            invisible="state not in ('sent', 'cancelled')"
                            icon="fa-undo"/>
                    
                    <button name="action_create_next_reminder" 
                            string="Relance suivante" 
                            type="object"
                            class="btn-warning"
                            invisible="state != 'sent' or reminder_type == 'formal_notice'"
                            icon="fa-forward"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,paid"/>
                </header>
                
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="not auto_generated">
                        Cette relance a ete generee automatiquement par le systeme.
                    </div>
                    
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o">
                            <span class="o_stat_text">Voir Facture</span>
                        </button>
                    </div>
                    
                    <group>
                        <group string="Relance">
                            <field name="invoice_id" options="{'no_create': True}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="reminder_type"/>
                            <field name="date"/>
                            <field name="auto_generated" invisible="1"/>
                        </group>
                        <group string="Montants">
                            <field name="amount_due"/>
                            <field name="days_overdue"/>
                            <field name="penalty_amount"/>
                            <field name="total_due"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <group string="Envoi">
                        <group>
                            <field name="send_date" readonly="1"/>
                            <field name="email_sent" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Notes internes..."/>
                    </group>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <record id="view_invoice_reminder_tree" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.tree</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <list string="Relances" decoration-muted="state == 'cancelled'" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="reminder_type"/>
                <field name="date"/>
                <field name="amount_due" sum="Total"/>
                <field name="days_overdue"/>
                <field name="state"/>
                <field name="auto_generated" optional="hide"/>
                <field name="send_date" optional="hide"/>
            </list>
        </field>
    </record>
    
    <record id="view_invoice_reminder_search" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.search</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <search string="Rechercher">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_sent" string="Envoyees" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_paid" string="Payees" domain="[('state', '=', 'paid')]"/>
                <group string="Grouper par">
                    <filter name="group_state" string="Etat" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record id="view_invoice_reminder_config_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.config.form</field>
        <field name="model">lolirine.invoice.reminder.config</field>
        <field name="arch" type="xml">
            <form string="Configuration des relances">
                <sheet>
                    <group>
                        <group string="Delais (jours)">
                            <field name="reminder_1_days"/>
                            <field name="reminder_2_days"/>
                            <field name="reminder_3_days"/>
                            <field name="formal_notice_days"/>
                        </group>
                        <group string="Parametres">
                            <field name="penalty_rate"/>
                            <field name="auto_reminder"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <group invisible="not auto_reminder">
                        <button name="action_test_auto_reminder" 
                                string="Tester auto-relance maintenant" 
                                type="object" 
                                class="btn-primary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_invoice_reminders" model="ir.actions.act_window">
        <field name="name">Relances</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
    </record>
    
    <record id="action_invoice_reminders_to_send" model="ir.actions.act_window">
        <field name="name">Relances a envoyer</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
    </record>
    
    <record id="action_invoice_reminders_sent" model="ir.actions.act_window">
        <field name="name">Relances en attente</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent')]</field>
    </record>
    
    <record id="action_invoice_reminder_config" model="ir.actions.act_window">
        <field name="name">Configuration relances</field>
        <field name="res_model">lolirine.invoice.reminder.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
