<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ============================================ -->
    <!-- RAPPORT: BON DE COMMANDE DROPSHIPPING -->
    <!-- ============================================ -->

    <template id="report_dropship_purchase_order_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="doc"/>
            <t t-set="lang" t-value="doc.partner_id.lang"/>
            
            <div class="page">
                <!-- Header avec badge dropshipping -->
                <div class="row mb-4">
                    <div class="col-8">
                        <h2>
                            <span>Commande Dropshipping</span>
                            <span t-field="o.name"/>
                        </h2>
                    </div>
                    <div class="col-4 text-end">
                        <span class="badge bg-warning text-dark" style="font-size: 1.2em;">
                            DROPSHIP
                        </span>
                    </div>
                </div>
                
                <!-- Informations principales -->
                <div class="row mb-4">
                    <div class="col-6">
                        <strong>Fournisseur:</strong><br/>
                        <div t-field="o.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Date commande:</strong></td>
                                <td t-field="o.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                            </tr>
                            <tr>
                                <td><strong>Notre référence:</strong></td>
                                <td t-field="o.name"/>
                            </tr>
                            <tr t-if="o.supplier_order_ref">
                                <td><strong>Votre référence:</strong></td>
                                <td t-field="o.supplier_order_ref"/>
                            </tr>
                            <tr t-if="o.dropship_sale_id">
                                <td><strong>Commande client:</strong></td>
                                <td t-field="o.dropship_sale_id.name"/>
                            </tr>
                        </table>
                    </div>
                </div>
                
                <!-- ALERTE DROPSHIPPING -->
                <div class="alert alert-warning mb-4" style="border: 2px solid #ffc107;">
                    <h4 class="alert-heading">
                        <i class="fa fa-exclamation-triangle"/> LIVRAISON DIRECTE CLIENT
                    </h4>
                    <p class="mb-0">
                        Cette commande doit être expédiée directement à l'adresse ci-dessous.
                        <strong>Ne pas livrer à notre adresse.</strong>
                    </p>
                </div>
                
                <!-- Adresse de livraison -->
                <div class="row mb-4" t-if="o.dest_address_id">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <strong>📦 ADRESSE DE LIVRAISON (CLIENT FINAL)</strong>
                            </div>
                            <div class="card-body">
                                <div t-field="o.dest_address_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'
                                     style="font-size: 1.1em;"/>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Détail des produits -->
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Description</th>
                            <th class="text-center">Quantité</th>
                            <th class="text-end">Prix unitaire</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.order_line" t-as="line">
                            <td>
                                <span t-field="line.product_id.default_code"/>
                                <t t-if="line.supplier_product_ref">
                                    <br/><small class="text-muted">Réf. fourn: <t t-esc="line.supplier_product_ref"/></small>
                                </t>
                            </td>
                            <td t-field="line.name"/>
                            <td class="text-center" t-field="line.product_qty"/>
                            <td class="text-end" t-field="line.price_unit"/>
                            <td class="text-end" t-field="line.price_subtotal"/>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end"><strong>Total HT</strong></td>
                            <td class="text-end"><strong t-field="o.amount_untaxed"/></td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end">TVA</td>
                            <td class="text-end" t-field="o.amount_tax"/>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-end"><strong>Total TTC</strong></td>
                            <td class="text-end"><strong t-field="o.amount_total"/></td>
                        </tr>
                    </tfoot>
                </table>
                
                <!-- Instructions -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-secondary text-white">
                                <strong>📝 INSTRUCTIONS</strong>
                            </div>
                            <div class="card-body">
                                <ul class="mb-0">
                                    <li><strong>Emballage neutre obligatoire</strong> - Aucune mention de votre société</li>
                                    <li><strong>Ne pas inclure de facture</strong> dans le colis</li>
                                    <li><strong>Communiquer le numéro de suivi</strong> dès expédition</li>
                                </ul>
                                <t t-if="o.notes">
                                    <hr/>
                                    <strong>Notes additionnelles:</strong>
                                    <p t-field="o.notes"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </t>
    </template>

    <record id="action_report_dropship_purchase_order" model="ir.actions.report">
        <field name="name">BC Dropshipping</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_pool_dropship.report_dropship_purchase_order_document</field>
        <field name="report_file">lolirine_pool_dropship.report_dropship_purchase_order_document</field>
        <field name="print_report_name">'BC_Dropship_%s' % (object.name).replace('/','_')</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============================================ -->
    <!-- RAPPORT: ANALYSE DES MARGES -->
    <!-- ============================================ -->

    <template id="report_dropship_margin_analysis">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Analyse des marges Dropshipping</h2>
                    <p>Période: <t t-esc="data.get('date_from')"/> - <t t-esc="data.get('date_to')"/></p>
                    
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Fournisseur</th>
                                <th class="text-end">CA Ventes</th>
                                <th class="text-end">Coût fournisseur</th>
                                <th class="text-end">Marge</th>
                                <th class="text-end">Marge %</th>
                                <th class="text-center">Nb commandes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data.get('suppliers', [])" t-as="supplier">
                                <td t-esc="supplier['name']"/>
                                <td class="text-end" t-esc="supplier['sales']" t-options='{"widget": "monetary"}'/>
                                <td class="text-end" t-esc="supplier['costs']" t-options='{"widget": "monetary"}'/>
                                <td class="text-end" t-esc="supplier['margin']" t-options='{"widget": "monetary"}'/>
                                <td class="text-end"><t t-esc="supplier['margin_percent']"/>%</td>
                                <td class="text-center" t-esc="supplier['orders']"/>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>TOTAL</td>
                                <td class="text-end" t-esc="data.get('total_sales')" t-options='{"widget": "monetary"}'/>
                                <td class="text-end" t-esc="data.get('total_costs')" t-options='{"widget": "monetary"}'/>
                                <td class="text-end" t-esc="data.get('total_margin')" t-options='{"widget": "monetary"}'/>
                                <td class="text-end"><t t-esc="data.get('total_margin_percent')"/>%</td>
                                <td class="text-center" t-esc="data.get('total_orders')"/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

</data>
</odoo>
