<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="storage_chat_widget_template" name="Storage Chat Widget" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <t t-set="st_ws_id" t-value="request.env['ir.config_parameter'].sudo().get_param('lolirine_storage_chat.website_id', '0')" />
            <t t-if="st_ws_id == '0' or str(website.id) == st_ws_id">
                <div id="lolirine-storage-chat-root">
                    <link rel="stylesheet" type="text/css" href="/lolirine_storage_chat/static/src/css/storage_chat_widget.css" />
                    <script type="text/javascript" src="/lolirine_storage_chat/static/src/js/storage_chat_widget.js"> </script>
                </div>
            </t>
        </xpath>
    </template>
</odoo>