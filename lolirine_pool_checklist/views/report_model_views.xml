<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Séquence ══ -->
    <record id="seq_pool_checklist_report" model="ir.sequence">
        <field name="name">Fiche de visite piscine</field>
        <field name="code">pool.checklist.report</field>
        <field name="prefix">LPS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- ══ Vue liste ══ -->
    <record id="view_pool_checklist_list" model="ir.ui.view">
        <field name="name">pool.checklist.report.list</field>
        <field name="model">pool.checklist.report</field>
        <field name="arch" type="xml">
            <list string="Fiches de visite" decoration-success="state=='done'"
                  decoration-muted="state=='archived'" decoration-warning="items_action>0">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="client_name" optional="show"/>
                <field name="intervention_type"/>
                <field name="technician_id"/>
                <field name="items_total"/>
                <field name="items_ok"/>
                <field name="items_warning" optional="show"/>
                <field name="items_action" optional="show"/>
                <field name="completion_pct" widget="progressbar"/>
                <field name="estimate_total" optional="show" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge"
                       decoration-success="state=='done'"
                       decoration-warning="state=='draft'"
                       decoration-muted="state=='archived'"/>
                <field name="sale_order_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ══ Vue formulaire ══ -->
    <record id="view_pool_checklist_form" model="ir.ui.view">
        <field name="name">pool.checklist.report.form</field>
        <field name="model">pool.checklist.report</field>
        <field name="arch" type="xml">
            <form string="Fiche de visite chantier">
                <header>
                    <button name="action_validate" string="Valider" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Remettre en brouillon" type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_view_sale_order" string="Voir le devis" type="object"
                            invisible="not sale_order_id" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="display_name" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Client &amp; chantier">
                            <field name="partner_id" options="{'no_create_edit': False}"/>
                            <field name="client_name" placeholder="Si pas encore dans les contacts"/>
                            <field name="address"/>
                            <field name="tel"/>
                        </group>
                        <group string="Intervention">
                            <field name="intervention_type"/>
                            <field name="plan_type"/>
                            <field name="date"/>
                            <field name="technician_id"/>
                            <field name="ref_dossier"/>
                        </group>
                    </group>
                    <group string="Statistiques">
                        <group>
                            <field name="items_total"/>
                            <field name="items_ok"/>
                            <field name="items_warning"/>
                            <field name="items_action"/>
                        </group>
                        <group>
                            <field name="completion_pct" widget="progressbar"/>
                            <field name="estimate_total"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Remarques générales de visite…"/>
                        </page>
                        <page string="Données techniques">
                            <field name="checklist_data" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══ Vue recherche ══ -->
    <record id="view_pool_checklist_search" model="ir.ui.view">
        <field name="name">pool.checklist.report.search</field>
        <field name="model">pool.checklist.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="client_name"/>
                <field name="technician_id"/>
                <field name="intervention_type"/>
                <field name="ref_dossier"/>
                <filter name="draft"    string="Brouillons"  domain="[('state','=','draft')]"/>
                <filter name="done"     string="Validées"    domain="[('state','=','done')]"/>
                <filter name="my"       string="Mes fiches"  domain="[('technician_id','=',uid)]"/>
                <filter name="actions"  string="Actions requises" domain="[('items_action','>',0)]"/>
                <separator/>
                <filter name="this_month" string="Ce mois"
                        domain="[('date','&gt;=', (context_today()+relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Grouper par">
                    <filter name="by_type"  string="Type d'intervention" context="{'group_by':'intervention_type'}"/>
                    <filter name="by_tech"  string="Technicien"          context="{'group_by':'technician_id'}"/>
                    <filter name="by_month" string="Mois"                context="{'group_by':'date:month'}"/>
                    <filter name="by_state" string="État"                context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══ Action fenêtre ══ -->
    <record id="action_pool_checklist_report" model="ir.actions.act_window">
        <field name="name">Fiches de visite piscine</field>
        <field name="res_model">pool.checklist.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pool_checklist_search"/>
        <field name="context">{'search_default_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune fiche de visite pour le moment
            </p>
            <p>Les fiches créées depuis la page <a href="/visite-chantier">/visite-chantier</a> apparaissent ici.</p>
        </field>
    </record>

</odoo>
