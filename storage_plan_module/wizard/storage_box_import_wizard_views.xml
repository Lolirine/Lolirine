<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire du wizard d'import -->
    <record id="view_storage_box_import_wizard_form" model="ir.ui.view">
        <field name="name">storage.box.import.wizard.form</field>
        <field name="model">storage.box.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer des boxes">
                <group>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </group>
                <separator string="Instructions"/>
                <div class="alert alert-info" role="alert">
                    <p><strong>Format attendu :</strong></p>
                    <p>Le fichier XLSX doit contenir les colonnes suivantes :</p>
                    <ul>
                        <li><strong>Nom du Box</strong> (obligatoire) : Identifiant unique du box</li>
                        <li><strong>Étage</strong> (obligatoire pour nouveaux boxes) : Nom de l'étage</li>
                        <li><strong>Code Étage</strong> : Code de l'étage (RDC, R1, etc.)</li>
                        <li><strong>Largeur (cm)</strong>, <strong>Profondeur (cm)</strong>, <strong>Hauteur (cm)</strong></li>
                        <li><strong>Prix Mensuel (€)</strong>, <strong>Frais Dossier (€)</strong>, <strong>Caution (mois)</strong></li>
                        <li><strong>Statut</strong> : disponible, occupe, maintenance, reserve, etc.</li>
                        <li><strong>Date Disponibilité</strong> : Format YYYY-MM-DD</li>
                        <li><strong>Allée</strong> : left ou right</li>
                        <li><strong>Description</strong>, <strong>Actif</strong> (Oui/Non)</li>
                    </ul>
                    <p class="mb-0">
                        <button name="action_download_template" type="object" class="btn btn-link p-0">
                            <i class="fa fa-download"/> Télécharger un modèle avec les données actuelles
                        </button>
                    </p>
                    <p class="mb-0 mt-2">
                        <a href="/storage/boxes/export/xlsx" target="_blank" class="btn btn-link p-0">
                            <i class="fa fa-file-excel-o"/> Exporter tous les boxes (XLSX)
                        </a>
                    </p>
                </div>
                <footer>
                    <button name="action_import" string="Importer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action pour ouvrir le wizard d'import -->
    <record id="action_storage_box_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer des boxes (XLSX)</field>
        <field name="res_model">storage.box.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
