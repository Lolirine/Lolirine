<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vapid_setup_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.vapid.setup.wizard.form</field>
        <field name="model">lolirine.vapid.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer les clés VAPID">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>ℹ️ Prérequis :</strong>
                        Le paquet Python <code>pywebpush</code> doit être installé
                        (ajoutez-le dans <code>requirements.txt</code> à la racine du dépôt Git,
                        puis commitez pour que Odoo.sh le déploie).
                    </div>

                    <group string="Configuration">
                        <field name="vapid_email" string="Email de contact VAPID"/>
                    </group>

                    <group string="Clés générées" colspan="2">
                        <field name="vapid_public_key"
                               string="Clé publique"
                               readonly="1"
                               placeholder="(cliquez Générer)"/>
                        <field name="vapid_private_key"
                               string="Clé privée"
                               readonly="1"
                               password="True"
                               placeholder="(cliquez Générer)"/>
                    </group>

                    <div class="alert alert-success" role="alert"
                         invisible="state != 'saved'">
                        ✅ Clés sauvegardées. Rechargez le backend et accordez
                        la permission navigateur pour activer les Web Push.
                    </div>
                </sheet>
                <footer>
                    <button name="action_generate_keys"
                            type="object"
                            string="🔑 Générer"
                            class="btn btn-primary"/>
                    <button name="action_save_keys"
                            type="object"
                            string="💾 Sauvegarder"
                            class="btn btn-success"
                            invisible="not vapid_public_key"/>
                    <button string="Fermer"
                            class="btn btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vapid_setup_wizard" model="ir.actions.act_window">
        <field name="name">Assistant clés VAPID</field>
        <field name="res_model">lolirine.vapid.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vapid_setup_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
