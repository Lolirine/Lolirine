<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Modèle d'email pour l'envoi du contrat -->
        <record id="email_template_contract" model="mail.template">
            <field name="name">Contrat de Garde-Meubles</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="email_from">{{ (object.company_id.email or object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="subject">Votre contrat de garde-meubles – {{ object.name }}</field>
            <field name="body_html" type="html">
<![CDATA[
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Bonjour <t t-out="object.partner_id.name or ''">Cher Client</t>,
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Nous avons le plaisir de vous transmettre votre contrat de location de garde-meubles 
        référencé <strong><t t-out="object.name or ''">CTR/2025/XXX</t></strong>.
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        <strong>Récapitulatif de votre location :</strong>
    </p>
    <ul style="font-size: 13px;">
        <t t-foreach="object.order_line" t-as="line">
            <t t-if="line.product_id">
                <li><t t-out="line.product_id.name"/> - <t t-out="'%.2f' % line.price_subtotal"/> € / mois</li>
            </t>
        </t>
    </ul>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Vous trouverez en pièce jointe votre contrat de location au format PDF.
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        <strong>Prochaines étapes :</strong>
    </p>
    <ol style="font-size: 13px;">
        <li>Veuillez prendre connaissance du contrat ci-joint</li>
        <li>Effectuez le versement de la caution sur le compte indiqué</li>
        <li>Signez le contrat et renvoyez-le nous par email ou apportez-le lors du dépôt de vos effets</li>
    </ol>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        <t t-if="object.contract_access_code">
            <strong>Votre code d'accès personnel :</strong> <t t-out="object.contract_access_code"/><br/>
        </t>
        <t t-if="object.contract_forklift_code">
            <strong>Votre code gerbeur :</strong> <t t-out="object.contract_forklift_code"/><br/>
        </t>
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Pour toute question, n'hésitez pas à nous contacter.
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Cordialement,<br/>
        <strong>L'équipe Lolirine Garde-Meubles</strong>
    </p>
    <br/>
    <hr style="border: none; border-top: 1px solid #ccc;"/>
    <p style="margin: 0px; padding: 0px; font-size: 11px; color: #666;">
        Srl Lolirine<br/>
        Rue Bois D'Esneux 110 - B-5021 Boninne<br/>
        GSM: 0498/52.11.31 - 0497/44.41.46<br/>
        Email: gardemeublelolirine@gmail.com<br/>
        Web: www.lolirine.be
    </p>
</div>
]]>
            </field>
            <field name="report_template_ids" eval="[(4, ref('lolirine_contract.action_report_contract'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
