<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================= WIZARDS VIEWS ======================= -->
    
    <!-- Wizard réassignation image -->
    <record id="view_pool_catalog_image_reassign_wizard" model="ir.ui.view">
        <field name="name">pool.catalog.image.reassign.wizard.form</field>
        <field name="model">pool.catalog.image.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Réassigner l'image à un produit">
                <group>
                    <field name="image_id" readonly="1"/>
                    <field name="pdf_import_id" invisible="1"/>
                    <field name="current_product_id" readonly="1"/>
                    <field name="new_product_id" required="1"/>
                    <field name="confidence_score"/>
                </group>
                <group>
                    <field name="notes" placeholder="Raison de la réassignation..."/>
                </group>
                <footer>
                    <button string="Réassigner" name="action_reassign" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Wizard push vers production -->
    <record id="view_pool_catalog_image_push_wizard" model="ir.ui.view">
        <field name="name">pool.catalog.image.push.wizard.form</field>
        <field name="model">pool.catalog.image.push.wizard</field>
        <field name="arch" type="xml">
            <form string="Pousser les images vers la production">
                <group name="stats" string="Statistiques">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h4 class="text-info"><field name="total_products"/></h4>
                                    <p>Produits totaux</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h4 class="text-success"><field name="products_with_images"/></h4>
                                    <p>Avec images</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h4 class="text-warning"><field name="primary_images_count"/></h4>
                                    <p>Images principales</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h4 class="text-info"><field name="secondary_images_count"/></h4>
                                    <p>Images secondaires</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </group>
                
                <group name="options" string="Options">
                    <group>
                        <field name="create_missing_products"/>
                        <field name="overwrite_existing_images"/>
                    </group>
                    <group>
                        <field name="category_id" invisible="create_missing_products != True"/>
                        <field name="website_id"/>
                    </group>
                </group>
                
                <!-- Résultats après exécution -->
                <group name="results" string="Résultats" 
                       invisible="result_created_products == 0 and result_updated_products == 0 and not result_errors">
                    <div class="alert alert-success" role="alert"
                         invisible="result_created_products == 0 and result_updated_products == 0">
                        <strong>Push terminé !</strong><br/>
                        • <field name="result_created_products"/> produits créés<br/>
                        • <field name="result_updated_products"/> produits mis à jour
                    </div>
                    
                    <div class="alert alert-warning" role="alert" invisible="not result_errors">
                        <strong>Erreurs rencontrées :</strong><br/>
                        <field name="result_errors" readonly="1"/>
                    </div>
                </group>
                
                <footer>
                    <button string="🚀 Push vers production" name="action_push_to_production" 
                            type="object" class="btn-primary"
                            invisible="result_created_products > 0 or result_updated_products > 0"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Wizard attribution en masse -->
    <record id="view_pool_catalog_image_bulk_wizard" model="ir.ui.view">
        <field name="name">pool.catalog.image.bulk.wizard.form</field>
        <field name="model">pool.catalog.image.bulk.wizard</field>
        <field name="arch" type="xml">
            <form string="Attribution d'images en masse">
                <group name="action" string="Action à effectuer">
                    <field name="action_type" widget="radio"/>
                    <field name="quality_threshold" 
                           invisible="action_type != 'reject_low_quality'"/>
                </group>
                
                <group name="filters" string="Filtres">
                    <field name="filter_unassigned_only"/>
                </group>
                
                <div class="alert alert-info" role="alert">
                    <h6><strong>Description des actions :</strong></h6>
                    <ul class="mb-0">
                        <li><strong>Auto: Meilleure image → Principale</strong> : Pour chaque produit, 
                            l'image avec le meilleur score qualité devient l'image principale.</li>
                        <li><strong>Auto: Autres images → Secondaires</strong> : Toutes les images 
                            associées à un produit (sauf les principales) deviennent secondaires.</li>
                        <li><strong>Reset: Tout en non-attribué</strong> : Remet toutes les images 
                            sélectionnées en statut "Non attribuée".</li>
                        <li><strong>Rejeter: Score qualité &lt; seuil</strong> : Marque comme "Rejetées" 
                            les images avec un score qualité inférieur au seuil.</li>
                    </ul>
                </div>
                
                <footer>
                    <button string="Exécuter" name="action_execute_bulk" 
                            type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- ======================= ACTIONS WIZARDS ======================= -->
    
    <record id="action_pool_catalog_image_reassign_wizard" model="ir.actions.act_window">
        <field name="name">Réassigner image</field>
        <field name="res_model">pool.catalog.image.reassign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <record id="action_pool_catalog_image_push_wizard" model="ir.actions.act_window">
        <field name="name">Push vers production</field>
        <field name="res_model">pool.catalog.image.push.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <record id="action_pool_catalog_image_bulk_wizard" model="ir.actions.act_window">
        <field name="name">Attribution en masse</field>
        <field name="res_model">pool.catalog.image.bulk.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <!-- ======================= AJOUTS MENU & ACTIONS ======================= -->
    
    <!-- Action Push depuis la liste d'import -->
    <record id="view_pool_catalog_pdf_import_form_push_button" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.import.form.push.button</field>
        <field name="model">pool.catalog.pdf.import</field>
        <field name="inherit_id" ref="lolirine_pool_import_extended.view_pool_catalog_pdf_import_form_images"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_push_wizard" string="🚀 Push vers production"
                        type="object" class="btn-warning" 
                        invisible="image_count == 0"/>
                <button name="action_bulk_assign_wizard" string="Attribution en masse"
                        type="object" class="btn-info"
                        invisible="image_count == 0"/>
            </xpath>
        </field>
    </record>
    
    <!-- Méthodes pour ouvrir les wizards depuis l'import -->
    <record id="pool_catalog_pdf_import_wizard_methods" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.import.wizard.methods</field>
        <field name="model">pool.catalog.pdf.import</field>
        <field name="inherit_id" ref="lolirine_pool_import_extended.view_pool_catalog_pdf_import_form_images"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <script type="text/javascript">
                    // Méthodes JavaScript pour les wizards si besoin
                </script>
            </xpath>
        </field>
    </record>
</odoo>
