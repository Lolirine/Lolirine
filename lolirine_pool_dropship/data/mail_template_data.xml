<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================ -->
        <!-- TEMPLATES EMAIL CLIENT -->
        <!-- ============================================ -->

        <!-- Envoi du devis piscine au client -->
        <record id="email_template_dropship_quote" model="mail.template">
            <field name="name">Dropshipping: Devis piscine</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Lolirine Pool Store — Votre devis {{ object.dropship_ref or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="report_template_ids" eval="[(4, ref('sale.action_report_saleorder'))]"/>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #0078D4; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">&#127946; Lolirine Pool Store</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Suite à votre demande, nous avons le plaisir de vous transmettre notre devis pour votre projet piscine.</p>

        <div style="background: #f0f7ff; border-left: 4px solid #0078D4; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Référence devis :</strong> {{ object.dropship_ref or object.name }}</p>
            <p style="margin: 5px 0 0 0;"><strong>Montant total :</strong> {{ '%.2f' % object.amount_total }} € TTC</p>
            <p style="margin: 5px 0 0 0;"><strong>Validité :</strong> {{ object.validity_date or 'Non définie' }}</p>
        </div>

        <p>Vous trouverez ci-joint le détail complet de notre offre au format PDF.</p>

        <div style="background: #e8f5e9; padding: 15px; border-radius: 4px; margin: 20px 0;">
            <strong>&#128073; Prochaine étape :</strong><br/>
            Si ce devis vous convient, il vous suffit de nous confirmer votre accord par retour
            d'e-mail ou par téléphone et nous lancerons immédiatement la commande auprès de
            notre partenaire logistique.
        </div>

        <p>Pour toute question ou demande de modification : <strong>+32 (0)497 44 41 46</strong></p>

        <p style="margin-top: 25px;">Cordialement,<br/>
        <strong>L'équipe Lolirine Pool Store</strong><br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Confirmation commande dropship au client -->
        <record id="email_template_dropship_order_confirmed" model="mail.template">
            <field name="name">Dropshipping: Confirmation commande client</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Lolirine Pool Store — Confirmation de votre commande {{ object.dropship_ref or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="report_template_ids" eval="[(4, ref('sale.action_report_saleorder'))]"/>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #0078D4; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">&#128694; Lolirine Pool Store</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Nous avons bien reçu votre commande et nous vous en remercions !</p>

        <div style="background: #f0f7ff; border-left: 4px solid #0078D4; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Référence commande :</strong> {{ object.dropship_ref or object.name }}</p>
            <p style="margin: 5px 0 0 0;"><strong>Montant :</strong> {{ '%.2f' % object.amount_total }} € TTC</p>
        </div>

        <h3 style="color: #0078D4;">Prochaines étapes</h3>
        <ol style="line-height: 1.8;">
            <li>Commande confirmée et en cours de traitement</li>
            <li>Préparation et expédition par notre partenaire logistique</li>
            <li>Vous recevrez un email avec le numéro de suivi dès l'expédition</li>
            <li>Livraison à votre adresse</li>
        </ol>

        <div style="background: #fff3cd; padding: 12px; border-radius: 4px; margin: 15px 0;">
            <strong>Adresse de livraison :</strong><br/>
            {{ object.partner_shipping_id.name }}<br/>
            {{ object.partner_shipping_id.street or '' }}<br/>
            {{ object.partner_shipping_id.zip or '' }} {{ object.partner_shipping_id.city or '' }}<br/>
            {{ object.partner_shipping_id.country_id.name or '' }}
        </div>

        <p>Pour toute question, contactez-nous : <strong>+32 (0)497 44 41 46</strong></p>

        <p style="margin-top: 25px;">Cordialement,<br/>
        <strong>L'équipe Lolirine Pool Store</strong><br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Notification commande en préparation -->
        <record id="email_template_dropship_po_sent" model="mail.template">
            <field name="name">Dropshipping: Commande en préparation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre commande {{ object.dropship_ref or object.name }} est en préparation</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #0078D4; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Lolirine Pool Store</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Votre commande <strong>{{ object.dropship_ref or object.name }}</strong> a été transmise à notre partenaire logistique pour préparation.</p>
        <div style="background: #d4edda; border-left: 4px solid #28a745; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Statut :</strong> En préparation</p>
            <p style="margin: 5px 0 0 0;">Vous recevrez un email avec le numéro de suivi dès que votre commande sera expédiée.</p>
        </div>
        <p>Cordialement,<br/><strong>L'équipe Lolirine Pool Store</strong></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Notification expédition avec tracking -->
        <record id="email_template_dropship_shipped" model="mail.template">
            <field name="name">Dropshipping: Notification expédition</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre commande {{ object.dropship_ref or object.name }} a été expédiée</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #28a745; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Commande expédiée !</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Bonne nouvelle ! Votre commande <strong>{{ object.dropship_ref or object.name }}</strong> vient d'être expédiée.</p>
        <div style="background: #f0f7ff; border-left: 4px solid #0078D4; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
            <p style="margin: 0;"><strong>Référence :</strong> {{ object.dropship_ref or object.name }}</p>
        </div>
        <div style="background: #fff3cd; padding: 12px; border-radius: 4px; margin: 15px 0;">
            <strong>Livraison prévue à :</strong><br/>
            {{ object.partner_shipping_id.name }}<br/>
            {{ object.partner_shipping_id.street or '' }}<br/>
            {{ object.partner_shipping_id.zip or '' }} {{ object.partner_shipping_id.city or '' }}
        </div>
        <p>Cordialement,<br/><strong>L'équipe Lolirine Pool Store</strong><br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Notification livraison -->
        <record id="email_template_dropship_delivered" model="mail.template">
            <field name="name">Dropshipping: Confirmation livraison</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre commande {{ object.dropship_ref or object.name }} a été livrée</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #28a745; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Commande livrée !</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Votre commande <strong>{{ object.dropship_ref or object.name }}</strong> a été livrée avec succès.</p>
        <p>Si vous avez la moindre question, n'hésitez pas à nous contacter.</p>
        <p>Merci pour votre confiance !<br/>
        <strong>L'équipe Lolirine Pool Store</strong><br/>
        +32 (0)497 44 41 46<br/>
        <a href="https://www.lolirinepoolstore.be">www.lolirinepoolstore.be</a></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Notification problème -->
        <record id="email_template_dropship_issue" model="mail.template">
            <field name="name">Dropshipping: Notification problème</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Information sur votre commande {{ object.dropship_ref or object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <div style="background: #dc3545; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 22px;">Information importante</h1>
    </div>
    <div style="padding: 25px; border: 1px solid #e0e0e0; border-top: none;">
        <p>Bonjour <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>Nous vous contactons au sujet de votre commande <strong>{{ object.dropship_ref or object.name }}</strong>.</p>
        <p>Un point nécessite notre attention. Notre équipe traite la situation dans les meilleurs délais.</p>
        <p>Pour toute question urgente : <strong>+32 (0)497 44 41 46</strong></p>
        <p>Cordialement,<br/><strong>L'équipe Lolirine Pool Store</strong></p>
    </div>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ============================================ -->
        <!-- TEMPLATE EMAIL FOURNISSEUR -->
        <!-- ============================================ -->

        <record id="email_template_dropship_po" model="mail.template">
            <field name="name">Dropshipping: Commande fournisseur</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Commande Dropshipping {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.dropship_order_email or object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<p>Bonjour,</p>
<p>Veuillez trouver ci-dessous notre commande <strong>{{ object.name }}</strong>.</p>
<p><strong>LIVRAISON DIRECTE AU CLIENT FINAL :</strong></p>
<div style="background: #fff3cd; padding: 12px; border-radius: 4px; margin: 10px 0;">
    <strong>{{ object.dest_address_id.name }}</strong><br/>
    {{ object.dest_address_id.street or '' }}<br/>
    {{ object.dest_address_id.zip or '' }} {{ object.dest_address_id.city or '' }}<br/>
    {{ object.dest_address_id.country_id.name or '' }}
</div>
<p><strong>EMBALLAGE NEUTRE REQUIS — NE PAS INCLURE DE FACTURE DANS LE COLIS</strong></p>
<p>Merci de confirmer la réception et le délai de livraison estimé.</p>
<p>Cordialement,<br/>{{ object.company_id.name }}</p>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
