<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ai_chat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai_chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Assistant IA" string="Assistant IA" data-key="lolirine_ai_chat">
                    <block title="Configuration API" name="ai_api_settings">
                        <setting string="Clé API Anthropic"
                                 help="Votre clé API Anthropic pour accéder à Claude. Obtenez-la sur console.anthropic.com">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="ai_chat_api_key" password="True" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Modèle IA"
                                 help="Choisissez le modèle Claude à utiliser">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_model" class="col-lg-3 o_light_label"/>
                                    <field name="ai_chat_model" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Tokens max par réponse"
                                 help="Nombre maximum de tokens dans la réponse de l'IA">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_max_tokens" class="col-lg-3 o_light_label"/>
                                    <field name="ai_chat_max_tokens" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Fonctionnalités" name="ai_features">
                        <setting string="Chat IA actif"
                                 help="Activer ou désactiver le widget de chat sur le site">
                            <field name="ai_chat_enabled"/>
                        </setting>
                        <setting string="Recherche web"
                                 help="Permettre à l'IA de rechercher des informations sur le web">
                            <field name="ai_chat_web_search"/>
                        </setting>
                        <setting string="Recherche produits"
                                 help="L'IA peut chercher et recommander des produits de votre catalogue">
                            <field name="ai_chat_product_search"/>
                        </setting>
                        <setting string="Sauvegarder les conversations"
                                 help="Enregistrer l'historique des conversations pour analyse">
                            <field name="ai_chat_save_conversations"/>
                        </setting>
                    </block>

                    <block title="Prompt système" name="ai_prompt">
                        <setting string="Instructions IA"
                                 help="Personnalisez les instructions données à l'IA pour guider ses réponses">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="ai_chat_system_prompt" class="col-lg-10"
                                           widget="text" placeholder="Instructions pour l'assistant IA..."/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Apparence" name="ai_appearance">
                        <setting string="Message de bienvenue"
                                 help="Premier message affiché à l'ouverture du chat">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="ai_chat_welcome_message" class="col-lg-8"
                                           widget="text"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Couleurs"
                                 help="Personnalisez les couleurs du widget">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_primary_color" class="col-lg-3 o_light_label"/>
                                    <field name="ai_chat_primary_color" widget="color" class="col-lg-3"/>
                                </div>
                                <div class="row mt8">
                                    <label for="ai_chat_secondary_color" class="col-lg-3 o_light_label"/>
                                    <field name="ai_chat_secondary_color" widget="color" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Position"
                                 help="Où afficher le widget sur la page">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_position" class="col-lg-3 o_light_label"/>
                                    <field name="ai_chat_position" class="col-lg-4"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Limites" name="ai_limits">
                        <setting string="Messages max par session"
                                 help="Nombre maximum de messages qu'un visiteur peut envoyer par session">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_max_messages_per_session" class="col-lg-3 o_light_label"/>
                                    <field name="ai_chat_max_messages_per_session" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Messages max par jour/IP"
                                 help="Nombre maximum de messages par adresse IP par jour">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_max_messages_per_day_ip" class="col-lg-3 o_light_label"/>
                                    <field name="ai_chat_max_messages_per_day_ip" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
