<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="apartment_inventory_view_form" model="ir.ui.view">
        <field name="name">apartment.inventory.form</field>
        <field name="model">apartment.inventory</field>
        <field name="arch" type="xml">
            <form string="État des lieux">
                <header>
                    <button name="action_start" string="Démarrer" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Terminer" type="object" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_sign" string="Signer" type="object" class="btn-success" invisible="state != 'pending_signature'"/>
                    <button name="action_dispute" string="Contester" type="object" class="btn-warning" invisible="state != 'pending_signature'"/>
                    <button name="action_reset_draft" string="Remettre en brouillon" type="object" invisible="state == 'signed'"/>
                    <button name="action_print_report" string="Imprimer PDF" type="object" class="btn-secondary" icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,pending_signature,signed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_photos" type="object" class="oe_stat_button" icon="fa-camera">
                            <field name="photo_count" widget="statinfo" string="Photos"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Sortie" bg_color="text-bg-warning" invisible="inventory_type != 'exit'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations générales">
                            <field name="inventory_type"/>
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="lease_id" options="{'no_create': True}"/>
                            <field name="tenant_id" readonly="1"/>
                            <field name="date"/>
                        </group>
                        <group string="Présences">
                            <field name="tenant_present"/>
                            <field name="landlord_present"/>
                            <field name="conducted_by"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pièces" name="rooms">
                            <button name="action_add_rooms" string="Ajouter pièces standard" type="object" class="btn-secondary mb-3" invisible="line_ids"/>
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="room_type_id"/>
                                    <field name="name"/>
                                    <field name="condition"/>
                                    <field name="walls_condition"/>
                                    <field name="floor_condition"/>
                                    <field name="windows_condition"/>
                                </list>
                            </field>
                        </page>
                        <page string="Compteurs" name="meters">
                            <group>
                                <group string="Relevés">
                                    <field name="electricity_reading"/>
                                    <field name="gas_reading"/>
                                    <field name="water_reading"/>
                                    <field name="heating_reading"/>
                                </group>
                            </group>
                        </page>
                        <page string="Clés" name="keys">
                            <group>
                                <group>
                                    <field name="keys_count"/>
                                    <field name="keys_detail"/>
                                </group>
                                <group>
                                    <field name="remote_count"/>
                                    <field name="badge_count"/>
                                    <field name="mailbox_key"/>
                                    <field name="cellar_key"/>
                                    <field name="garage_key"/>
                                </group>
                            </group>
                        </page>
                        <page string="État général" name="general">
                            <group>
                                <group>
                                    <field name="general_condition"/>
                                    <field name="cleanliness"/>
                                </group>
                            </group>
                            <group string="Observations">
                                <field name="observations" nolabel="1" placeholder="Observations générales..."/>
                            </group>
                            <group string="Dégâts constatés">
                                <field name="damages_noted" nolabel="1" placeholder="Dégâts constatés..."/>
                            </group>
                            <group string="Réparations nécessaires">
                                <field name="repairs_needed" nolabel="1" placeholder="Réparations nécessaires..."/>
                                <field name="estimated_cost"/>
                            </group>
                        </page>
                        <page string="Comparaison" name="comparison" invisible="inventory_type != 'exit'">
                            <group>
                                <field name="entry_inventory_id"/>
                                <field name="comparison_notes" placeholder="Notes de comparaison..."/>
                                <field name="damages_chargeable" placeholder="Dégâts imputables au locataire..."/>
                            </group>
                        </page>
                        <page string="Signatures" name="signatures">
                            <group>
                                <group string="Locataire">
                                    <field name="tenant_signature" widget="image"/>
                                    <field name="tenant_signature_date"/>
                                </group>
                                <group string="Bailleur">
                                    <field name="landlord_signature" widget="image"/>
                                    <field name="landlord_signature_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Photos" name="photos">
                            <button name="%(apartment_inventory_photo_wizard_action)d" type="action" string="Importer des photos" icon="fa-upload" class="mb-3"/>
                            <field name="photo_ids"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="apartment_inventory_view_tree" model="ir.ui.view">
        <field name="name">apartment.inventory.tree</field>
        <field name="model">apartment.inventory</field>
        <field name="arch" type="xml">
            <list string="États des lieux" decoration-info="inventory_type == 'entry'" decoration-warning="inventory_type == 'exit'" decoration-danger="state == 'disputed'">
                <field name="name"/>
                <field name="inventory_type" widget="badge" decoration-info="inventory_type == 'entry'" decoration-warning="inventory_type == 'exit'"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="date"/>
                <field name="photo_count"/>
                <field name="state" widget="badge" decoration-success="state == 'signed'" decoration-warning="state == 'pending_signature'" decoration-danger="state == 'disputed'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="apartment_inventory_view_search" model="ir.ui.view">
        <field name="name">apartment.inventory.search</field>
        <field name="model">apartment.inventory</field>
        <field name="arch" type="xml">
            <search string="Rechercher un état des lieux">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <filter string="Entrée" name="entry" domain="[('inventory_type', '=', 'entry')]"/>
                <filter string="Sortie" name="exit" domain="[('inventory_type', '=', 'exit')]"/>
                <filter string="Brouillon" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="En cours" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="À signer" name="pending" domain="[('state', '=', 'pending_signature')]"/>
                <filter string="Signé" name="signed" domain="[('state', '=', 'signed')]"/>
                <filter string="Contesté" name="disputed" domain="[('state', '=', 'disputed')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="apartment_inventory_action" model="ir.actions.act_window">
        <field name="name">États des lieux</field>
        <field name="res_model">apartment.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="apartment_inventory_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez un état des lieux
            </p>
            <p>
                Documentez l'état du bien à l'entrée et à la sortie du locataire.
            </p>
        </field>
    </record>

    <!-- Inventory Line Form (popup) -->
    <record id="apartment_inventory_line_view_form" model="ir.ui.view">
        <field name="name">apartment.inventory.line.form</field>
        <field name="model">apartment.inventory.line</field>
        <field name="arch" type="xml">
            <form string="Détail pièce">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="room_type_id"/>
                            <field name="name"/>
                            <field name="condition"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Structure">
                            <group>
                                <group>
                                    <field name="walls_condition"/>
                                    <field name="walls_notes"/>
                                    <field name="walls_color"/>
                                </group>
                                <group>
                                    <field name="ceiling_condition"/>
                                    <field name="ceiling_notes"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="floor_condition"/>
                                    <field name="floor_type"/>
                                    <field name="floor_notes"/>
                                </group>
                                <group>
                                    <field name="windows_condition"/>
                                    <field name="windows_count"/>
                                    <field name="windows_notes"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="doors_condition"/>
                                    <field name="doors_notes"/>
                                </group>
                            </group>
                        </page>
                        <page string="Installations">
                            <group>
                                <group>
                                    <field name="electricity_condition"/>
                                    <field name="outlets_count"/>
                                    <field name="switches_count"/>
                                    <field name="electricity_notes"/>
                                </group>
                                <group>
                                    <field name="heating_condition"/>
                                    <field name="heating_type"/>
                                    <field name="heating_notes"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sanitaires">
                            <group>
                                <group>
                                    <field name="has_sink"/>
                                    <field name="sink_condition" invisible="not has_sink"/>
                                    <field name="has_toilet"/>
                                    <field name="toilet_condition" invisible="not has_toilet"/>
                                </group>
                                <group>
                                    <field name="has_shower"/>
                                    <field name="shower_condition" invisible="not has_shower"/>
                                    <field name="has_bathtub"/>
                                    <field name="bathtub_condition" invisible="not has_bathtub"/>
                                </group>
                            </group>
                        </page>
                        <page string="Cuisine">
                            <group>
                                <group>
                                    <field name="has_oven"/>
                                    <field name="oven_condition" invisible="not has_oven"/>
                                    <field name="oven_brand" invisible="not has_oven"/>
                                </group>
                                <group>
                                    <field name="has_cooktop"/>
                                    <field name="cooktop_condition" invisible="not has_cooktop"/>
                                    <field name="cooktop_type" invisible="not has_cooktop"/>
                                </group>
                                <group>
                                    <field name="has_hood"/>
                                    <field name="hood_condition" invisible="not has_hood"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
