<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== TRAJET VIEWS ==================== -->

    <!-- Form View -->
    <record id="km_trajet_view_form" model="ir.ui.view">
        <field name="name">km.trajet.form</field>
        <field name="model">km.trajet</field>
        <field name="arch" type="xml">
            <form string="Trajet">
                <header>
                    <button name="action_soumettre" string="Soumettre" type="object"
                            class="oe_highlight"
                            invisible="state != 'brouillon'"/>
                    <button name="action_valider" string="Valider" type="object"
                            class="oe_highlight"
                            invisible="state != 'soumis'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_refuser" string="Refuser" type="object"
                            invisible="state != 'soumis'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_creer_note_frais" string="Créer Note de Frais" type="object"
                            class="oe_highlight"
                            invisible="state != 'valide' or expense_id"/>
                    <button name="action_remettre_brouillon" string="Remettre en brouillon" type="object"
                            invisible="state in ('brouillon', 'rembourse')"/>
                    <button name="action_recalculer_bareme" string="Recalculer barème" type="object"
                            class="btn-secondary" icon="fa-refresh"
                            invisible="state == 'rembourse'"
                            confirm="Voulez-vous recalculer le barème et le montant de ce trajet ?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,soumis,valide,rembourse"/>
                </header>
                <sheet>
                    <!-- Alerte changement de trimestre -->
                    <field name="alerte_trimestre" nolabel="1" colspan="2" 
                           invisible="not alerte_trimestre" readonly="1"/>
                    
                    <!-- Badge comptabilisation -->
                    <div class="alert alert-success" role="alert" invisible="not comptabilise">
                        <i class="fa fa-check-circle"/> Trajet comptabilisé le <field name="date_comptabilisation" nolabel="1" readonly="1"/>
                    </div>
                    
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_note_frais" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not expense_id">
                            <field name="expense_id" widget="statinfo" string="Note de frais"/>
                        </button>
                        <button name="action_voir_facture" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not invoice_id">
                            <field name="invoice_id" widget="statinfo" string="Facture"/>
                        </button>
                        <button name="action_voir_ecriture_comptable" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not account_move_id">
                            <field name="account_move_id" widget="statinfo" string="Écriture"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <field name="origine_trajet" widget="badge" 
                               decoration-info="origine_trajet == 'manuel'"
                               decoration-success="origine_trajet in ('facture_fournisseur', 'facture_client')"
                               decoration-warning="origine_trajet in ('visite_box', 'signature_contrat', 'rdv_client')"
                               readonly="1"/>
                    </div>
                    <group>
                        <group string="Informations générales">
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="categorie_id" options="{'no_quick_create': False, 'no_create_edit': False}"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Véhicule">
                            <field name="type_vehicule_utilise" widget="radio"/>
                            <field name="vehicule_id"
                                   invisible="type_vehicule_utilise != 'parc'"
                                   required="type_vehicule_utilise == 'parc'"/>
                            <field name="vehicule_personnel_id"
                                   invisible="type_vehicule_utilise != 'personnel'"
                                   required="type_vehicule_utilise == 'personnel'"
                                   domain="[('employee_id', '=', employee_id)]"/>
                            <field name="puissance_fiscale"/>
                            <field name="type_vehicule_km"/>
                        </group>
                    </group>
                    <group>
                        <group string="Trajet">
                            <field name="use_predefined" widget="boolean_toggle"/>
                            <field name="lieu_depart_predef_id" 
                                   invisible="not use_predefined"
                                   required="use_predefined"
                                   options="{'no_create': True}"/>
                            <field name="destination_predef_id"
                                   invisible="not use_predefined"
                                   required="use_predefined"
                                   options="{'no_create': True}"/>
                            <div invisible="use_predefined" class="alert alert-info mb-2" role="alert">
                                <small><i class="fa fa-info-circle"/> Tapez votre adresse, des suggestions apparaîtront automatiquement.<br/>
                                Sélectionnez l'adresse correcte dans la liste pour une précision optimale.</small>
                            </div>
                            <field name="lieu_depart" 
                                   widget="address_autocomplete"
                                   invisible="use_predefined"
                                   required="not use_predefined"
                                   placeholder="Commencez à taper une adresse..."/>
                            <field name="lieu_arrivee" 
                                   widget="address_autocomplete"
                                   invisible="use_predefined"
                                   required="not use_predefined"
                                   placeholder="Commencez à taper une adresse..."/>
                            <field name="aller_retour"/>
                            <label for="distance_aller"/>
                            <div class="o_row">
                                <field name="distance_aller" class="oe_inline" placeholder="0.0"/>
                                <span class="oe_inline">km</span>
                                <button name="action_calculer_distance" type="object"
                                        string="Calculer via API" class="btn-secondary btn-sm ms-2"
                                        invisible="use_predefined"
                                        icon="fa-calculator"/>
                            </div>
                            <field name="distance"/>
                            <field name="distance_calculee" invisible="1"/>
                        </group>
                        <group string="Indemnité">
                            <field name="info_bareme" readonly="1" class="text-info"/>
                            <field name="bareme_id" options="{'no_create': True}"/>
                            <field name="taux_km"/>
                            <field name="montant_indemnite" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Motif du déplacement">
                        <field name="motif" nolabel="1" placeholder="Décrivez le motif professionnel de ce déplacement..."/>
                    </group>
                    <notebook>
                        <page string="Justificatifs" name="justificatifs">
                            <field name="justificatif_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes internes..."/>
                        </page>
                        <page string="Comptabilité" name="comptabilite">
                            <group>
                                <group string="Statut de comptabilisation">
                                    <field name="comptabilise" widget="boolean_toggle"/>
                                    <field name="date_comptabilisation" invisible="not comptabilise"/>
                                    <field name="account_move_id" invisible="not comptabilise"/>
                                </group>
                                <group string="Actions" invisible="not comptabilise">
                                    <button name="action_annuler_comptabilisation" 
                                            string="Annuler la comptabilisation" 
                                            type="object" 
                                            class="btn-secondary"
                                            confirm="Voulez-vous annuler la comptabilisation de ce trajet ?"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="km_trajet_view_tree" model="ir.ui.view">
        <field name="name">km.trajet.tree</field>
        <field name="model">km.trajet</field>
        <field name="arch" type="xml">
            <list string="Trajets" decoration-info="state == 'brouillon'"
                  decoration-warning="state == 'soumis'"
                  decoration-success="state in ('valide', 'rembourse')"
                  decoration-danger="state == 'refuse'">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id" optional="show"/>
                <field name="lieu_depart"/>
                <field name="lieu_arrivee"/>
                <field name="distance" sum="Total KM"/>
                <field name="categorie_id"/>
                <field name="origine_trajet" optional="hide" widget="badge"/>
                <field name="comptabilise" optional="hide" widget="boolean_toggle"/>
                <field name="montant_indemnite" sum="Total €" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'brouillon'"
                       decoration-warning="state == 'soumis'"
                       decoration-success="state in ('valide', 'rembourse')"
                       decoration-danger="state == 'refuse'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="km_trajet_view_kanban" model="ir.ui.view">
        <field name="name">km.trajet.kanban</field>
        <field name="model">km.trajet</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="date"/>
                <field name="lieu_depart"/>
                <field name="lieu_arrivee"/>
                <field name="distance"/>
                <field name="montant_indemnite"/>
                <field name="state"/>
                <field name="categorie_id"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'brouillon': 'info', 'soumis': 'warning', 'valide': 'success', 'refuse': 'danger', 'rembourse': 'success'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="date"/></div>
                                <div>
                                    <i class="fa fa-map-marker"/> 
                                    <field name="lieu_depart"/> → <field name="lieu_arrivee"/>
                                </div>
                                <div class="mt-2">
                                    <span class="badge text-bg-secondary">
                                        <field name="distance"/> km
                                    </span>
                                    <span class="badge text-bg-primary float-end">
                                        <field name="montant_indemnite" widget="monetary"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="categorie_id" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="km_trajet_view_calendar" model="ir.ui.view">
        <field name="name">km.trajet.calendar</field>
        <field name="model">km.trajet</field>
        <field name="arch" type="xml">
            <calendar string="Trajets" date_start="date" color="categorie_id" mode="month">
                <field name="lieu_depart"/>
                <field name="lieu_arrivee"/>
                <field name="distance"/>
            </calendar>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="km_trajet_view_pivot" model="ir.ui.view">
        <field name="name">km.trajet.pivot</field>
        <field name="model">km.trajet</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des Trajets">
                <field name="date" type="row" interval="month"/>
                <field name="categorie_id" type="col"/>
                <field name="distance" type="measure"/>
                <field name="montant_indemnite" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="km_trajet_view_graph" model="ir.ui.view">
        <field name="name">km.trajet.graph</field>
        <field name="model">km.trajet</field>
        <field name="arch" type="xml">
            <graph string="Analyse des Trajets" type="bar">
                <field name="date" type="row" interval="month"/>
                <field name="distance" type="measure"/>
                <field name="montant_indemnite" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Actions -->
    <record id="km_trajet_action" model="ir.actions.act_window">
        <field name="name">Trajets</field>
        <field name="res_model">km.trajet</field>
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creez votre premier trajet professionnel
            </p>
            <p>
                Enregistrez vos deplacements professionnels pour calculer automatiquement
                vos indemnites kilometriques.
            </p>
        </field>
    </record>

    <!-- Action serveur pour recalculer le bareme sur plusieurs trajets -->
    <record id="action_recalculer_bareme_multi" model="ir.actions.server">
        <field name="name">Recalculer le barème</field>
        <field name="model_id" ref="model_km_trajet"/>
        <field name="binding_model_id" ref="model_km_trajet"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_recalculer_bareme()
        </field>
    </record>

    <record id="km_trajet_action_a_valider" model="ir.actions.act_window">
        <field name="name">Trajets à valider</field>
        <field name="res_model">km.trajet</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('state', '=', 'soumis')]</field>
        <field name="context">{}</field>
    </record>

    <record id="km_trajet_action_non_comptabilises" model="ir.actions.act_window">
        <field name="name">Trajets non comptabilises</field>
        <field name="res_model">km.trajet</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('comptabilise', '=', False), ('state', '=', 'valide'), ('montant_indemnite', '>', 0)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun trajet valide en attente de comptabilisation
            </p>
        </field>
    </record>

    <record id="km_trajet_action_comptabilises" model="ir.actions.act_window">
        <field name="name">Trajets comptabilisés</field>
        <field name="res_model">km.trajet</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('comptabilise', '=', True)]</field>
        <field name="context">{}</field>
    </record>

    <!-- ==================== CATEGORIE VIEWS ==================== -->

    <record id="km_trajet_categorie_view_form" model="ir.ui.view">
        <field name="name">km.trajet.categorie.form</field>
        <field name="model">km.trajet.categorie</field>
        <field name="arch" type="xml">
            <form string="Catégorie">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="km_trajet_categorie_view_tree" model="ir.ui.view">
        <field name="name">km.trajet.categorie.tree</field>
        <field name="model">km.trajet.categorie</field>
        <field name="arch" type="xml">
            <list string="Catégories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="km_trajet_categorie_action" model="ir.actions.act_window">
        <field name="name">Catégories de trajets</field>
        <field name="res_model">km.trajet.categorie</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
