<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 
    Injection des données et boutons directement dans le footer de la page
    Ceci est plus fiable car website.layout est toujours présent
    -->
    <template id="storage_box_footer_inject" inherit_id="website.layout" name="Storage Box Footer Inject">
        <xpath expr="//footer" position="before">
            <!-- Script avec les données du produit (si on est sur une page produit) -->
            <t t-if="product and product.is_storage_box">
                <script type="application/json" id="lolirine_storage_data">
                    {
                        "is_storage_box": true,
                        "product_id": <t t-out="product.id"/>,
                        "storage_status": "<t t-out="product.storage_status"/>",
                        "storage_status_display": "<t t-out="product.storage_status_display"/>",
                        "show_badge": <t t-out="'true' if request.env['ir.config_parameter'].sudo().get_param('lolirine_storage.show_status_badge', 'False') == 'True' else 'false'"/>,
                        "show_appointment_button": <t t-out="'true' if product.show_appointment_button else 'false'"/>,
                        "show_general_inquiry_button": <t t-out="'true' if product.show_general_inquiry_button else 'false'"/>,
                        "appointment_url": "<t t-out="product.appointment_url or '/appointment'"/>",
                        "general_inquiry_url": "<t t-out="product.general_inquiry_url or '/contactus'"/>",
                        "appointment_button_label": "<t t-out="product.appointment_button_label or 'Contactez-nous'"/>",
                        "general_inquiry_button_label": "<t t-out="product.general_inquiry_button_label or 'Demande générale'"/>"
                    }
                </script>
            </t>
        </xpath>
    </template>

    <!-- Templates standalone pour référence -->
    <template id="storage_status_badge" name="Storage Status Badge">
        <t t-if="product and product.is_storage_box">
            <div class="storage-status-badge mb-2">
                <span t-if="product.storage_status == 'available'" 
                      class="badge text-bg-success">
                    <i class="fa fa-check-circle"/> Disponible
                </span>
                <span t-elif="product.storage_status == 'rented'" 
                      class="badge text-bg-danger">
                    <i class="fa fa-lock"/> Loué
                </span>
                <span t-elif="product.storage_status == 'reserved'" 
                      class="badge text-bg-warning">
                    <i class="fa fa-clock-o"/> Réservé
                </span>
                <span t-elif="product.storage_status == 'maintenance'" 
                      class="badge text-bg-secondary">
                    <i class="fa fa-wrench"/> En maintenance
                </span>
            </div>
        </t>
    </template>

</odoo>
