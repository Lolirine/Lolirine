<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liste des abonnements : colonne Box apres le client -->
    <record id="view_sale_subscription_tree_lolirine_box" model="ir.ui.view">
        <field name="name">sale.subscription.order.list.lolirine.box</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_box_names" string="Box" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Fiche contrat : box lies au client, cliquables -->
    <record id="view_sale_subscription_form_lolirine_box" model="ir.ui.view">
        <field name="name">sale.order.subscription.form.lolirine.box</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_box_ids" string="Box" widget="many2many_tags" readonly="1"
                       invisible="not x_box_ids"/>
            </xpath>
        </field>
    </record>

</odoo>
