<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== VEHICULE PERSONNEL VIEWS ==================== -->

    <!-- Form View -->
    <record id="km_vehicule_personnel_view_form" model="ir.ui.view">
        <field name="name">km.vehicule.personnel.form</field>
        <field name="model">km.vehicule.personnel</field>
        <field name="arch" type="xml">
            <form string="Véhicule Personnel">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-road" type="object"
                                name="action_voir_trajets" string="Trajets">
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ex: Peugeot 308"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations véhicule">
                            <field name="marque"/>
                            <field name="modele"/>
                            <field name="immatriculation"/>
                            <field name="date_mise_circulation"/>
                        </group>
                        <group string="Classification">
                            <field name="type_vehicule"/>
                            <field name="puissance_fiscale"/>
                            <field name="employee_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="km_vehicule_personnel_view_tree" model="ir.ui.view">
        <field name="name">km.vehicule.personnel.tree</field>
        <field name="model">km.vehicule.personnel</field>
        <field name="arch" type="xml">
            <list string="Véhicules Personnels">
                <field name="name"/>
                <field name="marque"/>
                <field name="modele"/>
                <field name="immatriculation"/>
                <field name="puissance_fiscale"/>
                <field name="type_vehicule"/>
                <field name="employee_id"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="km_vehicule_personnel_view_kanban" model="ir.ui.view">
        <field name="name">km.vehicule.personnel.kanban</field>
        <field name="model">km.vehicule.personnel</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="marque"/>
                <field name="modele"/>
                <field name="immatriculation"/>
                <field name="puissance_fiscale"/>
                <field name="employee_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="marque"/> <field name="modele"/></div>
                                <div><i class="fa fa-car"/> <field name="immatriculation"/></div>
                                <div class="mt-2">
                                    <span class="badge text-bg-info">
                                        <field name="puissance_fiscale"/> CV
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="km_vehicule_personnel_view_search" model="ir.ui.view">
        <field name="name">km.vehicule.personnel.search</field>
        <field name="model">km.vehicule.personnel</field>
        <field name="arch" type="xml">
            <search string="Rechercher Véhicules">
                <field name="name"/>
                <field name="immatriculation"/>
                <field name="marque"/>
                <field name="employee_id"/>
                <separator/>
                <filter name="mes_vehicules" string="Mes véhicules"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter name="group_employee" string="Propriétaire" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_puissance" string="Puissance" context="{'group_by': 'puissance_fiscale'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_vehicule'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="km_vehicule_personnel_action" model="ir.actions.act_window">
        <field name="name">Mes Véhicules</field>
        <field name="res_model">km.vehicule.personnel</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_mes_vehicules': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enregistrez votre premier véhicule personnel
            </p>
            <p>
                Ajoutez les véhicules personnels que vous utilisez pour vos déplacements professionnels
                afin de calculer automatiquement vos indemnités kilométriques.
            </p>
        </field>
    </record>

    <!-- ==================== FLEET.VEHICLE EXTENSION ==================== -->

    <!-- Extend fleet.vehicle form view -->
    <record id="fleet_vehicle_view_form_inherit_km" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.km</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_voir_trajets" type="object"
                        class="oe_stat_button" icon="fa-road">
                    <field name="nombre_trajets" widget="statinfo" string="Trajets"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='vehicle_group']" position="after">
                <group name="km_expense_group" string="Indemnités Kilométriques">
                    <field name="puissance_fiscale"/>
                    <field name="type_vehicule_km"/>
                    <field name="est_vehicule_personnel"/>
                    <field name="proprietaire_id" invisible="not est_vehicule_personnel"/>
                    <field name="total_km_professionnels"/>
                    <field name="total_indemnites"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
