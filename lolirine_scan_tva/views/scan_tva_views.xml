<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lolirine_scan_tva_form" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.form</field>
        <field name="model">lolirine.scan.tva</field>
        <field name="arch" type="xml">
            <form string="Scan TVA">
                <header>
                    <button name="action_scan_ocr" type="object" string="Extraire OCR" class="btn-primary" invisible="not document or state not in ('draft', 'scanned')"/>
                    <button name="action_manual_extract" type="object" string="Saisie manuelle" class="btn-secondary" invisible="state not in ('draft', 'scanned', 'extracted')"/>
                    <button name="action_validate" type="object" string="Valider" class="btn-primary" invisible="state != 'extracted'"/>
                    <button name="action_create_invoice" type="object" string="Creer facture" class="btn-primary" invisible="state != 'validated'"/>
                    <button name="action_view_invoice" type="object" string="Voir facture" invisible="state != 'invoiced'"/>
                    <button name="action_reset_draft" type="object" string="Brouillon" invisible="state in ('draft', 'invoiced')"/>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state in ('cancelled', 'invoiced')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scanned,extracted,validated,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_id">
                            <field name="invoice_id" widget="statinfo" string="Facture"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group string="Document">
                        <group>
                            <field name="document" filename="document_filename" widget="binary"/>
                            <field name="document_filename" invisible="1"/>
                            <field name="document_type"/>
                        </group>
                        <group>
                            <field name="document_preview" widget="image" options="{'size': [300, 400]}" invisible="not document"/>
                        </group>
                    </group>
                    <group string="Texte OCR" invisible="not ocr_text">
                        <field name="ocr_text" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Fournisseur">
                        <group>
                            <field name="supplier_vat"/>
                            <field name="partner_id"/>
                            <field name="partner_exists" invisible="1"/>
                            <field name="supplier_name"/>
                        </group>
                        <group>
                            <field name="supplier_street"/>
                            <field name="supplier_zip"/>
                            <field name="supplier_city"/>
                            <field name="supplier_country_id"/>
                            <field name="supplier_phone"/>
                            <field name="supplier_email"/>
                        </group>
                    </group>
                    <group string="Facture">
                        <group>
                            <field name="invoice_number"/>
                            <field name="invoice_date"/>
                            <field name="tax_rate"/>
                        </group>
                        <group>
                            <field name="amount_untaxed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Comptabilite">
                        <group>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <record id="view_lolirine_scan_tva_list" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.list</field>
        <field name="model">lolirine.scan.tva</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date"/>
                <field name="supplier_vat"/>
                <field name="supplier_name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    
    <record id="action_lolirine_scan_tva" model="ir.actions.act_window">
        <field name="name">Scans TVA</field>
        <field name="res_model">lolirine.scan.tva</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <record id="action_lolirine_scan_tva_new" model="ir.actions.act_window">
        <field name="name">Nouveau scan</field>
        <field name="res_model">lolirine.scan.tva.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <record id="view_partner_form_scan_tva" model="ir.ui.view">
        <field name="name">res.partner.form.scan.tva</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_scan_tva" type="object" class="oe_stat_button" icon="fa-qrcode" invisible="supplier_rank == 0">
                    <field name="scan_tva_count" widget="statinfo" string="Scans TVA"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
