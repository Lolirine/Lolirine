<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extension formulaire product.template : onglet Images Variantes -->
    <record id="view_product_template_variant_images_form" model="ir.ui.view">
        <field name="name">product.template.form.variant.images</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Images Variantes" name="variant_images"
                      invisible="product_variant_count &lt;= 1">
                    <group>
                        <group>
                            <field name="variant_images_configured" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_auto_assign_variant_images"
                                    type="object"
                                    string="Auto-assigner les images"
                                    class="btn btn-primary"
                                    icon="fa-picture-o"/>
                            <button name="action_distribute_images_round_robin"
                                    type="object"
                                    string="Distribuer"
                                    class="btn btn-secondary"
                                    icon="fa-random"/>
                            <button name="action_reset_variant_images"
                                    type="object"
                                    string="Reset"
                                    class="btn btn-outline-danger"
                                    icon="fa-trash"
                                    confirm="Supprimer toutes les assignations ?"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
