<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 
            NOTE: La création du website doit être faite manuellement dans Odoo
            car elle nécessite une configuration spécifique (domaine, etc.)
            
            Ce fichier crée uniquement les éléments de contenu.
        -->

        <!-- Liste de prix spécifique au site piscine -->
        <record id="pricelist_pool_public" model="product.pricelist">
            <field name="name">Tarif Public Piscine</field>
            <field name="currency_id" ref="base.EUR"/>
            <field name="sequence">50</field>
        </record>

        <!-- Attributs techniques piscine -->
        <record id="pool_attr_power" model="pool.product.attribute">
            <field name="name">Puissance</field>
            <field name="code">POWER</field>
            <field name="attribute_type">float</field>
            <field name="unit">W</field>
            <field name="show_on_website" eval="True"/>
            <field name="show_in_filter" eval="True"/>
        </record>

        <record id="pool_attr_flow_rate" model="pool.product.attribute">
            <field name="name">Débit</field>
            <field name="code">FLOW</field>
            <field name="attribute_type">float</field>
            <field name="unit">m³/h</field>
            <field name="show_on_website" eval="True"/>
            <field name="show_in_filter" eval="True"/>
        </record>

        <record id="pool_attr_pool_volume" model="pool.product.attribute">
            <field name="name">Volume piscine recommandé</field>
            <field name="code">VOLUME</field>
            <field name="attribute_type">char</field>
            <field name="unit">m³</field>
            <field name="show_on_website" eval="True"/>
            <field name="show_in_filter" eval="True"/>
        </record>

        <record id="pool_attr_warranty" model="pool.product.attribute">
            <field name="name">Garantie</field>
            <field name="code">WARRANTY</field>
            <field name="attribute_type">selection</field>
            <field name="selection_values">1 an
2 ans
3 ans
5 ans
10 ans</field>
            <field name="show_on_website" eval="True"/>
            <field name="show_in_filter" eval="True"/>
        </record>

        <record id="pool_attr_noise" model="pool.product.attribute">
            <field name="name">Niveau sonore</field>
            <field name="code">NOISE</field>
            <field name="attribute_type">float</field>
            <field name="unit">dB</field>
            <field name="show_on_website" eval="True"/>
        </record>

        <record id="pool_attr_energy_class" model="pool.product.attribute">
            <field name="name">Classe énergétique</field>
            <field name="code">ENERGY</field>
            <field name="attribute_type">selection</field>
            <field name="selection_values">A+++
A++
A+
A
B
C
D</field>
            <field name="show_on_website" eval="True"/>
            <field name="show_in_filter" eval="True"/>
        </record>

    </data>
</odoo>
