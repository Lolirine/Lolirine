<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         TEMPLATE QWEB — PDF NOTIFICATION D'INDEXATION
         Document officiel imprimable / téléchargeable pour envoyer au client
         ===================================================================== -->
    <template id="report_indexation_notice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.indexation_id.company_id or env.company"/>
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 11pt; padding: 0;">

                        <!-- ===== EN-TÊTE LOLIRINE AVEC LOGO ===== -->
                        <div style="border-bottom: 3px solid #C91E18; padding-bottom: 15px; margin-bottom: 30px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <!-- Logo société (gauche) -->
                                    <td style="width: 120px; vertical-align: top;">
                                        <img t-if="company.logo"
                                             t-att-src="image_data_uri(company.logo)"
                                             style="max-width: 120px; max-height: 80px;"
                                             alt="Logo Lolirine"/>
                                    </td>

                                    <!-- Coordonnées société (droite) -->
                                    <td style="vertical-align: top; text-align: right; padding-left: 20px;">
                                        <h2 style="margin: 0 0 5px 0; color: #C91E18; font-size: 18pt;">
                                            <span t-out="company.name or ''">Lolirine SRL</span>
                                        </h2>
                                        <div style="font-size: 9pt; color: #555; line-height: 1.5;">
                                            <span t-if="company.street" t-out="company.street"/>
                                            <span t-if="company.street2"> — <t t-out="company.street2"/></span>
                                            <br/>
                                            <span t-out="company.zip or ''"/>
                                            <span t-out="company.city or ''"/>
                                            <span t-if="company.country_id">, <t t-out="company.country_id.name"/></span>
                                            <br/>
                                            <span t-if="company.vat">TVA : <t t-out="company.vat"/><br/></span>
                                            <span style="color: #C91E18;">📧 gardemeublelolirine@gmail.com</span>
                                            <br/>
                                            <span style="color: #C91E18;">📞 0497 / 444 146</span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- ===== CONTENU DU DOCUMENT ===== -->

                        <!-- Référence et date -->
                        <div style="text-align: right; margin-bottom: 30px; font-size: 10pt; color: #666;">
                            <p style="margin: 0;">
                                Référence : <strong t-out="o.indexation_id.name or '-'">IDX/-/-</strong>
                            </p>
                            <p style="margin: 0;">
                                Boninne, le
                                <span t-out="(o.indexation_id.create_date and o.indexation_id.create_date.strftime('%d/%m/%Y')) or '-'">-</span>
                            </p>
                        </div>

                        <!-- Bloc destinataire -->
                        <div style="margin-bottom: 40px;">
                            <p style="margin: 0;">
                                <strong t-out="o.partner_id.name or ''">[Client]</strong>
                            </p>
                            <p style="margin: 0;" t-if="o.partner_id.street">
                                <span t-out="o.partner_id.street">-</span>
                            </p>
                            <p style="margin: 0;" t-if="o.partner_id.street2">
                                <span t-out="o.partner_id.street2">-</span>
                            </p>
                            <p style="margin: 0;">
                                <span t-out="o.partner_id.zip or ''">-</span>
                                <span t-out="o.partner_id.city or ''">-</span>
                            </p>
                            <p style="margin: 0;" t-if="o.partner_id.country_id">
                                <span t-out="o.partner_id.country_id.name">-</span>
                            </p>
                        </div>

                        <!-- Objet -->
                        <h2 style="color: #C91E18; font-size: 16pt; margin-bottom: 20px;">
                            Objet : Notification d'indexation annuelle
                        </h2>

                        <p style="margin: 0 0 15px 0;">
                            <strong>Bonjour <span t-out="o.partner_id.name or ''">[Client]</span>,</strong>
                        </p>

                        <p style="margin: 0 0 15px 0; text-align: justify;">
                            Conformément à la clause d'indexation prévue dans votre contrat
                            de location de box <strong t-out="o.subscription_id.name or ''">[contrat]</strong>,
                            et en application de l'évolution de l'indice santé belge publié
                            mensuellement par Statbel (Office belge de statistique), nous
                            avons le plaisir de vous notifier l'indexation annuelle de votre loyer.
                        </p>

                        <!-- Tableau de détail -->
                        <h3 style="color: #C91E18; font-size: 13pt; margin: 25px 0 10px 0; border-bottom: 2px solid #C91E18; padding-bottom: 5px;">
                            Détail de l'indexation
                        </h3>

                        <table class="table table-sm" style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <tr>
                                <td style="padding: 8px; border: 1px solid #ddd; width: 50%; background-color: #f9f9f9;">
                                    Box concerné
                                </td>
                                <td style="padding: 8px; border: 1px solid #ddd;">
                                    <span t-out="o.product_id.name or ''">-</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #ddd; background-color: #f9f9f9;">
                                    Référence du contrat
                                </td>
                                <td style="padding: 8px; border: 1px solid #ddd;">
                                    <span t-out="o.subscription_id.name or ''">-</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #ddd; background-color: #f9f9f9;">
                                    Date de signature du contrat
                                </td>
                                <td style="padding: 8px; border: 1px solid #ddd;">
                                    <span t-out="(o.subscription_id.start_date and o.subscription_id.start_date.strftime('%d/%m/%Y')) or '-'">-</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #ddd; background-color: #f9f9f9;">
                                    Loyer actuel (mensuel)
                                </td>
                                <td style="padding: 8px; border: 1px solid #ddd;">
                                    <span t-out="'%.2f' % o.old_price">0.00</span> €
                                </td>
                            </tr>
                            <tr style="background-color: #fff8f7;">
                                <td style="padding: 8px; border: 1px solid #ddd;">
                                    <strong style="color: #C91E18;">Nouveau loyer (mensuel)</strong>
                                </td>
                                <td style="padding: 8px; border: 1px solid #ddd;">
                                    <strong style="color: #C91E18; font-size: 13pt;">
                                        <span t-out="'%.2f' % o.new_price">0.00</span> €
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #ddd; background-color: #f9f9f9;">
                                    <strong>Augmentation</strong>
                                </td>
                                <td style="padding: 8px; border: 1px solid #ddd;">
                                    <strong>+ <span t-out="'%.2f' % o.price_increase">0.00</span> € / mois</strong>
                                    (+ <span t-out="'%.2f' % o.increase_percentage">0.00</span> %)
                                </td>
                            </tr>
                        </table>

                        <!-- Indices utilisés -->
                        <h3 style="color: #C91E18; font-size: 13pt; margin: 25px 0 10px 0; border-bottom: 2px solid #C91E18; padding-bottom: 5px;">
                            Indices de référence (base 2025=100)
                        </h3>

                        <table class="table table-sm" style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <tr>
                                <td style="padding: 8px; border: 1px solid #ddd; width: 50%; background-color: #f9f9f9;">
                                    Indice de base (à la signature)
                                </td>
                                <td style="padding: 8px; border: 1px solid #ddd;">
                                    <span t-out="'%.2f' % o.base_index_value">0.00</span>
                                    <span t-if="o.base_index_id">
                                        (<span t-out="(o.base_index_id.date and o.base_index_id.date.strftime('%m/%Y')) or ''">-</span>)
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #ddd; background-color: #f9f9f9;">
                                    Nouvel indice (cible)
                                </td>
                                <td style="padding: 8px; border: 1px solid #ddd;">
                                    <span t-out="'%.2f' % o.new_index_value">0.00</span>
                                    <span t-if="o.indexation_id.new_index_id">
                                        (<span t-out="(o.indexation_id.new_index_id.date and o.indexation_id.new_index_id.date.strftime('%m/%Y')) or ''">-</span>)
                                    </span>
                                </td>
                            </tr>
                        </table>

                        <p style="margin: 15px 0; text-align: justify; font-size: 10pt; color: #666; font-style: italic;">
                            Formule de calcul appliquée :
                            <strong>Nouveau loyer = Ancien loyer × (Nouvel indice / Indice de base)</strong>
                        </p>

                        <!-- Date d'application -->
                        <div style="background-color: #f9f9f9; border-left: 4px solid #C91E18; padding: 15px 20px; margin: 25px 0;">
                            <p style="margin: 0 0 5px 0; font-weight: bold; color: #C91E18;">
                                Date d'application
                            </p>
                            <p style="margin: 0;">
                                Cette indexation prendra effet à compter du
                                <strong>
                                    <span t-out="(o.indexation_id.application_date and o.indexation_id.application_date.strftime('%d/%m/%Y')) or '-'">-</span>
                                </strong>.
                                Le nouveau montant sera automatiquement appliqué sur votre prochaine
                                facture suivant cette date.
                            </p>
                        </div>

                        <p style="margin: 20px 0 15px 0; text-align: justify;">
                            Pour toute question relative à cette indexation, n'hésitez pas à
                            nous contacter par email à
                            <strong>gardemeublelolirine@gmail.com</strong>
                            ou par téléphone au <strong>0497 / 444 146</strong>.
                        </p>

                        <p style="margin: 20px 0 5px 0;">
                            Nous vous remercions de votre confiance.
                        </p>

                        <!-- Signature -->
                        <div style="margin-top: 40px;">
                            <p style="margin: 0 0 5px 0;">Cordialement,</p>
                            <p style="margin: 0; font-weight: bold;">L'équipe Lolirine Garde-meuble</p>
                            <p style="margin: 0; font-size: 10pt; color: #666;">Rodney Feron, gérant</p>
                        </div>

                        <!-- ===== PIED DE PAGE LOLIRINE ===== -->
                        <div style="margin-top: 50px; border-top: 2px solid #C91E18; padding-top: 10px; font-size: 8pt; color: #888; text-align: center;">
                            <strong t-out="company.name or 'Lolirine SRL'">Lolirine SRL</strong>
                            — TVA <span t-out="company.vat or 'BE0650891279'"/>
                            <br/>
                            <span t-if="company.street" t-out="company.street"/>,
                            <span t-out="company.zip or ''"/>
                            <span t-out="company.city or ''"/>
                            — gardemeublelolirine@gmail.com — 0497 / 444 146
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
