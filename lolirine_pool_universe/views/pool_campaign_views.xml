<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lolirine_pool_campaign_list" model="ir.ui.view">
        <field name="name">lolirine.pool.campaign.list</field>
        <field name="model">lolirine.pool.campaign</field>
        <field name="arch" type="xml">
            <list string="Encarts saisonniers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="title"/>
                <field name="mode"/>
                <field name="start_day" string="Du (jour)"/>
                <field name="start_month" string="Du (mois)"/>
                <field name="end_day" string="Au (jour)"/>
                <field name="end_month" string="Au (mois)"/>
                <field name="is_live"/>
                <field name="product_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_lolirine_pool_campaign_form" model="ir.ui.view">
        <field name="name">lolirine.pool.campaign.form</field>
        <field name="model">lolirine.pool.campaign</field>
        <field name="arch" type="xml">
            <form string="Encart saisonnier">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_page" type="object" class="oe_stat_button" icon="fa-external-link">
                            <field name="product_count" widget="statinfo" string="Produits"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Hivernage"/></h1>
                    </div>
                    <group>
                        <group string="Texte affiché">
                            <field name="badge"/>
                            <field name="title"/>
                            <field name="subtitle"/>
                            <field name="cta_label"/>
                            <field name="theme"/>
                        </group>
                        <group string="Période">
                            <field name="mode"/>
                            <field name="start_day" invisible="mode != 'auto'"/>
                            <field name="start_month" invisible="mode != 'auto'"/>
                            <field name="end_day" invisible="mode != 'auto'"/>
                            <field name="end_month" invisible="mode != 'auto'"/>
                            <field name="is_live"/>
                            <field name="code"/>
                            <field name="website_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sélection des produits" name="selection">
                            <group>
                                <group string="Inclure">
                                    <field name="categ_ids" widget="many2many_tags"/>
                                    <field name="keywords" placeholder="Un mot-clé par ligne"/>
                                    <field name="limit"/>
                                    <field name="only_with_image"/>
                                </group>
                                <group string="Exclure">
                                    <field name="exclude_categ_ids" widget="many2many_tags"
                                           placeholder="Ex. : Raccorderie PVC, Pièces à sceller &amp; Plomberie"/>
                                    <field name="exclude_keywords" placeholder="Un mot-clé par ligne"/>
                                </group>
                            </group>
                        </page>
                        <page string="Produits trouvés" name="found">
                            <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                                <button name="action_select_products" type="object" class="btn btn-primary"
                                        icon="fa-check-square-o" string="Sélectionner plusieurs produits à exclure"/>
                                <span class="text-muted">
                                    Ouvre la liste complète avec cases à cocher, recherche et regroupement
                                    par catégorie. « Exclure » sur une ligne retire un seul produit.
                                </span>
                            </div>
                            <field name="found_product_ids" readonly="1"
                                   context="{'pu_campaign_id': id}">
                                <list create="0" delete="0" limit="80">
                                    <field name="default_code" optional="show"/>
                                    <field name="name"/>
                                    <field name="public_categ_ids" widget="many2many_tags" optional="show"/>
                                    <field name="list_price" optional="show"/>
                                    <button name="action_pu_campaign_exclude" type="object"
                                            string="Exclure" icon="fa-ban" class="btn-link text-danger"/>
                                </list>
                            </field>
                        </page>
                        <page string="Produits exclus" name="excluded">
                            <p class="text-muted">
                                « Ajouter une ligne » ouvre la liste des produits de l'encart avec cases à cocher
                                (sélection multiple). Supprimez une ligne pour remettre le produit dans l'encart.
                            </p>
                            <field name="exclude_product_ids" domain="[('id', 'in', found_product_ids)]">
                                <list>
                                    <field name="default_code" optional="show"/>
                                    <field name="name"/>
                                    <field name="public_categ_ids" widget="many2many_tags" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══ Liste « Produits de l'encart » : sélection multiple ══ -->
    <record id="view_pu_campaign_product_list" model="ir.ui.view">
        <field name="name">product.template.list.pu.campaign</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Produits de l'encart" create="0" delete="0" edit="0" duplicate="0"
                  decoration-muted="pu_campaign_excluded" limit="200">
                <header>
                    <button name="action_pu_campaign_exclude" type="object"
                            string="Exclure de l'encart" icon="fa-ban" class="btn-danger"/>
                    <button name="action_pu_campaign_include" type="object"
                            string="Remettre dans l'encart" icon="fa-undo"/>
                </header>
                <field name="pu_campaign_excluded" widget="boolean" string="Exclu" width="70px"/>
                <field name="default_code" optional="show"/>
                <field name="name"/>
                <field name="public_categ_ids" widget="many2many_tags" optional="show"/>
                <field name="categ_id" optional="hide"/>
                <field name="list_price" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pu_campaign_product_search" model="ir.ui.view">
        <field name="name">product.template.search.pu.campaign</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Produits de l'encart">
                <field name="name" string="Produit"
                       filter_domain="['|', ('name', 'ilike', self), ('default_code', 'ilike', self)]"/>
                <field name="public_categ_ids" string="Catégorie du site"/>
                <group>
                    <filter name="group_public_categ" string="Catégorie du site"
                            context="{'group_by': 'public_categ_ids'}"/>
                    <filter name="group_categ" string="Catégorie de produit"
                            context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lolirine_pool_campaign" model="ir.actions.act_window">
        <field name="name">Encarts saisonniers</field>
        <field name="res_model">lolirine.pool.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_lolirine_pool_campaign"
              name="Encarts saisonniers"
              parent="website.menu_website_global_configuration"
              action="action_lolirine_pool_campaign"
              sequence="62"/>
</odoo>
