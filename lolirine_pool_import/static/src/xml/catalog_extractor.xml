<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="lolirine_pool_import.CatalogExtractorView">
        <div class="o_pool_catalog_extractor h-100 d-flex flex-column">
            <!-- Header -->
            <div class="o_pool_header bg-white border-bottom p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">
                        <i class="fa fa-magic me-2 text-primary"/>
                        Extracteur de Catalogue IA
                    </h2>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary" t-on-click="toggleHistory">
                            <i class="fa fa-history me-1"/>
                            Historique
                        </button>
                        <button class="btn btn-outline-secondary" t-on-click="openExtractionList">
                            <i class="fa fa-database me-1"/>
                            Extractions
                        </button>
                        <button class="btn btn-outline-secondary" t-on-click="openCatalogList">
                            <i class="fa fa-list me-1"/>
                            Catalogues
                        </button>
                        <t t-if="state.extractedProducts.length > 0">
                            <button class="btn btn-success" t-on-click="importAllExtracted" 
                                    t-att-disabled="pendingProductsCount === 0 || state.loading">
                                <i class="fa fa-download me-1"/>
                                Tout importer (<t t-esc="pendingProductsCount"/>)
                            </button>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Main Content - Split View -->
            <div class="o_pool_content flex-grow-1 d-flex overflow-hidden position-relative">
                
                <!-- History Panel (overlay) -->
                <t t-if="state.showHistory">
                    <div class="o_pool_history_overlay position-absolute top-0 end-0 bg-white shadow border-start h-100" 
                         style="width: 350px; z-index: 100;">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fa fa-history me-2"/>
                                Historique des extractions
                            </h5>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleHistory">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <div class="o_pool_history_list overflow-auto" style="max-height: calc(100% - 60px);">
                            <t t-if="state.extractionHistory.length === 0">
                                <div class="text-center text-muted py-4">
                                    <i class="fa fa-inbox fa-2x mb-2"/>
                                    <p>Aucune extraction</p>
                                </div>
                            </t>
                            <t t-else="">
                                <t t-foreach="state.extractionHistory" t-as="extraction" t-key="extraction.id">
                                    <div class="p-3 border-bottom cursor-pointer hover-bg-light"
                                         t-on-click="() => this.loadExtraction(extraction.id)"
                                         t-att-class="{'bg-light': state.extractionId === extraction.id}">
                                        <div class="d-flex justify-content-between">
                                            <strong t-esc="extraction.supplier_id ? extraction.supplier_id[1] : 'Sans fournisseur'"/>
                                            <span class="badge" 
                                                  t-att-class="{'bg-success': extraction.state === 'imported', 'bg-warning text-dark': extraction.state === 'extracted'}">
                                                <t t-esc="extraction.state === 'imported' ? 'Importé' : 'Extrait'"/>
                                            </span>
                                        </div>
                                        <div class="small text-muted">
                                            <t t-esc="extraction.product_count"/> produit(s) - 
                                            <t t-esc="extraction.extraction_type === 'variants' ? 'Variantes' : 'Simple'"/>
                                        </div>
                                        <div class="small text-muted">
                                            <t t-esc="extraction.create_date"/>
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Left Panel - Catalog Viewer -->
                <div class="o_pool_viewer_panel border-end" style="width: 55%; min-width: 400px;">
                    <!-- Toolbar -->
                    <div class="o_pool_viewer_toolbar bg-light border-bottom p-2 d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm" style="width: 150px;" 
                                t-on-change="onSupplierChange">
                            <t t-foreach="state.suppliers" t-as="supplier" t-key="supplier.id">
                                <option t-att-value="supplier.id" 
                                        t-att-selected="state.selectedSupplier?.id === supplier.id">
                                    <t t-esc="supplier.name"/>
                                </option>
                            </t>
                        </select>
                        
                        <input type="text" class="form-control form-control-sm flex-grow-1" 
                               placeholder="URL du catalogue..."
                               t-att-value="state.catalogUrl"
                               t-on-change="onCatalogUrlChange"/>
                        
                        <button class="btn btn-sm btn-primary" t-on-click="loadCatalog">
                            <i class="fa fa-refresh"/>
                        </button>
                        
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="previousPage">
                                <i class="fa fa-chevron-left"/>
                            </button>
                            <span class="btn btn-sm btn-outline-secondary disabled">
                                <t t-esc="state.currentPage"/> / <t t-esc="state.totalPages"/>
                            </span>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="nextPage">
                                <i class="fa fa-chevron-right"/>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Iframe Viewer -->
                    <div class="o_pool_viewer_frame h-100 bg-secondary">
                        <t t-if="state.catalogUrl">
                            <iframe id="catalog-viewer-iframe"
                                    t-att-src="state.catalogUrl"
                                    class="w-100 h-100 border-0"
                                    sandbox="allow-same-origin allow-scripts allow-popups allow-forms"/>
                        </t>
                        <t t-else="">
                            <div class="d-flex align-items-center justify-content-center h-100 text-white">
                                <div class="text-center">
                                    <i class="fa fa-book fa-4x mb-3 opacity-50"/>
                                    <p>Sélectionnez un fournisseur ou entrez une URL de catalogue</p>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Right Panel - Form & Items -->
                <div class="o_pool_form_panel flex-grow-1 d-flex flex-column overflow-hidden">
                    
                    <!-- Tabs -->
                    <ul class="nav nav-tabs px-3 pt-2 bg-white">
                        <li class="nav-item">
                            <a class="nav-link" t-att-class="{'active': state.activeTab === 'form'}"
                               href="#" t-on-click.prevent="() => this.setActiveTab('form')">
                                <i class="fa fa-edit me-1"/>
                                Extraction
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" t-att-class="{'active': state.activeTab === 'specs'}"
                               href="#" t-on-click.prevent="() => this.setActiveTab('specs')">
                                <i class="fa fa-cogs me-1"/>
                                Spécifications
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" t-att-class="{'active': state.activeTab === 'items'}"
                               href="#" t-on-click.prevent="() => this.setActiveTab('items')">
                                <i class="fa fa-list me-1"/>
                                Produits (<t t-esc="state.items.length"/>)
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content flex-grow-1 overflow-auto">
                        
                        <!-- Tab Extraction/Form -->
                        <div class="tab-pane fade p-3" t-att-class="{'show active': state.activeTab === 'form'}">
                            
                            <!-- Section OCR -->
                            <div class="card mb-3 border-info">
                                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="fa fa-magic me-2"/>
                                        Extraction IA (OCR)
                                    </span>
                                    <t t-if="state.extractionType === 'variants'">
                                        <span class="badge bg-warning text-dark">
                                            <i class="fa fa-th-list me-1"/>
                                            Variantes détectées
                                        </span>
                                    </t>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-2">
                                        Prenez une capture d'écran d'une section du catalogue. L'IA détectera automatiquement s'il s'agit d'un produit unique ou d'un tableau de variantes.
                                    </p>
                                    
                                    <!-- Upload zone -->
                                    <div class="d-flex gap-2 align-items-end mb-3">
                                        <div class="flex-grow-1">
                                            <input type="file" 
                                                   class="form-control form-control-sm" 
                                                   accept="image/*"
                                                   t-on-change="onOcrFileChange"
                                                   id="ocr-file-input"/>
                                        </div>
                                        <button class="btn btn-info" 
                                                t-on-click="extractWithOcr"
                                                t-att-disabled="!state.ocrFile || state.ocrLoading">
                                            <t t-if="state.ocrLoading">
                                                <i class="fa fa-spinner fa-spin me-1"/>
                                                Extraction...
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-magic me-1"/>
                                                Extraire
                                            </t>
                                        </button>
                                    </div>
                                    
                                    <!-- Preview & Navigation -->
                                    <t t-if="state.ocrPreview">
                                        <div class="mb-3">
                                            <img t-att-src="state.ocrPreview" 
                                                 class="img-fluid rounded border" 
                                                 style="max-height: 150px;"/>
                                        </div>
                                    </t>
                                    
                                    <!-- Navigation produits extraits -->
                                    <t t-if="state.extractedProducts.length > 1">
                                        <div class="alert alert-info py-2 d-flex justify-content-between align-items-center">
                                            <span>
                                                <i class="fa fa-cubes me-1"/>
                                                <strong><t t-esc="state.extractedProducts.length"/></strong> produits extraits
                                            </span>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" 
                                                        t-on-click="previousProduct"
                                                        t-att-disabled="state.currentProductIndex === 0">
                                                    <i class="fa fa-chevron-left"/>
                                                </button>
                                                <span class="btn btn-outline-primary disabled">
                                                    <t t-esc="productNavigationText"/>
                                                </span>
                                                <button class="btn btn-outline-primary" 
                                                        t-on-click="nextProduct"
                                                        t-att-disabled="state.currentProductIndex >= state.extractedProducts.length - 1">
                                                    <i class="fa fa-chevron-right"/>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <!-- Quick select buttons -->
                                        <div class="mb-3 d-flex flex-wrap gap-1">
                                            <t t-foreach="state.extractedProducts" t-as="prod" t-key="prod.id">
                                                <button class="btn btn-sm"
                                                        t-att-class="{
                                                            'btn-primary': prod_index === state.currentProductIndex,
                                                            'btn-success': prod.state === 'imported' and prod_index !== state.currentProductIndex,
                                                            'btn-outline-secondary': prod.state !== 'imported' and prod_index !== state.currentProductIndex
                                                        }"
                                                        t-on-click="() => this.selectProduct(prod_index)"
                                                        t-att-title="prod.name">
                                                    <t t-if="prod.state === 'imported'">
                                                        <i class="fa fa-check me-1"/>
                                                    </t>
                                                    <t t-esc="prod.type_code || prod.capacity || (prod_index + 1)"/>
                                                </button>
                                            </t>
                                        </div>
                                    </t>
                                    
                                    <!-- Error message -->
                                    <t t-if="state.ocrError">
                                        <div class="alert alert-danger py-2">
                                            <i class="fa fa-exclamation-triangle me-1"/>
                                            <t t-esc="state.ocrError"/>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Product imported indicator -->
                            <t t-if="isCurrentProductImported">
                                <div class="alert alert-success py-2 mb-3">
                                    <i class="fa fa-check-circle me-1"/>
                                    Ce produit a été importé dans Odoo
                                </div>
                            </t>

                            <!-- Formulaire Produit -->
                            <div class="card">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="fa fa-cube me-2"/>
                                        Données produit
                                    </span>
                                    <button class="btn btn-sm btn-outline-secondary" t-on-click="resetForm">
                                        <i class="fa fa-eraser me-1"/>
                                        Effacer
                                    </button>
                                </div>
                                <div class="card-body">
                                    <!-- Références -->
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <label class="form-label">Référence fournisseur</label>
                                            <input type="text" class="form-control"
                                                   t-att-value="state.formData.supplier_ref"
                                                   t-on-input="(ev) => this.onFormFieldChange('supplier_ref', ev)"
                                                   placeholder="SC941, SC942..."/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Code Type</label>
                                            <input type="text" class="form-control"
                                                   t-att-value="state.formData.type_code"
                                                   t-on-input="(ev) => this.onFormFieldChange('type_code', ev)"
                                                   placeholder="ASRC120, ASRC150..."/>
                                        </div>
                                    </div>

                                    <!-- Nom -->
                                    <div class="mb-3">
                                        <label class="form-label">Nom du produit</label>
                                        <input type="text" class="form-control"
                                               t-att-value="state.formData.name"
                                               t-on-input="(ev) => this.onFormFieldChange('name', ev)"
                                               placeholder="Pompe à chaleur..."/>
                                    </div>

                                    <!-- Marque & Catégorie -->
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <label class="form-label">Marque</label>
                                            <input type="text" class="form-control"
                                                   t-att-value="state.formData.brand"
                                                   t-on-input="(ev) => this.onFormFieldChange('brand', ev)"
                                                   placeholder="Astral, Hayward..."/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Catégorie</label>
                                            <input type="text" class="form-control"
                                                   t-att-value="state.formData.category"
                                                   t-on-input="(ev) => this.onFormFieldChange('category', ev)"
                                                   placeholder="Pompes à chaleur, Filtration..."/>
                                        </div>
                                    </div>

                                    <!-- Capacité -->
                                    <div class="mb-3">
                                        <label class="form-label">Capacité / Variante</label>
                                        <input type="text" class="form-control"
                                               t-att-value="state.formData.capacity"
                                               t-on-input="(ev) => this.onFormFieldChange('capacity', ev)"
                                               placeholder="12 kW, 15 m³/h..."/>
                                    </div>

                                    <!-- Prix -->
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <label class="form-label">Prix d'achat HT</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" step="0.01"
                                                       t-att-value="state.formData.purchase_price"
                                                       t-on-input="(ev) => this.onPriceChange('purchase_price', ev)"/>
                                                <span class="input-group-text">€</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Prix de vente HT</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" step="0.01"
                                                       t-att-value="state.formData.selling_price"
                                                       t-on-input="(ev) => this.onPriceChange('selling_price', ev)"/>
                                                <span class="input-group-text">€</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Description FR -->
                                    <div class="mb-3">
                                        <label class="form-label">Description FR</label>
                                        <textarea class="form-control" rows="2"
                                                  t-att-value="state.formData.description_fr"
                                                  t-on-input="(ev) => this.onFormFieldChange('description_fr', ev)"
                                                  placeholder="Description en français..."/>
                                    </div>

                                    <!-- Buttons -->
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-primary flex-grow-1" 
                                                t-on-click="addProduct"
                                                t-att-disabled="state.loading || isCurrentProductImported">
                                            <t t-if="state.loading">
                                                <i class="fa fa-spinner fa-spin me-1"/>
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-plus me-1"/>
                                            </t>
                                            <t t-if="state.formData._extracted_product_id">
                                                Importer dans Odoo
                                            </t>
                                            <t t-else="">
                                                Ajouter (Ctrl+Enter)
                                            </t>
                                        </button>
                                    </div>
                                    
                                    <p class="text-muted small mt-2 mb-0">
                                        <i class="fa fa-keyboard-o me-1"/>
                                        Raccourcis: Alt+← / Alt+→ pour naviguer entre les produits
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Tab Spécifications -->
                        <div class="tab-pane fade p-3" t-att-class="{'show active': state.activeTab === 'specs'}">
                            <div class="card">
                                <div class="card-header">
                                    <i class="fa fa-cogs me-2"/>
                                    Spécifications techniques
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <label class="form-label">Puissance (kW)</label>
                                            <input type="number" class="form-control" step="0.1"
                                                   t-att-value="state.formData.power_kw"
                                                   t-on-input="(ev) => this.onNumberChange('power_kw', ev)"/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Puissance (CV)</label>
                                            <input type="text" class="form-control"
                                                   t-att-value="state.formData.power_cv"
                                                   t-on-input="(ev) => this.onFormFieldChange('power_cv', ev)"/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Tension (V)</label>
                                            <input type="number" class="form-control"
                                                   t-att-value="state.formData.voltage"
                                                   t-on-input="(ev) => this.onNumberChange('voltage', ev)"/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Débit (m³/h)</label>
                                            <input type="number" class="form-control" step="0.1"
                                                   t-att-value="state.formData.flow_rate"
                                                   t-on-input="(ev) => this.onNumberChange('flow_rate', ev)"/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">COP</label>
                                            <input type="number" class="form-control" step="0.1"
                                                   t-att-value="state.formData.cop"
                                                   t-on-input="(ev) => this.onNumberChange('cop', ev)"/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Niveau sonore (dB)</label>
                                            <input type="number" class="form-control" step="0.1"
                                                   t-att-value="state.formData.noise_level"
                                                   t-on-input="(ev) => this.onNumberChange('noise_level', ev)"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab Items -->
                        <div class="tab-pane fade p-3" t-att-class="{'show active': state.activeTab === 'items'}">
                            <t t-if="state.items.length === 0">
                                <div class="text-center text-muted py-5">
                                    <i class="fa fa-inbox fa-3x mb-3"/>
                                    <p>Aucun produit ajouté manuellement</p>
                                    <p class="small">Utilisez l'extraction IA ou le formulaire pour ajouter des produits</p>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="d-flex justify-content-end mb-3">
                                    <button class="btn btn-success" t-on-click="importAllItems">
                                        <i class="fa fa-download me-1"/>
                                        Finaliser l'import
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Réf.</th>
                                                <th>Nom</th>
                                                <th>Marque</th>
                                                <th class="text-end">Prix achat</th>
                                                <th class="text-end">Prix vente</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.items" t-as="item" t-key="item.id">
                                                <tr t-on-click="() => this.selectItem(item)"
                                                    class="cursor-pointer">
                                                    <td><t t-esc="item.supplier_ref || item.type_code"/></td>
                                                    <td><t t-esc="item.name"/></td>
                                                    <td><t t-esc="item.brand"/></td>
                                                    <td class="text-end"><t t-esc="item.purchase_price.toFixed(2)"/> €</td>
                                                    <td class="text-end"><t t-esc="item.selling_price.toFixed(2)"/> €</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-danger"
                                                                t-on-click.stop="() => this.deleteItem(item)">
                                                            <i class="fa fa-trash"/>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
