<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Case à cocher « Aucune facture attendue » sur le modèle de rapprochement.
         Si l'xpath casse sur une future version, retirer ce fichier du manifest :
         le champ reste alimentable par script ou via la vue développeur. -->
    <record id="view_reconcile_model_form_no_invoice" model="ir.ui.view">
        <field name="name">account.reconcile.model.form.no.invoice</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.account_reconcile_model_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_no_invoice_expected"/>
            </field>
        </field>
    </record>

    <record id="view_reconcile_model_list_no_invoice" model="ir.ui.view">
        <field name="name">account.reconcile.model.list.no.invoice</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.account_reconcile_model_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_no_invoice_expected" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
