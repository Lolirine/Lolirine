<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_penalite_client_tree" model="ir.ui.view">
        <field name="name">penalite.client.tree</field>
        <field name="model">penalite.client</field>
        <field name="arch" type="xml">
            <tree string="Pénalités">
                <field name="name"/>
                <field name="motif"/>
                <field name="montant"/>
                <field name="date"/>
            </tree>
        </field>
    </record>

    <record id="view_penalite_client_form" model="ir.ui.view">
        <field name="name">penalite.client.form</field>
        <field name="model">penalite.client</field>
        <field name="arch" type="xml">
            <form string="Pénalité">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="motif"/>
                        <field name="montant"/>
                        <field name="date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_penalite_client" model="ir.actions.act_window">
        <field name="name">Pénalités</field>
        <field name="res_model">penalite.client</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_penalite_root" name="Pénalités" sequence="10"/>
    <menuitem id="menu_penalite_client" name="Liste des pénalités"
              parent="menu_penalite_root" action="action_penalite_client" sequence="20"/>
</odoo>
