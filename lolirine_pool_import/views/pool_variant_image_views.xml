<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         1. EXTENSION FORMULAIRE PRODUCT.TEMPLATE
         ============================================================ -->

    <record id="view_product_template_variant_images_form" model="ir.ui.view">
        <field name="name">product.template.form.variant.images</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Images Variantes" name="variant_images"
                      invisible="product_variant_count &lt;= 1">
                    <group>
                        <group>
                            <field name="variant_images_configured" readonly="1"/>
                        </group>
                        <group>
                            <div class="d-flex gap-2">
                                <button name="action_auto_assign_variant_images"
                                        type="object"
                                        string="Auto-assigner"
                                        class="btn btn-primary"
                                        icon="fa-picture-o"
                                        title="Assigne automatiquement les images aux variantes"/>
                                <button name="action_distribute_images_round_robin"
                                        type="object"
                                        string="Distribuer"
                                        class="btn btn-secondary"
                                        icon="fa-random"
                                        title="Distribue les images non-assignées"/>
                                <button name="action_reset_variant_images"
                                        type="object"
                                        string="Reset"
                                        class="btn btn-outline-danger"
                                        icon="fa-trash"
                                        confirm="Supprimer toutes les assignations d'images variantes ?"/>
                            </div>
                        </group>
                    </group>

                    <separator string="Valeurs d'attributs avec images"/>
                    <field name="attribute_line_ids" readonly="1">
                        <list string="Lignes d'attributs">
                            <field name="attribute_id"/>
                            <field name="value_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         2. VUES PTAV STANDALONE (pas d'inherit, évite les erreurs)
         ============================================================ -->

    <record id="view_ptav_variant_image_form" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.variant.image</field>
        <field name="model">product.template.attribute.value</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Valeur attribut - Image variante">
                <sheet>
                    <group>
                        <group string="Informations">
                            <field name="attribute_id" readonly="1"/>
                            <field name="product_attribute_value_id" readonly="1"/>
                            <field name="price_extra"/>
                        </group>
                        <group string="Image variante">
                            <field name="variant_image" widget="image" class="oe_avatar"/>
                            <field name="variant_image_url"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ptav_variant_image_tree" model="ir.ui.view">
        <field name="name">product.template.attribute.value.tree.variant.image</field>
        <field name="model">product.template.attribute.value</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Valeurs d'attribut - Images">
                <field name="attribute_id"/>
                <field name="product_attribute_value_id"/>
                <field name="price_extra"/>
                <field name="variant_image" widget="image" width="40"
                       options='{"size": [40, 40]}'/>
            </list>
        </field>
    </record>

    <record id="action_ptav_variant_images" model="ir.actions.act_window">
        <field name="name">Images par valeur d'attribut</field>
        <field name="res_model">product.template.attribute.value</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ptav_variant_image_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_ptav_variant_image_form')})]"/>
    </record>

    <!-- ============================================================
         3. ACTIONS SERVEUR
         ============================================================ -->

    <record id="action_batch_assign_variant_images" model="ir.actions.server">
        <field name="name">Assigner images variantes</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records.action_auto_assign_variant_images()
        </field>
    </record>

    <record id="action_batch_all_variant_images" model="ir.actions.server">
        <field name="name">Batch : images variantes (tous)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
result = env['product.template'].cron_assign_all_variant_images()
if result:
    msg = "Traités: %d, Images: %d, Erreurs: %d" % (
        result.get('processed', 0),
        result.get('assigned', 0),
        len(result.get('errors', [])),
    )
    raise Warning(msg)
        </field>
    </record>

    <!-- ============================================================
         4. CRON
         ============================================================ -->

    <record id="ir_cron_assign_variant_images" model="ir.cron">
        <field name="name">Pool : Assigner images variantes</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model.cron_assign_all_variant_images()</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
        <field name="doall" eval="False"/>
    </record>

</odoo>
