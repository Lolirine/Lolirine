<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_checklist" name="Pool Checklist — Fiche de visite">
        <t t-call="website.layout">

            <t t-set="head">
                <style>
                    /* ── Masque header/footer Odoo ── */
                    #wrapwrap > header,
                    #wrapwrap > footer,
                    .o_footer_copyright { display: none !important; }

                    /* ── Hero éditabl via Website Builder ── */
                    #lpc_hero {
                        position: relative;
                        min-height: 180px;
                        background: linear-gradient(135deg,#0ea5e9 0%,#0369a1 100%);
                        background-size: cover;
                        background-position: center;
                    }
                    #lpc_hero .o_we_bg_filter {
                        position: absolute;
                        inset: 0;
                        background: rgba(10,30,60,0.45);
                    }
                    #lpc_hero .lpc_hero_inner {
                        position: relative;
                        z-index: 2;
                        padding: 44px 52px;
                        display: flex;
                        align-items: center;
                        gap: 22px;
                    }
                    #lpc_hero .lpc_logo_box {
                        width: 64px; height: 64px;
                        background: rgba(255,255,255,0.15);
                        border-radius: 16px;
                        display: grid; place-items: center;
                        font-size: 32px; flex-shrink: 0;
                        backdrop-filter: blur(8px);
                        border: 1.5px solid rgba(255,255,255,0.25);
                    }
                    #lpc_hero h1 {
                        font-family: 'DM Serif Display', serif;
                        font-size: 30px; color: #fff; margin: 0;
                        text-shadow: 0 2px 8px rgba(0,0,0,0.3);
                    }
                    #lpc_hero p { font-size: 14px; color: rgba(255,255,255,0.8); margin-top:4px; }
                    .lpc_back_btn {
                        margin-left: auto;
                        background: rgba(255,255,255,0.15);
                        border: 1.5px solid rgba(255,255,255,0.3);
                        border-radius: 9px; padding: 8px 18px;
                        font-size: 13px; color: #fff;
                        text-decoration: none; flex-shrink: 0;
                        backdrop-filter: blur(8px);
                        transition: background .2s;
                    }
                    .lpc_back_btn:hover { background: rgba(255,255,255,0.25); color:#fff; }

                    /* ── Zone app ── */
                    #lpc_app_zone { background: #eef2f7; min-height: 80vh; }

                    /* ── Zone footer éditable ── */
                    #lpc_footer_zone {
                        background: #1a2332;
                        min-height: 60px;
                        padding: 0;
                    }

                    /* ── Accès restreint : overlay si non connecté ── */
                    #lpc_auth_wall {
                        display: none;
                        position: fixed; inset: 0;
                        background: rgba(10,20,40,0.95);
                        z-index: 99999;
                        align-items: center; justify-content: center;
                        flex-direction: column; gap: 16px;
                        color: #fff; font-family: 'DM Sans', sans-serif;
                    }
                </style>

                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&amp;family=DM+Sans:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js" crossorigin="anonymous"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js" crossorigin="anonymous"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.2/babel.min.js" crossorigin="anonymous"/>
                <link rel="stylesheet" href="/lolirine_pool_checklist/static/src/css/pool_checklist.css"/>
            </t>

            <!-- ═══════ HERO — entièrement éditable Website Builder ═══════
                 Pour modifier l'image de fond :
                 1. Clique sur "Modifier" dans la barre Website Builder
                 2. Clique sur le bandeau bleu
                 3. Panneau droit → "Arrière-plan" → choisis ton image
                 4. Ajuste l'opacité du filtre si nécessaire
                 5. Enregistrer
            ═══════════════════════════════════════════════════════════ -->
            <section id="lpc_hero"
                     class="o_cc o_cc1 o_colored_level"
                     data-snippet="s_cover"
                     data-name="Hero Fiche de visite"
                     contenteditable="false">

                <!-- Filtre de couleur éditable (opacité ajustable dans le builder) -->
                <div class="o_we_bg_filter"/>

                <!-- Zone structure libre en haut -->
                <div id="oe_structure_lpc_top" class="oe_structure oe_empty"/>

                <!-- Contenu hero -->
                <div class="lpc_hero_inner" contenteditable="false">
                    <div class="lpc_logo_box">🏊</div>
                    <div>
                        <h1>Lolirine Pool Store — Fiche de visite chantier</h1>
                        <p>Diagnostic · intervention · produits liés · devis estimatif</p>
                    </div>
                    <a href="/odoo/website" class="lpc_back_btn">← Retour Odoo</a>
                </div>

                <!-- Zone structure libre en bas du hero -->
                <div id="oe_structure_lpc_bottom" class="oe_structure oe_empty"/>
            </section>

            <!-- ═══════ APPLICATION REACT ═══════ -->
            <section id="lpc_app_zone" contenteditable="false">
                <!-- Mur d'auth JS (visible seulement si cookie session absent) -->
                <div id="lpc_auth_wall">
                    <span style="font-size:40px">🔒</span>
                    <span style="font-size:18px;font-weight:700">Accès réservé aux techniciens Lolirine</span>
                    <a href="/web/login" style="background:#0ea5e9;color:#fff;padding:10px 24px;border-radius:10px;text-decoration:none;font-weight:700;">Se connecter</a>
                </div>
                <div id="pool-checklist-root"/>
            </section>

            <!-- ═══════ FOOTER ÉDITABLE ═══════ -->
            <section id="lpc_footer_zone" class="o_cc o_cc5">
                <div id="oe_structure_lpc_footer" class="oe_structure">
                    <div style="text-align:center;color:rgba(255,255,255,0.45);font-size:12px;font-family:'DM Sans',sans-serif;padding:16px 0;">
                        Lolirine Pool Store · lolirinepoolstore.be · BCE 0650.891.279
                    </div>
                </div>
            </section>

            <!-- Config Odoo -->
            <script type="text/javascript">
                window.LOLIRINE_CHECKLIST_CONFIG = {
                    productsEndpoint: '/pool-checklist/products',
                    websiteId: <t t-out="website_id or 6"/>,
                    userName: '<t t-out="request.env.user.name"/>',
                    isLoggedIn: true,
                };
                // Sécurité côté JS : si la session expire, afficher le mur d'auth
                document.addEventListener('DOMContentLoaded', function() {
                    if(!window.LOLIRINE_CHECKLIST_CONFIG.isLoggedIn) {
                        var wall = document.getElementById('lpc_auth_wall');
                        if(wall) wall.style.display = 'flex';
                    }
                });
            </script>

            <!-- Contrôleur Website Builder : rendre la page éditable -->
            <script type="text/javascript">
                // Permet au Website Builder de reconnaître les sections éditables
                document.addEventListener('DOMContentLoaded', function() {
                    var hero = document.getElementById('lpc_hero');
                    if(hero) {
                        hero.setAttribute('data-oe-model', 'ir.ui.view');
                        hero.setAttribute('data-oe-field', 'arch');
                    }
                });
            </script>

            <!-- Application React -->
            <script type="text/babel"
                    src="/lolirine_pool_checklist/static/src/js/pool_checklist.js"
                    data-presets="react"/>
        </t>
    </template>

</odoo>
