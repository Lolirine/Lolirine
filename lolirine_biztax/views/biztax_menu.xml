<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem
        id="menu_biztax_root"
        name="Biztax"
        web_icon="lolirine_biztax,static/description/icon.png"
        sequence="45"/>

    <!-- Declarations Menu -->
    <menuitem
        id="menu_biztax_declarations"
        name="Déclarations"
        parent="menu_biztax_root"
        sequence="10"/>

    <menuitem
        id="menu_biztax_declaration_list"
        name="Déclarations Fiscales"
        parent="menu_biztax_declarations"
        action="action_biztax_declaration"
        sequence="10"/>

    <menuitem
        id="menu_biztax_declaration_new"
        name="Nouvelle Déclaration"
        parent="menu_biztax_declarations"
        action="action_biztax_generate_wizard"
        sequence="20"/>

    <menuitem
        id="menu_biztax_multicompany_manager"
        name="Groupes de Sociétés"
        parent="menu_biztax_declarations"
        action="action_biztax_multicompany_manager"
        groups="lolirine_biztax.group_biztax_manager"
        sequence="30"/>

    <!-- Adjustments Menu -->
    <menuitem
        id="menu_biztax_adjustments"
        name="Ajustements"
        parent="menu_biztax_root"
        sequence="20"/>

    <menuitem
        id="menu_biztax_adjustment_list"
        name="Tous les Ajustements"
        parent="menu_biztax_adjustments"
        action="action_biztax_adjustment"
        sequence="10"/>

    <menuitem
        id="menu_biztax_extra_accounting"
        name="Mouvements Extra-Comptables"
        parent="menu_biztax_adjustments"
        action="action_biztax_extra_accounting"
        sequence="15"/>

    <menuitem
        id="menu_biztax_import_wizard"
        name="Importer des Ajustements"
        parent="menu_biztax_adjustments"
        action="action_biztax_import_wizard"
        sequence="20"/>

    <menuitem
        id="menu_biztax_loss_carryforward"
        name="Pertes Reportables"
        parent="menu_biztax_adjustments"
        action="action_biztax_loss_carryforward"
        sequence="30"/>

    <!-- Attachments Menu -->
    <menuitem
        id="menu_biztax_attachments"
        name="Annexes"
        parent="menu_biztax_root"
        action="action_biztax_attachment"
        sequence="30"/>

    <!-- Configuration Menu -->
    <menuitem
        id="menu_biztax_config"
        name="Configuration"
        parent="menu_biztax_root"
        groups="lolirine_biztax.group_biztax_manager"
        sequence="90"/>

    <menuitem
        id="menu_biztax_tax_codes"
        name="Codes Fiscaux"
        parent="menu_biztax_config"
        action="action_biztax_tax_code"
        sequence="10"/>

    <menuitem
        id="menu_biztax_account_mapping"
        name="Mappings Comptables"
        parent="menu_biztax_config"
        action="action_biztax_account_mapping"
        sequence="20"/>

    <menuitem
        id="menu_biztax_pcmn_mapping"
        name="Correspondance PCMN → XBRL"
        parent="menu_biztax_config"
        action="action_biztax_pcmn_mapping"
        sequence="25"/>

    <menuitem
        id="menu_biztax_company_settings"
        name="Paramètres Société"
        parent="menu_biztax_config"
        action="action_biztax_company_settings"
        sequence="30"/>

    <!-- Tax Code Action -->
    <record id="action_biztax_tax_code" model="ir.actions.act_window">
        <field name="name">Codes Fiscaux be-tax</field>
        <field name="res_model">biztax.tax.code</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_section': 1}</field>
    </record>

    <!-- Tax Code Views -->
    <record id="view_biztax_tax_code_tree" model="ir.ui.view">
        <field name="name">biztax.tax.code.tree</field>
        <field name="model">biztax.tax.code</field>
        <field name="arch" type="xml">
            <list string="Codes Fiscaux">
                <field name="code"/>
                <field name="name"/>
                <field name="section"/>
                <field name="data_type"/>
                <field name="xbrl_element"/>
            </list>
        </field>
    </record>

    <record id="view_biztax_tax_code_form" model="ir.ui.view">
        <field name="name">biztax.tax.code.form</field>
        <field name="model">biztax.tax.code</field>
        <field name="arch" type="xml">
            <form string="Code Fiscal">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="section"/>
                        </group>
                        <group string="XBRL">
                            <field name="xbrl_element"/>
                            <field name="data_type"/>
                            <field name="parent_id"/>
                        </group>
                    </group>
                    <group string="Traductions">
                        <field name="name_nl"/>
                        <field name="name_de"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_biztax_tax_code_search" model="ir.ui.view">
        <field name="name">biztax.tax.code.search</field>
        <field name="model">biztax.tax.code</field>
        <field name="arch" type="xml">
            <search string="Recherche Codes Fiscaux">
                <field name="code"/>
                <field name="name"/>
                <field name="xbrl_element"/>
                <separator/>
                <filter string="Première opération" name="section_f" domain="[('section', '=', 'F')]"/>
                <filter string="DNA" name="section_i" domain="[('section', '=', 'I')]"/>
                <filter string="Déductions" name="section_j" domain="[('section', '=', 'J')]"/>
                <filter string="Base imposable" name="section_k" domain="[('section', '=', 'K')]"/>
                <filter string="Impôt" name="section_l" domain="[('section', '=', 'L')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Section" name="group_section" context="{'group_by': 'section'}"/>
                    <filter string="Type de données" name="group_datatype" context="{'group_by': 'data_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Account Mapping Action -->
    <record id="action_biztax_account_mapping" model="ir.actions.act_window">
        <field name="name">Mappings Comptables</field>
        <field name="res_model">biztax.account.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Account Mapping Views -->
    <record id="view_biztax_account_mapping_tree" model="ir.ui.view">
        <field name="name">biztax.account.mapping.tree</field>
        <field name="model">biztax.account.mapping</field>
        <field name="arch" type="xml">
            <list string="Mappings Comptables" editable="bottom">
                <field name="account_id"/>
                <field name="tax_code_id"/>
                <field name="dna_percentage"/>
                <field name="is_template"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_biztax_account_mapping_form" model="ir.ui.view">
        <field name="name">biztax.account.mapping.form</field>
        <field name="model">biztax.account.mapping</field>
        <field name="arch" type="xml">
            <form string="Mapping Comptable">
                <sheet>
                    <group>
                        <group string="Compte">
                            <field name="account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Code Fiscal">
                            <field name="tax_code_id"/>
                            <field name="dna_percentage"/>
                            <field name="is_template"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Company Settings Action -->
    <record id="action_biztax_company_settings" model="ir.actions.act_window">
        <field name="name">Paramètres Biztax</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">form</field>
        <field name="res_id" eval="1"/>
        <field name="view_id" ref="view_company_biztax_form"/>
        <field name="target">current</field>
    </record>
    
    <!-- Multi-Company Manager Action -->
    <record id="action_biztax_multicompany_manager" model="ir.actions.act_window">
        <field name="name">Groupes de Sociétés</field>
        <field name="res_model">biztax.multicompany.manager</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- Extra Accounting Action -->
    <record id="action_biztax_extra_accounting" model="ir.actions.act_window">
        <field name="name">Mouvements Extra-Comptables</field>
        <field name="res_model">biztax.extra.accounting</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>
    
    <!-- Loss Carryforward Action -->
    <record id="action_biztax_loss_carryforward" model="ir.actions.act_window">
        <field name="name">Pertes Reportables</field>
        <field name="res_model">biztax.loss.carryforward</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- PCMN Mapping Action -->
    <record id="action_biztax_pcmn_mapping" model="ir.actions.act_window">
        <field name="name">Correspondance PCMN → XBRL</field>
        <field name="res_model">biztax.pcmn.xbrl.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_class': 1}</field>
    </record>
    
    <!-- PCMN Mapping Wizard Action -->
    <record id="action_biztax_pcmn_mapping_wizard" model="ir.actions.act_window">
        <field name="name">Appliquer Mappings PCMN</field>
        <field name="res_model">biztax.pcmn.mapping.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
