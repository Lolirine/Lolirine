<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VUE LISTE EMAILS - Ajouter des colonnes -->
    <record id="view_mail_mail_tree_lolirine" model="ir.ui.view">
        <field name="name">mail.mail.tree.lolirine</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subject']" position="after">
                <field name="email_to" string="Destinataire"/>
                <field name="email_from" string="Expediteur"/>
                <field name="model" string="Modele" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="failure_reason" string="Erreur" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
