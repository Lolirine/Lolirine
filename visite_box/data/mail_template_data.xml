<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Template de confirmation de visite -->
        <record id="mail_template_visite_confirmation" model="mail.template">
            <field name="name">Visite: Confirmation de rendez-vous</field>
            <field name="model_id" ref="model_visite_box"/>
            <field name="subject">Confirmation de votre visite - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
    <p>Bonjour {{ object.partner_id.name }},</p>
    
    <p>Nous vous confirmons votre rendez-vous de visite :</p>
    
    <div style="background-color: #f5f5f5; padding: 15px; border-radius: 5px; margin: 20px 0;">
        <p><strong>📅 Date :</strong> {{ format_datetime(object.date_visite, dt_format='full', tz=user.tz) }}</p>
        <p><strong>📍 Lieu :</strong> Nos locaux de stockage</p>
        <p><strong>⏱️ Durée estimée :</strong> {{ object.duree_visite }} heure(s)</p>
    </div>
    
    <p>Lors de cette visite, nous vous présenterons :</p>
    <ul>
        <li>Nos installations de stockage sécurisées</li>
        <li>Les différentes tailles de box disponibles</li>
        <li>Nos conditions et tarifs</li>
    </ul>
    
    <p><strong>Besoin de modifier ou annuler ?</strong><br/>
    Contactez-nous par téléphone ou répondez simplement à cet email.</p>
    
    <p>À bientôt !</p>
    
    <p>L'équipe {{ object.company_id.name }}</p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Template de rappel de visite -->
        <record id="mail_template_visite_reminder" model="mail.template">
            <field name="name">Visite: Rappel de rendez-vous</field>
            <field name="model_id" ref="model_visite_box"/>
            <field name="subject">Rappel: Votre visite demain - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
    <p>Bonjour {{ object.partner_id.name }},</p>
    
    <p>Nous vous rappelons votre rendez-vous de visite prévu <strong>demain</strong> :</p>
    
    <div style="background-color: #e8f4fd; padding: 15px; border-radius: 5px; margin: 20px 0; border-left: 4px solid #2196F3;">
        <p><strong>📅 Date :</strong> {{ format_datetime(object.date_visite, dt_format='full', tz=user.tz) }}</p>
        <p><strong>📍 Lieu :</strong> Nos locaux de stockage</p>
    </div>
    
    <p><strong>Empêchement ?</strong><br/>
    Merci de nous prévenir dès que possible afin que nous puissions reprogrammer.</p>
    
    <p>À demain !</p>
    
    <p>L'équipe {{ object.company_id.name }}</p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Template après visite -->
        <record id="mail_template_visite_followup" model="mail.template">
            <field name="name">Visite: Suivi post-visite</field>
            <field name="model_id" ref="model_visite_box"/>
            <field name="subject">Suite à votre visite - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
    <p>Bonjour {{ object.partner_id.name }},</p>
    
    <p>Nous vous remercions pour votre visite de nos installations.</p>
    
    <p>Suite à notre échange, voici un récapitulatif :</p>
    
    <div style="background-color: #f5f5f5; padding: 15px; border-radius: 5px; margin: 20px 0;">
        <p><strong>Vos besoins :</strong><br/>{{ object.besoin_description or 'À définir' }}</p>
        <p><strong>Volume estimé :</strong> {{ object.volume_estime }} m³</p>
        <p><strong>Durée prévue :</strong> {{ dict(object._fields['duree_prevue'].selection).get(object.duree_prevue, '') }}</p>
    </div>
    
    <p>N'hésitez pas à nous recontacter pour toute question ou pour finaliser votre réservation.</p>
    
    <p>Cordialement,</p>
    
    <p>{{ object.user_id.name }}<br/>
    {{ object.company_id.name }}</p>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
