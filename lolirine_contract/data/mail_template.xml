<p>Veuillez trouver en piece jointe votre contrat de garde-meubles.</p>
<p>Cordialement,</p>
<p><strong>Lolirine Garde-Meubles</strong><br/>
Tel: 0497/44 41 46<br/>
Email: gardemeublelolirine@gmail.com</p>
</div>
</field>
<field name="report_template_ids" eval="[(4, ref('lolirine_contract.action_report_contract'))]"/>
<field name="auto_delete" eval="False"/>
</record>
</odoo>
