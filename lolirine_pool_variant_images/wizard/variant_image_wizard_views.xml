<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_variant_image_wizard_form" model="ir.ui.view">
        <field name="name">variant.image.wizard.form</field>
        <field name="model">variant.image.wizard</field>
        <field name="arch" type="xml">
            <form string="Images des variantes">
                <div class="alert alert-info" role="alert">
                    <strong>Produit :</strong> <field name="product_tmpl_id" readonly="1" class="fw-bold"/>
                    — <field name="variant_count" readonly="1"/> variantes
                    <br/>
                    <small class="text-muted">
                        Uploadez une image pour chaque combinaison de variante.
                        Quand le client sélectionne une combinaison sur le site web,
                        l'image principale sera remplacée par celle de la variante correspondante.
                    </small>
                </div>

                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="variant_id" column_invisible="1"/>
                        <field name="attribute_values" string="Combinaison" readonly="1"/>
                        <field name="current_image" string="Image actuelle"/>
                        <field name="new_image" string="Nouvelle image"
                               widget="image" options="{'size': [80, 80]}"/>
                        <field name="clear_image" string="Suppr." optional="hide"/>
                    </list>
                </field>

                <footer>
                    <button name="action_apply" string="Appliquer les images" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
