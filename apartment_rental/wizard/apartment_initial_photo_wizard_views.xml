<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="apartment_initial_photo_wizard_view_form" model="ir.ui.view">
        <field name="name">apartment.initial.photo.wizard.form</field>
        <field name="model">apartment.initial.photo.wizard</field>
        <field name="arch" type="xml">
            <form string="Import de photos initiales">
                <group>
                    <group>
                        <field name="property_id" options="{'no_create': True}"/>
                        <field name="taken_date"/>
                    </group>
                    <group>
                        <field name="room_type_id"/>
                        <field name="photo_type"/>
                    </group>
                </group>
                <separator string="Photos à importer"/>
                <field name="photo_ids" widget="many2many_binary" string="Sélectionner les photos"/>
                <footer>
                    <button name="action_import_photos" string="Importer les photos" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="apartment_initial_photo_wizard_action" model="ir.actions.act_window">
        <field name="name">Importer des photos</field>
        <field name="res_model">apartment.initial.photo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_property_id': active_id}</field>
    </record>

</odoo>
