<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Template: Rappel de loyer -->
        <record id="mail_template_rent_reminder" model="mail.template">
            <field name="name">Rappel de loyer</field>
            <field name="model_id" ref="model_apartment_rent"/>
            <field name="subject">Rappel - Loyer {{ object.period_name }} - {{ object.property_id.name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.tenant_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
    <p>Bonjour <t t-out="object.tenant_id.name"/>,</p>
    
    <p>Nous vous rappelons que le loyer suivant est en attente de paiement :</p>
    
    <table style="border-collapse: collapse; margin: 20px 0;">
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Bien</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.property_id.name"/></td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Période</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.period_name"/></td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Montant total</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="&#34;%.2f&#34;|format(object.total_amount)"/> €</td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Reste dû</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd; color: #c00;"><t t-out="&#34;%.2f&#34;|format(object.amount_due)"/> €</td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Échéance</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.date_due"/></td>
        </tr>
    </table>
    
    <p>Nous vous prions de bien vouloir procéder au règlement dans les plus brefs délais.</p>
    
    <p>Cordialement,<br/>
    <t t-out="user.name"/></p>
</div>
            ]]></field>
            <field name="lang">{{ object.tenant_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Template: Notification visite de contrôle -->
        <record id="mail_template_control_visit_notification" model="mail.template">
            <field name="name">Notification visite de contrôle</field>
            <field name="model_id" ref="model_apartment_control_visit"/>
            <field name="subject">Visite de contrôle prévue - {{ object.property_id.name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.tenant_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
    <p>Bonjour <t t-out="object.tenant_id.name"/>,</p>
    
    <p>Nous vous informons qu'une visite de contrôle est prévue à votre logement :</p>
    
    <table style="border-collapse: collapse; margin: 20px 0;">
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Bien</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.property_id.name"/></td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Adresse</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.property_id.street"/>, <t t-out="object.property_id.zip_code"/> <t t-out="object.property_id.city"/></td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Date</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.date"/></td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Type de visite</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="dict(object._fields[&#39;visit_type&#39;].selection).get(object.visit_type)"/></td>
        </tr>
    </table>
    
    <p>Votre présence est souhaitée lors de cette visite. Si la date proposée ne vous convient pas, merci de nous contacter pour convenir d'un autre rendez-vous.</p>
    
    <p>Cordialement,<br/>
    <t t-out="user.name"/></p>
</div>
            ]]></field>
            <field name="lang">{{ object.tenant_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Template: Notification intervention -->
        <record id="mail_template_intervention_notification" model="mail.template">
            <field name="name">Notification intervention</field>
            <field name="model_id" ref="model_apartment_intervention"/>
            <field name="subject">Intervention prévue - {{ object.property_id.name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.lease_id.tenant_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
    <p>Bonjour <t t-out="object.lease_id.tenant_id.name"/>,</p>
    
    <p>Nous vous informons qu'une intervention est prévue à votre logement :</p>
    
    <table style="border-collapse: collapse; margin: 20px 0;">
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Bien</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.property_id.name"/></td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Type</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="dict(object._fields[&#39;intervention_type&#39;].selection).get(object.intervention_type)"/></td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Description</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.title"/></td>
        </tr>
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Date prévue</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.date_planned"/></td>
        </tr>
        {% if object.contractor_id %}
        <tr>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><strong>Intervenant</strong></td>
            <td style="padding: 5px 15px; border: 1px solid #ddd;"><t t-out="object.contractor_id.name"/></td>
        </tr>
        {% endif %}
    </table>
    
    <p>Merci de bien vouloir faciliter l'accès au logement pour cette intervention.</p>
    
    <p>Cordialement,<br/>
    <t t-out="user.name"/></p>
</div>
            ]]></field>
            <field name="lang">{{ object.lease_id.tenant_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Template: Notification indexation -->
        <record id="mail_template_indexation_notification" model="mail.template">
            <field name="name">Notification indexation loyer</field>
            <field name="model_id" ref="model_apartment_lease"/>
            <field name="subject">Indexation de votre loyer - {{ object.property_id.name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.tenant_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
    <p>Bonjour <t t-out="object.tenant_id.name"/>,</p>
    
    <p>Conformément aux dispositions de votre contrat de bail et à la législation en vigueur, nous procédons à l'indexation annuelle de votre loyer.</p>
    
    <p><strong>Nouveau loyer mensuel : <t t-out="&#34;%.2f&#34;|format(object.rent_amount)"/> €</strong></p>
    
    <p>Cette indexation prend effet à compter du <t t-out="object.last_indexation_date"/>.</p>
    
    <p>Pour tout renseignement complémentaire, n'hésitez pas à nous contacter.</p>
    
    <p>Cordialement,<br/>
    <t t-out="user.name"/></p>
</div>
            ]]></field>
            <field name="lang">{{ object.tenant_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
