                <!-- Bouton toggle -->
                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <button type="button" class="s_pool_guides_btn" id="s_pool_guides_toggle">
                            VOIR PLUS DE GUIDES
                        </button>
                    </div>
                </div>

            </div><!-- /container -->

            <!-- Script toggle -->
            <script type="text/javascript">
                (function() {
                    var btn = document.getElementById('s_pool_guides_toggle');
                    if (!btn) return;
                    btn.addEventListener('click', function() {
                        var hidden = document.querySelectorAll('.s_pool_guide_hidden');
                        var isExpanded = btn.getAttribute('data-expanded') === '1';
                        hidden.forEach(function(el) {
                            el.style.display = isExpanded ? 'none' : '';
                        });
                        btn.textContent = isExpanded ? 'VOIR PLUS DE GUIDES' : 'VOIR MOINS DE GUIDES';
                        btn.setAttribute('data-expanded', isExpanded ? '0' : '1');
                    });
                })();
            </script>

        </section><!-- /s_pool_guides -->

        <!-- Vague + formulaire devis -->
        <t t-call="lolirine_pool_website.guide_devis_form"/>

