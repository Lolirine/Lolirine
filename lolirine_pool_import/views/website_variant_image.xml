<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="pool_variant_image_style"
              inherit_id="website.layout"
              name="Pool Variant Image CSS">
        <xpath expr="//head" position="inside">
            <style>
                .pool-variant-thumb {
                    width: 32px; height: 32px;
                    object-fit: cover; border-radius: 4px;
                    margin-right: 6px; vertical-align: middle;
                    border: 1px solid #ddd;
                    transition: border-color .2s, box-shadow .2s;
                }
                .pool-variant-thumb:hover {
                    border-color: #3aadaa;
                    box-shadow: 0 0 0 2px rgba(58,173,170,.25);
                }
                .product_detail_img,
                .o_wsale_product_main_image img {
                    transition: opacity .25s ease;
                }
                input:checked + label .pool-variant-thumb,
                .btn.active .pool-variant-thumb {
                    border-color: #3aadaa;
                    box-shadow: 0 0 0 2px rgba(58,173,170,.4);
                }
            </style>
        </xpath>
    </template>

</odoo>
