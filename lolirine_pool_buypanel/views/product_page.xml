<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         Héritage 1 : website_sale.cta_wrapper
         → Bloc livraison/stock AVANT le bouton panier
         ═══════════════════════════════════════════════════════ -->
    <template id="lolirine_buypanel_delivery"
              inherit_id="website_sale.cta_wrapper"
              active="True">

        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="before">
            <t t-if="website.id == 6">
                <div id="lp_buypanel_delivery"
                     class="lp-buypanel-delivery mb-3"
                     style="display:none;">
                    <div class="lp-stock-line mb-1">
                        <span class="lp-stock-dot"></span>
                        <span class="lp-stock-label"></span>
                        <span class="lp-stock-sub"></span>
                    </div>
                    <div class="lp-delivery-line mb-1">
                        <svg class="lp-icon" viewBox="0 0 16 16" fill="none">
                            <path d="M1 8h9M7 5l3 3-3 3"
                                  stroke="currentColor" stroke-width="1.4"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M10 4h2l2 3v3h-4V4z"
                                  stroke="currentColor" stroke-width="1.4"
                                  stroke-linejoin="round"/>
                            <circle cx="4"  cy="12" r="1.2" stroke="currentColor" stroke-width="1.2"/>
                            <circle cx="12" cy="12" r="1.2" stroke="currentColor" stroke-width="1.2"/>
                        </svg>
                        <span class="lp-delivery-text"></span>
                    </div>
                    <div class="lp-pickup-line">
                        <svg class="lp-icon" viewBox="0 0 16 16" fill="none">
                            <circle cx="8" cy="8" r="5"
                                    stroke="currentColor" stroke-width="1.4"/>
                            <path d="M8 5v3l2 1.5"
                                  stroke="currentColor" stroke-width="1.3"
                                  stroke-linecap="round"/>
                        </svg>
                        <span>Retrait entrepôt Boninne sur RDV</span>
                    </div>
                </div>
            </t>
        </xpath>

    </template>


    <!-- ═══════════════════════════════════════════════════════
         Héritage 2 : website_sale.product
         → Trust badges + infos produit APRÈS le formulaire panier
         ═══════════════════════════════════════════════════════ -->
    <template id="lolirine_buypanel_trust"
              inherit_id="website_sale.product"
              active="True">

        <xpath expr="//form[@t-if='is_add_to_cart_possible']" position="after">
            <t t-if="website.id == 6">

                <!-- Badges de confiance -->
                <div class="lp-trust-grid mt-3">
                    <div class="lp-trust-item">
                        <svg viewBox="0 0 16 16" fill="none">
                            <path d="M8 1l1.8 4H14l-3.4 2.5 1.3 4L8 9.2 4.1 11.5l1.3-4L2 5h4.2z"
                                  stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                        </svg>
                        <div>
                            <strong>Satisfait ou remboursé</strong>
                            <span>30 jours</span>
                        </div>
                    </div>
                    <div class="lp-trust-item">
                        <svg viewBox="0 0 16 16" fill="none">
                            <rect x="2" y="4" width="12" height="9" rx="1.5"
                                  stroke="currentColor" stroke-width="1.2"/>
                            <path d="M5 4V3a3 3 0 016 0v1"
                                  stroke="currentColor" stroke-width="1.2"/>
                            <circle cx="8" cy="8.5" r="1" fill="currentColor"/>
                        </svg>
                        <div>
                            <strong>Paiement sécurisé</strong>
                            <span>SSL 256-bit</span>
                        </div>
                    </div>
                    <div class="lp-trust-item">
                        <svg viewBox="0 0 16 16" fill="none">
                            <path d="M8 1L2 4v5c0 3 2.5 5.5 6 6 3.5-.5 6-3 6-6V4L8 1z"
                                  stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                            <path d="M5.5 8l1.5 1.5L10.5 6"
                                  stroke="currentColor" stroke-width="1.2"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <div>
                            <strong class="lp-warranty-label">Garantie fabricant</strong>
                            <span>SAV Lolirine</span>
                        </div>
                    </div>
                    <div class="lp-trust-item">
                        <svg viewBox="0 0 16 16" fill="none">
                            <circle cx="8" cy="6" r="3"
                                    stroke="currentColor" stroke-width="1.2"/>
                            <path d="M2 14c0-2.5 2.7-4 6-4s6 1.5 6 4"
                                  stroke="currentColor" stroke-width="1.2"
                                  stroke-linecap="round"/>
                        </svg>
                        <div>
                            <strong>Expert piscine</strong>
                            <span>+32 497 44 41 46</span>
                        </div>
                    </div>
                </div>

                <!-- Infos produit rapides -->
                <div id="lp_buypanel_info" class="lp-product-info mt-3" style="display:none;">
                    <div class="lp-info-label">Informations produit</div>
                    <table class="lp-info-table">
                        <tr class="lp-info-ref" style="display:none;">
                            <td>Référence</td>
                            <td class="lp-val-ref"></td>
                        </tr>
                        <tr class="lp-info-brand" style="display:none;">
                            <td>Marque</td>
                            <td class="lp-val-brand"></td>
                        </tr>
                        <tr class="lp-info-warranty" style="display:none;">
                            <td>Garantie</td>
                            <td class="lp-val-warranty"></td>
                        </tr>
                        <tr>
                            <td>Livraison</td>
                            <td class="lp-val-delivery">Offerte dès 499 € HT</td>
                        </tr>
                        <tr>
                            <td>Retours</td>
                            <td>30 jours — conditions générales</td>
                        </tr>
                    </table>
                </div>

                <!-- Barre contact -->
                <div class="lp-contact-bar mt-3">
                    <div>
                        <strong>Une question sur ce produit ?</strong>
                        <span>Nos experts répondent en moins de 2h</span>
                    </div>
                    <a href="/contactus" class="lp-contact-btn">Contacter</a>
                </div>

            </t>
        </xpath>

    </template>


    <!-- ═══════════════════════════════════════════════════════
         Héritage 3 : zone Caractéristiques techniques.
         Champ HTML dédié (x_specs_techniques) rendu en t-field :
         éditable nativement par l'éditeur, distinct de la
         description. S'affiche seulement s'il y a du contenu
         (ou en édition sur le site 6 pour pouvoir le remplir).
         ═══════════════════════════════════════════════════════ -->
    <template id="lolirine_extra_specs_zone"
              inherit_id="website_sale.product"
              active="True">

        <xpath expr="//div[@id='product_full_description']" position="after">
            <section t-if="product.x_specs_techniques or editable"
                     class="o_lp_extra_specs container mt-3"
                     data-name="Caractéristiques techniques">
                <h4 class="mb-3">Caractéristiques techniques</h4>
                <div t-field="product.x_specs_techniques"
                     class="o_lp_specs_content"/>
            </section>
        </xpath>

    </template>
