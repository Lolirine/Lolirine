<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Wizard : Gérer les visuels des valeurs d'attribut            -->
    <!-- ============================================================ -->
    <record id="view_attribute_visual_wizard_form" model="ir.ui.view">
        <field name="name">attribute.visual.wizard.form</field>
        <field name="model">attribute.visual.wizard</field>
        <field name="arch" type="xml">
            <form string="Gérer les visuels">
                <div class="alert alert-info" role="alert">
                    <strong>💡 Conseil :</strong>
                    Assignez une <strong>image</strong> (photo texture/matière) ou une <strong>couleur HTML</strong> 
                    à chaque valeur. L'image a priorité sur la couleur sur le site web.
                    <br/>
                    Produit : <field name="product_tmpl_id" readonly="1" class="fw-bold"/>
                </div>

                <group>
                    <group>
                        <field name="attribute_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="display_type" string="Mode d'affichage"/>
                    </group>
                </group>

                <separator string="Valeurs et visuels"/>

                <field name="line_ids" nolabel="1">
                    <list editable="bottom" decoration-danger="not html_color and not image"
                          decoration-success="image" decoration-info="html_color and not image">
                        <field name="attribute_value_id" column_invisible="1"/>
                        <field name="name" readonly="1" string="Valeur"/>
                        <field name="current_visual" string="Aperçu actuel"/>
                        <field name="html_color" string="Couleur HTML"
                               widget="color"/>
                        <field name="image" string="Image/Texture"
                               widget="image" options="{'size': [80, 80]}"/>
                        <field name="generate_color_image" string="Auto-générer"
                               help="Cocher pour générer une image à partir de la couleur"/>
                    </list>
                </field>

                <footer>
                    <button name="action_apply" string="✅ Appliquer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
