<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- DASHBOARD DROPSHIPPING -->
    <!-- ============================================ -->

    <!-- Kanban Dashboard -->
    <record id="view_dropship_dashboard_kanban" model="ir.ui.view">
        <field name="name">dropship.dashboard.kanban</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard o_dropship_dashboard" create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="dropship_status"/>
                <field name="dropship_margin_percent"/>
                <field name="date_order"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="row">
                            <div class="col-6">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="col-6 text-end">
                                <field name="dropship_status" widget="badge"
                                       decoration-info="dropship_status in ('pending', 'analyzed')"
                                       decoration-warning="dropship_status in ('supplier_selected', 'po_created')"
                                       decoration-success="dropship_status in ('po_sent', 'shipped', 'delivered')"
                                       decoration-danger="dropship_status == 'issue'"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <field name="partner_id"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <span class="text-muted">Montant:</span>
                                <field name="amount_total" widget="monetary"/>
                            </div>
                            <div class="col-6">
                                <span class="text-muted">Marge:</span>
                                <field name="dropship_margin_percent"/>%
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12 text-muted small">
                                <field name="date_order"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action Dashboard -->
    <record id="action_dropship_dashboard" model="ir.actions.act_window">
        <field name="name">Tableau de bord Dropshipping</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="domain">[('is_dropship_order', '=', True)]</field>
        <field name="context">{
            'search_default_dropship': 1,
            'kanban_view_ref': 'lolirine_pool_dropship.view_dropship_dashboard_kanban'
        }</field>
    </record>

    <!-- Pivot Analysis - Marges par fournisseur -->
    <record id="view_dropship_margin_analysis_pivot" model="ir.ui.view">
        <field name="name">dropship.margin.analysis.pivot</field>
        <field name="model">dropship.decision.log</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des marges" display_quantity="true">
                <field name="selected_supplier_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="decision_date" interval="month" type="col"/>
                <field name="margin_amount" type="measure"/>
                <field name="margin_percent" type="measure"/>
                <field name="sale_price" type="measure"/>
                <field name="supplier_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph - Évolution des marges -->
    <record id="view_dropship_margin_evolution_graph" model="ir.ui.view">
        <field name="name">dropship.margin.evolution.graph</field>
        <field name="model">dropship.decision.log</field>
        <field name="arch" type="xml">
            <graph string="Évolution des marges" type="line">
                <field name="decision_date" interval="week"/>
                <field name="margin_percent" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action - Analyse des marges -->
    <record id="action_dropship_margin_analysis" model="ir.actions.act_window">
        <field name="name">Analyse des marges</field>
        <field name="res_model">dropship.decision.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_dropship_margin_analysis_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_dropship_margin_evolution_graph')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_dropship_decision_log_tree')})]"/>
    </record>

    <!-- Pivot - Performance fournisseurs -->
    <record id="view_dropship_supplier_performance_pivot" model="ir.ui.view">
        <field name="name">dropship.supplier.performance.pivot</field>
        <field name="model">dropship.decision.log</field>
        <field name="arch" type="xml">
            <pivot string="Performance fournisseurs">
                <field name="selected_supplier_id" type="row"/>
                <field name="sale_price" type="measure"/>
                <field name="supplier_cost" type="measure"/>
                <field name="margin_amount" type="measure"/>
                <field name="margin_percent" type="measure"/>
                <field name="alternatives_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action - Performance fournisseurs -->
    <record id="action_dropship_supplier_performance" model="ir.actions.act_window">
        <field name="name">Performance fournisseurs</field>
        <field name="res_model">dropship.decision.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_dropship_supplier_performance_pivot')})]"/>
        <field name="context">{'search_default_group_supplier': 1}</field>
    </record>

</odoo>
