<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== -->
    <!-- CATÉGORIES PISCINE    -->
    <!-- ===================== -->

    <record id="pool_product_category_view_form" model="ir.ui.view">
        <field name="name">pool.product.category.form</field>
        <field name="model">pool.product.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie Piscine">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" 
                                name="action_view_products"
                                class="oe_stat_button" 
                                icon="fa-cubes"
                                invisible="product_count == 0">
                            <field name="product_count" widget="statinfo" string="Produits"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la catégorie"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="product_category_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="icon" placeholder="fa-cube"/>
                            <field name="color" widget="color"/>
                            <field name="image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pool_product_category_view_tree" model="ir.ui.view">
        <field name="name">pool.product.category.tree</field>
        <field name="model">pool.product.category</field>
        <field name="arch" type="xml">
            <list string="Catégories Piscine">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <record id="pool_product_category_action" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">pool.product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== -->
    <!-- MARQUES PISCINE       -->
    <!-- ===================== -->

    <record id="pool_brand_view_form" model="ir.ui.view">
        <field name="name">pool.brand.form</field>
        <field name="model">pool.brand</field>
        <field name="arch" type="xml">
            <form string="Marque Piscine">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Produits"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la marque"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="website_url" widget="url"/>
                            <field name="main_supplier_id"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pool_brand_view_tree" model="ir.ui.view">
        <field name="name">pool.brand.tree</field>
        <field name="model">pool.brand</field>
        <field name="arch" type="xml">
            <list string="Marques Piscine">
                <field name="sequence" widget="handle"/>
                <field name="logo" widget="image" class="oe_avatar"/>
                <field name="name"/>
                <field name="code"/>
                <field name="main_supplier_id"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <record id="pool_brand_view_kanban" model="ir.ui.view">
        <field name="name">pool.brand.kanban</field>
        <field name="model">pool.brand</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="logo"/>
                <field name="product_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="logo" widget="image" class="o_kanban_image me-3"/>
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted">
                                    <field name="product_count"/> produits
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="pool_brand_action" model="ir.actions.act_window">
        <field name="name">Marques</field>
        <field name="res_model">pool.brand</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- ===================== -->
    <!-- ATTRIBUTS PISCINE     -->
    <!-- ===================== -->

    <record id="pool_attribute_view_form" model="ir.ui.view">
        <field name="name">pool.attribute.form</field>
        <field name="model">pool.attribute</field>
        <field name="arch" type="xml">
            <form string="Attribut Piscine">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="attribute_type"/>
                            <field name="unit"/>
                        </group>
                    </group>
                    <group string="Valeurs possibles" invisible="attribute_type != 'selection'">
                        <field name="value_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="code"/>
                            </list>
                        </field>
                    </group>
                    <group string="Catégories concernées">
                        <field name="category_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pool_attribute_view_tree" model="ir.ui.view">
        <field name="name">pool.attribute.tree</field>
        <field name="model">pool.attribute</field>
        <field name="arch" type="xml">
            <list string="Attributs Piscine">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="attribute_type"/>
                <field name="unit"/>
            </list>
        </field>
    </record>

    <record id="pool_attribute_action" model="ir.actions.act_window">
        <field name="name">Attributs techniques</field>
        <field name="res_model">pool.attribute</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== -->
    <!-- EXTENSION PRODUIT     -->
    <!-- ===================== -->

    <!-- 
    NOTE: Vue héritée désactivée temporairement - les xpath peuvent avoir changé en Odoo 19.
    À réactiver après vérification des noms de pages/champs dans product.product_template_only_form_view
    
    <record id="product_template_form_view_pool" model="ir.ui.view">
        <field name="name">product.template.form.pool</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Piscine" name="pool" invisible="not is_pool_product">
                    <group>
                        <group string="Classification">
                            <field name="is_pool_product" invisible="1"/>
                            <field name="pool_brand_id"/>
                            <field name="pool_category_id"/>
                            <field name="main_pool_supplier_id" readonly="1"/>
                        </group>
                        <group string="Caractéristiques techniques">
                            <field name="pool_volume"/>
                            <field name="pool_flow_rate"/>
                            <field name="pool_power"/>
                            <field name="pool_warranty"/>
                        </group>
                    </group>
                    <group string="Compatibilité">
                        <field name="pool_compatibility" nolabel="1"/>
                    </group>
                    <group string="Stock fournisseur">
                        <field name="supplier_stock_available" readonly="1"/>
                        <field name="supplier_lead_time" readonly="1"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="is_pool_product"/>
            </xpath>
        </field>
    </record>
    -->

    <!-- Filtre produits piscine -->
    <!-- 
    NOTE: Vue héritée désactivée temporairement - les filtres consumable/categ_id 
    peuvent avoir changé de nom en Odoo 19. À réactiver après vérification.
    
    <record id="product_template_search_view_pool" model="ir.ui.view">
        <field name="name">product.template.search.pool</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='consumable']" position="after">
                <separator/>
                <filter string="Produits piscine" name="pool_products" domain="[('is_pool_product', '=', True)]"/>
            </xpath>
            <xpath expr="//filter[@name='categ_id']" position="after">
                <filter string="Marque piscine" name="group_pool_brand" context="{'group_by': 'pool_brand_id'}"/>
            </xpath>
        </field>
    </record>
    -->

    <!-- Action produits piscine -->
    <record id="pool_product_action" model="ir.actions.act_window">
        <field name="name">Produits Piscine</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_pool_product', '=', True)]</field>
        <field name="context">{'default_is_pool_product': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre premier produit piscine
            </p>
            <p>
                Importez vos catalogues fournisseurs ou créez des produits manuellement.
            </p>
        </field>
    </record>

</odoo>
