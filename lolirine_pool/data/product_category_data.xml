<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Catégorie racine produits piscine -->
        <record id="product_category_pool" model="product.category">
            <field name="name">Piscine</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <!-- Sous-catégories Odoo -->
        <record id="product_category_pool_filtration" model="product.category">
            <field name="name">Filtration</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_pompes" model="product.category">
            <field name="name">Pompes</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_robots" model="product.category">
            <field name="name">Robots &amp; Nettoyage</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_traitement" model="product.category">
            <field name="name">Traitement de l'eau</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_chauffage" model="product.category">
            <field name="name">Chauffage</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_couvertures" model="product.category">
            <field name="name">Couvertures &amp; Volets</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_accessoires" model="product.category">
            <field name="name">Accessoires</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_construction" model="product.category">
            <field name="name">Construction &amp; Rénovation</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_spa" model="product.category">
            <field name="name">Spa &amp; Bien-être</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <!-- Catégories piscine internes -->
        <record id="pool_category_filtration" model="pool.product.category">
            <field name="name">Filtration</field>
            <field name="code">FILT</field>
            <field name="sequence">10</field>
            <field name="icon">fa-filter</field>
            <field name="product_category_id" ref="product_category_pool_filtration"/>
            <field name="description">Filtres à sable, cartouche, diatomées et accessoires de filtration</field>
        </record>

        <record id="pool_category_pompes" model="pool.product.category">
            <field name="name">Pompes</field>
            <field name="code">PUMP</field>
            <field name="sequence">20</field>
            <field name="icon">fa-cog</field>
            <field name="product_category_id" ref="product_category_pool_pompes"/>
            <field name="description">Pompes de filtration, circulation, doseuses et pièces détachées</field>
        </record>

        <record id="pool_category_robots" model="pool.product.category">
            <field name="name">Robots &amp; Nettoyage</field>
            <field name="code">ROBOT</field>
            <field name="sequence">30</field>
            <field name="icon">fa-robot</field>
            <field name="product_category_id" ref="product_category_pool_robots"/>
            <field name="description">Robots électriques, hydrauliques, balais manuels et épuisettes</field>
        </record>

        <record id="pool_category_traitement" model="pool.product.category">
            <field name="name">Traitement de l'eau</field>
            <field name="code">TREAT</field>
            <field name="sequence">40</field>
            <field name="icon">fa-flask</field>
            <field name="product_category_id" ref="product_category_pool_traitement"/>
            <field name="description">Chlore, pH, électrolyseurs, UV, analyseurs et produits chimiques</field>
        </record>

        <record id="pool_category_chauffage" model="pool.product.category">
            <field name="name">Chauffage</field>
            <field name="code">HEAT</field>
            <field name="sequence">50</field>
            <field name="icon">fa-fire</field>
            <field name="product_category_id" ref="product_category_pool_chauffage"/>
            <field name="description">Pompes à chaleur, réchauffeurs, échangeurs et capteurs solaires</field>
        </record>

        <record id="pool_category_couvertures" model="pool.product.category">
            <field name="name">Couvertures &amp; Volets</field>
            <field name="code">COVER</field>
            <field name="sequence">60</field>
            <field name="icon">fa-shield-alt</field>
            <field name="product_category_id" ref="product_category_pool_couvertures"/>
            <field name="description">Bâches, volets roulants, couvertures à barres et automatiques</field>
        </record>

        <record id="pool_category_accessoires" model="pool.product.category">
            <field name="name">Accessoires</field>
            <field name="code">ACC</field>
            <field name="sequence">70</field>
            <field name="icon">fa-puzzle-piece</field>
            <field name="product_category_id" ref="product_category_pool_accessoires"/>
            <field name="description">Échelles, douches, éclairage LED, jeux d'eau et mobilier</field>
        </record>

        <record id="pool_category_construction" model="pool.product.category">
            <field name="name">Construction &amp; Rénovation</field>
            <field name="code">CONST</field>
            <field name="sequence">80</field>
            <field name="icon">fa-wrench</field>
            <field name="product_category_id" ref="product_category_pool_construction"/>
            <field name="description">Liners, skimmers, buses, pièces à sceller, colles, joints</field>
        </record>

        <record id="pool_category_spa" model="pool.product.category">
            <field name="name">Spa &amp; Bien-être</field>
            <field name="code">SPA</field>
            <field name="sequence">90</field>
            <field name="icon">fa-bath</field>
            <field name="product_category_id" ref="product_category_pool_spa"/>
            <field name="description">Spas, saunas, hammams et accessoires bien-être</field>
        </record>

        <!-- Marques préconfigurées -->
        <record id="pool_brand_astralpool" model="pool.brand">
            <field name="name">AstralPool</field>
            <field name="code">ASTRAL</field>
            <field name="sequence">10</field>
            <field name="website_url">https://www.astralpool.com</field>
        </record>

        <record id="pool_brand_zodiac" model="pool.brand">
            <field name="name">Zodiac</field>
            <field name="code">ZODIAC</field>
            <field name="sequence">20</field>
            <field name="website_url">https://www.zodiac.com</field>
        </record>

        <record id="pool_brand_hayward" model="pool.brand">
            <field name="name">Hayward</field>
            <field name="code">HAYWARD</field>
            <field name="sequence">30</field>
            <field name="website_url">https://www.hayward-pool.com</field>
        </record>

        <record id="pool_brand_pentair" model="pool.brand">
            <field name="name">Pentair</field>
            <field name="code">PENTAIR</field>
            <field name="sequence">40</field>
            <field name="website_url">https://www.pentair.com</field>
        </record>

        <record id="pool_brand_dolphin" model="pool.brand">
            <field name="name">Dolphin (Maytronics)</field>
            <field name="code">DOLPHIN</field>
            <field name="sequence">50</field>
            <field name="website_url">https://www.maytronics.com</field>
        </record>

        <record id="pool_brand_bayrol" model="pool.brand">
            <field name="name">Bayrol</field>
            <field name="code">BAYROL</field>
            <field name="sequence">60</field>
            <field name="website_url">https://www.bayrol.com</field>
        </record>

    </data>
</odoo>
