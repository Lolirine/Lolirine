<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Catégorie racine Odoo -->
        <record id="product_category_pool" model="product.category">
            <field name="name">Matériel Piscine</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>

        <!-- Sous-catégories principales Odoo -->
        <record id="product_category_pool_filtration" model="product.category">
            <field name="name">Filtration</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_pumps" model="product.category">
            <field name="name">Pompes</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_robots" model="product.category">
            <field name="name">Robots &amp; Nettoyage</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_treatment" model="product.category">
            <field name="name">Traitement de l'eau</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_heating" model="product.category">
            <field name="name">Chauffage</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_covers" model="product.category">
            <field name="name">Couvertures &amp; Volets</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_accessories" model="product.category">
            <field name="name">Accessoires</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_construction" model="product.category">
            <field name="name">Construction &amp; Rénovation</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <record id="product_category_pool_spa" model="product.category">
            <field name="name">Spa &amp; Bien-être</field>
            <field name="parent_id" ref="product_category_pool"/>
        </record>

        <!-- Catégories piscine (modèle custom) -->
        <record id="pool_category_filtration" model="pool.product.category">
            <field name="name">Filtration</field>
            <field name="code">FILT</field>
            <field name="sequence">10</field>
            <field name="icon">fa-filter</field>
            <field name="product_category_id" ref="product_category_pool_filtration"/>
            <field name="description">Filtres à sable, cartouche, diatomées et accessoires de filtration</field>
        </record>

        <record id="pool_category_pumps" model="pool.product.category">
            <field name="name">Pompes</field>
            <field name="code">PUMP</field>
            <field name="sequence">20</field>
            <field name="icon">fa-cogs</field>
            <field name="product_category_id" ref="product_category_pool_pumps"/>
            <field name="description">Pompes de filtration, pompes à chaleur, surpresseurs</field>
        </record>

        <record id="pool_category_robots" model="pool.product.category">
            <field name="name">Robots &amp; Nettoyage</field>
            <field name="code">ROBOT</field>
            <field name="sequence">30</field>
            <field name="icon">fa-android</field>
            <field name="product_category_id" ref="product_category_pool_robots"/>
            <field name="description">Robots électriques, hydrauliques, épuisettes, brosses</field>
        </record>

        <record id="pool_category_treatment" model="pool.product.category">
            <field name="name">Traitement de l'eau</field>
            <field name="code">TREAT</field>
            <field name="sequence">40</field>
            <field name="icon">fa-tint</field>
            <field name="product_category_id" ref="product_category_pool_treatment"/>
            <field name="description">Chlore, pH, électrolyseurs, régulateurs automatiques</field>
        </record>

        <record id="pool_category_heating" model="pool.product.category">
            <field name="name">Chauffage</field>
            <field name="code">HEAT</field>
            <field name="sequence">50</field>
            <field name="icon">fa-thermometer-half</field>
            <field name="product_category_id" ref="product_category_pool_heating"/>
            <field name="description">Pompes à chaleur, réchauffeurs, échangeurs, capteurs solaires</field>
        </record>

        <record id="pool_category_covers" model="pool.product.category">
            <field name="name">Couvertures &amp; Volets</field>
            <field name="code">COVER</field>
            <field name="sequence">60</field>
            <field name="icon">fa-shield</field>
            <field name="product_category_id" ref="product_category_pool_covers"/>
            <field name="description">Bâches, volets roulants, couvertures automatiques</field>
        </record>

        <record id="pool_category_accessories" model="pool.product.category">
            <field name="name">Accessoires</field>
            <field name="code">ACCESS</field>
            <field name="sequence">70</field>
            <field name="icon">fa-plus-circle</field>
            <field name="product_category_id" ref="product_category_pool_accessories"/>
            <field name="description">Échelles, plongeoirs, éclairage, douches, mobilier</field>
        </record>

        <record id="pool_category_construction" model="pool.product.category">
            <field name="name">Construction &amp; Rénovation</field>
            <field name="code">CONST</field>
            <field name="sequence">80</field>
            <field name="icon">fa-wrench</field>
            <field name="product_category_id" ref="product_category_pool_construction"/>
            <field name="description">Liners, skimmers, buses, pièces à sceller, colles, joints</field>
        </record>

        <record id="pool_category_spa" model="pool.product.category">
            <field name="name">Spa &amp; Bien-être</field>
            <field name="code">SPA</field>
            <field name="sequence">90</field>
            <field name="icon">fa-bath</field>
            <field name="product_category_id" ref="product_category_pool_spa"/>
            <field name="description">Spas, saunas, hammams et accessoires bien-être</field>
        </record>

    </data>
</odoo>
