<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Groupe Utilisateur -->
        <record id="group_apartment_rental_user" model="res.groups">
            <field name="name">Gestion Locative / Utilisateur</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe Manager -->
        <record id="group_apartment_rental_manager" model="res.groups">
            <field name="name">Gestion Locative / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_apartment_rental_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
