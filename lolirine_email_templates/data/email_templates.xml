        <!-- ============================================================ -->
        <!-- Email Template: Annonce Portail - Basé sur Abonnements       -->
        <!-- Version compatible Gmail/Outlook - Sans CSS avancé           -->
        <!-- ============================================================ -->
        <record id="email_template_annonce_portail_subscription" model="mail.template">
            <field name="name">Lolirine - Annonce Portail Client (Abonnements)</field>
            <field name="model_id" ref="sale_subscription.model_sale_order"/>
            <field name="subject">Lolirine évolue : Découvrez votre nouvel espace client en ligne</field>
            <field name="email_from">gardemeublelolirine@gmail.com</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f5f5f5" style="font-family: Arial, Helvetica, sans-serif;">
    <tr>
        <td align="center" style="padding: 20px 0;">
            <table width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="border-radius: 8px;">
                
                <!-- Header Rouge -->
                <tr>
                    <td align="center" bgcolor="#C91E18" style="padding: 30px 40px;">
                        <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold;">LOLIRINE</h1>
                        <p style="margin: 10px 0 0 0; color: #ffcccc; font-size: 14px; letter-spacing: 1px;">GARDE-MEUBLES</p>
                    </td>
                </tr>
                
                <!-- Contenu Principal -->
                <tr>
                    <td style="padding: 40px;">
                        <p style="margin: 0 0 20px 0; color: #333333; font-size: 16px; line-height: 1.6;">
                            Bonjour <t t-out="object.partner_id.name or 'cher(e) client(e)'"/>,
                        </p>
                        
                        <p style="margin: 0 0 20px 0; color: #555555; font-size: 15px; line-height: 1.7;">
                            Nous avons le plaisir de vous annoncer une évolution importante dans la gestion de nos services de garde-meubles.
                        </p>
                        
                        <!-- Box Highlight -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td bgcolor="#fce8e8" style="padding: 20px; border-left: 4px solid #C91E18;">
                                    <p style="margin: 0; color: #8b1510; font-size: 18px; font-weight: bold;">
                                        🚀 Lolirine se digitalise pour mieux vous servir.
                                    </p>
                                </td>
                            </tr>
                        </table>
                        
                        <p style="margin: 25px 0 20px 0; color: #555555; font-size: 15px; line-height: 1.7;">
                            Dans les prochaines semaines, nous mettons en place une nouvelle plateforme de gestion qui vous permettra de gérer votre abonnement en toute autonomie, <strong>24h/24 et 7j/7</strong>.
                        </p>
                        
                        <!-- Section: Ce qui change -->
                        <h2 style="margin: 30px 0 15px 0; color: #8b1510; font-size: 18px; font-weight: bold; border-bottom: 2px solid #C91E18; padding-bottom: 8px;">
                            ✨ Ce qui change pour vous
                        </h2>
                        
                        <p style="margin: 0 0 15px 0; color: #555555; font-size: 15px; line-height: 1.7;">
                            Une fois inscrit(e), vous pourrez :
                        </p>
                        
                        <p style="margin: 0 0 8px 0; padding-left: 20px; color: #555555; font-size: 14px;">
                            <span style="color: #C91E18; font-weight: bold;">✓</span> Consulter les détails de votre contrat et votre historique
                        </p>
                        <p style="margin: 0 0 8px 0; padding-left: 20px; color: #555555; font-size: 14px;">
                            <span style="color: #C91E18; font-weight: bold;">✓</span> Télécharger vos factures à tout moment
                        </p>
                        <p style="margin: 0 0 8px 0; padding-left: 20px; color: #555555; font-size: 14px;">
                            <span style="color: #C91E18; font-weight: bold;">✓</span> Suivre vos paiements en temps réel
                        </p>
                        <p style="margin: 0 0 8px 0; padding-left: 20px; color: #555555; font-size: 14px;">
                            <span style="color: #C91E18; font-weight: bold;">✓</span> Mettre à jour vos informations personnelles
                        </p>
                        <p style="margin: 0 0 8px 0; padding-left: 20px; color: #555555; font-size: 14px;">
                            <span style="color: #C91E18; font-weight: bold;">✓</span> Communiquer directement avec notre équipe
                        </p>
                        
                        <!-- Bouton CTA -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 35px 0;">
                            <tr>
                                <td align="center">
                                    <table cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td align="center" bgcolor="#C91E18" style="border-radius: 8px;">
                                                <a t-att-href="object.get_portal_url()" target="_blank" style="display: inline-block; padding: 18px 45px; font-size: 16px; font-weight: bold; color: #ffffff; text-decoration: none; border-radius: 8px;">
                                                    🔐 Accéder à mon espace client
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                    <p style="margin: 12px 0 0 0; color: #999999; font-size: 12px;">
                                        Cliquez pour créer votre mot de passe et accéder à votre espace
                                    </p>
                                </td>
                            </tr>
                        </table>
                        
                        <!-- Box Info Abonnement -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td bgcolor="#fff8e1" style="padding: 15px 20px; border-left: 4px solid #f39c12;">
                                    <p style="margin: 0; color: #7f6003; font-size: 14px;">
                                        <strong>📋 Votre abonnement :</strong> <t t-out="object.name"/>
                                    </p>
                                </td>
                            </tr>
                        </table>
                        
                        <!-- Section: Ce qui ne change pas -->
                        <h2 style="margin: 30px 0 15px 0; color: #1e7e34; font-size: 18px; font-weight: bold; border-bottom: 2px solid #27ae60; padding-bottom: 8px;">
                            🔒 Ce qui ne change pas
                        </h2>
                        
                        <p style="margin: 0 0 20px 0; color: #555555; font-size: 15px; line-height: 1.7;">
                            Votre box de stockage, vos conditions tarifaires et la qualité de notre service restent identiques. Cette transition est purement administrative et vise à simplifier votre expérience client.
                        </p>
                        
                        <!-- Section: Prochaines étapes -->
                        <h2 style="margin: 30px 0 15px 0; color: #8b1510; font-size: 18px; font-weight: bold; border-bottom: 2px solid #C91E18; padding-bottom: 8px;">
                            📋 Prochaines étapes
                        </h2>
                        
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="40" valign="top" style="padding: 10px 0;">
                                    <table cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td align="center" bgcolor="#C91E18" width="28" height="28" style="border-radius: 50%; color: #ffffff; font-weight: bold; font-size: 14px;">1</td>
                                        </tr>
                                    </table>
                                </td>
                                <td valign="top" style="padding: 10px 0; color: #555555; font-size: 14px; line-height: 1.6;">
                                    <strong>Cliquez sur le bouton ci-dessus</strong><br/>
                                    Accédez à la page d'activation de votre compte
                                </td>
                            </tr>
                            <tr>
                                <td width="40" valign="top" style="padding: 10px 0;">
                                    <table cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td align="center" bgcolor="#C91E18" width="28" height="28" style="border-radius: 50%; color: #ffffff; font-weight: bold; font-size: 14px;">2</td>
                                        </tr>
                                    </table>
                                </td>
                                <td valign="top" style="padding: 10px 0; color: #555555; font-size: 14px; line-height: 1.6;">
                                    <strong>Créez votre mot de passe</strong><br/>
                                    Définissez votre mot de passe personnel en quelques clics
                                </td>
                            </tr>
                            <tr>
                                <td width="40" valign="top" style="padding: 10px 0;">
                                    <table cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td align="center" bgcolor="#27ae60" width="28" height="28" style="border-radius: 50%; color: #ffffff; font-weight: bold; font-size: 14px;">✓</td>
                                        </tr>
                                    </table>
                                </td>
                                <td valign="top" style="padding: 10px 0; color: #555555; font-size: 14px; line-height: 1.6;">
                                    <strong>Accédez à votre espace</strong><br/>
                                    Gérez votre abonnement en toute autonomie !
                                </td>
                            </tr>
                        </table>
                        
                        <!-- Box Contact -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 30px;">
                            <tr>
                                <td bgcolor="#f8f9fa" style="padding: 20px; border-radius: 8px;">
                                    <p style="margin: 0 0 10px 0; color: #333333; font-size: 15px;">
                                        <strong>Des questions ?</strong> N'hésitez pas à nous contacter :
                                    </p>
                                    <p style="margin: 5px 0; color: #555555; font-size: 14px;">
                                        📧 <a href="mailto:gardemeublelolirine@gmail.com" style="color: #C91E18; text-decoration: none;">gardemeublelolirine@gmail.com</a>
                                    </p>
                                    <p style="margin: 5px 0; color: #555555; font-size: 14px;">
                                        📞 <a href="tel:+32497444146" style="color: #C91E18; text-decoration: none;">0497/444146</a>
                                    </p>
                                </td>
                            </tr>
                        </table>
                        
                        <p style="margin: 30px 0 0 0; color: #555555; font-size: 15px; line-height: 1.7;">
                            Nous vous remercions de votre confiance et restons à votre disposition.
                        </p>
                        
                        <p style="margin: 20px 0 0 0; color: #333333; font-size: 15px;">
                            Bien cordialement,
                        </p>
                        <p style="margin: 5px 0 0 0; color: #C91E18; font-size: 16px; font-weight: bold;">
                            L'équipe Lolirine
                        </p>
                    </td>
                </tr>
                
                <!-- Footer -->
                <tr>
                    <td align="center" bgcolor="#8b1510" style="padding: 25px 40px;">
                        <p style="margin: 0 0 10px 0; color: #ffffff; font-size: 16px; font-weight: bold;">
                            Lolirine SPRL
                        </p>
                        <p style="margin: 0 0 5px 0; color: #ffcccc; font-size: 13px;">
                            📍 Boninne, Belgique
                        </p>
                        <p style="margin: 0 0 5px 0; color: #ffcccc; font-size: 13px;">
                            📧 gardemeublelolirine@gmail.com | 📞 0497/444146
                        </p>
                        <p style="margin: 15px 0 0 0; color: #cc9999; font-size: 11px;">
                            © 2025 Lolirine SPRL - Tous droits réservés
                        </p>
                    </td>
                </tr>
                
            </table>
        </td>
    </tr>
</table>
            </field>
        </record>


