<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue formulaire -->
    <record id="view_lolirine_popup_config_form" model="ir.ui.view">
        <field name="name">lolirine.popup.config.form</field>
        <field name="model">lolirine.popup.config</field>
        <field name="arch" type="xml">
            <form string="Configuration Popup">
                <header>
                    <button name="action_activate" string="Activer" type="object" 
                            class="btn-primary" invisible="active"/>
                    <button name="action_deactivate" string="Désactiver" type="object" 
                            class="btn-secondary" invisible="not active"/>
                    <button name="action_duplicate" string="Dupliquer" type="object" 
                            class="btn-secondary"/>
                    <button name="action_reset_stats" string="Réinitialiser stats" type="object" 
                            class="btn-secondary" confirm="Voulez-vous vraiment réinitialiser les statistiques ?"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-eye" disabled="1">
                            <field name="view_count" string="Vues" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-mouse-pointer" disabled="1">
                            <field name="click_count" string="Clics" widget="statinfo"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Titre du popup"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="🎯 Type de Popup">
                            <field name="popup_type" widget="radio"/>
                            <field name="sequence" string="Priorité (1=haute)"/>
                        </group>
                        <group string="📝 Message">
                            <field name="subtitle" widget="text" placeholder="Message affiché dans le popup..."/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Onglet Popup Standard -->
                        <page string="🔘 Boutons" name="buttons" invisible="popup_type != 'standard'">
                            <group>
                                <group string="Bouton principal">
                                    <field name="button_text"/>
                                    <field name="button_url"/>
                                    <field name="button_target"/>
                                </group>
                                <group string="Bouton secondaire">
                                    <field name="show_secondary_button"/>
                                    <field name="secondary_button_text" invisible="not show_secondary_button"/>
                                    <field name="secondary_button_url" invisible="not show_secondary_button"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Onglet Boxes Disponibles -->
                        <page string="📦 Boxes Disponibles" name="boxes_config" invisible="popup_type != 'available_boxes'">
                            <group>
                                <group string="Affichage">
                                    <field name="max_boxes_display"/>
                                    <field name="show_box_price"/>
                                    <field name="show_box_size"/>
                                </group>
                                <group string="Action">
                                    <field name="boxes_button_text"/>
                                    <field name="boxes_contact_url"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle me-2"/>
                                <strong>Note :</strong> Ce popup affichera automatiquement les boxes avec le statut "Disponible" 
                                et publiés sur le site web. Les boxes sont triés par prix croissant.
                            </div>
                        </page>
                        
                        <!-- Onglet Pages d'affichage -->
                        <page string="📄 Pages d'affichage" name="display_pages">
                            <group>
                                <group string="Mode d'affichage">
                                    <field name="display_mode" widget="radio"/>
                                </group>
                                <group string="Timing">
                                    <field name="show_delay"/>
                                    <field name="hide_duration"/>
                                </group>
                            </group>
                            
                            <!-- Pages spécifiques -->
                            <group string="📑 Pages sélectionnées" invisible="display_mode != 'pages'">
                                <field name="page_ids" widget="many2many_tags" 
                                       options="{'color_field': 'color'}"
                                       placeholder="Cliquez pour ajouter des pages..."/>
                            </group>
                            
                            <!-- Catégories de produits -->
                            <group string="🏷️ Catégories de produits" invisible="display_mode != 'categories'">
                                <field name="category_ids" widget="many2many_tags"
                                       placeholder="Cliquez pour ajouter des catégories..."/>
                            </group>
                            
                            <!-- URLs personnalisées -->
                            <group string="🔗 URLs personnalisées" invisible="display_mode != 'urls'">
                                <field name="specific_urls" 
                                       placeholder="/ma-page&#10;/autre-page&#10;/shop/promotion"/>
                            </group>
                            
                            <div class="alert alert-warning" role="alert" invisible="display_mode not in ['pages', 'categories', 'urls']">
                                <i class="fa fa-lightbulb-o me-2"/>
                                <strong>Astuce :</strong> 
                                <span invisible="display_mode != 'pages'">Utilisez la recherche pour trouver les pages du site web.</span>
                                <span invisible="display_mode != 'categories'">Sélectionnez les catégories de produits e-commerce.</span>
                                <span invisible="display_mode != 'urls'">Entrez une URL par ligne, commençant par /</span>
                            </div>
                        </page>
                        
                        <!-- Onglet Style -->
                        <page string="🎨 Style" name="style">
                            <group>
                                <group>
                                    <field name="background_color" widget="color"/>
                                    <field name="text_color" widget="color"/>
                                </group>
                                <group>
                                    <field name="background_image" widget="image" class="oe_avatar"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Vue liste -->
    <record id="view_lolirine_popup_config_list" model="ir.ui.view">
        <field name="name">lolirine.popup.config.list</field>
        <field name="model">lolirine.popup.config</field>
        <field name="arch" type="xml">
            <list string="Popups" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="popup_type" optional="show"/>
                <field name="display_mode"/>
                <field name="page_count" string="Pages" invisible="display_mode != 'pages'"/>
                <field name="category_count" string="Catégories" invisible="display_mode != 'categories'"/>
                <field name="show_delay" optional="hide"/>
                <field name="view_count" string="Vues"/>
                <field name="click_count" string="Clics"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <!-- Vue Kanban -->
    <record id="view_lolirine_popup_config_kanban" model="ir.ui.view">
        <field name="name">lolirine.popup.config.kanban</field>
        <field name="model">lolirine.popup.config</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="title"/>
                <field name="popup_type"/>
                <field name="active"/>
                <field name="view_count"/>
                <field name="click_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="title"/>
                                        </strong>
                                    </div>
                                    <field name="active" widget="boolean_toggle"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span class="badge bg-primary me-1">
                                        <field name="popup_type"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="me-2"><i class="fa fa-eye"/> <field name="view_count"/></span>
                                        <span><i class="fa fa-mouse-pointer"/> <field name="click_count"/></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_lolirine_popup_config" model="ir.actions.act_window">
        <field name="name">Configuration Popups</field>
        <field name="res_model">lolirine.popup.config</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier popup !
            </p>
            <p>
                Configurez des popups personnalisés pour rediriger vos visiteurs vers le formulaire de contact
                ou afficher les boxes disponibles. Vous pouvez créer plusieurs popups et les activer/désactiver selon vos besoins.
            </p>
        </field>
    </record>
    
    <!-- Filtre de recherche -->
    <record id="view_lolirine_popup_config_search" model="ir.ui.view">
        <field name="name">lolirine.popup.config.search</field>
        <field name="model">lolirine.popup.config</field>
        <field name="arch" type="xml">
            <search string="Rechercher Popups">
                <field name="title"/>
                <field name="popup_type"/>
                <filter name="active" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactifs" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="type_standard" string="Standard" domain="[('popup_type', '=', 'standard')]"/>
                <filter name="type_boxes" string="Boxes disponibles" domain="[('popup_type', '=', 'available_boxes')]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'popup_type'}"/>
                    <filter name="group_mode" string="Mode d'affichage" context="{'group_by': 'display_mode'}"/>
                </group>
            </search>
        </field>
    </record>
    
</odoo>
