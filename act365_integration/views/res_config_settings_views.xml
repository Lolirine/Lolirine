<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit res.config.settings view -->
    <record id="res_config_settings_view_form_act365" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.act365</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ACT365" string="ACT365" name="act365_integration" groups="base.group_system">
                    <block title="Configuration API ACT365" name="act365_api_settings">
                        <setting string="Connexion API" help="Configurez les parametres de connexion a l'API ACT365">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="act365_api_url" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="act365_api_url" class="col-9 col-lg-6" placeholder="https://api.act365.eu"/>
                                </div>
                                <div class="row mt8">
                                    <label for="act365_api_key" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="act365_api_key" class="col-9 col-lg-6" password="True" placeholder="Votre cle API ACT365"/>
                                </div>
                                <div class="row mt8">
                                    <div class="col-3 col-lg-3"/>
                                    <div class="col-9 col-lg-6 text-muted small">
                                        Pour obtenir votre cle API, connectez-vous a ACT365 &gt; Profile &gt; Apps &amp; Integrations
                                    </div>
                                </div>
                                <div class="row mt16">
                                    <div class="col-3 col-lg-3"/>
                                    <div class="col-9 col-lg-6">
                                        <button name="action_test_act365_connection" 
                                                type="object" 
                                                string="Tester la connexion"
                                                class="btn-secondary me-2"
                                                icon="fa-plug"/>
                                        <button name="action_open_act365_web" 
                                                type="object" 
                                                string="Ouvrir ACT365"
                                                class="btn-primary"
                                                icon="fa-external-link"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                        
                        <setting string="Groupes de cardholders" help="Gerez les groupes ACT365 pour definir les acces">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="act365_default_group_id" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="act365_default_group_id" class="col-9 col-lg-6"/>
                                </div>
                                <div class="row mt16">
                                    <div class="col-3 col-lg-3"/>
                                    <div class="col-9 col-lg-6">
                                        <button name="action_sync_act365_groups" 
                                                type="object" 
                                                string="Synchroniser les groupes"
                                                class="btn-secondary me-2"
                                                icon="fa-refresh"/>
                                        <button name="action_open_act365_groups" 
                                                type="object" 
                                                string="Voir les groupes"
                                                class="btn-secondary"
                                                icon="fa-list"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                    
                    <block title="Options de code PIN" name="act365_pin_settings">
                        <setting string="Generation du PIN" help="Configurez la generation automatique des codes PIN">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="act365_pin_length" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="act365_pin_length" class="col-9 col-lg-2"/>
                                    <span class="text-muted ms-2">chiffres (4-8 recommande)</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                    
                    <block title="Automatisation" name="act365_automation_settings">
                        <setting string="Synchronisation automatique" help="Synchroniser automatiquement avec ACT365">
                            <field name="act365_auto_sync"/>
                        </setting>
                        
                        <setting string="Activer a la confirmation" help="Activer automatiquement l'acces lors de la confirmation de l'abonnement">
                            <field name="act365_enable_on_confirm"/>
                        </setting>
                        
                        <setting string="Desactiver a la cloture" help="Desactiver automatiquement l'acces lors de la resiliation de l'abonnement">
                            <field name="act365_disable_on_close"/>
                        </setting>
                    </block>
                    
                    <block title="Acces rapide" name="act365_quick_access">
                        <setting string="Interface ACT365" help="Accedez directement a l'interface de gestion ACT365">
                            <div class="content-group">
                                <div class="row mt16">
                                    <div class="col-12">
                                        <a href="https://www.act365.eu/Manage/ManageHome" target="_blank" class="btn btn-primary">
                                            <i class="fa fa-external-link me-2"/>Ouvrir ACT365 Management
                                        </a>
                                        <a href="https://www.act365.eu" target="_blank" class="btn btn-secondary ms-2">
                                            <i class="fa fa-globe me-2"/>Site ACT365
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- ACT365 Cardholder Group List View -->
    <record id="view_act365_cardholder_group_list" model="ir.ui.view">
        <field name="name">act365.cardholder.group.list</field>
        <field name="model">act365.cardholder.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="act365_id"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ACT365 Cardholder Group Form View -->
    <record id="view_act365_cardholder_group_form" model="ir.ui.view">
        <field name="name">act365.cardholder.group.form</field>
        <field name="model">act365.cardholder.group</field>
        <field name="arch" type="xml">
            <form string="Groupe ACT365">
                <header>
                    <button name="set_as_default" 
                            type="object" 
                            string="Definir par defaut"
                            invisible="is_default"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du groupe"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="act365_id"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for ACT365 Groups -->
    <record id="action_act365_cardholder_groups" model="ir.actions.act_window">
        <field name="name">Groupes ACT365</field>
        <field name="res_model">act365.cardholder.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun groupe ACT365 configure
            </p>
            <p>
                Cliquez sur "Synchroniser les groupes" dans les parametres ACT365 
                pour recuperer les groupes depuis votre compte ACT365.
            </p>
        </field>
    </record>

    <!-- Action URL to open ACT365 Management -->
    <record id="action_open_act365_management" model="ir.actions.act_url">
        <field name="name">ACT365 Management</field>
        <field name="url">https://www.act365.eu/Manage/ManageHome</field>
        <field name="target">new</field>
    </record>

    <!-- ACT365 Web View (iframe attempt) -->
    <record id="view_act365_web_iframe" model="ir.ui.view">
        <field name="name">act365.web.iframe</field>
        <field name="model">ir.ui.view</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="act365_integration.act365_web_view">
                <div class="o_act365_web_container" style="height: calc(100vh - 100px); width: 100%;">
                    <div class="alert alert-info mb-3">
                        <i class="fa fa-info-circle me-2"/>
                        Si la page ne s'affiche pas ci-dessous, 
                        <a href="https://www.act365.eu/Manage/ManageHome" target="_blank" class="alert-link">
                            cliquez ici pour ouvrir ACT365 dans un nouvel onglet
                        </a>
                    </div>
                    <iframe src="https://www.act365.eu/Manage/ManageHome" 
                            style="width: 100%; height: 100%; border: 1px solid #ddd; border-radius: 4px;"
                            allowfullscreen="true"/>
                </div>
            </t>
        </field>
    </record>

    <!-- Action client for ACT365 Web View -->
    <record id="action_act365_web_view" model="ir.actions.client">
        <field name="name">ACT365 Management</field>
        <field name="tag">act365_web_view</field>
    </record>

    <!-- Main menu for ACT365 Application -->
    <menuitem id="menu_act365_main_root"
              name="ACT365"
              web_icon="act365_integration,static/description/icon.png"
              sequence="100"/>

    <!-- Submenu: Recherche par code -->
    <menuitem id="menu_act365_search_by_code"
              name="Rechercher par code"
              parent="menu_act365_main_root"
              action="action_search_partner_by_code"
              sequence="5"/>

    <!-- Submenu: Open ACT365 Web -->
    <menuitem id="menu_act365_open_web"
              name="Ouvrir ACT365 Web"
              parent="menu_act365_main_root"
              action="action_open_act365_management"
              sequence="10"/>

    <!-- Configuration submenu -->
    <menuitem id="menu_act365_configuration"
              name="Configuration"
              parent="menu_act365_main_root"
              sequence="50"/>
    
    <menuitem id="menu_act365_groups_main"
              name="Groupes d'acces"
              parent="menu_act365_configuration"
              action="action_act365_cardholder_groups"
              sequence="10"/>

    <!-- Also keep menu under subscriptions for convenience -->
    <menuitem id="menu_act365_root"
              name="ACT365"
              parent="sale_subscription.menu_sale_subscription_root"
              sequence="50"/>
    
    <menuitem id="menu_act365_groups"
              name="Groupes d'acces"
              parent="menu_act365_root"
              action="action_act365_cardholder_groups"
              sequence="10"/>

    <menuitem id="menu_act365_search_code_sub"
              name="Rechercher par code"
              parent="menu_act365_root"
              action="action_search_partner_by_code"
              sequence="5"/>

</odoo>
