<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Snippet Avantages Pool Store -->
    <template id="s_pool_features" name="Pool Features">
        <section class="s_pool_features py-5 bg-light">
            <div class="container">
                <div class="row text-center g-4">
                    <div class="col-md-3">
                        <div class="p-3">
                            <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px; background-color: #0ea5e9;">
                                <i class="fa fa-truck fa-lg text-white"/>
                            </div>
                            <h6 class="fw-bold">Livraison Belgique</h6>
                            <p class="text-muted small mb-0">Livraison rapide partout en Belgique</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3">
                            <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px; background-color: #0ea5e9;">
                                <i class="fa fa-shield fa-lg text-white"/>
                            </div>
                            <h6 class="fw-bold">Garantie incluse</h6>
                            <p class="text-muted small mb-0">Tous nos produits sont garantis</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3">
                            <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px; background-color: #0ea5e9;">
                                <i class="fa fa-headphones fa-lg text-white"/>
                            </div>
                            <h6 class="fw-bold">Conseil expert</h6>
                            <p class="text-muted small mb-0">Notre équipe vous accompagne</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3">
                            <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px; background-color: #0ea5e9;">
                                <i class="fa fa-euro fa-lg text-white"/>
                            </div>
                            <h6 class="fw-bold">Meilleurs prix</h6>
                            <p class="text-muted small mb-0">Prix compétitifs garantis</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    
</odoo>
