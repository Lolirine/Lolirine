<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Adjustment Form View - CORRIGÉ POUR ODOO 19 -->
    <record id="view_biztax_adjustment_form" model="ir.ui.view">
        <field name="name">biztax.adjustment.form</field>
        <field name="model">biztax.adjustment</field>
        <field name="arch" type="xml">
            <form string="Ajustement fiscal">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <field name="declaration_id"/>
                            <field name="category"/>
                            <field name="adjustment_type"/>
                        </group>
                        <group string="Comptabilité">
                            <!-- IMPORTANT: Pas de domain sur account_id car company_id 
                                 n'existe plus sur account.account en Odoo 19 -->
                            <field name="account_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Montants">
                            <field name="base_amount"/>
                            <field name="dna_percentage" 
                                   invisible="category not in ('dna', 'dna_vehicle', 'dna_restaurant', 'dna_reception', 'dna_gifts', 'dna_fines', 'dna_interest')"/>
                            <field name="amount"/>
                            <field name="signed_amount"/>
                        </group>
                        <group string="Classification">
                            <field name="tax_code_id"/>
                            <field name="legal_reference"/>
                        </group>
                    </group>
                    
                    <!-- Vehicle fields (only for DNA vehicles) -->
                    <group string="Données véhicule" 
                           invisible="category != 'dna_vehicle'">
                        <group>
                            <field name="vehicle_co2"/>
                            <field name="vehicle_fuel_type"/>
                        </group>
                        <group>
                            <field name="vehicle_deduction_rate"/>
                        </group>
                    </group>
                    
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                    
                    <group string="Écritures comptables liées">
                        <field name="move_line_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="date"/>
                                <field name="account_id"/>
                                <field name="name"/>
                                <field name="debit"/>
                                <field name="credit"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List/Tree View -->
    <record id="view_biztax_adjustment_tree" model="ir.ui.view">
        <field name="name">biztax.adjustment.tree</field>
        <field name="model">biztax.adjustment</field>
        <field name="arch" type="xml">
            <list string="Ajustements fiscaux" editable="bottom"
                  decoration-success="adjustment_type == 'decrease'"
                  decoration-warning="adjustment_type == 'increase'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="adjustment_type"/>
                <field name="base_amount" optional="hide"/>
                <field name="dna_percentage" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="signed_amount" sum="Total signé"/>
                <field name="legal_reference" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_biztax_adjustment_search" model="ir.ui.view">
        <field name="name">biztax.adjustment.search</field>
        <field name="model">biztax.adjustment</field>
        <field name="arch" type="xml">
            <search string="Rechercher ajustements">
                <field name="name"/>
                <field name="declaration_id"/>
                <field name="category"/>
                <field name="legal_reference"/>
                <separator/>
                <filter name="filter_increase" string="Majorations" 
                        domain="[('adjustment_type', '=', 'increase')]"/>
                <filter name="filter_decrease" string="Diminutions" 
                        domain="[('adjustment_type', '=', 'decrease')]"/>
                <separator/>
                <filter name="filter_dna" string="DNA" 
                        domain="[('category', 'ilike', 'dna')]"/>
                <filter name="filter_provisions" string="Provisions" 
                        domain="[('category', '=', 'provision')]"/>
                <filter name="filter_deductions" string="Déductions" 
                        domain="[('category', 'in', ['rdt', 'innovation', 'investment', 'nid'])]"/>
                <separator/>
                <filter string="Catégorie" name="group_category" context="{'group_by': 'category'}"/>
                <filter string="Type" name="group_type" context="{'group_by': 'adjustment_type'}"/>
                <filter string="Déclaration" name="group_declaration" context="{'group_by': 'declaration_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_biztax_adjustment" model="ir.actions.act_window">
        <field name="name">Ajustements fiscaux</field>
        <field name="res_model">biztax.adjustment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_biztax_adjustment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier ajustement fiscal
            </p>
            <p>
                Les ajustements permettent de calculer la base imposable à partir
                du résultat comptable (DNA, provisions, déductions, etc.).
            </p>
        </field>
    </record>
</odoo>
