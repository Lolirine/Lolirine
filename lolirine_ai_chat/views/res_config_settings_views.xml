<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form_ai_chat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai_chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Assistant IA" data-string="Assistant IA" data-key="lolirine_ai_chat">
                    <block title="API" name="ai_api">
                        <setting string="Cle API Anthropic">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_api_key" class="col-lg-3 o_light_label" />
                                    <field name="ai_chat_api_key" password="True" class="col-lg-6" />
                                </div>
                            </div>
                        </setting>
                        <setting string="Modele IA">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_model" class="col-lg-3 o_light_label" />
                                    <field name="ai_chat_model" class="col-lg-6" />
                                </div>
                            </div>
                        </setting>
                        <setting string="Tokens max">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_max_tokens" class="col-lg-3 o_light_label" />
                                    <field name="ai_chat_max_tokens" class="col-lg-3" />
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Fonctionnalites" name="ai_features">
                        <setting string="Chat IA actif">
                            <field name="ai_chat_enabled" />
                        </setting>
                        <setting string="Recherche web">
                            <field name="ai_chat_web_search" />
                        </setting>
                        <setting string="Recherche produits">
                            <field name="ai_chat_product_search" />
                        </setting>
                    </block>
                    <block title="Prompt" name="ai_prompt">
                        <setting string="Instructions IA">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="ai_chat_system_prompt" widget="text" class="col-lg-10" />
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Apparence" name="ai_appearance">
                        <setting string="Message de bienvenue">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="ai_chat_welcome_message" widget="text" class="col-lg-8" />
                                </div>
                            </div>
                        </setting>
                        <setting string="Couleur principale">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_chat_primary_color" class="col-lg-3 o_light_label" />
                                    <field name="ai_chat_primary_color" widget="color" class="col-lg-3" />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>