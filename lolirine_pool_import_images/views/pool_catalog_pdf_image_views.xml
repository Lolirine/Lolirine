<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Bouton d'extraction avancée -->
        <record id="view_pool_catalog_pdf_import_form_images_advanced" model="ir.ui.view">
            <field name="name">pool.catalog.pdf.import.form.advanced</field>
            <field name="model">pool.catalog.pdf.import</field>
            <field name="inherit_id" ref="lolirine_pool_import.pool_catalog_pdf_import_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_extract_images_advanced" 
                            type="object" 
                            string="🔍 Extraction Avancée OCR"
                            class="btn-primary"
                            help="Extraction avec détourage précis et optimisation qualité"/>
                </xpath>
            </field>
        </record>

        <!-- Action pour voir les images -->
        <record id="action_pool_catalog_pdf_image" model="ir.actions.act_window">
            <field name="name">Images Extraites</field>
            <field name="res_model">pool.catalog.pdf.image</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aucune image extraite
                </p>
                <p>
                    Utilisez l'extraction d'images depuis un import PDF pour voir les images ici.
                </p>
            </field>
        </record>

        <!-- Menu principal -->
        <menuitem 
            id="menu_pool_catalog_pdf_image"
            name="Images Extraites"
            action="action_pool_catalog_pdf_image"
            sequence="99"/>

    </data>
</odoo>
