<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bon fournisseur : onglet « ✍ Signature » -->
    <record id="view_purchase_order_form_signature" model="ir.ui.view">
        <field name="name">purchase.order.form.pool.signature</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="✍ Signature" name="pool_signature">
                    <div class="text-muted small mb-2">Signe le bon ici (souris, doigt ou stylet) : la signature est imprimée
                        en bas du bon de commande PDF envoyé au fournisseur. Pour la refaire, efface-la puis signe à nouveau.</div>
                    <div class="mb-3">
                        <button name="action_pool_signer_document" type="object" class="btn-secondary"
                                string="📄 Signer un document du fournisseur (confirmation PDF)"
                                help="Appose ta signature sur un PDF reçu du fournisseur (joint au bon) et le lui renvoie"/>
                    </div>
                    <group>
                        <group>
                            <field name="pool_signe_par" placeholder="Nom du signataire"/>
                            <field name="pool_signe_le"/>
                        </group>
                        <group>
                            <field name="pool_signature" widget="signature" nolabel="1" colspan="2"
                                   options="{'full_name': 'pool_signe_par', 'size': [400, 150]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- PDF du bon de commande / de la demande de prix : bloc de signature -->
    <template id="report_purchaseorder_document_signature" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='o.payment_term_id']" position="after">
            <div t-if="o.pool_signature" class="row mt-4" style="page-break-inside: avoid;">
                <div class="col-6 offset-6 text-center">
                    <div>Pour <t t-out="o.company_id.name"/>,</div>
                    <img t-att-src="image_data_uri(o.pool_signature)" style="max-height: 4cm; max-width: 8cm;"/>
                    <div><strong t-out="o.pool_signe_par"/></div>
                    <div t-if="o.pool_signe_le" class="small text-muted">Signé le <t t-out="o.pool_signe_le" t-options="{'widget': 'date'}"/></div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Assistant : signer un document du fournisseur -->
    <record id="view_pool_signer_document_form" model="ir.ui.view">
        <field name="name">lolirine.pool.signer.document.form</field>
        <field name="model">lolirine.pool.signer.document</field>
        <field name="arch" type="xml">
            <form>
                <field name="po_id" invisible="1"/>
                <field name="signe_id" invisible="1"/>
                <div class="text-muted small mb-2" invisible="signe_id">
                    Choisis le PDF du fournisseur joint au bon (sa confirmation de commande…) : ta signature de l'onglet
                    « ✍ Signature » y est apposée, avec la mention, ton nom, la date et la référence du bon.
                    Pour joindre un PDF au bon : trombone en haut à droite du bon.
                </div>
                <group invisible="signe_id">
                    <field name="attachment_id" options="{'no_create': True}"/>
                    <field name="mention"/>
                    <field name="page" widget="radio" options="{'horizontal': true}"/>
                    <field name="position" widget="radio"/>
                </group>
                <div invisible="not signe_id" class="alert alert-success" role="status">
                    Document signé : <field name="signe_id" readonly="1" class="oe_inline"/> — il est joint au bon.
                    Vérifie-le avec « Aperçu », puis renvoie-le au fournisseur.
                </div>
                <footer>
                    <button name="action_signer" type="object" string="✍ Signer le document" class="btn-primary"
                            invisible="signe_id"/>
                    <button name="action_apercu" type="object" string="👁 Aperçu" class="btn-secondary"
                            invisible="not signe_id"/>
                    <button name="action_envoyer" type="object" string="📧 Renvoyer au fournisseur" class="btn-primary"
                            invisible="not signe_id"/>
                    <button name="action_signer" type="object" string="Signer à nouveau" class="btn-link"
                            invisible="not signe_id"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
