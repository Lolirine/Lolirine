<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================= -->
    <!-- VUE LISTE RELANCES                            -->
    <!-- ============================================= -->
    <record id="view_invoice_reminder_list" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.list</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <list string="Relances" decoration-danger="state == 'draft'" decoration-success="state == 'paid'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="reminder_type"/>
                <field name="invoice_residual" sum="Total reste a payer"/>
                <field name="invoice_date_due"/>
                <field name="send_date"/>
                <field name="state" widget="badge" decoration-danger="state == 'draft'" decoration-success="state == 'paid'" decoration-info="state == 'sent'" decoration-muted="state == 'cancelled'"/>
                <field name="auto_generated" widget="boolean"/>
            </list>
        </field>
    </record>
    
    <!-- ============================================= -->
    <!-- VUE FORMULAIRE RELANCE                        -->
    <!-- ============================================= -->
    <record id="view_invoice_reminder_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.form</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <form string="Relance">
                <header>
                    <button name="action_send" string="Envoyer" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_next_reminder" string="Relance suivante" type="object" invisible="state != 'sent' or reminder_type == 'formal_notice'"/>
                    <button name="action_set_paid" string="Marquer payee" type="object" invisible="state not in ['draft', 'sent']"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state in ['paid', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Facture">
                            <field name="invoice_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="invoice_amount"/>
                            <field name="invoice_residual"/>
                            <field name="invoice_date_due"/>
                        </group>
                        <group string="Relance">
                            <field name="reminder_type" readonly="state != 'draft'"/>
                            <field name="send_date"/>
                            <field name="auto_generated"/>
                            <field name="fee_invoice_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- ============================================= -->
    <!-- VUE RECHERCHE RELANCES                        -->
    <!-- ============================================= -->
    <record id="view_invoice_reminder_search" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.search</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <search string="Relances">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="A envoyer" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_sent" string="En attente paiement" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_paid" string="Payees" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="filter_reminder_1" string="1er Rappel" domain="[('reminder_type', '=', 'reminder_1')]"/>
                <filter name="filter_reminder_2" string="2eme Rappel" domain="[('reminder_type', '=', 'reminder_2')]"/>
                <filter name="filter_reminder_3" string="3eme Rappel" domain="[('reminder_type', '=', 'reminder_3')]"/>
                <filter name="filter_formal" string="Mise en demeure" domain="[('reminder_type', '=', 'formal_notice')]"/>
                <separator/>
                <filter name="filter_auto" string="Auto-generees" domain="[('auto_generated', '=', True)]"/>
            </search>
        </field>
    </record>
    
    <!-- ============================================= -->
    <!-- VUE FORMULAIRE CONFIGURATION                  -->
    <!-- ============================================= -->
    <record id="view_invoice_reminder_config_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.config.form</field>
        <field name="model">lolirine.invoice.reminder.config</field>
        <field name="arch" type="xml">
            <form string="Configuration des relances">
                <sheet>
                    <group>
                        <group string="Delais (jours apres echeance)">
                            <field name="reminder_1_days"/>
                            <field name="reminder_2_days"/>
                            <field name="reminder_3_days"/>
                            <field name="formal_notice_days"/>
                        </group>
                        <group string="Frais">
                            <field name="fee_reminder_3"/>
                            <field name="fee_formal_notice"/>
                        </group>
                    </group>
                    <group string="Automatisation">
                        <field name="auto_reminder" widget="boolean_toggle"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group invisible="not auto_reminder">
                        <button name="action_test_dry_run" string="Simuler (sans envoyer)" type="object" class="btn-secondary me-2"/>
                        <button name="action_test_auto_reminder" string="Executer maintenant" type="object" class="btn-primary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ============================================= -->
    <!-- ACTIONS                                       -->
    <!-- ============================================= -->
    <record id="action_invoice_reminder" model="ir.actions.act_window">
        <field name="name">Relances</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune relance trouvee
            </p>
        </field>
    </record>
    
    <record id="action_invoice_reminder_to_send" model="ir.actions.act_window">
        <field name="name">A envoyer</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
    </record>
    
    <record id="action_invoice_reminder_sent" model="ir.actions.act_window">
        <field name="name">En attente</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent')]</field>
    </record>
    
    <!-- ACTION CONFIGURATION - Appelle la méthode Python qui charge le bon record -->
    <record id="action_invoice_reminder_config" model="ir.actions.server">
        <field name="name">Configuration des relances</field>
        <field name="model_id" ref="model_lolirine_invoice_reminder_config"/>
        <field name="state">code</field>
        <field name="code">
action = env['lolirine.invoice.reminder.config'].get_config().action_open_config()
        </field>
    </record>
    
    <!-- ============================================= -->
    <!-- CRONS                                         -->
    <!-- ============================================= -->
    <record id="ir_cron_auto_reminder" model="ir.cron">
        <field name="name">Lolirine - Auto-relance factures impayees</field>
        <field name="model_id" ref="model_lolirine_invoice_reminder"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=8, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    
    <record id="ir_cron_check_paid" model="ir.cron">
        <field name="name">Lolirine - Verifier factures payees</field>
        <field name="model_id" ref="model_lolirine_invoice_reminder"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_paid()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=9, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

</odoo>
