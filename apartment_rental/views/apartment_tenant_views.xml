<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="apartment_tenant_view_form" model="ir.ui.view">
        <field name="name">apartment.tenant.form</field>
        <field name="model">apartment.tenant</field>
        <field name="arch" type="xml">
            <form string="Locataire">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leases" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="lease_count" widget="statinfo" string="Baux"/>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nom du locataire"/>
                        </h1>
                        <field name="reference" readonly="1"/>
                    </div>
                    <group>
                        <group string="Informations Personnelles">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="birth_date"/>
                            <field name="birth_place"/>
                            <field name="nationality_id"/>
                            <field name="national_id"/>
                        </group>
                        <group string="Adresse">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="zip"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Emploi" name="employment">
                            <group>
                                <group>
                                    <field name="profession"/>
                                    <field name="employer"/>
                                    <field name="employer_phone" widget="phone"/>
                                </group>
                                <group>
                                    <field name="contract_type"/>
                                    <field name="monthly_income"/>
                                    <field name="income_proof_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contact d'urgence" name="emergency">
                            <group>
                                <group>
                                    <field name="emergency_contact_name"/>
                                    <field name="emergency_contact_phone" widget="phone"/>
                                    <field name="emergency_contact_relation"/>
                                </group>
                            </group>
                        </page>
                        <page string="Garant" name="guarantor">
                            <group>
                                <group>
                                    <field name="guarantor_name"/>
                                    <field name="guarantor_phone" widget="phone"/>
                                    <field name="guarantor_email" widget="email"/>
                                </group>
                                <group>
                                    <field name="guarantor_address"/>
                                    <field name="guarantor_profession"/>
                                    <field name="guarantor_income"/>
                                </group>
                            </group>
                        </page>
                        <page string="Banque" name="bank">
                            <group>
                                <field name="bank_account_id"/>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="expiry_date"/>
                                    <field name="is_signed"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="comment" placeholder="Notes internes sur le locataire..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="apartment_tenant_view_tree" model="ir.ui.view">
        <field name="name">apartment.tenant.tree</field>
        <field name="model">apartment.tenant</field>
        <field name="arch" type="xml">
            <list string="Locataires">
                <field name="reference"/>
                <field name="name"/>
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="profession"/>
                <field name="lease_count"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="apartment_tenant_view_kanban" model="ir.ui.view">
        <field name="name">apartment.tenant.kanban</field>
        <field name="model">apartment.tenant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <div><field name="phone" widget="phone"/></div>
                        <div><field name="email" widget="email"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="apartment_tenant_view_search" model="ir.ui.view">
        <field name="name">apartment.tenant.search</field>
        <field name="model">apartment.tenant</field>
        <field name="arch" type="xml">
            <search string="Rechercher un locataire">
                <field name="name"/>
                <field name="reference"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="national_id"/>
                <filter string="Avec bail actif" name="active_lease" domain="[('lease_count', '>', 0)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="apartment_tenant_action" model="ir.actions.act_window">
        <field name="name">Locataires</field>
        <field name="res_model">apartment.tenant</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="apartment_tenant_view_search"/>
        <field name="context">{'default_is_tenant': True}</field>
        <field name="domain">[('is_tenant', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajoutez votre premier locataire
            </p>
            <p>
                Gérez les informations de vos locataires, leurs documents et garants.
            </p>
        </field>
    </record>

</odoo>
