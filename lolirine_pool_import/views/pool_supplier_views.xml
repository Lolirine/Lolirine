<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pool Supplier Tree View -->
    <record id="pool_supplier_tree" model="ir.ui.view">
        <field name="name">pool.supplier.tree</field>
        <field name="model">pool.supplier</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="default_margin"/>
                <field name="product_count"/>
                <field name="last_import_date"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Pool Supplier Form View -->
    <record id="pool_supplier_form" model="ir.ui.view">
        <field name="name">pool.supplier.form</field>
        <field name="model">pool.supplier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cube">
                            <field name="product_count" widget="statinfo" string="Produits"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom du fournisseur"/></h1>
                    </div>
                    
                    <group>
                        <group string="Informations">
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="website" widget="url"/>
                            <field name="catalog_url" widget="url"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Configuration des prix">
                            <field name="default_margin" widget="percentage"/>
                            <field name="min_margin" widget="percentage"/>
                            <field name="price_rounding"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Marques" name="brands">
                            <field name="brand_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mapping Catégories" name="categories">
                            <field name="category_mapping_ids">
                                <list editable="bottom">
                                    <field name="supplier_category"/>
                                    <field name="supplier_prefix"/>
                                    <field name="odoo_category_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    
                    <group string="Dernier import">
                        <field name="last_import_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pool Supplier Action -->
    <record id="action_pool_supplier" model="ir.actions.act_window">
        <field name="name">Fournisseurs Piscine</field>
        <field name="res_model">pool.supplier</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Pool Import Log Tree View -->
    <record id="pool_import_log_tree" model="ir.ui.view">
        <field name="name">pool.import.log.tree</field>
        <field name="model">pool.import.log</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-danger="state == 'error'" decoration-info="state == 'processing'">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="source_type"/>
                <field name="create_date"/>
                <field name="products_created"/>
                <field name="products_updated"/>
                <field name="templates_created"/>
                <field name="errors_count"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'error'" decoration-info="state == 'processing'"/>
            </list>
        </field>
    </record>

    <!-- Pool Import Log Form View -->
    <record id="pool_import_log_form" model="ir.ui.view">
        <field name="name">pool.import.log.form</field>
        <field name="model">pool.import.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_view_created_products" string="Voir les produits créés" type="object" class="oe_highlight" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    
                    <group>
                        <group string="Import">
                            <field name="supplier_id"/>
                            <field name="source_type"/>
                            <field name="import_filename"/>
                            <field name="import_file" filename="import_filename"/>
                        </group>
                        <group string="Timing">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    
                    <group string="Résultats">
                        <group>
                            <field name="total_lines"/>
                            <field name="products_created"/>
                            <field name="products_updated"/>
                            <field name="products_skipped"/>
                        </group>
                        <group>
                            <field name="templates_created"/>
                            <field name="variants_created"/>
                            <field name="errors_count"/>
                        </group>
                    </group>
                    
                    <group string="Erreur" invisible="not error_message">
                        <field name="error_message" colspan="2" readonly="1" nolabel="1"/>
                    </group>
                    
                    <notebook>
                        <page string="Détails" name="details">
                            <field name="log_line_ids">
                                <list decoration-success="action == 'create'" decoration-warning="action == 'update'" decoration-danger="action == 'error'" decoration-muted="action == 'skip'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="supplier_ref"/>
                                    <field name="product_name"/>
                                    <field name="product_id"/>
                                    <field name="action" widget="badge"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pool Import Log Action -->
    <record id="action_pool_import_log" model="ir.actions.act_window">
        <field name="name">Historique des imports</field>
        <field name="res_model">pool.import.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
