<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_contrat_bail_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- Utilisation du layout externe standard d'Odoo qui inclut votre logo -->
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mt-5">CONTRAT DE BAIL POUR ESPACE DE STOCKAGE</h2>

                        <p class="mt-5"><strong>Entre les soussignés :</strong></p>

                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Le Bailleur :</strong><br/>
                                <div t-field="doc.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"]}'/>
                            </div>
                            <div class="col-6">
                                <strong>Le Locataire :</strong><br/>
                                <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"]}'/>
                            </div>
                        </div>

                        <h3><u>Article 1 : Objet du contrat</u></h3>
                        <p>
                            Le présent contrat a pour objet la location d'un espace de stockage par le Bailleur au Locataire,
                            identifié dans le cadre de l'abonnement <strong t-field="doc.code"/>.
                        </p>

                        <h3><u>Article 2 : Conditions financières</u></h3>
                        <p><strong>Date de début du contrat :</strong> <span t-field="doc.date_start" t-options='{"widget": "date"}'/></p>
                        <p>
                            <strong>Loyer :</strong>
                            <span t-field="doc.recurring_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            payable tous les <span t-field="doc.recurring_interval"/>
                            <span t-if="doc.recurring_rule_type == 'daily'">jours</span>
                            <span t-if="doc.recurring_rule_type == 'weekly'">semaines</span>
                            <span t-if="doc.recurring_rule_type == 'monthly'">mois</span>
                            <span t-if="doc.recurring_rule_type == 'yearly'">ans</span>.
                        </p>

                        <h3><u>Article 3 : Clauses</u></h3>
                        <p>
                            <em>(Vous pouvez ajouter ici vos clauses spécifiques : durée, dépôt de garantie, obligations, conditions de résiliation, etc.)</em>
                        </p>
                        <p>
                            1. Le locataire s'engage à utiliser l'espace de stockage conformément à sa destination.<br/>
                            2. Le loyer est payable d'avance, selon les termes de l'abonnement associé.<br/>
                            3. Le contrat est résiliable selon les conditions définies dans le modèle d'abonnement.
                        </p>

                        <div class="row" style="position: absolute; bottom: 80px; width: 100%;">
                            <div class="col-6 text-center">
                                <p>Fait à <span t-esc="doc.company_id.partner_id.city or ''"/>, le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></p>
                                <br/><br/>
                                <p><strong>Le Bailleur</strong></p>
                                <p>(Signature précédée de la mention "Lu et approuvé")</p>
                            </div>
                            <div class="col-6 text-center">
                                <p>Fait à <span t-esc="doc.partner_id.city or ''"/>, le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></p>
                                <br/><br/>
                                <p><strong>Le Locataire</strong></p>
                                <p>(Signature précédée de la mention "Lu et approuvé")</p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
