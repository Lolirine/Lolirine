<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu principal de l'application Piscine -->
    <menuitem id="menu_pool_root"
        name="Piscine"
        web_icon="lolirine_pool_import,static/description/icon.png"
        sequence="50"/>
    
    <!-- Products Submenu -->
    <menuitem id="menu_pool_products"
        name="Produits Piscine"
        parent="menu_pool_root"
        action="action_pool_products"
        sequence="10"/>
    
    <!-- Catalogues -->
    <menuitem id="menu_pool_catalogs"
        name="Catalogues"
        parent="menu_pool_root"
        action="action_pool_catalog"
        sequence="20"/>
    
    <!-- Import Submenu (wizard rapide) -->
    <menuitem id="menu_pool_import"
        name="Import rapide"
        parent="menu_pool_root"
        action="action_pool_import_wizard"
        sequence="30"/>
    
    <!-- Configuration Menu -->
    <menuitem id="menu_pool_config"
        name="Configuration"
        parent="menu_pool_root"
        sequence="100"/>
    
    <menuitem id="menu_pool_suppliers"
        name="Fournisseurs"
        parent="menu_pool_config"
        action="action_pool_supplier"
        sequence="10"/>
    
    <menuitem id="menu_pool_import_log"
        name="Historique des imports"
        parent="menu_pool_config"
        action="action_pool_import_log"
        sequence="20"/>
    
    <menuitem id="menu_pool_catalog_items"
        name="Éléments de catalogue"
        parent="menu_pool_config"
        action="action_pool_catalog_item"
        sequence="30"/>
</odoo>
