<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Definition du rapport -->
    <record id="action_report_invoice_lolirine" model="ir.actions.report">
        <field name="name">Facture Lolirine</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_invoice.report_invoice_lolirine</field>
        <field name="report_file">lolirine_invoice.report_invoice_lolirine</field>
        <field name="print_report_name">'Facture_%s' % (object.name or 'Brouillon').replace('/','_')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="is_invoice_report" eval="True"/>
    </record>

    <!-- Template principal -->
    <template id="report_invoice_lolirine">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="lolirine_invoice.report_invoice_lolirine_document"/>
            </t>
        </t>
    </template>

    <!-- Document de facture -->
    <template id="report_invoice_lolirine_document">
        <div class="article" style="font-family: Arial, sans-serif; font-size: 9pt; padding: 5px; margin: 0;">
            <!-- Style CSS optimise pour une page -->
            <style>
                @page {
                    size: A4;
                    margin: 8mm 10mm 10mm 10mm;
                }
                .lolirine-invoice {
                    font-family: Arial, sans-serif;
                    font-size: 9pt;
                    color: #333;
                }
                .lolirine-logo {
                    max-height: 45px;
                    max-width: 140px;
                }
                .lolirine-company-info {
                    text-align: right;
                    font-size: 8pt;
                    line-height: 1.2;
                }
                .lolirine-slogan {
                    color: #c0392b;
                    font-style: italic;
                    font-size: 8pt;
                    margin-top: 2px;
                }
                .lolirine-client-block {
                    margin: 8px 0;
                    font-size: 9pt;
                }
                .lolirine-title {
                    color: #c0392b;
                    font-size: 14pt;
                    font-weight: bold;
                    margin: 8px 0;
                }
                .lolirine-dates-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 10px;
                    background-color: #f5f5f5;
                }
                .lolirine-dates-table td {
                    padding: 5px 8px;
                    border: 1px solid #ddd;
                }
                .lolirine-dates-table .label {
                    font-weight: bold;
                    color: #333;
                }
                .lolirine-main-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 8px;
                }
                .lolirine-main-table thead tr {
                    background-color: #c0392b;
                    color: white;
                }
                .lolirine-main-table thead th {
                    padding: 6px 5px;
                    text-align: left;
                    font-weight: bold;
                    border: none;
                    background-color: #c0392b;
                    color: white;
                    font-size: 8pt;
                }
                .lolirine-main-table tbody td {
                    padding: 5px;
                    border-bottom: 1px solid #eee;
                    vertical-align: top;
                    font-size: 8pt;
                }
                .lolirine-totals-table {
                    width: 220px;
                    margin-left: auto;
                    border-collapse: collapse;
                }
                .lolirine-totals-table td {
                    padding: 4px 6px;
                    border: 1px solid #ddd;
                    font-size: 8pt;
                }
                .lolirine-totals-table .label-cell {
                    text-align: left;
                    background-color: #f9f9f9;
                }
                .lolirine-totals-table .value-cell {
                    text-align: right;
                    min-width: 60px;
                }
                .lolirine-totals-table .total-row td {
                    background-color: #c0392b;
                    color: white;
                    font-weight: bold;
                    font-size: 9pt;
                    border-color: #c0392b;
                }
                .lolirine-payment-info {
                    margin: 5px 0;
                    font-size: 8pt;
                }
                .lolirine-amount-words {
                    text-align: right;
                    font-size: 7pt;
                    margin-top: 3px;
                }
                .lolirine-conditions {
                    margin-top: 5px;
                    font-size: 7pt;
                    color: #666;
                }
                .lolirine-signature {
                    margin-top: 10px;
                    border-top: 1px solid #333;
                    width: 150px;
                    margin-left: auto;
                    padding-top: 3px;
                    text-align: center;
                    font-size: 7pt;
                }
                .lolirine-footer {
                    margin-top: 8px;
                    padding-top: 5px;
                    border-top: 2px solid #c0392b;
                    font-size: 7pt;
                    color: #666;
                    text-align: center;
                }
            </style>

            <div class="lolirine-invoice">
                <!-- En-tete -->
                <table style="width: 100%; margin-bottom: 10px;">
                    <tr>
                        <td style="width: 50%; vertical-align: top;">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="lolirine-logo" alt="Logo"/>
                            <div class="lolirine-slogan" t-if="o.company_id.report_header">
                                <t t-esc="o.company_id.report_header"/>
                            </div>
                        </td>
                        <td style="width: 50%; vertical-align: top;" class="lolirine-company-info">
                            <strong>Soci&#233;t&#233; <t t-esc="o.company_id.name"/></strong><br/>
                            <t t-if="o.company_id.street"><t t-esc="o.company_id.street"/><br/></t>
                            <t t-if="o.company_id.street2"><t t-esc="o.company_id.street2"/><br/></t>
                            <br/>
                            <t t-if="o.company_id.zip"><t t-esc="o.company_id.zip"/> </t>
                            <t t-if="o.company_id.city"><t t-esc="o.company_id.city"/></t><br/>
                            <t t-if="o.company_id.country_id"><t t-esc="o.company_id.country_id.name"/></t>
                        </td>
                    </tr>
                </table>

                <!-- Infos client -->
                <div class="lolirine-client-block">
                    <strong><t t-esc="o.partner_id.name"/></strong><br/>
                    <t t-if="o.partner_id.street"><t t-esc="o.partner_id.street"/><br/></t>
                    <t t-if="o.partner_id.street2"><t t-esc="o.partner_id.street2"/><br/></t>
                    <t t-if="o.partner_id.zip"><t t-esc="o.partner_id.zip"/> </t>
                    <t t-if="o.partner_id.city"><t t-esc="o.partner_id.city"/><br/></t>
                    <t t-if="o.partner_id.country_id"><t t-esc="o.partner_id.country_id.name"/></t>
                </div>

                <!-- Titre facture -->
                <div class="lolirine-title">
                    <t t-if="o.state == 'draft'">PRO FORMA </t>
                    <t t-if="o.move_type == 'out_invoice'">Facture </t>
                    <t t-elif="o.move_type == 'out_refund'">Avoir </t>
                    <t t-esc="o.name or ''"/>
                </div>

                <!-- Dates -->
                <table class="lolirine-dates-table">
                    <tr>
                        <td style="width: 50%;">
                            <span class="label">Date de facturation</span><br/>
                            <t t-if="o.invoice_date"><t t-esc="o.invoice_date" t-options="{'widget': 'date'}"/></t>
                            <t t-else="">-</t>
                        </td>
                        <td style="width: 50%;">
                            <span class="label">Date d'&#233;ch&#233;ance</span><br/>
                            <t t-if="o.invoice_date_due"><t t-esc="o.invoice_date_due" t-options="{'widget': 'date'}"/></t>
                            <t t-else="">-</t>
                        </td>
                    </tr>
                </table>

                <!-- Tableau des lignes -->
                <table class="lolirine-main-table">
                    <thead>
                        <tr>
                            <th style="width: 50%;">DESCRIPTION</th>
                            <th style="width: 12%; text-align: center;">QUANTIT&#201;</th>
                            <th style="width: 15%; text-align: right;">PRIX UNITAIRE</th>
                            <th style="width: 8%; text-align: center;">TAXES</th>
                            <th style="width: 15%; text-align: right;">MONTANT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids" t-as="line">
                            <t t-if="line.product_id">
                            <tr>
                                <td>
                                    <t t-esc="line.name or line.product_id.name or '-'"/>
                                </td>
                                <td style="text-align: center;">
                                    <t t-esc="'%.2f' % line.quantity"/> <t t-if="line.product_uom_id"><t t-esc="line.product_uom_id.name"/></t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-esc="'%.2f' % line.price_unit"/> &#8364;
                                </td>
                                <td style="text-align: center;">
                                    <t t-esc="', '.join(line.tax_ids.mapped('name'))"/>
                                </td>
                                <td style="text-align: right;">
                                    <t t-esc="'%.2f' % line.price_subtotal"/> &#8364;
                                </td>
                            </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <!-- Section paiement et totaux -->
                <table style="width: 100%;">
                    <tr>
                        <td style="width: 55%; vertical-align: top;">
                            <!-- Communication de paiement -->
                            <div class="lolirine-payment-info">
                                <t t-if="o.payment_reference">
                                    <strong>Communication de paiement : </strong>
                                    <span style="font-weight: bold;"><t t-esc="o.payment_reference"/></span><br/>
                                </t>
                                <t t-if="o.partner_bank_id">
                                    <strong>sur ce compte : </strong>
                                    <span style="font-weight: bold;"><t t-esc="o.partner_bank_id.acc_number"/></span>
                                    <t t-if="o.partner_bank_id.bank_id"> - <t t-esc="o.partner_bank_id.bank_id.name"/></t>
                                </t>
                            </div>

                            <!-- QR Code SEPA -->
                            <t t-if="o.display_qr_code and o.partner_bank_id and o.state == 'posted'">
                                <div style="margin-top: 5px; text-align: center;">
                                    <t t-set="qr_code_url" t-value="o.partner_bank_id.build_qr_code_url(o.amount_residual or o.amount_total, o.ref or o.name, o.payment_reference, o.currency_id, o.partner_id)"/>
                                    <img t-if="qr_code_url" t-att-src="qr_code_url" style="width: 70px; height: 70px;" alt="QR Code SEPA"/>
                                    <div style="font-size: 6pt; color: #666; margin-top: 2px;">
                                        Scannez pour payer par virement SEPA
                                    </div>
                                </div>
                            </t>
                        </td>
                        <td style="width: 45%; vertical-align: top;">
                            <!-- Totaux -->
                            <table class="lolirine-totals-table">
                                <tr>
                                    <td class="label-cell">Montant hors taxes</td>
                                    <td class="value-cell"><t t-esc="'%.2f' % o.amount_untaxed"/> &#8364;</td>
                                </tr>
                                <tr>
                                    <td class="label-cell">TVA</td>
                                    <td class="value-cell"><t t-esc="'%.2f' % o.amount_tax"/> &#8364;</td>
                                </tr>
                                <tr class="total-row">
                                    <td>Total TTC</td>
                                    <td class="value-cell"><t t-esc="'%.2f' % o.amount_total"/> &#8364;</td>
                                </tr>
                            </table>

                            <!-- Montant en lettres -->
                            <div class="lolirine-amount-words">
                                <strong>Montant total en toutes lettres :</strong><br/>
                                <t t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Conditions generales -->
                <div class="lolirine-conditions">
                    Conditions g&#233;n&#233;rales : <a href="https://lolirine-lolirine.odoo.com/terms">https://lolirine-lolirine.odoo.com/terms</a>
                </div>

                <!-- Zone signature -->
                <div class="lolirine-signature">
                    Signataire autoris&#233;
                </div>

                <!-- Pied de page -->
                <div class="lolirine-footer">
                    <t t-if="o.company_id.email">Email : <t t-esc="o.company_id.email"/> </t>
                    <t t-if="o.company_id.website">| Site : http://<t t-esc="o.company_id.website"/> </t>
                    <t t-if="o.company_id.vat">| TVA : <t t-esc="o.company_id.vat"/> </t>
                    <t t-if="o.company_id.partner_id.bank_ids">
                        | <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.name or ''"/> : <t t-esc="o.company_id.partner_id.bank_ids[0].acc_number"/>
                    </t>
                </div>

            </div>
        </div>
    </template>
</odoo>
