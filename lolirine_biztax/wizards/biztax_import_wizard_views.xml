<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import Wizard Form View -->
    <record id="view_biztax_import_wizard_form" model="ir.ui.view">
        <field name="name">biztax.import.wizard.form</field>
        <field name="model">biztax.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer des Ajustements">
                <group>
                    <group string="Source">
                        <field name="declaration_id" invisible="context.get('active_model') == 'biztax.declaration'"/>
                        <field name="import_type"/>
                    </group>
                    <group string="Options">
                        <field name="replace_existing"/>
                    </group>
                </group>
                
                <!-- CSV/Excel Import -->
                <group invisible="import_type not in ('csv', 'excel')" string="Fichier">
                    <field name="import_file" filename="import_filename"/>
                    <field name="import_filename" invisible="1"/>
                </group>
                
                <!-- Previous Declaration Import -->
                <group invisible="import_type != 'previous'" string="Déclaration Source">
                    <field name="source_declaration_id"/>
                </group>
                
                <!-- Template Import -->
                <group invisible="import_type != 'template'" string="Modèles">
                    <field name="template_category"/>
                </group>
                
                <!-- CSV Format Help -->
                <div class="alert alert-info" role="alert" invisible="import_type != 'csv'">
                    <strong>Format CSV attendu :</strong><br/>
                    <code>code,name,category,type,amount</code><br/>
                    Exemple: <code>I101,Frais de restaurant,dna,increase,1500.00</code>
                </div>
                
                <footer>
                    <button name="action_import" type="object" 
                            string="Importer" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Import Wizard Action -->
    <record id="action_biztax_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer des Ajustements</field>
        <field name="res_model">biztax.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
