<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue Formulaire du Wizard -->
    <record id="visite_to_quotation_wizard_view_form" model="ir.ui.view">
        <field name="name">visite.to.quotation.wizard.form</field>
        <field name="model">visite.to.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Convertir en devis/abonnement">
                <group>
                    <group string="Visite">
                        <field name="visite_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="estimated_volume" readonly="1"/>
                        <field name="estimated_duration" readonly="1"/>
                    </group>
                    <group string="Configuration">
                        <field name="create_type" widget="radio"/>
                        <field name="storage_box_id" options="{'no_create': True}"/>
                        <field name="start_date"/>
                        <field name="product_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <group>
                    <group string="Tarification">
                        <field name="use_box_price"/>
                        <field name="custom_price" invisible="use_box_price"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Abonnement" invisible="create_type != 'subscription'">
                        <field name="subscription_template_id"/>
                    </group>
                </group>
                <group string="Notes de visite" invisible="not notes">
                    <field name="notes" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_create_document" string="Créer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>
