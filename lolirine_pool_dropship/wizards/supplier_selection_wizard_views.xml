<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ============================================ -->
    <!-- WIZARD: SÉLECTION FOURNISSEUR -->
    <!-- ============================================ -->

    <record id="view_supplier_selection_wizard_form" model="ir.ui.view">
        <field name="name">supplier.selection.wizard.form</field>
        <field name="model">supplier.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Sélection manuelle des fournisseurs">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                </group>
                
                <notebook>
                    <page string="Produits à configurer" name="lines">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom" decoration-danger="calculated_margin &lt; 15"
                                  decoration-warning="calculated_margin &gt;= 15 and calculated_margin &lt; 25"
                                  decoration-success="calculated_margin &gt;= 25">
                                <field name="product_id" readonly="1"/>
                                <field name="quantity" readonly="1"/>
                                <field name="sale_price" readonly="1"/>
                                <field name="available_supplier_ids" column_invisible="1"/>
                                <field name="selected_supplier_id" required="1"/>
                                <field name="supplier_cost"/>
                                <field name="calculated_margin" widget="progressbar"/>
                                <field name="supplier_delay"/>
                                <field name="selected_supplier_info_id" column_invisible="1"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                
                <footer>
                    <button name="action_confirm" type="object" string="Confirmer la sélection" 
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- WIZARD: MISE À JOUR SUIVI -->
    <!-- ============================================ -->

    <record id="view_dropship_tracking_wizard_form" model="ir.ui.view">
        <field name="name">dropship.tracking.wizard.form</field>
        <field name="model">dropship.tracking.wizard</field>
        <field name="arch" type="xml">
            <form string="Mise à jour du suivi">
                <group>
                    <group string="Commande">
                        <field name="purchase_id" readonly="1"/>
                        <field name="supplier_order_ref" placeholder="N° commande chez le fournisseur"/>
                    </group>
                    <group string="Livraison">
                        <field name="expected_delivery"/>
                    </group>
                </group>
                
                <group string="Informations de suivi">
                    <group>
                        <field name="carrier_selection"/>
                        <field name="carrier" placeholder="Nom du transporteur" 
                               invisible="carrier_selection != 'other'"/>
                    </group>
                    <group>
                        <field name="tracking_number" placeholder="Ex: 1Z999AA10123456784"/>
                    </group>
                </group>
                
                <group>
                    <field name="notify_customer"/>
                    <field name="notes" placeholder="Notes additionnelles..."/>
                </group>
                
                <footer>
                    <button name="action_update_tracking" type="object" 
                            string="Mettre à jour" class="btn-primary"/>
                    <button name="action_update_and_notify" type="object"
                            string="Mettre à jour et notifier le client" 
                            class="btn-success"
                            invisible="notify_customer"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- WIZARD: SIGNALEMENT PROBLÈME -->
    <!-- ============================================ -->

    <record id="view_dropship_issue_wizard_form" model="ir.ui.view">
        <field name="name">dropship.issue.wizard.form</field>
        <field name="model">dropship.issue.wizard</field>
        <field name="arch" type="xml">
            <form string="Signaler un problème">
                <group>
                    <group string="Commandes concernées">
                        <field name="purchase_id"/>
                        <field name="sale_id"/>
                    </group>
                    <group string="Classification">
                        <field name="issue_type" widget="radio"/>
                        <field name="severity" widget="radio"/>
                    </group>
                </group>
                
                <group string="Description">
                    <field name="description" nolabel="1" placeholder="Décrivez le problème en détail..."/>
                </group>
                
                <group string="Informations complémentaires" col="1">
                    <field name="affected_products" placeholder="Liste des produits concernés..."/>
                    <field name="evidence_note" placeholder="Description des preuves, photos..."/>
                </group>
                
                <group string="Actions à entreprendre">
                    <group>
                        <field name="action_refund"/>
                        <field name="action_reship"/>
                    </group>
                    <group>
                        <field name="action_contact_customer"/>
                        <field name="action_update_reliability"/>
                    </group>
                </group>
                
                <footer>
                    <button name="action_report_issue" type="object" 
                            string="Signaler le problème" class="btn-danger"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</data>
</odoo>
