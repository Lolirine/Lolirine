<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- WIZARD: Créer trajet depuis facture -->
    <!-- ============================================ -->
    
    <record id="km_trajet_from_invoice_wizard_form" model="ir.ui.view">
        <field name="name">km.trajet.from.invoice.wizard.form</field>
        <field name="model">km.trajet.from.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Créer un trajet">
                <group>
                    <group string="Informations de la facture">
                        <field name="invoice_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="trajet_type" readonly="1"/>
                        <field name="date_trajet"/>
                        <field name="categorie_id"/>
                    </group>
                    <group string="Options">
                        <field name="aller_retour"/>
                        <field name="destination_info" readonly="1" 
                               class="text-info" nolabel="1" colspan="2"/>
                        <field name="destination_found" invisible="1"/>
                    </group>
                </group>
                
                <group string="Trajet">
                    <group>
                        <field name="use_predefined" widget="boolean_toggle"/>
                    </group>
                </group>
                
                <group invisible="not use_predefined">
                    <group string="Destination prédéfinie">
                        <field name="lieu_depart_predef_id" 
                               required="use_predefined"
                               options="{'no_create': True}"/>
                        <field name="destination_predef_id" 
                               required="use_predefined"
                               options="{'no_create': True}"/>
                        <field name="distance_aller"/>
                    </group>
                </group>
                
                <group invisible="use_predefined">
                    <group string="Adresses manuelles">
                        <field name="lieu_depart" 
                               required="not use_predefined"
                               placeholder="Adresse de départ"/>
                        <field name="lieu_arrivee" 
                               required="not use_predefined"
                               placeholder="Adresse d'arrivée"/>
                        <field name="distance_aller" 
                               placeholder="Distance en km (laisser 0 pour calculer plus tard)"/>
                    </group>
                </group>
                
                <group>
                    <field name="motif" placeholder="Motif du déplacement..."/>
                </group>
                
                <footer>
                    <button name="action_create_trajet" string="Créer le trajet" 
                            type="object" class="btn-primary"/>
                    <button name="action_create_and_new" string="Créer et nouveau" 
                            type="object" class="btn-secondary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- WIZARD: Créer trajet depuis événement -->
    <!-- ============================================ -->
    
    <record id="km_trajet_from_event_wizard_form" model="ir.ui.view">
        <field name="name">km.trajet.from.event.wizard.form</field>
        <field name="model">km.trajet.from.event.wizard</field>
        <field name="arch" type="xml">
            <form string="Créer un trajet">
                <group>
                    <group string="Informations">
                        <field name="event_id" readonly="1" invisible="not event_id"/>
                        <field name="partner_id"/>
                        <field name="date_trajet"/>
                        <field name="event_type"/>
                        <field name="categorie_id"/>
                    </group>
                    <group string="Options">
                        <field name="aller_retour"/>
                        <field name="use_predefined" widget="boolean_toggle"/>
                    </group>
                </group>
                
                <group invisible="not use_predefined">
                    <group string="Destination prédéfinie">
                        <field name="lieu_depart_predef_id" 
                               required="use_predefined"
                               options="{'no_create': True}"/>
                        <field name="destination_predef_id" 
                               options="{'no_create': True}"/>
                        <field name="distance_aller"/>
                    </group>
                </group>
                
                <group invisible="use_predefined">
                    <group string="Adresses">
                        <field name="lieu_depart" 
                               required="not use_predefined"
                               placeholder="Adresse de départ"/>
                        <field name="lieu_arrivee" 
                               required="not use_predefined"
                               placeholder="Adresse du client"/>
                        <field name="distance_aller" 
                               placeholder="Distance en km"/>
                    </group>
                </group>
                
                <group>
                    <field name="motif" placeholder="Motif du déplacement..."/>
                </group>
                
                <footer>
                    <button name="action_create_trajet" string="Créer le trajet" 
                            type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
