<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- SNIPPET: Section Recommandations Complète    -->
    <!-- ============================================ -->
    <template id="s_recommendations_section" name="Section Recommandations Produits">
        <section class="s_recommendations_section pt-4 pb-4" 
                 data-snippet="s_recommendations_section"
                 data-name="Recommandations Produits">
            <div class="container">
                <!-- Titre de la section -->
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="d-flex align-items-center justify-content-between">
                            <h3 class="recommendations-title mb-0">
                                <i class="fa fa-fire me-2 text-primary"></i>
                                <span class="title-text">Meilleures ventes</span>
                            </h3>
                            <a href="/shop" class="btn btn-link see-all-link">
                                Voir tout <i class="fa fa-chevron-right ms-1"></i>
                            </a>
                        </div>
                        <p class="recommendations-subtitle text-muted mb-0 mt-1" style="display: none;"></p>
                    </div>
                </div>
                
                <!-- Carrousel de produits -->
                <div class="recommendations-carousel-wrapper position-relative">
                    <!-- Bouton précédent -->
                    <button class="carousel-nav-btn carousel-prev" type="button" aria-label="Précédent">
                        <i class="fa fa-chevron-left"></i>
                    </button>
                    
                    <!-- Container produits -->
                    <div class="recommendations-carousel" 
                         data-section-type="best_sellers"
                         data-limit="12"
                         data-category-id="">
                        <!-- Skeleton loader -->
                        <div class="recommendations-skeleton">
                            <div class="skeleton-card" t-foreach="range(6)" t-as="i">
                                <div class="skeleton-image"></div>
                                <div class="skeleton-text"></div>
                                <div class="skeleton-text short"></div>
                                <div class="skeleton-price"></div>
                            </div>
                        </div>
                        
                        <!-- Produits chargés dynamiquement ici -->
                        <div class="recommendations-products"></div>
                    </div>
                    
                    <!-- Bouton suivant -->
                    <button class="carousel-nav-btn carousel-next" type="button" aria-label="Suivant">
                        <i class="fa fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </section>
    </template>
    
    <!-- ============================================ -->
    <!-- SNIPPET: Produits Récemment Consultés       -->
    <!-- ============================================ -->
    <template id="s_recently_viewed" name="Produits Récemment Consultés">
        <section class="s_recommendations_section s_recently_viewed pt-4 pb-4" 
                 data-snippet="s_recently_viewed"
                 data-name="Produits Récemment Consultés">
            <div class="container">
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="d-flex align-items-center justify-content-between">
                            <h3 class="recommendations-title mb-0">
                                <i class="fa fa-history me-2 text-info"></i>
                                <span class="title-text">Produits récemment consultés</span>
                            </h3>
                            <a href="/shop" class="btn btn-link see-all-link">
                                Continuer mes achats <i class="fa fa-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="recommendations-carousel-wrapper position-relative">
                    <button class="carousel-nav-btn carousel-prev" type="button" aria-label="Précédent">
                        <i class="fa fa-chevron-left"></i>
                    </button>
                    
                    <div class="recommendations-carousel" 
                         data-section-type="recently_viewed"
                         data-limit="12"
                         data-hide-if-empty="true">
                        <div class="recommendations-skeleton">
                            <div class="skeleton-card" t-foreach="range(6)" t-as="i">
                                <div class="skeleton-image"></div>
                                <div class="skeleton-text"></div>
                                <div class="skeleton-text short"></div>
