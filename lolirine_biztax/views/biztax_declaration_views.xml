<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Declaration Form View -->
    <record id="view_biztax_declaration_form" model="ir.ui.view">
        <field name="name">biztax.declaration.form</field>
        <field name="model">biztax.declaration</field>
        <field name="arch" type="xml">
            <form string="Déclaration Biztax">
                <header>
                    <button name="action_compute" type="object" string="Calculer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Valider"
                            class="btn-primary" invisible="state != 'computed'"/>
                    <button name="action_generate_xbrl" type="object" string="Générer XBRL"
                            invisible="state not in ('validated', 'generated')"/>
                    <button name="action_generate_biztax" type="object" string="Télécharger .biztax"
                            class="btn-primary" invisible="state not in ('validated', 'generated')"/>
                    <button name="action_mark_submitted" type="object" string="Marquer soumis"
                            invisible="state != 'generated'"
                            confirm="Confirmez-vous que la déclaration a été soumise via Biztax?"/>
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon"
                            invisible="state in ('draft', 'submitted')"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('cancelled', 'submitted')"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,computed,validated,generated,submitted"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_biztax_adjustment)d" type="action"
                                class="oe_stat_button" icon="fa-sliders"
                                context="{'default_declaration_id': id, 'search_default_declaration_id': id}">
                            <field name="adjustment_ids" widget="statinfo" string="Ajustements"/>
                        </button>
                        <button name="action_view_attachments" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Annexes"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Soumis" bg_color="text-bg-success"
                            invisible="state != 'submitted'"/>
                    <widget name="web_ribbon" title="Annulé" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Type de déclaration">
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="declaration_type" readonly="state != 'draft'"/>
                            <field name="declaration_status" readonly="state != 'draft'"/>
                            <field name="corrected_declaration_id" 
                                   invisible="declaration_status != 'corrective'"
                                   readonly="state != 'draft'"/>
                            <field name="taxonomy_version" readonly="state != 'draft'"/>
                        </group>
                        <group string="Période fiscale">
                            <field name="fiscal_year_start" readonly="state != 'draft'"/>
                            <field name="fiscal_year_end" readonly="state != 'draft'"/>
                            <field name="fiscal_year_months"/>
                            <field name="assessment_year"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Identification société">
                            <field name="enterprise_number"/>
                            <field name="fiscal_number"/>
                            <field name="vat_number"/>
                            <field name="legal_form"/>
                            <field name="registered_address"/>
                        </group>
                        <group string="Statut PME">
                            <field name="is_sme"/>
                            <field name="sme_rate" invisible="not is_sme"/>
                            <field name="sme_threshold" invisible="not is_sme"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Résultat comptable" name="result">
                            <group>
                                <group string="Du P&amp;L Odoo">
                                    <field name="total_revenue"/>
                                    <field name="total_expenses"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group string="Résultat">
                                    <field name="accounting_result" class="oe_highlight"/>
                                    <field name="accounting_result_type"/>
                                </group>
                            </group>
                            
                            <group>
                                <group string="Ajustements fiscaux">
                                    <field name="total_increases"/>
                                    <field name="total_decreases"/>
                                    <field name="total_dna"/>
                                    <field name="total_rdt"/>
                                </group>
                                <group string="Base imposable">
                                    <field name="taxable_base" class="oe_highlight"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Calcul de l'impôt" name="tax">
                            <group>
                                <group string="Pertes antérieures">
                                    <field name="previous_losses"/>
                                    <field name="losses_used"/>
                                    <field name="losses_remaining"/>
                                </group>
                                <group string="Taux d'imposition">
                                    <field name="tax_rate"/>
                                </group>
                            </group>
                            
                            <group>
                                <group string="Impôt calculé">
                                    <field name="tax_due" class="oe_highlight"/>
                                </group>
                                <group string="Déductions">
                                    <field name="prepayments"/>
                                    <field name="withholding_tax"/>
                                </group>
                            </group>
                            
                            <group>
                                <group string="Solde">
                                    <field name="tax_balance" class="oe_highlight"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Ajustements" name="adjustments">
                            <field name="adjustment_ids">
                                <list editable="bottom"
                                      decoration-success="adjustment_type == 'decrease'"
                                      decoration-warning="adjustment_type == 'increase'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="tax_code_id"/>
                                    <field name="adjustment_type"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="signed_amount" sum="Total signé"/>
                                    <field name="legal_reference"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Annexes PDF" name="attachments">
                            <div class="alert alert-info" role="alert" invisible="has_mandatory_annexes">
                                <strong>Annexes manquantes:</strong> <field name="missing_mandatory_annexes" nolabel="1"/>
                            </div>
                            
                            <!-- Boutons de génération automatique -->
                            <div class="mb-3">
                                <button name="action_generate_all_annexes" type="object" 
                                        string="⚡ Générer toutes les annexes" class="btn-primary me-2"
                                        invisible="state in ('submitted', 'cancelled')"
                                        title="Génère automatiquement le Bilan, Compte de résultats, DNA et Résumé fiscal"/>
                                <button name="action_generate_balance_sheet" type="object" 
                                        string="📊 Bilan" class="btn-secondary me-1"
                                        invisible="state in ('submitted', 'cancelled')"/>
                                <button name="action_generate_profit_loss" type="object" 
                                        string="📈 Compte de résultats" class="btn-secondary me-1"
                                        invisible="state in ('submitted', 'cancelled')"/>
                                <button name="action_generate_dna_detail" type="object" 
                                        string="📝 Détail DNA" class="btn-secondary me-1"
                                        invisible="state in ('submitted', 'cancelled') or total_dna == 0"/>
                                <button name="action_generate_fiscal_summary" type="object" 
                                        string="📋 Résumé fiscal" class="btn-secondary"
                                        invisible="state in ('submitted', 'cancelled')"/>
                            </div>
                            
                            <field name="attachment_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="annex_type"/>
                                    <field name="is_mandatory"/>
                                    <field name="file_data" filename="file_name"/>
                                    <field name="file_name" column_invisible="1"/>
                                    <field name="file_size"/>
                                    <field name="generated_from_odoo"/>
                                </list>
                            </field>
                            <field name="has_mandatory_annexes" invisible="1"/>
                        </page>
                        
                        <page string="Fichiers générés" name="files"
                              invisible="state not in ('generated', 'submitted')">
                            <group>
                                <group string="Instance XBRL">
                                    <field name="xbrl_file" filename="xbrl_filename"/>
                                    <field name="xbrl_filename" invisible="1"/>
                                </group>
                                <group string="Package Biztax">
                                    <field name="biztax_file" filename="biztax_filename"/>
                                    <field name="biztax_filename" invisible="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="Dates">
                                    <field name="generation_date"/>
                                    <field name="submission_date"/>
                                    <field name="submission_reference"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_biztax_declaration_tree" model="ir.ui.view">
        <field name="name">biztax.declaration.tree</field>
        <field name="model">biztax.declaration</field>
        <field name="arch" type="xml">
            <list string="Déclarations Biztax"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'computed'"
                  decoration-success="state in ('validated', 'generated', 'submitted')"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="company_id"/>
                <field name="declaration_type"/>
                <field name="declaration_status"/>
                <field name="fiscal_year_end"/>
                <field name="assessment_year"/>
                <field name="accounting_result"/>
                <field name="taxable_base"/>
                <field name="tax_due"/>
                <field name="tax_balance"/>
                <field name="attachment_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'computed'"
                       decoration-success="state in ('validated', 'generated', 'submitted')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_biztax_declaration_search" model="ir.ui.view">
        <field name="name">biztax.declaration.search</field>
        <field name="model">biztax.declaration</field>
        <field name="arch" type="xml">
            <search string="Rechercher déclarations">
                <field name="name"/>
                <field name="company_id"/>
                <field name="assessment_year"/>
                <field name="enterprise_number"/>
                <separator/>
                <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_computed" string="Calculé" domain="[('state', '=', 'computed')]"/>
                <filter name="filter_validated" string="Validé" domain="[('state', '=', 'validated')]"/>
                <filter name="filter_generated" string="Généré" domain="[('state', '=', 'generated')]"/>
                <filter name="filter_submitted" string="Soumis" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="filter_isoc" string="ISOC" domain="[('declaration_type', '=', 'rcorp')]"/>
                <filter name="filter_ipm" string="IPM" domain="[('declaration_type', '=', 'rle')]"/>
                <filter name="filter_inr" string="INR" domain="[('declaration_type', '=', 'nrcorp')]"/>
                <separator/>
                <filter name="filter_initial" string="Initiale" domain="[('declaration_status', '=', 'initial')]"/>
                <filter name="filter_corrective" string="Corrective" domain="[('declaration_status', '=', 'corrective')]"/>
                <separator/>
                <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Société" name="group_company" context="{'group_by': 'company_id'}"/>
                <filter string="Exercice" name="group_year" context="{'group_by': 'assessment_year'}"/>
                <filter string="Type" name="group_type" context="{'group_by': 'declaration_type'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_biztax_declaration" model="ir.actions.act_window">
        <field name="name">Déclarations fiscales</field>
        <field name="res_model">biztax.declaration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_biztax_declaration_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première déclaration fiscale
            </p>
            <p>
                Cliquez sur <b>Nouveau</b> pour créer une déclaration ISOC, IPM ou INR.
                <br/>
                Les déclarations Biztax permettent de calculer l'impôt des sociétés
                et de générer les fichiers XBRL pour soumission sur MyMinfin/Biztax.
            </p>
        </field>
    </record>
</odoo>
