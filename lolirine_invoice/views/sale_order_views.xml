<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Bouton de résiliation avec prorata sur le formulaire abonnement -->
    <record id="sale_order_view_form_subscription_prorata" model="ir.ui.view">
        <field name="name">sale.order.form.subscription.prorata</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Ajouter les boutons après le bouton "Renouveler" -->
            <xpath expr="//button[@name='prepare_renewal_order']" position="after">
                <button name="action_terminate_with_prorata" 
                        type="object" 
                        string="Résilier avec Prorata" 
                        class="btn-secondary"
                        invisible="not is_subscription or subscription_state != '3_progress' or not end_date"
                        confirm="Créer une facture prorata et clôturer l'abonnement ?"/>
                <button name="action_terminate_and_close" 
                        type="object" 
                        string="Clôturer sans Prorata" 
                        class="btn-warning"
                        invisible="not is_subscription or subscription_state != '3_progress'"
                        confirm="Clôturer l'abonnement SANS facture prorata ?"/>
            </xpath>
        </field>
    </record>
    
</odoo>
