<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Afficher les options d'envoi sur les factures clients -->
    <record id="view_move_form_send_options" model="ir.ui.view">
        <field name="name">account.move.form.send.options</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            
            <!-- Ajouter les options d'envoi après le journal -->
            <xpath expr="//field[@name='journal_id']/.." position="after">
                <group string="📤 Options d'envoi" 
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       col="1">
                    <field name="auto_send_invoice" 
                           string="📧 Envoi Email automatique"
                           widget="boolean_toggle"/>
                    <field name="auto_send_peppol" 
                           string="🔄 Envoi Peppol automatique"
                           widget="boolean_toggle"/>
                </group>
            </xpath>
            
        </field>
    </record>
    
</odoo>
