        <!-- ══ Vague SVG ══ -->
        <div class="s_pool_guides_wave" aria-hidden="true">
            <svg viewBox="0 0 1440 90" xmlns="http://www.w3.org/2000/svg"
                 preserveAspectRatio="none" style="display:block;width:100%;height:90px;">
