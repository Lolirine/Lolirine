<template id="box_map_template" name="Plan des boxes">
  <t t-call="website.layout">
    <div class="container">
      <h2>Plan interactif des boxes</h2>
      <svg width="900" height="700">
        <t t-foreach="boxes" t-as="box">
          <rect t-att-x="box.x" t-att-y="box.y" width="60" height="40"
                t-att-fill="'green' if box.etat == 'libre' else ('red' if box.etat == 'occupe' else 'orange')"
                style="stroke:#000;stroke-width:1px;cursor:pointer"
                t-att-data-box-id="box.id"/>
          <text t-att-x="box.x + 5" t-att-y="box.y + 25" fill="white" font-size="12">
            <t t-esc="box.name"/>
          </text>
        </t>
      </svg>
    </div>
  </t>
</template>