<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_supplement" model="ir.ui.view">
        <field name="name">delivery.carrier.form.pool.supplement</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="currency_id" invisible="1"/>
                <field name="pool_supplement_transport" widget="monetary"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_supplement" model="ir.ui.view">
        <field name="name">product.template.form.pool.supplement</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="pool_supplement_transport" invisible="not sale_ok"/>
            </xpath>
        </field>
    </record>
</odoo>
