<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form_ai_chat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai_chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//app[@data-key='website']" position="inside">
                <block title="Assistant IA Chat" name="ai_chat_settings">
                    <setting string="Cle API Anthropic">
                        <field name="ai_chat_api_key" />
                    </setting>
                    <setting string="Modele IA">
                        <field name="ai_chat_model" />
                    </setting>
                    <setting string="Tokens max">
                        <field name="ai_chat_max_tokens" />
                    </setting>
                    <setting string="Activer le chat IA">
                        <field name="ai_chat_enabled" />
                    </setting>
                    <setting string="Recherche web">
                        <field name="ai_chat_web_search" />
                    </setting>
                    <setting string="Recherche produits">
                        <field name="ai_chat_product_search" />
                    </setting>
                    <setting string="Sauvegarder conversations">
                        <field name="ai_chat_save_conversations" />
                    </setting>
                    <setting string="Prompt systeme">
                        <field name="ai_chat_system_prompt" />
                    </setting>
                    <setting string="Message de bienvenue">
                        <field name="ai_chat_welcome_message" />
                    </setting>
                    <setting string="Couleur principale">
                        <field name="ai_chat_primary_color" />
                    </setting>
                    <setting string="Couleur secondaire">
                        <field name="ai_chat_secondary_color" />
                    </setting>
                    <setting string="Position du widget">
                        <field name="ai_chat_position" />
                    </setting>
                    <setting string="Messages max par session">
                        <field name="ai_chat_max_messages_session" />
                    </setting>
                    <setting string="Sessions max par jour">
                        <field name="ai_chat_max_sessions_day" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>