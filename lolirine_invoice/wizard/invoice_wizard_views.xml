<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== WIZARD ENVOI GROUPE ==================== -->
    
    <record id="view_invoice_mass_send_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.mass.send.wizard.form</field>
        <field name="model">lolirine.invoice.mass.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Envoi groupe de factures">
                <group>
                    <group>
                        <field name="send_type" widget="radio"/>
                        <field name="skip_already_sent"/>
                    </group>
                    <group>
                        <div class="alert alert-info">
                            <strong>Resume:</strong>
                            <ul>
                                <li><field name="invoice_count" class="oe_inline"/> facture(s) selectionnee(s)</li>
                                <li><field name="email_count" class="oe_inline"/> avec adresse email</li>
                                <li><field name="peppol_count" class="oe_inline"/> avec endpoint Peppol</li>
                            </ul>
                        </div>
                    </group>
                </group>
                <notebook>
                    <page string="Apercu des envois" name="preview">
                        <field name="preview_line_ids" readonly="1">
                            <list>
                                <field name="invoice_id"/>
                                <field name="partner_id"/>
                                <field name="can_email" widget="boolean"/>
                                <field name="already_sent_email" widget="boolean"/>
                                <field name="will_send_email" widget="boolean" decoration-success="will_send_email"/>
                                <field name="can_peppol" widget="boolean"/>
                                <field name="already_sent_peppol" widget="boolean"/>
                                <field name="will_send_peppol" widget="boolean" decoration-success="will_send_peppol"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_send" type="object" string="Envoyer" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_invoice_mass_send_wizard" model="ir.actions.act_window">
        <field name="name">Envoi groupe</field>
        <field name="res_model">lolirine.invoice.mass.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- ==================== WIZARD EXPORT COMPTABLE ==================== -->
    
    <record id="view_invoice_export_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.export.wizard.form</field>
        <field name="model">lolirine.invoice.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export comptable">
                <group invisible="context.get('show_download')">
                    <group string="Periode">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filtres">
                        <field name="state_filter"/>
                        <field name="payment_filter"/>
                    </group>
                </group>
                <group invisible="context.get('show_download')">
                    <group string="Options">
                        <field name="export_format" widget="radio"/>
                        <field name="include_lines"/>
                    </group>
                    <group>
                        <div class="alert alert-info">
                            <strong><field name="invoice_count" class="oe_inline"/></strong> facture(s) trouvee(s)
                        </div>
                    </group>
                </group>
                <group invisible="not context.get('show_download')">
                    <div class="alert alert-success">
                        <h4>Export termine !</h4>
                        <p>Cliquez sur le bouton ci-dessous pour telecharger le fichier.</p>
                    </div>
                    <field name="file_name" readonly="1"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Exporter" class="btn-primary" invisible="context.get('show_download')"/>
                    <button name="action_download" type="object" string="Telecharger" class="btn-success" invisible="not context.get('show_download')"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_invoice_export_wizard" model="ir.actions.act_window">
        <field name="name">Export comptable</field>
        <field name="res_model">lolirine.invoice.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
