<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Kanban ultra-simple -->
    <record id="view_pool_catalog_pdf_image_kanban" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.image.kanban</field>
        <field name="model">pool.catalog.pdf.image</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="role"/>
                <field name="image_final"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card" style="width: 200px;">
                            <div style="height: 120px; text-align: center;">
                                <img t-att-src="kanban_image('pool.catalog.pdf.image', 'image_final', record.id.raw_value)" 
                                     style="max-width: 100%; max-height: 100%;"/>
                            </div>
                            <div class="p-2">
                                <strong><t t-esc="record.name.value"/></strong>
                                <br/>
                                <span t-att-class="'badge ' + (record.role.raw_value == 'primary' ? 'bg-warning' : 'bg-secondary')">
                                    <t t-esc="record.role.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Vue Liste ultra-simple -->
    <record id="view_pool_catalog_pdf_image_list" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.image.list</field>
        <field name="model">pool.catalog.pdf.image</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role"/>
            </list>
        </field>
    </record>
    
    <!-- Vue Formulaire ultra-simple -->
    <record id="view_pool_catalog_pdf_image_form" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.image.form</field>
        <field name="model">pool.catalog.pdf.image</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="role"/>
                        <field name="image_final" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action principale -->
    <record id="action_pool_catalog_pdf_image" model="ir.actions.act_window">
        <field name="name">Images Extraites</field>
        <field name="res_model">pool.catalog.pdf.image</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Menu pour accéder aux images (temporaire) -->
    <menuitem id="menu_pool_catalog_images" 
              name="Images Extraites" 
              parent="lolirine_pool_import.menu_pool_catalog_root"
              action="action_pool_catalog_pdf_image"
              sequence="20"/>
</odoo>
