<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste des couleurs -->
    <record id="view_storage_status_color_tree" model="ir.ui.view">
        <field name="name">storage.status.color.tree</field>
        <field name="model">storage.status.color</field>
        <field name="arch" type="xml">
            <list string="Couleurs des statuts" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="status_key"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="show_in_legend"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire des couleurs -->
    <record id="view_storage_status_color_form" model="ir.ui.view">
        <field name="name">storage.status.color.form</field>
        <field name="model">storage.status.color</field>
        <field name="arch" type="xml">
            <form string="Couleur du statut">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="status_key"/>
                            <field name="name" placeholder="Ex: Disponible, Libre, À louer..."/>
                            <field name="sequence"/>
                        </group>
                        <group string="Apparence">
                            <field name="color" widget="color_picker"/>
                            <field name="show_in_legend"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour les couleurs -->
    <record id="action_storage_status_color" model="ir.actions.act_window">
        <field name="name">Couleurs des statuts</field>
        <field name="res_model">storage.status.color</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez les couleurs des statuts
            </p>
            <p>
                Définissez les couleurs pour chaque statut de box et personnalisez la légende du plan interactif.
            </p>
        </field>
    </record>
</odoo>
