<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron_update_supplier_reliability" model="ir.cron">
            <field name="name">Dropshipping: Mise à jour fiabilité fournisseurs</field>
            <field name="model_id" ref="model_supplier_dropship_info"/>
            <field name="state">code</field>
            <field name="code">model.search([('is_active', '=', True)]).update_reliability_score()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_check_pending_orders" model="ir.cron">
            <field name="name">Dropshipping: Vérifier commandes en attente</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.search([('is_dropship_order', '=', True), ('state', '=', 'sale'), ('dropship_status', 'in', ['pending', 'analyzed'])])._analyze_dropship_suppliers()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
