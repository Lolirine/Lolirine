<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- ENHANCED COMPANY FORM FOR BIZTAX            -->
    <!-- ============================================ -->
    
    <record id="view_company_biztax_form_extended" model="ir.ui.view">
        <field name="name">res.company.biztax.extended.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="lolirine_biztax.view_company_biztax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@string='Identification Biztax']" position="replace">
                <group string="Identification BCE/KBO">
                    <group>
                        <field name="vat"/>
                        <field name="enterprise_number" readonly="1"/>
                        <field name="enterprise_number_formatted" readonly="1"/>
                    </group>
                    <group>
                        <field name="legal_form"/>
                        <field name="legal_form_code" readonly="1"/>
                        <field name="foundation_date"/>
                        <field name="fiscal_year_closing_month"/>
                    </group>
                </group>
            </xpath>
            
            <xpath expr="//page[@name='biztax_settings']" position="inside">
                <!-- NACE Codes -->
                <group string="Codes NACE">
                    <group>
                        <field name="nace_main_code"/>
                        <field name="nace_main_description"/>
                    </group>
                </group>
                <field name="nace_secondary_ids">
                    <list editable="bottom">
                        <field name="code"/>
                        <field name="description"/>
                        <field name="is_main"/>
                    </list>
                </field>
                
                <!-- Registered Office -->
                <group string="Siège social">
                    <group>
                        <field name="registered_street"/>
                        <field name="registered_street_number"/>
                        <field name="registered_box"/>
                    </group>
                    <group>
                        <field name="registered_zip"/>
                        <field name="registered_city"/>
                        <field name="registered_country_code"/>
                    </group>
                </group>
                
                <!-- Declarant -->
                <group string="Déclarant">
                    <group>
                        <field name="declarant_type"/>
                        <field name="declarant_name"/>
                        <field name="declarant_quality"/>
                    </group>
                    <group>
                        <field name="declarant_national_number"/>
                        <field name="declarant_itaa_number" 
                               invisible="declarant_type == 'internal'"/>
                    </group>
                </group>
                
                <!-- SME Criteria -->
                <group string="Critères PME (Art. 1:24-25 CSA)">
                    <group>
                        <field name="sme_employees_fte"/>
                        <field name="sme_turnover"/>
                        <field name="sme_balance_total"/>
                    </group>
                    <group>
                        <field name="sme_criteria_met"/>
                        <field name="is_small_company" readonly="1"/>
                        <field name="is_micro_company" readonly="1"/>
                    </group>
                </group>
                
                <!-- Bank account for tax -->
                <group string="Compte bancaire fiscal">
                    <field name="tax_bank_account_id"/>
                    <field name="tax_iban" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- DIRECTORS / MANDATAIRES                     -->
    <!-- ============================================ -->
    
    <record id="view_res_company_director_form" model="ir.ui.view">
        <field name="name">res.company.director.form</field>
        <field name="model">res.company.director</field>
        <field name="arch" type="xml">
            <form string="Mandataire">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="company_id"/>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="director_type"/>
                            <field name="function"/>
                        </group>
                        <group string="Personne physique" invisible="director_type != 'natural'">
                            <field name="national_number"/>
                            <field name="birth_date"/>
                        </group>
                        <group string="Personne morale" invisible="director_type != 'legal'">
                            <field name="enterprise_number"/>
                            <field name="permanent_representative"/>
                        </group>
                    </group>
                    <group string="Mandat">
                        <group>
                            <field name="mandate_start"/>
                            <field name="mandate_end"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="receives_remuneration"/>
                            <field name="remuneration_amount" invisible="not receives_remuneration"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_res_company_director_tree" model="ir.ui.view">
        <field name="name">res.company.director.tree</field>
        <field name="model">res.company.director</field>
        <field name="arch" type="xml">
            <list string="Mandataires" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="director_type"/>
                <field name="function"/>
                <field name="mandate_start"/>
                <field name="mandate_end"/>
                <field name="is_active"/>
                <field name="receives_remuneration"/>
            </list>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- ANNEX REQUIREMENT VIEWS                     -->
    <!-- ============================================ -->
    
    <record id="view_biztax_annex_requirement_form" model="ir.ui.view">
        <field name="name">biztax.annex.requirement.form</field>
        <field name="model">biztax.annex.requirement</field>
        <field name="arch" type="xml">
            <form string="Annexe requise">
                <header>
                    <button name="action_generate_annex" type="object" 
                            string="Générer depuis Odoo"
                            class="oe_highlight"
                            invisible="not can_auto_generate or status != 'missing'"/>
                </header>
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="declaration_id"/>
                            <field name="registry_id"/>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group string="Statut">
                            <field name="is_mandatory"/>
                            <field name="mandatory_reason"/>
                            <field name="status" widget="badge"/>
                            <field name="can_auto_generate"/>
                        </group>
                    </group>
                    <group string="Fichier">
                        <field name="attachment_id"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_biztax_annex_requirement_tree" model="ir.ui.view">
        <field name="name">biztax.annex.requirement.tree</field>
        <field name="model">biztax.annex.requirement</field>
        <field name="arch" type="xml">
            <list string="Annexes requises" 
                  decoration-danger="is_mandatory and status == 'missing'"
                  decoration-success="status in ('ready', 'validated')"
                  decoration-muted="not is_mandatory">
                <field name="code"/>
                <field name="name"/>
                <field name="is_mandatory"/>
                <field name="status" widget="badge"/>
                <field name="can_auto_generate"/>
                <field name="attachment_id"/>
                <button name="action_generate_annex" type="object" 
                        string="Générer" icon="fa-magic"
                        invisible="not can_auto_generate or status != 'missing'"/>
            </list>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- ANNEX REGISTRY VIEWS                        -->
    <!-- ============================================ -->
    
    <record id="view_biztax_annex_registry_form" model="ir.ui.view">
        <field name="name">biztax.annex.registry.form</field>
        <field name="model">biztax.annex.registry</field>
        <field name="arch" type="xml">
            <form string="Type d'annexe Biztax">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" class="oe_inline"/> - 
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="category"/>
                            <field name="name_nl"/>
                            <field name="legal_reference"/>
                        </group>
                        <group string="Conditions d'obligation">
                            <field name="is_always_mandatory"/>
                            <field name="mandatory_condition"/>
                            <field name="mandatory_field"/>
                            <field name="mandatory_adjustment_category"/>
                        </group>
                    </group>
                    <group>
                        <group string="Applicabilité - Type déclaration">
                            <field name="applicable_rcorp"/>
                            <field name="applicable_rle"/>
                            <field name="applicable_nrcorp"/>
                        </group>
                        <group string="Applicabilité - Taille société">
                            <field name="applicable_large"/>
                            <field name="applicable_small"/>
                            <field name="applicable_micro"/>
                        </group>
                    </group>
                    <group string="Génération automatique">
                        <field name="can_auto_generate"/>
                        <field name="odoo_report_name" invisible="not can_auto_generate"/>
                        <field name="template_url"/>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_biztax_annex_registry_tree" model="ir.ui.view">
        <field name="name">biztax.annex.registry.tree</field>
        <field name="model">biztax.annex.registry</field>
        <field name="arch" type="xml">
            <list string="Types d'annexes Biztax">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="is_always_mandatory"/>
                <field name="can_auto_generate"/>
                <field name="applicable_rcorp"/>
                <field name="applicable_small"/>
            </list>
        </field>
    </record>
    
    <record id="view_biztax_annex_registry_search" model="ir.ui.view">
        <field name="name">biztax.annex.registry.search</field>
        <field name="model">biztax.annex.registry</field>
        <field name="arch" type="xml">
            <search string="Recherche annexes">
                <field name="code"/>
                <field name="name"/>
                <filter string="Obligatoire" name="mandatory" domain="[('is_always_mandatory', '=', True)]"/>
                <filter string="Auto-génération" name="auto" domain="[('can_auto_generate', '=', True)]"/>
                <group expand="1" string="Grouper par">
                    <filter string="Catégorie" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action for annex registry -->
    <record id="action_biztax_annex_registry" model="ir.actions.act_window">
        <field name="name">Types d'annexes</field>
        <field name="res_model">biztax.annex.registry</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>
    
    <!-- Menu item for annex registry (in configuration) -->
    <menuitem
        id="menu_biztax_annex_registry"
        name="Types d'annexes"
        parent="lolirine_biztax.menu_biztax_config"
        action="action_biztax_annex_registry"
        sequence="35"/>
    
</odoo>
