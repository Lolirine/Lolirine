<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         FORMULAIRE WIZARD ENVOI NOTIFICATIONS
         ===================================================================== -->
    <record id="view_lolirine_indexation_send_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.indexation.send.wizard.form</field>
        <field name="model">lolirine.indexation.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Envoi des notifications d'indexation">
                <sheet>
                    <div class="oe_title">
                        <h1>📧 Envoi des notifications d'indexation</h1>
                        <p class="text-muted">
                            Prévisualise et envoie les notifications d'indexation
                            aux clients concernés. Les sociétés reçoivent un PDF
                            officiel en pièce jointe ; les particuliers ne
                            reçoivent que l'email.
                        </p>
                    </div>

                    <field name="indexation_id" invisible="1"/>

                    <group>
                        <group string="Options">
                            <field name="attach_pdf_for_companies"/>
                            <field name="test_mode"/>
                            <field name="test_email"
                                   invisible="not test_mode"
                                   required="test_mode"/>
                        </group>

                        <group string="Synthèse">
                            <field name="total_lines"/>
                            <field name="total_companies"/>
                            <field name="total_individuals"/>
                            <field name="total_no_email"
                                   class="text-danger"
                                   invisible="total_no_email == 0"/>
                            <field name="total_already_sent"
                                   invisible="total_already_sent == 0"/>
                        </group>
                    </group>

                    <div class="alert alert-warning"
                         role="alert"
                         invisible="total_no_email == 0">
                        <strong>⚠️ Attention :</strong>
                        <field name="total_no_email" readonly="1" nolabel="1"/>
                        client(s) n'ont pas d'adresse email — ils ne
                        recevront PAS de notification automatique.
                    </div>

                    <div class="alert alert-info"
                         role="alert"
                         invisible="not test_mode">
                        <strong>🧪 Mode test activé :</strong>
                        Tous les emails seront envoyés à
                        <field name="test_email" readonly="1" nolabel="1"/>
                        au lieu des vrais destinataires.
                        Aucun client réel ne recevra d'email.
                    </div>

                    <notebook>
                        <page string="📬 Aperçu de l'email" name="preview">
                            <group>
                                <field name="preview_line_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <field name="preview_will_attach_pdf" invisible="1"/>

                            <div invisible="not preview_line_id">
                                <button name="action_send_to_self_test"
                                        string="✉️ M'envoyer cet aperçu"
                                        type="object"
                                        class="btn-secondary"/>

                                <div style="margin-top: 15px; border: 1px solid #dee2e6; border-radius: 4px; background: white;">
                                    <field name="preview_html"
                                           nolabel="1"
                                           readonly="1"
                                           widget="html"/>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button name="action_send_all"
                            string="📨 Envoyer à tous"
                            type="object"
                            class="btn-success"
                            confirm="Confirmes-tu l'envoi des notifications d'indexation à tous les clients concernés ?"/>
                    <button string="Annuler"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- =====================================================================
         ACTION + BOUTON SUR LA FICHE storage.indexation
         ===================================================================== -->
    <record id="action_lolirine_indexation_send_wizard"
            model="ir.actions.act_window">
        <field name="name">Envoyer les notifications</field>
        <field name="res_model">lolirine.indexation.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="storage_indexation.model_storage_indexation"/>
        <field name="binding_view_types">form</field>
    </record>

    <!-- =====================================================================
         AJOUT D'UN BOUTON SUR LA FICHE D'INDEXATION
         ===================================================================== -->
    <record id="view_storage_indexation_form_inherit_lolirine"
            model="ir.ui.view">
        <field name="name">storage.indexation.form.inherit.lolirine</field>
        <field name="model">storage.indexation</field>
        <field name="inherit_id"
               ref="storage_indexation.view_storage_indexation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_send_notifications']"
                   position="replace">
                <button name="%(action_lolirine_indexation_send_wizard)d"
                        string="📨 Envoyer les notifications"
                        type="action"
                        class="btn-primary"
                        invisible="state not in ('confirmed', 'computed')"/>
            </xpath>
        </field>
    </record>

</odoo>
