<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue du wizard de scan -->
    <record id="view_lolirine_scan_tva_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.wizard.form</field>
        <field name="model">lolirine.scan.tva.wizard</field>
        <field name="arch" type="xml">
            <form string="Scanner une souche TVA">
                <group>
                    <group string="Document a scanner">
                        <field name="document_type" widget="radio"/>
                        <field name="document" filename="document_filename" widget="binary" class="oe_inline"/>
                        <field name="document_filename" invisible="1"/>
                    </group>
                    <group string="Informations">
                        <div class="alert alert-info" role="alert">
                            <h4><i class="fa fa-info-circle"/> Instructions</h4>
                            <ol>
                                <li>Selectionnez le type de document (Image ou PDF)</li>
                                <li>Uploadez ou scannez votre ticket/facture</li>
                                <li>Cliquez sur "Scanner et extraire"</li>
                                <li>Verifiez et completez les informations extraites</li>
                                <li>Validez et creez la facture fournisseur</li>
                            </ol>
                        </div>
                    </group>
                </group>
                <group>
                    <field name="notes" placeholder="Notes optionnelles..."/>
                </group>
                <footer>
                    <button name="action_create_scan" 
                            type="object" 
                            string="Scanner et extraire" 
                            class="btn-primary"
                            icon="fa-magic"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Vue du wizard d'extraction manuelle -->
    <record id="view_lolirine_scan_tva_extract_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.extract.wizard.form</field>
        <field name="model">lolirine.scan.tva.extract.wizard</field>
        <field name="arch" type="xml">
            <form string="Extraction manuelle">
                <group>
                    <group string="Fournisseur">
                        <field name="supplier_vat" placeholder="BE0123456789"/>
                        <field name="supplier_name"/>
                    </group>
                    <group string="Facture">
                        <field name="invoice_number"/>
                        <field name="invoice_date"/>
                    </group>
                </group>
                <group>
                    <group string="Montants">
                        <field name="tax_rate"/>
                        <field name="amount_untaxed"/>
                        <field name="amount_tax"/>
                        <field name="amount_total"/>
                    </group>
                    <group string="Texte OCR (reference)">
                        <field name="ocr_text" readonly="1" nolabel="1"/>
                    </group>
                </group>
                <field name="scan_id" invisible="1"/>
                <footer>
                    <button name="action_apply" 
                            type="object" 
                            string="Appliquer" 
                            class="btn-primary"
                            icon="fa-check"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
