<odoo>
    <record id="view_lolirine_box_tree" model="ir.ui.view">
        <field name="name">lolirine.box.tree</field>
        <field name="model">lolirine.box</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="location"/>
                <field name="size"/>
                <field name="is_available"/>
            </tree>
        </field>
    </record>

    <record id="view_lolirine_box_form" model="ir.ui.view">
        <field name="name">lolirine.box.form</field>
        <field name="model">lolirine.box</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="location"/>
                    <field name="size"/>
                    <field name="is_available"/>
                </group>
            </form>
        </field>
    </record>

    <menuitem id="menu_lolirine_box_root" name="Garde-meubles"/>
    <menuitem id="menu_lolirine_box" name="Boxes" parent="menu_lolirine_box_root"/>

    <record id="action_lolirine_box" model="ir.actions.act_window">
        <field name="name">Boxes</field>
        <field name="res_model">lolirine.box</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_lolirine_box_action" name="Liste des Boxes"
              parent="menu_lolirine_box"
              action="action_lolirine_box"/>
</odoo>
