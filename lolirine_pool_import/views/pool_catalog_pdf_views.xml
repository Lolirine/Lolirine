<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ LIST VIEW — Import ═══ -->
    <record id="pool_catalog_pdf_import_list" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.import.list</field>
        <field name="model">pool.catalog.pdf.import</field>
        <field name="arch" type="xml">
            <list string="Imports PDF catalogue">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="page_start"/>
                <field name="page_end"/>
                <field name="page_current"/>
                <field name="product_count"/>
                <field name="imported_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'running'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <!-- ═══ FORM VIEW — Import ═══ -->
    <record id="pool_catalog_pdf_import_form" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.import.form</field>
        <field name="model">pool.catalog.pdf.import</field>
        <field name="arch" type="xml">
            <form string="Import PDF Catalogue FlippingBook">
                <header>
                    <button name="action_run_pdf_upload"
                            string="▶ Traiter PDF uploadé"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft', 'running'] or not source_pdf"/>
                    <button name="action_run_import"
                            string="▶ Importer 50 pages"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft', 'running']"/>
                    <button name="action_import_to_odoo"
                            string="→ Importer dans Odoo"
                            type="object"
                            class="btn-secondary"
                            invisible="product_count == 0"/>
                    <button name="action_update_costs_only"
                            string="💰 Mettre à jour les coûts"
                            type="object"
                            class="btn-secondary"
                            invisible="product_count == 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex: Fluidra Benelux 2026"/></h1>
                    </div>
                    <group>
                        <group string="Configuration FlippingBook (Fluidra)">
                            <field name="supplier_id"/>
                            <field name="base_url"/>
                            <field name="guid"/>
                        </group>
                        <group string="PDF uploadé (ex: SCP FlipDocs)">
                            <field name="source_pdf" widget="binary" filename="source_pdf_filename"/>
                            <field name="source_pdf_filename" invisible="1"/>
                            <field name="pages_per_chunk"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pages à traiter (FlippingBook)">
                            <field name="page_start"/>
                            <field name="page_end"/>
                            <field name="page_current" readonly="1"/>
                        </group>
                    </group>
                    <group string="Statistiques" invisible="product_count == 0">
                        <group>
                            <field name="product_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="imported_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" readonly="1" invisible="not notes"
                           widget="text" string="Erreurs"/>
                    <notebook>
                        <page string="Produits extraits" name="products">
                            <field name="product_ids" nolabel="1">
                                <list decoration-success="state == 'imported'"
                                      decoration-muted="state == 'skipped'"
                                      decoration-danger="state == 'error'">
                                    <field name="page_num" string="Page"/>
                                    <field name="ref" string="Référence"/>
                                    <field name="name" string="Nom"/>
                                    <field name="brand" string="Marque"/>
                                    <field name="category" string="Catégorie"/>
                                    <field name="price" string="Prix catalogue" widget="monetary"/>
                                    <field name="price_net" string="Prix net" widget="monetary"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'imported'"
                                           decoration-warning="state == 'to_import'"
                                           decoration-danger="state == 'error'"/>
                                    <field name="product_id" string="Produit Odoo" optional="show"/>
                                    <button name="action_import" string="Importer"
                                            type="object" icon="fa-download"
                                            invisible="state != 'to_import'"/>
                                    <button name="action_skip" string="Ignorer"
                                            type="object" icon="fa-times"
                                            invisible="state != 'to_import'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══ SEARCH VIEW ═══ -->
    <record id="pool_catalog_pdf_product_search" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.product.search</field>
        <field name="model">pool.catalog.pdf.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ref"/>
                <field name="brand"/>
                <field name="category"/>
                <filter name="to_import" string="À importer" domain="[('state','=','to_import')]"/>
                <filter name="imported"  string="Importés"   domain="[('state','=','imported')]"/>
                <filter name="with_price" string="Avec prix" domain="[('price','>',0)]"/>
                <separator/>
                <filter name="group_cat" string="Catégorie" context="{'group_by':'category'}"/>
                <filter name="group_brand" string="Marque"  context="{'group_by':'brand'}"/>
            </search>
        </field>
    </record>

    <!-- ═══ ACTIONS ═══ -->
    <record id="action_pool_catalog_pdf_import" model="ir.actions.act_window">
        <field name="name">Import PDF Catalogue</field>
        <field name="res_model">pool.catalog.pdf.import</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
