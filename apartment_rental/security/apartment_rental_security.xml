<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Catégorie du module -->
        <record id="module_category_apartment_rental" model="ir.module.category">
            <field name="name">Gestion Locative</field>
            <field name="sequence">50</field>
        </record>

        <!-- Groupe Utilisateur -->
        <record id="group_apartment_rental_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_apartment_rental"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe Manager -->
        <record id="group_apartment_rental_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_apartment_rental"/>
            <field name="implied_ids" eval="[(4, ref('group_apartment_rental_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
