<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Création du site web Lolirine Pool Store -->
    <record id="website_pool" model="website">
        <field name="name">Lolirine Pool Store</field>
        <field name="domain">lolirine-pool.be</field>
        <field name="is_pool_website">True</field>
        <field name="logo" type="base64" file="lolirine_pool_website/static/description/icon.png"/>
        <field name="social_facebook">https://facebook.com/lolirine</field>
        <field name="social_instagram">https://instagram.com/lolirine</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="homepage_url">/</field>
    </record>
    
    <!-- Configuration e-commerce pour le site Pool -->
    <record id="website_pool_config" model="website">
        <field name="id" ref="website_pool"/>
        <field name="shop_ppg">20</field>
        <field name="shop_ppr">4</field>
    </record>
    
</odoo>
