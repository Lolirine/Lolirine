<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== LIEU DEPART VIEWS ==================== -->

    <record id="km_lieu_depart_view_form" model="ir.ui.view">
        <field name="name">km.lieu.depart.form</field>
        <field name="model">km.lieu.depart</field>
        <field name="arch" type="xml">
            <form string="Lieu de Départ">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="is_default"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="adresse"/>
                            <field name="code_postal"/>
                            <field name="ville"/>
                            <field name="pays_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="adresse_complete" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="km_lieu_depart_view_list" model="ir.ui.view">
        <field name="name">km.lieu.depart.list</field>
        <field name="model">km.lieu.depart</field>
        <field name="arch" type="xml">
            <list string="Lieux de Départ" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="adresse"/>
                <field name="code_postal"/>
                <field name="ville"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="km_lieu_depart_action" model="ir.actions.act_window">
        <field name="name">Lieux de Départ</field>
        <field name="res_model">km.lieu.depart</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez vos lieux de départ
            </p>
            <p>
                Ajoutez vos points de départ habituels (siège social, entrepôt, etc.)
            </p>
        </field>
    </record>

    <!-- ==================== DESTINATION VIEWS ==================== -->

    <record id="km_destination_view_form" model="ir.ui.view">
        <field name="name">km.destination.form</field>
        <field name="model">km.destination</field>
        <field name="arch" type="xml">
            <form string="Destination">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du fournisseur/client"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="type_destination" widget="radio"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Adresse">
                            <field name="adresse"/>
                            <field name="code_postal"/>
                            <field name="ville"/>
                            <field name="pays_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="adresse_complete" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Distances" name="distances">
                            <field name="distance_ids">
                                <list editable="bottom">
                                    <field name="lieu_depart_id"/>
                                    <field name="distance_km"/>
                                    <field name="distance_aller_retour"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="km_destination_view_list" model="ir.ui.view">
        <field name="name">km.destination.list</field>
        <field name="model">km.destination</field>
        <field name="arch" type="xml">
            <list string="Destinations">
                <field name="name"/>
                <field name="type_destination" widget="badge"
                       decoration-info="type_destination == 'fournisseur'"
                       decoration-success="type_destination == 'client'"
                       decoration-warning="type_destination == 'administratif'"/>
                <field name="adresse"/>
                <field name="code_postal"/>
                <field name="ville"/>
                <field name="partner_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="km_destination_view_search" model="ir.ui.view">
        <field name="name">km.destination.search</field>
        <field name="model">km.destination</field>
        <field name="arch" type="xml">
            <search string="Rechercher Destinations">
                <field name="name"/>
                <field name="adresse"/>
                <field name="ville"/>
                <separator/>
                <filter name="fournisseurs" string="Fournisseurs"
                        domain="[('type_destination', '=', 'fournisseur')]"/>
                <filter name="clients" string="Clients"
                        domain="[('type_destination', '=', 'client')]"/>
                <filter name="administratif" string="Administratif"
                        domain="[('type_destination', '=', 'administratif')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'type_destination'}"/>
                    <filter name="group_ville" string="Ville" context="{'group_by': 'ville'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="km_destination_action" model="ir.actions.act_window">
        <field name="name">Destinations Favorites</field>
        <field name="res_model">km.destination</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_fournisseurs': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajoutez vos destinations favorites
            </p>
            <p>
                Enregistrez vos fournisseurs, clients et autres destinations fréquentes
                avec leurs distances prédéfinies pour gagner du temps.
            </p>
        </field>
    </record>

    <!-- ==================== MENUS ==================== -->

    <menuitem id="km_expense_menu_lieux_depart"
              name="Lieux de Départ"
              parent="km_expense_menu_configuration"
              action="km_lieu_depart_action"
              sequence="5"/>

    <menuitem id="km_expense_menu_destinations"
              name="Destinations Favorites"
              parent="km_expense_menu_configuration"
              action="km_destination_action"
              sequence="6"/>

</odoo>
