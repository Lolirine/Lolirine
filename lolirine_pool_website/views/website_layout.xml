<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- CLASSE CONDITIONNELLE POUR LE SITE POOL     -->
    <!-- ============================================ -->
    
    <!-- 
        Ajoute la classe 'o_website_pool' via JavaScript
        uniquement sur le site Pool Store.
        Le script s'exécute immédiatement pour éviter le flash.
    -->
    <template id="pool_website_body_class" inherit_id="website.layout" name="Pool Website Body Class">
        <xpath expr="//head" position="inside">
            <t t-if="website and 'Pool' in (website.name or '')">
                <script>
                    (function() {
                        document.documentElement.classList.add('o_website_pool');
                        if (document.body) document.body.classList.add('o_website_pool');
                    })();
                </script>
            </t>
        </xpath>
    </template>
    
</odoo>
