<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Création du site web Lolirine Pool Store -->
    <record id="website_pool" model="website">
        <field name="name">Lolirine Pool Store</field>
        <field name="domain">www.lolirinepoolstore.be</field>
        <field name="is_pool_website">True</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="homepage_url">/</field>
        <field name="shop_ppg">20</field>
        <field name="shop_ppr">4</field>
    </record>
    
</odoo>
