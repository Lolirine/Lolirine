<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire des pénalités -->
    <record id="partner_penalty_view_form" model="ir.ui.view">
        <field name="name">partner.penalty.form</field>
        <field name="model">partner.penalty</field>
        <field name="arch" type="xml">
            <form string="Pénalité">
                <header>
                    <button name="action_confirm" type="object" string="Confirmer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object" string="Créer facture"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Remettre en brouillon"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,invoiced,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="penalty_type_id"/>
                            <field name="category" readonly="1"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="invoice_id" readonly="1" 
                                   invisible="not invoice_id"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" 
                               placeholder="Motif détaillé de la pénalité..."/>
                    </group>
                    <group string="Notes internes">
                        <field name="notes" nolabel="1"
                               placeholder="Notes internes (non visibles par le client)..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue liste des pénalités -->
    <record id="partner_penalty_view_list" model="ir.ui.view">
        <field name="name">partner.penalty.list</field>
        <field name="model">partner.penalty</field>
        <field name="arch" type="xml">
            <list string="Pénalités" 
                  decoration-danger="state in ('draft', 'confirmed')"
                  decoration-success="state == 'paid'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="penalty_type_id"/>
                <field name="category"/>
                <field name="product_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'invoiced'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="invoice_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Vue recherche des pénalités -->
    <record id="partner_penalty_view_search" model="ir.ui.view">
        <field name="name">partner.penalty.search</field>
        <field name="model">partner.penalty</field>
        <field name="arch" type="xml">
            <search string="Rechercher pénalités">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="penalty_type_id"/>
                <separator/>
                <filter string="Brouillon" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmées" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Facturées" name="invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter string="Payées" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Annulées" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="À traiter" name="to_process" 
                        domain="[('state', 'in', ('draft', 'confirmed'))]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'penalty_type_id'}"/>
                    <filter string="Catégorie" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Mois" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue formulaire des types de pénalités -->
    <record id="penalty_type_view_form" model="ir.ui.view">
        <field name="name">partner.penalty.type.form</field>
        <field name="model">partner.penalty.type</field>
        <field name="arch" type="xml">
            <form string="Type de pénalité">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="default_amount"/>
                            <field name="is_percentage"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste des types de pénalités -->
    <record id="penalty_type_view_list" model="ir.ui.view">
        <field name="name">partner.penalty.type.list</field>
        <field name="model">partner.penalty.type</field>
        <field name="arch" type="xml">
            <list string="Types de pénalités">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="default_amount"/>
                <field name="is_percentage"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_partner_penalties" model="ir.actions.act_window">
        <field name="name">Pénalités clients</field>
        <field name="res_model">partner.penalty</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_process': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune pénalité enregistrée
            </p>
            <p>
                Ajoutez des pénalités depuis la fiche client ou créez-en une nouvelle ici.
            </p>
        </field>
    </record>

    <record id="action_penalty_types" model="ir.actions.act_window">
        <field name="name">Types de pénalités</field>
        <field name="res_model">partner.penalty.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
