<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default system parameters -->
        <record id="config_ai_chat_enabled" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.enabled</field>
            <field name="value">True</field>
        </record>
        <record id="config_ai_chat_web_search" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.web_search</field>
            <field name="value">True</field>
        </record>
        <record id="config_ai_chat_product_search" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.product_search</field>
            <field name="value">True</field>
        </record>
        <record id="config_ai_chat_save_conversations" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.save_conversations</field>
            <field name="value">True</field>
        </record>
        <record id="config_ai_chat_model" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.model</field>
            <field name="value">claude-sonnet-4-20250514</field>
        </record>
        <record id="config_ai_chat_max_tokens" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.max_tokens</field>
            <field name="value">1024</field>
        </record>
        <record id="config_ai_chat_primary_color" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.primary_color</field>
            <field name="value">#0369a1</field>
        </record>
        <record id="config_ai_chat_secondary_color" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.secondary_color</field>
            <field name="value">#0d9488</field>
        </record>
        <record id="config_ai_chat_position" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.position</field>
            <field name="value">bottom-right</field>
        </record>
        <record id="config_ai_chat_max_messages_per_session" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.max_messages_per_session</field>
            <field name="value">50</field>
        </record>
        <record id="config_ai_chat_max_messages_per_day_ip" model="ir.config_parameter">
            <field name="key">lolirine_ai_chat.max_messages_per_day_ip</field>
            <field name="value">100</field>
        </record>
    </data>
</odoo>
