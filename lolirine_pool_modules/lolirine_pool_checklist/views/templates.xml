<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_checklist" name="Pool Checklist — Fiche de visite">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="False"/>
            <t t-set="no_footer" t-value="False"/>

            <t t-set="head">
                <style>
                    #wrapwrap > header,
                    #wrapwrap > footer,
                    .o_footer_copyright { display: none !important; }
                    #wrapwrap { background: #f0f4f8 !important; }
                    #wrap { padding: 0 !important; min-height: 100vh; }
                </style>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js" crossorigin="anonymous"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js" crossorigin="anonymous"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.2/babel.min.js" crossorigin="anonymous"/>
                <link rel="stylesheet" href="/lolirine_pool_checklist/static/src/css/pool_checklist.css"/>
            </t>

            <!-- Conteneur React -->
            <div id="pool-checklist-root"/>

            <!-- Configuration injectée par Odoo (same-origin, pas de problème XML) -->
            <script type="text/javascript">
                window.LOLIRINE_CHECKLIST_CONFIG = {
                    productsEndpoint: '/pool-checklist/products',
                    pingEndpoint:     '/pool-checklist/ping',
                    websiteId:        <t t-out="website_id"/>,
                    csrfToken:        '<t t-out="request.csrf_token()"/>',
                    userName:         '<t t-out="request.env.user.name | e"/>',
                };
            </script>

            <!-- Application React : fichier JS externe, aucun escaping XML -->
            <script type="text/babel"
                    src="/lolirine_pool_checklist/static/src/js/pool_checklist.js"
                    data-presets="react"/>
        </t>
    </template>

</odoo>
