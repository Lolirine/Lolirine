<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Biztax Attachment Form View -->
    <record id="view_biztax_attachment_form" model="ir.ui.view">
        <field name="name">biztax.attachment.form</field>
        <field name="model">biztax.attachment</field>
        <field name="arch" type="xml">
            <form string="Annexe Biztax">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Description de l'annexe"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Type d'annexe">
                            <field name="annex_type"/>
                            <field name="is_mandatory" readonly="1"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Fichier PDF">
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name"/>
                            <field name="file_size" readonly="1"/>
                        </group>
                    </group>
                    <group string="Informations">
                        <field name="declaration_id" readonly="1"/>
                        <field name="generated_from_odoo" readonly="1"/>
                        <field name="source_report" readonly="1" invisible="not generated_from_odoo"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Biztax Attachment List View -->
    <record id="view_biztax_attachment_list" model="ir.ui.view">
        <field name="name">biztax.attachment.list</field>
        <field name="model">biztax.attachment</field>
        <field name="arch" type="xml">
            <list string="Annexes Biztax" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="annex_type"/>
                <field name="is_mandatory" readonly="1"/>
                <field name="file_data" filename="file_name"/>
                <field name="file_name" column_invisible="1"/>
                <field name="file_size" readonly="1"/>
                <field name="generated_from_odoo" readonly="1"/>
                <field name="declaration_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Biztax Attachment Search View -->
    <record id="view_biztax_attachment_search" model="ir.ui.view">
        <field name="name">biztax.attachment.search</field>
        <field name="model">biztax.attachment</field>
        <field name="arch" type="xml">
            <search string="Recherche annexes">
                <field name="name"/>
                <field name="annex_type"/>
                <field name="declaration_id"/>
                <separator/>
                <filter name="mandatory" string="Obligatoires" domain="[('is_mandatory', '=', True)]"/>
                <filter name="generated" string="Générées Odoo" domain="[('generated_from_odoo', '=', True)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'annex_type'}"/>
                    <filter name="group_declaration" string="Déclaration" context="{'group_by': 'declaration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Biztax Attachment Action -->
    <record id="action_biztax_attachment" model="ir.actions.act_window">
        <field name="name">Annexes Biztax</field>
        <field name="res_model">biztax.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune annexe
            </p>
            <p>
                Ajoutez des annexes PDF à vos déclarations Biztax.
            </p>
        </field>
    </record>
</odoo>
