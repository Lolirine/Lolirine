<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <!-- ============================================ -->
    <!-- LAYOUT POOL STORE (en-tête/pied de page)    -->
    <!-- ============================================ -->

    <template id="pool_document_layout">
        <div class="pool-document" style="font-family: 'Helvetica Neue', Arial, sans-serif; color: #333;">
            <!-- EN-TÊTE -->
            <div style="border-bottom: 3px solid #0078D4; padding-bottom: 15px; margin-bottom: 25px;">
                <div class="row">
                    <div class="col-4">
                        <img src="/lolirine_pool_dropship/static/img/pool_store_logo.png"
                             style="max-height: 90px; max-width: 220px;" alt="Lolirine Pool Store"/>
                    </div>
                    <div class="col-4 text-center" style="padding-top: 20px;">
                        <span style="color: #0078D4; font-style: italic; font-size: 12px;">
                            Votre spécialiste piscine &amp; wellness en Belgique
                        </span>
                    </div>
                    <div class="col-4 text-end" style="font-size: 11px; color: #666; padding-top: 5px;">
                        <strong>Lolirine SPRL</strong><br/>
                        Rue Bois d'Esneux 110<br/>
                        Rue de la Drève Boninas 2<br/>
                        5021 Namur - Belgique<br/>
                        BCE: <t t-esc="doc.company_id.vat or 'BE0650.891.279'"/>
                    </div>
                </div>
            </div>

            <!-- CONTENU -->
            <t t-raw="0"/>

            <!-- PIED DE PAGE -->
            <div style="border-top: 2px solid #0078D4; margin-top: 30px; padding-top: 10px; font-size: 10px; color: #888;">
                <div class="row">
                    <div class="col-4">
                        <strong>Lolirine SPRL</strong><br/>
                        Rue Bois d'Esneux 110<br/>
                        5021 Boninne (Namur)
                    </div>
                    <div class="col-4 text-center">
                        +32 (0)497 44 41 46<br/>
                        info@lolirinepoolstore.be<br/>
                        www.lolirinepoolstore.be
                    </div>
                    <div class="col-4 text-end">
                        BCE: <t t-esc="doc.company_id.vat or 'BE0650.891.279'"/><br/>
                        IBAN: <t t-esc="doc.company_id.partner_id.bank_ids[:1].acc_number or ''"/>
                    </div>
                </div>
            </div>
        </div>
    </template>


    <!-- ============================================ -->
    <!-- DEVIS PISCINE                               -->
    <!-- ============================================ -->

    <template id="report_pool_devis_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article o_report_layout_standard"
                     t-att-data-oe-model="doc and doc._name"
                     t-att-data-oe-id="doc and doc.id">
                    <t t-call="lolirine_pool_dropship.pool_document_layout">

                        <!-- TITRE -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h1 style="color: #0078D4; font-size: 28px; margin: 0;">
                                    Devis Piscine
                                </h1>
                                <h2 style="color: #0078D4; font-size: 24px; margin: 5px 0 0 0; font-weight: bold;">
                                    <t t-if="doc.dropship_ref" t-esc="doc.dropship_ref"/>
                                    <t t-else="" t-esc="doc.name"/>
                                </h2>
                            </div>
                            <div class="col-4 text-end" style="padding-top: 10px;">
                                <span style="background: #e3f2fd; color: #0078D4; padding: 8px 18px; border-radius: 20px; font-weight: bold; font-size: 14px;">
                                    DEVIS
                                </span>
                            </div>
                        </div>

                        <!-- COORDONNÉES -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div style="background: #f8f9fa; padding: 15px; border-radius: 6px; border-left: 4px solid #0078D4;">
                                    <strong style="color: #0078D4; font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">Client</strong><br/>
                                    <strong t-field="doc.partner_id.name" style="font-size: 15px;"/><br/>
                                    <span t-field="doc.partner_id.street"/><br/>
                                    <t t-if="doc.partner_id.street2">
                                        <span t-field="doc.partner_id.street2"/><br/>
                                    </t>
                                    <span t-field="doc.partner_id.zip"/> <span t-field="doc.partner_id.city"/><br/>
                                    <span t-field="doc.partner_id.country_id.name"/><br/>
                                    <t t-if="doc.partner_id.vat">
                                        <span style="color: #666;">TVA: <span t-field="doc.partner_id.vat"/></span><br/>
                                    </t>
                                    <t t-if="doc.partner_id.phone">
                                        <span style="color: #666;">Tél: <span t-field="doc.partner_id.phone"/></span>
                                    </t>
                                </div>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm" style="font-size: 13px;">
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>Référence :</strong></td>
                                        <td style="border: none; padding: 4px 8px; color: #0078D4; font-weight: bold;">
                                            <t t-if="doc.dropship_ref" t-esc="doc.dropship_ref"/>
                                            <t t-else="" t-esc="doc.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>Date du devis :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </tr>
                                    <tr t-if="doc.validity_date">
                                        <td style="border: none; padding: 4px 8px;"><strong>Valide jusqu'au :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.validity_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </tr>
                                    <tr t-if="doc.client_order_ref">
                                        <td style="border: none; padding: 4px 8px;"><strong>Votre réf. :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.client_order_ref"/>
                                    </tr>
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>Vendeur :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.user_id.name"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ADRESSE LIVRAISON si différente -->
                        <t t-if="doc.partner_shipping_id.id != doc.partner_id.id">
                            <div class="row mb-3">
                                <div class="col-6">
                                    <div style="background: #fff3cd; padding: 12px; border-radius: 6px; border-left: 4px solid #ffc107;">
                                        <strong style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">Adresse de livraison</strong><br/>
                                        <strong t-field="doc.partner_shipping_id.name"/><br/>
                                        <span t-field="doc.partner_shipping_id.street"/><br/>
                                        <t t-if="doc.partner_shipping_id.street2">
                                            <span t-field="doc.partner_shipping_id.street2"/><br/>
                                        </t>
                                        <span t-field="doc.partner_shipping_id.zip"/> <span t-field="doc.partner_shipping_id.city"/><br/>
                                        <span t-field="doc.partner_shipping_id.country_id.name"/>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- TABLEAU PRODUITS -->
                        <table class="table table-sm" style="font-size: 13px; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #0078D4; color: white;">
                                    <th style="padding: 10px 12px; border: none;">Description</th>
                                    <th class="text-center" style="padding: 10px; border: none; width: 80px;">Qté</th>
                                    <th class="text-end" style="padding: 10px; border: none; width: 110px;">Prix unit. HTVA</th>
                                    <th class="text-center" style="padding: 10px; border: none; width: 70px;">TVA</th>
                                    <th class="text-end" style="padding: 10px; border: none; width: 120px;">Montant HTVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-if="not line.display_type">
                                        <tr style="border-bottom: 1px solid #dee2e6;">
                                            <td style="padding: 8px 12px;">
                                                <strong t-field="line.product_id.name"/>
                                                <t t-if="line.name and line.name != line.product_id.display_name">
                                                    <br/><small style="color: #666;" t-field="line.name"/>
                                                </t>
                                            </td>
                                            <td class="text-center" style="padding: 8px;">
                                                <span t-field="line.product_uom_qty"/>
                                                <span t-field="line.product_uom" groups="uom.group_uom"/>
                                            </td>
                                            <td class="text-end" style="padding: 8px;" t-field="line.price_unit"/>
                                            <td class="text-center" style="padding: 8px; font-size: 11px;">
                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"/>
                                            </td>
                                            <td class="text-end" style="padding: 8px;">
                                                <strong t-field="line.price_subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_section'">
                                        <tr>
                                            <td colspan="5" style="padding: 10px 12px; background: #e9ecef; font-weight: bold;">
                                                <span t-field="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr>
                                            <td colspan="5" style="padding: 6px 12px; font-style: italic; color: #666;">
                                                <span t-field="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTAUX -->
                        <div class="row">
                            <div class="col-7"/>
                            <div class="col-5">
                                <table class="table table-sm" style="font-size: 13px;">
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>Sous-total HTVA</strong></td>
                                        <td class="text-end" style="border: none; padding: 4px 8px;" t-field="doc.amount_untaxed"/>
                                    </tr>
                                    <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                    <t t-foreach="doc.amount_by_group" t-as="amount_by_group">
                                        <tr>
                                            <td style="border: none; padding: 4px 8px;"><span t-esc="amount_by_group[0]"/></td>
                                            <td class="text-end" style="border: none; padding: 4px 8px;" t-esc="amount_by_group[1]" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </tr>
                                    </t>
                                    <tr style="border-top: 3px solid #0078D4;">
                                        <td style="border: none; padding: 8px;"><strong style="font-size: 18px; color: #0078D4;">Total TTC</strong></td>
                                        <td class="text-end" style="border: none; padding: 8px;"><strong style="font-size: 18px; color: #0078D4;" t-field="doc.amount_total"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- NOTE -->
                        <t t-if="doc.note">
                            <div style="margin-top: 15px; padding: 12px; background: #f8f9fa; border-radius: 6px;">
                                <strong>Notes :</strong><br/>
                                <span t-field="doc.note"/>
                            </div>
                        </t>

                        <!-- BLOC CONFIRMATION -->
                        <div style="margin-top: 25px; padding: 18px; background: #e8f4fd; border-radius: 8px; border: 1px solid #b8daff;">
                            <strong style="color: #0078D4; font-size: 14px;">Pour confirmer ce devis :</strong><br/>
                            <p style="margin: 8px 0 0 0;">
                                Renvoyez-nous ce devis signé par email à <strong>info@lolirinepoolstore.be</strong>
                                ou confirmez par téléphone au <strong>+32 (0)497 44 41 46</strong>.<br/>
                                Nous lancerons immédiatement la commande auprès de notre partenaire logistique.
                            </p>
                        </div>

                        <!-- SIGNATURE -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <p><strong>Lolirine Pool Store</strong></p>
                            </div>
                            <div class="col-6">
                                <p><strong>Bon pour accord :</strong></p>
                                <p style="margin-top: 40px; border-top: 1px solid #999; padding-top: 5px;">
                                    Date et signature du client
                                </p>
                            </div>
                        </div>

                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_pool_devis" model="ir.actions.report">
        <field name="name">Devis Piscine</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_pool_dropship.report_pool_devis_document</field>
        <field name="report_file">lolirine_pool_dropship.report_pool_devis_document</field>
        <field name="print_report_name">'Devis_Piscine_%s' % ((object.dropship_ref or object.name) or '').replace('/','_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>


    <!-- ============================================ -->
    <!-- CONFIRMATION DE COMMANDE PISCINE            -->
    <!-- ============================================ -->

    <template id="report_pool_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article o_report_layout_standard"
                     t-att-data-oe-model="doc and doc._name"
                     t-att-data-oe-id="doc and doc.id">
                    <t t-call="lolirine_pool_dropship.pool_document_layout">

                        <!-- TITRE -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h1 style="color: #0078D4; font-size: 28px; margin: 0;">
                                    Confirmation de commande
                                </h1>
                                <h2 style="color: #0078D4; font-size: 24px; margin: 5px 0 0 0; font-weight: bold;">
                                    <t t-if="doc.dropship_ref" t-esc="doc.dropship_ref"/>
                                    <t t-else="" t-esc="doc.name"/>
                                </h2>
                            </div>
                            <div class="col-4 text-end" style="padding-top: 10px;">
                                <span style="background: #d4edda; color: #155724; padding: 8px 18px; border-radius: 20px; font-weight: bold; font-size: 14px;">
                                    CONFIRMÉE
                                </span>
                            </div>
                        </div>

                        <!-- COORDONNÉES -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div style="background: #f8f9fa; padding: 15px; border-radius: 6px; border-left: 4px solid #0078D4;">
                                    <strong style="color: #0078D4; font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">Client</strong><br/>
                                    <strong t-field="doc.partner_id.name" style="font-size: 15px;"/><br/>
                                    <span t-field="doc.partner_id.street"/><br/>
                                    <t t-if="doc.partner_id.street2">
                                        <span t-field="doc.partner_id.street2"/><br/>
                                    </t>
                                    <span t-field="doc.partner_id.zip"/> <span t-field="doc.partner_id.city"/><br/>
                                    <span t-field="doc.partner_id.country_id.name"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm" style="font-size: 13px;">
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>Référence :</strong></td>
                                        <td style="border: none; padding: 4px 8px; color: #0078D4; font-weight: bold;">
                                            <t t-if="doc.dropship_ref" t-esc="doc.dropship_ref"/>
                                            <t t-else="" t-esc="doc.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>Date commande :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.date_order" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </tr>
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>N° interne :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.name"/>
                                    </tr>
                                    <tr t-if="doc.client_order_ref">
                                        <td style="border: none; padding: 4px 8px;"><strong>Votre réf. :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.client_order_ref"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ADRESSE LIVRAISON -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <div style="background: #e8f5e9; padding: 12px; border-radius: 6px; border-left: 4px solid #28a745;">
                                    <strong style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #28a745;">Livraison</strong><br/>
                                    <strong t-field="doc.partner_shipping_id.name"/><br/>
                                    <span t-field="doc.partner_shipping_id.street"/><br/>
                                    <t t-if="doc.partner_shipping_id.street2">
                                        <span t-field="doc.partner_shipping_id.street2"/><br/>
                                    </t>
                                    <span t-field="doc.partner_shipping_id.zip"/> <span t-field="doc.partner_shipping_id.city"/><br/>
                                    <span t-field="doc.partner_shipping_id.country_id.name"/>
                                    <t t-if="doc.partner_shipping_id.phone">
                                        <br/>Tél: <span t-field="doc.partner_shipping_id.phone"/>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- TABLEAU PRODUITS -->
                        <table class="table table-sm" style="font-size: 13px; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #0078D4; color: white;">
                                    <th style="padding: 10px 12px; border: none;">Description</th>
                                    <th class="text-center" style="padding: 10px; border: none; width: 80px;">Qté</th>
                                    <th class="text-end" style="padding: 10px; border: none; width: 110px;">Prix unit. HTVA</th>
                                    <th class="text-center" style="padding: 10px; border: none; width: 70px;">TVA</th>
                                    <th class="text-end" style="padding: 10px; border: none; width: 120px;">Montant HTVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-if="not line.display_type">
                                        <tr style="border-bottom: 1px solid #dee2e6;">
                                            <td style="padding: 8px 12px;"><strong t-field="line.product_id.name"/></td>
                                            <td class="text-center" style="padding: 8px;" t-field="line.product_uom_qty"/>
                                            <td class="text-end" style="padding: 8px;" t-field="line.price_unit"/>
                                            <td class="text-center" style="padding: 8px; font-size: 11px;">
                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"/>
                                            </td>
                                            <td class="text-end" style="padding: 8px;"><strong t-field="line.price_subtotal"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTAUX -->
                        <div class="row">
                            <div class="col-7"/>
                            <div class="col-5">
                                <table class="table table-sm" style="font-size: 13px;">
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>Sous-total HTVA</strong></td>
                                        <td class="text-end" style="border: none; padding: 4px 8px;" t-field="doc.amount_untaxed"/>
                                    </tr>
                                    <t t-foreach="doc.amount_by_group" t-as="amount_by_group">
                                        <tr>
                                            <td style="border: none; padding: 4px 8px;"><span t-esc="amount_by_group[0]"/></td>
                                            <td class="text-end" style="border: none; padding: 4px 8px;" t-esc="amount_by_group[1]" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </tr>
                                    </t>
                                    <tr style="border-top: 3px solid #0078D4;">
                                        <td style="border: none; padding: 8px;"><strong style="font-size: 18px; color: #0078D4;">Total TTC</strong></td>
                                        <td class="text-end" style="border: none; padding: 8px;"><strong style="font-size: 18px; color: #0078D4;" t-field="doc.amount_total"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- PROCHAINES ÉTAPES -->
                        <div style="margin-top: 25px; padding: 18px; background: #e8f4fd; border-radius: 8px; border: 1px solid #b8daff;">
                            <strong style="color: #0078D4; font-size: 14px;">Prochaines étapes :</strong>
                            <ol style="margin: 10px 0 0 0; line-height: 1.8;">
                                <li>Votre commande est confirmée et en cours de traitement</li>
                                <li>Préparation et expédition par notre partenaire logistique</li>
                                <li>Vous recevrez un email avec le suivi dès l'expédition</li>
                                <li>Livraison à votre adresse</li>
                            </ol>
                        </div>

                        <t t-if="doc.note">
                            <div style="margin-top: 15px; padding: 12px; background: #f8f9fa; border-radius: 6px;">
                                <strong>Notes :</strong><br/>
                                <span t-field="doc.note"/>
                            </div>
                        </t>

                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_pool_order" model="ir.actions.report">
        <field name="name">Bon de commande Piscine</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_pool_dropship.report_pool_order_document</field>
        <field name="report_file">lolirine_pool_dropship.report_pool_order_document</field>
        <field name="print_report_name">'Commande_Piscine_%s' % ((object.dropship_ref or object.name) or '').replace('/','_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>


    <!-- ============================================ -->
    <!-- FACTURE PISCINE                             -->
    <!-- ============================================ -->

    <template id="report_pool_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article o_report_layout_standard"
                     t-att-data-oe-model="doc and doc._name"
                     t-att-data-oe-id="doc and doc.id">

                    <div class="pool-document" style="font-family: 'Helvetica Neue', Arial, sans-serif; color: #333;">
                        <!-- EN-TÊTE FACTURE -->
                        <div style="border-bottom: 3px solid #0078D4; padding-bottom: 15px; margin-bottom: 25px;">
                            <div class="row">
                                <div class="col-4">
                                    <img src="/lolirine_pool_dropship/static/img/pool_store_logo.png"
                                         style="max-height: 90px; max-width: 220px;" alt="Lolirine Pool Store"/>
                                </div>
                                <div class="col-4 text-center" style="padding-top: 20px;">
                                    <span style="color: #0078D4; font-style: italic; font-size: 12px;">
                                        Votre spécialiste piscine &amp; wellness en Belgique
                                    </span>
                                </div>
                                <div class="col-4 text-end" style="font-size: 11px; color: #666; padding-top: 5px;">
                                    <strong>Lolirine SPRL</strong><br/>
                                    Rue Bois d'Esneux 110<br/>
                                    5021 Namur - Belgique<br/>
                                    BCE: <t t-esc="doc.company_id.vat or 'BE0650.891.279'"/>
                                </div>
                            </div>
                        </div>

                        <!-- TITRE -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h1 style="color: #0078D4; font-size: 28px; margin: 0;">
                                    <t t-if="doc.move_type == 'out_invoice'">Facture</t>
                                    <t t-elif="doc.move_type == 'out_refund'">Note de crédit</t>
                                    <t t-else="">Document</t>
                                </h1>
                                <h2 style="color: #0078D4; font-size: 24px; margin: 5px 0 0 0; font-weight: bold;" t-field="doc.name"/>
                            </div>
                            <div class="col-4 text-end" style="padding-top: 10px;">
                                <span style="background: #0078D4; color: white; padding: 8px 18px; border-radius: 20px; font-weight: bold; font-size: 14px;">
                                    PISCINE &amp; WELLNESS
                                </span>
                            </div>
                        </div>

                        <!-- COORDONNÉES -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div style="background: #f8f9fa; padding: 15px; border-radius: 6px; border-left: 4px solid #0078D4;">
                                    <strong style="color: #0078D4; font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">Facturer à</strong><br/>
                                    <strong t-field="doc.partner_id.name" style="font-size: 15px;"/><br/>
                                    <span t-field="doc.partner_id.street"/><br/>
                                    <t t-if="doc.partner_id.street2">
                                        <span t-field="doc.partner_id.street2"/><br/>
                                    </t>
                                    <span t-field="doc.partner_id.zip"/> <span t-field="doc.partner_id.city"/><br/>
                                    <span t-field="doc.partner_id.country_id.name"/><br/>
                                    <t t-if="doc.partner_id.vat">
                                        <span style="color: #666;">TVA: <span t-field="doc.partner_id.vat"/></span>
                                    </t>
                                </div>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm" style="font-size: 13px;">
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>N° facture :</strong></td>
                                        <td style="border: none; padding: 4px 8px; color: #0078D4; font-weight: bold;" t-field="doc.name"/>
                                    </tr>
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>Date facture :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.invoice_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </tr>
                                    <tr t-if="doc.invoice_date_due">
                                        <td style="border: none; padding: 4px 8px;"><strong>Échéance :</strong></td>
                                        <td style="border: none; padding: 4px 8px; font-weight: bold; color: #dc3545;" t-field="doc.invoice_date_due" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </tr>
                                    <tr t-if="doc.ref">
                                        <td style="border: none; padding: 4px 8px;"><strong>Référence :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.ref"/>
                                    </tr>
                                    <tr t-if="doc.invoice_origin">
                                        <td style="border: none; padding: 4px 8px;"><strong>Commande :</strong></td>
                                        <td style="border: none; padding: 4px 8px;" t-field="doc.invoice_origin"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- TABLEAU LIGNES -->
                        <table class="table table-sm" style="font-size: 13px; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #0078D4; color: white;">
                                    <th style="padding: 10px 12px; border: none;">Description</th>
                                    <th class="text-center" style="padding: 10px; border: none; width: 80px;">Qté</th>
                                    <th class="text-end" style="padding: 10px; border: none; width: 110px;">Prix unit. HTVA</th>
                                    <th class="text-center" style="padding: 10px; border: none; width: 70px;">TVA</th>
                                    <th class="text-end" style="padding: 10px; border: none; width: 120px;">Montant HTVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <t t-if="not line.display_type">
                                        <tr style="border-bottom: 1px solid #dee2e6;">
                                            <td style="padding: 8px 12px;"><strong t-field="line.name"/></td>
                                            <td class="text-center" style="padding: 8px;" t-field="line.quantity"/>
                                            <td class="text-end" style="padding: 8px;" t-field="line.price_unit"/>
                                            <td class="text-center" style="padding: 8px; font-size: 11px;">
                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"/>
                                            </td>
                                            <td class="text-end" style="padding: 8px;"><strong t-field="line.price_subtotal"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTAUX -->
                        <div class="row">
                            <div class="col-7"/>
                            <div class="col-5">
                                <table class="table table-sm" style="font-size: 13px;">
                                    <tr>
                                        <td style="border: none; padding: 4px 8px;"><strong>Sous-total HTVA</strong></td>
                                        <td class="text-end" style="border: none; padding: 4px 8px;" t-field="doc.amount_untaxed"/>
                                    </tr>
                                    <t t-foreach="doc.amount_by_group" t-as="amount_by_group">
                                        <tr>
                                            <td style="border: none; padding: 4px 8px;"><span t-esc="amount_by_group[0]"/></td>
                                            <td class="text-end" style="border: none; padding: 4px 8px;" t-esc="amount_by_group[1]" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </tr>
                                    </t>
                                    <tr style="border-top: 3px solid #0078D4;">
                                        <td style="border: none; padding: 8px;"><strong style="font-size: 18px; color: #0078D4;">Total TTC</strong></td>
                                        <td class="text-end" style="border: none; padding: 8px;"><strong style="font-size: 18px; color: #0078D4;" t-field="doc.amount_total"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- PAIEMENT -->
                        <div style="margin-top: 20px; padding: 18px; background: #e8f4fd; border-radius: 8px; border: 1px solid #b8daff;">
                            <strong style="color: #0078D4; font-size: 14px;">Informations de paiement :</strong><br/>
                            <table style="margin-top: 8px; font-size: 13px;">
                                <tr t-if="doc.partner_bank_id">
                                    <td style="padding: 3px 15px 3px 0;"><strong>IBAN :</strong></td>
                                    <td t-esc="doc.partner_bank_id.acc_number"/>
                                </tr>
                                <tr t-if="doc.payment_reference">
                                    <td style="padding: 3px 15px 3px 0;"><strong>Communication :</strong></td>
                                    <td><strong t-esc="doc.payment_reference"/></td>
                                </tr>
                                <tr t-if="doc.invoice_date_due">
                                    <td style="padding: 3px 15px 3px 0;"><strong>Échéance :</strong></td>
                                    <td t-field="doc.invoice_date_due" t-options='{"format": "dd/MM/yyyy"}'/>
                                </tr>
                            </table>
                        </div>

                        <!-- PIED DE PAGE -->
                        <div style="border-top: 2px solid #0078D4; margin-top: 30px; padding-top: 10px; font-size: 10px; color: #888;">
                            <div class="row">
                                <div class="col-4">
                                    <strong>Lolirine SPRL</strong><br/>
                                    Rue Bois d'Esneux 110<br/>
                                    5021 Boninne (Namur)
                                </div>
                                <div class="col-4 text-center">
                                    +32 (0)497 44 41 46<br/>
                                    info@lolirinepoolstore.be<br/>
                                    www.lolirinepoolstore.be
                                </div>
                                <div class="col-4 text-end">
                                    BCE: <t t-esc="doc.company_id.vat or 'BE0650.891.279'"/><br/>
                                    IBAN: <t t-esc="doc.company_id.partner_id.bank_ids[:1].acc_number or ''"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_pool_invoice" model="ir.actions.report">
        <field name="name">Facture Piscine</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_pool_dropship.report_pool_invoice_document</field>
        <field name="report_file">lolirine_pool_dropship.report_pool_invoice_document</field>
        <field name="print_report_name">'Facture_Piscine_%s' % (object.name or '').replace('/','_')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>


    <!-- ============================================ -->
    <!-- BC FOURNISSEUR DROPSHIPPING                 -->
    <!-- ============================================ -->

    <template id="report_dropship_purchase_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article o_report_layout_standard"
                     t-att-data-oe-model="doc and doc._name"
                     t-att-data-oe-id="doc and doc.id">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="row mb-4">
                                <div class="col-8">
                                    <h2>Commande Dropshipping <span t-field="doc.name"/></h2>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge bg-warning text-dark" style="font-size: 1.2em;">DROPSHIP</span>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-6">
                                    <strong>Fournisseur:</strong><br/>
                                    <div t-field="doc.partner_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
                                </div>
                                <div class="col-6">
                                    <table class="table table-sm">
                                        <tr><td><strong>Date:</strong></td><td t-field="doc.date_order" t-options='{"format": "dd/MM/yyyy"}'/></tr>
                                        <tr><td><strong>Réf.:</strong></td><td t-field="doc.name"/></tr>
                                        <tr t-if="doc.dropship_sale_id"><td><strong>Cde client:</strong></td><td t-field="doc.dropship_sale_id.name"/></tr>
                                    </table>
                                </div>
                            </div>

                            <div class="alert alert-warning mb-4" style="border: 2px solid #ffc107;">
                                <h4><i class="fa fa-exclamation-triangle"/> LIVRAISON DIRECTE CLIENT</h4>
                                <p class="mb-0">Expédier directement à l'adresse ci-dessous. <strong>Ne pas livrer à notre adresse.</strong></p>
                            </div>

                            <div class="row mb-4" t-if="doc.dest_address_id">
                                <div class="col-12">
                                    <div style="border: 2px solid #0078D4; padding: 15px; border-radius: 6px;">
                                        <strong style="color: #0078D4;">ADRESSE DE LIVRAISON (CLIENT FINAL)</strong><br/>
                                        <div t-field="doc.dest_address_id"
                                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'
                                             style="font-size: 1.1em;"/>
                                    </div>
                                </div>
                            </div>

                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Référence</th><th>Description</th>
                                        <th class="text-center">Qté</th><th class="text-end">Prix unit.</th><th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.order_line" t-as="line">
                                        <td>
                                            <span t-field="line.product_id.default_code"/>
                                            <t t-if="line.supplier_product_ref"><br/><small class="text-muted">Réf: <t t-esc="line.supplier_product_ref"/></small></t>
                                        </td>
                                        <td t-field="line.name"/>
                                        <td class="text-center" t-field="line.product_qty"/>
                                        <td class="text-end" t-field="line.price_unit"/>
                                        <td class="text-end" t-field="line.price_subtotal"/>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr><td colspan="4" class="text-end"><strong>Total HT</strong></td><td class="text-end"><strong t-field="doc.amount_untaxed"/></td></tr>
                                    <tr><td colspan="4" class="text-end">TVA</td><td class="text-end" t-field="doc.amount_tax"/></tr>
                                    <tr><td colspan="4" class="text-end"><strong>Total TTC</strong></td><td class="text-end"><strong t-field="doc.amount_total"/></td></tr>
                                </tfoot>
                            </table>

                            <div style="border: 1px solid #dee2e6; padding: 15px; border-radius: 6px; margin-top: 20px;">
                                <strong>INSTRUCTIONS :</strong>
                                <ul class="mb-0">
                                    <li><strong>Emballage neutre obligatoire</strong></li>
                                    <li><strong>Ne pas inclure de facture</strong> dans le colis</li>
                                    <li><strong>Communiquer le numéro de suivi</strong> dès expédition</li>
                                </ul>
                                <t t-if="doc.notes"><hr/><span t-field="doc.notes"/></t>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_dropship_purchase_order" model="ir.actions.report">
        <field name="name">BC Dropshipping</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_pool_dropship.report_dropship_purchase_order_document</field>
        <field name="report_file">lolirine_pool_dropship.report_dropship_purchase_order_document</field>
        <field name="print_report_name">'BC_Dropship_%s' % (object.name).replace('/','_')</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

    </data>
</odoo>
