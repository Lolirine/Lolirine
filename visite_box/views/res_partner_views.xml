<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension du formulaire partenaire -->
    <record id="res_partner_view_form_inherit_visite" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.visite</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_visites" type="object" class="oe_stat_button" icon="fa-calendar-check-o"
                        groups="visite_box.group_visite_user">
                    <field name="visite_count" widget="statinfo" string="Visites"/>
                </button>
                <button name="action_view_storage_boxes" type="object" class="oe_stat_button" icon="fa-archive"
                        groups="visite_box.group_visite_user">
                    <field name="storage_box_count" widget="statinfo" string="Box"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Garde-meubles" name="storage" groups="visite_box.group_visite_user">
                    <group>
                        <group>
                            <field name="storage_status"/>
                            <field name="last_visite_date"/>
                            <field name="last_visite_state"/>
                        </group>
                        <group>
                            <button name="action_create_visite" string="Nouvelle visite" type="object" 
                                    class="btn-primary" icon="fa-plus"/>
                        </group>
                    </group>
                    <separator string="Historique des visites"/>
                    <field name="visite_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="date_visite"/>
                            <field name="state" widget="badge"/>
                            <field name="user_id"/>
                            <field name="box_selected_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Filtre de recherche étendu -->
    <record id="res_partner_view_search_inherit_visite" model="ir.ui.view">
        <field name="name">res.partner.view.search.inherit.visite</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <separator/>
                <filter string="Prospects" name="prospects" 
                        domain="[('storage_status', '=', 'prospect')]"/>
                <filter string="Clients stockage" name="storage_clients" 
                        domain="[('storage_status', '=', 'client')]"/>
                <filter string="Anciens clients" name="former_clients" 
                        domain="[('storage_status', '=', 'former')]"/>
            </xpath>
        </field>
    </record>
</odoo>
