<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template principal du contrat -->
    <template id="report_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="lolirine_contract.report_contract_content"/>
            </t>
        </t>
    </template>

    <!-- Contenu du contrat -->
    <template id="report_contract_content">
        <t t-set="company" t-value="doc.company_id or res_company"/>
        
        <div class="page" style="font-family: Arial, sans-serif; font-size: 11pt;">
            
            <!-- ========== EN-TÊTE AVEC LOGO ========== -->
            <div style="text-align: center; margin-bottom: 20px;">
                <img t-if="company.logo" 
                     t-att-src="image_data_uri(company.logo)" 
                     style="max-height: 80px;" 
                     alt="Logo"/>
                <t t-if="not company.logo">
                    <h2 style="color: #c41e3a; font-size: 28pt; margin: 0;">
                        <span style="font-family: 'Times New Roman', serif;">🔒 lolirine</span>
                        <span style="font-size: 10pt; vertical-align: super;">SPRL</span>
                    </h2>
                    <p style="color: #c41e3a; margin: 0; font-style: italic;">Garde-meubles</p>
                </t>
            </div>

            <!-- ========== INTRO ========== -->
            <p style="text-align: center; margin-bottom: 15px;">
                Le présent contrat est conclu sur deux pages entre:
            </p>

            <!-- ========== TABLEAU BAILLEUR / PRENEUR ========== -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                <tr>
                    <td style="width: 45%; border: 1px solid #ccc; padding: 10px; vertical-align: top; background-color: #f9f9f9;">
                        <strong style="color: #c41e3a;">Le Bailleur (Srl Lolirine)</strong>
                    </td>
                    <td style="width: 10%; text-align: center; vertical-align: middle; border: none;">
                        Et,
                    </td>
                    <td style="width: 45%; border: 1px solid #ccc; padding: 10px; vertical-align: top; background-color: #f9f9f9;">
                        <strong style="color: #c41e3a;">Le Preneur (Client)</strong>
                    </td>
                </tr>
                <tr>
                    <td style="border: 1px solid #ccc; padding: 10px; vertical-align: top;">
                        <strong>Srl Lolirine</strong><br/>
                        Rue Bois D'Esneux 110<br/>
                        B - 5021 Boninne<br/><br/>
                        GSM: 0498/52.11.31 - GSM: 0497/44.41.46<br/>
                        Mail: gardemeublelolirine@gmail.com
                    </td>
                    <td style="border: none;"></td>
                    <td style="border: 1px solid #ccc; padding: 10px; vertical-align: top;">
                        <strong><t t-esc="doc.partner_id.name"/></strong><br/>
                        <t t-if="doc.partner_id.street"><t t-esc="doc.partner_id.street"/><br/></t>
                        <t t-if="doc.partner_id.street2"><t t-esc="doc.partner_id.street2"/><br/></t>
                        B - <t t-esc="doc.partner_id.zip"/> <t t-esc="doc.partner_id.city"/><br/><br/>
                        <t t-if="doc.partner_id.phone or doc.partner_id.mobile">
                            GSM : <t t-esc="doc.partner_id.mobile or doc.partner_id.phone"/><br/>
                        </t>
                        <t t-if="doc.partner_id.email">
                            Mail : <t t-esc="doc.partner_id.email"/>
                        </t>
                    </td>
                </tr>
            </table>

            <!-- ========== TITRE DU BAIL ========== -->
            <h2 style="text-align: center; margin: 20px 0; font-size: 14pt;">
                Bail n°<t t-esc="doc.name"/> de location d'un emplacement garde-meubles
            </h2>

            <!-- ========== CODES D'ACCÈS ========== -->
            <table style="width: 100%; margin-bottom: 20px;">
                <tr>
                    <td style="width: 50%;">
                        <strong>CODE D'ACCES :</strong> 
                        <t t-esc="doc.contract_access_code or '________________'"/>
                    </td>
                    <td style="width: 50%; text-align: right;">
                        <strong>CODE GERBEUR :</strong> 
                        <t t-esc="doc.contract_forklift_code or '________________'"/>
                    </td>
                </tr>
            </table>

            <!-- ========== 1. OBJET DU CONTRAT ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">1. Objet du Contrat</strong>
            </div>
            <p>Le présent contrat a pour objet la location d'un emplacement de garde-meubles désigné comme suit :</p>
            <p>
                <strong>Localisation :</strong> Rue de la Drève Boninnas 2, B-5021 BONINNE<br/>
                <t t-foreach="doc.order_line" t-as="line">
                    <t t-if="line.product_id">
                        <strong>Box n° :</strong> <span style="color: #c41e3a;"><t t-esc="line.product_id.name"/></span><br/>
                        <t t-if="line.product_id.description_sale">
                            <t t-esc="line.product_id.description_sale"/><br/>
                        </t>
                    </t>
                </t>
            </p>

            <!-- ========== 2. DURÉE ET RENOUVELLEMENT ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">2. Durée et renouvellement</strong>
            </div>
            <p>
                Le présent bail est consenti moyennant un loyer principal de 
                <strong><t t-esc="'%.2f' % doc.contract_monthly_rent"/> EUR</strong>, 
                exigible au domicile du bailleur le 5 de chaque mois. Le paiement du premier loyer au prorata 
                du nombre de jour du mois en cours sera honoré le 5 du mois qui suit la location. Le loyer peut 
                être révisé par le bailleur, chaque année à la date anniversaire, en fonction de la variation 
                de l'indice des prix à la consommation.
            </p>

            <!-- ========== 3. PAIEMENT DU LOYER ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">3. Paiement du loyer</strong>
            </div>
            <p>
                Le loyer de <strong><t t-esc="'%.2f' % doc.contract_monthly_rent"/> EUR</strong> est payable 
                le 5 de chaque mois. Une révision annuelle du loyer est possible en fonction de l'indice à la consommation.
            </p>

            <!-- ========== 4. PROVISIONS ET CHARGES ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">4. Provisions et charges</strong>
            </div>
            <p>
                Les charges (Frais de dossier unique) sont fixées forfaitairement à 
                <strong><t t-esc="'%.2f' % doc.contract_dossier_fees if doc.contract_dossier_fees else '15'"/> EUR</strong> 
                et les autres provisions, si mentionnées dans les conditions générales sont révisables chaque année.
            </p>

            <!-- ========== 5. DÉPÔT DE GARANTIE ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">5. Dépôt de garantie</strong>
            </div>
            <p>
                À la signature des présentes, le preneur verse au bailleur l'équivalent de deux mois de loyer 
                <strong><t t-esc="'%.2f' % doc.contract_deposit_amount"/> euros</strong> à titre de dépôt de garantie 
                et de caution pour les équipements d'accès au local garde-meubles. Cette somme est à verser au compte 
                <strong>SRL LOLIRINE - Caution BE30 7320 8038 9611</strong>.
            </p>

            <!-- ========== 6. RETARD DE PAIEMENT ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">6. Retard de paiement – Frais de rappel</strong>
            </div>
            <p>
                En cas de non-paiement à l'échéance convenue, un montant forfaitaire de 20 euros sera automatiquement 
                appliqué à titre de frais de rappel. Ce montant sera dû de plein droit, sans qu'aucun rappel ne soit 
                nécessaire, et viendra s'ajouter au solde impayé.
            </p>

            <!-- ========== SAUT DE PAGE ========== -->
            <div style="page-break-before: always;"></div>

            <!-- ========== LOGO PAGE 2 ========== -->
            <div style="text-align: center; margin-bottom: 20px;">
                <img t-if="company.logo" 
                     t-att-src="image_data_uri(company.logo)" 
                     style="max-height: 60px;" 
                     alt="Logo"/>
            </div>

            <!-- ========== 7. CODE D'ACCÈS ET SÉCURISATION ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">7. Code d'accès et sécurisation du box</strong>
            </div>
            <p>
                Un code d'accès personnel et unique est attribué au client lors de la signature du contrat. 
                Ce code est strictement confidentiel et placé sous la seule responsabilité du client.
            </p>
            <p>
                Tout partage ou transfert de ce code à un tiers, pour quelque raison que ce soit, engage la 
                responsabilité du client en cas de dommages, pertes ou intrusions.
            </p>
            <p>
                Le client est également tenu de fermer systématiquement son box à l'aide d'un cadenas personnel, 
                la société ne fournissant pas de dispositif de fermeture.
            </p>
            <p>
                En cas de négligence, la société décline toute responsabilité pour les éventuels vols ou dégradations.
            </p>

            <!-- ========== 8. MATÉRIEL DE TRANSPORT ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">8. Matériel de transport et de levage</strong>
            </div>
            <p>
                La société met à disposition, sur le site du garde-meubles, du matériel de transport et de levage 
                (chariots, diables, plateaux roulants, etc.) afin de faciliter le déplacement des biens.
            </p>
            <p>
                Le client reconnaît que ce matériel est mis à disposition à titre gracieux et temporaire, et s'engage 
                à l'utiliser avec soin. En cas de mauvaise utilisation ou de dommages causés au matériel ou à des tiers, 
                la responsabilité de la société ne pourra en aucun cas être engagée.
            </p>
            <p>
                Le client prend également bonne note que tout enlèvement du matériel hors du site est strictement 
                interdit et passible d'une amende sévère.
            </p>
            <p>
                Le matériel utilisé doit impérativement être remis à sa place après usage.
            </p>

            <!-- ========== 9. CONDITIONS GÉNÉRALES ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">9. Conditions générales</strong>
            </div>
            <p>
                Le locataire reconnaît avoir pris connaissance des présentes conditions générales (cfr. site internet) 
                et en accepte l'intégralité des termes.
            </p>
            <p>
                Le locataire s'engage à prévenir le bailleur exclusivement par mail au minimum 15 jours avant la date 
                prévue de libération de son box. À défaut, des frais de prolongation pourront être appliqués selon les 
                modalités prévues au contrat.
            </p>
            <p>
                Le locataire est seul responsable de l'assurance des biens stockés dans le box. Il reconnaît que le 
                bailleur ne couvre ni les pertes, ni les vols, ni les dégradations pouvant survenir sur le contenu entreposé.
            </p>
            <p>
                Le locataire reconnaît également avoir eu accès aux informations détaillées relatives au fonctionnement 
                du garde-meubles via le site internet et les conditions générales et en accepte les modalités.
            </p>

            <!-- ========== 10. SIGNATURES ========== -->
            <div style="background-color: #f5f5f5; padding: 8px; margin: 15px 0 10px 0; border-left: 3px solid #c41e3a;">
                <strong style="color: #c41e3a;">10. Signatures</strong>
            </div>
            
            <p style="margin-top: 30px;">
                Fait en double exemplaire à <t t-esc="doc.contract_signature_location or 'Boninne'"/>, 
                le <t t-esc="doc.contract_signature_date.strftime('%d / %m / %Y') if doc.contract_signature_date else '___/___/______'"/>
            </p>
            <p>
                Dépôt des effets, le <t t-esc="doc.contract_deposit_date.strftime('%d / %m / %Y') if doc.contract_deposit_date else '___/___/______'"/>
            </p>

            <table style="width: 100%; margin-top: 50px;">
                <tr>
                    <td style="width: 50%; text-align: center;">
                        <strong>Le Bailleur</strong>
                        <br/><br/><br/><br/>
                        ______________________
                    </td>
                    <td style="width: 50%; text-align: center;">
                        <strong>Le Preneur</strong>
                        <br/><br/><br/><br/>
                        ______________________
                    </td>
                </tr>
            </table>

            <!-- Numéro de page -->
            <div style="text-align: center; margin-top: 30px; font-size: 9pt; color: #666;">
                2
            </div>

        </div>
    </template>

</odoo>
