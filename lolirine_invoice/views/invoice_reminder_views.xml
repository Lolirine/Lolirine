<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- FORMULAIRE RELANCE -->
    <record id="view_invoice_reminder_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.form</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_reminder" string="Envoyer par email" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" string="Marquer payee" type="object" class="btn-success" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_reset_draft" string="Remettre en brouillon" type="object" invisible="state not in ('sent', 'cancelled')"/>
                    <button name="action_create_next_reminder" string="Relance suivante" type="object" class="btn-warning" invisible="state != 'sent' or reminder_type == 'formal_notice'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <span class="o_stat_text">Voir Facture</span>
                        </button>
                    </div>
                    <group>
                        <group string="Relance">
                            <field name="invoice_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="reminder_type"/>
                            <field name="date"/>
                        </group>
                        <group string="Montants">
                            <field name="amount_due"/>
                            <field name="days_overdue"/>
                            <field name="penalty_amount"/>
                            <field name="total_due"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Envoi">
                        <field name="send_date" readonly="1"/>
                        <field name="email_sent" readonly="1"/>
                        <field name="auto_generated" readonly="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- LISTE RELANCES -->
    <record id="view_invoice_reminder_tree" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.tree</field>
        <field name="model">lolirine.invoice.reminder</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'paid'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="reminder_type"/>
                <field name="date"/>
                <field name="amount_due" sum="Total"/>
                <field name="days_overdue"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    
    <!-- FORMULAIRE CONFIG -->
    <record id="view_invoice_reminder_config_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.config.form</field>
        <field name="model">lolirine.invoice.reminder.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Delais (jours apres echeance)">
                            <field name="reminder_1_days"/>
                            <field name="reminder_2_days"/>
                            <field name="reminder_3_days"/>
                            <field name="formal_notice_days"/>
                        </group>
                        <group string="Parametres">
                            <field name="penalty_rate"/>
                            <field name="auto_reminder"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group invisible="not auto_reminder">
                        <button name="action_test_auto_reminder" string="Tester auto-relance" type="object" class="btn-primary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ACTIONS -->
    <record id="action_invoice_reminders" model="ir.actions.act_window">
        <field name="name">Toutes les relances</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <record id="action_invoice_reminders_to_send" model="ir.actions.act_window">
        <field name="name">A envoyer</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
    </record>
    
    <record id="action_invoice_reminders_sent" model="ir.actions.act_window">
        <field name="name">En attente de paiement</field>
        <field name="res_model">lolirine.invoice.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'sent')]</field>
    </record>
    
    <record id="action_invoice_reminder_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">lolirine.invoice.reminder.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    
    <!-- MENUS -->
    <menuitem id="menu_lolirine_reminders"
              name="Relances"
              parent="lolirine_invoice.menu_lolirine_invoice_root"
              sequence="30"/>
    
    <menuitem id="menu_lolirine_reminders_all"
              name="Toutes les relances"
              parent="menu_lolirine_reminders"
              action="action_invoice_reminders"
              sequence="10"/>
    
    <menuitem id="menu_lolirine_reminders_to_send"
              name="A envoyer"
              parent="menu_lolirine_reminders"
              action="action_invoice_reminders_to_send"
              sequence="20"/>
    
    <menuitem id="menu_lolirine_reminders_sent"
              name="En attente de paiement"
              parent="menu_lolirine_reminders"
              action="action_invoice_reminders_sent"
              sequence="30"/>
    
    <menuitem id="menu_lolirine_reminders_config"
              name="Configuration"
              parent="menu_lolirine_reminders"
              action="action_invoice_reminder_config"
              sequence="100"
              groups="base.group_system"/>

</odoo>
