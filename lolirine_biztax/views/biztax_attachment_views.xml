<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Biztax Attachment Form View -->
    <record id="view_biztax_attachment_form" model="ir.ui.view">
        <field name="name">biztax.attachment.form</field>
        <field name="model">biztax.attachment</field>
        <field name="arch" type="xml">
            <form string="Annexe Fiscale">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="declaration_id"/>
                            <field name="name"/>
                            <field name="attachment_type"/>
                        </group>
                        <group string="Fichier">
                            <field name="file_name"/>
                            <field name="file_data" filename="file_name"/>
                            <field name="file_size"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Description ou commentaires..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Biztax Attachment Tree View -->
    <record id="view_biztax_attachment_tree" model="ir.ui.view">
        <field name="name">biztax.attachment.tree</field>
        <field name="model">biztax.attachment</field>
        <field name="arch" type="xml">
            <list string="Annexes Fiscales">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="attachment_type"/>
                <field name="file_name"/>
                <field name="file_size"/>
                <field name="declaration_id"/>
            </list>
        </field>
    </record>

    <!-- Biztax Attachment Search View -->
    <record id="view_biztax_attachment_search" model="ir.ui.view">
        <field name="name">biztax.attachment.search</field>
        <field name="model">biztax.attachment</field>
        <field name="arch" type="xml">
            <search string="Recherche Annexes">
                <field name="name"/>
                <field name="declaration_id"/>
                <field name="attachment_type"/>
                <separator/>
                <filter string="Formulaires 275" name="form_275" domain="[('attachment_type', 'like', '275')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Déclaration" name="group_declaration" context="{'group_by': 'declaration_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'attachment_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for standalone attachment view -->
    <record id="action_biztax_attachment" model="ir.actions.act_window">
        <field name="name">Annexes Fiscales</field>
        <field name="res_model">biztax.attachment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
