<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action pour afficher les box de stockage -->
    <record id="action_storage_box_list" model="ir.actions.act_window">
        <field name="name">Box de Stockage</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_storage_box', '=', True)]</field>
        <field name="context">{'default_is_storage_box': True, 'search_default_storage_box': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier box de stockage
            </p>
            <p>
                Gérez vos box de stockage, leur disponibilité et les rendez-vous clients.
            </p>
        </field>
    </record>

    <!-- Menu racine de l'application (apparaît sur le tableau de bord) -->
    <menuitem id="menu_storage_root"
              name="Box de Stockage"
              action="action_storage_box_list"
              web_icon="lolirine_storage_availability,static/description/icon.png"
              sequence="100"/>

    <!-- Sous-menu : Tous les box -->
    <menuitem id="menu_storage_all"
              name="Tous les Box"
              parent="menu_storage_root"
              action="action_storage_box_list"
              sequence="10"/>

    <!-- Action pour les box disponibles -->
    <record id="action_storage_box_available" model="ir.actions.act_window">
        <field name="name">Box Disponibles</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_storage_box', '=', True), ('storage_status', '=', 'available')]</field>
        <field name="context">{'default_is_storage_box': True, 'default_storage_status': 'available'}</field>
    </record>

    <!-- Sous-menu : Box disponibles -->
    <menuitem id="menu_storage_available"
              name="Disponibles"
              parent="menu_storage_root"
              action="action_storage_box_available"
              sequence="20"/>

    <!-- Action pour les box loués -->
    <record id="action_storage_box_rented" model="ir.actions.act_window">
        <field name="name">Box Loués</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_storage_box', '=', True), ('storage_status', '=', 'rented')]</field>
        <field name="context">{'default_is_storage_box': True, 'default_storage_status': 'rented'}</field>
    </record>

    <!-- Sous-menu : Box loués -->
    <menuitem id="menu_storage_rented"
              name="Loués"
              parent="menu_storage_root"
              action="action_storage_box_rented"
              sequence="30"/>

    <!-- Action pour les box réservés -->
    <record id="action_storage_box_reserved" model="ir.actions.act_window">
        <field name="name">Box Réservés</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_storage_box', '=', True), ('storage_status', '=', 'reserved')]</field>
        <field name="context">{'default_is_storage_box': True, 'default_storage_status': 'reserved'}</field>
    </record>

    <!-- Sous-menu : Box réservés -->
    <menuitem id="menu_storage_reserved"
              name="Réservés"
              parent="menu_storage_root"
              action="action_storage_box_reserved"
              sequence="40"/>

    <!-- Action pour les box en maintenance -->
    <record id="action_storage_box_maintenance" model="ir.actions.act_window">
        <field name="name">Box en Maintenance</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_storage_box', '=', True), ('storage_status', '=', 'maintenance')]</field>
        <field name="context">{'default_is_storage_box': True, 'default_storage_status': 'maintenance'}</field>
    </record>

    <!-- Sous-menu : Box en maintenance -->
    <menuitem id="menu_storage_maintenance"
              name="En Maintenance"
              parent="menu_storage_root"
              action="action_storage_box_maintenance"
              sequence="50"/>

    <!-- ============================================ -->
    <!-- SECTION : Lien avec produits existants      -->
    <!-- ============================================ -->

    <!-- Action pour voir TOUS les produits (pour convertir en box) -->
    <record id="action_all_products_for_conversion" model="ir.actions.act_window">
        <field name="name">Tous les Produits</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sélectionnez des produits existants
            </p>
            <p>
                Cochez la case "Box de stockage" sur les produits que vous souhaitez gérer comme des box.
            </p>
        </field>
    </record>

    <!-- Action pour produits NON encore box de stockage -->
    <record id="action_products_not_storage" model="ir.actions.act_window">
        <field name="name">Produits à convertir</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_storage_box', '=', False)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>
                Ces produits ne sont pas encore configurés comme box de stockage.
                Ouvrez un produit et cochez "Box de stockage" pour le convertir.
            </p>
        </field>
    </record>

    <!-- Sous-menu : Produits -->
    <menuitem id="menu_storage_products"
              name="Produits"
              parent="menu_storage_root"
              sequence="60"/>

    <menuitem id="menu_all_products"
              name="Tous les Produits"
              parent="menu_storage_products"
              action="action_all_products_for_conversion"
              sequence="10"/>

    <menuitem id="menu_products_to_convert"
              name="Produits à Convertir"
              parent="menu_storage_products"
              action="action_products_not_storage"
              sequence="20"/>

    <!-- ============================================ -->
    <!-- SECTION : Configuration                     -->
    <!-- ============================================ -->

    <!-- Séparateur pour la configuration -->
    <menuitem id="menu_storage_config"
              name="Configuration"
              parent="menu_storage_root"
              sequence="100"
              groups="base.group_system"/>

    <!-- Action pour ouvrir les paramètres -->
    <record id="action_storage_config_settings" model="ir.actions.act_window">
        <field name="name">Paramètres Box de Stockage</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'lolirine_storage_availability'}</field>
    </record>

    <menuitem id="menu_storage_settings"
              name="Paramètres"
              parent="menu_storage_config"
              action="action_storage_config_settings"
              sequence="10"/>

    <!-- Action pour les types de rendez-vous -->
    <record id="action_appointment_types" model="ir.actions.act_window">
        <field name="name">Types de Rendez-vous</field>
        <field name="res_model">appointment.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_appointment_types"
              name="Types de Rendez-vous"
              parent="menu_storage_config"
              action="action_appointment_types"
              sequence="20"/>

</odoo>
