<odoo>
    <record id="box_maintenance_view_form" model="ir.ui.view">
        <field name="name">box.maintenance.view.form</field>
        <field name="model">box.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Box">
                <group>
                    <field name="box_name"/>
                    <field name="date"/>
                    <field name="type"/>
                    <field name="notes"/>
                </group>
            </form>
        </field>
    </record>

    <record id="box_maintenance_view_list" model="ir.ui.view">
        <field name="name">box.maintenance.view.list</field>
        <field name="model">box.maintenance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="box_name"/>
                <field name="date"/>
                <field name="type"/>
            </tree>
        </field>
    </record>

    <record id="box_maintenance_action" model="ir.actions.act_window">
        <field name="name">Maintenances de Box</field>
        <field name="res_model">box.maintenance</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
