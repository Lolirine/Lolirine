<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- PRODUCT TEMPLATE - EXTENSION -->
    <!-- ============================================ -->

    <record id="view_product_template_form_dropship" model="ir.ui.view">
        <field name="name">product.template.form.dropship</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Ajouter le bouton dans la button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_dropship_suppliers" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="not is_dropship_product">
                    <field name="dropship_supplier_count" widget="statinfo" string="Fournisseurs"/>
                </button>
            </xpath>
            
            <!-- Ajouter le champ dropshipping près du type de produit -->
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="is_dropship_product"/>
            </xpath>
            
            <!-- Ajouter un nouvel onglet pour le dropshipping -->
            <xpath expr="//notebook" position="inside">
                <page string="Dropshipping" name="dropshipping" invisible="not is_dropship_product">
                    
                    <!-- Résumé -->
                    <group>
                        <group string="Meilleurs fournisseurs">
                            <field name="best_margin_supplier_id"/>
                            <field name="fastest_supplier_id"/>
                            <field name="best_overall_supplier_id"/>
                            <field name="preferred_dropship_supplier_id" 
                                   domain="[('product_tmpl_id', '=', id)]"/>
                        </group>
                        <group string="Marges">
                            <field name="best_margin"/>
                            <field name="avg_margin"/>
                            <field name="worst_margin"/>
                        </group>
                    </group>
                    
                    <!-- Liste des fournisseurs -->
                    <separator string="Fournisseurs dropshipping"/>
                    <field name="dropship_supplier_ids" nolabel="1">
                        <tree editable="bottom" decoration-success="is_priority" 
                              decoration-muted="not is_active">
                            <field name="sequence" widget="handle"/>
                            <field name="supplier_id"/>
                            <field name="supplier_product_ref"/>
                            <field name="price"/>
                            <field name="shipping_cost"/>
                            <field name="total_cost"/>
                            <field name="margin_estimate" widget="progressbar"/>
                            <field name="delay"/>
                            <field name="reliability_score" widget="progressbar"/>
                            <field name="is_priority"/>
                            <field name="is_active"/>
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                    
                </page>
            </xpath>
            
        </field>
    </record>

    <!-- Liste produits - Ajouter colonne dropship -->
    <record id="view_product_template_tree_dropship" model="ir.ui.view">
        <field name="name">product.template.tree.dropship</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_dropship_product" optional="show"/>
                <field name="dropship_supplier_count" optional="hide"/>
                <field name="best_margin" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Recherche produits - Ajouter filtre dropship -->
    <record id="view_product_template_search_dropship" model="ir.ui.view">
        <field name="name">product.template.search.dropship</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='consumable']" position="after">
                <filter string="Dropshipping" name="dropship" 
                        domain="[('is_dropship_product', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
