<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue formulaire du wizard -->
    <record id="view_invoice_reminder_simulation_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.reminder.simulation.wizard.form</field>
        <field name="model">lolirine.invoice.reminder.simulation.wizard</field>
        <field name="arch" type="xml">
            <form string="Simulation des relances">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span class="text-warning">SIMULATION</span> - Aucun email ne sera envoye
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="count" string="Relances a envoyer"/>
                            <field name="total_amount" string="Montant total du (EUR)"/>
                        </group>
                        <group>
                            <field name="total_fees" string="Frais qui seront factures (EUR)"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Detail des relances" name="lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="partner_name" string="Client"/>
                                    <field name="partner_email" string="Email"/>
                                    <field name="invoice_name" string="Facture"/>
                                    <field name="amount_due" string="Montant (EUR)" sum="Total"/>
                                    <field name="days_overdue" string="Retard (j)"/>
                                    <field name="reminder_type" string="Type"/>
                                    <field name="fee" string="Frais (EUR)" sum="Total"/>
                                    <field name="invoice_id" column_invisible="1"/>
                                    <field name="partner_id" column_invisible="1"/>
                                    <button name="action_view_invoice" type="object" icon="fa-file-text-o" title="Voir la facture"/>
                                    <button name="action_view_partner" type="object" icon="fa-user" title="Voir le client"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_execute_reminders" string="Executer les relances maintenant" type="object" class="btn-danger" confirm="Attention: Ceci va REELLEMENT envoyer les emails aux clients. Continuer ?"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard -->
    <record id="action_invoice_reminder_simulation_wizard" model="ir.actions.act_window">
        <field name="name">Simulation des relances</field>
        <field name="res_model">lolirine.invoice.reminder.simulation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
