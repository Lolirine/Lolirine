<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Options d'édition pour les boutons du plan de stockage -->
    <template id="storage_plan_button_options" inherit_id="web_editor.snippet_options">
        <xpath expr="." position="inside">
            <!-- Options pour le bouton de demande générale -->
            <div data-js="StoragePlanButtons"
                 data-selector="#general-inquiry-btn, .storage-plan-btn">
                
                <we-select string="Style du bouton" data-name="button_style_opt" data-select-class="">
                    <we-button data-select-class="btn-primary">Primaire</we-button>
                    <we-button data-select-class="btn-secondary">Secondaire</we-button>
                    <we-button data-select-class="btn-success">Succès</we-button>
                    <we-button data-select-class="btn-danger">Danger</we-button>
                    <we-button data-select-class="btn-warning">Avertissement</we-button>
                    <we-button data-select-class="btn-info">Info</we-button>
                    <we-button data-select-class="btn-light">Clair</we-button>
                    <we-button data-select-class="btn-dark">Sombre</we-button>
                </we-select>
                
                <we-select string="Taille du bouton" data-name="button_size_opt" data-select-class="">
                    <we-button data-select-class="btn-sm">Petit</we-button>
                    <we-button data-select-class="">Normal</we-button>
                    <we-button data-select-class="btn-lg">Grand</we-button>
                </we-select>
                
                <we-checkbox string="Pleine largeur" data-name="button_full_width" data-set-full-width="true"/>
                
            </div>
        </xpath>
    </template>
</odoo>
