<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- INJECTION AUTOMATIQUE SUR LES PAGES PRODUIT -->
    <!-- ============================================ -->

    <!-- Ce template injecte automatiquement les données et boutons pour les box de stockage -->
    <template id="storage_box_auto_inject" 
              inherit_id="website_sale.product" 
              name="Storage Box Auto Inject"
              priority="100">
        
        <!-- Injecter un script avec les données du produit à la fin du body -->
        <xpath expr="//div[@id='product_detail']" position="inside">
            <t t-if="product.is_storage_box">
                <!-- Conteneur pour les boutons de remplacement -->
                <div id="storage_box_buttons" 
                     class="storage-box-container mt-3"
                     t-att-data-is-storage-box="product.is_storage_box"
                     t-att-data-storage-status="product.storage_status"
                     t-att-data-show-appointment="product.show_appointment_button"
                     t-att-data-show-inquiry="product.show_general_inquiry_button"
                     t-att-data-appointment-url="product.appointment_url"
                     t-att-data-inquiry-url="product.general_inquiry_url"
                     t-att-data-appointment-label="product.appointment_button_label"
                     t-att-data-inquiry-label="product.general_inquiry_button_label"
                     t-att-data-status-display="product.storage_status_display">
                    
                    <!-- Badge de statut -->
                    <t t-set="show_badge" t-value="request.env['ir.config_parameter'].sudo().get_param('lolirine_storage.show_status_badge', 'False') == 'True'"/>
                    <div t-if="show_badge" class="storage-status-badge mb-3">
                        <span t-if="product.storage_status == 'available'" 
                              class="badge text-bg-success fs-5 px-4 py-2">
                            <i class="fa fa-check-circle me-2"/> Disponible
                        </span>
                        <span t-elif="product.storage_status == 'rented'" 
                              class="badge text-bg-danger fs-5 px-4 py-2">
                            <i class="fa fa-lock me-2"/> Loué
                        </span>
                        <span t-elif="product.storage_status == 'reserved'" 
                              class="badge text-bg-warning fs-5 px-4 py-2">
                            <i class="fa fa-clock-o me-2"/> Réservé
                        </span>
                        <span t-elif="product.storage_status == 'maintenance'" 
                              class="badge text-bg-secondary fs-5 px-4 py-2">
                            <i class="fa fa-wrench me-2"/> En maintenance
                        </span>
                    </div>
                    
                    <!-- Bouton RDV si disponible -->
                    <t t-if="product.show_appointment_button">
                        <div class="storage-appointment-button mb-3">
                            <a t-att-href="product.appointment_url" 
                               class="btn btn-primary btn-lg w-100 py-3">
                                <i class="fa fa-calendar me-2"/>
                                <t t-esc="product.appointment_button_label"/>
                            </a>
                            <p class="text-muted small mt-2 text-center mb-0">
                                <i class="fa fa-info-circle me-1"/>
                                Prenez rendez-vous pour visiter ce box
                            </p>
                        </div>
                    </t>
                    
                    <!-- Bouton Demande générale si non disponible -->
                    <t t-if="product.show_general_inquiry_button">
                        <div class="storage-general-inquiry-button mb-3">
                            <a t-att-href="product.general_inquiry_url" 
                               class="btn btn-secondary btn-lg w-100 py-3">
                                <i class="fa fa-envelope me-2"/>
                                <t t-esc="product.general_inquiry_button_label"/>
                            </a>
                            <p class="text-muted small mt-2 text-center mb-0">
                                <i class="fa fa-info-circle me-1"/>
                                Ce box n'est pas disponible. Contactez-nous pour plus d'infos.
                            </p>
                        </div>
                    </t>
                    
                </div>
                
                <!-- Script inline pour masquer le panier -->
                <script>
                    (function() {
                        // Masquer immédiatement les éléments du panier
                        var style = document.createElement('style');
                        style.textContent = `
                            #product_detail form[action*="/shop/cart/update"],
                            #product_detail #add_to_cart,
                            #product_detail .js_check_product,
                            #product_detail .css_quantity,
                            #product_detail .js_quantity,
                            #product_detail a[href*="/shop/cart/update"],
                            .js_main_product form[action*="/shop/cart/update"],
                            .js_main_product .js_check_product {
                                display: none !important;
                            }
                        `;
                        document.head.appendChild(style);
                        
                        // Au cas où le DOM n'est pas encore chargé
                        document.addEventListener('DOMContentLoaded', function() {
                            var cartForms = document.querySelectorAll('form[action*="/shop/cart/update"]');
                            cartForms.forEach(function(el) { el.style.display = 'none'; });
                            
                            var addToCart = document.querySelectorAll('#add_to_cart, .js_check_product');
                            addToCart.forEach(function(el) { el.style.display = 'none'; });
                            
                            var qtyInputs = document.querySelectorAll('.css_quantity, .js_quantity');
                            qtyInputs.forEach(function(el) { el.style.display = 'none'; });
                        });
                    })();
                </script>
            </t>
        </xpath>
        
    </template>

    <!-- ============================================ -->
    <!-- TEMPLATES STANDALONE POUR LES SNIPPETS      -->
    <!-- ============================================ -->

    <template id="storage_status_badge" name="Storage Status Badge">
        <t t-if="product and product.is_storage_box">
            <t t-set="show_badge" t-value="request.env['ir.config_parameter'].sudo().get_param('lolirine_storage.show_status_badge', 'False') == 'True'"/>
            <div t-if="show_badge" class="storage-status-badge mb-2">
                <span t-if="product.storage_status == 'available'" 
                      class="badge text-bg-success">
                    <i class="fa fa-check-circle"/> Disponible
                </span>
                <span t-elif="product.storage_status == 'rented'" 
                      class="badge text-bg-danger">
                    <i class="fa fa-lock"/> Loué
                </span>
                <span t-elif="product.storage_status == 'reserved'" 
                      class="badge text-bg-warning">
                    <i class="fa fa-clock-o"/> Réservé
                </span>
                <span t-elif="product.storage_status == 'maintenance'" 
                      class="badge text-bg-secondary">
                    <i class="fa fa-wrench"/> En maintenance
                </span>
            </div>
        </t>
    </template>

    <template id="storage_appointment_button" name="Storage Appointment Button">
        <t t-if="product and product.show_appointment_button">
            <div class="storage-appointment-button my-3">
                <a t-att-href="product.appointment_url" 
                   class="btn btn-primary btn-lg w-100">
                    <i class="fa fa-calendar me-2"/>
                    <t t-esc="product.appointment_button_label"/>
                </a>
            </div>
        </t>
    </template>

    <template id="storage_general_inquiry_button" name="Storage General Inquiry Button">
        <t t-if="product and product.show_general_inquiry_button">
            <div class="storage-general-inquiry-button my-3">
                <a t-att-href="product.general_inquiry_url" 
                   class="btn btn-secondary btn-lg w-100">
                    <i class="fa fa-envelope me-2"/>
                    <t t-esc="product.general_inquiry_button_label"/>
                </a>
            </div>
        </t>
    </template>

</odoo>
