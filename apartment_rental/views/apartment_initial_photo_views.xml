<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Initial Photo Form View -->
    <record id="apartment_property_initial_photo_view_form" model="ir.ui.view">
        <field name="name">apartment.property.initial.photo.form</field>
        <field name="model">apartment.property.initial.photo</field>
        <field name="arch" type="xml">
            <form string="Photo initiale">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Description de la photo"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="property_id" readonly="1"/>
                            <field name="room_type_id"/>
                            <field name="location_detail" placeholder="Ex: Mur gauche, sous fenêtre..."/>
                            <field name="photo_type"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Métadonnées">
                            <field name="taken_date"/>
                            <field name="taken_by"/>
                        </group>
                    </group>
                    <group string="Photo">
                        <field name="image" widget="image" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Notes ou observations..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Initial Photo List View -->
    <record id="apartment_property_initial_photo_view_list" model="ir.ui.view">
        <field name="name">apartment.property.initial.photo.list</field>
        <field name="model">apartment.property.initial.photo</field>
        <field name="arch" type="xml">
            <list string="Photos initiales">
                <field name="sequence" widget="handle"/>
                <field name="image_thumbnail" widget="image"/>
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="photo_type"/>
                <field name="taken_date"/>
            </list>
        </field>
    </record>

    <!-- Initial Photo Kanban View -->
    <record id="apartment_property_initial_photo_view_kanban" model="ir.ui.view">
        <field name="name">apartment.property.initial.photo.kanban</field>
        <field name="model">apartment.property.initial.photo</field>
        <field name="arch" type="xml">
            <kanban default_group_by="room_type_id">
                <field name="id"/>
                <field name="name"/>
                <field name="image_thumbnail"/>
                <field name="room_type_id"/>
                <field name="photo_type"/>
                <field name="taken_date"/>
                <templates>
                    <t t-name="card">
                        <field name="image_thumbnail" widget="image"/>
                        <div class="mt-2">
                            <field name="name" class="fw-bold"/>
                        </div>
                        <div class="text-muted small">
                            <field name="photo_type"/> - <field name="taken_date"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Initial Photo Action -->
    <record id="apartment_property_initial_photo_action" model="ir.actions.act_window">
        <field name="name">Photos initiales</field>
        <field name="res_model">apartment.property.initial.photo</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
