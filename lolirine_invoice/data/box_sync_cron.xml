<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Synchronisation quotidienne contrats -> plan des boxes -> boutique -->
        <record id="ir_cron_box_sync_availability" model="ir.cron">
            <field name="name">Lolirine - Synchronisation disponibilité des boxes</field>
            <field name="model_id" ref="storage_plan_module.model_storage_box"/>
            <field name="state">code</field>
            <field name="code">model.cron_lolirine_sync_availability()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
