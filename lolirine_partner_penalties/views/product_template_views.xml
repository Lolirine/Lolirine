<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ajout du champ is_storage_box sur le formulaire produit -->
    <record id="product_template_form_view_storage_box" model="ir.ui.view">
        <field name="name">product.template.form.storage.box</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="is_storage_box"/>
            </xpath>
        </field>
    </record>

    <!-- Ajout du filtre dans la recherche produit -->
    <record id="product_template_search_view_storage_box" model="ir.ui.view">
        <field name="name">product.template.search.storage.box</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Box de stockage" name="storage_box" domain="[('is_storage_box', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
