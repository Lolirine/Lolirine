<odoo>
  <template id="formulaire_location_template" name="Formulaire Réservation Box" page="True">
    <t t-call="website.layout">
      <div class="container mt-5">
        <h2>Formulaire de réservation pour le box: <t t-esc="product.name"/></h2>
        <form action="/submit-location-form" method="POST">
          <input type="hidden" name="box_id" t-att-value="product.id"/>
          <div class="form-group">
            <label>Nom</label>
            <input type="text" name="name" class="form-control" required/>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control" required/>
          </div>
          <div class="form-group">
            <label>Date de début souhaitée</label>
            <input type="date" name="start_date" class="form-control" required/>
          </div>
          <div class="form-group">
            <label>Message</label>
            <textarea name="message" class="form-control" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-primary mt-2">Envoyer la demande</button>
        </form>
      </div>
    </t>
  </template>
</odoo>