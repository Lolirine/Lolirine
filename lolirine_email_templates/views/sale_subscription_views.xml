<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================= -->
    <!-- ABONNEMENT - EXTENSION FORMULAIRE -->
    <!-- ============================================= -->
    <record id="view_sale_order_form_email_auto" model="ir.ui.view">
        <field name="name">sale.order.form.email.auto</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter après le champ client_order_ref -->
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="auto_send_invoice_email" 
                       string="📧 Envoi email factures auto"
                       invisible="not is_subscription"/>
            </xpath>
        </field>
    </record>
    
</odoo>
