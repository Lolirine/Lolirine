<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Biztax Module Category -->
        <record id="module_category_biztax" model="ir.module.category">
            <field name="name">Biztax</field>
            <field name="description">Déclarations fiscales belges (ISOC/IPM/INR)</field>
            <field name="sequence">30</field>
        </record>

        <!-- User Group -->
        <record id="group_biztax_user" model="res.groups">
            <field name="name">Utilisateur Biztax</field>
            <field name="category_id" ref="module_category_biztax"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Peut consulter et créer des déclarations Biztax</field>
        </record>

        <!-- Manager Group -->
        <record id="group_biztax_manager" model="res.groups">
            <field name="name">Gestionnaire Biztax</field>
            <field name="category_id" ref="module_category_biztax"/>
            <field name="implied_ids" eval="[(4, ref('group_biztax_user'))]"/>
            <field name="comment">Peut valider, générer et configurer les déclarations Biztax</field>
        </record>

        <!-- Admin Group -->
        <record id="group_biztax_admin" model="res.groups">
            <field name="name">Administrateur Biztax</field>
            <field name="category_id" ref="module_category_biztax"/>
            <field name="implied_ids" eval="[(4, ref('group_biztax_manager'))]"/>
            <field name="comment">Accès complet à la configuration Biztax</field>
        </record>

        <!-- Record Rules -->
        <record id="biztax_declaration_company_rule" model="ir.rule">
            <field name="name">Déclaration Biztax multi-company</field>
            <field name="model_id" ref="model_biztax_declaration"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="biztax_adjustment_company_rule" model="ir.rule">
            <field name="name">Ajustement Biztax multi-company</field>
            <field name="model_id" ref="model_biztax_adjustment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="biztax_mapping_company_rule" model="ir.rule">
            <field name="name">Mapping Biztax multi-company</field>
            <field name="model_id" ref="model_biztax_account_mapping"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
