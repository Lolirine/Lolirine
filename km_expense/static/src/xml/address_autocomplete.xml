<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <!-- Template pour le widget d'autocomplétion d'adresses -->
    <t t-name="km_expense.AddressAutocompleteField" t-inherit="web.CharField" t-inherit-mode="primary">
        <xpath expr="//input" position="attributes">
            <attribute name="t-ref">input</attribute>
            <attribute name="autocomplete">off</attribute>
            <attribute name="class">o_input</attribute>
        </xpath>
    </t>
    
</templates>
