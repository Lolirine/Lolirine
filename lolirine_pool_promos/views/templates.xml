<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="promotions_page_template" name="Promotions Pool Store">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'promotions'"/>

            <div id="wrap" class="oe_structure oe_empty">

                <!-- HERO SECTION -->
                <section class="s_cover pt80 pb80" data-scroll-background-ratio="1"
                    style="background: linear-gradient(135deg, #0369a1 0%, #1a3a5c 100%); min-height: 320px;">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8 mx-auto text-center text-white">
                                <h1 class="display-3" style="font-weight: 800;">
                                    Nos Promotions
                                </h1>
                                <p class="lead mt-3 mb-4" style="opacity: 0.9; font-size: 1.25rem;">
                                    Profitez de nos offres spéciales sur une sélection de produits piscine et spa
                                </p>
                                <a href="/shop" class="btn btn-light btn-lg rounded-pill px-5 fw-semibold"
                                    style="color: #0369a1;">
                                    Voir tout le catalogue →
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- PROMOTIONS LIST -->
                <section class="pt-5 pb-5">
                    <div class="container">

                        <!-- Empty state -->
                        <t t-if="not promotions">
                            <div class="text-center py-5">
                                <div style="font-size: 4rem; opacity: 0.3;">🏷️</div>
                                <h3 class="text-muted mt-3">Aucune promotion en cours</h3>
                                <p class="text-muted">Revenez bientôt pour découvrir nos prochaines offres !</p>
                                <a href="/shop" class="btn btn-primary btn-lg mt-3 rounded-pill px-5">
                                    Explorer le catalogue
                                </a>
                            </div>
                        </t>

                        <!-- Promotions loop -->
                        <t t-foreach="promotions" t-as="promo">
                            <div class="mb-5">

                                <!-- PROMO BANNER -->
                                <div class="rounded-4 p-4 p-lg-5 text-white position-relative overflow-hidden shadow"
                                    t-attf-style="background: linear-gradient(135deg, #{promo.banner_color or '#0369a1'} 0%, #1a3a5c 100%);">

                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                        <div>
                                            <h2 class="fw-bold mb-1 display-6" t-esc="promo.name"/>
                                            <p class="mb-2 fs-5" style="opacity: 0.85;"
                                                t-if="promo.subtitle" t-esc="promo.subtitle"/>
                                            <span t-if="promo.discount_text"
                                                class="badge fs-5 px-3 py-2 mt-1"
                                                style="background-color: #fbbf24; color: #1a3a5c;">
                                                <t t-esc="promo.discount_text"/>
                                            </span>
                                        </div>
                                        <div>
                                            <a t-att-href="promo.button_url or '/shop/promotions'"
                                                class="btn btn-light btn-lg fw-semibold px-4 rounded-pill shadow-sm"
                                                style="color: #0369a1;">
                                                <t t-esc="promo.button_text or 'En profiter'"/>
                                                <span> →</span>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="mt-3 small" style="opacity: 0.7;">
                                        Valable du <span t-field="promo.date_start"/> au <span t-field="promo.date_end"/>
                                    </div>
                                </div>

                                <!-- DESCRIPTION -->
                                <t t-if="promo.description">
                                    <div class="mt-4 px-2 fs-5 text-muted" t-out="promo.description"/>
                                </t>

                                <!-- PRODUCTS GRID (from lines) -->
                                <t t-if="promo.line_ids">
                                    <h4 class="mt-5 mb-4 fw-bold" style="color: #1a3a5c;">
                                        <span style="border-bottom: 3px solid #0369a1; padding-bottom: 6px;">
                                            Produits concernés
                                        </span>
                                    </h4>
                                    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
                                        <t t-foreach="promo.line_ids" t-as="line">
                                            <div class="col">
                                                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden position-relative">

                                                    <!-- Discount badge on card -->
                                                    <t t-if="line.discount_display">
                                                        <span class="position-absolute top-0 end-0 m-2 badge rounded-pill fs-6 px-3 py-2"
                                                            style="background-color: #dc2626; color: white; z-index: 1;">
                                                            <t t-esc="line.discount_display"/>
                                                        </span>
                                                    </t>

                                                    <!-- Product image -->
                                                    <a t-attf-href="/shop/product/#{slug(line.product_id)}"
                                                        class="text-decoration-none">
                                                        <div style="background: #f8fafc; padding: 20px;">
                                                            <img class="w-100"
                                                                t-attf-src="/web/image/product.template/#{line.product_id.id}/image_256"
                                                                t-att-alt="line.product_id.name"
                                                                style="height: 180px; object-fit: contain;"
                                                                loading="lazy"/>
                                                        </div>
                                                    </a>

                                                    <!-- Product info -->
                                                    <div class="card-body text-center p-3">
                                                        <h6 class="card-title mb-2 fw-semibold"
                                                            style="min-height: 2.5em; line-height: 1.3; color: #1a3a5c;">
                                                            <a t-attf-href="/shop/product/#{slug(line.product_id)}"
                                                                class="text-decoration-none"
                                                                style="color: #1a3a5c;"
                                                                t-esc="line.product_id.name"/>
                                                        </h6>

                                                        <!-- Pricing: original strikethrough + promo price -->
                                                        <div class="mb-2">
                                                            <t t-if="line.savings > 0">
                                                                <span class="text-muted text-decoration-line-through me-2"
                                                                    style="font-size: 0.9rem;">
                                                                    <t t-esc="'%.2f' % line.original_price"/> €
                                                                </span>
                                                                <span class="fw-bold fs-5" style="color: #dc2626;">
                                                                    <t t-esc="'%.2f' % line.final_price"/> €
                                                                </span>
                                                                <div class="mt-1">
                                                                    <span class="badge rounded-pill px-2"
                                                                        style="background-color: #dcfce7; color: #166534; font-size: 0.8rem;">
                                                                        Économie : <t t-esc="'%.2f' % line.savings"/> €
                                                                    </span>
                                                                </div>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="fw-bold fs-5" style="color: #0369a1;">
                                                                    <t t-esc="'%.2f' % line.original_price"/> €
                                                                </span>
                                                            </t>
                                                        </div>
                                                    </div>

                                                    <!-- CTA button -->
                                                    <div class="card-footer bg-transparent border-0 text-center pb-3">
                                                        <a t-attf-href="/shop/product/#{slug(line.product_id)}"
                                                            class="btn btn-sm rounded-pill px-4"
                                                            style="background-color: #0369a1; color: white;">
                                                            Voir le produit
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>

                            <hr class="my-5" t-if="not promo_last" style="opacity: 0.15;"/>
                        </t>

                    </div>
                </section>

                <!-- CTA Section -->
                <section class="s_text_block pt-5 pb-5" style="background-color: #f0f9ff;">
                    <div class="container text-center">
                        <h2 class="fw-bold mb-3" style="color: #1a3a5c;">
                            Besoin de conseils ?
                        </h2>
                        <p class="lead text-muted mb-4">
                            Notre équipe est à votre disposition pour vous aider à choisir les meilleurs produits
                        </p>
                        <a href="/contactus" class="btn btn-lg rounded-pill px-5 fw-semibold"
                            style="background-color: #0369a1; color: white;">
                            Contactez-nous
                        </a>
                    </div>
                </section>

            </div>
        </t>
    </template>

</odoo>
