<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ============================================ -->
    <!-- POOL CATALOG EXTRACTION VIEWS               -->
    <!-- ============================================ -->

    <!-- Extraction List View -->
    <record id="pool_catalog_extraction_view_list" model="ir.ui.view">
        <field name="name">pool.catalog.extraction.list</field>
        <field name="model">pool.catalog.extraction</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'imported'" 
                  decoration-warning="state == 'extracted'" 
                  decoration-danger="state == 'error'">
                <field name="create_date" string="Date"/>
                <field name="supplier_id"/>
                <field name="extraction_type" widget="badge"/>
                <field name="product_count"/>
                <field name="imported_count"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'extracted'"
                       decoration-success="state == 'imported'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <!-- Extraction Form View -->
    <record id="pool_catalog_extraction_view_form" model="ir.ui.view">
        <field name="name">pool.catalog.extraction.form</field>
        <field name="model">pool.catalog.extraction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_extract" 
                            string="🔍 Extraire avec IA" 
                            type="object" 
                            class="btn-primary"
                            invisible="state not in ('draft', 'error')"/>
                    <button name="action_re_extract" 
                            string="🔄 Ré-extraire" 
                            type="object"
                            invisible="state != 'extracted'"/>
                    <button name="action_import_all" 
                            string="📥 Importer tout" 
                            type="object" 
                            class="btn-success"
                            invisible="state != 'extracted' or product_count == 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,extracted,imported"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" 
                                name="action_import_all" 
                                icon="fa-cubes"
                                invisible="product_count == 0">
                            <field name="product_count" widget="statinfo" string="Produits"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-circle"
                                invisible="imported_count == 0">
                            <field name="imported_count" widget="statinfo" string="Importés"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Erreur" bg_color="text-bg-danger" invisible="state != 'error'"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Source">
                            <field name="supplier_id"/>
                            <field name="image" widget="image" class="oe_avatar" options="{'size': [300, 300]}"/>
                            <field name="image_filename" invisible="1"/>
                        </group>
                        <group string="Extraction">
                            <field name="extraction_type" readonly="1"/>
                            <field name="error_message" invisible="not error_message" 
                                   readonly="1" widget="text" class="text-danger"/>
                        </group>
                    </group>
                    
                    <!-- Produits extraits -->
                    <notebook invisible="state == 'draft'">
                        <page string="Produits extraits" name="products">
                            <field name="extracted_product_ids" nolabel="1">
                                <list editable="bottom" 
                                      decoration-success="state == 'imported'"
                                      decoration-danger="state == 'error'"
                                      decoration-muted="state == 'skipped'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="type_code" optional="show"/>
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="capacity" optional="show"/>
                                    <field name="brand" optional="hide"/>
                                    <field name="category" optional="hide"/>
                                    <field name="purchase_price" sum="Total Achat"/>
                                    <field name="selling_price" sum="Total Vente"/>
                                    <field name="margin" widget="percentage" optional="show"/>
                                    <field name="is_dropship_product" widget="boolean" optional="show"/>
                                    <field name="power_kw" optional="show"/>
                                    <field name="state" widget="badge"/>
                                    <button name="action_import_to_odoo" 
                                            type="object" 
                                            icon="fa-download" 
                                            title="Importer"
                                            invisible="state != 'draft'"/>
                                    <button name="action_skip" 
                                            type="object" 
                                            icon="fa-ban" 
                                            title="Ignorer"
                                            invisible="state != 'draft'"/>
                                    <button name="action_reset" 
                                            type="object" 
                                            icon="fa-refresh" 
                                            title="Réinitialiser"
                                            invisible="state in ('draft', 'imported')"/>
                                    <button name="action_view_product" 
                                            type="object" 
                                            icon="fa-external-link" 
                                            title="Voir le produit"
                                            invisible="not product_id and not existing_product_id"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Aperçu image" name="preview">
                            <field name="image" widget="image" readonly="1" class="w-100"/>
                        </page>
                        
                        <page string="Données brutes" name="raw_data">
                            <field name="raw_extraction_data" readonly="1" widget="text"/>
                        </page>
                        
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes et commentaires..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Extraction Search View -->
    <record id="pool_catalog_extraction_view_search" model="ir.ui.view">
        <field name="name">pool.catalog.extraction.search</field>
        <field name="model">pool.catalog.extraction</field>
        <field name="arch" type="xml">
            <search>
                <field name="supplier_id"/>
                <field name="extraction_type"/>
                <filter name="draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="extracted" string="Extrait" domain="[('state', '=', 'extracted')]"/>
                <filter name="imported" string="Importé" domain="[('state', '=', 'imported')]"/>
                <filter name="error" string="Erreur" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="with_variants" string="Avec variantes" domain="[('extraction_type', '=', 'variants')]"/>
                <separator/>
                <filter name="group_supplier" string="Fournisseur" context="{'group_by': 'supplier_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'extraction_type'}"/>
                <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Extraction Action -->
    <record id="action_pool_catalog_extraction" model="ir.actions.act_window">
        <field name="name">Extractions OCR</field>
        <field name="res_model">pool.catalog.extraction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_extracted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune extraction OCR
            </p>
            <p>
                Utilisez l'extracteur de catalogue pour capturer et extraire les produits depuis vos catalogues fournisseurs.
            </p>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- EXTRACTION PRODUCT VIEWS                    -->
    <!-- ============================================ -->

    <!-- Extraction Product Form View -->
    <record id="pool_catalog_extraction_product_view_form" model="ir.ui.view">
        <field name="name">pool.catalog.extraction.product.form</field>
        <field name="model">pool.catalog.extraction.product</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import_to_odoo" 
                            string="Importer dans Odoo" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_skip" 
                            string="Ignorer" 
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_reset" 
                            string="Réinitialiser" 
                            type="object"
                            invisible="state in ('draft', 'imported')"/>
                    <button name="action_view_product" 
                            string="Voir le produit" 
                            type="object" 
                            class="btn-info"
                            invisible="not product_id and not existing_product_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Identification">
                            <field name="extraction_id"/>
                            <field name="type_code"/>
                            <field name="reference"/>
                            <field name="brand"/>
                            <field name="category"/>
                            <field name="variant_name"/>
                            <field name="capacity"/>
                        </group>
                        <group string="Prix">
                            <field name="purchase_price"/>
                            <field name="selling_price"/>
                            <field name="margin" widget="percentage"/>
                            <field name="is_dropship_product"/>
                        </group>
                    </group>
                    
                    <group string="Spécifications techniques">
                        <group>
                            <field name="power_kw"/>
                            <field name="power_cv"/>
                            <field name="voltage"/>
                            <field name="flow_rate"/>
                            <field name="diameter_mm"/>
                            <field name="filter_area"/>
                        </group>
                        <group>
                            <field name="cop"/>
                            <field name="noise_level"/>
                            <field name="capacity_spec"/>
                            <field name="dimensions"/>
                            <field name="weight"/>
                            <field name="warranty_years"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Descriptions" name="descriptions">
                            <group>
                                <field name="description_fr"/>
                                <field name="description_nl"/>
                            </group>
                        </page>
                        <page string="Lien Odoo" name="odoo">
                            <group>
                                <field name="existing_product_id"/>
                                <field name="product_id"/>
                                <field name="error_message" invisible="not error_message"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Extraction Product List View (standalone) -->
    <record id="pool_catalog_extraction_product_view_list" model="ir.ui.view">
        <field name="name">pool.catalog.extraction.product.list</field>
        <field name="model">pool.catalog.extraction.product</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'imported'"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'skipped'">
                <field name="extraction_id"/>
                <field name="type_code"/>
                <field name="reference"/>
                <field name="name"/>
                <field name="brand"/>
                <field name="capacity"/>
                <field name="purchase_price" sum="Total"/>
                <field name="selling_price" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Extraction Product Action -->
    <record id="action_pool_catalog_extraction_product" model="ir.actions.act_window">
        <field name="name">Produits extraits</field>
        <field name="res_model">pool.catalog.extraction.product</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>

</data>
</odoo>
