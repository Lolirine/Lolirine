<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ============================================ -->
    <!-- SALE ORDER - EXTENSION -->
    <!-- ============================================ -->

    <record id="view_sale_order_form_dropship" model="ir.ui.view">
        <field name="name">sale.order.form.dropship</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Ajouter les boutons dans la button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_dropship_purchases" type="object"
                        class="oe_stat_button" icon="fa-shopping-cart"
                        invisible="not is_dropship_order or dropship_purchase_count == 0">
                    <field name="dropship_purchase_count" widget="statinfo" string="BC Fournisseur"/>
                </button>
            </xpath>
            
            <!-- Ajouter le badge dropship dans le header -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_dropship_order" invisible="1"/>
                <field name="dropship_needs_processing" invisible="1"/>
                <field name="dropship_ref" invisible="1"/>
                <field name="dropship_quote_sent" invisible="1"/>
                <field name="dropship_confirmation_sent" invisible="1"/>
                <span class="badge rounded-pill text-bg-info me-2" 
                      invisible="not is_dropship_order">
                    <i class="fa fa-truck"/> <field name="dropship_ref" readonly="1" nolabel="1" invisible="not dropship_ref"/>
                    <span invisible="dropship_ref">Dropship</span>
                </span>
            </xpath>
            
            <!-- Bandeau alerte commande à traiter -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info text-center" role="alert"
                     invisible="not dropship_needs_processing">
                    <strong>🛒 COMMANDE DROPSHIP À TRAITER</strong> — 
                    Cliquez sur "Créer BC Dropship" pour créer le bon de commande fournisseur.
                </div>
            </xpath>
            
            <!-- Ajouter les actions dropship -->
            <xpath expr="//header" position="inside">
                <!-- === ENVOI DEVIS & CONFIRMATION === -->
                <button name="action_send_dropship_quote" type="object"
                        string="📧 Envoyer le devis" class="btn-primary"
                        invisible="not is_dropship_order or state != 'draft'"/>
                <button name="action_preview_dropship_quote_pdf" type="object"
                        string="📄 Aperçu devis PDF" class="btn-secondary"
                        invisible="not is_dropship_order or state != 'draft'"/>
                <button name="action_send_dropship_confirmation" type="object"
                        string="📧 Envoyer la confirmation" class="btn-primary"
                        invisible="not is_dropship_order or state != 'sale' or dropship_confirmation_sent"
                        confirm="Envoyer la confirmation de commande avec le PDF au client ?"/>
                <button name="action_preview_dropship_order_pdf" type="object"
                        string="📄 Aperçu commande PDF" class="btn-secondary"
                        invisible="not is_dropship_order or state != 'sale'"/>
                
                <!-- === WORKFLOW DROPSHIP === -->
                <button name="action_open_create_dropship_po_wizard" type="object"
                        string="📋 Créer BC Dropship" class="btn-primary"
                        invisible="not is_dropship_order or dropship_status not in ('pending', 'analyzed', 'supplier_selected', 'to_process') or dropship_purchase_count &gt; 0 or state == 'draft'"/>
                <button name="action_reanalyze_suppliers" type="object"
                        string="Réanalyser fournisseurs" class="btn-secondary"
                        invisible="not is_dropship_order or state != 'draft'"/>
                <button name="action_manual_supplier_selection" type="object"
                        string="Sélection manuelle" class="btn-secondary"
                        invisible="not is_dropship_order"/>
                <button name="action_create_dropship_po" type="object"
                        string="Créer BC (auto)" class="btn-secondary"
                        invisible="not is_dropship_order or dropship_status not in ('analyzed', 'supplier_selected') or state == 'draft'"/>
                <button name="action_mark_shipped" type="object"
                        string="📦 Expédiée" class="btn-info"
                        invisible="not is_dropship_order or dropship_status != 'po_sent'"/>
                <button name="action_mark_delivered" type="object"
                        string="✅ Livrée" class="btn-success"
                        invisible="not is_dropship_order or dropship_status != 'shipped'"/>
                <button name="action_mark_issue" type="object"
                        string="⚠️ Problème" class="btn-danger"
                        invisible="not is_dropship_order or dropship_status in ('pending', 'delivered')"/>
            </xpath>
            
            <!-- Ajouter l'onglet Dropshipping -->
            <xpath expr="//notebook" position="inside">
                <page string="Dropshipping" name="dropshipping" invisible="not is_dropship_order">
                    
                    <!-- Alertes -->
                    <div class="alert alert-warning" role="alert" invisible="not dropship_has_alerts">
                        <strong><i class="fa fa-warning"/> Alertes:</strong>
                        <field name="dropship_alert_message" nolabel="1"/>
                    </div>
                    
                    <!-- Statut et marges -->
                    <group>
                        <group string="Statut">
                            <field name="dropship_ref" readonly="1"/>
                            <field name="dropship_status" widget="badge"
                                   decoration-info="dropship_status in ('pending', 'analyzed')"
                                   decoration-warning="dropship_status in ('supplier_selected', 'po_created')"
                                   decoration-success="dropship_status in ('po_sent', 'shipped', 'delivered')"
                                   decoration-danger="dropship_status == 'issue'"/>
                        </group>
                        <group string="Communication">
                            <field name="dropship_quote_sent" widget="boolean_toggle" readonly="1"/>
                            <field name="dropship_confirmation_sent" widget="boolean_toggle" readonly="1"/>
                        </group>
                        <group string="Marges">
                            <field name="dropship_total_supplier_cost"/>
                            <field name="dropship_estimated_margin"/>
                            <field name="dropship_margin_percent" widget="progressbar"/>
                        </group>
                    </group>
                    
                    <!-- Journal des décisions -->
                    <separator string="Journal des décisions"/>
                    <field name="dropship_decision_log_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="decision_date"/>
                            <field name="product_id"/>
                            <field name="selected_supplier_id"/>
                            <field name="decision_type"/>
                            <field name="margin_percent"/>
                            <field name="score"/>
                            <field name="reasons"/>
                        </list>
                    </field>
                    
                </page>
            </xpath>
            
        </field>
    </record>

    <!-- Extension des lignes de commande -->
    <record id="view_sale_order_line_tree_dropship" model="ir.ui.view">
        <field name="name">sale.order.line.list.dropship</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="dropship_supplier_id" optional="hide"/>
                <field name="dropship_supplier_cost" optional="hide"/>
                <field name="dropship_margin" optional="hide"/>
                <field name="dropship_tracking_number" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Vue liste des commandes - Ajouter colonnes dropship -->
    <record id="view_sale_order_tree_dropship" model="ir.ui.view">
        <field name="name">sale.order.list.dropship</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_dropship_order" column_invisible="1"/>
                <field name="dropship_ref" optional="show"/>
                <field name="dropship_status" optional="show"
                       decoration-info="dropship_status in ('pending', 'analyzed')"
                       decoration-warning="dropship_status in ('supplier_selected', 'po_created')"
                       decoration-success="dropship_status in ('po_sent', 'shipped', 'delivered')"
                       decoration-danger="dropship_status == 'issue'"/>
                <field name="dropship_margin_percent" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Recherche commandes - Ajouter filtres dropship -->
    <record id="view_sale_order_search_dropship" model="ir.ui.view">
        <field name="name">sale.order.search.dropship</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/filter[1]" position="before">
                <separator/>
                <filter string="Dropshipping" name="dropship" 
                        domain="[('is_dropship_order', '=', True)]"/>
                <filter string="À traiter" name="dropship_to_process" 
                        domain="[('is_dropship_order', '=', True), ('state', '=', 'sale'), ('dropship_status', 'in', ['pending', 'to_process', 'analyzed', 'supplier_selected'])]"/>
                <filter string="En attente d'analyse" name="dropship_pending" 
                        domain="[('dropship_status', '=', 'pending')]"/>
                <filter string="BC à créer" name="dropship_to_create" 
                        domain="[('dropship_status', '=', 'supplier_selected')]"/>
                <filter string="Expédiées" name="dropship_shipped" 
                        domain="[('dropship_status', '=', 'shipped')]"/>
                <filter string="Problèmes" name="dropship_issues" 
                        domain="[('dropship_status', '=', 'issue')]"/>
            </xpath>
        </field>
    </record>

    <!-- Action pour les commandes dropshipping -->
    <record id="action_sale_order_dropship" model="ir.actions.act_window">
        <field name="name">Commandes Dropshipping</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
        <field name="domain">[('is_dropship_order', '=', True)]</field>
        <field name="context">{'search_default_dropship': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune commande dropshipping
            </p>
            <p>
                Les commandes contenant des produits dropshipping apparaîtront ici.
            </p>
        </field>
    </record>

    <!-- Action: Commandes à traiter -->
    <record id="action_dropship_orders_to_process" model="ir.actions.act_window">
        <field name="name">Commandes à traiter</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[
            ('is_dropship_order', '=', True),
            ('state', '=', 'sale'),
            ('dropship_status', 'in', ['pending', 'to_process', 'analyzed', 'supplier_selected']),
        ]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune commande dropship à traiter !
            </p>
            <p>
                Les commandes confirmées nécessitant la création d'un BC fournisseur apparaîtront ici.
            </p>
        </field>
    </record>

    <!-- Action: Toutes les commandes dropship -->
    <record id="action_dropship_orders_all" model="ir.actions.act_window">
        <field name="name">Toutes les commandes dropship</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="domain">[('is_dropship_order', '=', True)]</field>
        <field name="context">{}</field>
    </record>

</data>
</odoo>
