<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Template 1er Rappel - Avertissement frais -->
        <record id="email_template_reminder_1" model="mail.template">
            <field name="name">Lolirine - Relance: 1er Rappel</field>
            <field name="model_id" ref="model_lolirine_invoice_reminder"/>
            <field name="subject">Rappel de paiement - Facture {{ object.invoice_id.name }}</field>
            <field name="email_from">gardemeublelolirine@gmail.com</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 13px; color: #333;">
    <p>Bonjour {{ object.partner_id.name }},</p>
    
    <p>Sauf erreur de notre part, nous n'avons pas encore recu le paiement de la facture suivante :</p>
    
    <table style="margin: 20px 0; border-collapse: collapse; width: 100%; max-width: 400px;">
        <tr style="background-color: #f5f5f5;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Facture</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">{{ object.invoice_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Echeance</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">{{ object.invoice_id.invoice_date_due }}</td>
        </tr>
        <tr style="background-color: #f5f5f5;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Montant</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>{{ "%.2f"|format(object.amount_due) }} EUR</strong></td>
        </tr>
    </table>
    
    <p>Nous vous remercions de bien vouloir regulariser cette situation dans les meilleurs delais.</p>
    
    <p style="background-color: #fff3cd; padding: 10px; border-left: 4px solid #ffc107;">
        <strong>Attention :</strong> A defaut de paiement, des <strong>frais de rappel de 20 EUR</strong> pourront etre appliques conformement a nos conditions generales.
    </p>
    
    <p><strong>Coordonnees bancaires :</strong></p>
    <ul>
        <li>IBAN : BE07 7320 5208 0866 - CBC</li>
        <li>Communication : {{ object.invoice_id.payment_reference or object.invoice_id.name }}</li>
    </ul>
    
    <p>Si vous avez deja effectue le paiement, veuillez ignorer ce message.</p>
    
    <p>Cordialement,</p>
    <p><strong>Lolirine Garde-Meubles</strong><br/>Tel : 0497/44 41 46</p>
</div>
]]></field>
            <field name="report_template_ids" eval="[(4, ref('account.account_invoices'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- Template 2eme Rappel - Frais 20 EUR seront appliques -->
        <record id="email_template_reminder_2" model="mail.template">
            <field name="name">Lolirine - Relance: 2eme Rappel</field>
            <field name="model_id" ref="model_lolirine_invoice_reminder"/>
            <field name="subject">2eme Rappel - Facture {{ object.invoice_id.name }}</field>
            <field name="email_from">gardemeublelolirine@gmail.com</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 13px; color: #333;">
    <p>Bonjour {{ object.partner_id.name }},</p>
    
    <p>Malgre notre precedent rappel, nous constatons que la facture ci-dessous reste impayee :</p>
    
    <table style="margin: 20px 0; border-collapse: collapse; width: 100%; max-width: 400px;">
        <tr style="background-color: #f5f5f5;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Facture</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">{{ object.invoice_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Echeance</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">{{ object.invoice_id.invoice_date_due }}</td>
        </tr>
        <tr style="background-color: #f5f5f5;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Montant</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>{{ "%.2f"|format(object.amount_due) }} EUR</strong></td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Retard</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd; color: #e67e22;">{{ object.days_overdue }} jours</td>
        </tr>
    </table>
    
    <p style="background-color: #f8d7da; padding: 10px; border-left: 4px solid #dc3545;">
        <strong>IMPORTANT :</strong> Sans paiement dans les <strong>5 jours</strong>, des <strong>frais de rappel de 20 EUR</strong> seront automatiquement ajoutes a votre facture.
    </p>
    
    <p><strong>Coordonnees bancaires :</strong></p>
    <ul>
        <li>IBAN : BE07 7320 5208 0866 - CBC</li>
        <li>Communication : {{ object.invoice_id.payment_reference or object.invoice_id.name }}</li>
    </ul>
    
    <p>Cordialement,</p>
    <p><strong>Lolirine Garde-Meubles</strong><br/>Tel : 0497/44 41 46</p>
</div>
]]></field>
            <field name="report_template_ids" eval="[(4, ref('account.account_invoices'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- Template 3eme Rappel - Frais 20 EUR appliques + menace 50 EUR -->
        <record id="email_template_reminder_3" model="mail.template">
            <field name="name">Lolirine - Relance: 3eme Rappel - URGENT</field>
            <field name="model_id" ref="model_lolirine_invoice_reminder"/>
            <field name="subject">URGENT - 3eme Rappel - Facture {{ object.invoice_id.name }}</field>
            <field name="email_from">gardemeublelolirine@gmail.com</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 13px; color: #333;">
    <p>Bonjour {{ object.partner_id.name }},</p>
    
    <p style="color: #c0392b;"><strong>URGENT - TROISIEME ET DERNIER RAPPEL</strong></p>
    
    <p>Malgre nos precedents rappels, la facture suivante reste impayee. Conformement a nos conditions generales, des frais de rappel ont ete ajoutes :</p>
    
    <table style="margin: 20px 0; border-collapse: collapse; width: 100%; max-width: 400px;">
        <tr style="background-color: #f5f5f5;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Facture</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">{{ object.invoice_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Montant facture</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">{{ "%.2f"|format(object.amount_due) }} EUR</td>
        </tr>
        <tr style="background-color: #fff3cd;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Frais de rappel</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">20,00 EUR</td>
        </tr>
        <tr style="background-color: #f5f5f5;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>TOTAL DU</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>{{ "%.2f"|format(object.amount_due + 20) }} EUR</strong></td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Retard</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd; color: #c0392b;"><strong>{{ object.days_overdue }} jours</strong></td>
        </tr>
    </table>
    
    <p style="background-color: #f8d7da; padding: 15px; border-left: 4px solid #dc3545;">
        <strong>DERNIER AVERTISSEMENT :</strong><br/><br/>
        Sans paiement dans les <strong>5 jours</strong> :<br/>
        - Des frais supplementaires de <strong>50 EUR</strong> seront appliques<br/>
        - Nous procederons a la <strong>rupture de votre contrat</strong> conformement a nos conditions generales
    </p>
    
    <p><strong>Coordonnees bancaires :</strong></p>
    <ul>
        <li>IBAN : BE07 7320 5208 0866 - CBC</li>
        <li>Communication : {{ object.invoice_id.payment_reference or object.invoice_id.name }}</li>
    </ul>
    
    <p>Cordialement,</p>
    <p><strong>Lolirine Garde-Meubles</strong><br/>Tel : 0497/44 41 46</p>
</div>
]]></field>
            <field name="report_template_ids" eval="[(4, ref('account.account_invoices'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- Template Mise en demeure - Frais 50 EUR + rupture contrat -->
        <record id="email_template_formal_notice" model="mail.template">
            <field name="name">Lolirine - Relance: Mise en demeure</field>
            <field name="model_id" ref="model_lolirine_invoice_reminder"/>
            <field name="subject">MISE EN DEMEURE - Facture {{ object.invoice_id.name }}</field>
            <field name="email_from">gardemeublelolirine@gmail.com</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 13px; color: #333;">
    <p><strong style="color: #c0392b; font-size: 16px;">MISE EN DEMEURE DE PAYER</strong></p>
    
    <p>{{ object.partner_id.name }},</p>
    
    <p>Malgre nos nombreux rappels restes sans effet, nous vous mettons en demeure de payer la somme suivante :</p>
    
    <table style="margin: 20px 0; border-collapse: collapse; width: 100%; max-width: 400px; border: 2px solid #c0392b;">
        <tr style="background-color: #f5f5f5;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Facture</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">{{ object.invoice_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Montant facture</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">{{ "%.2f"|format(object.amount_due) }} EUR</td>
        </tr>
        <tr style="background-color: #fff3cd;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Frais de rappel</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">20,00 EUR</td>
        </tr>
        <tr style="background-color: #f8d7da;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Frais de mise en demeure</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;">50,00 EUR</td>
        </tr>
        <tr style="background-color: #ffebee;">
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>TOTAL DU</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong style="color: #c0392b; font-size: 16px;">{{ "%.2f"|format(object.amount_due + 70) }} EUR</strong></td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Retard</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd; color: #c0392b;"><strong>{{ object.days_overdue }} jours</strong></td>
        </tr>
    </table>
    
    <p><strong>Vous disposez d'un delai de 8 jours</strong> a compter de ce jour pour proceder au paiement integral.</p>
    
    <p style="background-color: #f8d7da; padding: 15px; border-left: 4px solid #dc3545;">
        <strong>A DEFAUT DE PAIEMENT :</strong><br/><br/>
        - Votre <strong>contrat de garde-meubles sera resilie</strong> avec effet immediat<br/>
        - Les biens stockes feront l'objet d'une <strong>retention</strong> jusqu'au paiement integral<br/>
        - Le dossier sera transmis a notre <strong>service contentieux</strong> pour recouvrement judiciaire<br/>
        - Des frais supplementaires seront a votre charge
    </p>
    
    <p><strong>Coordonnees bancaires :</strong></p>
    <ul>
        <li>IBAN : BE07 7320 5208 0866 - CBC</li>
        <li>Communication : {{ object.invoice_id.payment_reference or object.invoice_id.name }}</li>
    </ul>
    
    <p>Veuillez agreer nos salutations distinguees.</p>
    <p><strong>Lolirine Garde-Meubles</strong><br/>Tel : 0497/44 41 46</p>
</div>
]]></field>
            <field name="report_template_ids" eval="[(4, ref('account.account_invoices'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
        
    </data>
</odoo>
