<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lolirine_wishlist_config_form" model="ir.ui.view">
        <field name="name">lolirine.wishlist.config.form</field>
        <field name="model">lolirine.wishlist.config</field>
        <field name="arch" type="xml">
            <form string="Configuration Wishlist Pool Store">
                <sheet>
                    <div class="row">
                        <div class="col-12 d-flex align-items-center mb-3">
                            <div>
                                <h2 class="mb-0">Wishlist – Couleurs &amp; Textes</h2>
                                <span class="text-muted">
                                    Personnalisez l'apparence de la liste de souhaits
                                    sans toucher au code.
                                </span>
                            </div>
                        </div>
                    </div>

                    <group string="Couleurs">
                        <group string="Boutons &amp; accents">
                            <field name="color_primary"
                                   widget="color"
                                   string="Couleur principale"/>
                            <field name="color_primary_hover"
                                   widget="color"
                                   string="Couleur au survol"/>
                        </group>
                        <group string="Cartes produit">
                            <field name="color_card_bg"
                                   widget="color"
                                   string="Fond des cartes"/>
                            <field name="color_card_border"
                                   widget="color"
                                   string="Bordure"/>
                            <field name="color_card_border_hover"
                                   widget="color"
                                   string="Bordure au survol"/>
                        </group>
                        <group string="Récapitulatif &amp; page">
                            <field name="color_summary_bg"
                                   widget="color"
                                   string="Fond du récapitulatif"/>
                            <field name="color_page_bg"
                                   widget="color"
                                   string="Fond de la page"/>
                        </group>
                        <group string="Indicateurs de stock">
                            <field name="color_stock_green"
                                   widget="color"
                                   string="Stock disponible"/>
                            <field name="color_stock_orange"
                                   widget="color"
                                   string="Stock limité"/>
                        </group>
                    </group>

                    <group string="Textes">
                        <group string="Page &amp; navigation">
                            <field name="text_page_title"    string="Titre de la page"/>
                            <field name="text_shipping_note" string="Note livraison"/>
                            <field name="text_expert_phone"  string="Téléphone expert"/>
                            <field name="text_contact_label" string="Label contact"/>
                        </group>
                        <group string="Boutons d'action">
                            <field name="text_add_to_cart" string="Ajouter au panier"/>
                            <field name="text_add_all"     string="Tout ajouter"/>
                            <field name="text_share"       string="Partager"/>
                        </group>
                        <group string="Statuts de stock">
                            <field name="text_in_stock"     string="En stock"/>
                            <field name="text_low_stock"    string="Stock limité"/>
                            <field name="text_out_of_stock" string="Rupture de stock"/>
                        </group>
                    </group>

                    <group string="Aperçu rapide">
                        <div class="alert alert-info">
                            Les modifications sont appliquées immédiatement
                            sur le site après sauvegarde (Cmd/Ctrl+S).
                            Rechargez la page liste de souhaits pour voir
                            les changements.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lolirine_wishlist_config" model="ir.actions.act_window">
        <field name="name">Wishlist – Personnalisation</field>
        <field name="res_model">lolirine.wishlist.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_lolirine_wishlist_config_form"/>
        <field name="target">current</field>
    </record>

    <!-- Menu sous Lolirine Notify (déjà présent) -->
    <menuitem
        id="menu_lolirine_wishlist_config"
        name="Wishlist – Personnalisation"
        parent="lolirine_pool_buypanel.menu_lolirine_notify_root"
        action="action_lolirine_wishlist_config"
        sequence="30"
        groups="base.group_system"
    />

</odoo>
