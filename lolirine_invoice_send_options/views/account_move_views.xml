<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Afficher les options d'envoi sur les factures clients -->
    <record id="view_move_form_send_options" model="ir.ui.view">
        <field name="name">account.move.form.send.options</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            
            <!-- Ajouter les options d'envoi après les conditions de paiement -->
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="auto_send_invoice" 
                       string="📧 Envoi Email"
                       widget="boolean_toggle"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="auto_send_peppol" 
                       string="🔄 Envoi Peppol"
                       widget="boolean_toggle"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            
        </field>
    </record>
    
</odoo>
