<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ajouter les champs du contrat dans le formulaire de vente/abonnement -->
    <record id="view_order_form_contract_fields" model="ir.ui.view">
        <field name="name">sale.order.form.contract.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="arch" type="xml">
            <!-- Ajouter un onglet "Contrat" -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Contrat Garde-Meubles" name="contract_info" 
                      invisible="not is_subscription">
                    <group>
                        <group string="Codes d acces">
                            <field name="contract_access_code" placeholder="Ex: 1234"/>
                            <field name="contract_forklift_code" placeholder="Ex: 5678"/>
                        </group>
                        <group string="Dates">
                            <field name="contract_signature_date"/>
                            <field name="contract_deposit_date"/>
                            <field name="contract_signature_location"/>
                        </group>
                    </group>
                    <group>
                        <group string="Montants du contrat">
                            <field name="contract_monthly_rent" readonly="1"/>
                            <field name="contract_dossier_fees" readonly="1"/>
                            <field name="contract_deposit_amount" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Ajouter un bouton "Envoyer le contrat" dans l en-tete -->
    <record id="view_order_form_contract_button" model="ir.ui.view">
        <field name="name">sale.order.form.contract.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_send_contract" 
                        type="object" 
                        string="Envoyer le contrat"
                        class="btn-secondary"
                        invisible="state != 'sale' or not is_subscription"/>
            </xpath>
        </field>
    </record>
</odoo>
