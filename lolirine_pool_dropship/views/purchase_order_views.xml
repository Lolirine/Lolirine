<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- EXTENSION FORMULAIRE BON DE COMMANDE -->
    <!-- ============================================ -->

    <record id="view_purchase_order_form_dropship" model="ir.ui.view">
        <field name="name">purchase.order.form.dropship</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Bouton pour marquer comme envoyé -->
            <xpath expr="//form/header" position="inside">
                <button name="action_mark_sent_to_supplier" type="object"
                        string="📧 Marqué envoyé au fournisseur"
                        invisible="not is_dropship_order or dropship_sent_to_supplier"
                        class="btn-primary"/>
            </xpath>

            <!-- Lien vers la commande client -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_dropship_sale" type="object"
                        class="oe_stat_button" icon="fa-shopping-cart"
                        invisible="not dropship_sale_id">
                    <span class="o_stat_text">Commande client</span>
                </button>
            </xpath>

            <!-- Infos dropship -->
            <xpath expr="//group[@name='purchase_info' or @name='technical']" position="after">
                <group string="Dropshipping" invisible="not is_dropship_order" name="dropship_po_info">
                    <group>
                        <field name="is_dropship_order" invisible="1"/>
                        <field name="dropship_sale_id" string="Commande client"/>
                        <field name="dest_address_id" string="Livraison client"/>
                    </group>
                    <group>
                        <field name="dropship_sent_to_supplier"/>
                        <field name="dropship_sent_date" invisible="not dropship_sent_to_supplier"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- VUE LISTE BC DROPSHIP -->
    <!-- ============================================ -->

    <record id="view_purchase_order_dropship_list" model="ir.ui.view">
        <field name="name">purchase.order.dropship.list</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <list string="BC Dropshipping" default_order="create_date desc"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'sent'"
                  decoration-success="state == 'purchase'">
                <field name="name" string="BC"/>
                <field name="create_date" string="Date"/>
                <field name="partner_id" string="Fournisseur"/>
                <field name="dropship_sale_id" string="Commande client"/>
                <field name="dest_address_id" string="Livraison"/>
                <field name="amount_total" string="Montant HT" sum="Total"/>
                <field name="state" string="Statut" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'purchase'"/>
                <field name="dropship_sent_to_supplier" string="Envoyé" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Action: BC Dropshipping -->
    <record id="action_purchase_order_dropship" model="ir.actions.act_window">
        <field name="name">BC Fournisseurs</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_dropship_order', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_purchase_order_dropship_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun bon de commande dropshipping
            </p>
        </field>
    </record>

</odoo>
