<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_penalite_form" model="ir.ui.view">
        <field name="name">penalite.form</field>
        <field name="model">penalite.penalite</field>
        <field name="arch" type="xml">
            <form string="Pénalité">
                <group>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="subscription_id"/>
                    <field name="product_id"/>
                    <field name="price_unit" readonly="1"/>
                    <field name="date"/>
                    <field name="invoice_id"/>
                    <field name="state"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_penalite_tree" model="ir.ui.view">
        <field name="name">penalite.tree</field>
        <field name="model">penalite.penalite</field>
        <field name="arch" type="xml">
            <tree string="Pénalités">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <field name="product_id"/>
                <field name="price_unit"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_penalite_root" name="Pénalités" sequence="10"/>
    <menuitem id="menu_penalite" name="Frais et Pénalités" parent="menu_penalite_root"/>

    <record id="action_penalite" model="ir.actions.act_window">
        <field name="name">Frais et Pénalités</field>
        <field name="res_model">penalite.penalite</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_action_penalite" name="Liste" parent="menu_penalite" action="action_penalite"/>
</odoo>
