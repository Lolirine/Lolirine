<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Bouton sur les factures fournisseurs -->
    <!-- ============================================ -->
    
    <record id="view_move_form_inherit_km_expense" model="ir.ui.view">
        <field name="name">account.move.form.inherit.km_expense</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter le bouton dans la zone des boutons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_km_trajets" type="object"
                        class="oe_stat_button" icon="fa-road"
                        invisible="km_trajet_count == 0">
                    <field name="km_trajet_count" widget="statinfo" string="Trajets"/>
                </button>
            </xpath>
            
            <!-- Ajouter le bouton "Créer trajet" après les boutons d'action -->
            <xpath expr="//header" position="inside">
                <button name="action_create_km_trajet" string="Créer trajet" 
                        type="object" class="btn-secondary"
                        invisible="move_type not in ('in_invoice', 'out_invoice')"
                        icon="fa-car"/>
            </xpath>
        </field>
    </record>

</odoo>
