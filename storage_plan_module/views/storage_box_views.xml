<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste des boxes -->
    <record id="view_storage_box_tree" model="ir.ui.view">
        <field name="name">storage.box.tree</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <list string="Boxes de stockage" decoration-success="status == 'disponible'" 
                  decoration-danger="status == 'occupe'" decoration-warning="status == 'maintenance'">
                <field name="name"/>
                <field name="floor_id"/>
                <field name="volume"/>
                <field name="surface"/>
                <field name="price_monthly"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'disponible'"
                       decoration-danger="status == 'occupe'"
                       decoration-warning="status == 'maintenance'"
                       decoration-info="status == 'reserve'"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire des boxes -->
    <record id="view_storage_box_form" model="ir.ui.view">
        <field name="name">storage.box.form</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <form string="Box de stockage">
                <header>
                    <button name="action_make_available" string="Rendre disponible" 
                            type="object" class="oe_highlight" 
                            invisible="status == 'disponible'"/>
                    <button name="action_make_occupied" string="Marquer occupé" 
                            type="object" 
                            invisible="status == 'occupe'"/>
                    <button name="action_make_maintenance" string="En maintenance" 
                            type="object" 
                            invisible="status == 'maintenance'"/>
                    <field name="status" widget="statusbar" 
                           statusbar_visible="disponible,reserve,occupe"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                        <button name="action_view_on_website" type="object" class="oe_stat_button" icon="fa-globe" string="Voir sur le site">
                        </button>
                    </div>
                    <group>
                        <group string="Informations générales">
                            <field name="name"/>
                            <field name="floor_id"/>
                            <field name="status"/>
                        </group>
                        <group string="Dimensions">
                            <field name="width"/>
                            <field name="depth"/>
                            <field name="height"/>
                            <field name="volume"/>
                            <field name="surface"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tarification">
                            <field name="price_monthly"/>
                            <field name="registration_fee"/>
                            <field name="deposit_months"/>
                            <field name="deposit_amount"/>
                        </group>
                        <group string="Position">
                            <field name="aisle" widget="radio"/>
                            <field name="grid_row"/>
                            <field name="grid_col"/>
                            <field name="position_x"/>
                            <field name="position_y"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description du box..."/>
                    </group>
                    <notebook>
                        <page string="Réservations">
                            <field name="reservation_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="customer_name"/>
                                    <field name="reservation_date"/>
                                    <field name="start_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes internes">
                            <field name="notes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue kanban des boxes -->
    <record id="view_storage_box_kanban" model="ir.ui.view">
        <field name="name">storage.box.kanban</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="floor_id"/>
                <field name="volume"/>
                <field name="price_monthly"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="floor_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="volume"/> m³ - <field name="price_monthly"/> €/mois
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="status" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue recherche des boxes -->
    <record id="view_storage_box_search" model="ir.ui.view">
        <field name="name">storage.box.search</field>
        <field name="model">storage.box</field>
        <field name="arch" type="xml">
            <search string="Recherche boxes">
                <field name="name"/>
                <field name="floor_id"/>
                <filter string="Disponible" name="available" domain="[('status', '=', 'disponible')]"/>
                <filter string="Occupé" name="occupied" domain="[('status', '=', 'occupe')]"/>
                <filter string="Maintenance" name="maintenance" domain="[('status', '=', 'maintenance')]"/>
                <separator/>
                <filter string="Rez-de-chaussée" name="ground_floor" domain="[('floor_id.code', '=', 'RDC')]"/>
                <filter string="Premier étage" name="first_floor" domain="[('floor_id.code', '=', 'R1')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Étage" name="group_floor" context="{'group_by': 'floor_id'}"/>
                    <filter string="Statut" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action pour les boxes -->
    <record id="action_storage_box" model="ir.actions.act_window">
        <field name="name">Boxes de stockage</field>
        <field name="res_model">storage.box</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>
</odoo>
