<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ============================================ -->
        <!-- ANNEXES IDENTIFICATION & ÉTATS FINANCIERS   -->
        <!-- ============================================ -->
        
        <record id="annex_balance_sheet" model="biztax.annex.registry">
            <field name="code">BILAN</field>
            <field name="name">Bilan (schéma complet ou abrégé)</field>
            <field name="name_nl">Balans (volledig of verkort schema)</field>
            <field name="category">financial</field>
            <field name="is_always_mandatory">True</field>
            <field name="mandatory_condition">Toujours obligatoire - États financiers</field>
            <field name="can_auto_generate">True</field>
            <field name="odoo_report_name">l10n_be_reports.action_account_report_be_balance_sheet</field>
            <field name="description">Bilan actif/passif selon schéma BNB</field>
        </record>
        
        <record id="annex_pnl" model="biztax.annex.registry">
            <field name="code">CPT_RES</field>
            <field name="name">Compte de résultats</field>
            <field name="name_nl">Resultatenrekening</field>
            <field name="category">financial</field>
            <field name="is_always_mandatory">True</field>
            <field name="mandatory_condition">Toujours obligatoire - États financiers</field>
            <field name="can_auto_generate">True</field>
            <field name="odoo_report_name">l10n_be_reports.action_account_report_be_pnl</field>
            <field name="description">Compte de résultats selon schéma BNB</field>
        </record>
        
        <!-- ============================================ -->
        <!-- ANNEXES DNA (DÉPENSES NON ADMISES)          -->
        <!-- ============================================ -->
        
        <record id="annex_275f" model="biztax.annex.registry">
            <field name="code">275F</field>
            <field name="name">275F - Frais de voiture</field>
            <field name="name_nl">275F - Autokosten</field>
            <field name="category">dna</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si frais de voiture avec DNA</field>
            <field name="mandatory_adjustment_category">dna_car,dna_car_co2,dna_fuel_card</field>
            <field name="can_auto_generate">False</field>
            <field name="template_url">https://finances.belgium.be/sites/default/files/275f.pdf</field>
            <field name="legal_reference">Art. 66 CIR92</field>
            <field name="description">Détail des frais de voiture et calcul DNA selon formule CO2. Inclut les cartes carburant.</field>
        </record>
        
        <record id="annex_328k" model="biztax.annex.registry">
            <field name="code">328K</field>
            <field name="name">328K - Voitures de société mises à disposition</field>
            <field name="name_nl">328K - Ter beschikking gestelde bedrijfswagens</field>
            <field name="category">dna</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si mise à disposition de véhicules</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 36 CIR92</field>
            <field name="description">Liste des véhicules mis à disposition et avantages de toute nature</field>
        </record>
        
        <record id="annex_328s" model="biztax.annex.registry">
            <field name="code">328S</field>
            <field name="name">328S - Commissions secrètes</field>
            <field name="name_nl">328S - Geheime commissielonen</field>
            <field name="category">dna</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si commissions secrètes (cotisation spéciale)</field>
            <field name="mandatory_adjustment_category">dna_secret_commission</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 219 CIR92</field>
            <field name="description">Déclaration des commissions secrètes soumises à cotisation spéciale 100% ou 50%</field>
        </record>
        
        <!-- ============================================ -->
        <!-- ANNEXES PROVISIONS                          -->
        <!-- ============================================ -->
        
        <record id="annex_275c" model="biztax.annex.registry">
            <field name="code">275C</field>
            <field name="name">275C - Provisions pour risques et charges</field>
            <field name="name_nl">275C - Voorzieningen voor risico's en kosten</field>
            <field name="category">provision</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si provisions non déductibles ou mouvement de provisions</field>
            <field name="mandatory_adjustment_category">provision,dna_provision,provision_excess</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 48 CIR92</field>
            <field name="description">Tableau des provisions constituées, utilisées, reprises. Distingue provisions déductibles (pensions, obligations légales) et non déductibles.</field>
        </record>
        
        <!-- ============================================ -->
        <!-- ANNEXES PLUS-VALUES                         -->
        <!-- ============================================ -->
        
        <record id="annex_275u" model="biztax.annex.registry">
            <field name="code">275U</field>
            <field name="name">275U - Plus-values</field>
            <field name="name_nl">275U - Meerwaarden</field>
            <field name="category">capital_gain</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si plus-values réalisées ou immunisées</field>
            <field name="mandatory_adjustment_category">capital_gain_normal,capital_gain_spread,capital_gain_exempt,capital_gain_shares</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 47, 190, 192 CIR92</field>
            <field name="description">Détail des plus-values: taxation normale, étalée (Art. 47), immunisée (Art. 192). Inclut engagement de réinvestissement.</field>
        </record>
        
        <!-- ============================================ -->
        <!-- ANNEXES DÉDUCTIONS                          -->
        <!-- ============================================ -->
        
        <record id="annex_275k" model="biztax.annex.registry">
            <field name="code">275K</field>
            <field name="name">275K - Déduction pour investissement</field>
            <field name="name_nl">275K - Investeringsaftrek</field>
            <field name="category">investment</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si déduction pour investissement revendiquée</field>
            <field name="mandatory_adjustment_category">ded_investment,ded_investment_spread</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 68-77 CIR92</field>
            <field name="description">Liste des investissements ouvrant droit à déduction (R&amp;D, brevets, économies d'énergie, etc.). Calcul de la déduction.</field>
        </record>
        
        <record id="annex_275n" model="biztax.annex.registry">
            <field name="code">275N</field>
            <field name="name">275N - Intérêts notionnels (NID/DIN)</field>
            <field name="name_nl">275N - Notionele interesten (NIA)</field>
            <field name="category">deduction</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si déduction NID revendiquée</field>
            <field name="mandatory_adjustment_category">ded_nid</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 205bis-205novies CIR92</field>
            <field name="description">Calcul du capital à risque et de la déduction NID. Inclut les éléments à déduire (participations, immeubles, etc.).</field>
        </record>
        
        <record id="annex_275w" model="biztax.annex.registry">
            <field name="code">275W</field>
            <field name="name">275W - Déduction pour innovation (revenus de brevets)</field>
            <field name="name_nl">275W - Innovatie-aftrek (octrooi-inkomsten)</field>
            <field name="category">deduction</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si déduction innovation revendiquée</field>
            <field name="mandatory_adjustment_category">ded_innovation,ded_patent</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 205/1-205/4 CIR92</field>
            <field name="description">Calcul de la déduction 85% sur revenus nets de brevets, logiciels, modèles d'utilité, certificats d'obtention végétale.</field>
        </record>
        
        <record id="annex_275p" model="biztax.annex.registry">
            <field name="code">275P</field>
            <field name="name">275P - Pertes fiscales antérieures</field>
            <field name="name_nl">275P - Vorige fiscale verliezen</field>
            <field name="category">deduction</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si déduction de pertes antérieures</field>
            <field name="mandatory_adjustment_category">ded_loss,ded_loss_foreign</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 206 CIR92</field>
            <field name="description">Suivi des pertes reportables par exercice. Application de la règle du basket (1M + 70%).</field>
        </record>
        
        <record id="annex_275rdt" model="biztax.annex.registry">
            <field name="code">275RDT</field>
            <field name="name">275RDT - Revenus définitivement taxés (RDT)</field>
            <field name="name_nl">275DBI - Definitief belaste inkomsten (DBI)</field>
            <field name="category">deduction</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si déduction RDT revendiquée</field>
            <field name="mandatory_adjustment_category">ded_rdt,ded_rdt_excess</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 202-204 CIR92</field>
            <field name="description">Liste des participations, conditions RDT (10% ou 2.5M, 1 an), calcul de la déduction.</field>
        </record>
        
        <!-- ============================================ -->
        <!-- ANNEXES VERSEMENTS ANTICIPÉS                -->
        <!-- ============================================ -->
        
        <record id="annex_275a" model="biztax.annex.registry">
            <field name="code">275A</field>
            <field name="name">275A - Versements anticipés</field>
            <field name="name_nl">275A - Voorafbetalingen</field>
            <field name="category">prepayment</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_field">prepayments > 0</field>
            <field name="mandatory_condition">Obligatoire si versements anticipés effectués</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 157-168 CIR92</field>
            <field name="description">Détail des versements anticipés par trimestre (VA1 à VA4). Calcul de la bonification.</field>
        </record>
        
        <!-- ============================================ -->
        <!-- ANNEXES INTERNATIONAL / TRANSFERT           -->
        <!-- ============================================ -->
        
        <record id="annex_275cbcr" model="biztax.annex.registry">
            <field name="code">275CbCR</field>
            <field name="name">275CbCR - Country-by-Country Reporting</field>
            <field name="name_nl">275CbCR - Landenrapport</field>
            <field name="category">international</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire pour groupes > 750M EUR CA consolidé</field>
            <field name="applicable_small">False</field>
            <field name="applicable_micro">False</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 321/1-321/7 CIR92, BEPS Action 13</field>
            <field name="description">Rapport pays par pays pour multinationales. Déclaration ou notification de l'entité déclarante.</field>
        </record>
        
        <record id="annex_275tp" model="biztax.annex.registry">
            <field name="code">275TP</field>
            <field name="name">275TP - Documentation prix de transfert</field>
            <field name="name_nl">275TP - Verrekenprijsdocumentatie</field>
            <field name="category">international</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si transactions avec parties liées significatives</field>
            <field name="applicable_micro">False</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 321/1-321/7 CIR92</field>
            <field name="description">Formulaire de déclaration des transactions avec parties liées étrangères.</field>
        </record>
        
        <!-- ============================================ -->
        <!-- ANNEXES PME                                 -->
        <!-- ============================================ -->
        
        <record id="annex_275mkb" model="biztax.annex.registry">
            <field name="code">275MKB</field>
            <field name="name">275MKB - Attestation PME (taux réduit)</field>
            <field name="name_nl">275KMO - KMO-attest (verlaagd tarief)</field>
            <field name="category">other</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire pour bénéficier du taux PME 20%</field>
            <field name="applicable_large">False</field>
            <field name="can_auto_generate">False</field>
            <field name="legal_reference">Art. 215, al. 3 CIR92</field>
            <field name="description">Attestation des critères PME: rémunération dirigeant min 45.000 EUR, pas de société financière, etc.</field>
        </record>
        
        <!-- ============================================ -->
        <!-- ANNEXES FICHES INDIVIDUELLES                -->
        <!-- ============================================ -->
        
        <record id="annex_281_50" model="biztax.annex.registry">
            <field name="code">281.50</field>
            <field name="name">281.50 - Fiches de rémunérations (administrateurs)</field>
            <field name="name_nl">281.50 - Loonfiches (bestuurders)</field>
            <field name="category">other</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si rémunérations d'administrateurs</field>
            <field name="can_auto_generate">False</field>
            <field name="description">Fiches individuelles des rémunérations versées aux administrateurs/gérants.</field>
        </record>
        
        <record id="annex_325" model="biztax.annex.registry">
            <field name="code">325</field>
            <field name="name">325 - Listing TVA clients</field>
            <field name="name_nl">325 - BTW listing klanten</field>
            <field name="category">other</field>
            <field name="is_always_mandatory">False</field>
            <field name="mandatory_condition">Obligatoire si assujetti TVA avec clients belges > 250 EUR/an</field>
            <field name="can_auto_generate">True</field>
            <field name="odoo_report_name">l10n_be_reports.action_account_report_partner_vat_listing</field>
            <field name="description">Liste annuelle des clients assujettis belges.</field>
        </record>
        
    </data>
</odoo>
