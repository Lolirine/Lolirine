<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_launch_search_wizard_form" model="ir.ui.view">
        <field name="name">pool.image.search.launch.wizard.form</field>
        <field name="model">pool.image.search.launch.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechercher images web">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>🔍 Recherche web d'images produits</strong>
                        <p>Le module va scraper les sites fournisseurs et marques pour
                        trouver jusqu'à <field name="max_candidates_per_product" nolabel="1"
                        class="oe_inline" readonly="1"/> images par produit, puis te proposer
                        une validation kanban.</p>
                    </div>

                    <group>
                        <group string="Cible">
                            <field name="name"/>
                            <field name="product_count" readonly="1"/>
                            <field name="only_missing_image"/>
                            <field name="only_catalog_imported"/>
                        </group>
                        <group string="Configuration">
                            <field name="max_candidates_per_product"/>
                            <field name="auto_validate_threshold"/>
                            <field name="max_image_size"/>
                            <field name="run_mode"/>
                        </group>
                    </group>

                    <group string="Post-traitement">
                        <field name="enable_bg_removal"/>
                        <field name="enable_webp"/>
                        <field name="enable_phash_dedup"/>
                    </group>

                    <field name="product_ids" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_launch" type="object"
                            string="🚀 Lancer la recherche" class="btn-primary"/>
                    <button special="cancel" string="Annuler" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action serveur "Rechercher images web" sur product.template -->
    <record id="action_launch_image_search_from_products" model="ir.actions.act_window">
        <field name="name">Rechercher images web</field>
        <field name="res_model">pool.image.search.launch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="context">{'default_product_ids': [(6, 0, active_ids)]}</field>
    </record>

</odoo>
