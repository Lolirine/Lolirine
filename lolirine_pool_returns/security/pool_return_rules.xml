<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_pool_return_portal" model="ir.rule">
        <field name="name">Retours : le client ne voit que les siens</field>
        <field name="model_id" ref="model_pool_return"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_pool_return_line_portal" model="ir.rule">
        <field name="name">Lignes de retour : le client ne voit que les siennes</field>
        <field name="model_id" ref="model_pool_return_line"/>
        <field name="domain_force">[('return_id.partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_pool_return_company" model="ir.rule">
        <field name="name">Retours : sociétés autorisées</field>
        <field name="model_id" ref="model_pool_return"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
