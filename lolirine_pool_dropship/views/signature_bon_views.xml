<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bon fournisseur : onglet « ✍ Signature » -->
    <record id="view_purchase_order_form_signature" model="ir.ui.view">
        <field name="name">purchase.order.form.pool.signature</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="✍ Signature" name="pool_signature">
                    <div class="text-muted small mb-2">Signe le bon ici (souris, doigt ou stylet) : la signature est imprimée
                        en bas du bon de commande PDF envoyé au fournisseur. Pour la refaire, efface-la puis signe à nouveau.</div>
                    <group>
                        <group>
                            <field name="pool_signe_par" placeholder="Nom du signataire"/>
                            <field name="pool_signe_le"/>
                        </group>
                        <group>
                            <field name="pool_signature" widget="signature" nolabel="1" colspan="2"
                                   options="{'full_name': 'pool_signe_par', 'size': [400, 150]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- PDF du bon de commande / de la demande de prix : bloc de signature -->
    <template id="report_purchaseorder_document_signature" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='o.payment_term_id']" position="after">
            <div t-if="o.pool_signature" class="row mt-4" style="page-break-inside: avoid;">
                <div class="col-6 offset-6 text-center">
                    <div>Pour <t t-out="o.company_id.name"/>,</div>
                    <img t-att-src="image_data_uri(o.pool_signature)" style="max-height: 4cm; max-width: 8cm;"/>
                    <div><strong t-out="o.pool_signe_par"/></div>
                    <div t-if="o.pool_signe_le" class="small text-muted">Signé le <t t-out="o.pool_signe_le" t-options="{'widget': 'date'}"/></div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
