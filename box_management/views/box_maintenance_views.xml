<odoo>
    <record id="view_box_maintenance_form" model="ir.ui.view">
        <field name="name">box.maintenance.form</field>
        <field name="model">box.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Box">
                <group>
                    <field name="box_name"/>
                    <field name="date"/>
                    <field name="type"/>
                    <field name="notes"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_box_maintenance_tree" model="ir.ui.view">
        <field name="name">box.maintenance.tree</field>
        <field name="model">box.maintenance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="box_name"/>
                <field name="date"/>
                <field name="type"/>
            </tree>
        </field>
    </record>

    <record id="action_box_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">box.maintenance</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
