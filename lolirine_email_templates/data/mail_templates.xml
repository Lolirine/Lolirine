<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- ============================================= -->
        <!-- TEMPLATE EMAIL - FACTURE MENSUELLE -->
        <!-- ============================================= -->
        <record id="email_template_facture_mensuelle" model="mail.template">
            <field name="name">Lolirine - Facture mensuelle</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="email_from">gardemeublelolirine@gmail.com</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="subject">Envoi de votre facture mensuelle - Garde-meubles Lolirine - {{ object.name }}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333; line-height: 1.6;">
    <p>Bonjour {{ object.partner_id.name }},</p>
    
    <p>Veuillez trouver en pièce jointe votre facture mensuelle relative à la location de votre box au sein de notre site Lolirine.</p>
    
    <p>Cette facture correspond à la période de location en cours et reprend le détail des prestations facturées, conformément aux conditions prévues dans votre contrat de garde-meubles. Nous vous invitons à en prendre connaissance et à procéder au règlement selon les modalités indiquées sur le document.</p>
    
    <p>Sauf disposition contraire, le paiement est attendu à la date d'échéance mentionnée sur la facture. En cas de retard de paiement, des pénalités pourront être appliquées conformément aux conditions contractuelles.</p>
    
    <table style="margin: 20px 0; border-collapse: collapse; width: 100%; max-width: 450px;">
        <tr style="background-color: #f8f9fa;">
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold; width: 40%;">Numéro de facture</td>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold;">Date de facturation</td>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6;">{{ object.invoice_date }}</td>
        </tr>
        <tr style="background-color: #f8f9fa;">
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold;">Date d'échéance</td>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6;">{{ object.invoice_date_due }}</td>
        </tr>
        <tr>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold;">Montant total</td>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold; color: #28a745;">{{ '%.2f'|format(object.amount_total) }} EUR</td>
        </tr>
    </table>
    
    <p><strong>Modalités de paiement :</strong></p>
    <ul style="margin: 10px 0; padding-left: 20px;">
        <li style="margin-bottom: 8px;">Communication structurée : <strong>{{ object.payment_reference or object.name }}</strong></li>
        <li style="margin-bottom: 8px;">Compte bancaire : <strong>BE07 7320 5208 0866 - CBC</strong></li>
    </ul>
    
    <p>Pour toute question concernant cette facture, votre contrat ou les modalités de paiement, vous pouvez nous contacter :</p>
    <ul style="margin: 10px 0; padding-left: 20px;">
        <li style="margin-bottom: 5px;">Email : <a href="mailto:gardemeublelolirine@gmail.com" style="color: #007bff;">gardemeublelolirine@gmail.com</a></li>
        <li style="margin-bottom: 5px;">Téléphone : 0497/44 41 46 ou 0498/52 11 31</li>
    </ul>
    
    <p>Nous vous remercions de votre confiance et restons à votre disposition.</p>
    
    <p>Cordialement,</p>
    
    <div style="margin-top: 25px; padding-top: 15px; border-top: 1px solid #dee2e6;">
        <p style="margin: 0;">
            <strong style="color: #495057;">Lolirine Garde-Meubles</strong><br/>
            <span style="color: #6c757d;">Feron Rodney</span><br/>
            <span style="color: #6c757d;">Tél. : 0497/44 41 46 - 0498/52 11 31</span><br/>
            <span style="color: #6c757d;">Email : <a href="mailto:gardemeublelolirine@gmail.com" style="color: #007bff;">gardemeublelolirine@gmail.com</a></span>
        </p>
    </div>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('account.account_invoices'))]"/>
            <field name="lang">{{ object.partner_id.lang or 'fr_BE' }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- ============================================= -->
        <!-- TEMPLATE EMAIL - RAPPEL DE PAIEMENT -->
        <!-- ============================================= -->
        <record id="email_template_rappel_paiement" model="mail.template">
            <field name="name">Lolirine - Rappel de paiement</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="email_from">gardemeublelolirine@gmail.com</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="subject">Rappel : Facture {{ object.name }} en attente de paiement - Garde-meubles Lolirine</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333; line-height: 1.6;">
    <p>Bonjour {{ object.partner_id.name }},</p>
    
    <p>Nous nous permettons de vous contacter concernant la facture mentionnée ci-dessous, qui reste à ce jour impayée :</p>
    
    <table style="margin: 20px 0; border-collapse: collapse; width: 100%; max-width: 450px;">
        <tr style="background-color: #fff3cd;">
            <td style="padding: 12px 15px; border: 1px solid #ffc107; font-weight: bold; width: 40%;">Numéro de facture</td>
            <td style="padding: 12px 15px; border: 1px solid #ffc107;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold;">Date d'échéance</td>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; color: #dc3545; font-weight: bold;">{{ object.invoice_date_due }}</td>
        </tr>
        <tr style="background-color: #f8f9fa;">
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold;">Montant dû</td>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold; color: #dc3545;">{{ '%.2f'|format(object.amount_residual) }} EUR</td>
        </tr>
    </table>
    
    <p>Si vous avez déjà procédé au règlement, nous vous prions de ne pas tenir compte de ce message.</p>
    
    <p>Dans le cas contraire, nous vous serions reconnaissants de bien vouloir régulariser cette situation dans les meilleurs délais :</p>
    
    <ul style="margin: 10px 0; padding-left: 20px;">
        <li style="margin-bottom: 8px;">Communication structurée : <strong>{{ object.payment_reference or object.name }}</strong></li>
        <li style="margin-bottom: 8px;">Compte bancaire : <strong>BE07 7320 5208 0866 - CBC</strong></li>
    </ul>
    
    <p>Pour toute question ou si vous rencontrez des difficultés de paiement, n'hésitez pas à nous contacter.</p>
    
    <p>Cordialement,</p>
    
    <div style="margin-top: 25px; padding-top: 15px; border-top: 1px solid #dee2e6;">
        <p style="margin: 0;">
            <strong style="color: #495057;">Lolirine Garde-Meubles</strong><br/>
            <span style="color: #6c757d;">Feron Rodney</span><br/>
            <span style="color: #6c757d;">Tél. : 0497/44 41 46 - 0498/52 11 31</span><br/>
            <span style="color: #6c757d;">Email : <a href="mailto:gardemeublelolirine@gmail.com" style="color: #007bff;">gardemeublelolirine@gmail.com</a></span>
        </p>
    </div>
</div>
            </field>
            <field name="lang">{{ object.partner_id.lang or 'fr_BE' }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- ============================================= -->
        <!-- TEMPLATE EMAIL - CONFIRMATION PAIEMENT -->
        <!-- ============================================= -->
        <record id="email_template_confirmation_paiement" model="mail.template">
            <field name="name">Lolirine - Confirmation de paiement</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="email_from">gardemeublelolirine@gmail.com</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="subject">Confirmation de paiement - Facture {{ object.name }} - Garde-meubles Lolirine</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333; line-height: 1.6;">
    <p>Bonjour {{ object.partner_id.name }},</p>
    
    <p>Nous avons le plaisir de vous confirmer la bonne réception de votre paiement concernant :</p>
    
    <table style="margin: 20px 0; border-collapse: collapse; width: 100%; max-width: 450px;">
        <tr style="background-color: #d4edda;">
            <td style="padding: 12px 15px; border: 1px solid #28a745; font-weight: bold; width: 40%;">Numéro de facture</td>
            <td style="padding: 12px 15px; border: 1px solid #28a745;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold;">Montant reçu</td>
            <td style="padding: 12px 15px; border: 1px solid #dee2e6; font-weight: bold; color: #28a745;">{{ '%.2f'|format(object.amount_total) }} EUR</td>
        </tr>
    </table>
    
    <p>Votre facture est désormais soldée. Nous vous remercions pour votre confiance et votre ponctualité.</p>
    
    <p>Cordialement,</p>
    
    <div style="margin-top: 25px; padding-top: 15px; border-top: 1px solid #dee2e6;">
        <p style="margin: 0;">
            <strong style="color: #495057;">Lolirine Garde-Meubles</strong><br/>
            <span style="color: #6c757d;">Feron Rodney</span><br/>
            <span style="color: #6c757d;">Tél. : 0497/44 41 46 - 0498/52 11 31</span><br/>
            <span style="color: #6c757d;">Email : <a href="mailto:gardemeublelolirine@gmail.com" style="color: #007bff;">gardemeublelolirine@gmail.com</a></span>
        </p>
    </div>
</div>
            </field>
            <field name="lang">{{ object.partner_id.lang or 'fr_BE' }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
        
    </data>
</odoo>
