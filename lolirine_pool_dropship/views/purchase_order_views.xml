<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ============================================ -->
    <!-- PURCHASE ORDER - EXTENSION -->
    <!-- ============================================ -->

    <record id="view_purchase_order_form_dropship" model="ir.ui.view">
        <field name="name">purchase.order.form.dropship</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Bouton vers la commande client -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_pool_factures_client" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not dropship_sale_id">
                    <field name="pool_client_invoice_count" widget="statinfo" string="Facture client"/>
                </button>
                <button name="action_pool_autres_bons" type="object"
                        class="oe_stat_button" icon="fa-files-o"
                        invisible="not pool_autres_bc_count">
                    <field name="pool_autres_bc_count" widget="statinfo" string="Autres bons"/>
                </button>
                <button name="action_pool_marge_analytique" type="object"
                        class="oe_stat_button" icon="fa-line-chart"
                        invisible="not dropship_sale_id">
                    <span class="o_stat_text">Marge</span>
                </button>
                <button name="action_pool_ouvrir_suivi" type="object"
                        class="oe_stat_button" icon="fa-map-marker"
                        invisible="not pool_tracking_url">
                    <span class="o_stat_text">Suivre le colis</span>
                </button>
                <button name="action_pool_catalogues" type="object"
                        class="oe_stat_button" icon="fa-book">
                    <span class="o_stat_text">Catalogues</span>
                </button>
            </xpath>

            <!-- Bandeaux : paiement client, retard, marge -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="dropship_sale_id" invisible="1"/>
                <field name="pool_client_paye" invisible="1"/>
                <field name="pool_en_retard" invisible="1"/>
                <field name="pool_tracking_url" invisible="1"/>
                <div class="alert alert-danger py-2 mb-2" role="alert"
                     invisible="not is_dropship_order or not dropship_sale_id or pool_client_paye">
                    <i class="fa fa-exclamation-triangle" title="Client non payé"/>
                    <strong> Client non payé</strong> — <field name="pool_paiement_txt" readonly="1" class="d-inline"/>.
                    Ne pas envoyer le bon avant le paiement.
                </div>
                <div class="alert alert-warning py-2 mb-2" role="alert" invisible="not pool_en_retard">
                    <i class="fa fa-clock-o" title="Retard"/>
                    <strong> En retard</strong> — <field name="pool_retard_txt" readonly="1" class="d-inline"/>
                </div>
                <div class="alert alert-light border py-2 mb-3" role="status" invisible="not dropship_sale_id">
                    <span class="me-3">Vente HT <strong><field name="pool_vente_ht" readonly="1" class="d-inline"/></strong></span>
                    <span class="me-3">Achats HT <strong><field name="pool_achats_ht" readonly="1" class="d-inline"/></strong></span>
                    <span class="me-3" invisible="not pool_port_estime">Port fournisseur estimé <strong><field name="pool_port_estime" readonly="1" class="d-inline"/></strong></span>
                    <span class="me-3">Marge prévue <strong><field name="pool_marge" readonly="1" class="d-inline"/></strong>
                        (<field name="pool_marge_pct" readonly="1" digits="[16,1]" class="d-inline"/> %)</span>
                    <span invisible="not pool_marge_reelle_ok">Marge réelle <strong><field name="pool_marge_reelle" readonly="1" class="d-inline"/></strong></span>
                    <field name="pool_marge_reelle_ok" invisible="1"/>
                </div>
                <div class="alert alert-light border py-2 mb-3" role="status" invisible="not pool_commerciaux_html">
                    <i class="fa fa-user-circle-o me-1" title="Commercial"/><span class="me-2">Commercial :</span>
                    <field name="pool_commerciaux_html" readonly="1" nolabel="1" class="d-inline-block align-top"/>
                    <button name="action_pool_ecrire_commercial" type="object" class="btn btn-link p-0 ms-2"
                            icon="fa-pencil-square-o" string="Écrire depuis Odoo"/>
                </div>
            </xpath>
            
            <!-- Colonne « Remise » visible par défaut (prix catalogue − remise = net) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="string">Remise %</attribute>
            </xpath>

            <!-- Badge dropship -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_dropship_order" invisible="1"/>
                <span class="badge rounded-pill text-bg-warning me-2" 
                      invisible="not is_dropship_order">
                    <i class="fa fa-truck"/> Dropship
                </span>
            </xpath>
            
            <!-- Actions dropship -->
            <xpath expr="//header" position="inside">
                <button name="action_send_dropship_email" type="object"
                        string="📧 Envoyer au fournisseur" class="btn-warning"
                        invisible="not is_dropship_order or email_sent or state == 'draft'"
                        confirm="Voulez-vous envoyer cette commande au fournisseur par email ?"/>
                <button name="action_pool_envoyer_quand_meme" type="object"
                        string="Envoyer quand même" class="btn-outline-danger"
                        invisible="not is_dropship_order or email_sent or not dropship_sale_id or pool_client_paye"
                        confirm="Le client n'a pas payé. Envoyer quand même le bon au fournisseur ?"/>
                <button name="action_mark_shipped" type="object"
                        string="Marquer expédié" class="btn-primary"
                        invisible="not is_dropship_order or dropship_status not in ('sent', 'confirmed')"/>
                <button name="action_mark_delivered" type="object"
                        string="Marquer livré" class="btn-success"
                        invisible="not is_dropship_order or dropship_status != 'shipped'"/>
                <button name="action_update_tracking" type="object"
                        string="Mettre à jour suivi" class="btn-secondary"
                        invisible="not is_dropship_order"/>
                <button name="action_report_issue" type="object"
                        string="Signaler problème" class="btn-danger"
                        invisible="not is_dropship_order"/>
            </xpath>
            
            <!-- Onglet Dropshipping -->
            <xpath expr="//notebook" position="inside">
                <page string="Dropshipping" name="dropshipping" invisible="not is_dropship_order">
                    <group>
                        <group string="Statut &amp; suivi du colis">
                            <field name="dropship_status" widget="badge"
                                   decoration-info="dropship_status == 'draft'"
                                   decoration-warning="dropship_status in ('sent', 'confirmed')"
                                   decoration-success="dropship_status in ('shipped', 'delivered')"
                                   decoration-danger="dropship_status == 'issue'"/>
                            <field name="dropship_carrier"/>
                            <field name="dropship_tracking_number"
                                   help="Dès qu'un numéro est saisi, le bon passe « Expédié » et le client reçoit un e-mail avec le lien de suivi."/>
                            <field name="pool_tracking_url" widget="url" invisible="not pool_tracking_url"/>
                            <field name="dropship_expected_delivery"/>
                            <field name="dropship_shipped_date"/>
                            <field name="dropship_delivered_date"/>
                        </group>
                        <group string="Fournisseur">
                            <field name="supplier_order_ref" string="N° de commande chez le fournisseur"/>
                            <field name="last_sent_date"/>
                            <field name="email_sent" widget="boolean_toggle" readonly="1"/>
                            <field name="send_email_on_confirm" widget="boolean_toggle"
                                   invisible="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Facture fournisseur">
                            <field name="pool_facture_etat" widget="badge"
                                   decoration-muted="pool_facture_etat == 'attente'"
                                   decoration-success="pool_facture_etat == 'conforme'"
                                   decoration-danger="pool_facture_etat == 'ecart'"/>
                            <field name="pool_facture_ecart" invisible="pool_facture_etat != 'ecart'"/>
                        </group>
                        <group string="Coûts &amp; marge de la commande">
                            <field name="pool_paiement_txt" string="Paiement client" invisible="not dropship_sale_id"/>
                            <field name="pool_port_detail" string="Port fournisseur estimé" invisible="not pool_port_detail"/>
                            <field name="pool_marge_reelle" invisible="not pool_marge_reelle_ok"/>
                        </group>
                    </group>
                </page>
            </xpath>
            
        </field>
    </record>

    <!-- Vue liste -->
    <record id="view_purchase_order_tree_dropship" model="ir.ui.view">
        <field name="name">purchase.order.list.dropship</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">pool_en_retard</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_dropship_order" column_invisible="1"/>
                <field name="dropship_status" optional="show"
                       decoration-info="dropship_status == 'draft'"
                       decoration-warning="dropship_status in ('sent', 'confirmed')"
                       decoration-success="dropship_status in ('shipped', 'delivered')"
                       decoration-danger="dropship_status == 'issue'"/>
                <field name="dropship_tracking_number" optional="hide"/>
                <field name="pool_en_retard" column_invisible="1"/>
                <field name="pool_facture_etat" optional="show" widget="badge"
                       decoration-success="pool_facture_etat == 'conforme'"
                       decoration-danger="pool_facture_etat == 'ecart'"/>
            </xpath>
        </field>
    </record>

    <!-- Recherche -->
    <record id="view_purchase_order_search_dropship" model="ir.ui.view">
        <field name="name">purchase.order.search.dropship</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Dropshipping" name="dropship" 
                        domain="[('is_dropship_order', '=', True)]"/>
                <filter string="Envoyées" name="dropship_sent" 
                        domain="[('is_dropship_order', '=', True), ('dropship_status', '=', 'sent')]"/>
                <filter string="Expédiées" name="dropship_shipped" 
                        domain="[('is_dropship_order', '=', True), ('dropship_status', '=', 'shipped')]"/>
                <filter string="Problèmes" name="dropship_issues" 
                        domain="[('is_dropship_order', '=', True), ('dropship_status', '=', 'issue')]"/>
            </xpath>
        </field>
    </record>

    <!-- Action pour les BC dropshipping -->
    <record id="action_purchase_order_dropship" model="ir.actions.act_window">
        <field name="name">BC Dropshipping</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="domain">[('is_dropship_order', '=', True)]</field>
        <field name="context">{'search_default_dropship': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune commande fournisseur dropshipping
            </p>
        </field>
    </record>

</data>
</odoo>
