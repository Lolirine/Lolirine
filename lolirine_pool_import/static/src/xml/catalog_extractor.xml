<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="lolirine_pool_import.CatalogExtractorView">
        <div class="o_pool_catalog_extractor h-100 d-flex flex-column">
            <!-- Header -->
            <div class="o_pool_header bg-white border-bottom p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">
                        <i class="fa fa-book me-2 text-primary"/>
                        Extracteur de Catalogue
                    </h2>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary" t-on-click="openCatalogList">
                            <i class="fa fa-list me-1"/>
                            Voir les catalogues
                        </button>
                        <button class="btn btn-primary" t-on-click="importAllItems" 
                                t-att-disabled="state.items.length === 0 || state.loading">
                            <i class="fa fa-download me-1"/>
                            Importer (<t t-esc="state.items.length"/> produits)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Main Content - Split View -->
            <div class="o_pool_content flex-grow-1 d-flex overflow-hidden">
                
                <!-- Left Panel - Catalog Viewer -->
                <div class="o_pool_viewer_panel border-end" style="width: 55%; min-width: 400px;">
                    <!-- Toolbar -->
                    <div class="o_pool_viewer_toolbar bg-light border-bottom p-2 d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm" style="width: 150px;" 
                                t-on-change="onSupplierChange">
                            <t t-foreach="state.suppliers" t-as="supplier" t-key="supplier.id">
                                <option t-att-value="supplier.id" 
                                        t-att-selected="state.selectedSupplier?.id === supplier.id">
                                    <t t-esc="supplier.name"/>
                                </option>
                            </t>
                        </select>
                        
                        <input type="text" class="form-control form-control-sm flex-grow-1" 
                               placeholder="URL du catalogue..."
                               t-att-value="state.catalogUrl"
                               t-on-change="onCatalogUrlChange"/>
                        
                        <button class="btn btn-sm btn-primary" t-on-click="loadCatalog">
                            <i class="fa fa-refresh"/>
                        </button>
                        
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="previousPage">
                                <i class="fa fa-chevron-left"/>
                            </button>
                            <span class="btn btn-sm btn-outline-secondary disabled">
                                <t t-esc="state.currentPage"/> / <t t-esc="state.totalPages"/>
                            </span>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="nextPage">
                                <i class="fa fa-chevron-right"/>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Iframe Viewer -->
                    <div class="o_pool_viewer_frame h-100 bg-secondary">
                        <t t-if="state.catalogUrl">
                            <iframe id="catalog-viewer-iframe"
                                    t-att-src="state.catalogUrl"
                                    class="w-100 h-100 border-0"
                                    sandbox="allow-same-origin allow-scripts allow-popups allow-forms"/>
                        </t>
                        <t t-else="">
                            <div class="d-flex align-items-center justify-content-center h-100 text-white">
                                <div class="text-center">
                                    <i class="fa fa-book fa-4x mb-3 opacity-50"/>
                                    <p>Sélectionnez un fournisseur ou entrez une URL de catalogue</p>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Right Panel - Form & Items -->
                <div class="o_pool_form_panel flex-grow-1 d-flex flex-column overflow-hidden">
                    
                    <!-- Tabs -->
                    <ul class="nav nav-tabs px-3 pt-2 bg-white">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#tab-form">
                                <i class="fa fa-edit me-1"/>
                                Formulaire
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#tab-items">
                                <i class="fa fa-list me-1"/>
                                Produits (<t t-esc="state.items.length"/>)
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content flex-grow-1 overflow-auto">
                        
                        <!-- Tab Form -->
                        <div class="tab-pane fade show active p-3" id="tab-form">
                            
                            <!-- Section OCR -->
                            <div class="card mb-3 border-info">
                                <div class="card-header bg-info text-white">
                                    <i class="fa fa-magic me-2"/>
                                    Extraction IA (OCR)
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-2">
                                        Prenez une capture d'écran d'une section du catalogue, téléchargez-la ici, et laissez l'IA remplir les champs pour vous.
                                    </p>
                                    <div class="d-flex gap-2 align-items-end">
                                        <div class="flex-grow-1">
                                            <input type="file" 
                                                   class="form-control form-control-sm" 
                                                   accept="image/*"
                                                   t-on-change="onOcrFileChange"
                                                   id="ocr-file-input"/>
                                        </div>
                                        <button class="btn btn-info btn-sm" 
                                                t-on-click="extractWithOcr"
                                                t-att-disabled="!state.ocrFile || state.ocrLoading">
                                            <t t-if="state.ocrLoading">
                                                <i class="fa fa-spinner fa-spin me-1"/>
                                                Extraction...
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-magic me-1"/>
                                                Extraire
                                            </t>
                                        </button>
                                    </div>
                                    <t t-if="state.ocrPreview">
                                        <div class="mt-2">
                                            <img t-att-src="state.ocrPreview" 
                                                 class="img-thumbnail" 
                                                 style="max-height: 100px;"/>
                                        </div>
                                    </t>
                                    <t t-if="state.ocrError">
                                        <div class="alert alert-danger mt-2 mb-0 py-1 small">
                                            <t t-esc="state.ocrError"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <i class="fa fa-plus-circle me-2"/>
                                    Ajouter un Produit
                                </div>
                                <div class="card-body">
                                    <!-- Référence et Nom -->
                                    <div class="row mb-3">
                                        <div class="col-4">
                                            <label class="form-label">Référence *</label>
                                            <input type="text" class="form-control" 
                                                   t-att-value="state.formData.supplier_ref"
                                                   t-on-input="(ev) => this.onFormFieldChange('supplier_ref', ev)"
                                                   placeholder="REF-001"/>
                                        </div>
                                        <div class="col-8">
                                            <label class="form-label">Nom du produit *</label>
                                            <input type="text" class="form-control"
                                                   t-att-value="state.formData.name"
                                                   t-on-input="(ev) => this.onFormFieldChange('name', ev)"
                                                   placeholder="Nom du produit"/>
                                        </div>
                                    </div>

                                    <!-- Marque et Catégorie -->
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <label class="form-label">Marque</label>
                                            <input type="text" class="form-control"
                                                   t-att-value="state.formData.brand"
                                                   t-on-input="(ev) => this.onFormFieldChange('brand', ev)"
                                                   placeholder="Astral, Hayward..."/>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Catégorie</label>
                                            <input type="text" class="form-control"
                                                   t-att-value="state.formData.category"
                                                   t-on-input="(ev) => this.onFormFieldChange('category', ev)"
                                                   placeholder="Filtration, Pompes..."/>
                                        </div>
                                    </div>

                                    <!-- Prix -->
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <label class="form-label">Prix d'achat HT</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" step="0.01"
                                                       t-att-value="state.formData.purchase_price"
                                                       t-on-input="(ev) => this.onPriceChange('purchase_price', ev)"/>
                                                <span class="input-group-text">€</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Prix de vente HT</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" step="0.01"
                                                       t-att-value="state.formData.selling_price"
                                                       t-on-input="(ev) => this.onPriceChange('selling_price', ev)"/>
                                                <span class="input-group-text">€</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Description FR -->
                                    <div class="mb-3">
                                        <label class="form-label">Description FR</label>
                                        <textarea class="form-control" rows="2"
                                                  t-att-value="state.formData.description_fr"
                                                  t-on-input="(ev) => this.onFormFieldChange('description_fr', ev)"
                                                  placeholder="Description en français..."/>
                                    </div>

                                    <!-- Description NL -->
                                    <div class="mb-3">
                                        <label class="form-label">Description NL</label>
                                        <textarea class="form-control" rows="2"
                                                  t-att-value="state.formData.description_nl"
                                                  t-on-input="(ev) => this.onFormFieldChange('description_nl', ev)"
                                                  placeholder="Beschrijving in het Nederlands..."/>
                                    </div>

                                    <!-- Buttons -->
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-primary flex-grow-1" 
                                                t-on-click="addProduct"
                                                t-att-disabled="state.loading">
                                            <t t-if="state.loading">
                                                <i class="fa fa-spinner fa-spin me-1"/>
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-plus me-1"/>
                                            </t>
                                            Ajouter (Ctrl+Enter)
                                        </button>
                                        <button class="btn btn-outline-secondary" t-on-click="resetForm">
                                            <i class="fa fa-eraser"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab Items -->
                        <div class="tab-pane fade p-3" id="tab-items">
                            <t t-if="state.items.length === 0">
                                <div class="text-center text-muted py-5">
                                    <i class="fa fa-inbox fa-3x mb-3"/>
                                    <p>Aucun produit ajouté</p>
                                    <p class="small">Utilisez le formulaire pour ajouter des produits</p>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Réf.</th>
                                                <th>Nom</th>
                                                <th>Marque</th>
                                                <th class="text-end">Prix achat</th>
                                                <th class="text-end">Prix vente</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.items" t-as="item" t-key="item.id">
                                                <tr t-on-click="() => this.selectItem(item)"
                                                    t-att-class="{'table-active': state.selectedItem?.id === item.id}">
                                                    <td><t t-esc="item.supplier_ref"/></td>
                                                    <td><t t-esc="item.name"/></td>
                                                    <td><t t-esc="item.brand"/></td>
                                                    <td class="text-end"><t t-esc="item.purchase_price.toFixed(2)"/> €</td>
                                                    <td class="text-end"><t t-esc="item.selling_price.toFixed(2)"/> €</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-danger"
                                                                t-on-click.stop="() => this.deleteItem(item)">
                                                            <i class="fa fa-trash"/>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
