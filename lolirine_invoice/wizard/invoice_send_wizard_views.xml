<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire du wizard d'envoi -->
    <record id="lolirine_invoice_send_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.invoice.send.wizard.form</field>
        <field name="model">lolirine.invoice.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Envoyer la facture">
                <group>
                    <group string="Facture">
                        <field name="invoice_id" readonly="1"/>
                        <field name="partner_id"/>
                    </group>
                    <group string="Envoi">
                        <field name="send_method"/>
                        <field name="email" invisible="send_method == 'peppol'"/>
                        <field name="include_attachment" invisible="send_method == 'peppol'"/>
                        <field name="peppol_available" invisible="1"/>
                        <field name="peppol_endpoint" invisible="send_method == 'email'" readonly="1"/>
                    </group>
                </group>
                
                <div class="alert alert-info" role="alert" invisible="send_method != 'peppol' or peppol_available">
                    <strong>Information:</strong> L'envoi Peppol n'est pas configure pour ce client.
                    Veuillez d'abord configurer l'endpoint Peppol dans la fiche client.
                </div>
                
                <footer>
                    <button name="action_preview" string="Apercu" type="object" class="btn-secondary" icon="fa-eye"/>
                    <button name="action_send_and_close" string="Envoyer" type="object" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
