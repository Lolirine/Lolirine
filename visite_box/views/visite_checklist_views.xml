<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire template check-list -->
    <record id="visite_checklist_template_view_form" model="ir.ui.view">
        <field name="name">visite.checklist.template.view.form</field>
        <field name="model">visite.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Modèle de check-list">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Éléments">
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="is_required"/>
                                    <field name="help_text"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste template check-list -->
    <record id="visite_checklist_template_view_tree" model="ir.ui.view">
        <field name="name">visite.checklist.template.view.tree</field>
        <field name="model">visite.checklist.template</field>
        <field name="arch" type="xml">
            <tree string="Modèles de check-list">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_default"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Action template check-list -->
    <record id="visite_checklist_template_action" model="ir.actions.act_window">
        <field name="name">Modèles de check-list</field>
        <field name="res_model">visite.checklist.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Vue formulaire objection -->
    <record id="visite_objection_view_form" model="ir.ui.view">
        <field name="name">visite.objection.view.form</field>
        <field name="model">visite.objection</field>
        <field name="arch" type="xml">
            <form string="Objection">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <separator string="Réponse suggérée"/>
                    <field name="reponse_suggeree"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste objection -->
    <record id="visite_objection_view_tree" model="ir.ui.view">
        <field name="name">visite.objection.view.tree</field>
        <field name="model">visite.objection</field>
        <field name="arch" type="xml">
            <tree string="Objections">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="reponse_suggeree"/>
            </tree>
        </field>
    </record>

    <!-- Action objections -->
    <record id="visite_objection_action" model="ir.actions.act_window">
        <field name="name">Objections fréquentes</field>
        <field name="res_model">visite.objection</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
