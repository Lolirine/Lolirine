<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_specs" model="ir.ui.view">
        <field name="name">product.template.specs.techniques</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_description']" position="after">
                <field name="x_specs_techniques"
                       placeholder="Caractéristiques techniques affichées sous la description sur le site..."/>
            </xpath>
        </field>
    </record>
</odoo>
