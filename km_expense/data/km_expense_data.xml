<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence pour les trajets -->
        <record id="seq_km_trajet" model="ir.sequence">
            <field name="name">Trajet Kilometrique</field>
            <field name="code">km.trajet</field>
            <field name="prefix">TRJ/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Produit pour les notes de frais -->
        <record id="product_indemnite_km" model="product.product">
            <field name="name">Indemnite Kilometrique</field>
            <field name="default_code">IK</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="uom_id" ref="uom.product_uom_km"/>
            <field name="uom_po_id" ref="uom.product_uom_km"/>
            <field name="can_be_expensed" eval="True"/>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="description">Indemnite kilometrique pour deplacements professionnels</field>
        </record>

        <!-- 
        Les categories de trajets sont creees automatiquement
        via l'interface ou peuvent etre ajoutees manuellement.
        
        Configuration API Google :
        La cle API doit etre configuree via Configuration > Parametres > Indemnites Kilometriques
        -->

    </data>
</odoo>
