<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ============================================ -->
    <!-- SUPPLIER DROPSHIP INFO -->
    <!-- ============================================ -->

    <!-- Form View -->
    <record id="view_supplier_dropship_info_form" model="ir.ui.view">
        <field name="name">supplier.dropship.info.form</field>
        <field name="model">supplier.dropship.info</field>
        <field name="arch" type="xml">
            <form string="Fournisseur Dropshipping">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="update_reliability_score" type="object"
                                class="oe_stat_button" icon="fa-refresh">
                            <span>Actualiser score</span>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Prioritaire" bg_color="text-bg-success"
                            invisible="not is_priority"/>
                    <widget name="web_ribbon" title="Inactif" bg_color="text-bg-danger"
                            invisible="is_active"/>
                    
                    <group>
                        <group string="Identification">
                            <field name="supplier_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="product_id" invisible="1"/>
                            <field name="supplier_product_ref"/>
                            <field name="supplier_product_name"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Statut">
                            <field name="is_active"/>
                            <field name="is_dropship_capable"/>
                            <field name="is_priority"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Onglet Tarification -->
                        <page string="Tarification" name="pricing">
                            <group>
                                <group string="Prix de base">
                                    <field name="currency_id"/>
                                    <field name="price"/>
                                    <field name="min_qty"/>
                                </group>
                                <group string="Frais additionnels">
                                    <field name="shipping_cost"/>
                                    <field name="handling_fee"/>
                                    <field name="dropship_fee"/>
                                    <field name="urgent_surcharge"/>
                                </group>
                            </group>
                            <group>
                                <group string="Coût total">
                                    <field name="total_cost" class="oe_inline"/>
                                    <field name="margin_estimate" class="oe_inline"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Onglet Délais -->
                        <page string="Délais &amp; Livraison" name="delivery">
                            <group>
                                <group string="Délais">
                                    <field name="delay"/>
                                    <field name="delay_min"/>
                                    <field name="delay_max"/>
                                </group>
                                <group string="Stock fournisseur">
                                    <field name="supplier_stock"/>
                                    <field name="stock_updated"/>
                                </group>
                            </group>
                            
                            <group string="Zones desservies">
                                <field name="country_ids" widget="many2many_tags"/>
                                <field name="excluded_country_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        
                        <!-- Onglet Performance -->
                        <page string="Performance" name="performance">
                            <group>
                                <group string="Score">
                                    <field name="reliability_score" widget="progressbar"/>
                                </group>
                                <group string="Statistiques">
                                    <field name="total_orders"/>
                                    <field name="on_time_deliveries"/>
                                    <field name="avg_delay_variance"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Onglet Communication -->
                        <page string="Communication" name="communication">
                            <group>
                                <group string="Méthode de commande">
                                    <field name="order_method" widget="radio"/>
                                </group>
                                <group string="Coordonnées">
                                    <field name="order_email" placeholder="commandes@fournisseur.com"
                                           invisible="order_method not in ('email', False)"/>
                                    <field name="api_endpoint" invisible="order_method != 'api'"/>
                                    <field name="portal_url" invisible="order_method != 'portal'"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Onglet Notes -->
                        <page string="Notes" name="notes">
                            <group>
                                <field name="notes" placeholder="Notes internes..."/>
                            </group>
                            <group>
                                <field name="packaging_instructions" placeholder="Instructions d'emballage..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_supplier_dropship_info_tree" model="ir.ui.view">
        <field name="name">supplier.dropship.info.list</field>
        <field name="model">supplier.dropship.info</field>
        <field name="arch" type="xml">
            <list string="Fournisseurs Dropshipping" 
                  decoration-success="is_priority"
                  decoration-muted="not is_active">
                <field name="sequence" widget="handle"/>
                <field name="supplier_id"/>
                <field name="product_tmpl_id"/>
                <field name="supplier_product_ref"/>
                <field name="price"/>
                <field name="total_cost"/>
                <field name="margin_estimate" widget="progressbar"/>
                <field name="delay"/>
                <field name="reliability_score" widget="progressbar"/>
                <field name="is_priority"/>
                <field name="is_dropship_capable"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_supplier_dropship_info_search" model="ir.ui.view">
        <field name="name">supplier.dropship.info.search</field>
        <field name="model">supplier.dropship.info</field>
        <field name="arch" type="xml">
            <search string="Recherche fournisseurs">
                <field name="supplier_id"/>
                <field name="product_tmpl_id"/>
                <field name="supplier_product_ref"/>
                <separator/>
                <filter string="Actifs" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Prioritaires" name="priority" domain="[('is_priority', '=', True)]"/>
                <filter string="Dropship capable" name="dropship" domain="[('is_dropship_capable', '=', True)]"/>
                <separator/>
                <filter string="Marge supérieure à 20 pourcent" name="good_margin" domain="[('margin_estimate', '&gt;', 20)]"/>
                <filter string="Marge supérieure à 30 pourcent" name="excellent_margin" domain="[('margin_estimate', '&gt;', 30)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Fournisseur" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Produit" name="group_product" context="{'group_by': 'product_tmpl_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_supplier_dropship_info" model="ir.actions.act_window">
        <field name="name">Fournisseurs Dropshipping</field>
        <field name="res_model">supplier.dropship.info</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajoutez vos premiers fournisseurs dropshipping
            </p>
        </field>
    </record>

</data>
</odoo>
