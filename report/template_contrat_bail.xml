<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_contrat_bail_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1 class="text-center">Contrat de Bail pour Espace de Stockage</h1>

                        <div class="row mt32">
                            <div class="col-6">
                                <strong>Bailleur :</strong><br/>
                                <span t-esc="doc.company_id.name"/><br/>
                                <span t-esc="doc.company_id.partner_id.street"/><br/>
                                <span t-esc="doc.company_id.partner_id.city"/>, <span t-esc="doc.company_id.partner_id.zip"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Locataire :</strong><br/>
                                <span t-esc="doc.partner_id.name"/><br/>
                                <span t-esc="doc.partner_id.street"/><br/>
                                <span t-esc="doc.partner_id.city"/>, <span t-esc="doc.partner_id.zip"/><br/>
                            </div>
                        </div>

                        <h3 class="mt32">Objet du Contrat</h3>
                        <p>Le présent contrat a pour objet la location de l'espace de stockage désigné ci-après.</p>

                        <h3>Détails de l'Abonnement</h3>
                        <p><strong>Référence de l'abonnement :</strong> <span t-field="doc.code"/></p>
                        <p><strong>Date de début :</strong> <span t-field="doc.date_start"/></p>
                        <p><strong>Montant récurrent :</strong> <span t-field="doc.recurring_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></p>

                        <h3>Termes et Conditions</h3>
                        <p>
                            <!-- Ajoutez ici vos termes et conditions -->
                            1. Le locataire s'engage à utiliser l'espace de stockage conformément à sa destination...<br/>
                            2. Le loyer est payable mensuellement...<br/>
                        </p>

                        <div class="row mt64">
                            <div class="col-6 text-center">
                                <p>_________________________</p>
                                <p>Signature du Bailleur</p>
                            </div>
                            <div class="col-6 text-center">
                                <p>_________________________</p>
                                <p>Signature du Locataire</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
