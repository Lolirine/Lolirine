<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ============================================ -->
    <!-- PRODUCT TEMPLATE - EXTENSION -->
    <!-- ============================================ -->

    <record id="view_product_template_form_dropship" model="ir.ui.view">
        <field name="name">product.template.form.dropship</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Ajouter le bouton dans la button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_dropship_suppliers" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="not is_dropship_product">
                    <field name="dropship_supplier_count" widget="statinfo" string="Fournisseurs"/>
                </button>
            </xpath>
            
            <!-- Ajouter le champ dropshipping dans le formulaire -->
            <xpath expr="//sheet" position="inside">
                <group string="Dropshipping">
                    <field name="is_dropship_product"/>
                </group>
            </xpath>
            
            <!-- Ajouter un nouvel onglet pour le dropshipping -->
            <xpath expr="//notebook" position="inside">
                <page string="Dropshipping" name="dropshipping" invisible="not is_dropship_product">
                    
                    <!-- Résumé -->
                    <group>
                        <group string="Meilleurs fournisseurs">
                            <field name="best_margin_supplier_id"/>
                            <field name="fastest_supplier_id"/>
                            <field name="best_overall_supplier_id"/>
                            <field name="preferred_dropship_supplier_id" 
                                   domain="[('product_tmpl_id', '=', id)]"/>
                        </group>
                        <group string="Marges">
                            <field name="best_margin"/>
                            <field name="avg_margin"/>
                            <field name="worst_margin"/>
                        </group>
                    </group>
                    
                    <!-- Liste des fournisseurs -->
                    <separator string="Fournisseurs dropshipping"/>
                    <field name="dropship_supplier_ids" nolabel="1">
                        <list editable="bottom" decoration-success="is_priority" 
                              decoration-muted="not is_active">
                            <field name="sequence" widget="handle"/>
                            <field name="supplier_id"/>
                            <field name="supplier_product_ref"/>
                            <field name="price" string="Prix catalogue HT"/>
                            <field name="discount_percent" string="Réduction %"/>
                            <field name="negotiated_price" string="Prix négocié HT"/>
                            <field name="shipping_cost"/>
                            <field name="total_cost"/>
                            <field name="margin_estimate" widget="progressbar"/>
                            <field name="delay"/>
                            <field name="reliability_score" widget="progressbar"/>
                            <field name="is_priority"/>
                            <field name="is_active"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    
                </page>
            </xpath>
            
        </field>
    </record>

    <!-- Liste produits - Ajouter colonne dropship -->
    <record id="view_product_template_tree_dropship" model="ir.ui.view">
        <field name="name">product.template.list.dropship</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="after">
                <field name="is_dropship_product" optional="show"/>
                <field name="dropship_supplier_count" optional="hide"/>
                <field name="best_margin" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Recherche produits - Ajouter filtre dropship -->
    <record id="view_product_template_search_dropship" model="ir.ui.view">
        <field name="name">product.template.search.dropship</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Dropshipping" name="dropship" 
                        domain="[('is_dropship_product', '=', True)]"/>
                <filter string="Sans fournisseur" name="no_supplier"
                        domain="[('is_dropship_product', '=', True), ('dropship_supplier_count', '=', 0)]"/>
                <filter string="Avec fournisseur" name="has_supplier"
                        domain="[('is_dropship_product', '=', True), ('dropship_supplier_count', '>', 0)]"/>
            </xpath>
        </field>
    </record>

    <!-- Action: Catalogue produits dropship -->
    <record id="action_product_dropship_catalog" model="ir.actions.act_window">
        <field name="name">Catalogue dropship</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_dropship_product', '=', True)]</field>
        <field name="context">{'search_default_dropship': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun produit dropshipping
            </p>
        </field>
    </record>

    <!-- Action: Produits sans fournisseur -->
    <record id="action_product_dropship_no_supplier" model="ir.actions.act_window">
        <field name="name">Sans fournisseur</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_dropship_product', '=', True), ('dropship_supplier_count', '=', 0)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tous les produits dropship ont un fournisseur attribué !
            </p>
            <p>
                Utilisez l'action "Attribuer fournisseur dropship" pour attribuer en masse.
            </p>
        </field>
    </record>

</data>
</odoo>
