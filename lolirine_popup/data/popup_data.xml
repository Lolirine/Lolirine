<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Popup par défaut -->
        <record id="default_popup_config" model="lolirine.popup.config">
            <field name="active">True</field>
            <field name="title">Box Disponible</field>
            <field name="subtitle">Nous vous invitons à vous diriger vers notre formulaire d'enregistrement pour introduire vos informations de réservation.</field>
            <field name="button_text">Nouveau client / Vers le Formulaire</field>
            <field name="button_url">/contact-garde-meubles</field>
            <field name="button_target">_self</field>
            <field name="show_secondary_button">False</field>
            <field name="show_delay">3</field>
            <field name="hide_duration">7</field>
            <field name="display_mode">shop</field>
            <field name="background_color">#C91E18</field>
            <field name="text_color">#ffffff</field>
        </record>
        
    </data>
</odoo>
