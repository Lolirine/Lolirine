<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- DECLARATION TYPE VIEWS                                            -->
    <!-- ================================================================== -->
    
    <!-- List View -->
    <record id="view_biztax_declaration_type_list" model="ir.ui.view">
        <field name="name">biztax.declaration.type.list</field>
        <field name="model">biztax.declaration.type</field>
        <field name="arch" type="xml">
            <list string="Types de déclaration" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="tax_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_biztax_declaration_type_form" model="ir.ui.view">
        <field name="name">biztax.declaration.type.form</field>
        <field name="model">biztax.declaration.type</field>
        <field name="arch" type="xml">
            <form string="Type de déclaration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nom du type"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Informations générales">
                            <field name="code"/>
                            <field name="tax_type"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Configuration XBRL">
                            <field name="xbrl_namespace"/>
                            <field name="xbrl_schema"/>
                        </group>
                    </group>
                    
                    <group string="Formes juridiques autorisées">
                        <field name="allowed_legal_forms" placeholder="sa,srl,sc (vide = toutes)"/>
                    </group>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description du type de déclaration..."/>
                        </page>
                        <page string="Annexes obligatoires" name="required_annexes">
                            <field name="required_annexe_type_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="annexe_category"/>
                                </list>
                            </field>
                        </page>
                        <page string="Annexes optionnelles" name="optional_annexes">
                            <field name="optional_annexe_type_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="annexe_category"/>
                                </list>
                            </field>
                        </page>
                        <page string="Codes fiscaux" name="tax_codes">
                            <field name="tax_code_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="section"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_biztax_declaration_type_search" model="ir.ui.view">
        <field name="name">biztax.declaration.type.search</field>
        <field name="model">biztax.declaration.type</field>
        <field name="arch" type="xml">
            <search string="Rechercher">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archivé" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="ISoc" name="isoc" domain="[('tax_type', '=', 'isoc')]"/>
                <filter string="IPM" name="ipm" domain="[('tax_type', '=', 'ipm')]"/>
                <filter string="INR" name="inr" domain="[('tax_type', 'in', ['inr_soc', 'inr_pm'])]"/>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_biztax_declaration_type" model="ir.actions.act_window">
        <field name="name">Types de déclaration</field>
        <field name="res_model">biztax.declaration.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau type de déclaration
            </p>
            <p>
                Les types de déclaration définissent les différents formulaires fiscaux 
                (ISoc, IPM, INR) avec leurs annexes obligatoires et codes fiscaux.
            </p>
        </field>
    </record>
    
    <!-- ================================================================== -->
    <!-- ANNEXE TYPE VIEWS                                                 -->
    <!-- ================================================================== -->
    
    <!-- List View -->
    <record id="view_biztax_annexe_type_list" model="ir.ui.view">
        <field name="name">biztax.annexe.type.list</field>
        <field name="model">biztax.annexe.type</field>
        <field name="arch" type="xml">
            <list string="Types d'annexes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="annexe_category"/>
                <field name="can_auto_generate"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_biztax_annexe_type_form" model="ir.ui.view">
        <field name="name">biztax.annexe.type.form</field>
        <field name="model">biztax.annexe.type</field>
        <field name="arch" type="xml">
            <form string="Type d'annexe">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nom de l'annexe"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Informations générales">
                            <field name="code"/>
                            <field name="annexe_category"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Configuration XBRL">
                            <field name="xbrl_element"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Génération automatique">
                            <field name="can_auto_generate"/>
                            <field name="report_id" invisible="not can_auto_generate"/>
                            <field name="template_id" invisible="not can_auto_generate"/>
                        </group>
                        <group string="Contraintes fichier">
                            <field name="max_file_size_mb"/>
                            <field name="allowed_mime_types"/>
                        </group>
                    </group>
                    
                    <group string="Conditions">
                        <field name="condition_field" placeholder="Ex: total_increases > 0"/>
                    </group>
                    
                    <group>
                        <field name="description" placeholder="Description de l'annexe et son contenu attendu..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_biztax_annexe_type_search" model="ir.ui.view">
        <field name="name">biztax.annexe.type.search</field>
        <field name="model">biztax.annexe.type</field>
        <field name="arch" type="xml">
            <search string="Rechercher">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archivé" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Auto-générable" name="auto" domain="[('can_auto_generate', '=', True)]"/>
                <separator/>
                <filter string="États financiers" name="financial" domain="[('annexe_category', '=', 'financial')]"/>
                <filter string="Documents fiscaux" name="fiscal" domain="[('annexe_category', '=', 'fiscal')]"/>
                <filter string="Documents légaux" name="legal" domain="[('annexe_category', '=', 'legal')]"/>
                <separator/>
                <filter string="Catégorie" name="group_category" context="{'group_by': 'annexe_category'}"/>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_biztax_annexe_type" model="ir.actions.act_window">
        <field name="name">Types d'annexes</field>
        <field name="res_model">biztax.annexe.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau type d'annexe
            </p>
            <p>
                Les types d'annexes définissent les documents à joindre à la déclaration 
                (bilan, compte de résultat, attestations, etc.)
            </p>
        </field>
    </record>

</odoo>
