<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Biztax Adjustment Form View -->
    <record id="view_biztax_adjustment_form" model="ir.ui.view">
        <field name="name">biztax.adjustment.form</field>
        <field name="model">biztax.adjustment</field>
        <field name="arch" type="xml">
            <form string="Ajustement Fiscal">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="declaration_id"/>
                            <field name="tax_code_id"/>
                            <field name="name"/>
                        </group>
                        <group string="Classification">
                            <field name="category"/>
                            <field name="adjustment_type"/>
                            <field name="is_dna"/>
                        </group>
                    </group>
                    <group>
                        <group string="Montants">
                            <field name="amount"/>
                            <field name="dna_percentage" invisible="not is_dna"/>
                            <field name="dna_amount" invisible="not is_dna"/>
                        </group>
                        <group string="Comptabilité">
                            <field name="account_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Notes ou justifications..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Biztax Adjustment Tree View -->
    <record id="view_biztax_adjustment_tree" model="ir.ui.view">
        <field name="name">biztax.adjustment.tree</field>
        <field name="model">biztax.adjustment</field>
        <field name="arch" type="xml">
            <list string="Ajustements Fiscaux" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="tax_code_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="adjustment_type"/>
                <field name="amount"/>
                <field name="dna_percentage" optional="hide"/>
                <field name="dna_amount" optional="hide"/>
                <field name="account_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Biztax Adjustment Search View -->
    <record id="view_biztax_adjustment_search" model="ir.ui.view">
        <field name="name">biztax.adjustment.search</field>
        <field name="model">biztax.adjustment</field>
        <field name="arch" type="xml">
            <search string="Recherche Ajustements">
                <field name="name"/>
                <field name="tax_code_id"/>
                <field name="declaration_id"/>
                <field name="account_id"/>
                <separator/>
                <filter string="Augmentations" name="increases" domain="[('adjustment_type', '=', 'increase')]"/>
                <filter string="Diminutions" name="decreases" domain="[('adjustment_type', '=', 'decrease')]"/>
                <separator/>
                <filter string="DNA" name="dna" domain="[('is_dna', '=', True)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Déclaration" name="group_declaration" context="{'group_by': 'declaration_id'}"/>
                    <filter string="Catégorie" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'adjustment_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for standalone adjustment view -->
    <record id="action_biztax_adjustment" model="ir.actions.act_window">
        <field name="name">Ajustements Fiscaux</field>
        <field name="res_model">biztax.adjustment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>
</odoo>
