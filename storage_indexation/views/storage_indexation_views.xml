<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste des indexations -->
    <record id="view_storage_indexation_tree" model="ir.ui.view">
        <field name="name">storage.indexation.tree</field>
        <field name="model">storage.indexation</field>
        <field name="arch" type="xml">
            <list string="Indexations" decoration-info="state == 'draft'" 
                  decoration-warning="state in ('computed', 'confirmed')"
                  decoration-success="state == 'applied'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="index_type"/>
                <field name="new_index_id"/>
                <field name="indexation_rate" widget="float" digits="[16, 2]" string="Taux (%)"/>
                <field name="subscription_count"/>
                <field name="total_increase" sum="Total"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('computed', 'confirmed', 'notified')"
                       decoration-success="state == 'applied'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <!-- Vue formulaire des indexations -->
    <record id="view_storage_indexation_form" model="ir.ui.view">
        <field name="name">storage.indexation.form</field>
        <field name="model">storage.indexation</field>
        <field name="arch" type="xml">
            <form string="Indexation">
                <header>
                    <button name="action_compute_indexation" type="object" 
                            string="Calculer l'indexation" 
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" 
                            string="Confirmer" 
                            class="btn-primary"
                            invisible="state != 'computed'"/>
                    <button name="action_send_notifications" type="object" 
                            string="Envoyer les notifications" 
                            class="btn-primary"
                            invisible="state not in ('computed', 'confirmed')"/>
                    <button name="action_apply_indexation" type="object" 
                            string="Appliquer l'indexation" 
                            class="btn-success"
                            invisible="state not in ('confirmed', 'notified')"
                            confirm="Êtes-vous sûr de vouloir appliquer cette indexation ? Les prix seront définitivement modifiés."/>
                    <button name="action_cancel" type="object" 
                            string="Annuler" 
                            invisible="state in ('applied', 'cancelled')"/>
                    <button name="action_reset_to_draft" type="object" 
                            string="Remettre en brouillon" 
                            invisible="state in ('draft', 'applied')"/>
                    <button name="action_print_summary" type="object" 
                            string="Imprimer le résumé" 
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,confirmed,notified,applied"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_print_summary"
                                icon="fa-print" invisible="state == 'draft'">
                            <span>Imprimer</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <!-- Statistiques -->
                    <div class="row mt16 mb16" invisible="state == 'draft'">
                        <div class="col-12 col-lg-3">
                            <div class="o_stat_card bg-light p-3 rounded">
                                <div class="o_stat_value text-primary">
                                    <field name="subscription_count" class="o_stat_value"/>
                                </div>
                                <div class="o_stat_text">Abonnements</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-3">
                            <div class="o_stat_card bg-light p-3 rounded">
                                <div class="o_stat_value">
                                    <field name="total_old_amount" class="o_stat_value" widget="monetary"/>
                                </div>
                                <div class="o_stat_text">Montant actuel</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-3">
                            <div class="o_stat_card bg-light p-3 rounded">
                                <div class="o_stat_value text-success">
                                    <field name="total_new_amount" class="o_stat_value" widget="monetary"/>
                                </div>
                                <div class="o_stat_text">Nouveau montant</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-3">
                            <div class="o_stat_card bg-info p-3 rounded">
                                <div class="o_stat_value text-white">
                                    +<field name="total_increase" class="o_stat_value" widget="monetary"/>
                                </div>
                                <div class="o_stat_text text-white">Augmentation</div>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="index_type"/>
                            <field name="date"/>
                            <field name="application_date" invisible="state not in ('applied',)"/>
                        </group>
                        <group>
                            <field name="base_index_id" options="{'no_create': True}"/>
                            <field name="new_index_id" options="{'no_create': True}"/>
                            <label for="indexation_rate"/>
                            <div>
                                <field name="indexation_rate" widget="float" digits="[16, 2]" nolabel="1" class="oe_inline"/> %
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes d'indexation" name="lines">
                            <field name="line_ids" readonly="state == 'applied'">
                                <list editable="bottom"
                                      decoration-success="applied"
                                      decoration-muted="not applied and indexation_id.state == 'applied'">
                                    <field name="partner_id"/>
                                    <field name="subscription_id"/>
                                    <field name="product_id"/>
                                    <field name="old_price" sum="Total actuel"/>
                                    <field name="new_price" sum="Nouveau total"/>
                                    <field name="price_increase" sum="Augmentation"/>
                                    <field name="increase_percentage" widget="float" digits="[16, 2]" string="% Augm."/>
                                    <field name="notification_sent" widget="boolean_toggle"/>
                                    <field name="applied" widget="boolean"/>
                                    <button name="action_view_subscription" type="object" 
                                            string="Voir" icon="fa-external-link" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notifications" name="notifications">
                            <group>
                                <group>
                                    <field name="notification_sent"/>
                                    <field name="notification_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!-- Vue Kanban -->
    <record id="view_storage_indexation_kanban" model="ir.ui.view">
        <field name="name">storage.indexation.kanban</field>
        <field name="model">storage.indexation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="date"/>
                <field name="state"/>
                <field name="subscription_count"/>
                <field name="total_increase"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_title">
                            <strong><field name="name"/></strong>
                        </div>
                        <div class="o_kanban_record_subtitle">
                            <field name="date"/>
                        </div>
                        <div class="mt8">
                            <span class="badge bg-primary">
                                <field name="subscription_count"/> abonnements
                            </span>
                        </div>
                        <div class="mt8">
                            <strong class="text-success">
                                +<field name="total_increase" widget="monetary"/>
                            </strong>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- Action principale -->
    <record id="action_storage_indexation" model="ir.actions.act_window">
        <field name="name">Indexations</field>
        <field name="res_model">storage.indexation</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creez votre premiere indexation
            </p>
            <p>
                L'indexation permet de mettre a jour automatiquement les prix des abonnements
                en fonction de l'évolution de l'indice santé belge.
            </p>
        </field>
    </record>
    <!-- Vue liste des lignes d'indexation -->
    <record id="view_storage_indexation_line_tree" model="ir.ui.view">
        <field name="name">storage.indexation.line.tree</field>
        <field name="model">storage.indexation.line</field>
        <field name="arch" type="xml">
            <list string="Lignes d'indexation">
                <field name="indexation_id"/>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <field name="product_id"/>
                <field name="old_price"/>
                <field name="new_price"/>
                <field name="price_increase"/>
                <field name="increase_percentage" widget="float" digits="[16, 2]" string="% Augm."/>
                <field name="applied" widget="boolean"/>
            </list>
        </field>
    </record>
    <!-- Action pour les lignes -->
    <record id="action_storage_indexation_line" model="ir.actions.act_window">
        <field name="name">Détails des indexations</field>
        <field name="res_model">storage.indexation.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
