<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Index History Tree View -->
    <record id="apartment_index_history_view_tree" model="ir.ui.view">
        <field name="name">apartment.index.history.view.tree</field>
        <field name="model">apartment.index.history</field>
        <field name="arch" type="xml">
            <list string="Historique des indexations">
                <field name="lease_id"/>
                <field name="date"/>
                <field name="old_rent" widget="monetary"/>
                <field name="new_rent" widget="monetary"/>
                <field name="old_index"/>
                <field name="new_index"/>
                <field name="increase_percentage" widget="percentage"/>
                <field name="increase_amount" widget="monetary"/>
                <field name="source"/>
                <field name="notification_sent" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Index History Form View -->
    <record id="apartment_index_history_view_form" model="ir.ui.view">
        <field name="name">apartment.index.history.view.form</field>
        <field name="model">apartment.index.history</field>
        <field name="arch" type="xml">
            <form string="Indexation">
                <sheet>
                    <group>
                        <group string="Bail">
                            <field name="lease_id"/>
                            <field name="date"/>
                            <field name="source"/>
                            <field name="notification_sent" widget="boolean_toggle"/>
                        </group>
                        <group string="Indices">
                            <field name="old_index"/>
                            <field name="new_index"/>
                            <field name="index_type"/>
                        </group>
                    </group>
                    <group>
                        <group string="Loyers">
                            <field name="old_rent" widget="monetary"/>
                            <field name="new_rent" widget="monetary"/>
                        </group>
                        <group string="Augmentation">
                            <field name="increase_amount" widget="monetary"/>
                            <field name="increase_percentage" widget="percentage"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Notes ou commentaires..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Index History Search View -->
    <record id="apartment_index_history_view_search" model="ir.ui.view">
        <field name="name">apartment.index.history.view.search</field>
        <field name="model">apartment.index.history</field>
        <field name="arch" type="xml">
            <search string="Historique des indexations">
                <field name="lease_id"/>
                <field name="date"/>
                <filter string="Notifié" name="notified" domain="[('notification_sent', '=', True)]"/>
                <filter string="Non notifié" name="not_notified" domain="[('notification_sent', '=', False)]"/>
                <filter string="Cette année" name="this_year" domain="[('date', '&gt;=', time.strftime('%Y-01-01'))]"/>
            </search>
        </field>
    </record>

    <!-- Index History Action -->
    <record id="apartment_index_history_action" model="ir.actions.act_window">
        <field name="name">Historique des indexations</field>
        <field name="res_model">apartment.index.history</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune indexation enregistrée
            </p>
            <p>
                L'historique des indexations de loyer apparaîtra ici.
            </p>
        </field>
    </record>

</odoo>
