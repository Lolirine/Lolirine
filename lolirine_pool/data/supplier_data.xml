<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Séquence pour les imports -->
        <record id="sequence_pool_import_log" model="ir.sequence">
            <field name="name">Import Piscine</field>
            <field name="code">pool.import.log</field>
            <field name="prefix">IMP/POOL/</field>
            <field name="padding">5</field>
        </record>

        <!-- Fournisseur Fluidra -->
        <record id="pool_supplier_fluidra" model="pool.supplier">
            <field name="name">Fluidra</field>
            <field name="code">FLUIDRA</field>
            <field name="sequence">10</field>
            <field name="supplier_type">fluidra</field>
            <field name="import_method">csv</field>
            <field name="website_url">https://www.fluidra.com</field>
            <field name="catalog_url">https://catalog.fluidra.com</field>
            <field name="price_field">cost</field>
            <field name="margin_type">percentage</field>
            <field name="default_margin">35.0</field>
            <field name="default_category_id" ref="product_category_pool"/>
            <field name="notes"><![CDATA[
<h4>Fluidra - Leader mondial des équipements piscine</h4>
<p>Marques : AstralPool, Zodiac, Jandy, Polaris, etc.</p>
<h5>Instructions d'import :</h5>
<ol>
    <li>Se connecter sur le portail pro Fluidra</li>
    <li>Télécharger le catalogue au format Excel/CSV</li>
    <li>Utiliser l'assistant d'import avec le mapping automatique</li>
</ol>
<h5>Colonnes attendues :</h5>
<ul>
    <li>REF_ARTICLE → Réf. fournisseur</li>
    <li>DESIGNATION → Nom produit</li>
    <li>PV_HT → Prix d'achat</li>
    <li>EAN13 → Code-barres</li>
    <li>FAMILLE → Catégorie</li>
</ul>
            ]]></field>
        </record>

        <!-- Mapping Fluidra -->
        <record id="pool_supplier_fluidra_mapping_ref" model="pool.supplier.field.mapping">
            <field name="supplier_id" ref="pool_supplier_fluidra"/>
            <field name="sequence">1</field>
            <field name="source_field">REF_ARTICLE</field>
            <field name="target_field">supplier_code</field>
        </record>
        <record id="pool_supplier_fluidra_mapping_name" model="pool.supplier.field.mapping">
            <field name="supplier_id" ref="pool_supplier_fluidra"/>
            <field name="sequence">2</field>
            <field name="source_field">DESIGNATION</field>
            <field name="target_field">name</field>
        </record>
        <record id="pool_supplier_fluidra_mapping_price" model="pool.supplier.field.mapping">
            <field name="supplier_id" ref="pool_supplier_fluidra"/>
            <field name="sequence">3</field>
            <field name="source_field">PV_HT</field>
            <field name="target_field">standard_price</field>
        </record>
        <record id="pool_supplier_fluidra_mapping_ean" model="pool.supplier.field.mapping">
            <field name="supplier_id" ref="pool_supplier_fluidra"/>
            <field name="sequence">4</field>
            <field name="source_field">EAN13</field>
            <field name="target_field">barcode</field>
        </record>

        <!-- Fournisseur SCP Bénélux -->
        <record id="pool_supplier_scp" model="pool.supplier">
            <field name="name">SCP Bénélux</field>
            <field name="code">SCP</field>
            <field name="sequence">20</field>
            <field name="supplier_type">scp</field>
            <field name="import_method">csv</field>
            <field name="website_url">https://www.poolcorp.com</field>
            <field name="price_field">cost</field>
            <field name="margin_type">percentage</field>
            <field name="default_margin">30.0</field>
            <field name="default_category_id" ref="product_category_pool"/>
            <field name="notes"><![CDATA[
<h4>SCP Bénélux - Distributeur Pool Corp</h4>
<p>Large gamme de produits piscine et spa.</p>
<h5>Instructions d'import :</h5>
<ol>
    <li>Connexion portail SCP Bénélux</li>
    <li>Export catalogue depuis "Mon compte"</li>
    <li>Format CSV avec séparateur point-virgule</li>
</ol>
            ]]></field>
        </record>

        <!-- Fournisseur Allforpools -->
        <record id="pool_supplier_allforpools" model="pool.supplier">
            <field name="name">Allforpools</field>
            <field name="code">AFP</field>
            <field name="sequence">30</field>
            <field name="supplier_type">allforpools</field>
            <field name="import_method">csv</field>
            <field name="website_url">https://www.allforpools.be</field>
            <field name="price_field">cost</field>
            <field name="margin_type">percentage</field>
            <field name="default_margin">28.0</field>
            <field name="default_category_id" ref="product_category_pool"/>
            <field name="notes"><![CDATA[
<h4>Allforpools - Grossiste Belge</h4>
<p>Spécialiste local avec livraison rapide.</p>
            ]]></field>
        </record>

        <!-- Fournisseur MyPiscine -->
        <record id="pool_supplier_mypiscine" model="pool.supplier">
            <field name="name">MyPiscine.com</field>
            <field name="code">MYP</field>
            <field name="sequence">40</field>
            <field name="supplier_type">mypiscine</field>
            <field name="import_method">csv</field>
            <field name="website_url">https://www.mypiscine.com</field>
            <field name="price_field">cost</field>
            <field name="margin_type">percentage</field>
            <field name="default_margin">25.0</field>
            <field name="default_category_id" ref="product_category_pool"/>
            <field name="notes"><![CDATA[
<h4>MyPiscine.com</h4>
<p>Grossiste français avec large catalogue.</p>
            ]]></field>
        </record>

        <!-- Template fournisseur générique -->
        <record id="pool_supplier_generic" model="pool.supplier">
            <field name="name">Autre Fournisseur (Template)</field>
            <field name="code">OTHER</field>
            <field name="sequence">100</field>
            <field name="supplier_type">generic</field>
            <field name="import_method">csv</field>
            <field name="active" eval="False"/>
            <field name="price_field">cost</field>
            <field name="margin_type">percentage</field>
            <field name="default_margin">30.0</field>
            <field name="default_category_id" ref="product_category_pool"/>
            <field name="notes"><![CDATA[
<h4>Template Fournisseur Générique</h4>
<p>Dupliquez cette fiche pour ajouter un nouveau fournisseur.</p>
<ol>
    <li>Cliquez sur "Dupliquer"</li>
    <li>Modifiez le nom et le code</li>
    <li>Configurez le mapping des colonnes</li>
    <li>Activez le fournisseur</li>
</ol>
            ]]></field>
        </record>

        <!-- Marques principales -->
        <record id="pool_brand_astralpool" model="pool.brand">
            <field name="name">AstralPool</field>
            <field name="code">ASTRAL</field>
            <field name="website">https://www.astralpool.com</field>
            <field name="description">Marque premium du groupe Fluidra</field>
        </record>

        <record id="pool_brand_zodiac" model="pool.brand">
            <field name="name">Zodiac</field>
            <field name="code">ZODIAC</field>
            <field name="website">https://www.zodiac.com</field>
            <field name="description">Robots et équipements piscine haut de gamme</field>
        </record>

        <record id="pool_brand_hayward" model="pool.brand">
            <field name="name">Hayward</field>
            <field name="code">HAYWARD</field>
            <field name="website">https://www.hayward.eu</field>
            <field name="description">Équipements de filtration et robots</field>
        </record>

        <record id="pool_brand_pentair" model="pool.brand">
            <field name="name">Pentair</field>
            <field name="code">PENTAIR</field>
            <field name="website">https://www.pentair.com</field>
            <field name="description">Pompes et systèmes de filtration</field>
        </record>

        <record id="pool_brand_dolphin" model="pool.brand">
            <field name="name">Dolphin (Maytronics)</field>
            <field name="code">DOLPHIN</field>
            <field name="website">https://www.maytronics.com</field>
            <field name="description">Robots nettoyeurs électriques</field>
        </record>

        <record id="pool_brand_bayrol" model="pool.brand">
            <field name="name">Bayrol</field>
            <field name="code">BAYROL</field>
            <field name="website">https://www.bayrol.com</field>
            <field name="description">Produits de traitement de l'eau</field>
        </record>

    </data>
</odoo>
