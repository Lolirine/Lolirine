<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_form_pu_home" model="ir.ui.view">
        <field name="name">website.form.lolirine.home.blocks</field>
        <field name="model">website</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Vitrines de la page d'accueil">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Page d'accueil">
                            <field name="pu_home_enabled"/>
                            <field name="pu_showcase_count" invisible="not pu_home_enabled"/>
                            <field name="pu_home_tiles" invisible="not pu_home_enabled"/>
                            <field name="pu_home_lowprice" invisible="not pu_home_enabled"/>
                            <field name="pu_lowprice_max" invisible="not pu_home_enabled or not pu_home_lowprice"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_website_pu_home" model="ir.actions.act_window">
        <field name="name">Vitrines de l'accueil</field>
        <field name="res_model">website</field>
        <field name="view_mode">form</field>
        <field name="res_id">6</field>
        <field name="view_id" ref="view_website_form_pu_home"/>
    </record>

    <menuitem id="menu_website_pu_home"
              name="Vitrines de l'accueil"
              parent="website.menu_website_global_configuration"
              action="action_website_pu_home"
              sequence="61"/>
</odoo>
