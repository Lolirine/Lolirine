<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lolirine_destination_invoice_form" model="ir.ui.view">
        <field name="name">account.move.lolirine.destination</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Champs invisibles nécessaires aux conditions -->
            <xpath expr="//field[@name='ref']" position="before">
                <field name="has_hangar" invisible="1"/>
                <field name="has_appart" invisible="1"/>
                <field name="has_pool"   invisible="1"/>
                <field name="has_mixed"  invisible="1"/>
            </xpath>

            <!-- Résumé destination sous la référence -->
            <xpath expr="//field[@name='ref']" position="after">
                <field name="destination_summary"
                       string="Destination"
                       readonly="1"
                       invisible="move_type not in ['in_invoice', 'in_refund']"
                       widget="badge"/>
            </xpath>

            <!-- Boutons dans la button box -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">

                <button name="action_apply_hangar_only"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-industry"
                        invisible="move_type not in ['in_invoice', 'in_refund']"
                        title="Appliquer 100% Hangar sur toutes les lignes">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Hangar</span>
                        <span class="o_stat_value" invisible="not has_hangar">✓</span>
                    </div>
                </button>

                <button name="action_apply_hangar_appart"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-home"
                        invisible="move_type not in ['in_invoice', 'in_refund']"
                        title="Répartition 89% Hangar / 11% Appartement">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Hangar+Appart</span>
                        <span class="o_stat_value" invisible="not has_mixed">89/11%</span>
                    </div>
                </button>

                <button name="action_apply_pool_only"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tint"
                        invisible="move_type not in ['in_invoice', 'in_refund']"
                        title="Appliquer 100% Pool Store sur toutes les lignes">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Pool Store</span>
                        <span class="o_stat_value" invisible="not has_pool">✓</span>
                    </div>
                </button>

                <button name="action_clear_destination"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-times-circle"
                        invisible="move_type not in ['in_invoice', 'in_refund']"
                        title="Effacer toutes les destinations">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Effacer</span>
                    </div>
                </button>

            </xpath>

        </field>
    </record>

</odoo>
