<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rapport Contrat -->
    <record id="action_report_contract" model="ir.actions.report">
        <field name="name">Contrat de Garde-Meubles</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_contract.report_contract_document</field>
        <field name="report_file">lolirine_contract.report_contract_document</field>
        <field name="print_report_name">'Contrat_%s' % (object.name or 'Nouveau').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
    
    <!-- Rapport Devis -->
    <record id="action_report_quotation" model="ir.actions.report">
        <field name="name">Devis Garde-Meubles</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_contract.report_lolirine_quotation_document</field>
        <field name="report_file">lolirine_contract.report_lolirine_quotation_document</field>
        <field name="print_report_name">'Devis_%s' % (object.name or 'Nouveau').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
