<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Groupe pour les utilisateurs du module Scan TVA -->
        <record id="group_scan_tva_user" model="res.groups">
            <field name="name">Utilisateur Scan TVA</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        
        <record id="group_scan_tva_manager" model="res.groups">
            <field name="name">Responsable Scan TVA</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_scan_tva_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
        
        <!-- Règle d'accès multi-société -->
        <record id="rule_scan_tva_multi_company" model="ir.rule">
            <field name="name">Scan TVA multi-societe</field>
            <field name="model_id" ref="model_lolirine_scan_tva"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
