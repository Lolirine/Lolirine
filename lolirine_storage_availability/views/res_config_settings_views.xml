<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_storage" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.storage.availability</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Box de Stockage" string="Box de Stockage" name="lolirine_storage" 
                     groups="base.group_system">
                    <block title="Bouton pour les box DISPONIBLES" name="storage_available_settings">
                        <setting id="storage_appointment_button_setting" 
                                 string="Bouton Rendez-vous"
                                 help="Affiche un bouton pour prendre rendez-vous sur les box disponibles">
                            <field name="storage_enable_appointment_button"/>
                            <div invisible="not storage_enable_appointment_button" class="mt-3">
                                <div class="row">
                                    <label for="storage_default_appointment_type_id" 
                                           string="Type de rendez-vous" 
                                           class="col-lg-4"/>
                                    <field name="storage_default_appointment_type_id" 
                                           options="{'no_create': True}"
                                           class="col-lg-8"
                                           placeholder="Sélectionner un type de rendez-vous..."/>
                                </div>
                                <div class="row mt-2">
                                    <label for="storage_appointment_button_text" 
                                           string="Texte du bouton" 
                                           class="col-lg-4"/>
                                    <field name="storage_appointment_button_text" 
                                           class="col-lg-8"
                                           placeholder="Contactez-nous"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Bouton pour les box NON DISPONIBLES (loué, réservé, maintenance)" name="storage_unavailable_settings">
                        <setting id="storage_general_inquiry_setting"
                                 string="Bouton Demande générale"
                                 help="Bouton affiché quand le box n'est pas disponible, redirige vers la page contact">
                            <div class="mt-2">
                                <div class="row">
                                    <label for="storage_general_inquiry_button_text" 
                                           string="Texte du bouton" 
                                           class="col-lg-4"/>
                                    <field name="storage_general_inquiry_button_text" 
                                           class="col-lg-8"
                                           placeholder="Demande générale"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="storage_general_inquiry_url" 
                                           string="URL page contact" 
                                           class="col-lg-4"/>
                                    <field name="storage_general_inquiry_url" 
                                           class="col-lg-8"
                                           placeholder="/contactus"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Affichage e-commerce" name="storage_display_settings">
                        <setting id="storage_status_badge_setting"
                                 string="Badge de statut"
                                 help="Affiche le statut du box (Disponible, Loué, etc.) sur la page produit">
                            <field name="storage_show_status_badge"/>
                        </setting>
                    </block>
                    <block title="Informations" name="storage_info">
                        <div class="text-muted">
                            <p>
                                <i class="fa fa-info-circle"/> 
                                <strong>Comment ça fonctionne :</strong>
                            </p>
                            <ul>
                                <li>Marquez vos produits comme "Box de stockage" dans leur fiche</li>
                                <li>Définissez le statut de chaque box (Disponible, Loué, etc.)</li>
                                <li><strong>Box disponible :</strong> affiche le bouton rendez-vous → prise de RDV</li>
                                <li><strong>Box non disponible :</strong> affiche le bouton demande générale → page contact</li>
                                <li>Utilisez le snippet "Box de Stockage" sur vos pages produit e-commerce</li>
                            </ul>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
