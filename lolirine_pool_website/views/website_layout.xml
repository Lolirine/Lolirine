<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- CHARGEMENT CONDITIONNEL DU CSS POOL         -->
    <!-- ============================================ -->
    
    <!-- 
        Ce template charge le CSS du thème Pool uniquement
        lorsque le visiteur est sur le site Pool Store.
        Le CSS n'est plus chargé globalement via le manifest.
    -->
    <template id="pool_website_assets" inherit_id="website.layout" name="Pool Website Assets">
        <xpath expr="//head" position="inside">
            <t t-if="website and 'Pool' in (website.name or '')">
                <link rel="stylesheet" type="text/css" href="/lolirine_pool_website/static/src/css/pool_theme.css"/>
            </t>
        </xpath>
    </template>
    
</odoo>
