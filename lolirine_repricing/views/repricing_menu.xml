<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sous-menu dans eCommerce (parent ID 513 = eCommerce > Site Web) -->
    <record id="menu_repricing_root" model="ir.ui.menu">
        <field name="name">Repricing Pool Store</field>
        <field name="parent_id" ref="website.menu_website_configuration"/>
        <field name="sequence">99</field>
    </record>

    <record id="menu_repricing_run" model="ir.ui.menu">
        <field name="name">Lancer le repricing</field>
        <field name="parent_id" ref="menu_repricing_root"/>
        <field name="action" ref="lolirine_repricing.action_repricing_wizard"/>
        <field name="sequence">10</field>
    </record>

    <record id="menu_repricing_logs" model="ir.ui.menu">
        <field name="name">Historique des sessions</field>
        <field name="parent_id" ref="menu_repricing_root"/>
        <field name="action" ref="lolirine_repricing.action_repricing_logs"/>
        <field name="sequence">20</field>
    </record>
</odoo>
