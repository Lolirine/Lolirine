<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Ajouter un lien vers la config popup dans les paramètres du site web -->
    <record id="res_config_settings_view_form_popup" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lolirine.popup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Popup Lolirine" id="lolirine_popup_settings">
                    <setting string="Configurer le Popup" help="Gérez le popup de redirection vers le formulaire de contact">
                        <div class="mt8">
                            <button name="%(action_lolirine_popup_config)d" 
                                    type="action" 
                                    string="Configurer le Popup" 
                                    class="btn-primary"
                                    icon="fa-window-maximize"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
    
</odoo>
