<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- ================================================================== -->
    <!-- PAPERFORMAT                                                       -->
    <!-- ================================================================== -->
    
    <record id="paperformat_biztax_a4" model="report.paperformat">
        <field name="name">Biztax A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <!-- ================================================================== -->
    <!-- REPORT ACTIONS                                                    -->
    <!-- ================================================================== -->
    
    <!-- Balance Sheet Report -->
    <record id="action_report_balance_sheet" model="ir.actions.report">
        <field name="name">Bilan</field>
        <field name="model">biztax.declaration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_biztax.report_balance_sheet</field>
        <field name="report_file">lolirine_biztax.report_balance_sheet</field>
        <field name="print_report_name">'Bilan_%s_%s' % (object.company_id.name, object.assessment_year)</field>
        <field name="binding_model_id" ref="model_biztax_declaration"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_biztax_a4"/>
    </record>
    
    <!-- Profit & Loss Report -->
    <record id="action_report_profit_loss" model="ir.actions.report">
        <field name="name">Compte de résultats</field>
        <field name="model">biztax.declaration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_biztax.report_profit_loss</field>
        <field name="report_file">lolirine_biztax.report_profit_loss</field>
        <field name="print_report_name">'CompteResultats_%s_%s' % (object.company_id.name, object.assessment_year)</field>
        <field name="binding_model_id" ref="model_biztax_declaration"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_biztax_a4"/>
    </record>
    
    <!-- DNA Detail Report -->
    <record id="action_report_dna_detail" model="ir.actions.report">
        <field name="name">Détail DNA</field>
        <field name="model">biztax.declaration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_biztax.report_dna_detail</field>
        <field name="report_file">lolirine_biztax.report_dna_detail</field>
        <field name="print_report_name">'DNA_%s_%s' % (object.company_id.name, object.assessment_year)</field>
        <field name="binding_model_id" ref="model_biztax_declaration"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_biztax_a4"/>
    </record>
    
    <!-- Fiscal Summary Report -->
    <record id="action_report_fiscal_summary" model="ir.actions.report">
        <field name="name">Résumé fiscal complet</field>
        <field name="model">biztax.declaration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_biztax.report_fiscal_summary</field>
        <field name="report_file">lolirine_biztax.report_fiscal_summary</field>
        <field name="print_report_name">'ResumeFiscal_%s_%s' % (object.company_id.name, object.assessment_year)</field>
        <field name="binding_model_id" ref="model_biztax_declaration"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_biztax_a4"/>
    </record>

</odoo>
