<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Options pour les snippets de recommandation -->
    <template id="homepage_recommendations_options" inherit_id="website.snippet_options" name="Homepage Recommendations Options">
        <xpath expr="." position="inside">
            
            <!-- Options pour la section recommandations générique -->
            <div data-selector=".s_recommendations_section" data-js="RecommendationsSection">
                <!-- Choix du type de section -->
                <we-select string="Type de recommandation" data-attribute-name="sectionType">
                    <we-button data-select-data-attribute="best_sellers">Meilleures ventes</we-button>
                    <we-button data-select-data-attribute="recently_viewed">Récemment consultés</we-button>
                    <we-button data-select-data-attribute="continue_shopping">Continuez vos achats</we-button>
                    <we-button data-select-data-attribute="top_rated">Les mieux notés</we-button>
                    <we-button data-select-data-attribute="promotions">Offres/Promotions</we-button>
                    <we-button data-select-data-attribute="new_arrivals">Nouveautés</we-button>
                    <we-button data-select-data-attribute="related_to_viewed">En lien avec consultations</we-button>
                    <we-button data-select-data-attribute="for_category">Par catégorie</we-button>
                </we-select>
                
                <!-- Nombre de produits -->
                <we-input string="Nombre de produits" 
                          data-attribute-name="limit" 
                          data-default="12"
                          data-unit=""
                          data-save-attribute="data-limit"/>
                
                <!-- Sélection de catégorie (si type = for_category) -->
                <we-many2one string="Catégorie" 
                             data-attribute-name="categoryId"
                             data-model="product.public.category"
                             data-save-attribute="data-category-id"
                             data-dependencies="sectionType=for_category"/>
                
                <!-- Masquer si vide -->
                <we-checkbox string="Masquer si aucun produit" 
                             data-attribute-name="hideIfEmpty"
                             data-save-attribute="data-hide-if-empty"/>
                
                <!-- Afficher la réduction -->
                <we-checkbox string="Afficher % réduction" 
                             data-attribute-name="showDiscount"
                             data-save-attribute="data-show-discount"
                             data-dependencies="sectionType=promotions"/>
                
                <!-- Badge personnalisé -->
                <we-input string="Badge" 
                          data-attribute-name="badge"
                          data-save-attribute="data-show-badge"
                          data-dependencies="sectionType=new_arrivals|promotions"/>
            </div>
            
            <!-- Options pour la grille de catégories -->
            <div data-selector=".s_preferred_categories" data-js="PreferredCategoriesSection">
                <we-input string="Nombre de catégories" 
                          data-attribute-name="limit" 
                          data-default="6"
                          data-unit=""
                          data-save-attribute="data-limit"/>
            </div>
            
        </xpath>
    </template>
    
</odoo>
