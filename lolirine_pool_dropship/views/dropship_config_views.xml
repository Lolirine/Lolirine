<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ============================================ -->
    <!-- CONFIGURATION DROPSHIPPING -->
    <!-- ============================================ -->

    <!-- Form View -->
    <record id="view_dropship_config_form" model="ir.ui.view">
        <field name="name">dropship.config.form</field>
        <field name="model">dropship.config</field>
        <field name="arch" type="xml">
            <form string="Configuration Dropshipping">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la configuration"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Onglet Critères de sélection -->
                        <page string="Critères de sélection" name="selection_criteria">
                            <group>
                                <group string="Critère principal">
                                    <field name="selection_priority" widget="radio"/>
                                </group>
                            </group>
                            
                            <group string="Pondération des critères (total = 100%)">
                                <group>
                                    <field name="weight_margin"/>
                                    <field name="weight_delay"/>
                                </group>
                                <group>
                                    <field name="weight_reliability"/>
                                    <field name="weight_shipping"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Onglet Règles de marge -->
                        <page string="Règles de marge" name="margin_rules">
                            <group>
                                <group string="Seuils de marge">
                                    <field name="min_margin_percent"/>
                                    <field name="target_margin_percent"/>
                                </group>
                                <group string="Bonus / Malus">
                                    <field name="bonus_fast_delivery"/>
                                    <field name="bonus_priority_supplier"/>
                                    <field name="malus_low_reliability"/>
                                </group>
                            </group>
                            
                            <separator string="Règles spécifiques"/>
                            <field name="margin_rule_ids" context="{'default_config_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="apply_on"/>
                                    <field name="category_id" optional="hide"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="supplier_id" optional="hide"/>
                                    <field name="rule_type"/>
                                    <field name="min_margin"/>
                                    <field name="fixed_margin" optional="hide"/>
                                    <field name="action_below_min"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- Onglet Automatisation -->
                        <page string="Automatisation" name="automation">
                            <group>
                                <group string="Workflow automatique">
                                    <field name="auto_select_supplier"/>
                                    <field name="auto_create_po"/>
                                    <field name="auto_send_po"/>
                                </group>
                            </group>
                            
                            <group string="Notifications">
                                <group>
                                    <field name="notify_low_margin"/>
                                    <field name="notify_no_supplier"/>
                                </group>
                                <group>
                                    <field name="notification_user_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Onglet Dropshipping -->
                        <page string="Dropshipping" name="dropship_settings">
                            <group>
                                <group string="Emballage">
                                    <field name="use_neutral_packaging"/>
                                    <field name="include_packing_slip"/>
                                </group>
                            </group>
                            <group>
                                <field name="default_shipping_instructions" placeholder="Instructions par défaut pour les expéditions..."/>
                            </group>
                        </page>
                        
                        <!-- Onglet Branding Piscine -->
                        <page string="Branding Piscine" name="pool_branding">
                            <group>
                                <group string="Logo &amp; Identité">
                                    <field name="pool_logo" widget="image" class="oe_avatar"/>
                                    <field name="pool_store_name"/>
                                    <field name="pool_store_tagline"/>
                                </group>
                                <group string="Coordonnées documents">
                                    <field name="pool_store_email"/>
                                    <field name="pool_store_phone"/>
                                    <field name="pool_store_website"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_dropship_config_tree" model="ir.ui.view">
        <field name="name">dropship.config.list</field>
        <field name="model">dropship.config</field>
        <field name="arch" type="xml">
            <list string="Configurations Dropshipping">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="selection_priority"/>
                <field name="min_margin_percent"/>
                <field name="auto_select_supplier"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dropship_config" model="ir.actions.act_window">
        <field name="name">Configuration Dropshipping</field>
        <field name="res_model">dropship.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première configuration dropshipping
            </p>
            <p>
                Définissez les critères de sélection des fournisseurs et les règles de marge.
            </p>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- RÈGLES DE MARGE -->
    <!-- ============================================ -->

    <record id="view_dropship_margin_rule_form" model="ir.ui.view">
        <field name="name">dropship.margin.rule.form</field>
        <field name="model">dropship.margin.rule</field>
        <field name="arch" type="xml">
            <form string="Règle de marge">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="config_id"/>
                        </group>
                    </group>
                    
                    <group string="Conditions d'application">
                        <group>
                            <field name="apply_on" widget="radio"/>
                        </group>
                        <group>
                            <field name="category_id" invisible="apply_on != 'category'"/>
                            <field name="product_id" invisible="apply_on != 'product'"/>
                            <field name="supplier_id" invisible="apply_on != 'supplier'"/>
                        </group>
                    </group>
                    
                    <group string="Règle">
                        <group>
                            <field name="rule_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="min_margin" invisible="rule_type == 'fixed_margin'"/>
                            <field name="max_margin" invisible="rule_type != 'margin_range'"/>
                            <field name="fixed_margin" invisible="rule_type != 'fixed_margin'"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="action_below_min"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</data>
</odoo>
