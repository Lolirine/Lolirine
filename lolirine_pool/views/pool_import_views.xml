<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue formulaire Log Import -->
    <record id="pool_import_log_view_form" model="ir.ui.view">
        <field name="name">pool.import.log.form</field>
        <field name="model">pool.import.log</field>
        <field name="arch" type="xml">
            <form string="Log d'import">
                <header>
                    <button name="action_retry" type="object" string="Réessayer les erreurs"
                            class="btn-warning" invisible="error_count == 0 or state != 'done'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" 
                                class="oe_stat_button" icon="fa-cubes"
                                invisible="created_count == 0 and updated_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="created_count"/> / <field name="updated_count"/>
                                </span>
                                <span class="o_stat_text">Créés / MAJ</span>
                            </div>
                        </button>
                        <button name="action_view_errors" type="object" 
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="error_count == 0">
                            <field name="error_count" widget="statinfo" string="Erreurs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="supplier_id"/>
                            <field name="import_method"/>
                            <field name="import_filename"/>
                        </group>
                        <group>
                            <field name="total_lines"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Options">
                        <field name="update_existing"/>
                        <field name="create_category"/>
                        <field name="import_images"/>
                    </group>
                    <notebook>
                        <page string="Lignes importées" name="lines">
                            <field name="line_ids">
                                <tree string="Produits importés" decoration-success="state == 'created'" 
                                      decoration-info="state == 'updated'" 
                                      decoration-danger="state == 'error'"
                                      decoration-muted="state == 'skipped'">
                                    <field name="supplier_code"/>
                                    <field name="product_name"/>
                                    <field name="ean_code"/>
                                    <field name="cost_price"/>
                                    <field name="sale_price"/>
                                    <field name="category_name"/>
                                    <field name="state"/>
                                    <field name="product_id"/>
                                    <field name="error_message" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Journal" name="log">
                            <field name="log_text" readonly="1" widget="text"/>
                        </page>
                        <page string="Erreurs" name="errors" invisible="not error_log">
                            <field name="error_log" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vue liste Log Import -->
    <record id="pool_import_log_view_tree" model="ir.ui.view">
        <field name="name">pool.import.log.tree</field>
        <field name="model">pool.import.log</field>
        <field name="arch" type="xml">
            <tree string="Historique des imports" decoration-success="state == 'done'" 
                  decoration-danger="state == 'error'" decoration-warning="state == 'processing'">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="import_method"/>
                <field name="total_lines"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="error_count"/>
                <field name="start_date"/>
                <field name="duration" widget="float_time"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Recherche Log Import -->
    <record id="pool_import_log_view_search" model="ir.ui.view">
        <field name="name">pool.import.log.search</field>
        <field name="model">pool.import.log</field>
        <field name="arch" type="xml">
            <search string="Recherche Imports">
                <field name="name"/>
                <field name="supplier_id"/>
                <filter string="Terminés" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="En erreur" name="error" domain="[('state', '=', 'error')]"/>
                <filter string="En cours" name="processing" domain="[('state', '=', 'processing')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="today" domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Cette semaine" name="week" domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Fournisseur" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Log Import -->
    <record id="action_pool_import_log" model="ir.actions.act_window">
        <field name="name">Historique des imports</field>
        <field name="res_model">pool.import.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="pool_import_log_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun import effectué
            </p>
            <p>
                Utilisez le bouton "Importer des produits" depuis la fiche fournisseur.
            </p>
        </field>
    </record>

    <!-- Vue formulaire Ligne Import -->
    <record id="pool_product_import_view_form" model="ir.ui.view">
        <field name="name">pool.product.import.form</field>
        <field name="model">pool.product.import</field>
        <field name="arch" type="xml">
            <form string="Ligne d'import">
                <header>
                    <button name="action_process" type="object" string="Traiter"
                            class="btn-primary" invisible="state not in ('pending', 'error')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="supplier_id"/>
                            <field name="import_log_id"/>
                            <field name="supplier_code"/>
                            <field name="ean_code"/>
                        </group>
                        <group string="Produit">
                            <field name="product_name"/>
                            <field name="brand"/>
                            <field name="category_name"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Prix">
                            <field name="cost_price"/>
                            <field name="sale_price"/>
                        </group>
                        <group string="Autres">
                            <field name="weight"/>
                            <field name="image_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Description" invisible="not product_description">
                        <field name="product_description" nolabel="1"/>
                    </group>
                    <group string="Erreur" invisible="state != 'error'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="Données brutes" invisible="not raw_data">
                        <field name="raw_data" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
