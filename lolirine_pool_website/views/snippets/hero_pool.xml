<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Snippet Hero Pool Store -->
    <template id="s_pool_hero" name="Pool Hero">
        <section class="s_pool_hero s_cover parallax s_parallax_is_fixed pt96 pb96" 
                 data-scroll-background-ratio="1"
                 style="background-image: url('/lolirine_pool_website/static/src/img/hero-pool.jpg'); min-height: 500px;">
            <span class="s_parallax_bg_wrap">
                <span class="s_parallax_bg" style="background-color: rgba(0, 30, 60, 0.6);"/>
            </span>
            <div class="container">
                <div class="row">
                    <div class="col-lg-8 text-white">
                        <h1 class="display-4 fw-bold" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                            Équipez votre piscine
                        </h1>
                        <p class="lead mb-4">
                            Découvrez notre sélection de matériel de piscine professionnel
                        </p>
                        <a href="/shop" class="btn btn-lg text-white px-4" 
                           style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); border-radius: 50px;">
                            Voir la boutique
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
    
    <!-- Enregistrement du snippet -->
    <template id="s_pool_hero_options" inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-js="PoolHero" data-selector=".s_pool_hero"/>
        </xpath>
    </template>
    
</odoo>
