<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Définition du rapport -->
    <record id="action_report_invoice_lolirine" model="ir.actions.report">
        <field name="name">Facture Lolirine</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_invoice.report_invoice_lolirine</field>
        <field name="report_file">lolirine_invoice.report_invoice_lolirine</field>
        <field name="print_report_name">'Facture_%s' % object.name.replace('/','_')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template principal -->
    <template id="report_invoice_lolirine">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="lolirine_invoice.report_invoice_lolirine_document"/>
            </t>
        </t>
    </template>

    <!-- Document de facture -->
    <template id="report_invoice_lolirine_document">
        <div class="article" style="font-family: Arial, sans-serif; font-size: 10pt; padding: 15px;">
            <!-- Style CSS -->
            <style>
                .lolirine-invoice {
                    font-family: Arial, sans-serif;
                    font-size: 10pt;
                    color: #333;
                }
                .lolirine-logo {
                    max-height: 60px;
                    max-width: 180px;
                }
                .lolirine-company-info {
                    text-align: right;
                    font-size: 9pt;
                    line-height: 1.4;
                }
                .lolirine-slogan {
                    color: #c0392b;
                    font-style: italic;
                    font-size: 10pt;
                    margin-top: 5px;
                }
                .lolirine-client-block {
                    margin: 20px 0;
                    font-size: 10pt;
                }
                .lolirine-title {
                    color: #c0392b;
                    font-size: 20pt;
                    font-weight: bold;
                    margin: 15px 0;
                }
                .lolirine-dates-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 20px;
                    background-color: #f5f5f5;
                }
                .lolirine-dates-table td {
                    padding: 8px 12px;
                    border: 1px solid #ddd;
                }
                .lolirine-dates-table .label {
                    font-weight: bold;
                    color: #333;
                }
                .lolirine-main-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 15px;
                }
                .lolirine-main-table thead tr {
                    background-color: #c0392b;
                    color: white;
                }
                .lolirine-main-table thead th {
                    padding: 10px 8px;
                    text-align: left;
                    font-weight: bold;
                    border: none;
                    background-color: #c0392b;
                    color: white;
                }
                .lolirine-main-table tbody td {
                    padding: 10px 8px;
                    border-bottom: 1px solid #eee;
                    vertical-align: top;
                }
                .lolirine-totals-table {
                    width: 280px;
                    margin-left: auto;
                    border-collapse: collapse;
                }
                .lolirine-totals-table td {
                    padding: 6px 10px;
                    border: 1px solid #ddd;
                }
                .lolirine-totals-table .label-cell {
                    text-align: left;
                    background-color: #f9f9f9;
                }
                .lolirine-totals-table .value-cell {
                    text-align: right;
                    min-width: 80px;
                }
                .lolirine-totals-table .total-row td {
                    background-color: #c0392b;
                    color: white;
                    font-weight: bold;
                    font-size: 11pt;
                    border-color: #c0392b;
                }
                .lolirine-payment-info {
                    margin: 20px 0;
                    font-size: 10pt;
                }
                .lolirine-amount-words {
                    text-align: right;
                    font-size: 9pt;
                    margin-top: 10px;
                }
                .lolirine-conditions {
                    margin-top: 15px;
                    font-size: 9pt;
                    color: #666;
                }
                .lolirine-signature {
                    margin-top: 30px;
                    border-top: 1px solid #333;
                    width: 200px;
                    margin-left: auto;
                    padding-top: 5px;
                    text-align: center;
                    font-size: 9pt;
                }
                .lolirine-footer {
                    margin-top: 30px;
                    padding-top: 10px;
                    border-top: 2px solid #c0392b;
                    font-size: 8pt;
                    color: #666;
                    text-align: center;
                }
            </style>

            <div class="lolirine-invoice">
                <!-- En-tête -->
                <table style="width: 100%; margin-bottom: 10px;">
                    <tr>
                        <td style="width: 50%; vertical-align: top;">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="lolirine-logo" alt="Logo"/>
                            <div class="lolirine-slogan" t-if="o.company_id.report_header">
                                <t t-esc="o.company_id.report_header"/>
                            </div>
                        </td>
                        <td style="width: 50%; vertical-align: top;" class="lolirine-company-info">
                            <strong>Société <t t-esc="o.company_id.name"/></strong><br/>
                            <t t-if="o.company_id.street"><t t-esc="o.company_id.street"/><br/></t>
                            <t t-if="o.company_id.street2"><t t-esc="o.company_id.street2"/><br/></t>
                            <br/>
                            <t t-if="o.company_id.zip"><t t-esc="o.company_id.zip"/> </t>
                            <t t-if="o.company_id.city"><t t-esc="o.company_id.city"/></t><br/>
                            <t t-if="o.company_id.country_id"><t t-esc="o.company_id.country_id.name"/></t>
                        </td>
                    </tr>
                </table>

                <!-- Infos client -->
                <div class="lolirine-client-block">
                    <t t-if="o.partner_id.title"><t t-esc="o.partner_id.title.name"/> </t>
                    <strong><t t-esc="o.partner_id.name"/></strong><br/>
                    <t t-if="o.partner_id.street"><t t-esc="o.partner_id.street"/><br/></t>
                    <t t-if="o.partner_id.street2"><t t-esc="o.partner_id.street2"/><br/></t>
                    <t t-if="o.partner_id.zip"><t t-esc="o.partner_id.zip"/> </t>
                    <t t-if="o.partner_id.city"><t t-esc="o.partner_id.city"/><br/></t>
                    <t t-if="o.partner_id.country_id"><t t-esc="o.partner_id.country_id.name"/></t>
                </div>

                <!-- Titre facture -->
                <div class="lolirine-title">
                    <t t-if="o.state == 'draft'">PRO FORMA </t>
                    <t t-if="o.move_type == 'out_invoice'">Facture </t>
                    <t t-elif="o.move_type == 'out_refund'">Avoir </t>
                    <t t-esc="o.name"/>
                </div>

                <!-- Dates -->
                <table class="lolirine-dates-table">
                    <tr>
                        <td style="width: 50%;">
                            <span class="label">Date de facturation</span><br/>
                            <t t-esc="o.invoice_date" t-options="{'widget': 'date'}"/>
                        </td>
                        <td style="width: 50%;">
                            <span class="label">Date d'échéance</span><br/>
                            <t t-esc="o.invoice_date_due" t-options="{'widget': 'date'}"/>
                        </td>
                    </tr>
                </table>

                <!-- Tableau des lignes -->
                <table class="lolirine-main-table">
                    <thead>
                        <tr>
                            <th style="width: 50%;">DESCRIPTION</th>
                            <th style="width: 12%; text-align: center;">QUANTITÉ</th>
                            <th style="width: 15%; text-align: right;">PRIX UNITAIRE</th>
                            <th style="width: 8%; text-align: center;">TAXES</th>
                            <th style="width: 15%; text-align: right;">MONTANT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids.filtered(lambda l: not l.display_type)" t-as="line">
                            <tr>
                                <td>
                                    <t t-esc="line.name"/>
                                </td>
                                <td style="text-align: center;">
                                    <t t-esc="'%.2f' % line.quantity"/> <t t-esc="line.product_uom_id.name"/>
                                </td>
                                <td style="text-align: right;">
                                    <t t-esc="'%.2f' % line.price_unit"/>
                                </td>
                                <td style="text-align: center;">
                                    <t t-esc="', '.join(line.tax_ids.mapped('name'))"/>
                                </td>
                                <td style="text-align: right;">
                                    <t t-esc="'%.2f' % line.price_subtotal"/> €
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Section paiement et totaux -->
                <table style="width: 100%;">
                    <tr>
                        <td style="width: 55%; vertical-align: top;">
                            <!-- Communication de paiement -->
                            <div class="lolirine-payment-info">
                                <t t-if="o.payment_reference">
                                    <strong>Communication de paiement : </strong>
                                    <span style="font-weight: bold;"><t t-esc="o.payment_reference"/></span><br/>
                                </t>
                                <t t-if="o.partner_bank_id">
                                    <strong>sur ce compte : </strong>
                                    <span style="font-weight: bold;"><t t-esc="o.partner_bank_id.acc_number"/></span>
                                    <t t-if="o.partner_bank_id.bank_id"> - <t t-esc="o.partner_bank_id.bank_id.name"/></t>
                                </t>
                            </div>

                            <!-- QR Code si disponible -->
                            <t t-if="o.display_qr_code and o.state == 'posted'">
                                <div style="margin-top: 15px;">
                                    <table>
                                        <tr>
                                            <td style="vertical-align: middle;">
                                                <t t-set="qr_code_urls" t-value="o._generate_qr_code()"/>
                                                <t t-if="qr_code_urls">
                                                    <img t-att-src="qr_code_urls.get('vals', {}).get('qr_code')" style="width: 100px; height: 100px;" alt="QR Code"/>
                                                </t>
                                            </td>
                                            <td style="vertical-align: middle; padding-left: 10px; font-size: 9pt;">
                                                Scanner le code QR avec<br/>votre application bancaire
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </t>
                        </td>
                        <td style="width: 45%; vertical-align: top;">
                            <!-- Totaux -->
                            <table class="lolirine-totals-table">
                                <tr>
                                    <td class="label-cell">Montant hors taxes</td>
                                    <td class="value-cell"><t t-esc="'%.2f' % o.amount_untaxed"/> €</td>
                                </tr>
                                <tr>
                                    <td class="label-cell">TVA 21%</td>
                                    <td class="value-cell"><t t-esc="'%.2f' % o.amount_tax"/> €</td>
                                </tr>
                                <tr class="total-row">
                                    <td>Total</td>
                                    <td class="value-cell"><t t-esc="'%.2f' % o.amount_total"/> €</td>
                                </tr>
                            </table>

                            <!-- Montant en lettres -->
                            <div class="lolirine-amount-words">
                                <strong>Montant total en toutes lettres :</strong><br/>
                                <t t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Conditions générales -->
                <div class="lolirine-conditions">
                    Conditions générales : <a t-att-href="'https://' + (o.company_id.website or 'lolirine-lolirine.odoo.com') + '/terms'">https://<t t-esc="o.company_id.website or 'lolirine-lolirine.odoo.com'"/>/terms</a>
                </div>

                <!-- Zone signature -->
                <div class="lolirine-signature">
                    Signataire autorisé
                </div>

                <!-- Pied de page -->
                <div class="lolirine-footer">
                    <t t-if="o.company_id.email">Email.: <t t-esc="o.company_id.email"/> </t>
                    <t t-if="o.company_id.website">site : http://<t t-esc="o.company_id.website"/> </t>
                    <t t-if="o.company_id.vat">TVA : <t t-esc="o.company_id.vat"/> </t>
                    <t t-if="o.company_id.partner_id.bank_ids">
                        <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.name or ''"/> : <t t-esc="o.company_id.partner_id.bank_ids[0].acc_number"/>.
                    </t>
                </div>

            </div>
        </div>

        <!-- Saut de page entre les factures -->
        <p style="page-break-after: always;"/>
    </template>
</odoo>
