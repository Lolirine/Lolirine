<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Vitrine du haut : deux rangées qui défilent en sens opposés ══
         Variable : pu_home -->
    <template id="home_showcase" name="Lolirine — Vitrine accueil (bloc)">
        <t t-set="pu_show" t-value="pu_home['showcase']"/>
        <section class="s_pu_showcase o_not_editable" aria-labelledby="pu-showcase-title">
            <div class="container s_pu_head">
                <div class="s_pu_intro">
                    <h2 id="pu-showcase-title" class="s_pu_title" t-out="pu_show['title']"/>
                    <p class="s_pu_subtitle" t-out="pu_show['subtitle']"/>
                </div>
                <nav class="s_pu_chips" aria-label="Univers de la boutique">
                    <t t-foreach="pu_show['links']" t-as="link">
                        <a class="s_pu_chip" t-att-href="link['url']" t-out="link['name']"/>
                    </t>
                    <a class="s_pu_chip s_pu_chip_shop" href="/shop">Toute la boutique</a>
                </nav>
            </div>
            <t t-foreach="pu_show['rows']" t-as="row">
                <div t-attf-class="s_pu_viewport s_pu_row #{'s_pu_reverse' if row['reverse'] else ''}"
                     t-attf-style="--pu-duration: #{row['duration']}s;">
                    <div class="s_pu_track">
                        <t t-foreach="[False, True]" t-as="pu_dup">
                            <ul class="s_pu_group" t-att-aria-hidden="'true' if pu_dup else None">
                                <t t-foreach="row['items']" t-as="item">
                                    <t t-call="lolirine_pool_universe.pool_universe_card"/>
                                </t>
                            </ul>
                        </t>
                    </div>
                </div>
            </t>
        </section>
    </template>

    <!-- ══ Tuiles « Explorez par univers » ══ -->
    <template id="home_tiles" name="Lolirine — Tuiles univers accueil (bloc)">
        <section class="s_pu_tiles_wrap o_not_editable" aria-labelledby="pu-tiles-title">
            <div class="container">
                <div class="s_pu_head">
                    <div class="s_pu_intro">
                        <h2 id="pu-tiles-title" class="s_pu_title">Explorez par univers</h2>
                        <p class="s_pu_subtitle">Choisissez un univers pour parcourir tous ses produits</p>
                    </div>
                </div>
                <ul class="s_pu_tiles">
                    <li t-foreach="pu_home['tiles']" t-as="tile">
                        <a class="s_pu_tile" t-att-href="tile['url']">
                            <span class="s_pu_tile_thumbs">
                                <t t-foreach="tile['thumbs']" t-as="thumb">
                                    <img t-att-src="thumb" alt="" loading="lazy" width="96" height="96"/>
                                </t>
                            </span>
                            <span class="s_pu_tile_name" t-out="tile['name']"/>
                            <span class="s_pu_tile_count"><t t-out="tile['count']"/> produits</span>
                        </a>
                    </li>
                </ul>
            </div>
        </section>
    </template>

    <!-- ══ Insertion sur la page d'accueil ══
         Haut : vitrine au-dessus du hero. Bas : tuiles + petits prix, avant le pied de page. -->
    <template id="home_universe_blocks"
              inherit_id="website.layout"
              name="Lolirine — Vitrines de la page d'accueil">
        <xpath expr="//main/*[1]" position="before">
            <t t-set="pu_home" t-value="website._lolirine_is_home() and website._lolirine_home_blocks()"/>
            <t t-if="pu_home and pu_home['showcase']">
                <t t-call="lolirine_pool_universe.home_showcase"/>
            </t>
        </xpath>
        <xpath expr="//main" position="inside">
            <div t-if="pu_home and (pu_home['tiles'] or pu_home['lowprice'])" class="s_pu_home_bottom">
                <t t-if="pu_home['tiles']">
                    <t t-call="lolirine_pool_universe.home_tiles"/>
                </t>
                <t t-if="pu_home['lowprice']">
                    <t t-set="pu_data" t-value="pu_home['lowprice']"/>
                    <t t-set="pu_reverse" t-value="False"/>
                    <t t-call="lolirine_pool_universe.pool_universe_marquee"/>
                </t>
            </div>
        </xpath>
    </template>

</odoo>
