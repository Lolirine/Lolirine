<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu principal de l'application -->
    <menuitem id="menu_lolirine_invoice_root"
              name="Factures Lolirine"
              sequence="25"
              web_icon="lolirine_invoice,static/description/icon.png"/>
    
    <!-- Sous-menu Factures -->
    <menuitem id="menu_lolirine_invoice_invoices"
              name="Factures"
              parent="menu_lolirine_invoice_root"
              sequence="10"/>
    
    <!-- Menu Toutes les factures -->
    <menuitem id="menu_lolirine_invoice_all"
              name="Toutes les factures"
              parent="menu_lolirine_invoice_invoices"
              action="action_lolirine_invoices"
              sequence="10"/>
    
    <!-- Menu Brouillons -->
    <menuitem id="menu_lolirine_invoice_draft"
              name="Brouillons a confirmer"
              parent="menu_lolirine_invoice_invoices"
              action="action_lolirine_invoices_draft"
              sequence="20"/>
    
    <!-- Menu Non envoyées email -->
    <menuitem id="menu_lolirine_invoice_not_sent"
              name="Non envoyees (email)"
              parent="menu_lolirine_invoice_invoices"
              action="action_lolirine_invoices_not_sent"
              sequence="25"/>
    
    <!-- Menu Non payées -->
    <menuitem id="menu_lolirine_invoice_unpaid"
              name="Non payees"
              parent="menu_lolirine_invoice_invoices"
              action="action_lolirine_invoices_unpaid"
              sequence="30"/>
    
    <!-- Sous-menu Peppol -->
    <menuitem id="menu_lolirine_invoice_peppol"
              name="Peppol"
              parent="menu_lolirine_invoice_root"
              sequence="15"/>
    
    <!-- Menu A envoyer Peppol -->
    <menuitem id="menu_lolirine_invoice_peppol_pending"
              name="A envoyer"
              parent="menu_lolirine_invoice_peppol"
              action="action_lolirine_invoices_peppol_pending"
              sequence="10"/>
    
    <!-- Menu Envoyées Peppol -->
    <menuitem id="menu_lolirine_invoice_peppol_sent"
              name="Envoyees"
              parent="menu_lolirine_invoice_peppol"
              action="action_lolirine_invoices_peppol_sent"
              sequence="20"/>
    
    <!-- Sous-menu Rapports -->
    <menuitem id="menu_lolirine_invoice_reports"
              name="Rapports"
              parent="menu_lolirine_invoice_root"
              sequence="20"/>
    
    <!-- Rapport Chiffre d'affaires (lien vers rapport comptable existant) -->
    <menuitem id="menu_lolirine_invoice_report_revenue"
              name="Analyse des ventes"
              parent="menu_lolirine_invoice_reports"
              action="account.action_account_invoice_report_all"
              sequence="10"/>
    
    <!-- Sous-menu Configuration -->
    <menuitem id="menu_lolirine_invoice_config"
              name="Configuration"
              parent="menu_lolirine_invoice_root"
              sequence="30"
              groups="base.group_system"/>
</odoo>
