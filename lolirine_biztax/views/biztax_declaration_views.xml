<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Declaration Form View -->
    <record id="biztax_declaration_view_form" model="ir.ui.view">
        <field name="name">biztax.declaration.form</field>
        <field name="model">biztax.declaration</field>
        <field name="arch" type="xml">
            <form string="Déclaration Biztax">
                <header>
                    <button name="action_compute" type="object" string="Calculer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Valider"
                            class="btn-primary" invisible="state != 'computed'"/>
                    <button name="action_generate_xbrl" type="object" string="Générer XBRL"
                            invisible="state != 'validated'"/>
                    <button name="action_generate_biztax" type="object" string="Télécharger .biztax"
                            class="btn-primary" invisible="state not in ('validated', 'generated')"/>
                    <button name="action_mark_submitted" type="object" string="Marquer comme soumis"
                            invisible="state != 'generated'" confirm="Confirmez-vous que la déclaration a été soumise via Biztax?"/>
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon"
                            invisible="state in ('draft', 'submitted')"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('submitted', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,validated,generated,submitted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Annexes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Identification">
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="vat_number"/>
                            <field name="enterprise_number"/>
                            <field name="declaration_type" readonly="state != 'draft'"/>
                            <field name="taxonomy_version" readonly="state != 'draft'"/>
                        </group>
                        <group string="Période fiscale">
                            <field name="fiscal_year_start" readonly="state != 'draft'"/>
                            <field name="fiscal_year_end" readonly="state != 'draft'"/>
                            <field name="assessment_year"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Cadre F - Première opération -->
                        <page string="Résultat comptable" name="accounting_result">
                            <group>
                                <group string="Résultat de l'exercice">
                                    <field name="accounting_profit"/>
                                    <field name="accounting_loss"/>
                                </group>
                                <group string="Affectations">
                                    <field name="reserves_start"/>
                                    <field name="reserves_end"/>
                                    <field name="reserves_movement"/>
                                    <field name="dividends_distributed"/>
                                    <field name="tantiemes"/>
                                </group>
                            </group>
                            <group>
                                <field name="first_operation_result" class="oe_highlight"/>
                            </group>
                        </page>

                        <!-- Cadre I & J - Ajustements -->
                        <page string="Ajustements fiscaux" name="adjustments">
                            <group>
                                <group>
                                    <field name="total_dna" class="text-danger"/>
                                </group>
                                <group>
                                    <field name="total_deductions" class="text-success"/>
                                </group>
                            </group>
                            <field name="adjustment_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="tax_code_id"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="adjustment_type"/>
                                    <field name="base_amount" optional="hide"/>
                                    <field name="dna_percentage" optional="hide"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="auto_imported" invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <button name="%(lolirine_biztax.action_biztax_import_wizard)d" 
                                        type="action" string="Importer des ajustements" 
                                        class="btn-secondary"
                                        context="{'default_declaration_id': active_id}"/>
                            </group>
                        </page>

                        <!-- Cadre K, L, M, N - Calcul impôt -->
                        <page string="Calcul de l'impôt" name="tax_calculation">
                            <group>
                                <group string="Base imposable">
                                    <field name="taxable_base" class="oe_highlight"/>
                                </group>
                                <group string="Paramètres">
                                    <field name="is_sme"/>
                                    <field name="tax_rate"/>
                                    <field name="tax_rate_reduced" invisible="not is_sme"/>
                                </group>
                            </group>
                            <group>
                                <group string="Impôt">
                                    <field name="tax_amount"/>
                                </group>
                                <group string="Versements anticipés">
                                    <field name="prepayments"/>
                                    <field name="prepayment_benefit"/>
                                </group>
                            </group>
                            <group>
                                <field name="balance_due" class="oe_highlight" style="font-size: 1.5em; font-weight: bold;"/>
                            </group>
                        </page>

                        <!-- Annexes -->
                        <page string="Annexes" name="attachments">
                            <field name="attachment_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="annex_type"/>
                                    <field name="name"/>
                                    <field name="file_name"/>
                                    <field name="file_size"/>
                                    <field name="auto_generated"/>
                                </list>
                            </field>
                            <group>
                                <button name="%(lolirine_biztax.action_biztax_attachment_wizard)d"
                                        type="action" string="Ajouter une annexe"
                                        class="btn-secondary"
                                        context="{'default_declaration_id': active_id}"/>
                            </group>
                        </page>

                        <!-- Fichiers générés -->
                        <page string="Fichiers" name="files" invisible="state == 'draft'">
                            <group>
                                <group string="Fichier XBRL">
                                    <field name="xbrl_file" filename="xbrl_filename"/>
                                    <field name="xbrl_filename" invisible="1"/>
                                </group>
                                <group string="Package Biztax">
                                    <field name="biztax_file" filename="biztax_filename"/>
                                    <field name="biztax_filename" invisible="1"/>
                                </group>
                            </group>
                            <group string="Validation" invisible="not validation_errors">
                                <field name="is_valid"/>
                                <field name="validation_errors" readonly="1"/>
                            </group>
                        </page>

                        <!-- Notes -->
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Declaration Tree View -->
    <record id="biztax_declaration_view_tree" model="ir.ui.view">
        <field name="name">biztax.declaration.tree</field>
        <field name="model">biztax.declaration</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" 
                  decoration-warning="state == 'computed'"
                  decoration-success="state == 'submitted'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="declaration_type"/>
                <field name="assessment_year"/>
                <field name="fiscal_year_start"/>
                <field name="fiscal_year_end"/>
                <field name="taxable_base" sum="Total"/>
                <field name="tax_amount" sum="Total"/>
                <field name="balance_due" sum="Total"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'computed'"
                       decoration-primary="state == 'validated'"
                       decoration-success="state in ('generated', 'submitted')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Declaration Search View -->
    <record id="biztax_declaration_view_search" model="ir.ui.view">
        <field name="name">biztax.declaration.search</field>
        <field name="model">biztax.declaration</field>
        <field name="arch" type="xml">
            <search string="Déclarations Biztax">
                <field name="name"/>
                <field name="company_id"/>
                <field name="assessment_year"/>
                <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_computed" string="Calculé" domain="[('state', '=', 'computed')]"/>
                <filter name="filter_validated" string="Validé" domain="[('state', '=', 'validated')]"/>
                <filter name="filter_generated" string="Généré" domain="[('state', '=', 'generated')]"/>
                <filter name="filter_submitted" string="Soumis" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="filter_isoc" string="ISOC" domain="[('declaration_type', '=', 'rcorp')]"/>
                <filter name="filter_ipm" string="IPM" domain="[('declaration_type', '=', 'rle')]"/>
                <filter name="filter_inr" string="INR" domain="[('declaration_type', '=', 'nrcorp')]"/>
                <separator/>
                <filter name="filter_current_year" string="Année en cours" 
                        domain="[('assessment_year', '=', context_today().year)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_company" string="Société" context="{'group_by': 'company_id'}"/>
                    <filter name="group_year" string="Exercice d'imposition" context="{'group_by': 'assessment_year'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'declaration_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Declaration Kanban View -->
    <record id="biztax_declaration_view_kanban" model="ir.ui.view">
        <field name="name">biztax.declaration.kanban</field>
        <field name="model">biztax.declaration</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="company_id"/>
                <field name="assessment_year"/>
                <field name="taxable_base"/>
                <field name="tax_amount"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'computed': 'warning', 'validated': 'primary', 'generated': 'success', 'submitted': 'success', 'cancelled': 'danger'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="company_id" groups="base.group_multi_company"/>
                                <div>EI <field name="assessment_year"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span>Base: <field name="taxable_base" widget="monetary"/></span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span>Impôt: <field name="tax_amount" widget="monetary"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_biztax_declaration" model="ir.actions.act_window">
        <field name="name">Déclarations Biztax</field>
        <field name="res_model">biztax.declaration</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première déclaration Biztax
            </p>
            <p>
                Ce module vous permet de générer les déclarations fiscales belges 
                (ISOC, IPM, INR) au format XBRL pour dépôt via Biztax.
            </p>
        </field>
    </record>

    <!-- Wizard Actions -->
    <record id="action_biztax_generate_wizard" model="ir.actions.act_window">
        <field name="name">Nouvelle déclaration</field>
        <field name="res_model">biztax.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
