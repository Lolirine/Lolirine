<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Définition du rapport -->
    <record id="action_report_invoice_lolirine" model="ir.actions.report">
        <field name="name">Facture Lolirine</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lolirine_invoice.report_invoice_lolirine</field>
        <field name="report_file">lolirine_invoice.report_invoice_lolirine</field>
        <field name="print_report_name">'Facture_%s' % (object.name or 'Brouillon').replace('/','_')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="lolirine_invoice.paperformat_lolirine"/>
    </record>

    <!-- Format de papier personnalisé avec marges réduites -->
    <record id="paperformat_lolirine" model="report.paperformat">
        <field name="name">Lolirine A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Template principal -->
    <template id="report_invoice_lolirine">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="lolirine_invoice.report_invoice_lolirine_document"/>
            </t>
        </t>
    </template>

    <!-- Document de facture -->
    <template id="report_invoice_lolirine_document">
        <style>
            @page {
                size: A4;
                margin: 10mm;
            }
            body {
                font-family: Arial, sans-serif;
                font-size: 9pt;
                color: #333;
                margin: 0;
                padding: 0;
            }
            .lolirine-invoice {
                width: 100%;
            }
            .lolirine-logo {
                max-height: 50px;
                max-width: 150px;
            }
            .lolirine-company-info {
                text-align: right;
                font-size: 8pt;
                line-height: 1.3;
            }
            .lolirine-slogan {
                color: #c0392b;
                font-style: italic;
                font-size: 9pt;
                margin-top: 3px;
            }
            .lolirine-client-block {
                margin: 10px 0;
                font-size: 9pt;
                line-height: 1.4;
            }
            .lolirine-title {
                color: #c0392b;
                font-size: 16pt;
                font-weight: bold;
                margin: 10px 0;
            }
            .lolirine-dates-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
                background-color: #f5f5f5;
            }
            .lolirine-dates-table td {
                padding: 5px 10px;
                border: 1px solid #ddd;
                font-size: 9pt;
            }
            .lolirine-dates-table .label {
                font-weight: bold;
                color: #333;
                font-size: 8pt;
            }
            .lolirine-main-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            .lolirine-main-table thead tr {
                background-color: #c0392b;
            }
            .lolirine-main-table thead th {
                padding: 6px 5px;
                text-align: left;
                font-weight: bold;
                border: none;
                background-color: #c0392b;
                color: white;
                font-size: 8pt;
            }
            .lolirine-main-table tbody td {
                padding: 6px 5px;
                border-bottom: 1px solid #eee;
                vertical-align: top;
                font-size: 9pt;
            }
            .lolirine-totals-table {
                width: 240px;
                margin-left: auto;
                border-collapse: collapse;
            }
            .lolirine-totals-table td {
                padding: 4px 8px;
                border: 1px solid #ddd;
                font-size: 9pt;
            }
            .lolirine-totals-table .label-cell {
                text-align: left;
                background-color: #f9f9f9;
            }
            .lolirine-totals-table .value-cell {
                text-align: right;
                min-width: 70px;
            }
            .lolirine-totals-table .total-row td {
                background-color: #c0392b;
                color: white;
                font-weight: bold;
                font-size: 10pt;
                border-color: #c0392b;
            }
            .lolirine-payment-info {
                margin: 8px 0;
                font-size: 9pt;
            }
            .lolirine-qr-code {
                text-align: center;
                margin-top: 5px;
            }
            .lolirine-qr-code img {
                width: 80px;
                height: 80px;
            }
            .lolirine-qr-code-label {
                font-size: 7pt;
                color: #666;
                margin-top: 2px;
            }
            .lolirine-amount-words {
                text-align: right;
                font-size: 8pt;
                margin-top: 5px;
            }
            .lolirine-conditions {
                margin-top: 8px;
                font-size: 8pt;
                color: #666;
            }
            .lolirine-signature {
                margin-top: 15px;
                border-top: 1px solid #333;
                width: 180px;
                margin-left: auto;
                padding-top: 3px;
                text-align: center;
                font-size: 8pt;
            }
            .lolirine-footer {
                margin-top: 10px;
                padding-top: 8px;
                border-top: 2px solid #c0392b;
                font-size: 7pt;
                color: #666;
                text-align: center;
            }
        </style>

        <div class="lolirine-invoice">
            <!-- En-tête -->
            <table style="width: 100%; margin-bottom: 5px;">
                <tr>
                    <td style="width: 50%; vertical-align: top;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="lolirine-logo" alt="Logo"/>
                        <div class="lolirine-slogan" t-if="o.company_id.report_header">
                            <t t-esc="o.company_id.report_header"/>
                        </div>
                    </td>
                    <td style="width: 50%; vertical-align: top;" class="lolirine-company-info">
                        <strong>Société <t t-esc="o.company_id.name"/></strong><br/>
                        <t t-if="o.company_id.street"><t t-esc="o.company_id.street"/><br/></t>
                        <t t-if="o.company_id.street2"><t t-esc="o.company_id.street2"/><br/></t>
                        <t t-if="o.company_id.zip"><t t-esc="o.company_id.zip"/> </t>
                        <t t-if="o.company_id.city"><t t-esc="o.company_id.city"/></t><br/>
                        <t t-if="o.company_id.country_id"><t t-esc="o.company_id.country_id.name"/></t>
                    </td>
                </tr>
            </table>

            <!-- Infos client -->
            <div class="lolirine-client-block">
                <strong><t t-esc="o.partner_id.name"/></strong><br/>
                <t t-if="o.partner_id.street"><t t-esc="o.partner_id.street"/><br/></t>
                <t t-if="o.partner_id.street2"><t t-esc="o.partner_id.street2"/><br/></t>
                <t t-if="o.partner_id.zip"><t t-esc="o.partner_id.zip"/> </t>
                <t t-if="o.partner_id.city"><t t-esc="o.partner_id.city"/><br/></t>
                <t t-if="o.partner_id.country_id"><t t-esc="o.partner_id.country_id.name"/></t>
            </div>

            <!-- Titre facture -->
            <div class="lolirine-title">
                <t t-if="o.state == 'draft'">Facture Brouillon</t>
                <t t-else="">
                    <t t-if="o.move_type == 'out_invoice'">Facture </t>
                    <t t-elif="o.move_type == 'out_refund'">Avoir </t>
                    <t t-esc="o.name or ''"/>
                </t>
            </div>

            <!-- Dates -->
            <table class="lolirine-dates-table">
                <tr>
                    <td style="width: 50%;">
                        <span class="label">Date de facturation</span><br/>
                        <t t-if="o.invoice_date"><t t-esc="o.invoice_date" t-options="{'widget': 'date'}"/></t>
                        <t t-else="">-</t>
                    </td>
                    <td style="width: 50%;">
                        <span class="label">Date d'échéance</span><br/>
                        <t t-if="o.invoice_date_due"><t t-esc="o.invoice_date_due" t-options="{'widget': 'date'}"/></t>
                        <t t-else="">-</t>
                    </td>
                </tr>
            </table>

            <!-- Tableau des lignes -->
            <table class="lolirine-main-table">
                <thead>
                    <tr>
                        <th style="width: 50%;">DESCRIPTION</th>
                        <th style="width: 12%; text-align: center;">QUANTITÉ</th>
                        <th style="width: 15%; text-align: right;">PRIX UNIT.</th>
                        <th style="width: 8%; text-align: center;">TAXES</th>
                        <th style="width: 15%; text-align: right;">MONTANT</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.invoice_line_ids.filtered(lambda l: l.product_id)" t-as="line">
                        <td><t t-esc="line.name or line.product_id.name or '-'"/></td>
                        <td style="text-align: center;"><t t-esc="line.quantity"/> <t t-esc="line.product_uom_id.name or ''"/></td>
                        <td style="text-align: right;"><t t-esc="'%.2f' % line.price_unit"/> €</td>
                        <td style="text-align: center;"><t t-esc="', '.join(line.tax_ids.mapped('name'))"/></td>
                        <td style="text-align: right;"><t t-esc="'%.2f' % line.price_subtotal"/> €</td>
                    </tr>
                </tbody>
            </table>

            <!-- Section paiement et totaux -->
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%; vertical-align: top;">
                        <!-- Communication de paiement -->
                        <div class="lolirine-payment-info">
                            <t t-if="o.payment_reference">
                                <strong>Communication de paiement :</strong><br/>
                                <span style="font-weight: bold;"><t t-esc="o.payment_reference"/></span><br/>
                            </t>
                            <t t-if="o.partner_bank_id">
                                <strong>sur ce compte : </strong>
                                <span style="font-weight: bold;"><t t-esc="o.partner_bank_id.acc_number"/></span>
                                <t t-if="o.partner_bank_id.bank_id"> - <t t-esc="o.partner_bank_id.bank_id.name"/></t>
                            </t>
                        </div>
                        
                        <!-- QR Code SEPA -->
                        <t t-if="o.display_qr_code and o.partner_bank_id">
                            <div class="lolirine-qr-code">
                                <t t-set="qr_code_url" t-value="o.partner_bank_id.build_qr_code_url(o.amount_residual or o.amount_total, o.ref or o.name, o.payment_reference, o.currency_id, o.partner_id)"/>
                                <img t-if="qr_code_url" t-att-src="qr_code_url" alt="QR Code SEPA"/>
                                <div class="lolirine-qr-code-label">
                                    Scannez pour payer par virement SEPA
                                </div>
                            </div>
                        </t>
                    </td>
                    <td style="width: 50%; vertical-align: top;">
                        <!-- Totaux -->
                        <table class="lolirine-totals-table">
                            <tr>
                                <td class="label-cell">Montant hors taxes</td>
                                <td class="value-cell"><t t-esc="'%.2f' % o.amount_untaxed"/> €</td>
                            </tr>
                            <tr>
                                <td class="label-cell">TVA 21%</td>
                                <td class="value-cell"><t t-esc="'%.2f' % o.amount_tax"/> €</td>
                            </tr>
                            <tr class="total-row">
                                <td>Total</td>
                                <td class="value-cell"><t t-esc="'%.2f' % o.amount_total"/> €</td>
                            </tr>
                        </table>
                        <!-- Montant en lettres -->
                        <div class="lolirine-amount-words">
                            <strong>Montant total en toutes lettres :</strong><br/>
                            <t t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Conditions générales -->
            <div class="lolirine-conditions">
                Conditions générales : <a href="https://lolirine-lolirine.odoo.com/terms">https://lolirine-lolirine.odoo.com/terms</a>
            </div>

            <!-- Zone signature -->
            <div class="lolirine-signature">
                Signataire autorisé
            </div>

            <!-- Pied de page -->
            <div class="lolirine-footer">
                <t t-if="o.company_id.email">Email: <t t-esc="o.company_id.email"/> | </t>
                <t t-if="o.company_id.website">Site: http://<t t-esc="o.company_id.website"/> | </t>
                <t t-if="o.company_id.vat">TVA: <t t-esc="o.company_id.vat"/> | </t>
                <t t-if="o.company_id.partner_id.bank_ids">
                    <t t-esc="o.company_id.partner_id.bank_ids[0].bank_id.name or ''"/>: <t t-esc="o.company_id.partner_id.bank_ids[0].acc_number"/>
                </t>
            </div>
        </div>
    </template>
</odoo>
