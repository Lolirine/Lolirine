<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- PAGE BOUTIQUE DYNAMIQUE                    -->
    <!-- ============================================ -->
    
    <template id="page_boutique_dynamic" name="Pool Store - Boutique (Dynamic)">
        <t t-call="website.layout">
            <div id="wrap" class="pool-shop-wrap">
                
                <!-- HERO -->
                <section class="pshop-hero">
                    <div class="container py-5">
                        <div class="row align-items-center min-vh-40 py-4">
                            <div class="col-lg-7">
                                <span class="pshop-badge">Boutique en ligne</span>
                                <h1 class="pshop-title">
                                    Tout pour votre<br/>
                                    <span class="pshop-highlight">piscine &amp; spa</span>
                                </h1>
                                <p class="pshop-subtitle">
                                    Découvrez notre sélection de produits de qualité professionnelle pour l'entretien et l'équipement de votre espace aquatique.
                                </p>
                                <div class="d-flex gap-3 flex-wrap">
                                    <a href="/shop" class="pshop-btn-primary">
                                        <i class="fa fa-shopping-bag me-2"/>Tous les produits
                                    </a>
                                    <a href="/pool/devis" class="pshop-btn-outline">
                                        <i class="fa fa-headset me-2"/>Besoin de conseils ?
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- SECTION: EXPLOREZ NOS UNIVERS -->
                <section class="py-5 bg-white">
                    <div class="container py-4">
                        <div class="text-center mb-5">
                            <h2 class="pshop-section-title">Explorez nos univers</h2>
                            <p class="pshop-section-subtitle">
                                Trouvez tout ce dont vous avez besoin, classé par catégorie.
                            </p>
                        </div>
                        
                        <div class="row g-4">
                            <!-- Boucle sur les univers -->
                            <t t-foreach="universes" t-as="universe">
                                <div class="col-lg-3 col-md-6">
                                    <a t-att-href="universe['page_url']" class="text-decoration-none">
                                        <div class="pshop-universe-card">
                                            <div class="pshop-universe-img">
                                                <!-- Image de catégorie si disponible -->
                                                <t t-if="universe.get('category') and universe['category'].image_1920">
                                                    <img t-att-src="'/web/image/product.public.category/%s/image_1920' % universe['category'].id"
                                                         t-att-alt="universe['name']"/>
                                                </t>
                                                <!-- Sinon placeholder -->
                                                <t t-else="">
                                                    <div class="pshop-universe-placeholder" t-att-style="'background: %s;' % universe['gradient']">
                                                        <i t-att-class="'fa %s' % universe['icon']"/>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="pshop-universe-overlay">
                                                <h4 t-esc="universe['name']"/>
                                                <span class="pshop-universe-link">Découvrir <i class="fa fa-arrow-right ms-1"/></span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
                
                <!-- SECTION: AVANTAGES -->
                <section class="py-5 pshop-bg-light">
                    <div class="container">
                        <div class="row g-4 text-center">
                            <div class="col-md-3 col-6">
                                <div class="pshop-advantage">
                                    <div class="pshop-advantage-icon">
                                        <i class="fa fa-truck"/>
                                    </div>
                                    <h5>Livraison rapide</h5>
                                    <p>Expédition sous 24-48h</p>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="pshop-advantage">
                                    <div class="pshop-advantage-icon">
                                        <i class="fa fa-shield-alt"/>
                                    </div>
                                    <h5>Paiement sécurisé</h5>
                                    <p>CB, Bancontact, PayPal</p>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="pshop-advantage">
                                    <div class="pshop-advantage-icon">
                                        <i class="fa fa-headset"/>
                                    </div>
                                    <h5>Conseils experts</h5>
                                    <p>Une équipe à votre écoute</p>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="pshop-advantage">
                                    <div class="pshop-advantage-icon">
                                        <i class="fa fa-medal"/>
                                    </div>
                                    <h5>Qualité pro</h5>
                                    <p>Produits sélectionnés</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- ZONE ÉDITABLE -->
                <div class="oe_structure oe_empty"/>
                
                <!-- CTA -->
                <section class="pshop-cta">
                    <div class="container py-5">
                        <div class="row align-items-center">
                            <div class="col-lg-8 mb-4 mb-lg-0">
                                <h2>Besoin d'un conseil personnalisé ?</h2>
                                <p>Notre équipe d'experts est là pour vous accompagner dans vos choix.</p>
                            </div>
                            <div class="col-lg-4 text-lg-end">
                                <a href="tel:+32497444146" class="pshop-btn-white">
                                    <i class="fa fa-phone me-2"/>+32 497 44 41 46
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
                
            </div>
        </t>
    </template>


    <!-- ============================================ -->
    <!-- TEMPLATE UNIVERS DYNAMIQUE (réutilisable)  -->
    <!-- ============================================ -->
    
    <template id="page_univers_dynamic" name="Pool Store - Page Univers (Dynamic)">
        <t t-call="website.layout">
            <div id="wrap" class="pool-shop-wrap">
                
                <!-- HERO -->
                <section t-att-class="'pshop-page-hero %s' % hero_class">
                    <div class="container py-5">
                        <nav class="pshop-breadcrumb">
                            <a href="/">Accueil</a> / <a href="/boutique">Boutique</a> / <span t-esc="universe_name"/>
                        </nav>
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <h1 t-esc="universe_name"/>
                                <p t-esc="universe_description"/>
                                <a t-att-href="parent_url" class="pshop-btn-light mt-3">
                                    <i class="fa fa-th me-2"/>Voir tous les produits
                                </a>
                            </div>
                            <div class="col-lg-4 text-center d-none d-lg-block">
                                <div class="pshop-page-icon">
                                    <i t-att-class="'fa %s' % universe_icon"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- SOUS-CATÉGORIES DYNAMIQUES -->
                <section class="py-5">
                    <div class="container">
                        <h2 class="pshop-content-title mb-4">Parcourir les catégories</h2>
                        
                        <div class="row g-4">
                            <t t-foreach="subcategories" t-as="subcat">
                                <div class="col-lg-4 col-md-6">
                                    <a t-att-href="subcat['url']" class="text-decoration-none">
                                        <div class="pshop-subcat-card">
                                            <div class="pshop-subcat-img">
                                                <!-- Image si disponible -->
                                                <t t-if="subcat.get('image')">
                                                    <img t-att-src="'/web/image/product.public.category/%s/image_1920' % subcat['id']"
                                                         t-att-alt="subcat['name']"/>
                                                </t>
                                                <!-- Sinon placeholder -->
                                                <t t-else="">
                                                    <div t-att-class="'pshop-subcat-placeholder pshop-bg-%s' % universe_color">
                                                        <i t-att-class="'fa %s' % subcat.get('icon', 'fa-box')"/>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="pshop-subcat-content">
                                                <h4 t-esc="subcat['name']"/>
                                                <p t-if="subcat.get('description')" t-esc="subcat['description']"/>
                                                <p t-else="">Voir nos produits</p>
                                                <span class="pshop-subcat-link">
                                                    Voir les produits <i class="fa fa-arrow-right ms-1"/>
                                                </span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                        
                        <!-- Message si pas de sous-catégories -->
                        <t t-if="not subcategories">
                            <div class="text-center py-5">
                                <i class="fa fa-inbox fa-3x text-muted mb-3"/>
                                <p class="text-muted">Les catégories seront bientôt disponibles.</p>
                                <a t-att-href="parent_url" class="pshop-btn-primary">
                                    Voir tous les produits
                                </a>
                            </div>
                        </t>
                        
                        <!-- Bouton voir tous -->
                        <t t-if="subcategories">
                            <div class="text-center mt-5">
                                <a t-att-href="parent_url" class="pshop-btn-primary">
                                    <i class="fa fa-th me-2"/>Voir tous les produits <t t-esc="universe_name"/>
                                </a>
                            </div>
                        </t>
                        
                        <div class="oe_structure oe_empty mt-5"/>
                    </div>
                </section>
                
            </div>
        </t>
    </template>

</odoo>
