<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hériter de la vue formulaire pour ajouter les boutons Documents -->
    <record id="view_lolirine_scan_tva_form_documents" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.form.documents</field>
        <field name="model">lolirine.scan.tva</field>
        <field name="inherit_id" ref="lolirine_scan_tva.view_lolirine_scan_tva_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter le bouton Archive dans les stat buttons -->
            <xpath expr="//button[@name='action_view_invoice']" position="after">
                <button name="action_view_document" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-folder-open"
                        invisible="not documents_document_id">
                    <span class="o_stat_text">Archive</span>
                </button>
            </xpath>
            
            <!-- Ajouter le bouton "Archiver dans Documents" dans la section Document -->
            <xpath expr="//field[@name='document_type']" position="after">
                <button name="action_archive_document" 
                        type="object" 
                        string="Archiver dans Documents"
                        class="btn-link"
                        icon="fa-archive"
                        invisible="documents_document_id or not document"/>
            </xpath>
        </field>
    </record>
</odoo>
