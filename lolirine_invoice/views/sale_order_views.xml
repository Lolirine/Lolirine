<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Bouton de résiliation avec prorata sur le formulaire abonnement -->
    <record id="sale_order_view_form_subscription_prorata" model="ir.ui.view">
        <field name="name">sale.order.form.subscription.prorata</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Ajouter le bouton après le bouton "Résilier" -->
            <xpath expr="//button[@name='set_close']" position="after">
                <button name="action_terminate_with_prorata" 
                        type="object" 
                        string="Résilier avec Prorata" 
                        class="btn-secondary"
                        invisible="subscription_state != '3_progress' or not end_date"
                        confirm="Êtes-vous sûr de vouloir créer une facture prorata et résilier cet abonnement ?"/>
                <button name="action_terminate_and_close" 
                        type="object" 
                        string="Résilier + Clôturer" 
                        class="btn-warning"
                        invisible="subscription_state != '3_progress' or not end_date"
                        confirm="Êtes-vous sûr de vouloir créer une facture prorata ET clôturer définitivement cet abonnement ?"/>
            </xpath>
        </field>
    </record>
    
</odoo>
