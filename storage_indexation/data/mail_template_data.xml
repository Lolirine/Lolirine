<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Template email pour notification d'indexation -->
        <record id="email_template_indexation_notification" model="mail.template">
            <field name="name">Indexation: Notification client</field>
            <field name="model_id" ref="storage_indexation.model_storage_indexation_line"/>
            <field name="subject">Avis d'indexation de votre contrat de stockage - {{ object.subscription_id.name }}</field>
            <field name="email_from">{{ (object.indexation_id.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px;">
    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; width: 100%;">
        <tr>
            <td align="center">
                <table border="0" cellpadding="0" cellspacing="0" width="590" style="background-color: white; padding: 20px;">
                    <tr>
                        <td>
                            <p style="margin: 0 0 10px 0;">Madame, Monsieur <strong>{{ object.partner_id.name }}</strong>,</p>
                            
                            <p style="margin: 0 0 16px 0;">
                                Conformément aux conditions générales de votre contrat de stockage et à la législation en vigueur,
                                nous vous informons de l'indexation annuelle de votre loyer.
                            </p>

                            <div style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; margin: 20px 0;">
                                <h3 style="margin: 0 0 15px 0; color: #495057;">Détails de l'indexation</h3>
                                
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;"><strong>Contrat:</strong></td>
                                        <td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;">{{ object.subscription_id.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;"><strong>Unité de stockage:</strong></td>
                                        <td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;">{{ object.product_id.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;"><strong>Indice de base:</strong></td>
                                        <td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;">{{ object.base_index_id.name }} ({{ "%.2f"|format(object.base_index_value) }})</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;"><strong>Nouvel indice:</strong></td>
                                        <td style="padding: 8px 0; border-bottom: 1px solid #dee2e6;">{{ object.indexation_id.new_index_id.name }} ({{ "%.2f"|format(object.new_index_value) }})</td>
                                    </tr>
                                </table>
                            </div>

                            <div style="background-color: #e3f2fd; padding: 15px; border-radius: 5px; margin: 20px 0;">
                                <h3 style="margin: 0 0 15px 0; color: #1565c0;">Modification du loyer</h3>
                                
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 8px 0;"><strong>Loyer actuel:</strong></td>
                                        <td style="padding: 8px 0; text-align: right;">{{ "%.2f"|format(object.old_price) }} €/mois</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0;"><strong>Nouveau loyer:</strong></td>
                                        <td style="padding: 8px 0; text-align: right; font-size: 18px; color: #1565c0;">
                                            <strong>{{ "%.2f"|format(object.new_price) }} €/mois</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #90caf9;"><em>Augmentation:</em></td>
                                        <td style="padding: 8px 0; border-top: 1px solid #90caf9; text-align: right;">
                                            {{ "%.2f"|format(object.price_increase) }} € (+{{ "%.2f"|format(object.increase_percentage) }}%)
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <p style="margin: 16px 0;">
                                <strong>Date d'application:</strong> {{ object.indexation_id.date.strftime('%d/%m/%Y') }}
                            </p>

                            <p style="margin: 16px 0;">
                                Cette indexation est calculée selon la formule légale belge:<br/>
                                <em>Nouveau loyer = Loyer de base × (Nouvel indice / Indice de base)</em>
                            </p>

                            <p style="margin: 16px 0;">
                                Pour toute question concernant cette indexation, n'hésitez pas à nous contacter.
                            </p>

                            <p style="margin: 20px 0 0 0;">
                                Cordialement,<br/>
                                <strong>{{ object.indexation_id.company_id.name }}</strong>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td align="center" style="padding: 20px;">
                <span style="font-size: 12px; color: #666;">
                    {{ object.indexation_id.company_id.name }}<br/>
                    {{ object.indexation_id.company_id.street or '' }} {{ object.indexation_id.company_id.street2 or '' }}<br/>
                    {{ object.indexation_id.company_id.zip or '' }} {{ object.indexation_id.company_id.city or '' }}<br/>
                    {{ object.indexation_id.company_id.phone or '' }} - {{ object.indexation_id.company_id.email or '' }}
                </span>
            </td>
        </tr>
    </table>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('action_report_indexation_notice'))]"/>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
