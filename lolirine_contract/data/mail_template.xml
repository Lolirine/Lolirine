<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="email_template_contract" model="mail.template" forcecreate="True">
    <field name="name">Contrat de Garde-Meubles</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
    <field name="email_to">{{ object.partner_id.email }}</field>
    <field name="subject">Votre contrat de garde-meubles - {{ object.name }}</field>
    <field name="body_html" type="html">
<![CDATA[
<div style="font-family: Arial, sans-serif;">
    <p>Bonjour,</p>
    <p>Nous avons le plaisir de vous transmettre votre contrat de location de garde-meubles.</p>
    <p>Vous trouverez en piece jointe votre contrat au format PDF.</p>
    <p>Cordialement,<br/>L equipe Lolirine</p>
</div>
]]>
    </field>
    <field name="report_template_ids" eval="[(4, ref('lolirine_contract.action_report_contract'))]"/>
    <field name="auto_delete" eval="False"/>
</record>
</odoo>
