<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Nettoyages et maintenance du hangar : trajets crees chaque jour.
             Inactif tant que le parametre km_expense.auto_hangar_active n'est pas a 1. -->
        <record id="ir_cron_km_trajets_hangar" model="ir.cron">
            <field name="name">IK : trajets nettoyage / maintenance du hangar</field>
            <field name="model_id" ref="model_km_trajet"/>
            <field name="state">code</field>
            <field name="code">model.cron_trajets_hangar()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
