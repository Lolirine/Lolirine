<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire CRM Lead - Ajout onglet Piscine -->
    <record id="crm_lead_view_form_pool" model="ir.ui.view">
        <field name="name">crm.lead.form.pool</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="🏊 Piscine" name="pool_info" invisible="not is_pool_request">
                    <group>
                        <group string="Service demandé">
                            <field name="is_pool_request" invisible="1"/>
                            <field name="pool_service_type"/>
                            <field name="pool_urgency"/>
                        </group>
                        <group string="Caractéristiques piscine">
                            <field name="pool_type"/>
                            <field name="pool_dimensions"/>
                            <field name="pool_volume"/>
                            <field name="pool_treatment"/>
                        </group>
                    </group>
                    <group string="Informations complémentaires">
                        <field name="pool_address" placeholder="Adresse de la piscine (si différente)"/>
                        <field name="pool_problem" placeholder="Description du besoin ou du problème"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Liste CRM - Ajout colonne Pool -->
    <record id="crm_lead_view_tree_pool" model="ir.ui.view">
        <field name="name">crm.lead.tree.pool</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contact_name']" position="after">
                <field name="is_pool_request" column_invisible="True"/>
                <field name="pool_service_type" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Filtre CRM - Ajout filtre Pool Store -->
    <record id="crm_lead_view_search_pool" model="ir.ui.view">
        <field name="name">crm.lead.search.pool</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='myactivities']" position="after">
                <separator/>
                <filter string="Pool Store" name="pool_store" domain="[('is_pool_request', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
