<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue de configuration -->
    <record id="res_config_settings_view_form_lolirine" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.lolirine</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Formulaire de Contact Lolirine" name="lolirine_contact_form_settings">
                    <setting string="Google Places API" help="Configurez la clé API Google pour l'autocomplétion des adresses">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="google_places_api_key" class="col-lg-3 o_light_label"/>
                                <field name="google_places_api_key" class="col-lg-9" placeholder="AIzaSy..."/>
                            </div>
                            <div class="text-muted mt-2">
                                <i class="fa fa-info-circle"/> 
                                Obtenez une clé sur 
                                <a href="https://console.cloud.google.com/apis/credentials" target="_blank">
                                    Google Cloud Console
                                </a>
                                et activez l'API "Places API".
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
    
</odoo>
