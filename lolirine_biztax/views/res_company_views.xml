<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company Form View for Biztax Settings -->
    <record id="view_company_biztax_form" model="ir.ui.view">
        <field name="name">res.company.biztax.form</field>
        <field name="model">res.company</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Paramètres Biztax">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Identification" name="identification">
                            <group>
                                <group string="Informations Légales">
                                    <field name="vat"/>
                                    <field name="company_registry"/>
                                    <field name="biztax_legal_form"/>
                                </group>
                                <group string="Contact Biztax">
                                    <field name="biztax_contact_name"/>
                                    <field name="biztax_contact_email"/>
                                    <field name="biztax_contact_phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Critères PME" name="sme_criteria">
                            <group>
                                <group string="Seuils Article 15 CDE">
                                    <field name="biztax_employee_count"/>
                                    <field name="biztax_annual_turnover"/>
                                    <field name="biztax_balance_sheet_total"/>
                                </group>
                                <group string="Statut">
                                    <field name="biztax_is_sme"/>
                                    <field name="biztax_is_group_member"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Critères PME (Art. 15 CDE) :</strong><br/>
                                Une société est une PME si elle ne dépasse pas plus d'un des critères suivants:
                                <ul>
                                    <li>Effectif annuel moyen: 50 ETP</li>
                                    <li>Chiffre d'affaires HTVA: 9.000.000 €</li>
                                    <li>Total du bilan: 4.500.000 €</li>
                                </ul>
                                Les PME peuvent bénéficier du taux réduit de 20% sur la première tranche de 100.000 € de bénéfice imposable.
                            </div>
                        </page>
                        <page string="Taux d'imposition" name="tax_rates">
                            <group>
                                <group string="Taux Applicables">
                                    <field name="biztax_standard_rate"/>
                                    <field name="biztax_reduced_rate"/>
                                    <field name="biztax_reduced_rate_limit"/>
                                </group>
                                <group string="Versements Anticipés">
                                    <field name="biztax_va_benefit_rate"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Extend standard company form with Biztax tab -->
    <record id="view_company_form_biztax" model="ir.ui.view">
        <field name="name">res.company.form.biztax</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Biztax" name="biztax" groups="lolirine_biztax.group_biztax_user">
                    <group>
                        <group string="Informations Légales">
                            <field name="biztax_legal_form"/>
                            <field name="biztax_is_sme"/>
                            <field name="biztax_is_group_member"/>
                        </group>
                        <group string="Contact Biztax">
                            <field name="biztax_contact_name"/>
                            <field name="biztax_contact_email"/>
                            <field name="biztax_contact_phone"/>
                        </group>
                    </group>
                    <group>
                        <group string="Critères PME (Art. 15 CDE)">
                            <field name="biztax_employee_count"/>
                            <field name="biztax_annual_turnover"/>
                            <field name="biztax_balance_sheet_total"/>
                        </group>
                        <group string="Taux d'imposition">
                            <field name="biztax_standard_rate"/>
                            <field name="biztax_reduced_rate"/>
                            <field name="biztax_reduced_rate_limit"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
