<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_missing_invoice_lines_list" model="ir.ui.view">
        <field name="name">lolirine.missing.invoice.lines.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" default_order="date desc"
                  decoration-bf="x_invoice_priority">
                <field name="date"/>
                <field name="journal_id"/>
                <field name="payment_ref"/>
                <field name="partner_id"/>
                <field name="x_expected_partner_id" string="Fournisseur identifié"
                       optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="x_invoice_priority" widget="boolean_toggle"
                       string="À réclamer" readonly="1" optional="show"/>
                <field name="x_invoice_status" widget="badge"
                       decoration-danger="x_invoice_status == 'missing'"
                       decoration-warning="x_invoice_status == 'invoiced'"
                       decoration-success="x_invoice_status == 'found'"
                       decoration-info="x_invoice_status == 'reconciled'"
                       decoration-muted="x_invoice_status in ['no_invoice', 'na']"/>
                <field name="x_matched_move_ids" widget="many2many_tags"
                       string="Factures liées" optional="show"/>
                <field name="x_invoice_candidate_ids" widget="many2many_tags"
                       string="Candidates" optional="hide"/>
                <button name="action_open_candidates" type="object"
                        string="Voir factures" icon="fa-search"
                        invisible="x_invoice_status not in ['found', 'invoiced', 'reconciled']"/>
                <button name="action_x_link_single_candidate" type="object"
                        string="Rapprocher" icon="fa-link"
                        invisible="x_invoice_status != 'found'"/>
            </list>
        </field>
    </record>

    <record id="view_missing_invoice_lines_search" model="ir.ui.view">
        <field name="name">lolirine.missing.invoice.lines.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="payment_ref"/>
                <field name="partner_id"/>
                <field name="amount"/>

                <field name="x_expected_partner_id"/>
                <filter name="filter_priority" string="À réclamer (fournisseur connu)"
                        domain="[('x_invoice_priority', '=', True)]"/>
                <filter name="filter_missing" string="Factures manquantes"
                        domain="[('x_invoice_status', '=', 'missing')]"/>
                <filter name="filter_found" string="Facture candidate trouvée"
                        domain="[('x_invoice_status', '=', 'found')]"/>
                <filter name="filter_invoiced" string="Facture déjà soldée"
                        domain="[('x_invoice_status', '=', 'invoiced')]"/>
                <filter name="filter_no_invoice" string="Sans facture attendue"
                        domain="[('x_invoice_status', '=', 'no_invoice')]"/>
                <filter name="filter_reconciled" string="Déjà rapprochées"
                        domain="[('x_invoice_status', '=', 'reconciled')]"/>
                <separator/>
                <filter name="filter_unreconciled" string="Non rapprochées"
                        domain="[('is_reconciled', '=', False)]"/>
                <separator/>
                <filter name="filter_out" string="Sorties (fournisseurs)"
                        domain="[('amount', '&lt;', 0)]"/>
                <filter name="filter_in" string="Entrées (clients)"
                        domain="[('amount', '&gt;', 0)]"/>
                <separator/>
                <filter name="group_journal" string="Journal"
                        context="{'group_by': 'journal_id'}"/>
                <filter name="group_partner" string="Partenaire"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_month" string="Mois"
                        context="{'group_by': 'date:month'}"/>
                <filter name="group_status" string="Statut facture"
                        context="{'group_by': 'x_invoice_status'}"/>
                <filter name="group_expected" string="Fournisseur identifié"
                        context="{'group_by': 'x_expected_partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_missing_invoice_lines" model="ir.actions.act_window">
        <field name="name">Factures manquantes</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_missing_invoice_lines_list"/>
        <field name="search_view_id" ref="view_missing_invoice_lines_search"/>
        <field name="domain">[('state', '=', 'posted')]</field>
        <field name="context">{'search_default_filter_missing': 1, 'search_default_filter_out': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune facture manquante !
            </p>
            <p>Toutes les transactions bancaires attendant une facture en ont une
               dans la base. Retire le filtre pour voir les transactions déjà
               rapprochées, celles dont la facture est déjà soldée, et celles qui
               n'attendent aucune facture.</p>
        </field>
    </record>

    <record id="action_link_single_candidate" model="ir.actions.server">
        <field name="name">Rapprocher les candidates uniques</field>
        <field name="model_id" ref="account.model_account_bank_statement_line"/>
        <field name="binding_model_id" ref="account.model_account_bank_statement_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_x_link_single_candidate()</field>
    </record>

    <menuitem id="menu_missing_invoice_lines"
              name="Factures manquantes"
              parent="account.menu_finance_payables"
              action="action_missing_invoice_lines"
              sequence="25"/>

</odoo>
