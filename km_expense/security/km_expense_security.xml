<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Règle multi-société -->
        <record id="km_trajet_company_rule" model="ir.rule">
            <field name="name">Trajets: regle societe</field>
            <field name="model_id" ref="model_km_trajet"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="km_expense_company_rule" model="ir.rule">
            <field name="name">Feuilles IK: regle societe</field>
            <field name="model_id" ref="model_km_expense"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="km_bareme_company_rule" model="ir.rule">
            <field name="name">Baremes: regle societe</field>
            <field name="model_id" ref="model_km_bareme"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
