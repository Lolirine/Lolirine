<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- PAGE : DEMANDE DE DEVIS                    -->
    <!-- ============================================ -->
    
    <template id="page_pool_devis" name="Pool Store - Demande de devis">
        <t t-call="website.layout">
            <div id="wrap">
                
                <!-- HERO -->
                <section class="pool-page-hero pool-hero-dark">
                    <div class="container py-5">
                        <div class="row align-items-center">
                            <div class="col-lg-7">
                                <h1>Demande de devis</h1>
                                <p>Décrivez votre projet et recevez une estimation personnalisée sous 24h.</p>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- FORMULAIRE -->
                <section class="py-5">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                
                                <div class="pool-form-card">
                                    <form action="/pool/devis/submit" method="POST" class="pool-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        
                                        <!-- SECTION 1: VOS COORDONNÉES -->
                                        <div class="pool-form-section">
                                            <h4><span class="pool-form-step">1</span> Vos coordonnées</h4>
                                            
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label">Nom complet *</label>
                                                    <input type="text" name="name" class="form-control" required="" placeholder="Jean Dupont"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Téléphone *</label>
                                                    <input type="tel" name="phone" class="form-control" required="" placeholder="+32 470 12 34 56"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Email *</label>
                                                    <input type="email" name="email" class="form-control" required="" placeholder="jean.dupont@email.be"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Adresse de la piscine</label>
                                                    <input type="text" name="address" class="form-control" placeholder="Rue, numéro, code postal, ville"/>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- SECTION 2: VOTRE DEMANDE -->
                                        <div class="pool-form-section">
                                            <h4><span class="pool-form-step">2</span> Votre demande</h4>
                                            
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label">Service souhaité *</label>
                                                    <select name="service_type" class="form-select" required="">
                                                        <option value="">-- Sélectionnez --</option>
                                                        <optgroup label="Services">
                                                            <option value="entretien" t-att-selected="preselected_service == 'entretien'">Entretien &amp; Réparation</option>
                                                            <option value="construction" t-att-selected="preselected_service == 'construction'">Construction &amp; Rénovation</option>
                                                            <option value="analyse" t-att-selected="preselected_service == 'analyse'">Analyse de l'eau</option>
                                                            <option value="hivernage" t-att-selected="preselected_service == 'hivernage'">Hivernage</option>
                                                            <option value="estivage" t-att-selected="preselected_service == 'estivage'">Remise en service (estivage)</option>
                                                        </optgroup>
                                                        <optgroup label="Formules">
                                                            <option value="contrat_ponctuel" t-att-selected="preselected_service == 'contrat_ponctuel'">Visite Ponctuelle</option>
                                                            <option value="contrat_saison" t-att-selected="preselected_service == 'contrat_saison'">Contrat Saison</option>
                                                            <option value="contrat_annuel" t-att-selected="preselected_service == 'contrat_annuel'">Contrat Annuel</option>
                                                        </optgroup>
                                                        <option value="autre">Autre demande</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Urgence</label>
                                                    <select name="urgency" class="form-select">
                                                        <option value="low">Pas urgent</option>
                                                        <option value="medium" selected="">Dans le mois</option>
                                                        <option value="high">Urgent (cette semaine)</option>
                                                        <option value="critical">Très urgent (immédiat)</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- SECTION 3: VOTRE PISCINE -->
                                        <div class="pool-form-section">
                                            <h4><span class="pool-form-step">3</span> Votre piscine <small class="text-muted">(optionnel)</small></h4>
                                            
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label">Type de piscine</label>
                                                    <select name="pool_type" class="form-select">
                                                        <option value="">-- Non renseigné --</option>
                                                        <option value="enterree">Piscine enterrée</option>
                                                        <option value="hors_sol">Piscine hors-sol</option>
                                                        <option value="semi_enterree">Piscine semi-enterrée</option>
                                                        <option value="interieure">Piscine intérieure</option>
                                                        <option value="naturelle">Piscine naturelle / baignade</option>
                                                        <option value="autre">Autre</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Dimensions (L x l x P)</label>
                                                    <input type="text" name="dimensions" class="form-control" placeholder="ex: 10m x 5m x 1.5m"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Traitement actuel</label>
                                                    <select name="treatment" class="form-select">
                                                        <option value="">-- Non renseigné --</option>
                                                        <option value="chlore">Chlore</option>
                                                        <option value="sel">Électrolyse au sel</option>
                                                        <option value="brome">Brome</option>
                                                        <option value="oxygene">Oxygène actif</option>
                                                        <option value="uv">UV</option>
                                                        <option value="autre">Autre</option>
                                                        <option value="inconnu">Je ne sais pas</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- SECTION 4: DESCRIPTION -->
                                        <div class="pool-form-section">
                                            <h4><span class="pool-form-step">4</span> Décrivez votre besoin</h4>
                                            
                                            <div class="mb-3">
                                                <label class="form-label">Votre message *</label>
                                                <textarea name="problem" class="form-control" rows="5" required="" placeholder="Décrivez votre projet, problème rencontré, questions..."></textarea>
                                            </div>
                                        </div>
                                        
                                        <!-- SUBMIT -->
                                        <div class="text-center mt-4">
                                            <button type="submit" class="pool-btn-primary pool-btn-lg">
                                                <i class="fa fa-paper-plane me-2"/>Envoyer ma demande
                                            </button>
                                            <p class="text-muted small mt-3">
                                                <i class="fa fa-lock me-1"/>Vos données sont traitées de manière confidentielle.
                                            </p>
                                        </div>
                                        
                                    </form>
                                </div>
                                
                            </div>
                            
                            <!-- SIDEBAR INFO -->
                            <div class="col-lg-4 mt-4 mt-lg-0">
                                <div class="pool-sidebar">
                                    <h5>Besoin d'aide ?</h5>
                                    <p>Notre équipe est disponible pour répondre à vos questions.</p>
                                    <hr/>
                                    <div class="pool-sidebar-contact">
                                        <p>
                                            <i class="fa fa-phone me-2"/>
                                            <a href="tel:+32497444146">+32 497 44 41 46</a>
                                        </p>
                                        <p>
                                            <i class="fa fa-envelope me-2"/>
                                            <a href="mailto:info@lolirinepoolstore.be">info@lolirinepoolstore.be</a>
                                        </p>
                                        <p>
                                            <i class="fa fa-clock me-2"/>
                                            <span class="text-muted">Réponse sous 24h</span>
                                        </p>
                                    </div>
                                </div>
                                
                                <div class="pool-sidebar mt-4">
                                    <h5><i class="fa fa-shield-alt me-2"/>Nos engagements</h5>
                                    <ul class="pool-checklist">
                                        <!-- PLACEHOLDER -->
                                        <li><i class="fa fa-check"/>Devis gratuit et sans engagement</li>
                                        <li><i class="fa fa-check"/>Réponse sous 24h</li>
                                        <li><i class="fa fa-check"/>Techniciens qualifiés</li>
                                        <li><i class="fa fa-check"/>Intervention rapide</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                
            </div>
        </t>
    </template>


    <!-- ============================================ -->
    <!-- PAGE : CONFIRMATION ENVOI                  -->
    <!-- ============================================ -->
    
    <template id="page_pool_devis_success" name="Pool Store - Devis envoyé">
        <t t-call="website.layout">
            <div id="wrap">
                <section class="py-5">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-6 text-center">
                                
                                <div class="pool-success-card">
                                    <div class="pool-success-icon">
                                        <i class="fa fa-check-circle"/>
                                    </div>
                                    <h1>Merci <t t-esc="name"/> !</h1>
                                    <p class="lead">Votre demande de devis a bien été envoyée.</p>
                                    <p class="text-muted">
                                        Notre équipe va étudier votre demande et vous recontactera dans les plus brefs délais (généralement sous 24h ouvrées).
                                    </p>
                                    <hr/>
                                    <p>
                                        <strong>Une question urgente ?</strong><br/>
                                        Appelez-nous au <a href="tel:+32497444146">+32 497 44 41 46</a>
                                    </p>
                                    <div class="mt-4">
                                        <a href="/services" class="pool-btn-secondary me-2">
                                            <i class="fa fa-arrow-left me-2"/>Retour aux services
                                        </a>
                                        <a href="/" class="pool-btn-primary">
                                            <i class="fa fa-home me-2"/>Accueil
                                        </a>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>


    <!-- ============================================ -->
    <!-- PAGE : ERREUR ENVOI                        -->
    <!-- ============================================ -->
    
    <template id="page_pool_devis_error" name="Pool Store - Erreur devis">
        <t t-call="website.layout">
            <div id="wrap">
                <section class="py-5">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-6 text-center">
                                
                                <div class="pool-error-card">
                                    <div class="pool-error-icon">
                                        <i class="fa fa-exclamation-triangle"/>
                                    </div>
                                    <h1>Oups !</h1>
                                    <p class="lead">Une erreur s'est produite lors de l'envoi.</p>
                                    <p class="text-muted">
                                        Veuillez réessayer ou nous contacter directement.
                                    </p>
                                    <hr/>
                                    <p>
                                        <strong>Contactez-nous directement :</strong><br/>
                                        <i class="fa fa-phone me-2"/>
                                        <a href="tel:+32497444146">+32 497 44 41 46</a><br/>
                                        <i class="fa fa-envelope me-2"/>
                                        <a href="mailto:info@lolirinepoolstore.be">info@lolirinepoolstore.be</a>
                                    </p>
                                    <div class="mt-4">
                                        <a href="/pool/devis" class="pool-btn-primary">
                                            <i class="fa fa-redo me-2"/>Réessayer
                                        </a>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
