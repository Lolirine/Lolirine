<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste des indices -->
    <record id="view_storage_price_index_tree" model="ir.ui.view">
        <field name="name">storage.price.index.tree</field>
        <field name="model">storage.price.index</field>
        <field name="arch" type="xml">
            <list string="Indices de prix">
                <field name="name"/>
                <field name="index_type"/>
                <field name="date"/>
                <field name="value" decoration-bf="1"/>
                <field name="base_year"/>
                <field name="source"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire des indices -->
    <record id="view_storage_price_index_form" model="ir.ui.view">
        <field name="name">storage.price.index.form</field>
        <field name="model">storage.price.index</field>
        <field name="arch" type="xml">
            <form string="Indice de prix">
                <header>
                    <button name="action_fetch_from_statbel" type="object" 
                            string="Récupérer depuis Statbel" 
                            class="btn-primary"
                            invisible="index_type != 'health'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Référence de l'indice"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="index_type"/>
                            <field name="date"/>
                            <field name="value"/>
                            <field name="base_year"/>
                        </group>
                        <group string="Métadonnées">
                            <field name="source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notes ou commentaires..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="view_storage_price_index_search" model="ir.ui.view">
        <field name="name">storage.price.index.search</field>
        <field name="model">storage.price.index</field>
        <field name="arch" type="xml">
            <search string="Rechercher un indice">
                <field name="name"/>
                <field name="date"/>
                <field name="value"/>
                <separator/>
                <filter string="Indice Santé" name="filter_health" domain="[('index_type', '=', 'health')]"/>
                <filter string="CPI" name="filter_cpi" domain="[('index_type', '=', 'cpi')]"/>
                <filter string="Personnalisé" name="filter_custom" domain="[('index_type', '=', 'custom')]"/>
                <separator/>
                <filter string="Cette année" name="filter_this_year" domain="[('year', '=', ((context_today()).year))]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Type" name="group_type" context="{'group_by': 'index_type'}"/>
                    <filter string="Année" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue graphique -->
    <record id="view_storage_price_index_graph" model="ir.ui.view">
        <field name="name">storage.price.index.graph</field>
        <field name="model">storage.price.index</field>
        <field name="arch" type="xml">
            <graph string="Évolution des indices" type="line">
                <field name="date" type="row"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_storage_price_index" model="ir.actions.act_window">
        <field name="name">Indices de prix</field>
        <field name="res_model">storage.price.index</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="view_storage_price_index_search"/>
        <field name="context">{'search_default_filter_health': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier indice de prix
            </p>
            <p>
                Les indices de prix sont utilisés pour calculer l'indexation automatique des loyers.
                Vous pouvez récupérer automatiquement l'indice santé belge depuis Statbel.
            </p>
        </field>
    </record>
</odoo>
