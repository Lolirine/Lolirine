<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Séquence pour les indexations -->
        <record id="sequence_storage_indexation" model="ir.sequence">
            <field name="name">Indexation Stockage</field>
            <field name="code">storage.indexation</field>
            <field name="prefix">IDX/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
