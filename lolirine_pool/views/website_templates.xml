<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Page d'accueil du site piscine -->
    <template id="pool_homepage" name="Accueil Piscine">
        <t t-call="website.layout">
            <div id="wrap" class="pool-homepage">
                
                <!-- Hero Section -->
                <section class="pool-hero text-center py-5">
                    <div class="container">
                        <h1 class="display-4">Bienvenue chez Lolirine Pool</h1>
                        <p class="lead">Votre spécialiste en matériel de piscine en Belgique</p>
                        <a href="/shop" class="btn btn-primary btn-lg mt-3">Découvrir nos produits</a>
                    </div>
                </section>

                <!-- Catégories -->
                <section class="pool-categories py-5 bg-light">
                    <div class="container">
                        <h2 class="text-center mb-4">Nos catégories</h2>
                        <div class="row">
                            <t t-foreach="request.env['pool.product.category'].sudo().search([('parent_id', '=', False)], limit=9)" t-as="cat">
                                <div class="col-md-4 mb-4">
                                    <div class="card h-100 text-center pool-category-card">
                                        <div class="card-body">
                                            <i t-attf-class="fa #{cat.icon or 'fa-cube'} fa-3x mb-3 text-primary"/>
                                            <h5 class="card-title" t-field="cat.name"/>
                                            <p class="card-text text-muted" t-field="cat.description"/>
                                            <a t-attf-href="/shop?category=#{cat.product_category_id.id if cat.product_category_id else ''}" 
                                               class="btn btn-outline-primary">
                                                Voir les produits
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- Marques -->
                <section class="pool-brands py-5">
                    <div class="container">
                        <h2 class="text-center mb-4">Nos marques partenaires</h2>
                        <div class="row justify-content-center align-items-center">
                            <t t-foreach="request.env['pool.brand'].sudo().search([], limit=6)" t-as="brand">
                                <div class="col-4 col-md-2 mb-3 text-center">
                                    <t t-if="brand.logo">
                                        <img t-att-src="image_data_uri(brand.logo)" 
                                             t-att-alt="brand.name" 
                                             class="img-fluid pool-brand-logo"
                                             style="max-height: 60px;"/>
                                    </t>
                                    <t t-else="">
                                        <span class="h6" t-field="brand.name"/>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- Avantages -->
                <section class="pool-advantages py-5 bg-primary text-white">
                    <div class="container">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <i class="fa fa-truck fa-3x mb-3"/>
                                <h5>Livraison rapide</h5>
                                <p>Partout en Belgique</p>
                            </div>
                            <div class="col-md-3">
                                <i class="fa fa-headset fa-3x mb-3"/>
                                <h5>Conseil expert</h5>
                                <p>Équipe spécialisée</p>
                            </div>
                            <div class="col-md-3">
                                <i class="fa fa-shield-alt fa-3x mb-3"/>
                                <h5>Garantie</h5>
                                <p>Produits garantis</p>
                            </div>
                            <div class="col-md-3">
                                <i class="fa fa-euro-sign fa-3x mb-3"/>
                                <h5>Meilleurs prix</h5>
                                <p>Prix compétitifs</p>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <!-- 
    NOTE: Cette syntaxe d'assets est obsolète en Odoo 19.
    Les assets sont déjà définis dans le __manifest__.py via 'assets': {...}
    
    <template id="pool_assets_frontend" inherit_id="website.assets_frontend" name="Pool Frontend Assets">
        <xpath expr="." position="inside">
            <link rel="stylesheet" href="/lolirine_pool/static/src/css/pool_theme.css"/>
            <script src="/lolirine_pool/static/src/js/pool_shop.js"/>
        </xpath>
    </template>
    -->

</odoo>
