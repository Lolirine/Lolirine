<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Generate Rent Wizard Form View -->
    <record id="apartment_generate_rent_wizard_view_form" model="ir.ui.view">
        <field name="name">apartment.generate.rent.wizard.view.form</field>
        <field name="model">apartment.generate.rent.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer les loyers">
                <group>
                    <group string="Bail">
                        <field name="lease_id" options="{'no_create': True}"/>
                        <field name="property_id" readonly="1"/>
                        <field name="tenant_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Montants actuels">
                        <field name="current_rent" widget="monetary"/>
                        <field name="charges" widget="monetary"/>
                    </group>
                </group>
                
                <group string="Paramètres de génération">
                    <group>
                        <field name="generation_mode" widget="radio"/>
                    </group>
                </group>
                
                <group invisible="generation_mode != 'single'">
                    <group string="Mois à générer">
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                </group>
                
                <group invisible="generation_mode != 'range'">
                    <group string="Période">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                
                <group>
                    <group>
                        <field name="skip_existing"/>
                    </group>
                </group>
                
                <group string="Aperçu" col="4">
                    <field name="preview_count"/>
                    <field name="preview_total" widget="monetary"/>
                </group>
                
                <footer>
                    <button name="action_generate" string="Générer les loyers" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Generate Rent Wizard Action -->
    <record id="apartment_generate_rent_wizard_action" model="ir.actions.act_window">
        <field name="name">Générer les loyers</field>
        <field name="res_model">apartment.generate.rent.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
