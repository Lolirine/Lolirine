<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================= POOL.CATALOG.PDF.IMAGE VIEWS ======================= -->
    
    <!-- Vue Kanban des images extraites -->
    <record id="view_pool_catalog_pdf_image_kanban" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.image.kanban</field>
        <field name="model">pool.catalog.pdf.image</field>
        <field name="arch" type="xml">
            <kanban default_group_by="role" quick_create="false" class="o_image_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="role"/>
                <field name="image_final"/>
                <field name="matched_product_id"/>
                <field name="quality_score"/>
                <field name="confidence_score"/>
                <field name="page_number"/>
                <field name="image_variant"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click" style="width: 220px;">
                            <!-- Image principale -->
                            <div class="o_kanban_image" style="height: 150px; position: relative;">
                                <img t-att-src="kanban_image('pool.catalog.pdf.image', 'image_final', record.id.raw_value)" 
                                     alt="Image produit" style="max-width: 100%; max-height: 100%; object-fit: contain;"/>
                                
                                <!-- Badge rôle -->
                                <span t-att-class="'badge position-absolute top-0 start-0 m-1 ' + 
                                    (record.role.raw_value == 'primary' ? 'bg-warning' : 
                                     record.role.raw_value == 'secondary' ? 'bg-info' :
                                     record.role.raw_value == 'rejected' ? 'bg-danger' : 'bg-secondary')">
                                    <t t-if="record.role.raw_value == 'primary'">🌟 Principale</t>
                                    <t t-elif="record.role.raw_value == 'secondary'">📷 Secondaire</t>
                                    <t t-elif="record.role.raw_value == 'rejected'">❌ Rejetée</t>
                                    <t t-else="">❓ Non attribuée</t>
                                </span>
                                
                                <!-- Score qualité -->
                                <div class="position-absolute bottom-0 end-0 m-1 small bg-dark text-white px-1 rounded">
                                    Q: <t t-esc="record.quality_score.value"/>
                                </div>
                            </div>
                            
                            <!-- Contenu -->
                            <div class="oe_kanban_details p-2">
                                <div class="o_kanban_record_title">
                                    <strong><t t-esc="record.name.value"/></strong>
                                </div>
                                
                                <div class="text-muted small">
                                    Page <t t-esc="record.page_number.value"/> • 
                                    <t t-esc="record.image_variant.value"/>
                                </div>
                                
                                <div t-if="record.matched_product_id.value" class="text-info small">
                                    <i class="fa fa-link"/> <t t-esc="record.matched_product_id.value"/>
                                    <span class="text-muted">(conf: <t t-esc="Math.round(record.confidence_score.value * 100)"/>%)</span>
                                </div>
                                
                                <!-- Actions rapides -->
                                <div class="mt-2">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="object" name="action_set_primary" 
                                                class="btn btn-outline-warning btn-sm"
                                                t-if="record.role.raw_value != 'primary'"
                                                title="Définir comme principale">
                                            <i class="fa fa-star"/>
                                        </button>
                                        <button type="object" name="action_set_secondary" 
                                                class="btn btn-outline-info btn-sm"
                                                t-if="record.role.raw_value != 'secondary'"
                                                title="Définir comme secondaire">
                                            <i class="fa fa-camera"/>
                                        </button>
                                        <button type="object" name="action_set_rejected" 
                                                class="btn btn-outline-danger btn-sm"
                                                t-if="record.role.raw_value != 'rejected'"
                                                title="Rejeter cette image">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Vue Liste des images -->
    <record id="view_pool_catalog_pdf_image_list" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.image.list</field>
        <field name="model">pool.catalog.pdf.image</field>
        <field name="arch" type="xml">
            <list string="Images extraites" decoration-info="role == 'primary'" 
                  decoration-muted="role == 'rejected'" sample="1">
                <field name="name"/>
                <field name="page_number"/>
                <field name="matched_product_id"/>
                <field name="role" widget="badge" 
                       decoration-warning="role == 'primary'"
                       decoration-info="role == 'secondary'"
                       decoration-danger="role == 'rejected'"/>
                <field name="quality_score" widget="progressbar"/>
                <field name="confidence_score" widget="progressbar"/>
                <field name="image_variant"/>
                <field name="file_size_kb" string="Taille (KB)"/>
                <field name="original_width" string="Largeur"/>
                <field name="original_height" string="Hauteur"/>
            </list>
        </field>
    </record>
    
    <!-- Vue Formulaire des images -->
    <record id="view_pool_catalog_pdf_image_form" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.image.form</field>
        <field name="model">pool.catalog.pdf.image</field>
        <field name="arch" type="xml">
            <form string="Image extraite">
                <header>
                    <button name="action_set_primary" string="Définir comme principale" 
                            type="object" class="btn-warning" 
                            invisible="role == 'primary'"/>
                    <button name="action_set_secondary" string="Définir comme secondaire"
                            type="object" class="btn-info" 
                            invisible="role == 'secondary'"/>
                    <button name="action_set_rejected" string="Rejeter" 
                            type="object" class="btn-danger" 
                            invisible="role == 'rejected'"/>
                    <button name="action_reassign_product" string="Réassigner produit"
                            type="object" class="btn-secondary"/>
                    
                    <field name="role" widget="statusbar" 
                           statusbar_visible="unassigned,primary,secondary,rejected"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="info" string="Informations">
                            <field name="pdf_import_id" readonly="1"/>
                            <field name="page_number" readonly="1"/>
                            <field name="matched_product_id"/>
                            <field name="quality_score" widget="progressbar"/>
                            <field name="confidence_score" widget="progressbar"/>
                        </group>
                        <group name="technical" string="Technique">
                            <field name="bbox_x" readonly="1"/>
                            <field name="bbox_y" readonly="1"/>
                            <field name="bbox_width" readonly="1"/>
                            <field name="bbox_height" readonly="1"/>
                            <field name="original_width" readonly="1"/>
                            <field name="original_height" readonly="1"/>
                            <field name="file_size_kb" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Sélection de variante -->
                    <group string="Image finale">
                        <field name="image_variant" widget="radio"/>
                        <field name="image_final" widget="image" class="oe_avatar" 
                               options="{'size': [400, 400]}"/>
                    </group>
                    
                    <!-- Comparaison des 3 variantes -->
                    <notebook>
                        <page string="🔸 Image brute" name="raw">
                            <field name="image_raw" widget="image" class="oe_avatar"
                                   options="{'size': [600, 600]}"/>
                            <div class="text-muted mt-2">
                                Image extraite directement du PDF, sans traitement.
                            </div>
                        </page>
                        
                        <page string="✂️ Image détourée" name="trimmed">
                            <field name="image_trimmed" widget="image" class="oe_avatar"
                                   options="{'size': [600, 600]}"/>
                            <div class="text-muted mt-2">
                                Bordures automatiquement supprimées via détection de contours.
                            </div>
                        </page>
                        
                        <page string="✨ Image optimisée" name="enhanced">
                            <field name="image_enhanced" widget="image" class="oe_avatar"
                                   options="{'size': [600, 600]}"/>
                            <div class="text-muted mt-2">
                                Netteté améliorée + contraste subtil pour l'e-commerce.
                                <strong>Recommandée</strong> pour la plupart des cas.
                            </div>
                        </page>
                        
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes sur cette image..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Vue de recherche -->
    <record id="view_pool_catalog_pdf_image_search" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.image.search</field>
        <field name="model">pool.catalog.pdf.image</field>
        <field name="arch" type="xml">
            <search string="Rechercher images">
                <field name="name"/>
                <field name="matched_product_id"/>
                <field name="page_number"/>
                
                <filter string="Non attribuées" name="unassigned" 
                        domain="[('role', '=', 'unassigned')]"/>
                <filter string="Principales" name="primary" 
                        domain="[('role', '=', 'primary')]"/>
                <filter string="Secondaires" name="secondary" 
                        domain="[('role', '=', 'secondary')]"/>
                <filter string="Rejetées" name="rejected" 
                        domain="[('role', '=', 'rejected')]"/>
                
                <separator/>
                <filter string="Non rejetées" name="not_rejected" 
                        domain="[('role', '!=', 'rejected')]"/>
                <filter string="Avec produit" name="with_product" 
                        domain="[('matched_product_id', '!=', False)]"/>
                <filter string="Confiance élevée" name="high_confidence" 
                        domain="[('confidence_score', '>=', 0.7)]"/>
                
                <group expand="0" string="Grouper par">
                    <filter string="Rôle" name="group_by_role" 
                            context="{'group_by': 'role'}"/>
                    <filter string="Page" name="group_by_page" 
                            context="{'group_by': 'page_number'}"/>
                    <filter string="Produit" name="group_by_product" 
                            context="{'group_by': 'matched_product_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action principale -->
    <record id="action_pool_catalog_pdf_image" model="ir.actions.act_window">
        <field name="name">Images extraites</field>
        <field name="res_model">pool.catalog.pdf.image</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'search_default_not_rejected': 1,
            'search_default_group_by_role': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune image extraite
            </p>
            <p>
                Les images sont automatiquement extraites des catalogues PDF
                via l'action "Extraire les images" sur les imports PDF.
            </p>
        </field>
    </record>

    <!-- ======================= EXTENSIONS VUES EXISTANTES ======================= -->
    
    <!-- Extension vue import PDF - ajout boutons extraction images -->
    <record id="view_pool_catalog_pdf_import_form_images" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.import.form.images</field>
        <field name="model">pool.catalog.pdf.import</field>
        <field name="inherit_id" ref="lolirine_pool_import.view_pool_catalog_pdf_import_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_extract_images" string="Extraire les images" 
                        type="object" class="btn-success"
                        invisible="image_extraction_state == 'in_progress'"/>
                <button string="Extraction en cours..." class="btn-secondary" disabled="1"
                        invisible="image_extraction_state != 'in_progress'"/>
            </xpath>
            
            <xpath expr="//sheet" position="inside">
                <group name="images_status" string="Extraction d'images" 
                       invisible="image_extraction_state == 'not_started'">
                    <field name="image_extraction_state" widget="badge"
                           decoration-success="image_extraction_state == 'completed'"
                           decoration-warning="image_extraction_state == 'in_progress'"
                           decoration-danger="image_extraction_state == 'error'"/>
                    <field name="image_extraction_progress" widget="progressbar" 
                           invisible="image_extraction_state != 'in_progress'"/>
                    <field name="image_count" invisible="images_extracted != True"/>
                    <button name="action_view_images" string="Voir les images extraites"
                            type="object" class="btn-link" 
                            invisible="image_count == 0"/>
                    <button name="action_reset_image_extraction" string="Réinitialiser"
                            type="object" class="btn-link text-danger"
                            confirm="Supprimer toutes les images extraites ?"
                            invisible="images_extracted != True"/>
                </group>
                
                <group name="extraction_params" string="Paramètres d'extraction" 
                       invisible="images_extracted == True">
                    <field name="min_image_area"/>
                    <field name="max_image_area"/>
                    <field name="min_aspect_ratio"/>
                    <field name="max_aspect_ratio"/>
                </group>
            </xpath>
        </field>
    </record>
    
    <!-- Extension vue produit - ajout onglet images -->
    <record id="view_pool_catalog_pdf_product_form_images" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.product.form.images</field>
        <field name="model">pool.catalog.pdf.product</field>
        <field name="inherit_id" ref="lolirine_pool_import.view_pool_catalog_pdf_product_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <notebook>
                    <page string="Images" name="images" invisible="image_count == 0">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h4>Images extraites (<field name="image_count"/> trouvées)</h4>
                                    <button name="action_view_images" string="Gérer les images"
                                            type="object" class="btn btn-primary btn-sm"/>
                                </div>
                                
                                <!-- Image principale -->
                                <div t-if="primary_image_id" class="mb-4">
                                    <h5>🌟 Image principale</h5>
                                    <field name="primary_image_id" readonly="1" 
                                           context="{'form_view_initial_mode': 'readonly'}">
                                        <form>
                                            <field name="image_final" widget="image"
                                                   options="{'size': [300, 300]}"/>
                                            <div class="text-center mt-2">
                                                <field name="name" readonly="1"/>
                                            </div>
                                        </form>
                                    </field>
                                </div>
                                
                                <!-- Images secondaires -->
                                <div t-if="secondary_image_ids">
                                    <h5>📷 Images secondaires</h5>
                                    <field name="secondary_image_ids" readonly="1" mode="kanban"
                                           context="{'kanban_image_field': 'image_final'}">
                                        <kanban>
                                            <field name="image_final"/>
                                            <field name="name"/>
                                            <templates>
                                                <t t-name="kanban-box">
                                                    <div class="oe_kanban_card" style="width: 150px;">
                                                        <div class="o_kanban_image" style="height: 120px;">
                                                            <img t-att-src="kanban_image('pool.catalog.pdf.image', 'image_final', record.id.raw_value)"
                                                                 style="max-width: 100%; max-height: 100%; object-fit: contain;"/>
                                                        </div>
                                                        <div class="oe_kanban_details p-1 text-center small">
                                                            <t t-esc="record.name.value"/>
                                                        </div>
                                                    </div>
                                                </t>
                                            </templates>
                                        </kanban>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
