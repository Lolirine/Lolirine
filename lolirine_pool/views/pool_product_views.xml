<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extension formulaire product.template -->
    <record id="product_template_pool_form_view" model="ir.ui.view">
        <field name="name">product.template.pool.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Ajout d'un onglet Piscine -->
            <xpath expr="//page[@name='sales']" position="after">
                <page string="Piscine" name="pool" invisible="not is_pool_product">
                    <group>
                        <group string="Identification">
                            <field name="pool_supplier_id"/>
                            <field name="supplier_ref"/>
                            <field name="pool_brand_id"/>
                            <field name="pool_brand" invisible="pool_brand_id"/>
                            <field name="pool_category_id"/>
                        </group>
                        <group string="Dropshipping">
                            <field name="is_dropship"/>
                            <field name="dropship_delay" invisible="not is_dropship"/>
                            <field name="supplier_stock_qty"/>
                            <field name="supplier_stock_date"/>
                        </group>
                    </group>
                    <group string="Caractéristiques techniques">
                        <group>
                            <field name="pool_power"/>
                            <field name="pool_flow_rate"/>
                            <field name="pool_pressure"/>
                        </group>
                        <group>
                            <field name="pool_volume_min"/>
                            <field name="pool_volume_max"/>
                            <field name="pool_warranty_years"/>
                        </group>
                    </group>
                    <group string="Compatibilité" invisible="not pool_compatibility">
                        <field name="pool_compatibility" nolabel="1"/>
                    </group>
                    <group string="Documentation">
                        <field name="pool_datasheet_url" widget="url"/>
                        <field name="pool_manual_url" widget="url"/>
                    </group>
                    <group string="Attributs techniques avancés">
                        <field name="pool_attribute_value_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="attribute_id"/>
                                <field name="value_char" invisible="attribute_id.attribute_type != 'char'"/>
                                <field name="value_integer" invisible="attribute_id.attribute_type != 'integer'"/>
                                <field name="value_float" invisible="attribute_id.attribute_type != 'float'"/>
                                <field name="value_boolean" invisible="attribute_id.attribute_type != 'boolean'"/>
                                <field name="value_selection" invisible="attribute_id.attribute_type != 'selection'"/>
                                <field name="display_value"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
            <!-- Ajout checkbox "Produit piscine" dans l'entête -->
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="is_pool_product"/>
            </xpath>
        </field>
    </record>

    <!-- Vue liste produits piscine -->
    <record id="product_template_pool_tree_view" model="ir.ui.view">
        <field name="name">product.template.pool.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree string="Produits Piscine">
                <field name="default_code"/>
                <field name="name"/>
                <field name="pool_brand"/>
                <field name="pool_supplier_id"/>
                <field name="categ_id"/>
                <field name="list_price"/>
                <field name="standard_price"/>
                <field name="qty_available" optional="show"/>
                <field name="is_dropship"/>
            </tree>
        </field>
    </record>

    <!-- Recherche produits piscine -->
    <record id="product_template_pool_search_view" model="ir.ui.view">
        <field name="name">product.template.pool.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Produits Piscine">
                <field name="name"/>
                <field name="default_code"/>
                <field name="pool_brand"/>
                <field name="pool_supplier_id"/>
                <field name="categ_id"/>
                <filter string="Produits Piscine" name="is_pool" domain="[('is_pool_product', '=', True)]"/>
                <filter string="Dropship" name="dropship" domain="[('is_dropship', '=', True)]"/>
                <separator/>
                <filter string="Publiés" name="published" domain="[('website_published', '=', True)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Fournisseur" name="group_supplier" context="{'group_by': 'pool_supplier_id'}"/>
                    <filter string="Marque" name="group_brand" context="{'group_by': 'pool_brand'}"/>
                    <filter string="Catégorie" name="group_categ" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action produits piscine -->
    <record id="action_pool_products" model="ir.actions.act_window">
        <field name="name">Produits Piscine</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="product_template_pool_tree_view"/>
        <field name="search_view_id" ref="product_template_pool_search_view"/>
        <field name="domain">[('is_pool_product', '=', True)]</field>
        <field name="context">{'default_is_pool_product': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier produit piscine
            </p>
            <p>
                Importez des produits depuis vos fournisseurs ou créez-les manuellement.
            </p>
        </field>
    </record>

    <!-- Vue formulaire Catégorie Piscine -->
    <record id="pool_product_category_view_form" model="ir.ui.view">
        <field name="name">pool.product.category.form</field>
        <field name="model">pool.product.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie Piscine">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_products" 
                                icon="fa-cubes" invisible="product_count == 0">
                            <field name="product_count" widget="statinfo" string="Produits"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la catégorie"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="product_category_id"/>
                            <field name="default_margin"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Sous-catégories" invisible="not child_ids">
                        <field name="child_ids" nolabel="1">
                            <tree>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="product_count"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste Catégorie Piscine -->
    <record id="pool_product_category_view_tree" model="ir.ui.view">
        <field name="name">pool.product.category.tree</field>
        <field name="model">pool.product.category</field>
        <field name="arch" type="xml">
            <tree string="Catégories Piscine">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="product_count"/>
            </tree>
        </field>
    </record>

    <!-- Action Catégories Piscine -->
    <record id="action_pool_product_category" model="ir.actions.act_window">
        <field name="name">Catégories Piscine</field>
        <field name="res_model">pool.product.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Vue formulaire Marque -->
    <record id="pool_brand_view_form" model="ir.ui.view">
        <field name="name">pool.brand.form</field>
        <field name="model">pool.brand</field>
        <field name="arch" type="xml">
            <form string="Marque">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la marque"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group>
                            <field name="product_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Fournisseurs">
                        <field name="supplier_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste Marque -->
    <record id="pool_brand_view_tree" model="ir.ui.view">
        <field name="name">pool.brand.tree</field>
        <field name="model">pool.brand</field>
        <field name="arch" type="xml">
            <tree string="Marques">
                <field name="name"/>
                <field name="code"/>
                <field name="website" widget="url"/>
                <field name="product_count"/>
            </tree>
        </field>
    </record>

    <!-- Action Marques -->
    <record id="action_pool_brand" model="ir.actions.act_window">
        <field name="name">Marques</field>
        <field name="res_model">pool.brand</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
