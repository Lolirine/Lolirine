<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_image_search" model="ir.ui.view">
        <field name="name">product.template.form.image.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_image_candidates" type="object"
                        class="oe_stat_button" icon="fa-image"
                        invisible="image_candidate_count == 0">
                    <field name="image_candidate_count" string="Candidats" widget="statinfo"/>
                </button>
                <button name="action_launch_image_search" type="object"
                        class="oe_stat_button" icon="fa-search">
                    <span>🔍 Recherche</span>
                    <span>web</span>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Ajoute le filtre "image à revoir" dans la recherche produit -->
    <record id="view_product_template_search_image_search" model="ir.ui.view">
        <field name="name">product.template.search.image.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="image_missing" string="Sans image"
                        domain="[('image_1920', '=', False)]"/>
                <filter name="image_present" string="Avec image"
                        domain="[('image_1920', '!=', False)]"/>
                <filter name="has_candidates" string="A des candidats"
                        domain="[('image_candidate_ids', '!=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
