<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue tree pour les trajets dans le contexte de km.expense -->
    <record id="km_trajet_view_tree_in_expense" model="ir.ui.view">
        <field name="name">km.trajet.tree.in.expense</field>
        <field name="model">km.trajet</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Trajets"
                  decoration-muted="state == 'brouillon'"
                  decoration-info="state == 'soumis'"
                  decoration-success="state in ('valide', 'rembourse')">
                <field name="date"/>
                <field name="lieu_depart"/>
                <field name="lieu_arrivee"/>
                <field name="distance" sum="Total"/>
                <field name="categorie_id"/>
                <field name="montant_indemnite" sum="Total €" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'brouillon'"
                       decoration-warning="state == 'soumis'"
                       decoration-success="state in ('valide', 'rembourse')"
                       decoration-danger="state == 'refuse'"/>
            </list>
        </field>
    </record>

    <!-- ==================== KM.EXPENSE VIEWS ==================== -->

    <!-- Form View -->
    <record id="km_expense_view_form" model="ir.ui.view">
        <field name="name">km.expense.form</field>
        <field name="model">km.expense</field>
        <field name="arch" type="xml">
            <form string="Feuille d'Indemnités Kilométriques">
                <header>
                    <button name="action_ajouter_trajets" string="Ajouter les trajets" type="object"
                            class="oe_highlight"
                            invisible="state != 'brouillon'"/>
                    <button name="action_soumettre" string="Soumettre" type="object"
                            class="oe_highlight"
                            invisible="state != 'brouillon'"/>
                    <button name="action_approuver" string="Approuver" type="object"
                            class="oe_highlight"
                            invisible="state != 'soumis'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_refuser" string="Refuser" type="object"
                            invisible="state != 'soumis'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_payer" string="Marquer Paye" type="object"
                            invisible="state != 'approuve'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_brouillon" string="Remettre en brouillon" type="object"
                            invisible="state in ('brouillon', 'paye')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,soumis,approuve,paye"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="employee_id"/>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                        </group>
                        <group string="Totaux">
                            <field name="total_trajets"/>
                            <field name="total_km"/>
                            <field name="total_indemnites" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cumul Annuel">
                            <field name="cumul_km_annee"/>
                            <field name="cumul_indemnites_annee" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trajets" name="trajets">
                            <field name="trajet_ids" widget="one2many"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="km_expense_view_tree" model="ir.ui.view">
        <field name="name">km.expense.tree</field>
        <field name="model">km.expense</field>
        <field name="arch" type="xml">
            <list string="Feuilles IK"
                  decoration-info="state == 'brouillon'"
                  decoration-warning="state == 'soumis'"
                  decoration-success="state in ('approuve', 'paye')"
                  decoration-danger="state == 'refuse'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="total_trajets"/>
                <field name="total_km" sum="Total KM"/>
                <field name="total_indemnites" sum="Total €" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'brouillon'"
                       decoration-warning="state == 'soumis'"
                       decoration-success="state in ('approuve', 'paye')"
                       decoration-danger="state == 'refuse'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="km_expense_view_kanban" model="ir.ui.view">
        <field name="name">km.expense.kanban</field>
        <field name="model">km.expense</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="total_trajets"/>
                <field name="total_km"/>
                <field name="total_indemnites"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'brouillon': 'info', 'soumis': 'warning', 'approuve': 'success', 'refuse': 'danger', 'paye': 'success'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="employee_id"/></div>
                                <div>
                                    <field name="date_debut"/> - <field name="date_fin"/>
                                </div>
                                <div class="mt-2">
                                    <span class="badge text-bg-secondary">
                                        <field name="total_trajets"/> trajets
                                    </span>
                                    <span class="badge text-bg-info">
                                        <field name="total_km"/> km
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge text-bg-primary">
                                        <field name="total_indemnites" widget="monetary"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="km_expense_action" model="ir.actions.act_window">
        <field name="name">Feuilles IK</field>
        <field name="res_model">km.expense</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creez votre premiere feuille d'indemnites kilometriques
            </p>
            <p>
                Regroupez vos trajets par période pour faciliter le suivi
                et le remboursement de vos indemnités kilométriques.
            </p>
        </field>
    </record>

    <record id="km_expense_action_a_approuver" model="ir.actions.act_window">
        <field name="name">Feuilles à approuver</field>
        <field name="res_model">km.expense</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('state', '=', 'soumis')]</field>
    </record>

</odoo>
