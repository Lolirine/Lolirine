<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pool_return" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pool.return</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Retours clients" string="Retours clients" name="lolirine_pool_returns">
                    <block title="Délais et règles (conditions générales)">
                        <setting string="Délai de rétractation" help="Jours après la livraison, clients particuliers (légal : 14).">
                            <field name="lpr_delai_retractation"/>
                        </setting>
                        <setting string="Retour commercial pro" help="Délai accordé aux clients professionnels et frais de remise en stock.">
                            <div class="d-flex gap-2 align-items-center">
                                <field name="lpr_delai_pro" class="o_light_label" style="width:4rem"/> jours,
                                <field name="lpr_frais_pro" class="o_light_label" style="width:4rem"/> % de frais
                            </div>
                        </setting>
                        <setting string="Colis abîmé" help="Délai de signalement, en jours ouvrables après la livraison.">
                            <field name="lpr_delai_dommage"/>
                        </setting>
                        <setting string="Remboursement sans renvoi" help="Article défectueux, abîmé ou erroné de faible valeur : le client n'a rien à renvoyer.">
                            <field name="lpr_seuil_sans_retour"/>
                        </setting>
                        <setting string="Acceptation automatique" help="Les rétractations de particuliers dans les délais reçoivent leur bon de retour immédiatement. Les autres demandes sont examinées.">
                            <field name="lpr_auto_accepter"/>
                        </setting>
                        <setting string="Adresse de renvoi" help="Séparez les lignes par « ; ». Vide = adresse de la société.">
                            <field name="lpr_adresse_retour" placeholder="Lolirine SRL ; rue … ; 5021 Boninne ; Belgique"/>
                        </setting>
                        <setting string="Reprise par le fournisseur" help="Délai de reprise du matériel neuf (SCP : 8 jours, avec RMA) et adresse de retour du fournisseur (« ; » entre les lignes).">
                            <div class="d-flex flex-column gap-1">
                                <div><field name="lpr_delai_fournisseur" class="o_light_label" style="width:4rem"/> jours</div>
                                <field name="lpr_adresse_fournisseur"/>
                            </div>
                        </setting>
                        <setting string="E-mails de demande RMA" help="Matériel neuf, puis SAV / garantie.">
                            <div class="d-flex flex-column gap-1">
                                <field name="lpr_email_rma_neuf"/>
                                <field name="lpr_email_rma_sav"/>
                            </div>
                        </setting>
                        <setting string="Lien des conditions de retour" help="Page affichée au client depuis le formulaire de retour.">
                            <field name="lpr_lien_cgv"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
