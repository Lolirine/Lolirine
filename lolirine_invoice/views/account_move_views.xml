<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension de la vue formulaire des factures -->
    <record id="view_move_form_lolirine_invoice" model="ir.ui.view">
        <field name="name">account.move.form.lolirine.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter les boutons d'action -->
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_preview_invoice" 
                        type="object" 
                        string="Apercu PDF" 
                        class="btn-secondary"
                        icon="fa-file-pdf-o"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_confirm_and_send" 
                        type="object" 
                        string="Confirmer et envoyer" 
                        class="btn-secondary"
                        icon="fa-paper-plane"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_open_send_wizard" 
                        type="object" 
                        string="Envoyer" 
                        class="btn-secondary"
                        icon="fa-envelope"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_send_peppol" 
                        type="object" 
                        string="Envoyer Peppol" 
                        class="btn-secondary"
                        icon="fa-globe"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or peppol_sent == True"/>
            </xpath>
            
            <!-- Ajouter un groupe Peppol dans autres informations -->
            <xpath expr="//page[@name='other_info']//group" position="inside">
                <group string="Peppol" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="peppol_sent" readonly="1"/>
                    <field name="peppol_sent_date" readonly="1" invisible="not peppol_sent"/>
                </group>
            </xpath>
        </field>
    </record>
    
    <!-- Vue liste des factures clients -->
    <record id="view_invoice_list_lolirine" model="ir.ui.view">
        <field name="name">account.move.list.lolirine.invoice</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Factures clients" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="amount_untaxed" sum="Total HT"/>
                <field name="amount_tax" sum="TVA"/>
                <field name="amount_total" sum="Total TTC"/>
                <field name="amount_residual" sum="Solde"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
                <field name="payment_state" widget="badge" decoration-success="payment_state == 'paid'" decoration-warning="payment_state == 'partial'" decoration-danger="payment_state in ('not_paid', 'in_payment')"/>
                <field name="is_move_sent" widget="boolean" string="Email"/>
                <field name="peppol_sent" widget="boolean" string="Peppol"/>
            </list>
        </field>
    </record>
    
    <!-- Vue recherche simplifiee -->
    <record id="view_invoice_search_lolirine" model="ir.ui.view">
        <field name="name">account.move.search.lolirine.invoice</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Recherche factures">
                <field name="name" string="Numero"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="invoice_origin"/>
                <separator/>
                <filter string="Brouillons" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmees" name="posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter string="Non payees" name="not_paid" domain="[('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter string="Payees" name="paid" domain="[('payment_state', '=', 'paid')]"/>
                <separator/>
                <filter string="Non envoyees email" name="not_sent" domain="[('is_move_sent', '=', False), ('state', '=', 'posted')]"/>
                <filter string="Envoyees email" name="sent" domain="[('is_move_sent', '=', True)]"/>
                <separator/>
                <filter string="Non envoyees Peppol" name="peppol_not_sent" domain="[('peppol_sent', '=', False), ('state', '=', 'posted')]"/>
                <filter string="Envoyees Peppol" name="peppol_sent_filter" domain="[('peppol_sent', '=', True)]"/>
                <separator/>
                <group string="Grouper par">
                    <filter string="Client" name="partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Etat" name="state" context="{'group_by': 'state'}"/>
                    <filter string="Statut paiement" name="payment_state" context="{'group_by': 'payment_state'}"/>
                    <filter string="Mois" name="month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action pour les factures clients -->
    <record id="action_lolirine_invoices" model="ir.actions.act_window">
        <field name="name">Factures clients</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_posted': 1}</field>
        <field name="search_view_id" ref="view_invoice_search_lolirine"/>
    </record>
    
    <!-- Action pour les factures brouillons -->
    <record id="action_lolirine_invoices_draft" model="ir.actions.act_window">
        <field name="name">Brouillons a confirmer</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'draft')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="search_view_id" ref="view_invoice_search_lolirine"/>
    </record>
    
    <!-- Action pour les factures non payees -->
    <record id="action_lolirine_invoices_unpaid" model="ir.actions.act_window">
        <field name="name">Non payees</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="search_view_id" ref="view_invoice_search_lolirine"/>
    </record>
    
    <!-- Action pour les factures non envoyees email -->
    <record id="action_lolirine_invoices_not_sent" model="ir.actions.act_window">
        <field name="name">Non envoyees (email)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('is_move_sent', '=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="search_view_id" ref="view_invoice_search_lolirine"/>
    </record>
    
    <!-- Action pour les factures Peppol a envoyer -->
    <record id="action_lolirine_invoices_peppol_pending" model="ir.actions.act_window">
        <field name="name">A envoyer Peppol</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('peppol_sent', '=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="search_view_id" ref="view_invoice_search_lolirine"/>
    </record>
    
    <!-- Action pour les factures Peppol envoyees -->
    <record id="action_lolirine_invoices_peppol_sent" model="ir.actions.act_window">
        <field name="name">Envoyees Peppol</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('peppol_sent', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="search_view_id" ref="view_invoice_search_lolirine"/>
    </record>
</odoo>
