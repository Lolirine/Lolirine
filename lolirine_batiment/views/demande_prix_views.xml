<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Assistant : liste des matériaux à demander, fournisseurs, livraison -->
    <record id="view_bat_demande_prix_wizard_form" model="ir.ui.view">
        <field name="name">lolirine.bat.demande.prix.wizard.form</field>
        <field name="model">lolirine.bat.demande.prix.wizard</field>
        <field name="arch" type="xml">
            <form string="Demande de prix aux fournisseurs">
                <div class="text-muted mb-2">
                    Matériaux du devis <field name="order_id" class="oe_inline" readonly="1"/>, quantités cumulées par article.
                    Décoche, corrige ou ajoute des lignes : une demande de prix est créée par fournisseur,
                    avec un e-mail que tu relis et modifies avant de l'envoyer.
                </div>
                <group>
                    <group>
                        <field name="fournisseur_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="bat_livraison" widget="radio"/>
                        <field name="date_souhaitee"/>
                    </group>
                    <group>
                        <field name="message" nolabel="1" colspan="2"
                               placeholder="Précisions pour le fournisseur (remise, délai, conditionnement…)"/>
                    </group>
                </group>
                <field name="ligne_ids">
                    <list editable="bottom">
                        <field name="retenir" widget="boolean_toggle"/>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="quantite"/>
                        <field name="uom_id" options="{'no_create': True}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_creer" type="object" string="📨 Créer les demandes de prix"
                            class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Devis bâtiment : onglet « Demandes de prix » -->
    <record id="view_order_form_bat_demande_prix" model="ir.ui.view">
        <field name="name">sale.order.form.batiment.demande.prix</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="lolirine_batiment.view_order_form_batiment"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='bat_chantier']" position="after">
                <page string="🛒 Demandes de prix" name="bat_demandes_prix" invisible="chantier_domaine != 'batiment'">
                    <div class="mb-2">
                        <button name="action_bat_demande_prix" type="object" class="btn-primary me-2"
                                string="📨 Demander les prix aux fournisseurs"/>
                        <button name="action_bat_voir_demandes_prix" type="object" class="btn-secondary"
                                string="Ouvrir les demandes" invisible="not bat_demande_prix_count"/>
                        <field name="bat_demande_prix_count" invisible="1"/>
                    </div>
                    <div class="text-muted small mb-2">Les matériaux du devis (sans la main-d'œuvre) sont envoyés aux fournisseurs
                        choisis avec une demande de meilleur prix remisé. Chaque e-mail s'ouvre pour relecture avant l'envoi
                        (bouton « Envoyer par e-mail » de la demande). Note ensuite les prix reçus sur la demande
                        et confirme celle du fournisseur retenu.</div>
                    <field name="bat_demande_prix_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="date_order" string="Date"/>
                            <field name="bat_livraison"/>
                            <field name="amount_untaxed" string="Montant HT" sum="Total"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'" decoration-warning="state == 'sent'"
                                   decoration-success="state in ('purchase', 'done')"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Demande de prix : lien vers le devis, livraison, précisions -->
    <record id="view_purchase_order_form_bat" model="ir.ui.view">
        <field name="name">purchase.order.form.batiment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="bat_devis_id" invisible="not bat_devis_id" readonly="1"/>
                <field name="bat_livraison" invisible="not bat_devis_id"/>
                <field name="bat_date_souhaitee" invisible="not bat_devis_id"/>
                <field name="bat_message" invisible="not bat_devis_id"/>
            </xpath>
        </field>
    </record>

</odoo>
