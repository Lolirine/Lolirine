<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Vue formulaire améliorée pour les valeurs d'attribut         -->
    <!-- Ajoute l'aperçu visuel et facilite l'upload d'images         -->
    <!-- ============================================================ -->
    
    <!-- Extension de la vue formulaire des valeurs d'attribut -->
    <record id="product_attribute_value_view_form_images" model="ir.ui.view">
        <field name="name">product.attribute.value.form.images</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product.product_attribute_value_view_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='html_color']" position="after">
                <field name="visual_preview" string="Aperçu" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
