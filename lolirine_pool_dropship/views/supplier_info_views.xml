<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire supplier.dropship.info -->
    <record id="view_supplier_dropship_info_form" model="ir.ui.view">
        <field name="name">supplier.dropship.info.form</field>
        <field name="model">supplier.dropship.info</field>
        <field name="arch" type="xml">
            <form string="Info Fournisseur Dropship">
                <sheet>
                    <group>
                        <group string="Produit &amp; Fournisseur">
                            <field name="product_tmpl_id"/>
                            <field name="supplier_id" domain="[('is_dropship_supplier', '=', True)]"/>
                            <field name="supplier_product_ref"/>
                            <field name="supplier_product_name"/>
                            <field name="sequence"/>
                            <field name="is_priority"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Tarification">
                            <field name="currency_id" invisible="1"/>
                            <field name="price" string="Prix catalogue HT"/>
                            <field name="discount_percent"/>
                            <field name="negotiated_price" string="Prix négocié HT"/>
                            <field name="margin_estimate" string="Marge estimée %"/>
                            <field name="shipping_cost"/>
                            <field name="handling_fee"/>
                            <field name="dropship_fee"/>
                            <field name="total_cost"/>
                        </group>
                    </group>
                    <group>
                        <group string="Délais">
                            <field name="delay"/>
                            <field name="delay_min"/>
                            <field name="delay_max"/>
                        </group>
                        <group string="Commande">
                            <field name="order_method"/>
                            <field name="order_email"/>
                            <field name="min_qty"/>
                        </group>
                    </group>
                    <group>
                        <group string="Fiabilité">
                            <field name="reliability_score"/>
                            <field name="total_orders"/>
                            <field name="on_time_deliveries"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                        <field name="packaging_instructions" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Liste supplier.dropship.info -->
    <record id="view_supplier_dropship_info_list" model="ir.ui.view">
        <field name="name">supplier.dropship.info.list</field>
        <field name="model">supplier.dropship.info</field>
        <field name="arch" type="xml">
            <list string="Infos Fournisseurs Dropship" default_order="supplier_id, product_tmpl_id"
                  decoration-muted="not is_active">
                <field name="supplier_id" string="Fournisseur"/>
                <field name="product_tmpl_id" string="Produit"/>
                <field name="supplier_product_ref" string="Réf."/>
                <field name="price" string="Prix catalogue HT"/>
                <field name="discount_percent" string="Réduction %"/>
                <field name="negotiated_price" string="Prix négocié HT"/>
                <field name="margin_estimate" string="Marge %"
                       decoration-danger="margin_estimate &lt; 15"
                       decoration-success="margin_estimate &gt;= 25"/>
                <field name="delay" string="Délai (j)"/>
                <field name="is_priority" string="Prio"/>
                <field name="is_active" string="Actif"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_dropship_info_search" model="ir.ui.view">
        <field name="name">supplier.dropship.info.search</field>
        <field name="model">supplier.dropship.info</field>
        <field name="arch" type="xml">
            <search string="Infos Fournisseurs">
                <field name="product_tmpl_id"/>
                <field name="supplier_id"/>
                <filter string="Actifs" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Prioritaires" name="priority" domain="[('is_priority', '=', True)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Fournisseur" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Produit" name="group_product" context="{'group_by': 'product_tmpl_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_supplier_dropship_info" model="ir.actions.act_window">
        <field name="name">Fiches fournisseurs</field>
        <field name="res_model">supplier.dropship.info</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="search_view_id" ref="view_supplier_dropship_info_search"/>
    </record>

    <!-- Extension formulaire res.partner (fournisseur) -->
    <record id="view_partner_form_dropship" model="ir.ui.view">
        <field name="name">res.partner.form.dropship</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_dropship_products" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="not is_dropship_supplier">
                    <field name="dropship_product_count" widget="statinfo" string="Produits dropship"/>
                </button>
                <button name="action_view_dropship_orders" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="not is_dropship_supplier">
                    <field name="dropship_order_count" widget="statinfo" string="BC dropship"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Dropshipping" name="dropship_supplier_tab"
                      invisible="not is_dropship_supplier">
                    <group>
                        <group>
                            <field name="is_dropship_supplier"/>
                            <field name="dropship_default_discount"/>
                            <field name="dropship_default_delay"/>
                        </group>
                        <group>
                            <field name="dropship_order_email"
                                   placeholder="Si différent de l'email principal"/>
                        </group>
                    </group>
                    <field name="dropship_notes" placeholder="Notes dropship..."/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
