<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════
         Injection CSS dynamique dans le <head>
         ═══════════════════════════════════════════════ -->
    <template id="lolirine_wishlist_css_vars"
              inherit_id="website.layout"
              active="True">
        <xpath expr="//head" position="inside">
            <t t-if="website.id == 6">
                <link rel="stylesheet" type="text/css"
                      href="/shop/wishlist/css"/>
            </t>
        </xpath>
    </template>


    <!-- ═══════════════════════════════════════════════
         Override de la page wishlist complète
         ═══════════════════════════════════════════════ -->
    <template id="lolirine_wishlist_page"
              inherit_id="website_sale_wishlist.product_wishlist"
              active="True">

        <xpath expr="//section[hasclass('wishlist-section')]" position="replace">
            <t t-if="website.id == 6">

                <t t-set="wl_cfg" t-value="request.env['lolirine.wishlist.config'].sudo().get_config()"/>
                <t t-set="wl_texts" t-value="request.env['lolirine.wishlist.config'].sudo().get_texts()"/>

                <div class="lw-page container py-4">

                    <!-- Header -->
                    <div class="lw-header">
                        <div class="lw-header-left">
                            <h1 class="lw-title">
                                <t t-esc="wl_texts.get('page_title', 'Ma liste de souhaits')"/>
                                <span class="lw-count">
                                    (<t t-esc="len(wishes)"/> produit<t t-if="len(wishes) > 1">s</t>)
                                </span>
                            </h1>
                        </div>
                        <div class="lw-header-actions">
                            <a href="/shop" class="lw-btn-sm">
                                Continuer mes achats
                            </a>
                            <button class="lw-btn-sm lw-btn-share-top"
                                    onclick="window.lolirineWishlist.shareList()">
                                <t t-esc="wl_texts.get('share', 'Partager')"/>
                            </button>
                        </div>
                    </div>

                    <!-- Toolbar -->
                    <div class="lw-toolbar">
                        <div class="lw-search-wrap">
                            <svg class="lw-search-icon" viewBox="0 0 16 16" fill="none">
                                <circle cx="7" cy="7" r="4" stroke="currentColor" stroke-width="1.4"/>
                                <path d="M10.5 10.5l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            </svg>
                            <input type="text" class="lw-search-input"
                                   placeholder="Rechercher dans la liste..."
                                   oninput="window.lolirineWishlist.filter(this.value)"/>
                        </div>
                        <select class="lw-sort-select"
                                onchange="window.lolirineWishlist.sort(this.value)">
                            <option value="date">Trier : Date d'ajout</option>
                            <option value="price_asc">Prix croissant</option>
                            <option value="price_desc">Prix décroissant</option>
                            <option value="name">Nom A–Z</option>
                        </select>
                    </div>

                    <!-- Grid : liste + résumé -->
                    <div class="lw-grid">

                        <!-- Liste des produits -->
                        <div class="lw-list" id="lw_product_list">
                            <t t-foreach="wishes" t-as="wish">
                                <t t-set="product" t-value="wish.product_id"/>
                                <t t-set="tmpl" t-value="product.product_tmpl_id"/>
                                <div class="lw-item"
                                     t-att-data-price="tmpl.list_price or 0"
                                     t-att-data-name="tmpl.name"
                                     t-att-data-date="str(wish.create_date or '')">

                                    <!-- Image -->
                                    <div class="lw-img">
                                        <t t-if="tmpl.image_128">
                                            <img t-att-src="'/web/image/product.template/%d/image_128' % tmpl.id"
                                                 t-att-alt="tmpl.name"/>
                                        </t>
                                        <t t-else="">
                                            <svg viewBox="0 0 48 48" fill="none">
                                                <rect width="48" height="48" rx="6" fill="#e0f2fe"/>
                                                <path d="M12 36l8-12 6 8 4-6 8 10" stroke="#0369a1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </t>
                                    </div>

                                    <!-- Corps -->
                                    <div class="lw-body">
                                        <a t-att-href="'/shop/%s' % wish.product_id.product_tmpl_id.website_slug"
                                           class="lw-name">
                                            <t t-esc="tmpl.name"/>
                                        </a>
                                        <div class="lw-ref" t-if="product.default_code">
                                            Réf. <t t-esc="product.default_code"/>
                                        </div>

                                        <!-- Prix -->
                                        <t t-set="price_ht" t-value="tmpl.list_price or 0"/>
                                        <div class="lw-prices">
                                            <span class="lw-price-ht">
                                                <t t-esc="'%.2f' % price_ht"/> €
                                            </span>
                                            <span class="lw-price-ttc">
                                                / <t t-esc="'%.2f' % (price_ht * 1.21)"/> € TTC
                                            </span>
                                        </div>

                                        <!-- Stock -->
                                        <t t-set="qty" t-value="product.virtual_available"/>
                                        <div class="lw-stock-line">
                                            <t t-if="qty &gt; 10">
                                                <span class="lw-dot lw-dot-green"></span>
                                                <span class="lw-stock-txt lw-stock-green">
                                                    <t t-esc="wl_texts.get('in_stock', 'En stock')"/>
                                                </span>
                                                <span class="lw-delivery">
                                                    — Expédié sous 24h
                                                </span>
                                            </t>
                                            <t t-elif="qty &gt; 0">
                                                <span class="lw-dot lw-dot-orange"></span>
                                                <span class="lw-stock-txt lw-stock-orange">
                                                    <t t-esc="wl_texts.get('low_stock', 'Stock limité')"/>
                                                </span>
                                                <span class="lw-delivery">
                                                    — Plus que <t t-esc="int(qty)"/> unité<t t-if="qty &gt; 1">s</t>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="lw-dot lw-dot-gray"></span>
                                                <span class="lw-stock-txt lw-stock-gray">
                                                    <t t-esc="wl_texts.get('out_of_stock', 'Sur commande')"/>
                                                </span>
                                            </t>
                                        </div>

                                        <!-- Date d'ajout -->
                                        <div class="lw-added">
                                            Ajouté le <t t-esc="wish.create_date.strftime('%d %b %Y') if wish.create_date else ''"/>
                                        </div>
                                    </div>

                                    <!-- Actions -->
                                    <div class="lw-ctas">
                                        <a t-att-href="'/shop/cart/update?product_id=%d&amp;add_qty=1' % product.id"
                                           class="lw-btn-cart">
                                            <t t-esc="wl_texts.get('add_to_cart', 'Ajouter au panier')"/>
                                        </a>
                                        <button class="lw-btn-remove"
                                                t-att-data-wish-id="wish.id"
                                                onclick="window.lolirineWishlist.remove(this)">
                                            ✕ Retirer
                                        </button>
                                    </div>

                                </div>
                            </t>

                            <!-- Liste vide -->
                            <t t-if="not wishes">
                                <div class="lw-empty">
                                    <svg viewBox="0 0 64 64" fill="none">
                                        <circle cx="32" cy="32" r="30" stroke="#d1d5db" stroke-width="2"/>
                                        <path d="M32 44s-14-9-14-19a10 10 0 0120 0 10 10 0 0120 0c0 10-14 19-14 19z" stroke="#d1d5db" stroke-width="2" stroke-linejoin="round"/>
                                    </svg>
                                    <p>Votre liste de souhaits est vide.</p>
                                    <a href="/shop" class="lw-btn-cart" style="display:inline-block;text-decoration:none;">
                                        Découvrir nos produits
                                    </a>
                                </div>
                            </t>
                        </div>

                        <!-- Récapitulatif -->
                        <div class="lw-summary" t-if="wishes">
                            <div class="lw-sum-title">Récapitulatif de la liste</div>

                            <div class="lw-sum-row">
                                <span>Nombre d'articles</span>
                                <span><t t-esc="len(wishes)"/></span>
                            </div>

                            <t t-set="total_ht" t-value="sum((p.product_id.product_tmpl_id.list_price or 0) for p in wishes)"/>
                            <div class="lw-sum-row">
                                <span>Sous-total HT</span>
                                <span><t t-esc="'%.2f' % total_ht"/> €</span>
                            </div>

                            <div class="lw-sum-savings" t-if="total_ht >= 499">
                                <span>Livraison offerte</span>
                                <span>GRATUITE</span>
                            </div>
                            <div class="lw-sum-savings lw-sum-savings-info" t-else="">
                                <span>Livraison offerte dès 499 € HT</span>
                                <span><t t-esc="'%.0f' % (499 - total_ht)"/> € restants</span>
                            </div>

                            <div class="lw-sum-total">
                                <span>Total HT</span>
                                <span><t t-esc="'%.2f' % total_ht"/> €</span>
                            </div>
                            <div class="lw-sum-ttc">
                                soit <t t-esc="'%.2f' % (total_ht * 1.21)"/> € TTC
                            </div>

                            <!-- Tout ajouter au panier -->
                            <button class="lw-btn-all"
                                    onclick="window.lolirineWishlist.addAll()">
                                <t t-esc="wl_texts.get('add_all', 'Tout ajouter au panier')"/>
                            </button>

                            <!-- Partager -->
                            <button class="lw-btn-share"
                                    onclick="window.lolirineWishlist.shareList()">
                                <t t-esc="wl_texts.get('share', 'Partager la liste')"/>
                            </button>

                            <div class="lw-shipping-note">
                                <t t-esc="wl_texts.get('shipping_note', 'Livraison offerte dès 499 € HT · Retours 30 jours')"/>
                            </div>

                            <!-- Contact expert -->
                            <div class="lw-expert-block">
                                <div class="lw-expert-text">
                                    <strong>Un conseil avant d'acheter ?</strong>
                                    <span><t t-esc="wl_texts.get('expert_phone', '+32 497 44 41 46')"/></span>
                                </div>
                                <a href="/contactus" class="lw-btn-contact">
                                    <t t-esc="wl_texts.get('contact_label', 'Contacter')"/>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>

            </t>
            <!-- Fallback pour les autres sites : comportement Odoo natif -->
            <t t-else="">
                <div class="o_wsale_wishlist">
                    <t t-foreach="wishes" t-as="wish">
                        <div t-att-data-wish-id="wish.id"/>
                    </t>
                </div>
            </t>
        </xpath>

    </template>

</odoo>
