<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Snippet: Bannière promotionnelle piscine -->
    <template id="s_pool_promo_banner" name="Bannière promo piscine">
        <section class="s_pool_promo_banner py-4 bg-info text-white text-center">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h3>Préparez votre piscine pour l'été !</h3>
                        <p class="mb-0">Profitez de nos offres spéciales sur les robots et pompes à chaleur</p>
                    </div>
                    <div class="col-md-4">
                        <a href="/shop" class="btn btn-light btn-lg">Voir les offres</a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet: Grille de catégories -->
    <template id="s_pool_category_grid" name="Grille catégories piscine">
        <section class="s_pool_category_grid py-5">
            <div class="container">
                <h2 class="text-center mb-4">Nos univers</h2>
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card pool-cat-card h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-filter fa-3x mb-3 text-primary"/>
                                <h5>Filtration</h5>
                                <p>Filtres, pompes et accessoires</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card pool-cat-card h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-robot fa-3x mb-3 text-primary"/>
                                <h5>Nettoyage</h5>
                                <p>Robots et balais automatiques</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card pool-cat-card h-100">
                            <div class="card-body text-center">
                                <i class="fa fa-fire fa-3x mb-3 text-primary"/>
                                <h5>Chauffage</h5>
                                <p>Pompes à chaleur et réchauffeurs</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet: Bloc marques -->
    <template id="s_pool_brands_carousel" name="Carrousel marques piscine">
        <section class="s_pool_brands py-4 bg-light">
            <div class="container">
                <h4 class="text-center mb-3">Nos marques</h4>
                <div class="row justify-content-center align-items-center text-center">
                    <div class="col-4 col-md-2"><span class="h6">AstralPool</span></div>
                    <div class="col-4 col-md-2"><span class="h6">Zodiac</span></div>
                    <div class="col-4 col-md-2"><span class="h6">Hayward</span></div>
                    <div class="col-4 col-md-2"><span class="h6">Pentair</span></div>
                    <div class="col-4 col-md-2"><span class="h6">Dolphin</span></div>
                    <div class="col-4 col-md-2"><span class="h6">Bayrol</span></div>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet: Contact/conseil -->
    <template id="s_pool_contact_cta" name="CTA Contact piscine">
        <section class="s_pool_contact_cta py-5 bg-primary text-white">
            <div class="container text-center">
                <h3>Besoin d'un conseil ?</h3>
                <p class="lead mb-4">Notre équipe d'experts est à votre disposition</p>
                <a href="/contactus" class="btn btn-light btn-lg me-2">Nous contacter</a>
                <a href="tel:+32XXXXXXXX" class="btn btn-outline-light btn-lg">
                    <i class="fa fa-phone"/> Appelez-nous
                </a>
            </div>
        </section>
    </template>

</odoo>
