<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu principal -->
    <menuitem id="menu_storage_plan_root" 
              name="Garde-Meubles" 
              web_icon="storage_plan_module,static/description/icon.png" 
              sequence="10"/>

    <!-- Accès direct au plan du hangar (site web), sans passer par un box.
         Séquence 15 : après « Boxes » (10), sinon le clic sur l'application ouvre le plan
         au lieu de la liste des boxes. -->
    <record id="action_storage_plan_website" model="ir.actions.act_url">
        <field name="name">Plan du hangar</field>
        <field name="url">/storage/plan</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_storage_plan_website"
              name="Plan du hangar"
              parent="menu_storage_plan_root"
              action="action_storage_plan_website"
              sequence="15"/>

    <!-- Menu Boxes -->
    <menuitem id="menu_storage_boxes" 
              name="Boxes" 
              parent="menu_storage_plan_root" 
              sequence="10"/>
    
    <menuitem id="menu_storage_box_list" 
              name="Tous les boxes" 
              parent="menu_storage_boxes" 
              action="action_storage_box" 
              sequence="10"/>
    
    <menuitem id="menu_storage_box_import" 
              name="Importer (XLSX)" 
              parent="menu_storage_boxes" 
              action="action_storage_box_import_wizard" 
              sequence="15"/>
    
    <menuitem id="menu_storage_floor_list" 
              name="Étages" 
              parent="menu_storage_boxes" 
              action="action_storage_floor" 
              sequence="20"/>

    <!-- Menu Réservations -->
    <menuitem id="menu_reservations" 
              name="Réservations" 
              parent="menu_storage_plan_root" 
              sequence="20"/>
    
    <menuitem id="menu_box_reservation_list" 
              name="Toutes les réservations" 
              parent="menu_reservations" 
              action="action_box_reservation" 
              sequence="10"/>

    <!-- Menu Configuration -->
    <menuitem id="menu_storage_configuration" 
              name="Configuration" 
              parent="menu_storage_plan_root" 
              sequence="100" 
              groups="base.group_system"/>
    
    <menuitem id="menu_storage_status_colors" 
              name="Couleurs des statuts" 
              parent="menu_storage_configuration" 
              action="action_storage_status_color" 
              sequence="10"/>
</odoo>
