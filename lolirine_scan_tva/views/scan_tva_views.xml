<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire principale -->
    <record id="view_lolirine_scan_tva_form" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.form</field>
        <field name="model">lolirine.scan.tva</field>
        <field name="arch" type="xml">
            <form string="Scan TVA">
                <header>
                    <!-- Bouton Extraire OCR - visible quand document uploadé et état draft/scanned -->
                    <button name="action_scan_ocr" 
                            type="object" 
                            string="🔍 Extraire (OCR)" 
                            class="btn-primary"
                            invisible="not document or state not in ('draft', 'scanned')"/>
                    
                    <!-- Bouton Extraction manuelle -->
                    <button name="action_manual_extract" 
                            type="object" 
                            string="✏️ Saisie manuelle" 
                            class="btn-secondary"
                            invisible="state not in ('draft', 'scanned', 'extracted')"/>
                    
                    <!-- Bouton Valider -->
                    <button name="action_validate" 
                            type="object" 
                            string="✓ Valider" 
                            class="btn-primary"
                            invisible="state != 'extracted'"/>
                    
                    <!-- Bouton Créer facture -->
                    <button name="action_create_invoice" 
                            type="object" 
                            string="📄 Créer la facture" 
                            class="btn-primary"
                            invisible="state != 'validated'"/>
                    
                    <!-- Bouton Voir facture -->
                    <button name="action_view_invoice" 
                            type="object" 
                            string="Voir la facture" 
                            class="btn-secondary"
                            invisible="state != 'invoiced'"/>
                    
                    <!-- Bouton Archiver document -->
                    <button name="action_archive_document" 
                            type="object" 
                            string="📎 Archiver dans documents" 
                            class="btn-secondary"
                            invisible="not document"/>
                    
                    <button name="action_reset_draft" 
                            type="object" 
                            string="Remettre en brouillon" 
                            invisible="state in ('draft', 'invoiced')"/>
                    
                    <button name="action_cancel" 
                            type="object" 
                            string="Annuler" 
                            invisible="state in ('cancelled', 'invoiced')"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,scanned,extracted,validated,invoiced"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o"
                                invisible="not invoice_id">
                            <field name="invoice_id" widget="statinfo" string="Facture"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <!-- SECTION 1: Upload et Aperçu du document -->
                    <group string="📷 Document scanné">
                        <group>
                            <!-- Zone d'upload -->
                            <field name="document" filename="document_filename" widget="binary" string="Charger le fichier"/>
                            <field name="document_filename" invisible="1"/>
                            <field name="document_type" readonly="1"/>
                        </group>
                        <group>
                            <!-- Aperçu de l'image -->
                            <div invisible="not document" class="text-center">
                                <field name="document_preview" widget="image" 
                                       options="{'size': [400, 500]}"
                                       class="img-fluid border rounded"/>
                            </div>
                            <div invisible="document" class="text-center text-muted p-4" style="border: 2px dashed #ccc; border-radius: 8px;">
                                <i class="fa fa-cloud-upload fa-3x mb-2"/><br/>
                                <span>Uploadez un ticket ou une facture</span><br/>
                                <small>JPG, PNG ou PDF</small>
                            </div>
                        </group>
                    </group>
                    
                    <!-- SECTION 2: Texte OCR extrait -->
                    <group string="📝 Texte OCR extrait" invisible="not ocr_text">
                        <field name="ocr_text" readonly="1" nolabel="1" 
                               placeholder="Le texte extrait apparaîtra ici après l'extraction OCR..."
                               style="font-family: monospace; font-size: 11px; background: #f5f5f5; padding: 10px; border-radius: 4px; max-height: 200px; overflow-y: auto;"/>
                    </group>
                    
                    <!-- SECTION 3: Informations fournisseur -->
                    <group string="🏢 Fournisseur">
                        <group>
                            <field name="supplier_vat" placeholder="BE0123456789"/>
                            <field name="partner_id" domain="[('supplier_rank', '>', 0)]"/>
                            <field name="partner_exists" invisible="1"/>
                        </group>
                        <group>
                            <field name="supplier_name" placeholder="Nom du fournisseur"/>
                            <field name="supplier_phone"/>
                            <field name="supplier_email"/>
                        </group>
                    </group>
                    
                    <!-- Alertes fournisseur -->
                    <div class="alert alert-success py-2 mx-3" role="alert" invisible="not partner_exists">
                        <i class="fa fa-check-circle"/> Fournisseur trouvé dans la base de données
                    </div>
                    <div class="alert alert-info py-2 mx-3" role="alert" invisible="partner_exists or not supplier_vat">
                        <i class="fa fa-info-circle"/> Nouveau fournisseur - sera créé lors de la validation
                    </div>
                    
                    <!-- SECTION 4: Adresse -->
                    <group string="📍 Adresse" name="address">
                        <group>
                            <field name="supplier_street" placeholder="Rue et numéro"/>
                            <field name="supplier_zip" placeholder="Code postal"/>
                        </group>
                        <group>
                            <field name="supplier_city" placeholder="Ville"/>
                            <field name="supplier_country_id"/>
                        </group>
                    </group>
                    
                    <!-- SECTION 5: Informations facture -->
                    <group string="🧾 Facture / Ticket">
                        <group>
                            <field name="invoice_number" placeholder="N° facture ou ticket"/>
                            <field name="invoice_date"/>
                        </group>
                        <group>
                            <field name="tax_rate"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    
                    <!-- SECTION 6: Montants -->
                    <group string="💶 Montants">
                        <group>
                            <field name="amount_untaxed"/>
                            <field name="amount_tax"/>
                        </group>
                        <group>
                            <field name="amount_total" class="fw-bold" style="font-size: 1.2em;"/>
                        </group>
                    </group>
                    
                    <!-- SECTION 7: Comptabilité -->
                    <group string="📚 Comptabilité">
                        <group>
                            <field name="account_id" 
                                   domain="[('account_type', 'in', ('expense', 'expense_direct_cost'))]"
                                   options="{'no_create': True}"
                                   placeholder="Compte de charge"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    
                    <!-- SECTION 8: Notes -->
                    <group string="📝 Notes">
                        <field name="notes" nolabel="1" placeholder="Notes supplémentaires..."/>
                    </group>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Vue liste -->
    <record id="view_lolirine_scan_tva_list" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.list</field>
        <field name="model">lolirine.scan.tva</field>
        <field name="arch" type="xml">
            <list string="Scans TVA" decoration-info="state == 'draft'" decoration-warning="state == 'extracted'" decoration-success="state == 'invoiced'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="create_date" string="Date scan"/>
                <field name="supplier_vat"/>
                <field name="supplier_name"/>
                <field name="partner_id"/>
                <field name="invoice_number"/>
                <field name="invoice_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('scanned', 'extracted')"
                       decoration-success="state in ('validated', 'invoiced')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="invoice_id" optional="show"/>
            </list>
        </field>
    </record>
    
    <!-- Vue kanban -->
    <record id="view_lolirine_scan_tva_kanban" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.kanban</field>
        <field name="model">lolirine.scan.tva</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="supplier_name"/>
                <field name="supplier_vat"/>
                <field name="amount_total"/>
                <field name="state"/>
                <field name="document"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="row">
                                <div class="col-4">
                                    <field name="document" widget="image" 
                                           options="{'size': [80, 100]}"
                                           class="oe_kanban_image"/>
                                </div>
                                <div class="col-8">
                                    <strong><field name="name"/></strong>
                                    <div><field name="supplier_name"/></div>
                                    <div class="text-muted"><field name="supplier_vat"/></div>
                                    <div class="mt-2">
                                        <strong><field name="amount_total" widget="monetary"/></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Vue recherche -->
    <record id="view_lolirine_scan_tva_search" model="ir.ui.view">
        <field name="name">lolirine.scan.tva.search</field>
        <field name="model">lolirine.scan.tva</field>
        <field name="arch" type="xml">
            <search string="Recherche scans TVA">
                <field name="name"/>
                <field name="supplier_vat"/>
                <field name="supplier_name"/>
                <field name="partner_id"/>
                <field name="invoice_number"/>
                <separator/>
                <filter string="Brouillons" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Scannés" name="scanned" domain="[('state', '=', 'scanned')]"/>
                <filter string="Extraits" name="extracted" domain="[('state', '=', 'extracted')]"/>
                <filter string="Validés" name="validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Facturés" name="invoiced" domain="[('state', '=', 'invoiced')]"/>
                <separator/>
                <filter string="A traiter" name="to_process" domain="[('state', 'in', ('draft', 'scanned', 'extracted', 'validated'))]"/>
                <separator/>
                <filter string="Ce mois" name="this_month" domain="[('create_date', '>=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fournisseur" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Mois" name="group_month" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action principale -->
    <record id="action_lolirine_scan_tva" model="ir.actions.act_window">
        <field name="name">Scans TVA</field>
        <field name="res_model">lolirine.scan.tva</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_to_process': 1}</field>
        <field name="search_view_id" ref="view_lolirine_scan_tva_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Scanner une nouvelle souche TVA
            </p>
            <p>
                Uploadez ou scannez vos tickets et factures fournisseurs pour extraire
                automatiquement les informations et créer les écritures comptables.
            </p>
        </field>
    </record>
    
    <!-- Action pour créer un nouveau scan -->
    <record id="action_lolirine_scan_tva_new" model="ir.actions.act_window">
        <field name="name">Nouveau scan</field>
        <field name="res_model">lolirine.scan.tva.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <!-- Extension de la vue partenaire -->
    <record id="view_partner_form_scan_tva" model="ir.ui.view">
        <field name="name">res.partner.form.scan.tva</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_scan_tva" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-qrcode"
                        invisible="supplier_rank == 0">
                    <field name="scan_tva_count" widget="statinfo" string="Scans TVA"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
