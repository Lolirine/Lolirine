<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Ajoute un bouton "Annuler l'attribution" dans le header de la vue
        formulaire des transactions bancaires. Le bouton est placé AVANT le
        statusbar (sinon OWL le masque silencieusement en Odoo 19).
        Visible uniquement si un partenaire est attribué.
    -->
    <record id="view_account_bank_statement_line_form_unmatch" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.unmatch</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account.view_bank_statement_line_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_open_unmatch_wizard"
                        type="object"
                        string="Annuler l'attribution"
                        class="btn-warning"
                        icon="fa-undo"
                        invisible="not partner_id"
                        groups="account.group_account_user"/>
            </xpath>

        </field>
    </record>

</odoo>
