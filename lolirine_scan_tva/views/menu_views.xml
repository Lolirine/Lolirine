<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu principal de l'application -->
    <menuitem id="menu_lolirine_scan_tva_root"
              name="Scan TVA"
              sequence="26"
              web_icon="lolirine_scan_tva,static/description/icon.png"/>
    
    <!-- Menu Scanner -->
    <menuitem id="menu_lolirine_scan_tva_new"
              name="Nouveau scan"
              parent="menu_lolirine_scan_tva_root"
              action="action_lolirine_scan_tva_new"
              sequence="5"/>
    
    <!-- Sous-menu Scans -->
    <menuitem id="menu_lolirine_scan_tva_scans"
              name="Scans"
              parent="menu_lolirine_scan_tva_root"
              sequence="10"/>
    
    <!-- Menu Tous les scans -->
    <menuitem id="menu_lolirine_scan_tva_all"
              name="Tous les scans"
              parent="menu_lolirine_scan_tva_scans"
              action="action_lolirine_scan_tva"
              sequence="10"/>
    
    <!-- Menu A traiter -->
    <record id="action_lolirine_scan_tva_to_process" model="ir.actions.act_window">
        <field name="name">A traiter</field>
        <field name="res_model">lolirine.scan.tva</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ('draft', 'scanned', 'extracted', 'validated'))]</field>
        <field name="search_view_id" ref="view_lolirine_scan_tva_search"/>
    </record>
    
    <menuitem id="menu_lolirine_scan_tva_to_process"
              name="A traiter"
              parent="menu_lolirine_scan_tva_scans"
              action="action_lolirine_scan_tva_to_process"
              sequence="15"/>
    
    <!-- Menu Facturés -->
    <record id="action_lolirine_scan_tva_invoiced" model="ir.actions.act_window">
        <field name="name">Factures creees</field>
        <field name="res_model">lolirine.scan.tva</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'invoiced')]</field>
        <field name="search_view_id" ref="view_lolirine_scan_tva_search"/>
    </record>
    
    <menuitem id="menu_lolirine_scan_tva_invoiced"
              name="Factures creees"
              parent="menu_lolirine_scan_tva_scans"
              sequence="20"/>
    
    <!-- Sous-menu Rapports -->
    <menuitem id="menu_lolirine_scan_tva_reports"
              name="Rapports"
              parent="menu_lolirine_scan_tva_root"
              sequence="20"/>
    
    <!-- Lien vers factures fournisseurs -->
    <menuitem id="menu_lolirine_scan_tva_supplier_invoices"
              name="Factures fournisseurs"
              parent="menu_lolirine_scan_tva_reports"
              action="account.action_move_in_invoice_type"
              sequence="10"/>
    
    <!-- Sous-menu Configuration -->
    <menuitem id="menu_lolirine_scan_tva_config"
              name="Configuration"
              parent="menu_lolirine_scan_tva_root"
              sequence="30"
              groups="base.group_system"/>
    
    <!-- Lien vers plan comptable -->
    <menuitem id="menu_lolirine_scan_tva_accounts"
              name="Plan comptable"
              parent="menu_lolirine_scan_tva_config"
              action="account.action_account_form"
              sequence="10"/>
    
    <!-- Lien vers fournisseurs -->
    <menuitem id="menu_lolirine_scan_tva_suppliers"
              name="Fournisseurs"
              parent="menu_lolirine_scan_tva_config"
              action="account.res_partner_action_supplier"
              sequence="20"/>
</odoo>
