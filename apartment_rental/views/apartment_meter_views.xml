<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Meter Form View -->
    <record id="apartment_meter_view_form" model="ir.ui.view">
        <field name="name">apartment.meter.form</field>
        <field name="model">apartment.meter</field>
        <field name="arch" type="xml">
            <form string="Compteur">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_readings" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="reading_count" widget="statinfo" string="Relevés"/>
                        </button>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="meter_type"/>
                            <field name="meter_number"/>
                            <field name="ean_code"/>
                        </group>
                        <group string="Fournisseur">
                            <field name="supplier_id"/>
                            <field name="contract_number"/>
                            <field name="contract_start_date"/>
                            <field name="contract_end_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dernier relevé">
                            <field name="last_reading"/>
                            <field name="last_reading_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historique des relevés" name="readings">
                            <field name="reading_ids">
                                <tree>
                                    <field name="date"/>
                                    <field name="value"/>
                                    <field name="consumption"/>
                                    <field name="reading_type"/>
                                    <field name="reader_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Meter Tree View -->
    <record id="apartment_meter_view_tree" model="ir.ui.view">
        <field name="name">apartment.meter.tree</field>
        <field name="model">apartment.meter</field>
        <field name="arch" type="xml">
            <tree string="Compteurs">
                <field name="property_id"/>
                <field name="meter_type"/>
                <field name="meter_number"/>
                <field name="ean_code"/>
                <field name="supplier_id"/>
                <field name="last_reading"/>
                <field name="last_reading_date"/>
            </tree>
        </field>
    </record>

    <!-- Meter Search View -->
    <record id="apartment_meter_view_search" model="ir.ui.view">
        <field name="name">apartment.meter.search</field>
        <field name="model">apartment.meter</field>
        <field name="arch" type="xml">
            <search string="Rechercher un compteur">
                <field name="meter_number"/>
                <field name="ean_code"/>
                <field name="property_id"/>
                <filter string="Électricité" name="electricity" domain="[('meter_type', '=', 'electricity')]"/>
                <filter string="Gaz" name="gas" domain="[('meter_type', '=', 'gas')]"/>
                <filter string="Eau" name="water" domain="[('meter_type', '=', 'water')]"/>
                <filter string="Chauffage" name="heating" domain="[('meter_type', '=', 'heating')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Type" name="group_type" context="{'group_by': 'meter_type'}"/>
                    <filter string="Bien" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Fournisseur" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Meter Reading Form View -->
    <record id="apartment_meter_reading_view_form" model="ir.ui.view">
        <field name="name">apartment.meter.reading.form</field>
        <field name="model">apartment.meter.reading</field>
        <field name="arch" type="xml">
            <form string="Relevé de compteur">
                <sheet>
                    <group>
                        <group>
                            <field name="meter_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="value"/>
                            <field name="reading_type"/>
                        </group>
                        <group>
                            <field name="consumption" readonly="1"/>
                            <field name="days_since_last" readonly="1"/>
                            <field name="daily_average" readonly="1"/>
                            <field name="reader_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="photo" widget="image" options="{'size': [300, 300]}"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Meter Reading Tree View -->
    <record id="apartment_meter_reading_view_tree" model="ir.ui.view">
        <field name="name">apartment.meter.reading.tree</field>
        <field name="model">apartment.meter.reading</field>
        <field name="arch" type="xml">
            <tree string="Relevés">
                <field name="date"/>
                <field name="meter_id"/>
                <field name="value"/>
                <field name="consumption"/>
                <field name="daily_average"/>
                <field name="reading_type"/>
                <field name="reader_id"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="apartment_meter_action" model="ir.actions.act_window">
        <field name="name">Compteurs</field>
        <field name="res_model">apartment.meter</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="apartment_meter_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajoutez un compteur
            </p>
        </field>
    </record>

    <record id="apartment_meter_reading_action" model="ir.actions.act_window">
        <field name="name">Relevés de compteurs</field>
        <field name="res_model">apartment.meter.reading</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enregistrez un relevé
            </p>
        </field>
    </record>

</odoo>
