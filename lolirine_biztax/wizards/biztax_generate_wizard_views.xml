<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Generate Declaration Wizard Form View -->
    <record id="view_biztax_generate_wizard_form" model="ir.ui.view">
        <field name="name">biztax.generate.wizard.form</field>
        <field name="model">biztax.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Nouvelle Déclaration Fiscale">
                <group>
                    <group string="Exercice Fiscal">
                        <field name="fiscal_year_start"/>
                        <field name="fiscal_year_end"/>
                        <field name="assessment_year" readonly="1"/>
                    </group>
                    <group string="Type de Déclaration">
                        <field name="declaration_type"/>
                        <field name="taxonomy_version"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <group string="Options d'import">
                    <field name="import_accounting_data"/>
                    <field name="create_default_adjustments"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not existing_declaration_id">
                    <field name="existing_declaration_id" invisible="1"/>
                    <strong>Attention :</strong> Une déclaration existe déjà pour cet exercice fiscal.
                    Continuer créera une nouvelle déclaration.
                </div>
                <footer>
                    <button name="action_create_declaration" type="object" 
                            string="Créer la Déclaration" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Generate Wizard Action -->
    <record id="action_biztax_generate_wizard" model="ir.actions.act_window">
        <field name="name">Nouvelle Déclaration Biztax</field>
        <field name="res_model">biztax.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
