<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tax Code Form View -->
    <record id="view_biztax_tax_code_form" model="ir.ui.view">
        <field name="name">biztax.tax.code.form</field>
        <field name="model">biztax.tax.code</field>
        <field name="arch" type="xml">
            <form string="Code fiscal XBRL">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="section"/>
                        </group>
                        <group>
                            <field name="xbrl_element"/>
                            <field name="legal_reference"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tax Code List View -->
    <record id="view_biztax_tax_code_tree" model="ir.ui.view">
        <field name="name">biztax.tax.code.tree</field>
        <field name="model">biztax.tax.code</field>
        <field name="arch" type="xml">
            <list string="Codes fiscaux XBRL">
                <field name="code"/>
                <field name="name"/>
                <field name="section"/>
                <field name="xbrl_element"/>
                <field name="legal_reference"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_biztax_tax_code_search" model="ir.ui.view">
        <field name="name">biztax.tax.code.search</field>
        <field name="model">biztax.tax.code</field>
        <field name="arch" type="xml">
            <search string="Rechercher codes fiscaux">
                <field name="code"/>
                <field name="name"/>
                <field name="xbrl_element"/>
                <separator/>
                <filter name="filter_section_iii" string="Majorations (III)" domain="[('section', '=', 'iii')]"/>
                <filter name="filter_section_iv" string="Diminutions (IV)" domain="[('section', '=', 'iv')]"/>
                <filter name="filter_section_c" string="Déductions (C)" domain="[('section', '=', 'c')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Section" name="group_section" context="{'group_by': 'section'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_biztax_tax_code" model="ir.actions.act_window">
        <field name="name">Codes fiscaux XBRL</field>
        <field name="res_model">biztax.tax.code</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_biztax_tax_code_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Codes fiscaux XBRL
            </p>
            <p>
                Ces codes correspondent aux éléments de la taxonomie be-tax
                utilisée pour les déclarations fiscales belges.
            </p>
        </field>
    </record>
</odoo>
