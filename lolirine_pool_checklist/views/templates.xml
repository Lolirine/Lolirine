<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Page /visite-chantier
        Page HTML autonome — React 18 + Babel servis EN LOCAL (static/lib)
        Le JS JSX est servi depuis static/ et transpilé par Babel dans le navigateur

        IMPORTANT — les librairies ne sont plus appelées sur un CDN.
        Avec des URL flottantes (react@18, @babel/standalone), le CDN peut
        changer de version sans prévenir. C'est ce qui a cassé la page :
        le preset React de Babel est passé au JSX runtime "automatic", qui
        émet un « import { jsx } from "react/jsx-runtime" » impossible à
        injecter comme script classique -> page blanche.
        Les fichiers sont désormais dans static/lib/ — voir VERSIONS.txt.
        Mise à jour : tools/vendor_libs.sh. Ne jamais revenir à une URL CDN.
    -->
    <template id="page_checklist" name="Fiche de visite chantier">
        <html lang="fr">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Fiche de visite chantier — Lolirine Pool Store</title>
                <!-- Désactivation indexation -->
                <meta name="robots" content="noindex, nofollow"/>
                <!-- CSS module -->
                <link rel="stylesheet"
                      type="text/css"
                      t-att-href="'/lolirine_pool_checklist/static/src/css/pool_checklist.css'"/>
                <!-- React 18 + ReactDOM + Babel standalone — SERVIS EN LOCAL -->
                <script t-att-src="'/lolirine_pool_checklist/static/lib/react.production.min.js'"/>
                <script t-att-src="'/lolirine_pool_checklist/static/lib/react-dom.production.min.js'"/>
                <script t-att-src="'/lolirine_pool_checklist/static/lib/babel.min.js'"/>
                <!-- Config frontend injectée côté serveur -->
                <script>
                    window.LOLIRINE_CHECKLIST_CONFIG = {
                        csrfToken:        '<t t-esc="request.csrf_token()"/>',
                        productsEndpoint:  '/pool-checklist/products',
                        aiEndpoint:        '/pool-checklist/ai-suggest',
                        partnerEndpoint:   '/pool-checklist/search-partner',
                        quoteEndpoint:     '/pool-checklist/create-quote'
                    };
                </script>
                <style>
                    *, *::before, *::after { box-sizing: border-box; }
                    html, body { margin: 0; padding: 0; background: #f1f5f9; }
                    #pool-checklist-root { min-height: 100vh; }
                    .plc-boot { font-family: system-ui, sans-serif; padding: 48px 24px;
                                text-align: center; color: #64748b; }
                    .plc-boot-title { font-size: 15px; font-weight: 600; color: #1e293b; }
                    .plc-err { font-family: system-ui, sans-serif; max-width: 640px;
                               margin: 48px auto; padding: 24px; border: 1.5px solid #fca5a5;
                               border-radius: 12px; background: #fef2f2; }
                    .plc-err-title { font-weight: 800; font-size: 16px; color: #a32d2d;
                                     margin-bottom: 8px; }
                    .plc-err-msg { font-size: 13px; color: #7f1d1d; }
                    .plc-err-detail { font-size: 11px; color: #7f1d1d; background: #fff;
                                      border-radius: 8px; padding: 10px; margin-top: 10px;
                                      overflow: auto; white-space: pre-wrap; }

                    /* ── Fiche vierge à imprimer ─────────────────────── */
                    .plc-sheet { font-family: "Inter", "Segoe UI", system-ui, sans-serif;
                                 color: #111; background: #fff; }
                    .plc-sheet-page { max-width: 190mm; margin: 0 auto; padding: 10mm 8mm; }
                    .plc-sheet h1 { font-size: 17pt; margin: 0 0 2mm; letter-spacing: -.3px; }
                    .plc-sheet h2 { font-size: 11pt; margin: 5mm 0 2mm;
                                    padding-bottom: 1mm; border-bottom: 1.5pt solid #111; }
                    .plc-field { display: flex; align-items: flex-end; gap: 2mm;
                                 margin-bottom: 2.5mm; font-size: 9pt; }
                    .plc-field-label { white-space: nowrap; color: #333; font-weight: 600; }
                    .plc-field-fill { flex: 1; border-bottom: .6pt dotted #777;
                                      min-height: 5mm; }
                    .plc-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 6mm; }
                    .plc-grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0 6mm; }
                    .plc-section { page-break-inside: avoid; break-inside: avoid;
                                   margin-bottom: 4mm; }
                    .plc-item { display: flex; align-items: flex-end; gap: 1.5mm;
                                padding: .8mm 0; font-size: 8.5pt; line-height: 1.35;
                                border-bottom: .3pt solid #e5e5e5; }
                    .plc-box { width: 3.6mm; height: 3.6mm; border: .8pt solid #333;
                               flex-shrink: 0; display: inline-block; margin-bottom: .5mm; }
                    .plc-box-warn { border-color: #a86a00; }
                    .plc-box-bad { border-color: #a32d2d; }
                    .plc-item-text { flex: 0 1 auto; }
                    .plc-item-fill { flex: 1 1 30mm; border-bottom: .6pt dotted #999;
                                     min-width: 22mm; margin-left: 1.5mm; }
                    .plc-sketch { border: .8pt solid #333; height: 62mm;
                                  background-image:
                                    linear-gradient(#eee .4pt, transparent .4pt),
                                    linear-gradient(90deg, #eee .4pt, transparent .4pt);
                                  background-size: 5mm 5mm; }
                    .plc-notes-lines { border: .8pt solid #333; padding: 2mm;
                                       background-image: linear-gradient(#ddd .4pt, transparent .4pt);
                                       background-size: 100% 7mm; height: 56mm; }
                    .plc-sign { display: grid; grid-template-columns: 1fr 1fr; gap: 8mm;
                                margin-top: 5mm; page-break-inside: avoid; }
                    .plc-sign-box { border: .8pt solid #333; height: 26mm; padding: 1.5mm;
                                    font-size: 8pt; color: #555; }
                    .plc-legend { font-size: 8pt; color: #444; display: flex; gap: 5mm;
                                  flex-wrap: wrap; margin: 2mm 0 4mm; align-items: center; }
                    .plc-foot { margin-top: 5mm; padding-top: 2mm;
                                border-top: .6pt solid #999; font-size: 7.5pt;
                                color: #666; text-align: center; }


                    /* ── Aperçu paginé A4 ────────────────────────────── */
                    .plc-measure { position: absolute; left: -10000px; top: 0;
                                   width: 192mm; visibility: hidden;
                                   pointer-events: none; }
                    .plc-pagewrap { padding: 18px 0 40px; }
                    .plc-pageouter { margin: 0 auto 22px;
                                     width: calc(210mm * var(--plc-zoom, 1)); }
                    .plc-pagelabel { font-family: system-ui, sans-serif; font-size: 11px;
                                     color: #64748b; margin-bottom: 5px;
                                     text-align: right; font-weight: 600; }
                    .plc-page { width: 210mm; min-height: 297mm; padding: 10mm 9mm;
                                background: #fff; box-shadow: 0 2px 14px rgba(0,0,0,.16);
                                transform: scale(var(--plc-zoom, 1));
                                transform-origin: top left; }

                    /* ── Règles d'impression ─────────────────────────── */
                    @page { size: A4 portrait; margin: 10mm 9mm; }
                    @media print {
                        html, body { background: #fff !important; }
                        body * { visibility: hidden; }
                        #plc-print, #plc-print * { visibility: visible; }
                        #plc-print { position: absolute; left: 0; top: 0;
                                     width: 100%; margin: 0; padding: 0; }
                        .plc-noprint { display: none !important; }
                        .plc-sheet-page { max-width: none; padding: 0; }
                        .plc-pagebreak { page-break-before: always; break-before: page; }
                        .plc-measure { display: none !important; }
                        .plc-pagewrap { padding: 0; }
                        .plc-pageouter { width: auto; margin: 0; }
                        .plc-page { width: auto; min-height: 0; padding: 0;
                                    box-shadow: none; transform: none; }
                        .plc-page-break { page-break-after: always;
                                          break-after: page; }
                    }
                </style>
            </head>
            <body>
                <!-- Point de montage React -->
                <div id="pool-checklist-root">
                    <!-- Remplacé par React au montage. Reste affiché si le
                         chargement échoue : plus jamais de page blanche muette. -->
                    <div class="plc-boot">
                        <div style="font-size:32px;margin-bottom:12px">🏊</div>
                        <div class="plc-boot-title">Chargement de la fiche de visite…</div>
                    </div>
                </div>

                <!--
                    Chargement + transpilation explicite du JSX.

                    On n'utilise plus <script type="text/babel" src="..."> :
                    cette forme (même avec data-presets="react") ne permet pas
                    de passer d'OPTIONS au preset, donc on subit le runtime par
                    défaut de la version servie. Ici on force runtime "classic"
                    + pragma React.createElement : le code produit est du JS
                    classique, injectable tel quel.
                -->
                <script type="text/javascript">
                    (function () {
                        var JS_URL = '/lolirine_pool_checklist/static/src/js/pool_checklist.js';

                        function showError(msg, detail) {
                            var root = document.getElementById('pool-checklist-root');
                            if (!root) { return; }
                            root.textContent = '';
                            var box = document.createElement('div');
                            box.className = 'plc-err';
                            var t = document.createElement('div');
                            t.className = 'plc-err-title';
                            t.textContent = '⚠️ La fiche n\'a pas pu se charger';
                            var m = document.createElement('div');
                            m.className = 'plc-err-msg';
                            m.textContent = msg;
                            var d = document.createElement('pre');
                            d.className = 'plc-err-detail';
                            d.textContent = detail || '';
                            box.appendChild(t);
                            box.appendChild(m);
                            box.appendChild(d);
                            root.appendChild(box);
                        }

                        function libState() {
                            return 'Babel: ' + (typeof Babel)
                                 + ' | React: ' + (typeof React)
                                 + ' | ReactDOM: ' + (typeof ReactDOM);
                        }

                        if (typeof Babel === 'undefined') {
                            showError('Babel ne s\'est pas chargé (fichier manquant dans static/lib ?).', libState());
                            return;
                        }
                        if (typeof React === 'undefined') {
                            showError('React ne s\'est pas chargé (fichier manquant dans static/lib ?).', libState());
                            return;
                        }
                        if (typeof ReactDOM === 'undefined') {
                            showError('ReactDOM ne s\'est pas chargé (fichier manquant dans static/lib ?).', libState());
                            return;
                        }

                        fetch(JS_URL, { credentials: 'same-origin', cache: 'no-cache' })
                            .then(function (r) {
                                if (!r.ok) {
                                    throw new Error('HTTP ' + r.status + ' sur ' + JS_URL);
                                }
                                return r.text();
                            })
                            .then(function (src) {
                                var out = Babel.transform(src, {
                                    filename: 'pool_checklist.js',
                                    presets: [['react', {
                                        runtime:    'classic',
                                        pragma:     'React.createElement',
                                        pragmaFrag: 'React.Fragment'
                                    }]]
                                }).code;

                                if (/^\s*import\s/m.test(out)) {
                                    throw new Error(
                                        'Babel a produit du code ESM malgre runtime "classic". '
                                        + 'Verifier la version dans static/lib/VERSIONS.txt.');
                                }

                                var s = document.createElement('script');
                                s.type = 'text/javascript';
                                s.textContent = out;
                                document.body.appendChild(s);
                            })
                            .catch(function (e) {
                                console.error('[pool_checklist] echec du chargement :', e);
                                var detail = String(e);
                                if (e) {
                                    if (e.message) { detail = e.message; }
                                }
                                showError('Erreur pendant le chargement ou la transpilation du script.', detail);
                            });
                    })();
                </script>
            </body>
        </html>
    </template>
</odoo>
