<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Asset bundle dédié à la page checklist -->
    <template id="assets_checklist" name="Lolirine Pool Checklist Assets">
        <link rel="stylesheet" href="/lolirine_pool_checklist/static/src/css/pool_checklist.css"/>
        <script type="text/javascript" src="/lolirine_pool_checklist/static/src/js/pool_checklist.js"></script>
    </template>

    <!-- Page principale /visite-chantier -->
    <template id="page_checklist" name="Fiche de visite chantier">
        <t t-call="web.layout">
            <t t-set="head">
                <title t-esc="page_title"/>
                <!-- React 18 + ReactDOM + Babel standalone (CDN) -->
                <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin="anonymous"></script>
                <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin="anonymous"></script>
                <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

                <!-- Configuration passée au frontend -->
                <script>
                    window.LOLIRINE_CHECKLIST_CONFIG = {
                        csrfToken:       '<t t-esc="request.csrf_token()"/>',
                        productsEndpoint: '/pool-checklist/products',
                        aiEndpoint:       '/pool-checklist/ai-suggest',
                        partnerEndpoint:  '/pool-checklist/search-partner',
                        quoteEndpoint:    '/pool-checklist/create-quote',
                    };
                </script>

                <!-- Styles de base -->
                <style>
                    *, *::before, *::after { box-sizing: border-box; }
                    body { margin: 0; padding: 0; background: #f1f5f9; }
                    #pool-checklist-root { min-height: 100vh; }
                    /* Reset nav Odoo website */
                    nav.o_main_navbar, footer.o_footer, .o_website_header,
                    header#top, .o_header_standard { display: none !important; }
                </style>
            </t>
            <t t-set="body_classname">o_checklist_page</t>

            <!-- Conteneur React -->
            <div id="pool-checklist-root"></div>

            <!-- Chargement du JS JSX via Babel -->
            <t t-set="footer_scripts">
                <script type="text/babel" data-type="module"
                        src="/lolirine_pool_checklist/static/src/js/pool_checklist.js">
                </script>
            </t>
        </t>
    </template>

</odoo>
