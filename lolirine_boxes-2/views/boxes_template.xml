<odoo>
  <template id="boxes_page" name="Boxes Lolirine" page="True">
    <t t-call="website.layout">
      <div class="container">
        <h1 class="text-center my-4">Visualisation 2D des boxes</h1>
        <div id="boxes-view"></div>
        <div id="overlay" onclick="closeModal()" style="display:none;"></div>
        <div id="modal" style="display:none;">
          <h3 id="modal-title"></h3>
          <p><strong>Dimensions:</strong> <span id="modal-dim"></span></p>
          <p><strong>Volume:</strong> <span id="modal-volume"></span></p>
          <p><strong>Prix:</strong> <span id="modal-price"></span></p>
          <p><strong>État:</strong> <span id="modal-status"></span></p>
          <button onclick="closeModal()">Fermer</button>
        </div>
      </div>
    </t>
  </template>
</odoo>
