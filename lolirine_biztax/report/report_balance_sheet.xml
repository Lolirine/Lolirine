<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- ================================================================== -->
    <!-- BALANCE SHEET REPORT TEMPLATE                                     -->
    <!-- ================================================================== -->
    
    <template id="report_balance_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="text-center mb-4">
                            <h2>BILAN</h2>
                            <h4>
                                <span t-field="doc.company_id.name"/>
                            </h4>
                            <p class="text-muted">
                                Exercice clôturé le <span t-field="doc.fiscal_year_end"/>
                                <br/>
                                Exercice d'imposition <span t-field="doc.assessment_year"/>
                            </p>
                        </div>
                        
                        <t t-set="data" t-value="report_data[doc_index]"/>
                        
                        <!-- Two column layout -->
                        <div class="row">
                            <!-- ACTIF -->
                            <div class="col-6">
                                <h5 class="bg-primary text-white p-2">ACTIF</h5>
                                
                                <t t-foreach="data['assets'].items()" t-as="section">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th colspan="2"><t t-esc="section[1]['name']"/></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="section[1]['items']" t-as="item">
                                                <tr>
                                                    <td>
                                                        <small class="text-muted"><t t-esc="item['code']"/></small>
                                                        <t t-esc="item['name']"/>
                                                    </td>
                                                    <td class="text-end" style="width: 120px;">
                                                        <t t-esc="'{:,.2f}'.format(item['amount']).replace(',', ' ')"/> €
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr class="table-light fw-bold">
                                                <td>Sous-total</td>
                                                <td class="text-end">
                                                    <t t-esc="'{:,.2f}'.format(sum(i['amount'] for i in section[1]['items'])).replace(',', ' ')"/> €
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                
                                <!-- Total Actif -->
                                <div class="bg-dark text-white p-2 text-end fw-bold">
                                    TOTAL ACTIF: <t t-esc="'{:,.2f}'.format(data['total_assets']).replace(',', ' ')"/> €
                                </div>
                            </div>
                            
                            <!-- PASSIF -->
                            <div class="col-6">
                                <h5 class="bg-success text-white p-2">PASSIF</h5>
                                
                                <t t-foreach="data['liabilities'].items()" t-as="section">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th colspan="2"><t t-esc="section[1]['name']"/></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="section[1]['items']" t-as="item">
                                                <tr>
                                                    <td>
                                                        <small class="text-muted"><t t-esc="item['code']"/></small>
                                                        <t t-esc="item['name']"/>
                                                    </td>
                                                    <td class="text-end" style="width: 120px;">
                                                        <t t-esc="'{:,.2f}'.format(item['amount']).replace(',', ' ')"/> €
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr class="table-light fw-bold">
                                                <td>Sous-total</td>
                                                <td class="text-end">
                                                    <t t-esc="'{:,.2f}'.format(sum(i['amount'] for i in section[1]['items'])).replace(',', ' ')"/> €
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                
                                <!-- Total Passif -->
                                <div class="bg-dark text-white p-2 text-end fw-bold">
                                    TOTAL PASSIF: <t t-esc="'{:,.2f}'.format(data['total_liabilities']).replace(',', ' ')"/> €
                                </div>
                            </div>
                        </div>
                        
                        <!-- Footer -->
                        <div class="mt-4 pt-3 border-top">
                            <div class="row">
                                <div class="col-6">
                                    <small class="text-muted">
                                        Document généré depuis Odoo - Module Biztax<br/>
                                        Référence déclaration: <span t-field="doc.name"/>
                                    </small>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">
                                        BCE: <span t-field="doc.enterprise_number"/><br/>
                                        Généré le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
