<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================= -->
    <!-- CONTACT - EXTENSION FORMULAIRE -->
    <!-- ============================================= -->
    <record id="view_partner_form_email_auto" model="ir.ui.view">
        <field name="name">res.partner.form.email.auto</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter dans l'onglet Vente & Achats ou créer un groupe -->
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <field name="auto_send_invoice_email" 
                       string="📧 Envoi email factures auto"
                       help="Les factures de ce client seront envoyées automatiquement par email à leur date de facturation"/>
            </xpath>
        </field>
    </record>
    
    <!-- ============================================= -->
    <!-- CONTACT - BOUTON FACTURES EN ATTENTE -->
    <!-- ============================================= -->
    <record id="view_partner_form_email_pending_button" model="ir.ui.view">
        <field name="name">res.partner.form.email.pending.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(lolirine_email_templates.action_invoices_pending_email)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-envelope-o"
                        invisible="pending_invoice_count == 0"
                        context="{'search_default_partner_id': active_id}">
                    <field name="pending_invoice_count" string="En attente" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
    
</odoo>
