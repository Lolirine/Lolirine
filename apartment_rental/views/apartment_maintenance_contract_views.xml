<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contract Form View -->
    <record id="apartment_maintenance_contract_view_form" model="ir.ui.view">
        <field name="name">apartment.maintenance.contract.form</field>
        <field name="model">apartment.maintenance.contract</field>
        <field name="arch" type="xml">
            <form string="Contrat d'entretien">
                <header>
                    <button name="action_activate" type="object" string="Activer" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_renew" type="object" string="Renouveler" class="btn-primary" invisible="state not in ('expiring', 'expired')"/>
                    <button name="action_cancel" type="object" string="Résilier" class="btn-secondary" invisible="state in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Paiements"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Référence"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contrat">
                            <field name="property_id"/>
                            <field name="contract_type"/>
                            <field name="external_reference"/>
                        </group>
                        <group string="Prestataire">
                            <field name="provider_id"/>
                            <field name="provider_phone"/>
                            <field name="provider_email"/>
                        </group>
                    </group>
                    <group>
                        <group string="Période">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="is_renewable"/>
                            <field name="renewal_notice_days" invisible="not is_renewable"/>
                        </group>
                        <group string="Paiement">
                            <field name="payment_frequency"/>
                            <field name="payment_amount"/>
                            <field name="payment_day" invisible="payment_frequency == 'one_time'"/>
                            <field name="next_payment_date"/>
                            <field name="days_until_payment"/>
                            <field name="reminder_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Équipement" name="equipment">
                            <group>
                                <group>
                                    <field name="equipment_brand"/>
                                    <field name="equipment_model"/>
                                    <field name="equipment_serial"/>
                                </group>
                                <group>
                                    <field name="equipment_year"/>
                                </group>
                            </group>
                            <field name="equipment_notes" placeholder="Notes sur l'équipement..."/>
                        </page>
                        <page string="Paiements" name="payments">
                            <field name="payment_ids">
                                <list editable="bottom" decoration-danger="state == 'late'" decoration-success="state == 'paid'" decoration-muted="state == 'cancelled'">
                                    <field name="due_date"/>
                                    <field name="amount"/>
                                    <field name="description"/>
                                    <field name="invoice_number"/>
                                    <field name="date"/>
                                    <field name="payment_method"/>
                                    <field name="state" widget="badge" decoration-danger="state == 'late'" decoration-success="state == 'paid'" decoration-warning="state == 'pending'"/>
                                    <button name="action_mark_paid" type="object" string="Payé" icon="fa-check" invisible="state != 'pending' and state != 'late'"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="total_paid"/>
                                    <field name="last_payment_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_ids" context="{'default_maintenance_contract_id': id, 'default_document_type': 'maintenance_contract'}">
                                <list>
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="date"/>
                                    <field name="file_name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="description" placeholder="Description du contrat..."/>
                            <field name="notes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Contract List View -->
    <record id="apartment_maintenance_contract_view_list" model="ir.ui.view">
        <field name="name">apartment.maintenance.contract.list</field>
        <field name="model">apartment.maintenance.contract</field>
        <field name="arch" type="xml">
            <list string="Contrats d'entretien" decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="property_id"/>
                <field name="contract_type"/>
                <field name="provider_id"/>
                <field name="payment_frequency"/>
                <field name="payment_amount"/>
                <field name="next_payment_date"/>
                <field name="days_until_payment"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'" decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- Payment Form View -->
    <record id="apartment_maintenance_contract_payment_view_form" model="ir.ui.view">
        <field name="name">apartment.maintenance.contract.payment.form</field>
        <field name="model">apartment.maintenance.contract.payment</field>
        <field name="arch" type="xml">
            <form string="Paiement">
                <header>
                    <button name="action_mark_paid" type="object" string="Marquer comme payé" class="btn-primary" invisible="state == 'paid' or state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Annuler" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Échéance">
                            <field name="contract_id"/>
                            <field name="property_id"/>
                            <field name="provider_id"/>
                            <field name="due_date"/>
                            <field name="amount"/>
                            <field name="description"/>
                        </group>
                        <group string="Paiement">
                            <field name="date"/>
                            <field name="payment_method"/>
                            <field name="payment_reference"/>
                        </group>
                    </group>
                    <group string="Facture">
                        <group>
                            <field name="invoice_number"/>
                            <field name="invoice_date"/>
                        </group>
                        <group>
                            <field name="invoice_file" filename="invoice_filename"/>
                            <field name="invoice_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Payment List View -->
    <record id="apartment_maintenance_contract_payment_view_list" model="ir.ui.view">
        <field name="name">apartment.maintenance.contract.payment.list</field>
        <field name="model">apartment.maintenance.contract.payment</field>
        <field name="arch" type="xml">
            <list string="Paiements" decoration-danger="state == 'late'" decoration-success="state == 'paid'" decoration-muted="state == 'cancelled'">
                <field name="contract_id"/>
                <field name="property_id"/>
                <field name="provider_id"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="invoice_number"/>
                <field name="date"/>
                <field name="payment_method"/>
                <field name="state" widget="badge" decoration-danger="state == 'late'" decoration-success="state == 'paid'" decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="apartment_maintenance_contract_action" model="ir.actions.act_window">
        <field name="name">Contrats d'entretien</field>
        <field name="res_model">apartment.maintenance.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier contrat d'entretien
            </p>
            <p>
                Gérez les contrats d'entretien (chaudière, climatisation, etc.) et suivez les paiements.
            </p>
        </field>
    </record>

    <record id="apartment_maintenance_contract_payment_action" model="ir.actions.act_window">
        <field name="name">Paiements contrats</field>
        <field name="res_model">apartment.maintenance.contract.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Action for upcoming payments -->
    <record id="apartment_maintenance_contract_payment_upcoming_action" model="ir.actions.act_window">
        <field name="name">Échéances à venir</field>
        <field name="res_model">apartment.maintenance.contract.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['pending', 'late'])]</field>
        <field name="context">{}</field>
    </record>

</odoo>
