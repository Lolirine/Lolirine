<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══ FORM VIEW ═══ -->
    <record id="pool_catalog_pdf_parser_form" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.parser.form</field>
        <field name="model">pool.catalog.pdf.parser</field>
        <field name="arch" type="xml">
            <form string="Import PDF Catalogue Fluidra">

                <group invisible="state not in ('draft',)">
                    <group string="Configuration">
                        <field name="name"/>
                        <field name="supplier_id"/>
                        <field name="catalog_base_url"/>
                        <field name="catalog_guid"/>
                    </group>
                    <group string="Périmètre">
                        <field name="page_from"/>
                        <field name="page_to"
                               help="Page 1 à 582. Mettre 10 pour un test rapide."/>
                        <field name="dry_run"/>
                    </group>
                </group>

                <group invisible="state == 'draft'" string="Résultats">
                    <group>
                        <field name="pages_processed" readonly="1"/>
                        <field name="products_found"  readonly="1"/>
                        <field name="products_created" readonly="1"/>
                    </group>
                </group>

                <group invisible="not error_message" string="Erreur">
                    <field name="error_message" readonly="1" nolabel="1"/>
                </group>

                <field name="result_log" readonly="1" widget="text"
                       invisible="not result_log"
                       string="Log détaillé"/>

                <footer>
                    <button name="action_run"
                            string="▶  Lancer l'import PDF"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'done', 'error')"/>
                    <button name="action_test_page"
                            string="🔍 Tester page_from uniquement"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('draft',)"/>
                    <button string="Fermer"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══ LIST VIEW ═══ -->
    <record id="pool_catalog_pdf_parser_list" model="ir.ui.view">
        <field name="name">pool.catalog.pdf.parser.list</field>
        <field name="model">pool.catalog.pdf.parser</field>
        <field name="arch" type="xml">
            <list string="Sessions import PDF">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="page_from"/>
                <field name="page_to"/>
                <field name="pages_processed"/>
                <field name="products_found"/>
                <field name="products_created"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ═══ ACTION ═══ -->
    <record id="action_pool_catalog_pdf_parser" model="ir.actions.act_window">
        <field name="name">Import PDF Catalogue Fluidra</field>
        <field name="res_model">pool.catalog.pdf.parser</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
